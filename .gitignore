# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# next.js
/.next/
.next/
/out/*
!/out/index.html

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Copied from node_modules by scripts/copy-esbuild-wasm.mjs
public/sites/esbuild.wasm
public/sites/bundler-worker.js
public/sites/vendor/
public/sites/monaco/

# Every check-*.mjs probe bundles into a dot directory named after itself and
# deletes it on the way out. A probe that fails before its `finally` leaves one
# behind, and four of them reached `git add -A` before this line existed. The
# glob covers the ones below and every one added after.
.*-probe/

# Written and removed by scripts/check-sidebar.mjs while it bundles the probe.
.sidebar-probe/

# Generated by the measurement scripts, and deleted again in their finally block.
tsconfig.*.generated.json
.chart-probe/

# Written by scripts/check-creator-chrome.mjs while it bundles the probe.
.chrome-probe/

# Stub modules the render probes write and delete at run time
.wb-probe/

# Generated by scripts/check-editor-motion.mjs
.motion-probe/

# Written by scripts/check-product-bar.mjs while it bundles the probe.
.prodbar-probe/

# Written by scripts/check-bar-hydrate.mjs while it bundles the probe.
.hydrate-probe/

# Written by scripts/check-drawer-scrollbars.mjs while it bundles the probe.
.scroll-probe/

# Written by scripts/check-nav-drawer.mjs while it bundles the probe.
.drawer-probe/
.seam-probe/
.card-probe/
.footer-probe/
.sheetfps-probe/
.logofont-probe/
.lvb-probe/
.ctlfps-probe/
.hdrsearch-probe/
.width-probe/
# Written by scripts/check-onepage-stability.mjs while it bundles the probe.
.onepage-probe/
.dash-probe/
.nav-probe/
.payments-probe/

# Written and removed by scripts/check-nav-dropdown.mjs while it bundles the probe.
.navdrop-probe/
# The screenshot that probe leaves behind, so the dropdown can be looked at
# and not only measured.
.probe-nav-dropdown.png
# And the one scripts/check-writing-section.mjs leaves, of the Ask AI placeholder.
.probe-writing-section.png

# Written by scripts/check-cover-capture.mjs while it bundles the probe, and
# the three pictures it leaves so the cover can be looked at, not only measured.
.cover-probe/
.orders-probe/
.settings-probe/
.probe-cover-desktop.webp
.probe-cover-phone.webp
.probe-cover-desktop.png
.probe-cover-phone.png
.checkout-probe/
.focus-probe/
.button-probe/
.parity-probe/
.claude/worktrees/

# Where the download probes let Chromium save the files it really downloads
# (scripts/check-receipt.mjs, scripts/check-onepage-download.mjs). Removed on
# the way out; left behind by a run that stopped early.
.receipt-downloads/
.onepage-downloads/
.orders20-probe/
