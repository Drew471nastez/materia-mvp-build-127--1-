{# example
title: Scroll reveal chapters
summary: Chapters that fade and rise into place as they scroll into view, with CSS scroll-driven animation only, travelling as far as the site's motion feel says (--t-motion-distance) times the strength the creator sets; visible and still without support, with reduced motion or set to still.
tags: scroll, reveal, fade, view-timeline, animation-timeline, chapters, story, motion, stagger, reveal on scroll, motion tier
#}
<template>
<section class="rv" data-motion="{{ settings.motion }}" data-scheme="{{ settings.color_scheme }}" style="--m-k: calc({{ settings.motion_strength }} / 100); --s-bg: {{ scheme.bg }}; --s-text: {{ scheme.text }}; --s-heading: {{ scheme.heading }}; --s-accent: {{ scheme.accent }}; --s-border: {{ scheme.border }}; --s-pt: {{ settings.padding_top }}px; --s-pb: {{ settings.padding_bottom }}px;">
  {% if settings.heading %}<h2 class="rv__h">{{ settings.heading }}</h2>{% endif %}
  <ol class="rv__list">
    {% for block in section.blocks %}
      <li class="rv__item" data-block-id="{{ block.id }}">
        <span class="rv__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
        <div class="rv__body">
          <h3 class="rv__title">{{ block.settings.title }}</h3>
          {% if block.settings.text %}<div class="rv__text">{{ block.settings.text }}</div>{% endif %}
        </div>
      </li>
    {% else %}
      {% if page.in_editor %}<li class="rv__empty">Add chapters in the sidebar</li>{% endif %}
    {% endfor %}
  </ol>
</section>
</template>

<style scoped>
.rv { container-type: inline-size; padding: calc(var(--s-pt) * var(--theme-spacing-scale, 1)) var(--theme-padding-x, 20px) calc(var(--s-pb) * var(--theme-spacing-scale, 1)); background: var(--s-bg); color: var(--s-text); }
.rv__h { margin: 0 0 clamp(32px, 6vw, 72px); max-width: 18ch; font-family: var(--theme-font-heading), serif; font-size: clamp(2rem, 1.4rem + 3vw, 4.2rem); line-height: 0.98; letter-spacing: -0.025em; font-weight: 500; color: var(--s-heading); }
.rv__list { list-style: none; margin: 0; padding: 0; }
.rv__item { display: grid; grid-template-columns: 3.5rem 1fr; gap: 16px; padding: 28px 0; border-top: 1px solid var(--s-border); }
.rv__num { font-family: var(--theme-font-accent, var(--theme-font-body)), monospace; font-size: 0.8125rem; letter-spacing: 0.12em; color: var(--s-accent); font-variant-numeric: tabular-nums; }
.rv__title { margin: 0 0 8px; font-family: var(--theme-font-heading), serif; font-size: clamp(1.4rem, 1.1rem + 1.4vw, 2.2rem); line-height: 1.05; font-weight: 500; color: var(--s-heading); }
.rv__text { max-width: 60ch; font-size: 1.0625rem; line-height: 1.6; }
.rv__empty { padding: 24px 0; opacity: 0.7; }
@container (max-width: 600px) { .rv__list { --m-phone: 0.6; } }
@container (min-width: 760px) { .rv__item { grid-template-columns: 8rem minmax(0, 1fr); padding: 40px 0; } }
/* Motion is an extra: only where the browser ties it to scroll, and only for people who have not asked for less. */
@supports (animation-timeline: view()) {
  @media (prefers-reduced-motion: no-preference) {
    .rv:not([data-motion="off"]) .rv__item { animation: rv-rise linear both; animation-timeline: view(); animation-range: entry 0% entry 60%; }
    @keyframes rv-rise { from { opacity: 0; transform: translateY(calc(var(--t-motion-distance, 24px) * 1.3 * var(--m-k, 1) * var(--m-phone, 1))); } to { opacity: 1; transform: none; } }
  }
}
</style>

<schema>
{
  "schema_version": 1,
  "type": "ai_scroll_reveal",
  "name": "Chapters that reveal",
  "category": "text",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "How a commission comes together" },
    { "type": "select", "id": "motion", "label": "Motion", "default": "site", "options": [{ "label": "Follow the site", "value": "site" }, { "label": "Still", "value": "off" }] },
    { "type": "range", "id": "motion_strength", "label": "Motion strength", "min": 0, "max": 150, "step": 10, "unit": "%", "default": 100 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "site" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    { "type": "chapter", "name": "Chapter", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "A first conversation" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "What you need, where it will live, and when." }
    ] }
  ],
  "presets": [{ "name": "Chapters that reveal", "blocks": [{ "type": "chapter", "settings": { "title": "A first conversation", "text": "What you need, where it will live, and when." } }, { "type": "chapter", "settings": { "title": "Sketches", "text": "Two or three directions on paper before anything is made." } }, { "type": "chapter", "settings": { "title": "Making", "text": "The piece is made, with photos along the way." } }] }]
}
</schema>
