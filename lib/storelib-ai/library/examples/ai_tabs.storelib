{# example
title: Tabs without script
summary: Tabs built from a native radio group and :has(), so arrow keys move between them, the choice survives without script, and every panel is real text in the page; on a phone the tabs scroll sideways.
tags: tabs, tab panel, switcher, timetable, menu sections, :has, radio, keyboard
#}
<template>
<section class="tb" data-scheme="{{ settings.color_scheme }}" style="--s-bg: {{ scheme.bg }}; --s-text: {{ scheme.text }}; --s-heading: {{ scheme.heading }}; --s-accent: {{ scheme.accent }}; --s-border: {{ scheme.border }}; --s-pt: {{ settings.padding_top }}px; --s-pb: {{ settings.padding_bottom }}px;">
  <h2 class="tb__h" id="tb-{{ section.id }}">{{ settings.heading }}</h2>
  {% if section.blocks.size > 0 %}
  <div class="tb__tabs" role="radiogroup" aria-labelledby="tb-{{ section.id }}">
    {% for block in section.blocks %}
      <label class="tb__tab" data-block-id="{{ block.id }}"><input class="tb__radio" type="radio" name="tb-{{ section.id }}" value="{{ forloop.index }}"{% if forloop.first %} checked{% endif %}><span>{{ block.settings.title }}</span></label>
    {% endfor %}
  </div>
  <div class="tb__panels">
    {% for block in section.blocks %}
      <div class="tb__panel tb__panel--{{ forloop.index }}">
        <h3 class="tb__ptitle">{{ block.settings.title }}</h3>
        <div class="tb__body">{{ block.settings.body | raw }}</div>
      </div>
    {% endfor %}
  </div>
  {% elsif page.in_editor %}
  <p class="tb__empty">Add tabs in the sidebar</p>
  {% endif %}
</section>
</template>

<style scoped>
.tb { padding: calc(var(--s-pt) * var(--theme-spacing-scale, 1)) var(--theme-padding-x, 16px) calc(var(--s-pb) * var(--theme-spacing-scale, 1)); background: var(--s-bg); color: var(--s-text); }
.tb__h { margin: 0 0 20px; font-family: var(--theme-font-heading), serif; font-size: clamp(1.75rem, 1.2rem + 2.4vw, 3.25rem); line-height: 1; letter-spacing: -0.02em; font-weight: 500; color: var(--s-heading); }
.tb__tabs { display: flex; gap: 4px; overflow-x: auto; border-bottom: 1px solid var(--s-border); scrollbar-width: none; }
.tb__tab { position: relative; flex: none; display: inline-flex; align-items: center; min-height: 44px; padding: 0 16px; cursor: pointer; font-size: 0.9375rem; letter-spacing: 0.02em; }
.tb__radio { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
.tb__tab:has(.tb__radio:checked) { color: var(--s-heading); box-shadow: inset 0 -2px 0 var(--s-accent); }
.tb__tab:has(.tb__radio:focus-visible) { outline: 2px solid var(--s-accent); outline-offset: -2px; }
.tb__panels { padding-top: 28px; }
.tb__panel { display: none; max-width: 64ch; }
.tb__ptitle { margin: 0 0 10px; font-size: 1.25rem; font-weight: 600; color: var(--s-heading); }
.tb__body { font-size: 1.0625rem; line-height: 1.65; }
.tb__empty { opacity: 0.7; }
/* Up to eight tabs: the checked radio shows its panel. */
.tb:has(.tb__radio[value="1"]:checked) .tb__panel--1,
.tb:has(.tb__radio[value="2"]:checked) .tb__panel--2,
.tb:has(.tb__radio[value="3"]:checked) .tb__panel--3,
.tb:has(.tb__radio[value="4"]:checked) .tb__panel--4,
.tb:has(.tb__radio[value="5"]:checked) .tb__panel--5,
.tb:has(.tb__radio[value="6"]:checked) .tb__panel--6,
.tb:has(.tb__radio[value="7"]:checked) .tb__panel--7,
.tb:has(.tb__radio[value="8"]:checked) .tb__panel--8 { display: block; }
/* A browser without :has() shows every panel, each under its own title: nothing is lost. */
@supports not selector(:has(*)) { .tb__panel { display: block; margin-bottom: 24px; } .tb__tabs { display: none; } }
@media (prefers-reduced-motion: no-preference) {
  .tb__panel { animation: tb-in 200ms ease both; }
  @keyframes tb-in { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
}
</style>

<schema>
{
  "schema_version": 1,
  "type": "ai_tabs",
  "name": "Tabs",
  "category": "text",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The week at the studio" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "site" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 72 }
  ],
  "blocks": [
    { "type": "tab", "name": "Tab", "limit": 8, "settings": [
      { "type": "text", "id": "title", "label": "Tab name", "default": "Monday" },
      { "type": "richtext", "id": "body", "label": "Content", "default": "<p>Write what happens on this day.</p>" }
    ] }
  ],
  "presets": [{ "name": "Tabs", "blocks": [{ "type": "tab", "settings": { "title": "Monday" } }, { "type": "tab", "settings": { "title": "Wednesday" } }, { "type": "tab", "settings": { "title": "Saturday" } }] }]
}
</schema>
