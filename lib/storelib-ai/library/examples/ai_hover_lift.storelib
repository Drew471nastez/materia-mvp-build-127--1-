{# example
title: Hover lift and press
summary: An index of offers or programmes whose rows answer the pointer: the picture lifts and pans inside its crop, the arrow travels, and a press settles the row, all timed by the site's motion feel (--t-motion-hover, --t-motion-lift); touch keeps the press only, reduced motion keeps colour and underline feedback without movement.
tags: hover, hover lift, press, tactile, micro interaction, card hover, image pan, offers, programmes, index, links, motion tier
#}
<template>
<section class="hl" data-motion="{{ settings.motion }}" data-scheme="{{ settings.color_scheme }}" style="--s-bg: {{ scheme.bg }}; --s-text: {{ scheme.text }}; --s-heading: {{ scheme.heading }}; --s-accent: {{ scheme.accent }}; --s-border: {{ scheme.border }}; --s-pt: {{ settings.padding_top }}px; --s-pb: {{ settings.padding_bottom }}px; --m-k: calc({{ settings.motion_strength }} / 100);">
  <div class="hl__in">
    {% if settings.heading %}<h2 class="hl__h">{{ settings.heading }}</h2>{% endif %}
    <ul class="hl__list">
      {% for block in section.blocks %}
      <li class="hl__row" data-block-id="{{ block.id }}">
        <a class="hl__link" href="{{ block.settings.url | url }}">
          <span class="hl__body">
            <span class="hl__title">{{ block.settings.title }}</span>
            {% if block.settings.text %}<span class="hl__text">{{ block.settings.text }}</span>{% endif %}
          </span>
          {% if block.settings.meta %}<span class="hl__meta">{{ block.settings.meta }}</span>{% endif %}
          <span class="hl__arrow" aria-hidden="true">&rarr;</span>
          {% if block.settings.image %}<span class="hl__crop"><img class="hl__img" src="{{ block.settings.image | asset }}" alt="{{ block.settings.image_alt }}" width="800" height="1000" loading="lazy"></span>{% endif %}
        </a>
      </li>
      {% else %}
      {% if page.in_editor %}<li class="hl__row hl__empty">Add offers in the sidebar</li>{% endif %}
      {% endfor %}
    </ul>
  </div>
</section>
</template>

<style scoped>
.hl { container-type: inline-size; padding: calc(var(--s-pt) * var(--theme-spacing-scale, 1)) var(--theme-padding-x, 16px) calc(var(--s-pb) * var(--theme-spacing-scale, 1)); background: var(--s-bg); color: var(--s-text); }
.hl__in { max-width: var(--theme-page-width, 1280px); margin: 0 auto; }
.hl__h { margin: 0 0 clamp(24px, 4vw, 48px); font-family: var(--theme-font-heading), sans-serif; font-size: clamp(1.9rem, 1.2rem + 2.8vw, 3.8rem); line-height: 1; letter-spacing: -0.03em; font-weight: 700; color: var(--s-heading); }
.hl__list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--s-border); }
.hl__row { border-bottom: 1px solid var(--s-border); }
.hl__link { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 10px 20px; align-items: center; padding: 22px 0; min-height: 44px; color: inherit; text-decoration: none; }
.hl__body { display: grid; gap: 6px; }
.hl__title { font-family: var(--theme-font-heading), sans-serif; font-size: clamp(1.35rem, 1rem + 1.6vw, 2.3rem); line-height: 1.05; letter-spacing: -0.02em; font-weight: 700; color: var(--s-heading); text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 6px; transition: text-decoration-color var(--t-motion-hover, 200ms) ease; }
.hl__text { max-width: 54ch; font-size: 1rem; line-height: 1.55; }
.hl__meta { font-size: 0.9375rem; font-variant-numeric: tabular-nums; white-space: nowrap; }
.hl__arrow { display: none; }
.hl__crop { grid-column: 1 / -1; display: block; overflow: hidden; aspect-ratio: 16 / 10; }
.hl__img { display: block; width: 100%; height: 100%; object-fit: cover; }
.hl__link:focus-visible { outline: 2px solid var(--s-accent); outline-offset: 4px; }
.hl__link:hover .hl__title, .hl__link:focus-visible .hl__title { text-decoration-color: currentColor; }
.hl__empty { padding: 24px 0; opacity: 0.7; }
@container (min-width: 760px) {
  .hl__link { grid-template-columns: minmax(0, 1fr) auto 32px 168px; padding: 26px 0; }
  .hl__body { grid-column: 1; grid-row: 1; }
  .hl__meta { grid-column: 2; grid-row: 1; }
  .hl__arrow { display: block; grid-column: 3; grid-row: 1; font-size: 1.5rem; color: var(--s-accent); }
  .hl__crop { grid-column: 4; grid-row: 1; aspect-ratio: 4 / 5; }
}
/* Movement only when welcome. The press works on touch too; the lift and pan only on a pointer that hovers. */
@media (prefers-reduced-motion: no-preference) {
  .hl:not([data-motion="off"]) .hl__link { transition: transform var(--t-motion-hover, 200ms) var(--t-motion-ease-ui, cubic-bezier(0.3, 0.7, 0.4, 1)); }
  .hl:not([data-motion="off"]) .hl__link:active { transform: scale(0.985); }
  .hl:not([data-motion="off"]) .hl__img, .hl:not([data-motion="off"]) .hl__crop, .hl:not([data-motion="off"]) .hl__arrow { transition: transform calc(var(--t-motion-hover, 200ms) * 1.6) var(--t-motion-ease-ui, cubic-bezier(0.3, 0.7, 0.4, 1)); }
  @media (hover: hover) and (pointer: fine) {
    .hl:not([data-motion="off"]) .hl__link:hover .hl__crop { transform: translateY(calc(var(--t-motion-lift, 4px) * -1 * var(--m-k, 1))); }
    .hl:not([data-motion="off"]) .hl__link:hover .hl__img { transform: scale(calc(1 + (var(--t-motion-scale, 1.06) - 1) * var(--m-k, 1))); }
    .hl:not([data-motion="off"]) .hl__link:hover .hl__arrow { transform: translateX(calc(var(--t-motion-lift, 4px) * 2 * var(--m-k, 1))); }
  }
}
</style>

<schema>
{
  "schema_version": 1,
  "type": "ai_hover_lift",
  "name": "Offers that answer the pointer",
  "category": "text",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ways to train" },
    { "type": "header", "id": "hdr_motion", "label": "Motion" },
    { "type": "select", "id": "motion", "label": "Motion", "default": "site", "options": [{ "label": "Follow the site", "value": "site" }, { "label": "Still", "value": "off" }] },
    { "type": "range", "id": "motion_strength", "label": "Strength", "min": 0, "max": 150, "step": 10, "unit": "%", "default": 100 },
    { "type": "header", "id": "hdr_style", "label": "Style" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "site" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 80 }
  ],
  "blocks": [
    { "type": "offer", "name": "Offer", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "One to one" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "Twelve sessions in the studio, a plan between them." },
      { "type": "text", "id": "meta", "label": "Detail on the right", "default": "" },
      { "type": "url", "id": "url", "label": "Link", "default": "/about" },
      { "type": "image_picker", "id": "image", "label": "Picture" },
      { "type": "text", "id": "image_alt", "label": "Picture description", "default": "" }
    ] }
  ],
  "presets": [{ "name": "Offers that answer the pointer", "blocks": [{ "type": "offer", "settings": { "title": "One to one", "text": "Twelve sessions in the studio, a plan between them." } }, { "type": "offer", "settings": { "title": "Small group", "text": "Four people, one coach, Tuesday and Thursday at 6." } }, { "type": "offer", "settings": { "title": "Remote coaching", "text": "Your gym, a written plan, a video check in every Friday." } }] }]
}
</schema>
