{# example
title: Sticky stacked panels
summary: Panels that stick and stack on top of each other as the page scrolls, each a little lower than the last, with pure CSS position sticky; a plain list on phones that prefer less motion.
tags: sticky, stacked cards, stack, scroll, panels, services, steps, layering
#}
<template>
<section class="st" data-scheme="{{ settings.color_scheme }}" style="--s-bg: {{ scheme.bg }}; --s-text: {{ scheme.text }}; --s-heading: {{ scheme.heading }}; --s-accent: {{ scheme.accent }}; --s-border: {{ scheme.border }}; --s-pt: {{ settings.padding_top }}px; --s-pb: {{ settings.padding_bottom }}px;">
  <div class="st__head">
    {% if settings.label %}<p class="st__label">{{ settings.label }}</p>{% endif %}
    <h2 class="st__h">{{ settings.heading }}</h2>
  </div>
  <ol class="st__stack">
    {% for block in section.blocks %}
      <li class="st__panel" data-block-id="{{ block.id }}" style="--i: {{ forloop.index0 }};">
        <div class="st__copy">
          <span class="st__n">{{ forloop.index }}</span>
          <h3 class="st__title">{{ block.settings.title }}</h3>
          {% if block.settings.text %}<p class="st__text">{{ block.settings.text }}</p>{% endif %}
          {% if block.settings.link_url and block.settings.link_label %}<a class="st__link" href="{{ block.settings.link_url | url }}">{{ block.settings.link_label }}</a>{% endif %}
        </div>
        {% if block.settings.image %}<img class="st__img" src="{{ block.settings.image | asset }}" alt="{{ block.settings.image_alt }}" width="800" height="600" loading="lazy">{% endif %}
      </li>
    {% else %}
      {% if page.in_editor %}<li class="st__empty">Add panels in the sidebar</li>{% endif %}
    {% endfor %}
  </ol>
</section>
</template>

<style scoped>
.st { container-type: inline-size; padding: calc(var(--s-pt) * var(--theme-spacing-scale, 1)) var(--theme-padding-x, 16px) calc(var(--s-pb) * var(--theme-spacing-scale, 1)); background: var(--s-bg); color: var(--s-text); }
.st__head { margin-bottom: clamp(24px, 5vw, 56px); }
.st__label { margin: 0 0 10px; font-size: 0.8125rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--s-accent); }
.st__h { margin: 0; max-width: 16ch; font-family: var(--theme-font-heading), serif; font-size: clamp(2rem, 1.3rem + 3.4vw, 4.5rem); line-height: 0.95; letter-spacing: -0.03em; font-weight: 600; color: var(--s-heading); }
.st__stack { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
.st__panel { display: grid; gap: 20px; padding: clamp(20px, 4vw, 40px); background: var(--s-bg); border: 1px solid var(--s-border); border-radius: 4px; }
.st__n { font-variant-numeric: tabular-nums; font-size: 0.875rem; letter-spacing: 0.1em; color: var(--s-accent); }
.st__title { margin: 8px 0 10px; font-family: var(--theme-font-heading), serif; font-size: clamp(1.5rem, 1.1rem + 1.8vw, 2.6rem); line-height: 1; letter-spacing: -0.02em; font-weight: 600; color: var(--s-heading); }
.st__text { margin: 0; max-width: 52ch; font-size: 1.0625rem; line-height: 1.6; }
.st__link { display: inline-block; margin-top: 16px; padding-block: 10px; color: inherit; text-underline-offset: 4px; }
.st__img { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; }
.st__empty { opacity: 0.7; }
@container (min-width: 760px) {
  .st__panel { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: end; min-height: 60svh; }
}
/* The stack: each panel sticks a little lower than the one before. Only when motion is welcome and there is height for it. */
@media (prefers-reduced-motion: no-preference) and (min-height: 560px) {
  .st__panel { position: sticky; top: calc(72px + var(--i) * 18px); }
}
</style>

<schema>
{
  "schema_version": 1,
  "type": "ai_sticky_stack",
  "name": "Stacked panels",
  "category": "text",
  "settings": [
    { "type": "text", "id": "label", "label": "Small line above", "default": "What we do" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Three ways to work together" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "site" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 120 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 160 }
  ],
  "blocks": [
    { "type": "panel", "name": "Panel", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "One to one" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "Say what happens, how long it takes and who it suits." },
      { "type": "text", "id": "link_label", "label": "Link text", "default": "" },
      { "type": "url", "id": "link_url", "label": "Link", "default": "" },
      { "type": "image_picker", "id": "image", "label": "Photo" },
      { "type": "text", "id": "image_alt", "label": "Photo description", "default": "" }
    ] }
  ],
  "presets": [{ "name": "Stacked panels", "blocks": [{ "type": "panel", "settings": { "title": "One to one" } }, { "type": "panel", "settings": { "title": "Small groups" } }, { "type": "panel", "settings": { "title": "Online plan" } }] }]
}
</schema>
