{# example
title: Sticky storytelling
summary: A method told in two to five steps: on a wide screen the picture column stays while the steps pass beside it and each step's picture crossfades in on a named view timeline (position sticky plus timeline-scope, no script, no pinning by JavaScript); on phones, without support or with reduced motion it is plain sequential steps, each with its own picture.
tags: sticky story, sticky storytelling, scrollytelling, sticky image, process, method, steps, how it works, crossfade, timeline-scope, view-timeline, motion tier
#}
<template>
<section class="ss ss--{{ settings.layout }}" data-motion="{{ settings.motion }}" data-scheme="{{ settings.color_scheme }}" style="--s-bg: {{ scheme.bg }}; --s-text: {{ scheme.text }}; --s-heading: {{ scheme.heading }}; --s-accent: {{ scheme.accent }}; --s-border: {{ scheme.border }}; --s-pt: {{ settings.padding_top }}px; --s-pb: {{ settings.padding_bottom }}px;">
  <div class="ss__in">
    {% if settings.heading %}<h2 class="ss__h">{{ settings.heading }}</h2>{% endif %}
    <div class="ss__grid">
      <div class="ss__media" aria-hidden="true">
        {% for block in section.blocks %}{% if block.settings.image %}<img class="ss__pic" style="animation-timeline: --ss{{ forloop.index }};" src="{{ block.settings.image | asset }}" alt="" width="1200" height="1500" loading="lazy">{% endif %}{% endfor %}
      </div>
      <ol class="ss__steps">
        {% for block in section.blocks %}
        <li class="ss__step" data-block-id="{{ block.id }}" style="view-timeline-name: --ss{{ forloop.index }};">
          <span class="ss__n">{{ forloop.index }}</span>
          <h3 class="ss__title">{{ block.settings.title }}</h3>
          {% if block.settings.text %}<p class="ss__text">{{ block.settings.text }}</p>{% endif %}
          {% if block.settings.image %}<img class="ss__inline" src="{{ block.settings.image | asset }}" alt="{{ block.settings.image_alt }}" width="1200" height="1500" loading="lazy">{% endif %}
        </li>
        {% else %}
        {% if page.in_editor %}<li class="ss__step">Add steps in the sidebar</li>{% endif %}
        {% endfor %}
      </ol>
    </div>
  </div>
</section>
</template>

<style scoped>
.ss { container-type: inline-size; padding: calc(var(--s-pt) * var(--theme-spacing-scale, 1)) var(--theme-padding-x, 16px) calc(var(--s-pb) * var(--theme-spacing-scale, 1)); background: var(--s-bg); color: var(--s-text); }
.ss__in { max-width: var(--theme-page-width, 1280px); margin: 0 auto; }
.ss__h { margin: 0 0 clamp(28px, 5vw, 64px); max-width: 20ch; font-family: var(--theme-font-heading), sans-serif; font-size: clamp(2rem, 1.2rem + 3.4vw, 4.4rem); line-height: 0.98; letter-spacing: -0.03em; font-weight: 700; color: var(--s-heading); }
.ss__grid { display: block; }
.ss__media { display: none; }
.ss__steps { list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(40px, 8vw, 72px); }
.ss__n { display: block; font-size: 0.9375rem; font-variant-numeric: tabular-nums; color: var(--s-accent); }
.ss__title { margin: 6px 0 10px; font-family: var(--theme-font-heading), sans-serif; font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.5rem); line-height: 1.02; letter-spacing: -0.02em; font-weight: 700; color: var(--s-heading); }
.ss__text { margin: 0; max-width: 48ch; font-size: 1.0625rem; line-height: 1.6; }
.ss__inline { display: block; width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; margin-top: 20px; }
/* Plain steps on a wider screen: words beside their own picture, never a picture the width of the page. */
@container (min-width: 760px) {
  .ss__step { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 4fr); grid-template-rows: auto auto 1fr; column-gap: clamp(24px, 4vw, 64px); align-items: start; }
  .ss__n, .ss__title, .ss__text { grid-column: 1; }
  .ss__inline { grid-column: 2; grid-row: 1 / span 3; margin-top: 0; }
}
/*
  The story, only on a wide screen whose browser ties animation to a named
  view timeline, and only when motion is welcome: the picture column sticks,
  each step names a timeline, and its picture fades in while that step is in
  the middle of the screen. Everywhere else the steps above are the layout.
*/
@supports (animation-timeline: view()) and (timeline-scope: none) {
  @media (prefers-reduced-motion: no-preference) {
    @container (min-width: 860px) {
      .ss:not([data-motion="off"]) .ss__in { timeline-scope: --ss1, --ss2, --ss3, --ss4, --ss5; }
      .ss:not([data-motion="off"]) .ss__grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: clamp(32px, 5vw, 96px); align-items: start; }
      .ss--media-right:not([data-motion="off"]) .ss__media { order: 2; }
      .ss:not([data-motion="off"]) .ss__media { display: block; position: sticky; top: 12svh; max-height: 76svh; aspect-ratio: 4 / 5; overflow: hidden; }
      .ss:not([data-motion="off"]) .ss__pic { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; animation: ss-show linear both; animation-range: cover 18% cover 82%; }
      .ss:not([data-motion="off"]) .ss__inline { display: none; }
      .ss:not([data-motion="off"]) .ss__step { min-height: 72svh; display: flex; flex-direction: column; justify-content: center; }
      @keyframes ss-show { 0% { opacity: 0; transform: scale(calc(1 + (var(--t-motion-scale, 1.06) - 1) * 0.5)); } 20%, 80% { opacity: 1; transform: none; } 100% { opacity: 0; transform: none; } }
    }
  }
}
</style>

<schema>
{
  "schema_version": 1,
  "type": "ai_sticky_story",
  "name": "Method, step by step",
  "category": "text",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "How the twelve weeks run" },
    { "type": "header", "id": "hdr_motion", "label": "Motion" },
    { "type": "select", "id": "motion", "label": "Motion", "default": "site", "options": [{ "label": "Picture stays while steps pass", "value": "site" }, { "label": "Plain steps", "value": "off" }] },
    { "type": "select", "id": "layout", "label": "Picture side", "default": "media-left", "options": [{ "label": "Left", "value": "media-left" }, { "label": "Right", "value": "media-right" }] },
    { "type": "header", "id": "hdr_style", "label": "Style" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "site" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    { "type": "step", "name": "Step", "limit": 5, "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "An hour on the floor together" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "We test how you move and lift, and agree what the first month is for." },
      { "type": "image_picker", "id": "image", "label": "Picture" },
      { "type": "text", "id": "image_alt", "label": "Picture description", "default": "" }
    ] }
  ],
  "presets": [{ "name": "Method, step by step", "blocks": [{ "type": "step", "settings": { "title": "An hour on the floor together", "text": "We test how you move and lift, and agree what the first month is for." } }, { "type": "step", "settings": { "title": "A plan for the hours you have", "text": "Three sessions a week, written for your gym or your garage, in the app by Sunday night." } }, { "type": "step", "settings": { "title": "A check in every Friday", "text": "Video of your top sets, a short call, and next week's numbers." } }] }]
}
</schema>
