{# example
title: Bottom sheet menu on phones, a panel on wide screens
summary: Chrome kit menu drawer, a section placed after the header: on a phone the menu rises from the bottom edge where the thumb is (a sheet with a grab bar, up to 88% of the screen), on a wide screen it is a panel at the top right under the header. Opened by every Menu button through the hooks (a dialog: focus kept inside and returned, Escape, the close button, the dimmed page and any link shut it). Quick action tiles (blocks: track an order, book, contact), the site's menu with sub links as accordions, and the language and currency switches. Sheet height, tile count, wide screen placement and motion are settings.
tags: chrome kit, menu drawer, bottom sheet, mobile menu, thumb zone, sheet, quick actions, accordion menu, app like menu, locale, currency, own chrome
#}
<template>
<div class="mbs" data-wide="{{ settings.wide_place }}" data-motion="{{ settings.motion }}" {% if page.in_editor and settings.editor_open %}data-editor-open{% endif %} data-scheme="{{ settings.color_scheme }}" style="--s-bg: {{ scheme.bg }}; --s-text: {{ scheme.text }}; --s-heading: {{ scheme.heading }}; --s-accent: {{ scheme.accent }}; --s-border: {{ scheme.border }}; --s-btn: {{ scheme.primary_btn_bg }}; --s-btn-text: {{ scheme.primary_btn_text }}; --mbs-h: {{ settings.height }}svh; --m-k: calc({{ settings.motion_strength }} / 100);">
  <div class="mbs__panel" data-storelib-menu-panel aria-label="{{ settings.panel_label }}">
    <button class="mbs__scrim" type="button" data-storelib-menu-close tabindex="-1" aria-label="{{ settings.close_label }}"></button>
    <div class="mbs__sheet">
      <span class="mbs__grab" aria-hidden="true"></span>
      <div class="mbs__head">
        <p class="mbs__title">{{ settings.panel_label }}</p>
        <button class="mbs__close" type="button" data-storelib-menu-close>{{ settings.close_label }}</button>
      </div>
      {% if section.blocks.size > 0 %}
      <ul class="mbs__tiles">
        {% for block in section.blocks %}<li data-block-id="{{ block.id }}"><a class="mbs__tile" href="{{ block.settings.url | url }}"><span class="mbs__tile-t">{{ block.settings.title }}</span>{% if block.settings.text %}<span class="mbs__tile-x">{{ block.settings.text }}</span>{% endif %}</a></li>{% endfor %}
      </ul>
      {% endif %}
      <nav aria-label="{{ settings.nav_label }}">
        <ul class="mbs__list">
          {% for link in settings.menu.links %}
          <li>
            {% if link.links.size > 0 %}
            <details class="mbs__acc">
              <summary class="mbs__link">{{ link.title }}<span class="mbs__chev" aria-hidden="true"></span></summary>
              <ul class="mbs__sub"><li><a href="{{ link.url }}">{{ settings.all_label }}</a></li>{% for child in link.links %}<li><a href="{{ child.url }}">{{ child.title }}</a></li>{% endfor %}</ul>
            </details>
            {% else %}
            <a class="mbs__link" href="{{ link.url }}">{{ link.title }}</a>
            {% endif %}
          </li>
          {% endfor %}
        </ul>
      </nav>
      <div class="mbs__prefs">
        <div class="mbs__pref" data-storelib-locale-list role="group" aria-label="{{ settings.language_label }}"><button class="mbs__opt" type="button" data-storelib-locale-option hidden><span data-option-label></span></button></div>
        <div class="mbs__pref" data-storelib-currency-list role="group" aria-label="{{ settings.currency_label }}"><button class="mbs__opt" type="button" data-storelib-currency-option hidden><span data-option-label></span></button></div>
      </div>
    </div>
  </div>
</div>
</template>

<style scoped>
.mbs, .mbs *, .mbs *::before, .mbs *::after { box-sizing: border-box; }
/* The page hides and shows parts with the hidden attribute (a list with one choice, the empty cart, the copied patterns): it always wins over a display set here. */
.mbs [hidden] { display: none !important; }
.mbs__panel { position: fixed; inset: 0; z-index: 80; visibility: hidden; }
.mbs__panel[data-open="true"], .mbs[data-editor-open] .mbs__panel { visibility: visible; }
.mbs[data-editor-open] .mbs__panel { position: relative; min-height: 680px; }
.mbs__scrim { position: absolute; inset: 0; width: 100%; padding: 0; border: 0; background: rgba(0, 0, 0, 0.45); opacity: 0; cursor: pointer; }
.mbs__panel[data-open="true"] .mbs__scrim, .mbs[data-editor-open] .mbs__scrim { opacity: 1; }
.mbs__sheet { position: absolute; inset: auto 0 0; display: flex; flex-direction: column; gap: 16px; max-height: var(--mbs-h, 88svh); padding: 8px 20px calc(20px + env(safe-area-inset-bottom, 0px)); overflow-y: auto; overscroll-behavior: contain; border-radius: 14px 14px 0 0; background: var(--s-bg); color: var(--s-text); transform: translateY(100%); }
.mbs__panel[data-open="true"] .mbs__sheet, .mbs[data-editor-open] .mbs__sheet { transform: none; }
.mbs__grab { align-self: center; width: 40px; height: 4px; border-radius: 2px; background: var(--s-border); }
.mbs__head { display: flex; align-items: center; justify-content: space-between; }
.mbs__title { margin: 0; color: var(--s-heading); font-family: var(--theme-font-heading), sans-serif; font-size: 1.375rem; font-weight: 700; letter-spacing: -0.02em; }
.mbs__close { min-height: 44px; padding: 0 14px; border: 0; background: color-mix(in srgb, var(--s-text) 8%, var(--s-bg)); color: inherit; font: inherit; border-radius: 4px; cursor: pointer; }
.mbs__tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(130px, 100%), 1fr)); gap: 8px; margin: 0; padding: 0; list-style: none; }
.mbs__tile { display: grid; gap: 2px; align-content: end; min-height: 76px; padding: 12px; border-radius: 4px; background: color-mix(in srgb, var(--s-text) 6%, var(--s-bg)); color: inherit; text-decoration: none; }
.mbs__tile:hover { background: var(--s-btn); color: var(--s-btn-text); }
.mbs__tile-t { font-weight: 600; }
.mbs__tile-x { font-size: 0.8125rem; }
.mbs__list { margin: 0; padding: 0; list-style: none; }
.mbs__link { display: flex; align-items: center; justify-content: space-between; min-height: 52px; color: var(--s-heading); text-decoration: none; font-size: 1.125rem; font-weight: 600; border-bottom: 1px solid var(--s-border); cursor: pointer; list-style: none; }
.mbs__link::-webkit-details-marker { display: none; }
.mbs__chev { width: 9px; height: 9px; border-right: 2px solid currentColor; border-bottom: 2px solid currentColor; transform: rotate(45deg); }
.mbs__acc[open] .mbs__chev { transform: rotate(-135deg); }
.mbs__sub { margin: 0; padding: 4px 0 8px 12px; list-style: none; }
.mbs__sub a { display: flex; align-items: center; min-height: 44px; color: inherit; text-decoration: none; }
.mbs__prefs { display: grid; gap: 8px; }
.mbs__pref { display: flex; flex-wrap: wrap; gap: 6px; }
.mbs__opt { min-height: 44px; padding: 0 12px; border: 1px solid var(--s-border); border-radius: 4px; background: none; color: inherit; font: inherit; cursor: pointer; }
.mbs__opt[aria-current="true"] { border-color: currentColor; font-weight: 600; }
.mbs :focus-visible { outline: 2px solid var(--s-accent); outline-offset: 2px; }
@media (prefers-reduced-motion: no-preference) {
  .mbs:not([data-motion="off"]) .mbs__panel { transition: visibility 0s linear var(--t-motion-duration, 650ms); }
  .mbs:not([data-motion="off"]) .mbs__panel[data-open="true"] { transition-delay: 0s; }
  .mbs:not([data-motion="off"]) .mbs__sheet { transition: transform calc(var(--t-motion-duration, 650ms) * 0.7) cubic-bezier(0.32, 0.72, 0, 1); }
  .mbs:not([data-motion="off"]) .mbs__scrim { transition: opacity calc(var(--t-motion-duration, 650ms) * 0.5) ease; }
  .mbs:not([data-motion="off"]) .mbs__panel[data-open="true"] .mbs__tile { animation: mbs-pop calc(var(--t-motion-duration, 650ms) * 0.8) var(--t-motion-ease, ease-out) 150ms both; }
  @keyframes mbs-pop { from { opacity: 0; transform: scale(calc(1 - 0.06 * var(--m-k, 1))); } }
}
@media (prefers-reduced-motion: reduce) { .mbs__panel, .mbs__sheet, .mbs__scrim, .mbs__tile { transition: none; animation: none; } }
@media (min-width: 900px) {
  .mbs__sheet { inset: 72px 24px auto auto; width: min(420px, calc(100% - 48px)); max-height: calc(100svh - 96px); border-radius: 6px; transform: translateY(-12px); opacity: 0; }
  .mbs[data-wide="left"] .mbs__sheet { inset: 72px auto auto 24px; }
  .mbs__panel[data-open="true"] .mbs__sheet, .mbs[data-editor-open] .mbs__sheet { opacity: 1; }
  .mbs__grab { display: none; }
  .mbs:not([data-motion="off"]) .mbs__sheet { transition: transform calc(var(--t-motion-duration, 650ms) * 0.5) var(--t-motion-ease, ease-out), opacity calc(var(--t-motion-duration, 650ms) * 0.4) ease; }
}
</style>

<schema>
{
  "schema_version": 1,
  "type": "ai_chrome_menu_bottom",
  "name": "Bottom sheet menu",
  "settings": [
    { "type": "paragraph", "id": "about", "content": "Opens from every Menu button on the page. Keep it right after the header." },
    { "type": "checkbox", "id": "editor_open", "label": "Keep it open in the editor", "default": false },
    { "type": "header", "id": "hdr_menu", "label": "Menu" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "header", "id": "hdr_layout", "label": "Layout" },
    { "type": "range", "id": "height", "label": "Tallest on a phone", "min": 50, "max": 95, "step": 1, "unit": "%", "default": 88 },
    { "type": "select", "id": "wide_place", "label": "On wide screens", "default": "right", "options": [{ "label": "Top right", "value": "right" }, { "label": "Top left", "value": "left" }] },
    { "type": "header", "id": "hdr_words", "label": "Words" },
    { "type": "text", "id": "panel_label", "label": "Title", "default": "Menu" },
    { "type": "text", "id": "nav_label", "label": "Links name (read aloud)", "default": "Main" },
    { "type": "text", "id": "close_label", "label": "Close button", "default": "Close" },
    { "type": "text", "id": "all_label", "label": "Link to the whole section", "default": "See all" },
    { "type": "text", "id": "language_label", "label": "Language (read aloud)", "default": "Language" },
    { "type": "text", "id": "currency_label", "label": "Currency (read aloud)", "default": "Currency" },
    { "type": "header", "id": "hdr_motion", "label": "Motion" },
    { "type": "select", "id": "motion", "label": "Motion", "default": "site", "options": [{ "label": "Follow the site", "value": "site" }, { "label": "Still", "value": "off" }] },
    { "type": "range", "id": "motion_strength", "label": "Strength", "min": 0, "max": 150, "step": 10, "unit": "%", "default": 100 },
    { "type": "header", "id": "hdr_style", "label": "Style" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "site" }
  ],
  "blocks": [
    { "type": "tile", "name": "Quick action", "limit": 4, "min_blocks": 2, "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Contact us" },
      { "type": "text", "id": "text", "label": "Line under it", "default": "" },
      { "type": "url", "id": "url", "label": "Link", "default": "/contact" }
    ] }
  ],
  "presets": [{ "name": "Bottom sheet menu", "blocks": [
    { "type": "tile", "settings": { "title": "Your account", "text": "Orders and returns", "url": "/account" } },
    { "type": "tile", "settings": { "title": "Contact us", "text": "We answer within a day", "url": "/contact" } }
  ] }]
}
</schema>
