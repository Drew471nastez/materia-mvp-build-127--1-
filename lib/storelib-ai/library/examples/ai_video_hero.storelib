{# example
title: Video hero with a real pause
summary: An opening screen over the creator's own muted video with the browser's own controls (so it can always be paused), a poster for slow connections, a heading set large and off centre, one action; no autoplay for people who asked for less motion is left to the controls.
tags: video hero, hero, video, background video, opening, cinematic, poster
#}
<template>
<section class="vh" data-scheme="{{ settings.color_scheme }}" style="--s-bg: {{ scheme.bg }}; --s-text: {{ scheme.text }}; --s-heading: {{ scheme.heading }}; --s-accent: {{ scheme.accent }};">
  <div class="vh__media">
    {% if settings.video %}
      <video class="vh__video" src="{{ settings.video | asset }}"{% if settings.poster %} poster="{{ settings.poster | asset }}"{% endif %} muted loop playsinline preload="metadata" controls{% if settings.autoplay %} autoplay{% endif %} aria-label="{{ settings.video_label }}"></video>
    {% elsif settings.poster %}
      <img class="vh__video" src="{{ settings.poster | asset }}" alt="{{ settings.video_label }}" width="1920" height="1080">
    {% endif %}
  </div>
  <div class="vh__copy">
    {% if settings.label %}<p class="vh__label">{{ settings.label }}</p>{% endif %}
    <h1 class="vh__h">{{ settings.heading }}</h1>
    {% if settings.cta_label and settings.cta_url %}<a class="vh__cta" href="{{ settings.cta_url | url }}">{{ settings.cta_label }}</a>{% endif %}
  </div>
</section>
</template>

<style scoped>
.vh { position: relative; display: grid; min-height: 88svh; background: var(--s-bg); color: var(--s-text); }
.vh__media { grid-area: 1 / 1; position: relative; overflow: hidden; }
.vh__video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
.vh__copy { grid-area: 1 / 1; align-self: end; position: relative; z-index: 1; padding: 0 var(--theme-padding-x, 16px) clamp(64px, 10vw, 120px); max-width: 1100px; pointer-events: none; }
.vh__copy a { pointer-events: auto; }
.vh__label { margin: 0 0 14px; font-size: 0.8125rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--s-text); }
.vh__h { margin: 0; font-family: var(--theme-font-heading), sans-serif; font-size: clamp(2.75rem, 1.2rem + 7vw, 8.5rem); line-height: 0.88; letter-spacing: -0.035em; font-weight: 600; color: var(--s-heading); text-wrap: balance; }
.vh__cta { display: inline-block; margin-top: 28px; padding: 14px 22px; background: var(--s-accent); color: var(--s-bg); text-decoration: none; }
.vh__cta:focus-visible { outline: 2px solid var(--s-text); outline-offset: 3px; }
@media (min-width: 900px) { .vh__copy { padding-left: 8vw; } }
</style>

<schema>
{
  "schema_version": 1,
  "type": "ai_video_hero",
  "name": "Video opening",
  "category": "hero",
  "settings": [
    { "type": "video_picker", "id": "video", "label": "Video" },
    { "type": "image_picker", "id": "poster", "label": "Still shown while it loads" },
    { "type": "text", "id": "video_label", "label": "What the video shows", "default": "The crew rigging lights on set" },
    { "type": "checkbox", "id": "autoplay", "label": "Play on its own (muted)", "default": true },
    { "type": "text", "id": "label", "label": "Small line above", "default": "Production company, Glasgow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Short films for people who make things" },
    { "type": "text", "id": "cta_label", "label": "Button", "default": "See the reel" },
    { "type": "url", "id": "cta_url", "label": "Button link", "default": "/about" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "site" }
  ]
}
</schema>
