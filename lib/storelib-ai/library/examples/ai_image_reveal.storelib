{# example
title: Image curtain and scale-in
summary: One key photograph that opens like a curtain and settles from a slight scale as it scrolls into view, on a CSS view timeline (clip-path and transform only), sized by the site's motion feel; strength and curtain direction are editable, phones get the scale only, reduced motion gets the still photo.
tags: image reveal, curtain, scale in, scale reveal, clip-path, photo, cinematic, scroll, view-timeline, motion tier, image curtain
#}
<template>
<section class="ir ir--{{ settings.width }}" data-motion="{{ settings.motion }}" data-curtain="{{ settings.curtain }}" data-scheme="{{ settings.color_scheme }}" style="--s-bg: {{ scheme.bg }}; --s-text: {{ scheme.text }}; --s-heading: {{ scheme.heading }}; --s-pt: {{ settings.padding_top }}px; --s-pb: {{ settings.padding_bottom }}px; --m-k: calc({{ settings.motion_strength }} / 100); --ir-ratio: {{ settings.ratio }};">
  <figure class="ir__fig">
    <div class="ir__frame">
      {% if settings.image %}<img class="ir__img" src="{{ settings.image | asset }}" alt="{{ settings.image_alt }}" width="2400" height="1600" loading="lazy">{% elsif page.in_editor %}<p class="ir__ph">Pick the photo this section is for in the sidebar</p>{% endif %}
    </div>
    {% if settings.caption %}<figcaption class="ir__cap">{{ settings.caption }}</figcaption>{% endif %}
  </figure>
</section>
</template>

<style scoped>
.ir { container-type: inline-size; padding: calc(var(--s-pt) * var(--theme-spacing-scale, 1)) 0 calc(var(--s-pb) * var(--theme-spacing-scale, 1)); background: var(--s-bg); color: var(--s-text); }
.ir--inset .ir__fig { max-width: min(var(--theme-page-width, 1280px), 100%); padding-inline: var(--theme-padding-x, 16px); }
.ir__fig { margin: 0 auto; }
.ir__frame { position: relative; overflow: hidden; aspect-ratio: var(--ir-ratio, 16 / 9); background: color-mix(in srgb, var(--s-text) 8%, var(--s-bg)); }
.ir__img { display: block; width: 100%; height: 100%; object-fit: cover; }
.ir__ph { display: grid; place-items: center; height: 100%; margin: 0; padding: 16px; text-align: center; opacity: 0.7; }
.ir__cap { display: flex; justify-content: space-between; gap: 16px; padding: 12px var(--theme-padding-x, 16px) 0; font-size: 0.875rem; line-height: 1.45; }
.ir--inset .ir__cap { padding-inline: 0; }
/* The whole photo is the default. The curtain and the settle only run where the browser ties them to scroll and motion is welcome. */
@supports (animation-timeline: view()) {
  @media (prefers-reduced-motion: no-preference) {
    .ir:not([data-motion="off"]) .ir__img { animation: ir-settle linear both; animation-timeline: view(); animation-range: entry 0% cover 45%; }
    /* A phone gets the settle only: a curtain across a narrow photo hides its subject. */
    @container (min-width: 601px) {
      .ir:not([data-motion="off"])[data-curtain="up"] .ir__frame { animation: ir-up linear both; animation-timeline: view(); animation-range: entry 0% entry 90%; }
      .ir:not([data-motion="off"])[data-curtain="side"] .ir__frame { animation: ir-side linear both; animation-timeline: view(); animation-range: entry 0% entry 90%; }
    }
    @keyframes ir-settle { from { transform: scale(calc(1 + (var(--t-motion-scale, 1.06) - 1) * var(--m-k, 1))); } to { transform: scale(1); } }
    @keyframes ir-up { from { clip-path: inset(calc(28% * var(--m-k, 1)) 0 0 0); } to { clip-path: inset(0); } }
    @keyframes ir-side { from { clip-path: inset(0 calc(18% * var(--m-k, 1))); } to { clip-path: inset(0); } }
  }
}
</style>

<schema>
{
  "schema_version": 1,
  "type": "ai_image_reveal",
  "name": "Photo that opens",
  "category": "image",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Photo" },
    { "type": "text", "id": "image_alt", "label": "Photo description", "default": "" },
    { "type": "text", "id": "caption", "label": "Caption", "default": "" },
    { "type": "select", "id": "width", "label": "Width", "default": "full", "options": [{ "label": "Edge to edge", "value": "full" }, { "label": "Inside the page", "value": "inset" }] },
    { "type": "select", "id": "ratio", "label": "Shape", "default": "16 / 9", "options": [{ "label": "Wide", "value": "16 / 9" }, { "label": "Cinema", "value": "21 / 9" }, { "label": "Classic", "value": "3 / 2" }, { "label": "Tall", "value": "4 / 5" }] },
    { "type": "header", "id": "hdr_motion", "label": "Motion" },
    { "type": "select", "id": "motion", "label": "Motion", "default": "site", "options": [{ "label": "Follow the site", "value": "site" }, { "label": "Still", "value": "off" }] },
    { "type": "select", "id": "curtain", "label": "Opens", "default": "up", "options": [{ "label": "From below", "value": "up" }, { "label": "From the sides", "value": "side" }, { "label": "No curtain, settle only", "value": "none" }] },
    { "type": "range", "id": "motion_strength", "label": "Strength", "min": 0, "max": 150, "step": 10, "unit": "%", "default": 100 },
    { "type": "header", "id": "hdr_style", "label": "Style" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "site" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 48 }
  ]
}
</schema>
