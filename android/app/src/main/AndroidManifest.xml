<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- Entry gate: session check → welcome screen or skip to main -->
        <activity
            android:name=".WelcomeActivity"
            android:label="@string/app_name"
            android:theme="@style/AppTheme.Welcome"
            android:exported="true"
            android:screenOrientation="portrait">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Capacitor WebView (no longer the launcher) -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:exported="true">

            <!--
                App Links: intercept https://storelib.com/app/auth/callback and
                the www. variant after Google OAuth completes.
                @capacitor/browser opens the OAuth URL in the system browser;
                when Supabase redirects to this URL the OS fires the App Link,
                closes the browser, and delivers appUrlOpen to the WebView JS.
                CapacitorAuthHandler calls exchangeCodeForSession(code) in the
                same WebView context where signInWithOAuth stored the PKCE
                code-verifier — no cookie-jar isolation issue.
                android:autoVerify="true" requires /.well-known/assetlinks.json
                at both storelib.com and www.storelib.com.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="storelib.com"
                    android:pathPrefix="/app/auth/callback" />
            </intent-filter>

            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="www.storelib.com"
                    android:pathPrefix="/app/auth/callback" />
            </intent-filter>

            <!-- Custom scheme deep link for OAuth callback (no assetlinks.json needed) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="storelib"
                    android:host="auth"
                    android:pathPrefix="/callback" />
            </intent-filter>

            <!-- Custom scheme deep link for password reset with bridge code -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="storelib"
                    android:host="reset-password" />
            </intent-filter>

            <!--
                App Links: intercept password-reset email links so they open
                inside the Storelib app instead of the system browser.
                Requires the existing /.well-known/assetlinks.json (already
                present and covers the whole storelib.com domain).
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="storelib.com"
                    android:pathPrefix="/reset-password" />
            </intent-filter>

            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="www.storelib.com"
                    android:pathPrefix="/reset-password" />
            </intent-filter>

            <!--
                App Links: intercept Stripe checkout success/cancel redirect
                so the user returns to the installed Storelib app instead of
                staying in the browser.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="storelib.com"
                    android:pathPrefix="/app/settings/billing" />
            </intent-filter>

            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="www.storelib.com"
                    android:pathPrefix="/app/settings/billing" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Microphone, for speaking a request to Storelib AI in the website
        builder (components/website-builder/ask-voice.ts). The page asks with
        getUserMedia; Capacitor's BridgeWebChromeClient turns that into the
        runtime RECORD_AUDIO request (MODIFY_AUDIO_SETTINGS is what the
        WebView needs to open the input), which Android shows each time until
        it is allowed. Not required hardware: a device without one installs,
        and simply has no microphone button.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- The live camera for the ID photo in payout setup (getUserMedia in the web view). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
</manifest>
