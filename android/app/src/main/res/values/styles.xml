<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!--
        Post-splash activity theme — applied by the SplashScreen API once the
        system splash exits (postSplashScreenTheme) and used directly on
        pre-Android-12 devices as the activity window theme.

        Every colour is set to the same light gray (#F3F4F6) that appears on
        the splash screen so there is NEVER a white or black frame visible:
          • android:windowBackground  — the area shown before the first View draw
          • android:statusBarColor    — status bar matches the background
          • android:navigationBarColor — navigation bar matches the background
    -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">#F3F4F6</item>
        <item name="android:statusBarColor">#F3F4F6</item>
        <item name="android:navigationBarColor">#F3F4F6</item>
    </style>

    <!--
        Launch / SplashScreen theme — set on MainActivity in AndroidManifest.xml.

        AndroidX SplashScreen API attributes (back-ported to API 23+):
          windowSplashScreenBackground        — full-screen background colour
          windowSplashScreenAnimatedIcon      — icon shown centred on the splash
          windowSplashScreenIconBackgroundColor — colour of the circle behind the
                                                 icon; matches background so no
                                                 coloured ring is visible
          postSplashScreenTheme               — theme applied to the activity
                                               window once the system splash exits

        Legacy fallback (pre-API-12 devices / OEMs that ignore the SplashScreen
        API) — these standard attributes are evaluated before the first frame:
          android:windowBackground            — same light gray, never black/white
          android:statusBarColor              — no jarring colour change
          android:navigationBarColor          — no jarring colour change
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <!-- SplashScreen API (AndroidX core-splashscreen library) -->
        <item name="windowSplashScreenBackground">#F3F4F6</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">#F3F4F6</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>

        <!-- Legacy / pre-12 fallback -->
        <item name="android:windowBackground">#F3F4F6</item>
        <item name="android:statusBarColor">#F3F4F6</item>
        <item name="android:navigationBarColor">#F3F4F6</item>
    </style>

    <!-- Welcome screen: full-screen dark, no action bar, no white flash. -->
    <style name="AppTheme.Welcome" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">#050505</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

</resources>
