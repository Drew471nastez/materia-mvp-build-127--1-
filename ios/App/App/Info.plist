<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- ── App identity ──────────────────────────────────────────────────── -->
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Storelib</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!-- ── Orientation support ──────────────────────────────────────────── -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- ── Camera & photo library — REQUIRED for @capacitor/camera ──────── -->
	<key>NSCameraUsageDescription</key>
	<string>Storelib uses the camera to let you take photos for your product listings and profile picture.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Storelib accesses your photo library so you can choose images for products and your profile.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Storelib saves photos to your library when you request it.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Storelib may use the microphone when recording video for product previews.</string>

	<!-- ── Location — REQUIRED for the delivery-point picker ─────────────────
	     WKWebView refuses the JavaScript Geolocation API outright unless this
	     key is present: no prompt is shown and the call fails silently, which
	     looks like a broken feature rather than a missing permission.

	     WhenInUse only. Nothing here needs a position while backgrounded, and
	     asking for Always would be a worse review and a worse prompt for no
	     gain. Location is used to sort easyboxes by distance at checkout and is
	     never stored — see components/shipping/use-geolocation.ts.

	     The app asks in its own words first (LocationPrompt) before this alert
	     is shown, because iOS shows it only ONCE per install. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Storelib uses your location to show the easybox delivery points nearest to you. Your location is never saved.</string>

	<!-- ── Push notifications ────────────────────────────────────────────── -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<string>fetch</string>
	</array>

	<!-- ── Firebase (manual APNs → FCM exchange, no swizzling) ──────────── -->
	<key>FirebaseAppDelegateProxyEnabled</key>
	<false/>

	<!-- ── Queryable URL schemes (required for App.openUrl / canOpenURL) ── -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>whatsapp</string>
		<string>twitter</string>
		<string>fb</string>
		<string>fbauth2</string>
	</array>

	<!-- ── Deep linking / OAuth callback ────────────────────────────────── -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.storelib.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.storelib.app</string>
			</array>
		</dict>
	</array>

	<!-- ── ATS — allow the Capacitor server URL ──────────────────────────── -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>storelib.com</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<false/>
				<key>NSIncludesSubdomains</key>
				<true/>
			</dict>
		</dict>
	</dict>

	<!-- ── WKWebView settings ───────────────────────────────────────────── -->
	<key>WKAppBoundDomains</key>
	<array>
		<string>storelib.com</string>
	</array>

	<!-- ── Misc ─────────────────────────────────────────────────────────── -->
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiresFullScreen</key>
	<false/>
	<key>UIStatusBarHidden</key>
	<false/>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
