      "blocks": {
        "heading_1": {
          "type": "heading",
          "settings": {
            "text": "Questions before you start",
            "tag": "h2",
            "size_enable": true,
            "size_desktop": 44,
            "size_mobile": 30,
            "weight_enable": true,
            "weight": "700"
          }
        },
        "subheading_1": {
          "type": "subheading",
          "settings": {
            "text": "<p>Anything else? <a href=\"/pages/contact\">Write to us</a> and we answer within a day.</p>"
          }
        },
        "faq_item_1": {
          "type": "faq_item",
          "settings": {
            "question": "Do I need Canva Pro?",
            "answer": "<p>No. Every project works on the free plan. Where a Pro feature saves time, the lesson shows it and a free way to do the same thing.</p>"
          }
        },
        "faq_item_2": {
          "type": "faq_item",
          "settings": {
            "question": "I have never designed anything. Is that a problem?",
            "answer": "<p>No. The course starts with the brand kit and the basics of layout, and most students have never opened a design app before.</p>"
          }
        },
        "faq_item_3": {
          "type": "faq_item",
          "settings": {
            "question": "How long until I make something?",
            "answer": "<p>The brand kit is the end of module one. With two hours a week, most people have it in the first week and a poster in the second.</p>"
          }
        },
        "faq_item_4": {
          "type": "faq_item",
          "settings": {
            "question": "Can I follow along on a tablet?",
            "answer": "<p>Yes. The lessons are recorded on a laptop, and a short lesson shows where things are in the tablet and phone apps.</p>"
          }
        },
        "faq_item_5": {
          "type": "faq_item",
          "settings": {
            "question": "Can I use the templates for clients?",
            "answer": "<p>Yes, for your own business and for client work. You cannot resell the templates themselves as templates.</p>"
          }
        },
        "faq_item_6": {
          "type": "faq_item",
          "settings": {
            "question": "How long do I have access?",
            "answer": "<p>For good. You also get the new templates and notes added each month.</p>"
          }
        }
      },
