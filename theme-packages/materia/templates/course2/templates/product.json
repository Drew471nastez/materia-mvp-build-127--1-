    "curriculum": {
      "type": "course2-curriculum",
      "settings": {
        "tag": "Curriculum",
        "heading": "Seven modules,",
        "heading_accent": "in the order you need them",
        "text": "<p>Each module is a handful of short lessons. Watch one, go to the machine, come back for the next.</p>",
        "totals": "7 modules, 46 lessons, 6 hours",
        "first_open": true,
        "anchor": "",
        "accent": "#12704f",
        "padding_top": 64
      },
      "blocks": {
        "module_1": {
          "type": "module",
          "settings": {
            "title": "Beans and freshness",
            "meta": "5 lessons, 32 min",
            "lessons": "Reading a coffee bag\nRoast dates and resting\nStoring beans at home\nOne bag, three brews\nWhat to buy next"
          }
        },
        "module_2": {
          "type": "module",
          "settings": {
            "title": "Grinding and dose",
            "meta": "6 lessons, 48 min",
            "lessons": "Why the grinder matters most\nSetting a starting point\nWeighing the dose\nDistribution without tools\nTamping, briefly\nCleaning the burrs"
          }
        },
        "module_3": {
          "type": "module",
          "settings": {
            "title": "Espresso: the first shot",
            "meta": "8 lessons, 64 min",
            "lessons": "What a shot should taste like\nDose, yield and time\nPull your first shot\nRead the colour\nWhen it runs too fast\nWhen it chokes\nTemperature and your machine\nA shot log that helps"
          }
        },
        "module_4": {
          "type": "module",
          "settings": {
            "title": "Dialling in",
            "meta": "7 lessons, 55 min",
            "lessons": "Sour or bitter?\nOne change at a time\nThree shots to a new bag\nRatios for milk drinks\nRatios for black coffee\nWhen to give up on a bag\nPractice: dial in live"
          }
        },
        "module_5": {
          "type": "module",
          "settings": {
            "title": "Milk and steaming",
            "meta": "8 lessons, 60 min",
            "lessons": "Cold milk, clean jug\nWhere the wand goes\nStretch, then spin\nMilk for a flat white\nMilk for a cappuccino\nOat and other milks\nCleaning the wand\nCommon mistakes"
          }
        },
        "module_6": {
          "type": "module",
          "settings": {
            "title": "Latte art",
            "meta": "7 lessons, 58 min",
            "lessons": "Holding the cup\nThe pour height\nPour a heart\nPour a tulip\nPour a rosetta\nPractising with water and soap\nWhen the milk is wrong"
          }
        },
        "module_7": {
          "type": "module",
          "settings": {
            "title": "Filter and pour over",
            "meta": "5 lessons, 44 min",
            "lessons": "Grind for filter\nBloom and wait\nThe four pour recipe\nCafetiere, properly\nTaste and adjust"
          }
        }
      },
      "block_order": [
        "module_1",
