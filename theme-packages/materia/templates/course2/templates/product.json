    "faq": {
      "type": "course2-faq",
      "settings": {
        "tag": "Questions",
        "heading": "Straight answers",
        "heading_accent": "before you buy",
        "text": "<p>The questions people ask most. Anything else, <a href=\"/pages/contact\">write to us</a>.</p>",
        "accent": "#12704f"
      },
      "blocks": {
        "question_1": {
          "type": "question",
          "settings": {
            "question": "What machine do I need?",
            "answer": "<p>Any home espresso machine with a steam wand, and a grinder. The lessons use a single boiler machine and a hand grinder, and every step works the same on bigger ones.</p>"
          }
        },
        "question_2": {
          "type": "question",
          "settings": {
            "question": "Do I need a scale?",
            "answer": "<p>Yes, any kitchen scale that reads to a tenth of a gram. It is the cheapest thing that makes the biggest difference.</p>"
          }
        },
        "question_3": {
          "type": "question",
          "settings": {
            "question": "I only drink filter coffee. Is it for me?",
            "answer": "<p>The last module and the recipe cards cover pour over and cafetiere. The grinding lessons apply to both.</p>"
          }
        },
        "question_4": {
          "type": "question",
          "settings": {
            "question": "How long do I have access?",
            "answer": "<p>For good. Watch on a phone, a tablet or a computer, and come back to any lesson whenever you like.</p>"
          }
        },
        "question_5": {
          "type": "question",
          "settings": {
            "question": "What if it is not for me?",
            "answer": "<p>Write within 30 days and we refund you in full. Replace this with your own terms.</p>"
          }
        }
      },
      "block_order": [
        "question_1",
        "question_2",
        "question_3",
        "question_4",
        "question_5"
      ]
