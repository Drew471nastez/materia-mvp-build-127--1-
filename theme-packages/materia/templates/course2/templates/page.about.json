      "blocks": {
        "eyebrow_1": {
          "type": "eyebrow",
          "settings": {
            "text": "How it works",
            "custom_style": true,
            "color": "#b5471c",
            "size": 13
          }
        },
        "heading_1": {
          "type": "heading",
          "settings": {
            "text": "One evening a week, in the right order",
            "tag": "h2",
            "size_desktop": 46,
            "size_mobile": 32
          }
        },
        "subheading_1": {
          "type": "subheading",
          "settings": {
            "text": "<p>Most beginners stall because they buy tools before they know what to make. The course gives you one project at a time and the few tools it needs.</p>",
            "size": 16
          }
        },
        "step_1": {
          "type": "step",
          "settings": {
            "title": "Watch a short lesson",
            "description": "<p>Five to ten minutes, filmed over the bench so you see the tool, both hands and the line.</p>"
          }
        },
        "step_2": {
          "type": "step",
          "settings": {
            "title": "Practise on offcuts",
            "description": "<p>Every lesson ends with a drill on scrap wood. Ten saw cuts before you touch the real board.</p>"
          }
        },
        "step_3": {
          "type": "step",
          "settings": {
            "title": "Build the project",
            "description": "<p>Each module ends with a piece you keep: a cutting board, a shelf, a stool, a box, a side table.</p>"
          }
        },
        "step_4": {
          "type": "step",
          "settings": {
            "title": "Send a photo, get feedback",
            "description": "<p>With feedback, send photos of your joint and Tom replies with a short video on what to change.</p>"
          }
        },
        "button_1": {
          "type": "button",
          "settings": {
            "label": "Start learning",
            "url": "/#buy"
          }
        }
      },
