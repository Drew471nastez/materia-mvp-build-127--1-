          "settings": {
            "text": "Twenty minutes a day, in the right order",
            "tag": "h2",
            "size_desktop": 46,
            "size_mobile": 32
          }
        },
        "subheading_1": {
          "type": "subheading",
          "settings": {
            "text": "<p>Most beginners stop because they do not know what to practise next. Each day in the course tells you.</p>",
            "size": 16
          }
        },
        "step_1": {
          "type": "step",
          "settings": {
            "title": "Watch a short lesson",
            "description": "<p>Five to eight minutes, filmed close up so you can see both hands. Slow it down or loop a part.</p>"
          }
        },
        "step_2": {
          "type": "step",
          "settings": {
            "title": "Play along",
            "description": "<p>A track at three speeds for every lesson. Start slow, move up when it feels easy.</p>"
          }
        },
        "step_3": {
          "type": "step",
          "settings": {
            "title": "Tick it off",
            "description": "<p>Your plan moves on by itself. Miss a day and it picks up where you left off.</p>"
          }
        },
        "step_4": {
          "type": "step",
          "settings": {
            "title": "Send a video, get feedback",
            "description": "<p>With feedback, record yourself and Jonas replies with a short video on what to change.</p>"
          }
        },
        "button_1": {
          "type": "button",
          "settings": {
            "label": "Start learning",
            "url": "/#buy"
          }
        }
