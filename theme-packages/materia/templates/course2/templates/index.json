    "curriculum": {
      "type": "course2-curriculum",
      "settings": {
        "tag": "Curriculum",
        "heading": "Eight modules,",
        "heading_accent": "from first chord to whole songs",
        "text": "<p>Each module is a handful of short lessons and ends with a practice week. Do them in order; every lesson uses what the last one taught.</p>",
        "totals": "8 modules, 64 lessons, about 8 hours",
        "first_open": true,
        "anchor": "curriculum",
        "accent": "#e5372a",
        "heading_color": "#0d0d0f",
        "text_color": "#4a4d55",
        "line_color": "#e3e4e8",
        "background": "#ffffff",
        "heading_size": 46
      },
      "blocks": {
        "module_1": {
          "type": "module",
          "settings": {
            "title": "Your guitar and your hands",
            "meta": "6 lessons, 38 min",
            "lessons": "Holding the guitar\nTuning by ear and with an app\nYour picking hand\nYour fretting hand\nReading a chord box\nA practice routine that sticks"
          }
        },
        "module_2": {
          "type": "module",
          "settings": {
            "title": "First chords",
            "meta": "9 lessons, 62 min",
            "lessons": "E minor and A minor\nC, G and D\nChanging chords in time\nThe one minute change\nYour first two chord song\nCommon buzzing fixes\nA four chord loop\nPlaying with a metronome\nPractice week"
          }
        },
        "module_3": {
          "type": "module",
          "settings": {
            "title": "Strumming and rhythm",
            "meta": "8 lessons, 54 min",
            "lessons": "Down strums in time\nAdding ups\nThe pattern in most pop songs\nMuting and accents\nStrumming in 3/4\nPlaying with a drum track\nKeeping going through mistakes\nPractice week"
          }
        },
        "module_4": {
          "type": "module",
          "settings": {
            "title": "Your first five songs",
            "meta": "10 lessons, 76 min",
            "lessons": "Song one, slow then full speed\nSong two: a new chord shape\nSong three: a new strum\nSong four: a capo\nSong five: putting it together\nIntros and endings\nPlaying from a chord sheet\nSinging and playing\nRecording yourself\nPractice week"
          }
        },
        "module_5": {
          "type": "module",
          "settings": {
            "title": "Riffs and power chords",
            "meta": "8 lessons, 58 min",
            "lessons": "Single note riffs\nPalm muting\nPower chords on two strings\nMoving shapes up the neck\nThree famous style riffs\nA little distortion, electric only\nPlaying tight with a track\nPractice week"
          }
        },
        "module_6": {
          "type": "module",
          "settings": {
            "title": "Barre chords without tears",
            "meta": "8 lessons, 60 min",
            "lessons": "Why barre chords are hard\nThe F that finally rings\nE shape barre chords\nA shape barre chords\nSwitching to and from barres\nStrength without strain\nSongs with barre chords\nPractice week"
          }
        },
        "module_7": {
          "type": "module",
          "settings": {
            "title": "Fingerpicking",
            "meta": "7 lessons, 50 min",
            "lessons": "Thumb and fingers\nA first pattern\nTravis picking, slowly\nPicking through a chord change\nA fingerpicked song\nMixing picking and strumming\nPractice week"
          }
        },
        "module_8": {
          "type": "module",
          "settings": {
            "title": "Playing songs by yourself",
            "meta": "8 lessons, 66 min",
            "lessons": "Finding chords for a song\nChoosing a key that suits you\nSimplifying hard chords\nBuilding a set of ten songs\nPlaying for friends\nWhere to go next\nYour own practice plan\nGraduation song"
          }
        }
      },
      "block_order": [
        "module_1",
        "module_2",
        "module_3",
        "module_4",
        "module_5",
        "module_6",
        "module_7",
        "module_8"
      ]
    },
