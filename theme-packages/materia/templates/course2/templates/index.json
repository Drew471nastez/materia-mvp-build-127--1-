      "blocks": {
        "eyebrow_1": {
          "type": "eyebrow",
          "settings": {
            "text": "How it works",
            "custom_style": true,
            "color": "#b5471c",
            "size": 13
          }
        },
        "heading_1": {
          "type": "heading",
          "settings": {
            "text": "Two hours a week, in the right order",
            "tag": "h2",
            "size_desktop": 46,
            "size_mobile": 32
          }
        },
        "subheading_1": {
          "type": "subheading",
          "settings": {
            "text": "<p>Most people open Canva, pick a template and end up with posts that look like everyone else's. The course gives you a few rules and one project at a time.</p>",
            "size": 16
          }
        },
        "step_1": {
          "type": "step",
          "settings": {
            "title": "Watch a short lesson",
            "description": "<p>Five to ten minutes, recorded on screen so you see every click, with Clara explaining why.</p>"
          }
        },
        "step_2": {
          "type": "step",
          "settings": {
            "title": "Redo a real design",
            "description": "<p>Every lesson ends with a short exercise: take a messy post and fix one thing, then compare with the answer.</p>"
          }
        },
        "step_3": {
          "type": "step",
          "settings": {
            "title": "Make the project",
            "description": "<p>Each project is something your business uses: a brand kit, a poster, a carousel, a thumbnail set, a price guide.</p>"
          }
        },
        "step_4": {
          "type": "step",
          "settings": {
            "title": "Send a design, get feedback",
            "description": "<p>With feedback, share a link to your design and Clara replies with a short screen recording on what to change.</p>"
          }
        },
        "button_1": {
          "type": "button",
          "settings": {
            "label": "Start learning",
            "url": "/#buy"
          }
        }
      },
