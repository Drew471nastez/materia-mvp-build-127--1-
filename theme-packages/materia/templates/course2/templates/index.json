    "curriculum": {
      "type": "course2-curriculum",
      "settings": {
        "tag": "Curriculum",
        "heading": "Eight modules,",
        "heading_accent": "from a straight cut to a side table",
        "text": "<p>Each module is a handful of short lessons and ends with something you build. Do them in order; every joint uses what the last one taught.</p>",
        "totals": "8 modules, 56 lessons, about 7 hours",
        "first_open": true,
        "anchor": "curriculum",
        "accent": "#b5471c",
        "heading_color": "#1b1712",
        "text_color": "#4f4943",
        "line_color": "#e5e0d8",
        "background": "#ffffff",
        "heading_size": 46
      },
      "blocks": {
        "module_1": {
          "type": "module",
          "settings": {
            "title": "Your bench and your tools",
            "meta": "6 lessons, 40 min",
            "lessons": "A bench you can build or borrow\nThe eleven tools you need\nBuying second hand\nSetting up a block plane\nClamps, and how many\nWorking safely without fuss"
          }
        },
        "module_2": {
          "type": "module",
          "settings": {
            "title": "Measuring and marking",
            "meta": "7 lessons, 48 min",
            "lessons": "Rules, tapes and squares\nChecking a square is square\nThe knife line\nThe marking gauge\nFace side and face edge\nWriting a cut list\nProject: a cutting board"
          }
        },
        "module_3": {
          "type": "module",
          "settings": {
            "title": "Sawing straight",
            "meta": "8 lessons, 56 min",
            "lessons": "Holding the saw\nStarting a cut\nCrosscuts\nRip cuts\nSawing to the line, not near it\nFixing a cut that wanders\nSawing a tenon cheek\nPractice on offcuts"
          }
        },
        "module_4": {
          "type": "module",
          "settings": {
            "title": "Sharpening and planing",
            "meta": "8 lessons, 62 min",
            "lessons": "Sharpening a chisel on stones\nSharpening a plane iron\nPlaning a face flat\nPlaning an edge square\nEnd grain without tear out\nReading the grain\nThicknessing by hand\nPractice on offcuts"
          }
        },
        "module_5": {
          "type": "module",
          "settings": {
            "title": "Chisels and simple joints",
            "meta": "7 lessons, 54 min",
            "lessons": "Paring to a line\nChopping across the grain\nThe housing joint\nThe half lap\nThe rebate\nFixing a gappy joint\nProject: a wall shelf"
          }
        },
        "module_6": {
          "type": "module",
          "settings": {
            "title": "Mortise and tenon",
            "meta": "8 lessons, 64 min",
            "lessons": "Laying out the joint\nChopping a mortise\nSawing the tenon\nFitting it snug\nDrawboring with a peg\nA square glue up\nProject: a step stool, part one\nProject: a step stool, part two"
          }
        },
        "module_7": {
          "type": "module",
          "settings": {
            "title": "Dovetails",
            "meta": "6 lessons, 44 min",
            "lessons": "Through dovetails, tails first\nSawing the tails\nMarking and cutting pins\nGlue, clamps and a dry fit\nScraping, sanding and oil\nProject: a dovetailed box"
          }
        },
        "module_8": {
          "type": "module",
          "settings": {
            "title": "Your first side table",
            "meta": "6 lessons, 58 min",
            "lessons": "Drawing the table\nThe cut list and the timber\nLegs and aprons\nGluing up the top\nAssembly in one evening\nThe finish, and what to build next"
          }
        }
      },
      "block_order": [
        "module_1",
        "module_2",
        "module_3",
        "module_4",
        "module_5",
        "module_6",
        "module_7",
        "module_8"
      ]
    },
