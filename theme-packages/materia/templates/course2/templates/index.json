    "curriculum": {
      "type": "course2-curriculum",
      "settings": {
        "tag": "Curriculum",
        "heading": "Eight modules,",
        "heading_accent": "from a brand kit to a month of posts",
        "text": "<p>Each module is a handful of short lessons and ends with something you make. Do them in order; every project uses what the last one taught.</p>",
        "totals": "8 modules, 56 lessons, about 7 hours",
        "first_open": true,
        "anchor": "curriculum",
        "accent": "#b5471c",
        "heading_color": "#1b1712",
        "text_color": "#4f4943",
        "line_color": "#e5e0d8",
        "background": "#ffffff",
        "heading_size": 46
      },
      "blocks": {
        "module_1": {
          "type": "module",
          "settings": {
            "title": "Your brand kit",
            "meta": "6 lessons, 40 min",
            "lessons": "Free or Pro, and what you really need\nTwo fonts and no more\nA colour palette from one photo\nThe logo files you need\nSetting up the brand kit\nFolders that stay tidy"
          }
        },
        "module_2": {
          "type": "module",
          "settings": {
            "title": "Layout basics",
            "meta": "7 lessons, 48 min",
            "lessons": "Margins and grids\nLining things up\nOne thing first: hierarchy\nWhite space is not empty\nThe order people read in\nFixing a crowded design\nProject: an event poster"
          }
        },
        "module_3": {
          "type": "module",
          "settings": {
            "title": "Type that reads",
            "meta": "8 lessons, 56 min",
            "lessons": "Pairing a heading and body font\nSizes that read on a phone\nLine length and spacing\nText on top of photos\nQuotes and big numbers\nCapitals, bold and italics\nWhen to use less text\nPractice: three headline layouts"
          }
        },
        "module_4": {
          "type": "module",
          "settings": {
            "title": "Colour and photos",
            "meta": "8 lessons, 62 min",
            "lessons": "Using your palette on every post\nContrast you can read\nChoosing photos that fit\nCropping and framing\nRemoving a background\nShooting your own product photos\nA consistent filter\nPractice on real photos"
          }
        },
        "module_5": {
          "type": "module",
          "settings": {
            "title": "Posts and carousels",
            "meta": "7 lessons, 54 min",
            "lessons": "The sizes for each platform\nA first slide people stop for\nCarousels people swipe to the end\nTemplates you reuse every week\nBatching a month of posts\nScheduling and file names\nProject: a ten slide carousel"
          }
        },
        "module_6": {
          "type": "module",
          "settings": {
            "title": "Stories and thumbnails",
            "meta": "8 lessons, 64 min",
            "lessons": "Story layouts\nThumbnails that read small\nCovers that match your grid\nFaces, arrows and big words\nSimple animation\nExporting video without blur\nProject: a thumbnail set, part one\nProject: a thumbnail set, part two"
          }
        },
        "module_7": {
          "type": "module",
          "settings": {
            "title": "Print and documents",
            "meta": "6 lessons, 44 min",
            "lessons": "Flyers and menus\nBusiness cards\nBleed, margins and print settings\nOrdering from a printer\nPrice lists and PDFs\nProject: a two page price guide"
          }
        },
        "module_8": {
          "type": "module",
          "settings": {
            "title": "Slides and downloads",
            "meta": "6 lessons, 58 min",
            "lessons": "A slide deck template\nChecklists and workbooks\nAn ebook layout\nExporting clean PDFs\nSharing files with clients\nWhat to design next"
          }
        }
      },
      "block_order": [
        "module_1",
        "module_2",
        "module_3",
        "module_4",
        "module_5",
        "module_6",
        "module_7",
        "module_8"
      ]
    },
