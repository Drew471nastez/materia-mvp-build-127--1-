    "readme": {
      "type": "xpshop-window",
      "settings": {
        "title": "readme.txt",
        "icon": "note",
        "look": "plain",
        "show_menubar": true,
        "image": "shopify://shop_images/xpshop-about.webp",
        "image_alt": "A black tee with a yellow balloon print that says New drop is ready",
        "show_placeholder": false,
