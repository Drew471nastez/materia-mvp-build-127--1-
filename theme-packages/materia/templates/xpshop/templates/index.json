    "help": {
      "type": "xpshop-help",
      "settings": {
        "title": "Help and questions",
        "icon": "help",
        "heading": "Questions people ask",
        "heading_tag": "h2",
        "subheading": "Sizes, delivery, returns and the prints.",
        "show_find": true,
        "find_label": "Search the questions",
        "none_label": "No question matches that. Write to us instead.",
        "open_first": true,
        "end_text": "Still wondering about something?",
        "end_label": "Write to us",
        "end_link": "/pages/contact",
        "width": 1180,
        "padding_top": 0,
        "padding_bottom": 28,
        "padding_top_mobile": 0,
        "padding_bottom_mobile": 16
      },
      "blocks": {
        "q_1": {
          "type": "question",
          "settings": {
            "question": "Which size should I take?",
            "answer": "<p>Tees and crews are cut a little boxy with a dropped shoulder. If you are between two sizes, take the smaller one for a closer fit. Every product page has the measurements.</p>"
          }
        },
        "q_2": {
          "type": "question",
          "settings": {
            "question": "When will my order arrive?",
            "answer": "<p>Each piece is printed when you order it and leaves within two working days, tracked. Add your own delivery times on the <a href=\"/pages/shipping\">shipping page</a>.</p>"
          }
        },
        "q_3": {
          "type": "question",
          "settings": {
            "question": "Can I send something back?",
            "answer": "<p>Yes, within 30 days if it is unworn and unwashed. Write to us with your order number and we send a return label. See the <a href=\"/policies/refund-policy\">refund policy</a>.</p>"
          }
        },
        "q_4": {
          "type": "question",
          "settings": {
            "question": "Will the print crack or fade?",
            "answer": "<p>The prints are water based ink pressed into the cotton, so they stay soft. Wash cold and inside out, hang to dry, and they last as long as the tee.</p>"
          }
        }
      },
      "block_order": [
        "q_1",
        "q_2",
        "q_3",
        "q_4"
      ]
