    "faq": {
      "type": "xpshop-help",
      "settings": {
        "title": "Help and questions",
        "icon": "help",
        "heading": "Before you order",
        "heading_tag": "h2",
        "subheading": "Sizes, delivery, returns and the prints.",
        "show_find": false,
        "find_label": "Search the questions",
        "none_label": "No question matches that. Write to us instead.",
