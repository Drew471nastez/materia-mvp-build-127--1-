{
  "sections": {
    "main": {
      "type": "main-article",
      "settings": {
        "padding_top": 56,
        "section_width": "container",
        "padding_bottom": 40,
        "content_width_desktop": 760
      },
      "blocks": {
        "title_1": {
          "type": "title",
          "settings": {
            "blog_title_font_size": 44
          }
        },
        "blog_meta_2": {
          "type": "blog_meta",
          "settings": {
            "enable_custom_style": false
          }
        },
        "featured_image_3": {
          "type": "featured_image",
          "settings": {
            "image_height": "medium",
            "featured_image_top_padding": 16,
            "featured_image_border_radius": 12,
            "featured_image_bottom_padding": 16
          }
        },
        "content_article_4": {
          "type": "content_article",
          "settings": {}
        },
        "author_highlight_5": {
          "type": "author_highlight",
          "settings": {
            "author_text": "Thanks for reading.",
            "author_image_size": 56
          }
        }
      },
      "block_order": [
        "title_1",
        "blog_meta_2",
        "featured_image_3",
        "content_article_4",
        "author_highlight_5"
      ]
    },
    "posts": {
      "type": "blog-posts",
      "settings": {
        "heading": "More from the journal",
        "items_per_row": 3,
        "items_to_show": 3,
        "image_ratio": "custom",
        "custom_ratio": "4:3",
        "show_date": true,
        "show_author": false,
        "show_view_all": true,
        "section_width": "container",
        "content_alignment": "left",
        "heading_font_size": 32,
        "padding_top": 56,
        "padding_bottom": 96,
        "carousel_pagination": "disable",
        "items_per_row_mobile": 1,
        "column_gap": 32
      }
    }
  },
  "order": [
    "main",
    "posts"
  ]
}
