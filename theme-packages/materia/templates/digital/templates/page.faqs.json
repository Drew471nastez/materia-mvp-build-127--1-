        "faq_item_3": {
          "type": "faq_item",
          "settings": {
            "question": "How do I get my files?",
            "answer": "<p>The download link is on the confirmation page and in your receipt email, as soon as you pay.</p>"
          }
        },
        "faq_item_4": {
          "type": "faq_item",
          "settings": {
            "question": "Which software do I need?",
            "answer": "<p>Each product page lists the apps and versions the files work with.</p>"
          }
        },
        "faq_item_5": {
          "type": "faq_item",
          "settings": {
            "question": "Can I use these in client work?",
            "answer": "<p>Yes. The standard licence covers personal and commercial projects. You cannot resell the files themselves.</p>"
          }
        },
        "faq_item_6": {
          "type": "faq_item",
          "settings": {
            "question": "Do I get updates?",
            "answer": "<p>Yes. When a pack is updated you can download the new version free from your receipt.</p>"
          }
        },
        "faq_item_7": {
          "type": "faq_item",
          "settings": {
            "question": "Can I get a refund?",
            "answer": "<p>Digital files cannot be returned, but if something does not work we will fix it or refund you.</p>"
          }
        },
