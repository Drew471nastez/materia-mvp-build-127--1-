        "faq_item_2": {
          "type": "faq_item",
          "settings": {
            "question": "How do I get my files?",
            "answer": "<p>As soon as you pay, the download link is on the order page and in your receipt email. Nothing is posted.</p>"
          }
        },
        "faq_item_3": {
          "type": "faq_item",
          "settings": {
            "question": "What if the email does not arrive?",
            "answer": "<p>Check your spam folder first. If it is not there, write to us with the email you used at checkout and we will send the link again.</p>"
          }
        },
        "faq_item_4": {
          "type": "faq_item",
          "settings": {
            "question": "Which apps open the files?",
            "answer": "<p>Every product page lists the format, the file size and the apps it works with. If you are not sure, ask before you buy.</p>"
          }
        },
        "faq_item_5": {
          "type": "faq_item",
          "settings": {
            "question": "Do I get updates?",
            "answer": "<p>Yes. When a file is updated, the new version is free. Download it from the same email.</p>"
          }
        }
      },
