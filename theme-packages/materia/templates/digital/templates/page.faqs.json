        },
        "subheading_2": {
          "type": "subheading",
          "settings": {
            "text": "<p>Still stuck? <a href=\"/pages/contact\">Write to us</a> with your order number and we will reply within one working day.</p>"
          }
        },
        "faq_item_3": {
          "type": "faq_item",
          "settings": {
            "question": "Can I use the files in client work?",
            "answer": "<p>Yes. The licence covers personal and commercial projects. You cannot resell or share the files themselves.</p>"
          }
        },
        "faq_item_4": {
          "type": "faq_item",
          "settings": {
            "question": "Can I share a file with a friend or my team?",
            "answer": "<p>No. Each licence is for one person. For a team, buy one per person or write to us for a team price.</p>"
          }
        },
        "faq_item_5": {
          "type": "faq_item",
          "settings": {
            "question": "Can I get a refund?",
            "answer": "<p>A download cannot be returned, but if a file is broken or not what the page described, we will fix it or refund you.</p>"
          }
        }
      },
