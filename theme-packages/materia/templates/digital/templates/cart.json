{
  "sections": {
    "heading": {
      "type": "page-heading",
      "settings": {
        "height": "adapt",
        "alignment": "left",
        "padding_top": 56,
        "color_scheme": "default",
        "reset_spacing": true,
        "section_width": "container",
        "padding_bottom": 0
      },
      "blocks": {
        "heading_1": {
          "type": "heading",
          "settings": {
            "page_title": "Your cart",
            "header_size": "default",
            "vertical_gap": 8,
            "heading_font_size": 44
          }
        }
      },
      "block_order": [
        "heading_1"
      ]
    },
    "cart-items": {
      "type": "main-cart-items",
      "settings": {
        "padding_top": 32,
        "reset_spacing": true,
        "section_width": "container",
        "padding_bottom": 96,
        "enable_cart_note": false,
        "enable_discount_code": true,
        "show_estimate_shipping": false
      },
      "blocks": {
        "faq_section_1": {
          "type": "faq_section",
          "settings": {
            "show_faq": true,
            "faq_heading": "Before you pay"
          }
        },
        "faq_2": {
          "type": "faq",
          "settings": {
            "question": "When do I get the files?",
            "answer": "<p>Straight away. The download link is on the order page and in your receipt email.</p>"
          }
        },
        "faq_3": {
          "type": "faq",
          "settings": {
            "question": "Is anything posted?",
            "answer": "<p>No. Everything here is a download, so there is no shipping to pay.</p>"
          }
        },
        "faq_4": {
          "type": "faq",
          "settings": {
            "question": "Can I use them for clients?",
            "answer": "<p>Yes. The licence covers personal and client work. You cannot resell the files.</p>"
          }
        },
        "payment_badges_5": {
          "type": "payment_badges",
          "settings": {
            "show_amex": true,
            "show_visa": true,
            "show_amazon": false,
            "show_klarna": false,
            "show_paypal": false,
            "show_discover": false,
            "show_apple_pay": true,
            "show_google_pay": true,
            "show_mastercard": true,
            "show_payment_badges": true
          }
        }
      },
      "block_order": [
        "faq_section_1",
        "faq_2",
        "faq_3",
        "faq_4",
        "payment_badges_5"
      ]
    },
    "more": {
      "type": "products-grid",
      "settings": {
        "heading": "You might also want",
        "text": "",
        "items_to_show": 4,
        "show_add_to_cart": false,
        "button_label": "See all files",
        "button_link": "/collections/all",
        "items_per_row": 4,
        "items_per_row_mobile": 2,
        "column_gap": 24,
        "header_alignment": "left",
        "color_scheme": "default",
        "section_width": "container",
        "padding_top": 24,
        "padding_bottom": 96,
        "reset_spacing": true
      }
    }
  },
  "order": [
    "heading",
    "cart-items",
    "more"
  ]
}
