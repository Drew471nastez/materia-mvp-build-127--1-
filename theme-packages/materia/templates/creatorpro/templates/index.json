    "faq": {
      "type": "authorbook-faq",
      "settings": {
        "eyebrow": "Questions",
        "heading": "Good questions",
        "accent_color": "#e8401c",
        "icon_bg": "#f5f4f0",
        "text": "<p>Anything else? <a href=\"/pages/contact\">Send me a message</a> and I will reply within two days.</p>"
      },
      "blocks": {
        "question_1": {
          "type": "question",
          "settings": {
            "question": "Which course should I start with?",
            "answer": "<p>If you have an audience of any size and want to sell something, Launch Lab. If you are starting from nothing and want to make videos, YouTube from Zero. Not sure? Watch the free workshop first.</p>"
          }
        },
        "question_2": {
          "type": "question",
          "settings": {
            "question": "Do I need a big audience first?",
            "answer": "<p>No. Launch Lab is built for people with a small list or none at all. The first offer you make is small on purpose.</p>"
          }
        },
        "question_3": {
          "type": "question",
          "settings": {
            "question": "How long do I keep access?",
            "answer": "<p>For as long as the courses exist, including every update. Lessons work on a phone, a tablet or a laptop.</p>"
          }
        },
        "question_4": {
          "type": "question",
          "settings": {
            "question": "What if a course is not for me?",
            "answer": "<p>Write within 14 days and you get a full refund. Replace this with your own terms.</p>"
          }
        }
      },
      "block_order": [
        "question_1",
        "question_2",
        "question_3",
        "question_4"
      ]
