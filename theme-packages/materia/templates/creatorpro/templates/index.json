          "type": "faq_item",
          "settings": {
            "question": "Which course should I start with?",
            "answer": "<p>If you have an audience of any size and want to sell something, Launch Lab. If you are starting from nothing and want to make videos, YouTube from Zero.</p>"
          }
        },
        "faq_item_4": {
          "type": "faq_item",
          "settings": {
            "question": "Do I need a big audience first?",
            "answer": "<p>No. Launch Lab is built for people with a small list or none at all. The first offer you make is small on purpose.</p>"
          }
        },
        "faq_item_5": {
          "type": "faq_item",
          "settings": {
            "question": "How long do I keep access?",
            "answer": "<p>For as long as the courses exist, including every update. Lessons work on a phone, a tablet or a laptop.</p>"
          }
        },
        "faq_item_6": {
          "type": "faq_item",
          "settings": {
            "question": "What if a course is not for me?",
            "answer": "<p>Write within 14 days and you get a full refund.</p>"
          }
        },
        "faq_item_7": {
          "type": "faq_item",
          "settings": {
            "question": "Do you do sponsorships?",
