/* Templates round 22: rebuilt from the theme's own sections (split hero, scrolling words, image with steps, featured product, product grid, image with text, testimonials, newsletter with image, follow block, blog posts, FAQ). */
{
  "sections": {
    "letter": {
      "type": "newsletter-split",
      "settings": {
        "color_scheme": "default",
        "image": "shopify://shop_images/creatorpro-ig-4.webp",
        "image_alt": "Nina recording at her desk with headphones on",
        "image_position": "left",
        "image_ratio": "square",
        "form_layout": "horizontal",
        "btn_text": "Join free",
        "email_placeholder": "Your email",
        "note": "Every Tuesday. Leave whenever you like.",
        "success_text": "You are in. The next letter arrives on Tuesday."
      },
      "blocks": {
        "heading_1": {
          "type": "heading",
          "settings": {
            "text": "The Tuesday Letter"
          }
        },
        "subheading_2": {
          "type": "subheading",
          "settings": {
            "text": "<p>One useful email a week: what I tried in my own business, what worked and what I would do differently. Short, and you can use it the same day.</p>"
          }
        }
      },
      "block_order": [
        "heading_1",
        "subheading_2"
      ]
    },
    "inside": {
      "type": "text-columns",
      "settings": {
        "color_scheme": "scheme-2b5c6c91-201d-4fb1-aba3-e6d562656976",
        "columns_desktop": 3,
        "show_dividers": true
      },
      "blocks": {
        "heading_1": {
          "type": "heading",
          "settings": {
            "text": "What a letter looks like"
          }
        },
        "column_2": {
          "type": "column",
          "settings": {
            "label": "Every Tuesday",
            "heading": "One idea",
            "text": "<p>Something I tried that week, with the numbers when I have them.</p>"
          }
        },
        "column_3": {
          "type": "column",
          "settings": {
            "label": "Five minutes",
            "heading": "Short on purpose",
            "text": "<p>Written to read with a coffee and use the same afternoon.</p>"
          }
        },
        "column_4": {
          "type": "column",
          "settings": {
            "label": "Always free",
            "heading": "No sales every week",
            "text": "<p>I mention a course when one opens, a few times a year.</p>"
          }
        }
      },
      "block_order": [
        "heading_1",
        "column_2",
        "column_3",
        "column_4"
      ]
    },
    "students": {
      "type": "testimonials4",
      "settings": {
        "color_scheme": "default",
        "text_align": "center",
        "max_width": 820,
        "autoplay_s": 7
      },
      "blocks": {
        "eyebrow_1": {
          "type": "eyebrow",
          "settings": {
            "text": "Students"
          }
        },
        "heading_2": {
          "type": "heading",
          "settings": {
            "text": "What changed for them"
          }
        },
        "subheading_3": {
          "type": "subheading",
          "settings": {
            "text": "<p>Sample quotes to show the layout. Replace them with your students' words, with their permission.</p>"
          }
        },
        "testimonial_4": {
          "type": "testimonial",
          "settings": {
            "rating": 0,
            "body": "I had been planning a course for a year. Launch Lab made me sell a small workshop first, and that paid for the course before I built it.",
            "name": "Sample student",
            "role": "Launch Lab",
            "avatar": "shopify://shop_images/creatorpro-student-1.webp"
          }
        },
        "testimonial_5": {
          "type": "testimonial",
          "settings": {
            "rating": 0,
            "body": "The filming lessons are the first ones that did not assume I owned a studio. My phone and a window were enough.",
            "name": "Sample student",
            "role": "YouTube from Zero",
            "avatar": "shopify://shop_images/creatorpro-student-2.webp"
          }
        },
        "testimonial_6": {
          "type": "testimonial",
          "settings": {
            "rating": 0,
            "body": "I read the Tuesday letter before anything else that morning. It is short and there is always one thing I can try.",
            "name": "Sample reader",
            "role": "The Tuesday Letter",
            "avatar": "shopify://shop_images/creatorpro-student-3.webp"
          }
        },
        "testimonial_7": {
          "type": "testimonial",
          "settings": {
            "rating": 0,
            "body": "Nina is clear about what is worth your time and what is not. I stopped posting everywhere and grew faster.",
            "name": "Sample student",
            "role": "Launch Lab",
            "avatar": "shopify://shop_images/creatorpro-student-4.webp"
          }
        }
      },
      "block_order": [
        "eyebrow_1",
        "heading_2",
        "subheading_3",
        "testimonial_4",
        "testimonial_5",
        "testimonial_6",
        "testimonial_7"
      ]
    }
  },
  "order": [
    "letter",
    "inside",
    "students"
  ]
}
