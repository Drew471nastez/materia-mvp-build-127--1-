      "name": "main-collection-product",
      "blocks": {
        "block-mvmkffsh-1-pcnzc": {
          "type": "categories",
          "settings": {
            "title": "Category"
          }
        },
        "block-mvmkfj68-2-iqqos": {
          "type": "filter",
          "settings": {}
        }
      },
      "block_order": [
        "block-mvmkffsh-1-pcnzc",
        "block-mvmkfj68-2-iqqos"
      ]
