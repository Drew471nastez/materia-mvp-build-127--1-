        "color_scheme": "default",
        "filter_layout": "horizontal",
        "items_per_row": 4,
        "items_to_show": 12,
        "reset_spacing": true,
        "section_width": "fluid_container",
        "default_filter": "open_all",
        "empty_link_url": "/collections/all",
        "padding_bottom": 60,
        "vertical_posion": "left",
        "button_show_more": "Show more",
        "enable_filtering": false,
        "show_filter_counts": true,
        "items_per_row_mobile": "1",
        "toolbar_button_style": "minimal",
        "number_products_per_page": true
