/* Templates round 22: rebuilt from the theme's own sections (split hero, scrolling words, image with steps, featured product, product grid, image with text, testimonials, newsletter with image, follow block, blog posts, FAQ). */
{
  "sections": {
    "main-collection-heading": {
      "type": "main-collection-heading",
      "settings": {
        "height": "adapt",
        "alignment": "left",
        "padding_top": 48,
        "color_scheme": "default",
        "reset_spacing": true,
        "section_width": "fluid_container",
        "padding_bottom": 24,
        "show_collection_image": false
      },
      "name": "main-collection-heading",
      "blocks": {
        "breadcrumb": {
          "type": "breadcrumb",
          "settings": {}
        },
        "heading": {
          "type": "heading",
          "settings": {
            "header_size": "default"
          }
        },
        "description": {
          "type": "description",
          "settings": {}
        }
      },
      "block_order": [
        "breadcrumb",
        "heading",
        "description"
      ]
    },
    "main-collection-product": {
      "type": "main-collection-product",
      "settings": {
        "sorting": true,
        "column_gap": 30,
