            "max_height": 200
          }
        },
        "heading_2": {
          "type": "heading",
          "settings": {
            "eyebrow": "Free workshop",
            "heading": "The First Offer *Workshop*",
            "size": 30
          }
        },
        "text_3": {
          "type": "text",
          "settings": {
            "text": "<p>45 minutes on choosing what to sell first and how to price it, with the worksheet.</p>"
          }
        },
        "field_4": {
          "type": "field",
          "settings": {
            "kind": "name",
            "label": "First name",
            "required": false
          }
        },
        "field_5": {
          "type": "field",
          "settings": {
            "kind": "email",
            "label": "Email address"
          }
        },
        "button_6": {
          "type": "button",
          "settings": {
            "label": "Send me the workshop",
            "arrow": true
          }
        },
        "note_7": {
          "type": "note",
          "settings": {
            "icon": "lock",
            "text": "Your email stays private.",
            "small": "<p>You also get the Tuesday Letter. Leave whenever you like.</p>"
          }
        }
      },
      "block_order": [
        "image_1",
        "heading_2",
        "text_3",
        "field_4",
        "field_5",
        "button_6",
        "note_7"
