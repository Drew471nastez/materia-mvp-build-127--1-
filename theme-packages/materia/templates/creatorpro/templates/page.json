/* Templates round 22: rebuilt from the theme's own sections (split hero, scrolling words, image with steps, featured product, product grid, image with text, testimonials, newsletter with image, follow block, blog posts, FAQ). */
{
  "sections": {
    "main": {
      "type": "page-default",
      "settings": {
        "padding_top": 48,
        "reset_spacing": true,
        "section_width": "container",
        "padding_bottom": 72
      }
    },
    "letter": {
      "type": "newsletter-split",
      "settings": {
        "color_scheme": "scheme-4faf0e4d-27f4-4d02-bc51-617383bab1a9",
        "image": "shopify://shop_images/creatorpro-podcast.webp",
        "image_alt": "Nina recording at her desk with headphones on",
        "image_position": "left",
        "image_ratio": "square",
        "form_layout": "horizontal",
        "btn_text": "Join free",
        "email_placeholder": "Your email",
        "note": "Every Tuesday. Leave whenever you like.",
        "success_text": "You are in. The next letter arrives on Tuesday."
      },
      "blocks": {
        "heading_1": {
          "type": "heading",
          "settings": {
            "text": "The Tuesday Letter"
          }
        },
        "subheading_2": {
          "type": "subheading",
          "settings": {
            "text": "<p>One useful email a week: what I tried in my own business, what worked and what I would do differently. Short, and you can use it the same day.</p>"
          }
        }
      },
      "block_order": [
        "heading_1",
        "subheading_2"
      ]
    }
  },
  "order": [
    "main",
    "letter"
  ]
}
