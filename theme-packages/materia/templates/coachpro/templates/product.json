    "faq": {
      "type": "faq-pro",
      "settings": {
        "color_scheme": "default",
        "first_item_open": true,
        "content_alignment": "center",
        "max_content_width": 820
      },
      "blocks": {
        "heading_1": {
          "type": "heading",
          "settings": {
            "text": "Questions"
          }
        },
        "subheading_2": {
          "type": "subheading",
          "settings": {
            "text": "<p>Something else? <a href=\"/pages/contact\">Write to me</a>. I answer within two working days.</p>"
          }
        },
        "faq_item_3": {
          "type": "faq_item",
          "settings": {
            "question": "Who do you work with?",
            "answer": "<p>Designers, makers, architects and studio owners who are good at the work and tired of the business side. Most run a studio of one to ten people.</p>"
          }
        },
        "faq_item_4": {
          "type": "faq_item",
          "settings": {
            "question": "Which programme is right for me?",
            "answer": "<p>Price It Right if pricing is the main problem. Studio Foundations for the whole picture, in a group. One to one when you are making a bigger change and want it private.</p>"
          }
        },
        "faq_item_5": {
          "type": "faq_item",
          "settings": {
            "question": "When does the next round start?",
            "answer": "<p>Studio Foundations runs twice a year, in March and September, with twelve places in each round.</p>"
          }
        },
        "faq_item_6": {
          "type": "faq_item",
          "settings": {
            "question": "Can I pay in parts?",
            "answer": "<p>Yes. Studio Foundations can be paid in full or in three monthly parts.</p>"
          }
        },
        "faq_item_7": {
          "type": "faq_item",
          "settings": {
            "question": "What if it is not for me?",
            "answer": "<p>Price It Right has a 14 day refund. For the group, tell me after the first two calls and I refund in full.</p>"
          }
        }
      },
