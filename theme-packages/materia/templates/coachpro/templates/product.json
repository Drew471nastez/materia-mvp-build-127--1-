        "collapsible_row_2": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How it works",
            "content": "<p>After you pay you get an email with your login and, for live programmes, the call dates for your calendar. Everything is online, so you can join from anywhere.</p>",
            "use_product_description": false,
            "open": false
          }
        },
        "collapsible_row_3": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Refunds",
            "content": "<p>Programmes: tell me within the first two weeks and I refund you in full. Courses: within 30 days. No forms, just an email.</p>",
            "use_product_description": false,
            "open": false
          }
        },
        "collapsible_row_4": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Not sure which one?",
            "content": "<p>Start with the <a href=\"/pages/worksheet\">free pricing worksheet</a>, or <a href=\"/pages/contact\">send me a question</a> and I will tell you honestly which fits.</p>",
            "use_product_description": false,
            "open": false
          }
