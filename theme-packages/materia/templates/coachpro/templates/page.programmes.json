/* Templates round 22: rebuilt from the theme's own sections (collage hero, image with text, rows, promo banner, testimonials, newsletter with image, gallery, FAQ, banner); Lora and Open Sans. */
{
  "sections": {
    "heading": {
      "type": "page-heading",
      "settings": {
        "height": "adapt",
        "alignment": "center",
        "padding_top": 72,
        "padding_bottom": 40,
        "color_scheme": "default",
        "reset_spacing": true,
        "section_width": "container",
        "overlay_opacity": 0
      },
      "blocks": {
        "heading_1": {
          "type": "heading",
          "settings": {
            "page_title": "",
            "header_size": "medium",
            "heading_font_size": 48
          }
        },
        "description_2": {
          "type": "description",
          "settings": {
            "description": "<p>A group programme, a short course and private mentoring. All of them start with what your studio actually earns.</p>",
            "enable_custom_style": false,
            "description_font_size": 17
          }
        }
      },
      "block_order": [
        "heading_1",
        "description_2"
      ]
    },
    "programmes": {
      "type": "image-with-text-multirow",
      "settings": {
        "color_scheme": "default",
        "alternate_rows": true,
        "image_aspect_w": 4,
        "image_aspect_h": 5,
        "text_column_width": 50
      },
      "blocks": {
        "row_1": {
          "type": "row",
          "settings": {
            "image": "shopify://shop_images/coachpro-foundations.webp",
            "caption": "12 weeks, in a group of twelve",
            "heading": "Studio Foundations",
            "body": "<p>Set prices you can say out loud, find two or three clients worth keeping and build a week with real edges. A live call every Tuesday, short lessons in between, and me in your corner. Next round starts in March.</p>",
            "btn_label": "See the programme",
            "btn_link": "/collections/all"
          }
        },
        "row_2": {
          "type": "row",
          "settings": {
            "image": "shopify://shop_images/coachpro-pricing.webp",
            "caption": "Self paced, about three hours",
            "heading": "Price It Right",
            "body": "<p>The numbers behind a fair quote: your real hourly cost, a day rate that holds and how to present a price without apologising for it. Comes with the calculator I still use.</p>",
            "btn_label": "Start the course",
            "btn_link": "/collections/all"
          }
        },
        "row_3": {
          "type": "row",
          "settings": {
            "image": "shopify://shop_images/coachpro-mentoring.webp",
            "caption": "Three months, two places a quarter",
            "heading": "One to one mentoring",
            "body": "<p>For a bigger move: hiring your first person, raising every price at once or changing what the studio does. Fortnightly calls and quick answers between them.</p>",
            "btn_label": "Apply for a place",
            "btn_link": "/pages/contact"
          }
        }
      },
      "block_order": [
        "row_1",
        "row_2",
        "row_3"
      ]
    },
    "stories": {
      "type": "testimonials",
      "settings": {
        "color_scheme": "scheme-2b5c6c91-201d-4fb1-aba3-e6d562656976",
        "display_mode": "grid",
        "columns": 3,
        "header_alignment": "center",
        "card_style": "clean",
        "card_align": "left",
        "show_rating": false,
        "show_quote_mark": true,
        "avatar_shape": "circle"
      },
      "blocks": {
        "eyebrow_1": {
          "type": "eyebrow",
          "settings": {
            "enabled": true,
            "text": "Client stories"
          }
        },
        "heading_2": {
          "type": "heading",
          "settings": {
            "enabled": true,
            "text": "What changed in their studios"
          }
        },
        "subheading_3": {
          "type": "subheading",
          "settings": {
            "enabled": true,
            "text": "<p>Sample stories to show the layout. Replace them with your clients' own words and photos, with their permission.</p>"
          }
        },
        "testimonial_4": {
          "type": "testimonial",
          "settings": {
            "quote": "<p>I raised my day rate by a third and the clients I actually wanted stayed. The worksheet alone paid for the programme.</p>",
            "rating": 0,
            "name": "Mei L.",
            "role": "Ceramics studio, Studio Foundations",
            "avatar": "shopify://shop_images/coachpro-client-1.webp"
          }
        },
        "testimonial_5": {
          "type": "testimonial",
          "settings": {
            "quote": "<p>For the first time I know what a project earns before I say yes to it, not three months after.</p>",
            "rating": 0,
            "name": "Hanna V.",
            "role": "Brand designer, Price It Right",
            "avatar": "shopify://shop_images/coachpro-client-2.webp"
          }
        },
        "testimonial_6": {
          "type": "testimonial",
          "settings": {
            "quote": "<p>We went from four day weeks that ran to ten hours each to a proper Friday off, and the studio earns more.</p>",
            "rating": 0,
            "name": "Rosa M.",
            "role": "Interior studio, one to one",
            "avatar": "shopify://shop_images/coachpro-client-3.webp"
          }
        },
        "testimonial_7": {
          "type": "testimonial",
          "settings": {
            "quote": "<p>Camila asks the question you were hoping nobody would ask, then helps you answer it. Every single Tuesday.</p>",
            "rating": 0,
            "name": "Joan P.",
            "role": "Architect, Studio Foundations",
            "avatar": "shopify://shop_images/coachpro-client-4.webp"
          }
        },
        "testimonial_8": {
          "type": "testimonial",
          "settings": {
            "quote": "<p>I stopped offering a discount on the first call. That one change was worth the whole course.</p>",
            "rating": 0,
            "name": "Tom R.",
            "role": "Furniture maker, Price It Right",
            "avatar": "shopify://shop_images/coachpro-client-5.webp"
          }
        },
        "testimonial_9": {
          "type": "testimonial",
          "settings": {
            "quote": "<p>The one page plan is on my wall. I look at it every Monday and it has changed how I say yes.</p>",
            "rating": 0,
            "name": "Ines C.",
            "role": "Illustrator, one to one",
            "avatar": "shopify://shop_images/coachpro-client-1.webp"
          }
        }
      },
      "block_order": [
        "eyebrow_1",
        "heading_2",
        "subheading_3",
        "testimonial_4",
        "testimonial_5",
        "testimonial_6",
        "testimonial_7",
        "testimonial_8",
        "testimonial_9"
      ]
    },
    "faq": {
      "type": "faq-pro",
      "settings": {
        "color_scheme": "default",
        "first_item_open": true,
        "content_alignment": "center",
        "max_content_width": 820
      },
      "blocks": {
        "heading_1": {
          "type": "heading",
          "settings": {
            "text": "Before you apply"
          }
        },
        "subheading_2": {
          "type": "subheading",
          "settings": {
            "text": "<p>Something else? <a href=\"/pages/contact\">Write to me</a>. I answer within two working days.</p>"
          }
        },
        "faq_item_3": {
          "type": "faq_item",
          "settings": {
            "question": "Who do you work with?",
            "answer": "<p>Designers, makers, architects and studio owners who are good at the work and tired of the business side. Most run a studio of one to ten people.</p>"
          }
        },
        "faq_item_4": {
          "type": "faq_item",
          "settings": {
            "question": "Which programme is right for me?",
            "answer": "<p>Price It Right if pricing is the main problem. Studio Foundations for the whole picture, in a group. One to one when you are making a bigger change and want it private.</p>"
          }
        },
        "faq_item_5": {
          "type": "faq_item",
          "settings": {
            "question": "When does the next round start?",
            "answer": "<p>Studio Foundations runs twice a year, in March and September, with twelve places in each round.</p>"
          }
        },
        "faq_item_6": {
          "type": "faq_item",
          "settings": {
            "question": "Can I pay in parts?",
            "answer": "<p>Yes. Studio Foundations can be paid in full or in three monthly parts.</p>"
          }
        },
        "faq_item_7": {
          "type": "faq_item",
          "settings": {
            "question": "What if it is not for me?",
            "answer": "<p>Price It Right has a 14 day refund. For the group, tell me after the first two calls and I refund in full.</p>"
          }
        }
      },
      "block_order": [
        "heading_1",
        "subheading_2",
        "faq_item_3",
        "faq_item_4",
        "faq_item_5",
        "faq_item_6",
        "faq_item_7"
      ]
    },
    "cta": {
      "type": "banner3",
      "settings": {
        "color_scheme": "scheme-4faf0e4d-27f4-4d02-bc51-617383bab1a9",
        "banner_surface": "section",
        "max_width": 700,
        "pad_top_desktop": 96,
        "pad_bottom_desktop": 96
      },
      "blocks": {
        "eyebrow_1": {
          "type": "eyebrow",
          "settings": {
            "text": "Work with me",
            "transform": "uppercase"
          }
        },
        "heading_2": {
          "type": "heading",
          "settings": {
            "text": "Not sure where to start?",
            "transform": "none"
          }
        },
        "subheading_3": {
          "type": "subheading",
          "settings": {
            "text": "Listen to an episode, take the free worksheet, or apply for the next round of Studio Foundations."
          }
        },
        "button_4": {
          "type": "button",
          "settings": {
            "label": "See the programmes",
            "link": "/pages/programmes"
          }
        }
      },
      "block_order": [
        "eyebrow_1",
        "heading_2",
        "subheading_3",
        "button_4"
      ]
    }
  },
  "order": [
    "heading",
    "programmes",
    "stories",
    "faq",
    "cta"
  ]
}
