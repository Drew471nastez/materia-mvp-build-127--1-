/* Templates round 22: rebuilt from the theme's own sections (collage hero, image with text, rows, promo banner, testimonials, newsletter with image, gallery, FAQ, banner); Lora and Open Sans. */
{
  "sections": {
    "main": {
      "type": "main-search",
      "settings": {
        "sorting": true,
        "column_gap": 28,
        "pagination": "infinit_scrolling",
        "padding_top": 24,
        "filter_layout": "horizontal",
        "items_per_row": 3,
        "items_to_show": 12,
        "section_width": "container",
        "default_filter": "open_all",
        "padding_bottom": 48,
        "vertical_posion": "left",
        "button_show_more": "Show more",
        "enable_filtering": false,
        "show_filter_counts": true,
        "items_per_row_mobile": 1,
        "number_products_per_page": true
      }
    },
    "cta": {
      "type": "banner3",
      "settings": {
        "color_scheme": "scheme-4faf0e4d-27f4-4d02-bc51-617383bab1a9",
        "banner_surface": "section",
        "max_width": 700,
        "pad_top_desktop": 96,
        "pad_bottom_desktop": 96
      },
      "blocks": {
        "eyebrow_1": {
          "type": "eyebrow",
          "settings": {
            "text": "Work with me",
            "transform": "uppercase"
          }
        },
        "heading_2": {
          "type": "heading",
          "settings": {
            "text": "Not sure where to start?",
            "transform": "none"
          }
        },
        "subheading_3": {
          "type": "subheading",
          "settings": {
            "text": "Listen to an episode, take the free worksheet, or apply for the next round of Studio Foundations."
          }
        },
        "button_4": {
          "type": "button",
          "settings": {
            "label": "See the programmes",
            "link": "/pages/programmes"
          }
        }
      },
      "block_order": [
        "eyebrow_1",
        "heading_2",
        "subheading_3",
        "button_4"
      ]
    }
  },
  "order": [
    "main",
    "cta"
  ]
}
