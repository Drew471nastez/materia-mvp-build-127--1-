      "blocks": {
        "heading_xwFKKa": {
          "type": "heading",
          "settings": {
            "page_title": "",
            "header_size": "medium",
            "vertical_gap": 14,
            "heading_font_size": 36,
            "enable_heading_color": false
          }
        },
        "description_YRWpkt": {
          "type": "description",
          "settings": {
            "description": "<p>Notes on pricing, clients and running a small creative studio.</p>",
            "enable_custom_style": false,
            "description_font_size": 16
          }
        }
      },
      "block_order": [
