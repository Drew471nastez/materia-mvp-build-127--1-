        "image_position": "left",
        "image_ratio": "portrait",
        "image_width": 45,
        "form_layout": "horizontal",
        "btn_text": "Send me the worksheet",
        "email_placeholder": "Your email",
        "note": "One email on Sundays after that. Unsubscribe in one click.",
        "success_text": "Thank you. The worksheet is on its way to your inbox."
      },
      "blocks": {
        "heading_1": {
          "type": "heading",
          "settings": {
            "text": "Price your next project in twenty minutes"
          }
        },
        "subheading_2": {
          "type": "subheading",
          "settings": {
            "text": "<p>The worksheet I use with every client: your real cost per hour, a day rate you can defend and a short script for sending the number. Free, with a ten minute video.</p>"
          }
        }
      },
      "block_order": [
        "heading_1",
        "subheading_2"
      ]
    },
    "cta": {
      "type": "banner3",
      "settings": {
        "color_scheme": "scheme-4faf0e4d-27f4-4d02-bc51-617383bab1a9",
