/* Templates round 22: rebuilt from the theme's own sections (collage hero, image with text, rows, promo banner, testimonials, newsletter with image, gallery, FAQ, banner); Lora and Open Sans. */
{
  "sections": {
    "story": {
      "type": "Image-and-video-text",
      "settings": {
        "color_scheme": "default",
        "image": "shopify://shop_images/coachpro-about.webp",
        "image_alt": "Camila Duarte in her studio",
        "image_position": "right",
        "aspect_w": 4,
        "aspect_h": 5,
        "image_radius": 2
      },
      "blocks": {
        "eyebrow_1": {
          "type": "eyebrow",
          "settings": {
            "text": "About"
          }
        },
        "heading_2": {
          "type": "heading",
          "settings": {
            "text": "Camila Duarte",
            "tag": "h1"
          }
        },
        "subheading_3": {
          "type": "subheading",
          "settings": {
            "text": "<p>I opened my interior studio at twenty eight with one client and no idea what to charge. For years I said yes to everything, priced by feel and worked most evenings.</p><p>What changed it was boring: knowing my real costs, writing a one page plan each January and saying no kindly. I have taught that to more than two hundred studio owners since.</p>"
          }
        }
      },
      "block_order": [
        "eyebrow_1",
        "heading_2",
        "subheading_3"
      ]
    },
    "rules": {
      "type": "text-columns",
      "settings": {
        "color_scheme": "scheme-2b5c6c91-201d-4fb1-aba3-e6d562656976",
        "columns_desktop": 3,
        "show_dividers": true
      },
      "blocks": {
        "heading_1": {
          "type": "heading",
          "settings": {
            "text": "What I believe about small studios"
          }
        },
        "column_2": {
          "type": "column",
          "settings": {
            "label": "Pricing",
            "heading": "Know your number",
            "text": "<p>Your real cost per hour, written down, before you send any quote.</p>"
          }
        },
        "column_3": {
          "type": "column",
          "settings": {
            "label": "Clients",
            "heading": "Fewer, better",
            "text": "<p>Two or three clients worth keeping beat ten who want a discount.</p>"
          }
        },
        "column_4": {
          "type": "column",
          "settings": {
            "label": "Time",
            "heading": "A week with edges",
            "text": "<p>A studio that needs your evenings is not finished being built yet.</p>"
          }
        }
      },
      "block_order": [
        "heading_1",
        "column_2",
        "column_3",
        "column_4"
      ]
    },
    "hello": {
      "type": "Image-and-video-text",
      "settings": {
        "color_scheme": "default",
        "image": "shopify://shop_images/coachpro-hello.webp",
        "image_alt": "Camila at her desk",
        "image_position": "left",
        "aspect_w": 4,
        "aspect_h": 5,
        "image_radius": 2
      },
      "blocks": {
        "eyebrow_1": {
          "type": "eyebrow",
          "settings": {
            "text": "Lisbon studio, clients everywhere"
          }
        },
        "heading_2": {
          "type": "heading",
          "settings": {
            "text": "Where I work"
          }
        },
        "subheading_3": {
          "type": "subheading",
          "settings": {
            "text": "<p>I record the show and run the calls from my old design studio in Lisbon. Clients join from all over Europe and the Americas, on video, at times that work for both of us.</p>"
          }
        },
        "button_4": {
          "type": "button",
          "settings": {
            "label": "Write to me",
            "link": "/pages/contact"
          }
        }
      },
      "block_order": [
        "eyebrow_1",
        "heading_2",
        "subheading_3",
        "button_4"
      ]
    },
    "moments": {
      "type": "gallery-grid1",
      "settings": {
        "color_scheme": "default",
        "gutter": 10,
        "background_image_1": "shopify://shop_images/coachpro-moment-sofa.webp",
        "alt_1": "Camila on a white sofa in the studio",
        "background_image_2": "shopify://shop_images/coachpro-moment-plans.webp",
        "alt_2": "Camila holding rolled plans",
        "background_image_3": "shopify://shop_images/coachpro-moment-desk.webp",
        "alt_3": "Camila writing at her desk",
        "background_image_4": "shopify://shop_images/coachpro-moment-reading.webp",
        "alt_4": "Camila reading on the sofa"
      }
    },
    "stories": {
      "type": "testimonials",
      "settings": {
        "color_scheme": "scheme-2b5c6c91-201d-4fb1-aba3-e6d562656976",
        "display_mode": "grid",
        "columns": 3,
        "header_alignment": "center",
        "card_style": "clean",
        "card_align": "left",
        "show_rating": false,
        "show_quote_mark": true,
        "avatar_shape": "circle"
      },
      "blocks": {
        "eyebrow_1": {
          "type": "eyebrow",
          "settings": {
            "enabled": true,
            "text": "Client stories"
          }
        },
        "heading_2": {
          "type": "heading",
          "settings": {
            "enabled": true,
            "text": "What changed in their studios"
          }
        },
        "subheading_3": {
          "type": "subheading",
          "settings": {
            "enabled": true,
            "text": "<p>Sample stories to show the layout. Replace them with your clients' own words and photos, with their permission.</p>"
          }
        },
        "testimonial_4": {
          "type": "testimonial",
          "settings": {
            "quote": "<p>I raised my day rate by a third and the clients I actually wanted stayed. The worksheet alone paid for the programme.</p>",
            "rating": 0,
            "name": "Mei L.",
            "role": "Ceramics studio, Studio Foundations",
            "avatar": "shopify://shop_images/coachpro-client-1.webp"
          }
        },
        "testimonial_5": {
          "type": "testimonial",
          "settings": {
            "quote": "<p>For the first time I know what a project earns before I say yes to it, not three months after.</p>",
            "rating": 0,
            "name": "Hanna V.",
            "role": "Brand designer, Price It Right",
            "avatar": "shopify://shop_images/coachpro-client-2.webp"
          }
        },
        "testimonial_6": {
          "type": "testimonial",
          "settings": {
            "quote": "<p>We went from four day weeks that ran to ten hours each to a proper Friday off, and the studio earns more.</p>",
            "rating": 0,
            "name": "Rosa M.",
            "role": "Interior studio, one to one",
            "avatar": "shopify://shop_images/coachpro-client-3.webp"
          }
        }
      },
      "block_order": [
        "eyebrow_1",
        "heading_2",
        "subheading_3",
        "testimonial_4",
        "testimonial_5",
        "testimonial_6"
      ]
    },
    "cta": {
      "type": "banner3",
      "settings": {
        "color_scheme": "scheme-4faf0e4d-27f4-4d02-bc51-617383bab1a9",
        "banner_surface": "section",
        "max_width": 700,
        "pad_top_desktop": 96,
        "pad_bottom_desktop": 96
      },
      "blocks": {
        "eyebrow_1": {
          "type": "eyebrow",
          "settings": {
            "text": "Work with me",
            "transform": "uppercase"
          }
        },
        "heading_2": {
          "type": "heading",
          "settings": {
            "text": "Not sure where to start?",
            "transform": "none"
          }
        },
        "subheading_3": {
          "type": "subheading",
          "settings": {
            "text": "Listen to an episode, take the free worksheet, or apply for the next round of Studio Foundations."
          }
        },
        "button_4": {
          "type": "button",
          "settings": {
            "label": "See the programmes",
            "link": "/pages/programmes"
          }
        }
      },
      "block_order": [
        "eyebrow_1",
        "heading_2",
        "subheading_3",
        "button_4"
      ]
    }
  },
  "order": [
    "story",
    "rules",
    "hello",
    "moments",
    "stories",
    "cta"
  ]
}
