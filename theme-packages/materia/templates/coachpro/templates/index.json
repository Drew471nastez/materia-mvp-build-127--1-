      "blocks": {
        "programme_1": {
          "type": "programme",
          "settings": {
            "label": "Studio Foundations",
            "heading": "A studio that runs on <em>purpose</em>, not on overtime",
            "text": "<p>Twelve weeks in a small group to set prices you can say out loud, find two or three clients worth keeping, and build a week with real edges. One live call every Tuesday, short lessons in between, and me in your corner.</p>",
            "facts": "12 weeks | Live calls on Tuesdays | 12 places",
            "color": "#c2421f",
            "button_label": "See the programme",
            "button_link": "/pages/programmes",
            "link_label": "Read the stories",
            "link_url": "/pages/programmes#stories",
            "image": "shopify://shop_images/coachpro-foundations.webp",
            "image_alt": "Camila Duarte, Studio Foundations",
            "pin_title": "Next round starts 3 March",
            "pin_text": "Twelve places, applications open"
          }
        },
        "programme_2": {
          "type": "programme",
          "settings": {
            "label": "Price It Right",
            "heading": "Price your next project <em>in an afternoon</em>",
            "text": "<p>A short self paced course on the numbers behind a fair quote: your real hourly cost, a day rate that holds, and how to present a price without apologising for it. Comes with the calculator I still use.</p>",
            "facts": "Self paced | About three hours | Calculator included",
            "color": "#2f5d50",
            "button_label": "Start the course",
            "button_link": "/collections/all",
            "link_label": "What is inside",
            "link_url": "/pages/programmes",
            "image": "shopify://shop_images/coachpro-pricing.webp",
            "image_alt": "Camila Duarte, Price It Right",
            "pin_title": "Start today",
            "pin_text": "Watch the first lesson free"
          }
        },
        "programme_3": {
          "type": "programme",
          "settings": {
            "label": "One to one",
            "heading": "Three months of <em>private</em> mentoring",
            "text": "<p>For studio owners making a bigger move: hiring a first person, raising every price at once, or changing what the studio does. Fortnightly calls, a shared notebook and quick answers between calls.</p>",
            "facts": "Three months | Fortnightly calls | Two places a quarter",
            "color": "#16120f",
            "button_label": "Apply for a place",
            "button_link": "/pages/contact",
            "link_label": "Ask a question",
            "link_url": "/pages/faqs",
            "image": "shopify://shop_images/coachpro-mentoring.webp",
            "image_alt": "Camila Duarte, One to one",
            "pin_title": "Two places each quarter",
            "pin_text": "Short application, reply within a week"
          }
        }
      },
