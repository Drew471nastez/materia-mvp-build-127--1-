{
  "type": "footer",
  "name": "t:sections.footer.name",
  "sections": {
    "footer": {
      "type": "footer",
      "settings": {
        "custom_text": "Train",
        "padding_top": 48,
        "show_social": true,
        "color_scheme": "scheme-2b5c6c91-201d-4fb1-aba3-e6d562656976",
        "custom_image": "",
        "reset_spacing": true,
        "section_width": "fluid_container",
        "copyright_text": "© {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.",
        "heading_weight": "600",
        "padding_bottom": 24,
        "separator_line": "all-page",
        "arrow_icon_size": 14,
        "link_hover_color": "",
        "heading_transform": "none",
        "custom_text_italic": false,
        "custom_elements_gap": 22,
        "enable_custom_image": false,
        "enable_custom_style": false,
        "footer_heading_size": 17,
        "enable_custom_text_big": false,
        "enable_country_selector": false,
        "custom_image_size_mobile": 168,
        "enable_language_selector": false,
        "custom_image_size_desktop": 144,
        "custom_text_font_size_mobile": 94,
        "custom_text_font_size_desktop": 264
      },
      "blocks": {
        "store_info_1": {
          "type": "store_info",
          "settings": {
            "show_logo": false,
            "top_offset": 0,
            "image_width": 170,
            "store_email": true,
            "store_phone": true,
            "content_width": "30%",
            "store_address": true,
            "store_heading": "",
            "store_description": "<p>Coaching and training programs you can follow from any gym.</p>"
          }
        },
        "link_list_1": {
          "type": "link_list",
          "settings": {
            "menu": "main-menu",
            "heading": "Train",
            "content_width": "16%"
          }
        },
        "link_list_2": {
          "type": "link_list",
          "settings": {
            "menu": "footer",
            "heading": "Help",
            "content_width": "16%"
          }
        },
        "newsletter_1": {
          "type": "newsletter",
          "settings": {
            "note": "",
            "heading": "One workout a week",
            "description": "A free session in your inbox every Monday.",
            "button_label": "Send it",
            "content_width": "33.333%",
            "email_placeholder": "Your email address"
          }
        },
        "payment_badges_1": {
          "type": "payment_badges",
          "settings": {
            "alignment": "right",
            "enable_amex": true,
            "enable_visa": true,
            "content_width": "100%",
            "enable_klarna": false,
            "enable_paypal": true,
            "enable_apple_pay": true,
            "enable_google_pay": true,
            "enable_mastercard": true
          }
        },
        "logo_row": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{%- if settings.logo != blank -%}<a href=\"{{ routes.root_url }}\" aria-label=\"{{ shop.name | escape }}\" style=\"display:inline-block;line-height:0\"><img src=\"{{ settings.logo | image_url: width: 480 }}\" alt=\"{{ shop.name | escape }}\" width=\"166\" height=\"38\" loading=\"lazy\" style=\"height:38px;width:auto;max-width:100%\"></a>{%- else -%}<a href=\"{{ routes.root_url }}\" class=\"heading-color no-underline\">{{ shop.name | escape }}</a>{%- endif -%}",
            "content_width": "100%"
          }
        }
      },
      "block_order": [
        "logo_row",
        "store_info_1",
        "link_list_1",
        "link_list_2",
        "newsletter_1",
        "payment_badges_1"
      ]
    }
  },
  "order": [
    "footer"
  ]
}
