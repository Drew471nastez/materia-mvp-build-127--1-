          }
        },
        "subheading_2": {
          "type": "subheading",
          "settings": {
            "text": "<p>Shipping, downloads, the course and returns.</p>"
          }
        },
        "faq_item_3": {
          "type": "faq_item",
          "settings": {
            "question": "When will my print arrive?",
            "answer": "<p>Prints and paper goods leave the studio within three working days, packed flat or rolled in a tube, with tracking. Most parcels arrive within a week.</p>"
          }
        },
        "faq_item_4": {
          "type": "faq_item",
          "settings": {
            "question": "How do I get a download?",
            "answer": "<p>Brushes, wallpapers and other files arrive as a download link by email the moment you pay. The link stays in your account, so you can download again on a new device.</p>"
          }
        },
        "faq_item_5": {
          "type": "faq_item",
          "settings": {
            "question": "How long can I watch the course?",
            "answer": "<p>The course is yours once you pay: every lesson, as often as you like, including lessons added later.</p>"
          }
        },
        "faq_item_6": {
          "type": "faq_item",
          "settings": {
            "question": "Can I return something?",
            "answer": "<p>Send a print or paper item back unused within 30 days for a full refund. Downloads and the course can be refunded within 14 days if you have not opened them.</p>"
          }
        },
        "faq_item_7": {
          "type": "faq_item",
          "settings": {
            "question": "Do you ship abroad?",
            "answer": "<p>Yes, to most countries. The delivery price for yours is shown at checkout before you pay. Downloads and the course work anywhere.</p>"
          }
        },
        "card_text_8": {
          "type": "card_text",
          "settings": {
            "heading": "Still wondering about something?",
            "text": "<p>Write to me and I will answer within two working days.</p>"
          }
        },
