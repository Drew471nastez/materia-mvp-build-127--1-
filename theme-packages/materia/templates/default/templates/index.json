        "subheading_2": {
          "type": "subheading",
          "settings": {
            "text": "<p>The ones we hear most. The rest are on the <a href=\"/pages/faqs\">help page</a>.</p>"
          }
        },
        "faq_item_3": {
          "type": "faq_item",
          "settings": {
            "question": "When will my order arrive?",
            "answer": "<p>We pack orders within two working days and send them tracked. Most arrive three to five days later. You get the tracking link by email.</p>"
          }
        },
        "faq_item_4": {
          "type": "faq_item",
          "settings": {
            "question": "How do downloads work?",
            "answer": "<p>As soon as you pay, the download link appears on the confirmation page and in your receipt email. It also stays in your account.</p>"
          }
        },
        "faq_item_5": {
          "type": "faq_item",
          "settings": {
            "question": "Can I return something?",
            "answer": "<p>Yes. Send anything physical back unused within 30 days for a full refund. Downloads can be refunded within 14 days if you have not opened them.</p>"
          }
        },
        "faq_item_6": {
          "type": "faq_item",
          "settings": {
            "question": "Do you ship abroad?",
            "answer": "<p>To most countries. You see the delivery price for yours at checkout, before you pay.</p>"
          }
        },
        "card_text_7": {
          "type": "card_text",
          "settings": {
            "heading": "Still have a question?",
            "text": "<p>Write to us and one of us will reply within a working day.</p>"
          }
        },
        "button_8": {
          "type": "button",
          "settings": {
            "label": "Contact us",
            "link": "/pages/contact"
          }
        },
