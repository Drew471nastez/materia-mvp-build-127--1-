          "settings": {
            "text": "Printmaking at home",
            "size_desktop": 48,
            "size_mobile": 32
          }
        },
        "subheading_3": {
          "type": "subheading",
          "settings": {
            "text": "<p>Four weeks of short lessons on cutting, inking and printing with tools that fit on a kitchen table. $89, paid once.</p>"
          }
        },
        "step_4": {
          "type": "step",
          "settings": {
            "title": "Week 1. Shapes",
            "description": "<p>Cut your first block and learn what a clean edge needs.</p>"
          }
        },
        "step_5": {
          "type": "step",
          "settings": {
            "title": "Week 2. Ink",
            "description": "<p>Mix a colour, roll it thin and pull an even print.</p>"
          }
        },
        "step_6": {
          "type": "step",
          "settings": {
            "title": "Week 3. Layers",
            "description": "<p>Print a second colour that lines up with the first.</p>"
          }
        },
        "step_7": {
          "type": "step",
          "settings": {
            "title": "Week 4. An edition",
            "description": "<p>Print, sign and number a run of ten.</p>"
          }
        },
