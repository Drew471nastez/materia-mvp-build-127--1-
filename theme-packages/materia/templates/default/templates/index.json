            "text": "One shop, three kinds of thing"
          }
        },
        "column_2": {
          "type": "column",
          "settings": {
            "label": "Physical",
            "heading": "Prints and paper goods",
            "text": "<p>Posters, totes and sketch pads, printed and packed in the studio. Sent tracked, usually with you within a week.</p>",
            "link_label": "Shop prints",
            "link": "/collections/all"
          }
        },
        "column_3": {
          "type": "column",
          "settings": {
            "label": "Digital",
            "heading": "Brushes and files",
            "text": "<p>Procreate brushes, phone wallpapers and printable files. A download link arrives by email as soon as you pay.</p>",
