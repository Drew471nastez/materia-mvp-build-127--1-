        "subheading_2": {
          "type": "subheading",
          "settings": {
            "text": "<p>Something else? <a href=\"/pages/contact\">Write to us</a>.</p>"
          }
        },
        "faq_item_3": {
          "type": "faq_item",
          "settings": {
            "question": "Which camera do I need?",
            "answer": "<p>Any camera with a manual mode: mirrorless, DSLR or a compact with M on the dial. The lessons show the settings on the three common dial layouts.</p>"
          }
        },
        "faq_item_4": {
          "type": "faq_item",
          "settings": {
            "question": "When does the next class start?",
            "answer": "<p>The January class starts 12 January. You can join before then and start with module one straight away.</p>"
          }
        },
        "faq_item_5": {
          "type": "faq_item",
          "settings": {
            "question": "Do I need to buy a new lens?",
            "answer": "<p>No. Everything in the course works with the lens the camera came with. Module five says when a second lens is worth it.</p>"
          }
        },
        "faq_item_6": {
          "type": "faq_item",
          "settings": {
            "question": "Can I do it with my phone?",
            "answer": "<p>The light and composition lessons work with any phone. The settings lessons need manual control, so most of the course assumes a camera.</p>"
          }
        },
        "faq_item_7": {
          "type": "faq_item",
          "settings": {
            "question": "Can I pay in parts?",
            "answer": "<p>Yes. At checkout choose three monthly payments instead of one.</p>"
          }
        },
        "faq_item_8": {
          "type": "faq_item",
          "settings": {
            "question": "What if it is not for me?",
            "answer": "<p>Email us within 30 days of joining and you get a full refund.</p>"
          }
        }
      },
