          "type": "subheading",
          "settings": {
            "text": "<p>Something else? <a href=\"/pages/contact\">Write to us</a>.</p>"
          }
        },
        "faq_item_3": {
          "type": "faq_item",
          "settings": {
            "question": "Which paints do I need?",
            "answer": "<p>Six tubes of artist or student watercolour, a size 8 and a size 4 round brush and a pad of 300 gsm cotton paper. The list names good options at three prices.</p>"
          }
        },
        "faq_item_4": {
          "type": "faq_item",
          "settings": {
            "question": "When does the next class start?",
            "answer": "<p>The January class starts 12 January. You can join before then and start with module one straight away.</p>"
          }
        },
        "faq_item_5": {
          "type": "faq_item",
          "settings": {
            "question": "Can I use the set I already have?",
            "answer": "<p>Usually yes. Paper matters most, so start there. Module one says which colours in a set are worth keeping.</p>"
          }
        },
        "faq_item_6": {
          "type": "faq_item",
          "settings": {
            "question": "Can I paint on an iPad instead?",
            "answer": "<p>The shapes and composition lessons work in any painting app. Water and paint behave differently on a screen, so most of the course assumes real paper.</p>"
          }
        },
        "faq_item_7": {
          "type": "faq_item",
          "settings": {
            "question": "Can I pay in parts?",
            "answer": "<p>Yes. At checkout choose three monthly payments instead of one.</p>"
          }
        },
        "faq_item_8": {
          "type": "faq_item",
          "settings": {
            "question": "What if it is not for me?",
            "answer": "<p>Email us within 30 days of joining and you get a full refund.</p>"
          }
        }
      },
