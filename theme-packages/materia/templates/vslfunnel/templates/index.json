          "type": "faq_item",
          "settings": {
            "question": "Do I need a big audience?",
            "answer": "<p>No. Most of the program works with the people you already know and fifty you find in module three.</p>"
          }
        },
        "faq_item_5": {
          "type": "faq_item",
          "settings": {
            "question": "Do I have to cold call?",
            "answer": "<p>No. Outreach in the program is short written messages, mostly to people who already know your work or someone who does.</p>"
          }
        },
