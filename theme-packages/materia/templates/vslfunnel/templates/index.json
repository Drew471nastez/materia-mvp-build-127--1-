          "type": "module",
          "settings": {
            "title": "Tactics you will see every week",
            "meta": "6 lessons, 50 min",
            "lessons": "Forks\nPins and skewers\nDiscovered attacks\nRemoving the defender\nSpotting them in your own games\nAssignment: a hundred puzzles, slowly"
          }
        },
