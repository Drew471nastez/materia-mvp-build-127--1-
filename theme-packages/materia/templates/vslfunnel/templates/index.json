          "type": "module",
          "settings": {
            "title": "Washes",
            "meta": "6 lessons, 58 min",
            "lessons": "Flat and graded washes\nWet on wet, wet on dry\nWhen to stop touching it\nBlooms: fix them or keep them\nLifting colour out\nAssignment: one sky, three ways"
          }
        },
        "module_3": {
          "type": "module",
          "settings": {
            "title": "Brushstrokes",
            "meta": "6 lessons, 50 min",
            "lessons": "Pressure and release\nPetals in one stroke\nLeaves in two strokes\nStems that do not wobble\nThe dry brush\nAssignment: a page of leaves"
          }
        },
        "module_4": {
          "type": "module",
          "settings": {
            "title": "Colour mixing",
            "meta": "5 lessons, 52 min",
            "lessons": "A palette of six colours\nGreens that look alive\nWarm pinks and cool pinks\nMixing on the paper\nAssignment: one flower, four palettes"
          }
        },
        "module_5": {
          "type": "module",
          "settings": {
            "title": "Roses and peonies",
            "meta": "6 lessons, 64 min",
            "lessons": "Building a rose from the centre\nPeonies in layers\nLeaving white paper\nSoft and hard edges\nLight petals on dark leaves\nAssignment: three roses"
          }
        },
        "module_6": {
          "type": "module",
          "settings": {
            "title": "Wild flowers",
