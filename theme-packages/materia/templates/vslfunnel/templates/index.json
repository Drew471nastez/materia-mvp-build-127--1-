          "type": "module",
          "settings": {
            "title": "Openings without memorising",
            "meta": "5 lessons, 52 min",
            "lessons": "Three principles for the first ten moves\nOne reply to e4, one to d4\nA simple system as White\nWhen they leave the book\nAssignment: your repertoire sheet"
          }
        },
