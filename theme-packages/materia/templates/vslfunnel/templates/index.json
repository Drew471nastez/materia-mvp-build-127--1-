        "subheading_2": {
          "type": "subheading",
          "settings": {
            "text": "<p>Something else? <a href=\"/pages/contact\">Write to us</a> or <a href=\"/pages/book-a-call\">book a call</a>.</p>"
          }
        },
        "faq_item_3": {
          "type": "faq_item",
          "settings": {
            "question": "Who is it for?",
            "answer": "<p>Adults with a regular income who were never taught how to run it: first jobs, couples, parents, people going self employed. If you are in serious debt, start with a free debt advice service as well.</p>"
          }
        },
        "faq_item_4": {
          "type": "faq_item",
          "settings": {
            "question": "Will you tell me what to invest in?",
            "answer": "<p>No. Week seven explains pensions, index funds and fees so you can read your own statements. The course is education, not personal financial advice, and it sells nothing else.</p>"
          }
        },
        "faq_item_5": {
          "type": "faq_item",
          "settings": {
            "question": "Do I have to share my numbers?",
            "answer": "<p>Never. You work on your own accounts at home. On the calls you can ask with made up figures or just listen.</p>"
          }
        },
        "faq_item_6": {
          "type": "faq_item",
          "settings": {
            "question": "What if I miss a live call?",
            "answer": "<p>Every call is recorded and added the same day. Send your question beforehand and Daniel answers it on the recording.</p>"
          }
        },
        "faq_item_7": {
          "type": "faq_item",
          "settings": {
            "question": "How long do I keep the lessons?",
            "answer": "<p>For as long as the course exists. Lessons, recordings and the workbook stay in your account, and updates are free.</p>"
          }
        },
        "faq_item_8": {
          "type": "faq_item",
          "settings": {
            "question": "Can I pay in parts?",
            "answer": "<p>Yes. At checkout choose three monthly payments instead of one.</p>"
          }
        },
        "faq_item_9": {
          "type": "faq_item",
          "settings": {
            "question": "What if it is not for me?",
            "answer": "<p>Email us within 30 days of joining and you get a full refund.</p>"
          }
        }
