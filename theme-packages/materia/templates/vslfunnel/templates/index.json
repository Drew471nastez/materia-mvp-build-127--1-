      "blocks": {
        "module_1": {
          "type": "module",
          "settings": {
            "title": "Know your camera",
            "meta": "5 lessons, 44 min",
            "lessons": "The three dials that matter\nHolding the camera steady\nFocus points and focus modes\nRAW or JPEG\nAssignment: one object, thirty frames"
          }
        },
        "module_2": {
          "type": "module",
          "settings": {
            "title": "Exposure",
            "meta": "6 lessons, 62 min",
            "lessons": "Aperture and what goes soft\nShutter speed and what goes blurred\nISO and grain\nReading the meter\nExposure compensation\nAssignment: one scene three ways"
          }
        },
        "module_3": {
          "type": "module",
          "settings": {
            "title": "Light",
            "meta": "6 lessons, 66 min",
            "lessons": "Window light at home\nOpen shade outdoors\nHard midday sun\nGolden hour and blue hour\nWhite balance\nAssignment: one face, four kinds of light"
          }
        },
        "module_4": {
          "type": "module",
          "settings": {
            "title": "Composition",
            "meta": "5 lessons, 52 min",
            "lessons": "Where to stand\nFilling the frame\nLines, layers and edges\nWhen to break the rule of thirds\nAssignment: your street, ten frames"
          }
        },
        "module_5": {
          "type": "module",
          "settings": {
            "title": "Portraits",
            "meta": "6 lessons, 64 min",
            "lessons": "Talking to the person in front of you\nFocus on the near eye\nBackgrounds that stay quiet\nPortraits at home\nGroups without a tripod\nAssignment: someone you know"
          }
        },
        "module_6": {
          "type": "module",
          "settings": {
            "title": "Things that move",
            "meta": "5 lessons, 50 min",
            "lessons": "Children and pets\nContinuous focus\nPanning\nBurst mode, used sparingly\nAssignment: something fast"
          }
        },
        "module_7": {
          "type": "module",
          "settings": {
            "title": "Low light",
            "meta": "5 lessons, 54 min",
            "lessons": "Indoors at night\nA steady hand and a slow shutter\nWhen a tripod is worth it\nCity lights at dusk\nAssignment: after dark"
          }
        },
        "module_8": {
          "type": "module",
          "settings": {
            "title": "Edit and choose",
            "meta": "6 lessons, 70 min",
            "lessons": "Picking the best frame\nAn editing order that stays the same\nCrop and straighten\nColour that looks like the day\nPrinting your photos\nA set of twelve to keep"
          }
        }
