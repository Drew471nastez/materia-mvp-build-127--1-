            "meta": "6 lessons, 62 min",
            "lessons": "Potting mix that lasts the season\nBuild a raised bed in an afternoon\nDrainage and why pots drown\nFeeding, kept simple\nCompost in a small space\nReusing last year's soil"
          }
        },
        "module_3": {
          "type": "module",
          "settings": {
            "title": "Seeds and seedlings",
            "meta": "6 lessons, 70 min",
            "lessons": "Sowing indoors in March\nLight on a windowsill\nPricking out\nHardening off\nWhen to buy plants instead\nLabels and a sowing record"
          }
        },
        "module_4": {
          "type": "module",
          "settings": {
            "title": "Planting out",
            "meta": "5 lessons, 55 min",
            "lessons": "Spacing in a small bed\nCanes, strings and supports\nPlanting tomatoes deep\nSowing little and often\nWatering by the week, not the day"
          }
        },
        "module_5": {
          "type": "module",
          "settings": {
            "title": "Salad and herbs all season",
            "meta": "6 lessons, 64 min",
            "lessons": "Cut and come again leaves\nSalad in shade\nHerbs that come back every year\nBasil that survives\nSowing for autumn salads\nPicking without stripping a plant"
          }
        },
        "module_6": {
          "type": "module",
          "settings": {
            "title": "Tomatoes, beans and courgettes",
