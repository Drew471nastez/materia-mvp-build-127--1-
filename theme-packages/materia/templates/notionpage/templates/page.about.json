            "btn_link": "/collections/all",
            "image_position": "right"
          }
        },
        "row_2": {
          "type": "row",
          "settings": {
            "image": "shopify://shop_images/notionpage-review.webp",
            "caption": "How we work",
            "heading": "Small, plain and kept up to date",
            "heading_tag": "h2",
            "body": "<p>We make a few templates and keep improving them, rather than many we never touch again. Every update is free to people who bought before.</p><p>We read every email. If something in a template gets in your way, tell us and we will fix it for everyone.</p>",
            "btn_label": "Write to us",
            "btn_link": "/pages/contact",
            "image_position": "left"
          }
        }
      },
