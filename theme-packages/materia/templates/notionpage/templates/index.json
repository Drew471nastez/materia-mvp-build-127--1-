        },
        "faq_item_3": {
          "type": "faq_item",
          "settings": {
            "tab": "1",
            "question": "What is Offer Board?",
            "answer": "<p>A Notion template for running a job search. It keeps the roles you save, the companies, the people you talk to, your interview stories and any offers in one workspace, linked to each other.</p>"
          }
        },
        "faq_item_4": {
          "type": "faq_item",
          "settings": {
            "tab": "1",
            "question": "Do I need a paid Notion plan?",
            "answer": "<p>No. Offer Board works on Notion's free plan, on the web, the desktop app and the phone app.</p>"
          }
        },
        "faq_item_5": {
          "type": "faq_item",
          "settings": {
            "tab": "2",
            "question": "How do I get it after I pay?",
            "answer": "<p>The receipt page and the email both have a link. Open it while signed in to Notion and press Duplicate, and the whole template is copied into your workspace.</p>"
          }
        },
        "faq_item_6": {
          "type": "faq_item",
          "settings": {
            "tab": "3",
            "question": "I have never used Notion. Will I manage?",
            "answer": "<p>Yes. The Instructions page has a 12 minute walkthrough and five steps to follow. Most people are adding roles within the first half hour.</p>"
          }
        },
        "faq_item_7": {
          "type": "faq_item",
          "settings": {
            "tab": "1",
            "question": "Can I change it?",
            "answer": "<p>Every page, property and view is yours to edit. Rename the stages, add a column for visa sponsorship, delete the pages you do not need.</p>"
          }
        },
        "faq_item_8": {
          "type": "faq_item",
          "settings": {
            "tab": "3",
            "question": "Can I use it with a career coach or a friend?",
            "answer": "<p>Yes. Share the workspace or a single page with them from Notion, and they can comment on your applications and stories.</p>"
          }
        },
        "faq_item_9": {
          "type": "faq_item",
          "settings": {
            "tab": "2",
            "question": "Do you offer a student discount?",
            "answer": "<p>Yes. Write to us from your university email and we send a code for half off.</p>"
          }
        },
        "faq_item_10": {
          "type": "faq_item",
          "settings": {
            "tab": "2",
            "question": "What is your refund policy?",
            "answer": "<p>If Offer Board is not for you, email us within 14 days and we refund you. No form to fill in.</p>"
          }
        },
        "faq_item_11": {
          "type": "faq_item",
          "settings": {
            "tab": "3",
            "question": "What if I still have a question?",
            "answer": "<p>Write to us from the contact page. A person reads every message and replies within two working days.</p>"
          }
        }
