/* Templates round 23: the questions page, with the last call under it. */
{
  "sections": {
    "faq": {
      "type": "faq-tabs",
      "settings": {
        "color_scheme": "default",
        "section_width": "full_width",
        "structured_data": true,
        "open_first": false,
        "allow_multiple_open": false,
        "header_align": "center",
        "section_max_width_desktop": 760,
        "section_max_width_tablet": 700,
        "section_max_width_mobile": 560,
        "item_padding_y": 20,
        "enable_custom_style": true,
        "tabs_track_bg": "#f2f1ee",
        "tab_active_bg": "#ffffff",
        "tab_active_color": "#191918",
        "tab_inactive_color": "#6f6e69",
        "divider_color": "#e0dfda",
        "q_color": "#191918",
        "plus_color": "#9b9a96",
        "a_color": "#55534e",
        "tab_size": 14,
        "tab_weight": "600",
        "q_size": 17,
        "q_weight": "600",
        "a_size": 15,
        "padding_top_desktop": 72,
        "padding_bottom_desktop": 56,
        "padding_top_mobile": 56,
        "padding_bottom_mobile": 32,
        "tab_1_label": "The template",
        "tab_2_label": "Buying",
        "tab_3_label": "Using it",
        "tab_4_label": "",
        "tab_5_label": ""
      },
      "blocks": {
        "heading_1": {
          "type": "heading",
          "settings": {
            "text": "Questions",
            "tag": "h2",
            "size_enable": true,
            "size_desktop": 40,
            "size_mobile": 28
          }
        },
        "subheading_2": {
          "type": "subheading",
          "settings": {
            "text": "<p>About Creator OS, Notion, getting the template and refunds.</p>",
            "max_width": 560
          }
        },
        "faq_item_3": {
          "type": "faq_item",
          "settings": {
            "tab": "1",
            "question": "What is Creator OS?",
            "answer": "<p>A Notion template for content creators. It keeps your ideas, scripts, content calendar, sponsor deals and the numbers behind each post in one workspace, linked to each other.</p>"
          }
        },
        "faq_item_4": {
          "type": "faq_item",
          "settings": {
            "tab": "1",
            "question": "Do I need a paid Notion plan?",
            "answer": "<p>No. Creator OS works on Notion's free plan, on the web, the desktop app and the phone app.</p>"
          }
        },
        "faq_item_5": {
          "type": "faq_item",
          "settings": {
            "tab": "2",
            "question": "How do I get it after I pay?",
            "answer": "<p>The receipt page and the email both have a link. Open it while signed in to Notion and press Duplicate, and the whole template is copied into your workspace.</p>"
          }
        },
        "faq_item_6": {
          "type": "faq_item",
          "settings": {
            "tab": "3",
            "question": "I have never used Notion. Will I manage?",
            "answer": "<p>Yes. The Instructions page has a 14 minute walkthrough and five steps to follow. Most people have their ideas in within the first half hour.</p>"
          }
        },
        "faq_item_7": {
          "type": "faq_item",
          "settings": {
            "tab": "1",
            "question": "Can I change it?",
            "answer": "<p>Every page, property and view is yours to edit. Rename the stages, add a column for a second channel, delete the pages you do not need.</p>"
          }
        },
        "faq_item_8": {
          "type": "faq_item",
          "settings": {
            "tab": "3",
            "question": "Can my editor or manager use it with me?",
            "answer": "<p>Yes. Share the workspace or a single page from Notion, and they can comment on scripts, pick up edits and update sponsor deals.</p>"
          }
        },
        "faq_item_9": {
          "type": "faq_item",
          "settings": {
            "tab": "2",
            "question": "Do you offer a student discount?",
            "answer": "<p>Yes. Write to us from your university email and we send a code for half off.</p>"
          }
        },
        "faq_item_10": {
          "type": "faq_item",
          "settings": {
            "tab": "2",
            "question": "What is your refund policy?",
            "answer": "<p>If Creator OS is not for you, email us within 14 days and we refund you. No form to fill in.</p>"
          }
        },
        "faq_item_11": {
          "type": "faq_item",
          "settings": {
            "tab": "3",
            "question": "What if I still have a question?",
            "answer": "<p>Write to us from the contact page. A person reads every message and replies within two working days.</p>"
          }
        }
      },
      "block_order": [
        "heading_1",
        "subheading_2",
        "faq_item_3",
        "faq_item_4",
        "faq_item_5",
        "faq_item_6",
        "faq_item_7",
        "faq_item_8",
        "faq_item_9",
        "faq_item_10",
        "faq_item_11"
      ]
    },
    "cta": {
