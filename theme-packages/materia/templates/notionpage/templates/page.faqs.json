        "color_scheme": "default",
        "section_width": "container",
        "text_align": "center",
        "max_width": 720,
        "heading_tag": "h2",
        "banner_surface": "soft",
        "banner_tint": 4,
        "use_custom_bg": true,
        "bg_color": "#f5f4f1",
        "use_theme_radius": false,
        "section_border_radius": 20,
        "banner_shadow": "none",
        "reveal": false,
        "stack_gap": 12,
        "sub_btn_gap": 24,
        "pad_top_desktop": 56,
        "pad_bottom_desktop": 56,
        "pad_top_mobile": 40,
        "pad_bottom_mobile": 40,
        "section_padding_top": 24,
        "section_padding_bottom": 110,
        "section_padding_top_mobile": 16,
        "section_padding_bottom_mobile": 64
      },
      "blocks": {
        "eyebrow_1": {
          "type": "eyebrow",
          "settings": {
            "text": "Notion template",
            "enable_custom_style": true,
            "transform": "none",
            "letterspace": 0,
            "size_d": 14,
            "size_m": 13,
            "opacity": 70
          }
        },
        "heading_2": {
          "type": "heading",
          "settings": {
            "text": "Creator OS",
            "enable_custom_style": true,
            "size_d": 34,
            "size_m": 28,
            "weight": "700"
          }
        },
        "subheading_3": {
          "type": "subheading",
          "settings": {
            "text": "Plan, script and post your content from one Notion page. Pay once, keep every update."
          }
        },
        "button_4": {
          "type": "button",
          "settings": {
            "label": "Get the template",
            "link": "/collections/all",
            "enable_custom_style": true,
            "use_theme_button": true,
            "radius": 10,
            "pad_h": 28,
            "pad_v": 13,
            "size_d": 15,
            "size_m": 15
          }
        }
      },
      "block_order": [
        "eyebrow_1",
        "heading_2",
        "subheading_3",
        "button_4"
      ]
    }
  },
  "order": [
    "faq",
    "cta"
  ]
