      },
      "blocks": {
        "faq_item_1": {
          "type": "faq_item",
          "settings": {
            "question": "Do I need a paid Notion plan?",
            "answer": "<p>No. Every template works on Notion's free plan, on the web, the desktop app and the phone app.</p>"
          }
        },
        "faq_item_2": {
          "type": "faq_item",
          "settings": {
            "question": "How do I get a template after I pay?",
            "answer": "<p>The receipt page and the email both have a link. Open it while you are signed in to Notion, press Duplicate and the template is copied into your workspace.</p>"
          }
        },
        "faq_item_3": {
          "type": "faq_item",
          "settings": {
            "question": "Is the free template really free?",
            "answer": "<p>Yes. Home Admin checks out at $0, arrives by email the same way and is yours to keep.</p>"
          }
        },
        "faq_item_4": {
          "type": "faq_item",
          "settings": {
            "question": "I have never used Notion. Will I manage?",
            "answer": "<p>Each template opens on a Start here page with example entries. If you can type in a table, you can use it.</p>"
          }
        },
        "faq_item_5": {
          "type": "faq_item",
          "settings": {
            "question": "Can I change a template?",
            "answer": "<p>Every page, property and view is yours to edit. Rename things, add columns, delete pages you do not need.</p>"
          }
        },
        "faq_item_6": {
          "type": "faq_item",
          "settings": {
            "question": "Will I get updates?",
            "answer": "<p>Yes. When a template changes, everyone who bought it gets an email with the new link, at no cost.</p>"
          }
        },
        "faq_item_7": {
          "type": "faq_item",
          "settings": {
            "question": "What if it is not for me?",
            "answer": "<p>Email within 14 days of buying and you get your money back.</p>"
          }
        },
        "faq_item_8": {
          "type": "faq_item",
          "settings": {
            "question": "How can I ask a question?",
            "answer": "<p>Write from the contact page. Maya reads every message and replies within two working days.</p>"
          }
        }
      },
      "block_order": [
