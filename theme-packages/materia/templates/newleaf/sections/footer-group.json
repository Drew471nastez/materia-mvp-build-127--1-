        "pay": {
          "type": "payment_badges",
          "settings": {
            "alignment": "left",
            "enable_amex": true,
            "enable_visa": true,
            "content_width": "100%",
            "enable_klarna": false,
            "enable_paypal": true,
            "enable_apple_pay": true,
            "enable_google_pay": true,
            "enable_mastercard": true
          }
        }
      },
      "block_order": [
