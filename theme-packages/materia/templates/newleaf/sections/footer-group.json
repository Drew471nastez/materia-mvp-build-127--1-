        "color_scheme": "scheme-nl-slate",
        "section_width": "container",
        "padding_top": 56,
        "padding_bottom": 0,
        "padding_top_mobile": 36,
        "padding_bottom_mobile": 0
      }
    },
    "footer": {
      "type": "footer",
      "settings": {
