      "blocks": {
        "heading_1": {
          "type": "heading",
          "settings": {
            "text": "Why she wrote it"
          }
        },
        "column_2": {
          "type": "column",
          "settings": {
            "label": "01",
            "heading": "Agencies cost too much",
            "text": "<p>Most small shops cannot spend a few hundred a month on search. Most of the work is simple enough to do yourself.</p>"
          }
        },
        "column_3": {
          "type": "column",
          "settings": {
            "label": "02",
            "heading": "Advice was scattered",
            "text": "<p>Good tips live in a hundred blog posts. The book puts them in the order you need them.</p>"
          }
        },
        "column_4": {
          "type": "column",
          "settings": {
            "label": "03",
            "heading": "It is a habit, not a trick",
            "text": "<p>Being found is mostly showing up every week. The book gives you a routine short enough to keep.</p>"
          }
        }
      },
      "block_order": [
        "heading_1",
