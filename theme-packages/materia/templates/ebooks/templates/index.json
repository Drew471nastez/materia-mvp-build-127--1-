        "q0": {
          "type": "faq_item",
          "settings": {
            "question": "Do I get the ebook with the hardback?",
            "answer": "<p>Yes. The download link is on your order page and in your receipt, so you can start cooking before the parcel arrives.</p>"
          }
        },
        "q1": {
          "type": "faq_item",
          "settings": {
            "question": "Do I need special equipment?",
            "answer": "<p>No. A big pot, a sharp knife, a few glass jars and a baking tray cover almost every recipe.</p>"
          }
        },
        "q2": {
          "type": "faq_item",
          "settings": {
            "question": "Where do I buy organ meats?",
            "answer": "<p>Ask a butcher or a farm stall; most will set liver, heart and marrow bones aside if you ask a day ahead. Each book lists what to ask for.</p>"
          }
        },
        "q3": {
          "type": "faq_item",
          "settings": {
            "question": "When does a printed book arrive?",
            "answer": "<p>Hardbacks leave within two working days and arrive in 3 to 7. Shipping is free over $50.</p>"
          }
        },
        "q4": {
          "type": "faq_item",
          "settings": {
            "question": "Can I return a book?",
            "answer": "<p>Printed books can come back within 30 days. Ebooks are refunded within 14 days if they were not downloaded.</p>"
          }
        }
      },
