        "faq_item_3": {
          "type": "faq_item",
          "settings": {
            "question": "Which formats do I get?",
            "answer": "<p>Every ebook comes as EPUB and PDF. EPUB works on most e-readers and phones, PDF on anything.</p>"
          }
        },
        "faq_item_4": {
          "type": "faq_item",
          "settings": {
            "question": "How do I read it on a Kindle?",
            "answer": "<p>Use Send to Kindle with the EPUB file. It appears in your library in a few minutes.</p>"
          }
        },
        "faq_item_5": {
          "type": "faq_item",
          "settings": {
            "question": "When do I get the files?",
            "answer": "<p>Straight away. The download link is on the confirmation page and in your receipt email.</p>"
          }
        },
        "faq_item_6": {
          "type": "faq_item",
          "settings": {
            "question": "Can I buy a copy as a gift?",
            "answer": "<p>Yes. Forward the receipt email, or write to us and we will send the files to them.</p>"
          }
        }
      },
