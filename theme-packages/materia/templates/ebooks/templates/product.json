        "subheading_2": {
          "type": "subheading",
          "settings": {
            "text": "<p>The ones readers ask before they buy. Anything else, write to us.</p>"
          }
        },
        "faq_item_3": {
          "type": "faq_item",
          "settings": {
            "question": "What format is the book in?",
            "answer": "<p>You get a PDF and an EPUB. The PDF is laid out for reading on a laptop or printing. The EPUB works on phones, tablets and most e-readers.</p>"
          }
        },
        "faq_item_4": {
          "type": "faq_item",
          "settings": {
            "question": "How do I get it?",
            "answer": "<p>The download links are on the confirmation page and in your receipt email, a minute after you pay. They stay in your account too.</p>"
          }
        },
        "faq_item_5": {
          "type": "faq_item",
          "settings": {
            "question": "Do I need to be good with computers?",
            "answer": "<p>No. If you can send an email and take a photo with your phone, you can follow every chapter.</p>"
          }
        },
        "faq_item_6": {
          "type": "faq_item",
          "settings": {
            "question": "Will this work outside the US?",
            "answer": "<p>Yes. The map listings and review sites in the book work the same way in most countries. Where something differs, the book says so.</p>"
          }
        },
        "faq_item_7": {
          "type": "faq_item",
          "settings": {
            "question": "What if it is not for me?",
            "answer": "<p>Write within 30 days and you get your money back. No form to fill in.</p>"
          }
        },
        "button_8": {
          "type": "button",
          "settings": {
            "label": "Contact us",
            "link": "/pages/contact",
            "style": "primary",
            "size": "medium",
            "radius": 8
          }
        }
