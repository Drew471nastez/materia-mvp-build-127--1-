        },
        "column_1": {
          "type": "column",
          "settings": {
            "label": "Cloth",
            "heading": "Mills we visit",
            "text": "<p>Wool from Biella, linen and cotton from northern Portugal. We buy from mills we have walked round, and we go back every year.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "column_2": {
          "type": "column",
          "settings": {
            "label": "Making",
            "heading": "Small runs",
            "text": "<p>Each piece is cut and sewn in one of two family workshops near Porto. A run is rarely more than two hundred pieces.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "column_3": {
          "type": "column",
          "settings": {
            "label": "Price",
            "heading": "One price all season",
            "text": "<p>No flash sales and no codes. Prices stay where they are until the end of season sale in January and July.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "column_4": {
          "type": "column",
          "settings": {
            "label": "Repair",
            "heading": "Two years of mending",
            "text": "<p>Send back any Halde piece within two years and we repair a seam, a button or a moth hole at no cost.</p>",
            "link_label": "Ask about a repair",
            "link": "/pages/contact"
          }
        }
      },
