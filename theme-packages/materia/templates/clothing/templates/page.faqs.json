          "type": "faq_item",
          "settings": {
            "question": "How does your sizing run?",
            "answer": "<p>Our pieces are cut true to size. Each product page has a size guide with measurements in centimetres.</p>"
          }
        },
        "faq_item_4": {
          "type": "faq_item",
          "settings": {
            "question": "How long does delivery take?",
            "answer": "<p>Three to five working days. Express delivery is offered at checkout.</p>"
          }
        },
        "faq_item_5": {
          "type": "faq_item",
          "settings": {
            "question": "Can I return or exchange?",
            "answer": "<p>Yes, within 30 days. The piece must be unworn with its tags attached.</p>"
          }
        },
        "faq_item_6": {
          "type": "faq_item",
          "settings": {
            "question": "How should I wash linen and wool?",
            "answer": "<p>Wash linen cool and hang it to dry. Wash wool by hand, or use a wool cycle, and dry it flat.</p>"
          }
        }
