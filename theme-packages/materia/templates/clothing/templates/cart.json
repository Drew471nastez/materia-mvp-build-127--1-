{
  "sections": {
    "heading": {
      "type": "page-heading",
      "settings": {
        "color_scheme": "default",
        "section_width": "fluid_container",
        "reset_spacing": true,
        "alignment": "left",
        "height": "adapt",
        "overlay_opacity": 0,
        "padding_top": 56,
        "padding_bottom": 8
      },
      "blocks": {
        "heading_1": {
          "type": "heading",
          "settings": {
            "page_title": "Your bag",
            "header_size": "default",
            "heading_font_size": 40,
            "vertical_gap": 12,
            "enable_heading_color": false
          }
        }
      },
      "block_order": [
        "heading_1"
      ]
    },
    "cart-items": {
      "type": "main-cart-items",
      "settings": {
        "padding_top": 24,
        "reset_spacing": true,
        "section_width": "fluid_container",
        "padding_bottom": 96,
        "enable_cart_note": false,
        "enable_discount_code": true,
        "show_estimate_shipping": false
      },
      "blocks": {
        "faq_section_1": {
          "type": "faq_section",
          "settings": {
            "show_faq": true,
            "faq_heading": "Before you check out"
          }
        },
        "faq_1": {
          "type": "faq",
          "settings": {
            "question": "What if it does not fit?",
            "answer": "<p>Return it within 30 days, unworn with the tags on, and we refund you or send the other size. Returns are free.</p>"
          }
        },
        "faq_2": {
          "type": "faq",
          "settings": {
            "question": "When will it arrive?",
            "answer": "<p>In 2 to 4 working days, tracked. Delivery is free on orders over $200.</p>"
          }
        },
        "faq_3": {
          "type": "faq",
          "settings": {
            "question": "How do I choose a size?",
            "answer": "<p>Each product page has a size guide in centimetres and a note on how the piece fits.</p>"
          }
        },
        "payment_badges_1": {
          "type": "payment_badges",
          "settings": {
            "show_amex": true,
            "show_visa": true,
            "show_amazon": false,
            "show_klarna": false,
            "show_paypal": true,
            "show_discover": false,
            "show_apple_pay": true,
            "show_google_pay": true,
            "show_mastercard": true,
            "show_payment_badges": true
          }
        }
      },
      "block_order": [
        "faq_section_1",
        "faq_1",
        "faq_2",
        "faq_3",
        "payment_badges_1"
      ]
    }
  },
  "order": [
    "heading",
    "cart-items"
  ]
}