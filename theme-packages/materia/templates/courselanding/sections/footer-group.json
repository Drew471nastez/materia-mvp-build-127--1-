{
  "type": "footer",
  "name": "t:sections.footer.name",
  "sections": {
    "footer": {
      "type": "footer",
      "settings": {
        "color_scheme": "default",
        "section_width": "container",
        "padding_top": 40,
        "padding_bottom": 28,
        "reset_spacing": true,
        "copyright_text": "© {{ 'now' | date: '%Y' }} {{ shop.name }}",
        "show_social": false,
        "show_policy_links": true,
        "separator_line": "all-page",
        "heading_weight": "700",
        "footer_heading_size": 15
      },
      "blocks": {
        "store_info_1": {
          "type": "store_info",
          "settings": {
            "show_logo": false,
            "store_heading": "Charla",
            "image_width": 110,
            "store_email": true,
            "store_phone": false,
            "store_address": false,
            "content_width": "50%",
            "store_description": "<p>A 12 week Spanish course for adult beginners: a short lesson every day and two live conversation classes a week.</p>"
          }
        },
        "link_list_2": {
          "type": "link_list",
          "settings": {
            "menu": "footer",
            "heading": "Pages",
            "content_width": "25%"
          }
        },
        "payment_badges_1": {
          "type": "payment_badges",
          "settings": {
            "alignment": "right",
            "enable_amex": true,
            "enable_visa": true,
            "content_width": "100%",
            "enable_klarna": false,
            "enable_paypal": true,
            "enable_apple_pay": true,
            "enable_google_pay": true,
            "enable_mastercard": true
          }
        }
      },
      "block_order": [
        "store_info_1",
        "link_list_2",
        "payment_badges_1"
      ]
    }
  },
  "order": [
    "footer"
  ]
}
