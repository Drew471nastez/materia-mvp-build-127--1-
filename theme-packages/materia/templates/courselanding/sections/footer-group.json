{
  "type": "footer",
  "name": "t:sections.footer.name",
  "sections": {
    "footer": {
      "type": "footer",
      "settings": {
        "color_scheme": "default",
        "section_width": "container",
        "padding_top": 40,
        "padding_bottom": 28,
        "reset_spacing": true,
        "copyright_text": "© {{ 'now' | date: '%Y' }} {{ shop.name }}",
        "show_social": false,
        "show_policy_links": true,
        "separator_line": "all-page",
        "heading_weight": "700",
        "footer_heading_size": 15
      },
      "blocks": {
        "store_info_1": {
          "type": "store_info",
          "settings": {
            "show_logo": false,
            "store_heading": "Evenly",
            "image_width": 110,
            "store_email": true,
            "store_phone": false,
            "store_address": false,
            "content_width": "50%",
            "store_description": "<p>A four week course on budgeting, saving and investing. Write a line about your own course here.</p>"
          }
        },
        "link_list_2": {
          "type": "link_list",
          "settings": {
            "menu": "footer",
            "heading": "Pages",
            "content_width": "25%"
          }
        }
      },
      "block_order": [
        "store_info_1",
        "link_list_2"
      ]
    }
  },
  "order": [
    "footer"
  ]
}
