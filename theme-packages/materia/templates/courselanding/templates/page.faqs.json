      "blocks": {
        "heading_1": {
          "type": "heading",
          "settings": {
            "text": "Questions before you start",
            "size_enable": true,
            "size_desktop": 44,
            "size_mobile": 30,
            "weight_enable": true,
            "weight": "700"
          }
        },
        "faq_item_1": {
          "type": "faq_item",
          "settings": {
            "question": "Can I do this if I have never run before?",
            "answer": "<p>If you can walk briskly for 30 minutes, yes. Start with the free run walk week in the first video, then begin week one when twenty minutes of jogging feels possible.</p>"
          }
        },
        "faq_item_2": {
          "type": "faq_item",
          "settings": {
            "question": "Do I need a watch?",
            "answer": "<p>No. A phone with any free running app is enough, or a normal watch. Every run is set by time and feel, not by pace.</p>"
          }
        },
        "faq_item_3": {
          "type": "faq_item",
          "settings": {
            "question": "What if I miss a week?",
            "answer": "<p>There is a short video for exactly that. Miss a few days and you carry on. Miss a week and you repeat the last one. Miss more and the plan shows where to rejoin.</p>"
          }
        },
        "faq_item_4": {
          "type": "faq_item",
          "settings": {
            "question": "Which race should I enter?",
            "answer": "<p>Any flat or rolling half marathon 16 to 20 weeks from now. Week one has a short guide to picking one.</p>"
          }
        },
        "faq_item_5": {
          "type": "faq_item",
          "settings": {
            "question": "Is it safe with a past injury?",
            "answer": "<p>The plan builds slowly, but it is not medical advice. If you have an injury or a health condition, check with a doctor or physio first.</p>"
          }
        },
        "faq_item_6": {
          "type": "faq_item",
          "settings": {
            "question": "How do I get the plan?",
            "answer": "<p>Straight after payment you get a login by email. The weeks, videos and checklists open there, on your phone or computer.</p>"
          }
        },
        "faq_item_7": {
          "type": "faq_item",
          "settings": {
            "question": "Can I get a refund?",
            "answer": "<p>Yes. Write within 14 days of joining, for any reason, and you get your money back.</p>"
          }
        },
        "faq_item_8": {
          "type": "faq_item",
          "settings": {
            "question": "Does it work for a 10K too?",
            "answer": "<p>Yes. Follow the first eight weeks and race at the end of week nine. The 10K race week is in the course.</p>"
          }
        },
        "card_text_1": {
          "type": "card_text",
          "settings": {
            "heading": "Not sure it fits you?",
            "text": "<p>Tell us how much you run now and when your race is. Lena answers within two days.</p>"
          }
        },
        "button_1": {
          "type": "button",
          "settings": {
            "label": "Ask a question",
            "link": "/pages/contact",
            "style": "primary",
            "radius": 6
