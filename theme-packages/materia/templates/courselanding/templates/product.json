      "blocks": {
        "heading_1": {
          "type": "heading",
          "settings": {
            "text": "Questions before you start",
            "size_enable": true,
            "size_desktop": 44,
            "size_mobile": 30,
            "weight_enable": true,
            "weight": "700"
          }
        },
        "faq_item_1": {
          "type": "faq_item",
          "settings": {
            "question": "I have tried before and given up. Why would this be different?",
            "answer": "<p>Most people give up because they never speak. Here you speak in the first class, in a small group, and someone expects you there twice a week.</p>"
          }
        },
        "faq_item_2": {
          "type": "faq_item",
          "settings": {
            "question": "Which Spanish do you teach?",
            "answer": "<p>Spanish from Spain in the lessons, with notes on how Latin American Spanish differs. Teachers in the classes come from both.</p>"
          }
        },
        "faq_item_3": {
          "type": "faq_item",
          "settings": {
            "question": "What if I miss a class?",
            "answer": "<p>Join another group that week, or watch the recording and send a voice note instead. Life happens.</p>"
          }
        },
        "faq_item_4": {
          "type": "faq_item",
          "settings": {
            "question": "When are the classes?",
            "answer": "<p>Mornings and evenings in European and American time zones. You pick a group when you join. Change this to your own schedule.</p>"
          }
        },
        "faq_item_5": {
          "type": "faq_item",
          "settings": {
            "question": "Do I need to buy books?",
            "answer": "<p>No. Everything is in the course, including a phrasebook for each stage you can print.</p>"
          }
        },
        "faq_item_6": {
          "type": "faq_item",
          "settings": {
            "question": "How do I get access?",
            "answer": "<p>Straight after payment you get a login by email. Lessons work on your phone, and class links arrive before each class.</p>"
          }
        },
        "card_text_1": {
          "type": "card_text",
          "settings": {
            "heading": "Not sure where you are?",
            "text": "<p>Tell us what Spanish you have now and why you are learning. Lucía replies within two days.</p>"
          }
        },
        "button_1": {
          "type": "button",
          "settings": {
            "label": "Ask a question",
            "link": "/pages/contact",
            "style": "primary",
            "radius": 6
          }
        },
        "contact_line_1": {
          "type": "contact_line",
