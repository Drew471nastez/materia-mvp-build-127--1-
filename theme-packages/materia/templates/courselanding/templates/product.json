        "collapsible_row_1": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What is inside",
            "content": "<p>Six weeks of short video lessons in four stages, a live class with a trainer every Wednesday, feedback on a one minute clip every Sunday, and a printable plan and tick sheet for each week.</p>",
            "use_product_description": true,
            "open": true
          }
        },
        "collapsible_row_2": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Course or course and sessions",
            "content": "<p>The course gives you the lessons, the live classes and the weekly clip feedback. With two private sessions you also get two 45 minute video calls with Jonah about your own puppy, to use any time in the six weeks.</p>",
            "use_product_description": false,
            "open": false
          }
        },
        "collapsible_row_3": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Access and refunds",
            "content": "<p>Your login arrives by email straight after payment and the lessons stay yours. Write within 14 days of joining and you get your money back.</p>",
            "use_product_description": false,
            "open": false
          }
