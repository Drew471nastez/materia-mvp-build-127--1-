    "modules": {
      "type": "courselanding-modules",
      "settings": {
        "heading": "Four weeks,",
        "heading_accent": "one idea each",
        "text": "<p>Every week builds on the one before. Do them in order, at your own pace.</p>",
        "anchor": "",
        "accent": "#17804c",
        "padding_top": 56
      },
      "blocks": {
        "module_1": {
          "type": "module",
          "settings": {
            "label": "Week 1",
            "title": "Where it goes",
            "text": "Track a month of spending without a spreadsheet habit you will drop.",
            "lessons": "Your money in one place\nWhat a month really costs\nFixed, flexible and forgotten\nSubscriptions you do not use\nYour first honest number\nTask: log every spend for seven days"
          }
        },
        "module_2": {
          "type": "module",
          "settings": {
            "label": "Week 2",
            "title": "A plan you keep",
            "text": "Build a budget around the bills you already have, not the ones you wish you had.",
            "lessons": "Pay yourself first\nThree pots, not thirty categories\nA budget for irregular costs\nCouples and shared bills\nWhen the month goes wrong\nTask: your first full budget"
          }
        },
        "module_3": {
          "type": "module",
          "settings": {
            "label": "Week 3",
            "title": "Debt and a cushion",
            "text": "Pay down what costs you most and build a buffer for the surprises.",
            "lessons": "What your debt really costs\nWhich one to pay first\nAn emergency fund that fits\nTalking to your bank\nCredit scores, plainly\nTask: your payoff plan"
          }
        },
        "module_4": {
          "type": "module",
          "settings": {
            "label": "Week 4",
            "title": "Saving and investing",
            "text": "Make saving automatic and learn how index funds and pensions work.",
            "lessons": "Saving on autopilot\nPensions and workplace schemes\nIndex funds, plainly\nFees that eat returns\nA plan for the next year\nTask: set up one automatic transfer"
          }
        }
      },
      "block_order": [
        "module_1",
        "module_2",
        "module_3",
        "module_4"
      ]
    },
    "reviews": {
      "type": "courselanding-reviews",
      "settings": {
        "heading": "What students say",
        "text": "<p>Sample quotes to show the layout. Replace them with your students’ own words.</p>",
        "sample_label": "Sample",
        "anchor": "",
        "accent": "#17804c"
      },
      "blocks": {
        "quote_1": {
          "type": "quote",
          "settings": {
            "quote": "I always knew roughly what I earned. Now I know where it goes, and there is money left on the 25th.",
            "name": "Hanna, Leipzig"
          }
        },
        "quote_2": {
          "type": "quote",
          "settings": {
            "quote": "The Thursday calls are the part I would pay for alone. One question about my card debt saved me more than the course cost.",
            "name": "Marco, Turin"
          }
        },
        "quote_3": {
          "type": "quote",
          "settings": {
            "quote": "No app, no subscription. One spreadsheet and twenty minutes on a Sunday.",
            "name": "Ada, Leeds"
          }
        }
      },
      "block_order": [
        "quote_1",
        "quote_2",
        "quote_3"
      ]
    },
    "faq": {
      "type": "courselanding-faq",
      "settings": {
        "heading": "Questions",
        "anchor": "",
        "accent": "#17804c"
      },
      "blocks": {
        "question_1": {
          "type": "question",
          "settings": {
            "question": "Do I need to be good with numbers?",
            "answer": "<p>No. If you can add up a shopping receipt, you can do this course. The spreadsheet does the sums.</p>"
          }
        },
        "question_2": {
          "type": "question",
          "settings": {
            "question": "Do I need to buy an app?",
            "answer": "<p>No. Everything runs in a free spreadsheet app, or on the printed workbook if you prefer paper.</p>"
          }
        },
        "question_3": {
          "type": "question",
          "settings": {
            "question": "How much time does it take?",
            "answer": "<p>About twenty minutes a day: a short lesson and one small task. You can pause and pick it up a week later.</p>"
          }
        },
        "question_4": {
          "type": "question",
          "settings": {
            "question": "How do the live calls work?",
            "answer": "<p>Send a question by Wednesday. On Thursday evening Nina answers them on a video call. Recordings stay in the course. This is teaching, not personal financial advice.</p>"
          }
        },
        "question_5": {
          "type": "question",
          "settings": {
            "question": "What if it is not for me?",
            "answer": "<p>Write within 30 days and you get every cent back. Replace this with your own terms.</p>"
          }
        }
      },
      "block_order": [
        "question_1",
        "question_2",
        "question_3",
        "question_4",
        "question_5"
      ]
