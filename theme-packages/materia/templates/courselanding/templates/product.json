          "type": "eyebrow",
          "settings": {
            "text": "The six weeks",
            "enable_custom_style": true,
            "color": "#2f4fd1"
          }
        },
        "heading_1": {
          "type": "heading",
          "settings": {
            "text": "Four stages, one dog you can take anywhere",
            "size_enable": true,
            "size_desktop": 44,
            "size_mobile": 30,
            "weight_enable": true,
            "weight": "700"
          }
        },
        "subheading_1": {
          "type": "subheading",
          "settings": {
            "text": "<p>Each stage ends with a short test you can do at home, so you know when to move on.</p>"
          }
        },
        "item_1": {
          "type": "item",
          "settings": {
            "label": "Week 1",
            "title": "Name, sit and settle",
            "text": "<p>Your puppy learns to look at you when you say its name, to sit for a reward and to lie on a mat while you eat.</p>"
          }
        },
        "item_2": {
          "type": "item",
          "settings": {
            "label": "Weeks 2 and 3",
            "title": "A loose lead",
            "text": "<p>Walking beside you without pulling, first in the hallway, then on your street. What to do when they lunge at another dog.</p>"
          }
        },
        "item_3": {
          "type": "item",
          "settings": {
            "label": "Weeks 4 and 5",
            "title": "Come when called",
            "text": "<p>A recall that works in the park, with a long line first. Leaving things on the ground and dropping what is in their mouth.</p>"
          }
        },
        "item_4": {
          "type": "item",
          "settings": {
            "label": "Week 6",
            "title": "Out in the world",
            "text": "<p>Cafés, buses, visitors at the door and an hour home alone. The last class is a walk somewhere busy.</p>"
          }
        },
