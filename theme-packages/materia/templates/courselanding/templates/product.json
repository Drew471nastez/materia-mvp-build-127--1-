        "subheading_1": {
          "type": "subheading",
          "settings": {
            "enabled": true,
            "text": "<p>Sample quotes to show the layout. Replace them with your students’ own words.</p>"
          }
        },
        "testimonial_1": {
          "type": "testimonial",
          "settings": {
            "quote": "<p>I had used an app for two years and still could not order a coffee without panicking. Six weeks of classes and I chatted with our neighbours in Málaga.</p>",
            "rating": 5,
            "name": "Sample name",
            "role": "Started at 52"
          }
        },
        "testimonial_2": {
          "type": "testimonial",
          "settings": {
            "quote": "<p>The voice notes are the best part. Lucía hears the same mistake I make every week and tells me exactly how to fix it.</p>",
            "rating": 5,
            "name": "Sample name",
            "role": "Nurse, studies before shifts"
          }
        },
        "testimonial_3": {
          "type": "testimonial",
          "settings": {
            "quote": "<p>Twenty minutes in the morning is the only way I could have done this. I do the lesson on the train.</p>",
            "rating": 5,
            "name": "Sample name",
            "role": "Commutes to the city"
          }
        },
        "testimonial_4": {
          "type": "testimonial",
          "settings": {
            "quote": "<p>Being in a group of six made me show up. Nobody minded my accent, and by week eight I stopped minding it too.</p>",
            "rating": 5,
            "name": "Sample name",
            "role": "Moving to Valencia next year"
          }
        },
        "testimonial_5": {
          "type": "testimonial",
          "settings": {
            "quote": "<p>My partner is from Mexico. I can finally talk to his mother on the phone.</p>",
            "rating": 5,
            "name": "Sample name",
            "role": "Learning for family"
          }
        }
      },
