    "modules": {
      "type": "courselanding-modules",
      "settings": {
        "heading": "Four weeks,",
        "heading_accent": "one idea each",
        "text": "<p>Every week builds on the one before. Do them in order, at your own pace.</p>",
        "anchor": "",
        "accent": "#2f5bea",
        "padding_top": 56
      },
      "blocks": {
        "module_1": {
          "type": "module",
          "settings": {
            "label": "Week 1",
            "title": "Light",
            "text": "Where to stand, when to shoot, and how to expose for the part that matters.",
            "lessons": "Find the light first\nExpose for the bright part\nWindow light at home\nGolden hour, briefly\nShade and overcast days\nBrief: one object, three times a day"
          }
        },
        "module_2": {
          "type": "module",
          "settings": {
            "label": "Week 2",
            "title": "Framing",
            "text": "Simple rules for where things go, and when to break them.",
            "lessons": "Fill the frame\nEdges and corners\nLines that lead\nHeight: crouch or climb\nSpace around a subject\nBrief: one street, ten frames"
          }
        },
        "module_3": {
          "type": "module",
          "settings": {
            "label": "Week 3",
            "title": "People and places",
            "text": "Photographing people kindly and places honestly.",
            "lessons": "Asking, and not asking\nHands and details\nWaiting for the moment\nPortrait mode, carefully\nRooms and interiors\nBrief: a day in one place"
          }
        },
        "module_4": {
          "type": "module",
          "settings": {
            "label": "Week 4",
            "title": "Editing and choosing",
            "text": "Finish the pictures, then pick the few worth sharing.",
            "lessons": "A light first edit\nWarmth and colour\nCropping for a reason\nThe presets, explained\nPicking your best five\nBrief: a set of five"
          }
        }
      },
      "block_order": [
        "module_1",
        "module_2",
        "module_3",
        "module_4"
      ]
    },
    "reviews": {
      "type": "courselanding-reviews",
      "settings": {
        "heading": "What students say",
        "text": "<p>Sample quotes to show the layout. Replace them with your students’ own words.</p>",
        "sample_label": "Sample",
        "anchor": "",
        "accent": "#2f5bea"
      },
      "blocks": {
        "quote_1": {
          "type": "quote",
          "settings": {
            "quote": "I stopped taking forty pictures of everything. I wait for the light now, take three, and one of them is good.",
            "name": "Hanna, Leipzig"
          }
        },
        "quote_2": {
          "type": "quote",
          "settings": {
            "quote": "The Thursday calls are the part I would pay for alone. One comment about my horizon fixed half my pictures.",
            "name": "Marco, Turin"
          }
        },
        "quote_3": {
          "type": "quote",
          "settings": {
            "quote": "My phone is three years old. The course never once told me to buy a new one.",
            "name": "Ada, Leeds"
          }
        }
      },
      "block_order": [
        "quote_1",
        "quote_2",
        "quote_3"
      ]
    },
    "faq": {
      "type": "courselanding-faq",
      "settings": {
        "heading": "Questions",
        "anchor": "",
        "accent": "#2f5bea"
      },
      "blocks": {
        "question_1": {
          "type": "question",
          "settings": {
            "question": "Which phone do I need?",
            "answer": "<p>Any phone from the last five years. Every lesson works on both kinds of phone, and nothing needs the newest model.</p>"
          }
        },
        "question_2": {
          "type": "question",
          "settings": {
            "question": "Do I need to buy an editing app?",
            "answer": "<p>No. The editing lessons and presets use free apps that come with your phone or cost nothing.</p>"
          }
        },
        "question_3": {
          "type": "question",
          "settings": {
            "question": "How much time does it take?",
            "answer": "<p>About twenty minutes a day: a short lesson and a few pictures. You can pause and pick it up a week later.</p>"
          }
        },
        "question_4": {
          "type": "question",
          "settings": {
            "question": "How do the live critiques work?",
            "answer": "<p>Post your best picture of the week by Wednesday. On Thursday evening Teo looks at them on a video call. Recordings stay in the course.</p>"
          }
        },
        "question_5": {
          "type": "question",
          "settings": {
            "question": "What if it is not for me?",
            "answer": "<p>Write within 30 days and you get every cent back. Replace this with your own terms.</p>"
          }
        }
      },
      "block_order": [
        "question_1",
        "question_2",
        "question_3",
        "question_4",
        "question_5"
      ]
