        "heading_1": {
          "type": "heading",
          "settings": {
            "text": "Four blocks, one start line",
            "size_enable": true,
            "size_desktop": 44,
            "size_mobile": 30,
            "weight_enable": true,
            "weight": "700"
          }
        },
        "subheading_1": {
          "type": "subheading",
          "settings": {
            "text": "<p>Each block ends with an easier week, so your body catches up with the work.</p>"
          }
        },
        "item_1": {
          "type": "item",
          "settings": {
            "label": "Weeks 1 to 4",
            "title": "Base",
            "text": "<p>Easy running four times a week, a long run of 40 minutes and a first go at strides. You finish the block able to run for an hour.</p>"
          }
        },
        "item_2": {
          "type": "item",
          "settings": {
            "label": "Weeks 5 to 8",
            "title": "Build",
            "text": "<p>Hills arrive, the long run reaches 75 minutes and you learn to eat and drink on the move.</p>"
          }
        },
        "item_3": {
          "type": "item",
          "settings": {
            "label": "Weeks 9 to 12",
            "title": "Distance",
            "text": "<p>The long run passes 15 km. One run a week at the pace you want on race day, so it feels familiar.</p>"
          }
        },
        "item_4": {
          "type": "item",
          "settings": {
            "label": "Weeks 13 to 16",
            "title": "Sharpen and race",
            "text": "<p>Your longest run, then two weeks of doing less so you arrive fresh. Race week has its own video and checklist.</p>"
          }
        },
