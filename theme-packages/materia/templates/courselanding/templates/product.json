            "open": true
          }
        },
        "collapsible_row_2": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Plan or coaching",
            "content": "<p>The plan is everything you need to train on your own. With coaching, Lena reads your log each week, changes the plan when you miss runs or feel a niggle, and calls you in race week.</p>",
            "use_product_description": false,
            "open": false
          }
        },
        "collapsible_row_3": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Access and refunds",
            "content": "<p>Your login arrives by email straight after payment and stays open for good. Write within 14 days of joining and you get your money back.</p>",
