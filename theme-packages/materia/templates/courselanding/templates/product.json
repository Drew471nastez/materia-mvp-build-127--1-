      "blocks": {
        "eyebrow_1": {
          "type": "eyebrow",
          "settings": {
            "text": "The 12 weeks",
            "enable_custom_style": true,
            "color": "#f25c05"
          }
        },
        "heading_1": {
          "type": "heading",
          "settings": {
            "text": "Four stages, one real conversation",
            "size_enable": true,
            "size_desktop": 44,
            "size_mobile": 30,
            "weight_enable": true,
            "weight": "700"
          }
        },
        "subheading_1": {
          "type": "subheading",
          "settings": {
            "text": "<p>Each stage ends with a class built around one situation you will actually meet.</p>"
          }
        },
        "item_1": {
          "type": "item",
          "settings": {
            "label": "Weeks 1 to 3",
            "title": "Getting by",
            "text": "<p>Introduce yourself, order food and drink, ask the way and understand the answer. Numbers, times and prices.</p>"
          }
        },
        "item_2": {
          "type": "item",
          "settings": {
            "label": "Weeks 4 to 6",
            "title": "Your life",
            "text": "<p>Talk about your work, your family and your weekend. The past tense you need, and nothing you do not.</p>"
          }
        },
        "item_3": {
          "type": "item",
          "settings": {
            "label": "Weeks 7 to 9",
            "title": "Opinions and plans",
            "text": "<p>Agree, disagree, make plans and tell a short story. You start to follow people speaking at normal speed.</p>"
          }
        },
        "item_4": {
          "type": "item",
          "settings": {
            "label": "Weeks 10 to 12",
            "title": "Real situations",
            "text": "<p>A phone call, a pharmacy, a problem with a booking. The last class is twenty minutes with no English at all.</p>"
          }
        },
        "button_1": {
          "type": "button",
          "settings": {
