        "item_heading_size": 24,
        "padding_top": 96,
        "padding_bottom": 72,
        "padding_top_mobile": 56,
        "padding_bottom_mobile": 40
      },
      "blocks": {
        "heading_1": {
          "type": "heading",
          "settings": {
            "text": "Made for people who are not runners yet",
            "size_enable": true,
            "size_desktop": 44,
            "size_mobile": 30,
            "weight_enable": true,
            "weight": "700",
            "tracking": -1
          }
        },
        "subheading_1": {
          "type": "subheading",
          "settings": {
            "text": "<p>If you can jog for twenty minutes without stopping, you can start this week. If you cannot yet, the first block gets you there.</p>"
          }
        },
        "column_1": {
          "type": "column",
          "settings": {
            "label": "Where you start",
            "heading": "Twenty minutes of easy running",
            "text": "<p>No race history needed. The first four weeks build the habit before they build the distance.</p>"
          }
        },
        "column_2": {
          "type": "column",
          "settings": {
            "label": "Time",
            "heading": "Four runs, about four hours a week",
            "text": "<p>Three short runs on weekdays and one long run at the weekend. Swap days when life gets in the way.</p>"
          }
        },
        "column_3": {
          "type": "column",
          "settings": {
            "label": "Pace",
            "heading": "Slow is the point",
            "text": "<p>Most of your running is at a pace where you can still talk. That is how beginners get to the start line without getting hurt.</p>"
          }
        }
      },
      "block_order": [
        "heading_1",
        "subheading_1",
        "column_1",
        "column_2",
        "column_3"
      ]
