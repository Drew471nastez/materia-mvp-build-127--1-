            "text": "A normal week",
            "custom_style": true,
            "color": "#f25c05",
            "size": 13
          }
        },
        "heading_1": {
          "type": "heading",
          "settings": {
            "text": "Twenty minutes a day, two conversations a week",
            "tag": "h2",
            "size_desktop": 44,
            "size_mobile": 30
          }
        },
        "subheading_1": {
          "type": "subheading",
          "settings": {
            "text": "<p>Every day has one job. By Friday you use the week’s phrases with a real person.</p>",
            "size": 16
          }
        },
        "step_1": {
          "type": "step",
          "settings": {
            "title": "Every morning: a short lesson",
            "description": "<p>Listen to a real conversation, repeat the useful lines and answer questions out loud. About twenty minutes.</p>"
          }
        },
        "step_2": {
          "type": "step",
          "settings": {
            "title": "Tuesday: conversation class",
            "description": "<p>Six people and a native teacher on video for 45 minutes. You talk for most of it.</p>"
          }
        },
        "step_3": {
          "type": "step",
          "settings": {
            "title": "Thursday: second class",
            "description": "<p>The same group, a new situation: ordering, asking the way, talking about your weekend.</p>"
          }
        },
        "step_4": {
          "type": "step",
          "settings": {
            "title": "Friday: a voice note",
            "description": "<p>Record one minute about your week. Your teacher replies with what to fix and one new phrase.</p>"
          }
        },
        "button_1": {
          "type": "button",
          "settings": {
            "label": "Start speaking",
            "url": "/#shopify-section-pricing"
          }
        }
