      "blocks": {
        "heading_1": {
          "type": "heading",
          "settings": {
            "text": "For adults who froze the last time someone spoke Spanish to them",
            "size_enable": true,
            "size_desktop": 44,
            "size_mobile": 30,
            "weight_enable": true,
            "weight": "700",
            "tracking": -1
          }
        },
        "subheading_1": {
          "type": "subheading",
          "settings": {
            "text": "<p>You do not need a gift for languages or a year off. You need to hear real Spanish every day and say it out loud before you feel ready.</p>"
          }
        },
        "column_1": {
          "type": "column",
          "settings": {
            "label": "Where you start",
            "heading": "Hola, gracias and not much else",
            "text": "<p>The first week starts from zero. If you took Spanish at school, you will move faster through the first three weeks.</p>"
          }
        },
        "column_2": {
          "type": "column",
          "settings": {
            "label": "Time",
            "heading": "Twenty minutes a day, plus two classes",
            "text": "<p>A short lesson on your phone each morning and two 45 minute conversation classes a week, at a time that suits you.</p>"
          }
        },
        "column_3": {
          "type": "column",
          "settings": {
            "label": "Method",
            "heading": "Speak from the first day",
            "text": "<p>Every lesson ends with you answering out loud. Grammar comes in small pieces, when you need it to say something.</p>"
          }
        }
      },
      "block_order": [
        "heading_1",
        "subheading_1",
        "column_1",
        "column_2",
