        "faq_item_1": {
          "type": "faq_item",
          "settings": {
            "question": "My puppy is eight weeks old. Is that too young?",
            "answer": "<p>No, it is a good time to start. Week one is short sessions on the floor at home, before your puppy has had its vaccinations and can go out.</p>"
          }
        },
        "faq_item_2": {
          "type": "faq_item",
          "settings": {
            "question": "Does it work for an older dog?",
            "answer": "<p>Yes, up to about two years and often older. Start at week one; grown dogs usually move faster through the first stage.</p>"
          }
        },
        "faq_item_3": {
          "type": "faq_item",
          "settings": {
            "question": "What if I miss a live class?",
            "answer": "<p>Every class is recorded and added to the course the same day. Send your question beforehand and the trainer answers it on the recording.</p>"
          }
        },
        "faq_item_4": {
          "type": "faq_item",
          "settings": {
            "question": "When are the live classes?",
            "answer": "<p>Wednesday evenings, one class for European time zones and one for American ones. You pick when you join. Change this to your own schedule.</p>"
          }
        },
        "faq_item_5": {
          "type": "faq_item",
          "settings": {
            "question": "What do I need to buy?",
            "answer": "<p>A flat collar or harness, a two metre lead, a ten metre long line for week four and small soft treats. No clicker and no special collar.</p>"
          }
        },
        "faq_item_6": {
          "type": "faq_item",
          "settings": {
            "question": "How do I get access?",
            "answer": "<p>Straight after payment you get a login by email. Lessons work on your phone, and the class link arrives before each class.</p>"
          }
        },
        "card_text_1": {
          "type": "card_text",
          "settings": {
            "heading": "Not sure where to start?",
            "text": "<p>Tell us your puppy’s age and what is hardest right now. Jonah replies within two days.</p>"
          }
        },
