            "text": "A normal week",
            "custom_style": true,
            "color": "#f25c05",
            "size": 13
          }
        },
        "heading_1": {
          "type": "heading",
          "settings": {
            "text": "Four runs, each with a job",
            "tag": "h2",
            "size_desktop": 44,
            "size_mobile": 30
          }
        },
        "subheading_1": {
          "type": "subheading",
          "settings": {
            "text": "<p>Every week opens with a three minute video: what this week is for and how each run should feel.</p>",
            "size": 16
          }
        },
        "step_1": {
          "type": "step",
          "settings": {
            "title": "Tuesday: easy run",
            "description": "<p>Thirty to forty minutes at a talking pace. It should feel too easy. That is right.</p>"
          }
        },
        "step_2": {
          "type": "step",
          "settings": {
            "title": "Thursday: hills or strides",
            "description": "<p>Short, fast pieces with full rest between them. This is where your legs get stronger.</p>"
          }
        },
        "step_3": {
          "type": "step",
          "settings": {
            "title": "Friday: short and gentle",
            "description": "<p>Twenty minutes, or a walk if you are tired. Skipping it is allowed.</p>"
          }
        },
        "step_4": {
          "type": "step",
          "settings": {
            "title": "Sunday: the long run",
            "description": "<p>The run the whole plan is built around. It grows by ten minutes most weeks, then backs off every fourth.</p>"
          }
        },
        "button_1": {
          "type": "button",
          "settings": {
            "label": "Start the plan",
            "url": "/#shopify-section-pricing"
          }
        }
