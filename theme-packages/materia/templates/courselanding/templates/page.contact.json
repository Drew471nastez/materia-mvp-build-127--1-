    "faq": {
      "type": "faq-contact-card",
      "settings": {
        "color_scheme": "default",
        "section_width": "container",
        "first_item_open": true,
        "open_icon": "plus",
        "content_alignment": "left",
        "card_position": "right",
        "card_sticky": true,
        "max_content_width": 1160,
        "col_gap": 64,
        "gap_header_to_items": 28,
        "item_padding_y": 22,
        "enable_custom_style": true,
        "question_color": "#15171a",
        "hover_color": "#f25c05",
        "icon_color": "#f25c05",
        "answer_color": "#50545c",
        "divider_color": "#e6e7ea",
        "card_bg": "#f3f4f6",
        "card_border_color": "rgba(0,0,0,0)",
        "card_heading_color": "#15171a",
        "card_text_color": "#50545c",
        "reveal": false,
        "padding_top": 24,
        "padding_bottom": 104,
        "padding_top_mobile": 56,
        "padding_bottom_mobile": 56
      },
      "blocks": {
        "heading_1": {
          "type": "heading",
          "settings": {
            "text": "Questions before you start",
            "size_enable": true,
            "size_desktop": 44,
            "size_mobile": 30,
            "weight_enable": true,
            "weight": "700"
          }
        },
        "faq_item_1": {
          "type": "faq_item",
          "settings": {
            "question": "Can I do this if I have never run before?",
            "answer": "<p>If you can walk briskly for 30 minutes, yes. Start with the free run walk week in the first video, then begin week one when twenty minutes of jogging feels possible.</p>"
          }
        },
        "faq_item_2": {
          "type": "faq_item",
          "settings": {
            "question": "Do I need a watch?",
            "answer": "<p>No. A phone with any free running app is enough, or a normal watch. Every run is set by time and feel, not by pace.</p>"
          }
        },
        "faq_item_3": {
          "type": "faq_item",
          "settings": {
            "question": "What if I miss a week?",
            "answer": "<p>There is a short video for exactly that. Miss a few days and you carry on. Miss a week and you repeat the last one. Miss more and the plan shows where to rejoin.</p>"
          }
        },
        "faq_item_4": {
          "type": "faq_item",
          "settings": {
            "question": "Which race should I enter?",
            "answer": "<p>Any flat or rolling half marathon 16 to 20 weeks from now. Week one has a short guide to picking one.</p>"
          }
        },
        "card_text_1": {
          "type": "card_text",
          "settings": {
            "heading": "Not sure it fits you?",
            "text": "<p>Tell us how much you run now and when your race is. Lena answers within two days.</p>"
          }
        },
        "button_1": {
          "type": "button",
          "settings": {
            "label": "Ask a question",
            "link": "/pages/contact",
            "style": "primary",
            "radius": 6
          }
        },
        "contact_line_1": {
          "type": "contact_line",
          "settings": {
            "label": "Email",
            "text": "Add your email address",
            "link": "/pages/contact"
          }
        }
      },
      "block_order": [
        "heading_1",
        "faq_item_1",
        "faq_item_2",
        "faq_item_3",
        "faq_item_4",
        "card_text_1",
        "button_1",
        "contact_line_1"
      ]
    }
  },
