    "faq": {
      "type": "faq-contact-card",
      "settings": {
        "color_scheme": "default",
        "section_width": "container",
        "first_item_open": true,
        "open_icon": "plus",
        "content_alignment": "left",
        "card_position": "right",
        "card_sticky": true,
        "max_content_width": 1160,
        "col_gap": 64,
        "gap_header_to_items": 28,
        "item_padding_y": 22,
        "enable_custom_style": true,
        "question_color": "#261d18",
        "hover_color": "#9b4a2c",
        "icon_color": "#9b4a2c",
        "answer_color": "#5a514b",
        "divider_color": "#ece6e0",
        "card_bg": "#f8f5f2",
        "card_border_color": "rgba(0,0,0,0)",
        "card_heading_color": "#261d18",
        "card_text_color": "#5a514b",
        "reveal": false,
        "padding_top": 24,
        "padding_bottom": 104,
        "padding_top_mobile": 56,
        "padding_bottom_mobile": 56
      },
      "blocks": {
        "heading_1": {
          "type": "heading",
          "settings": {
            "text": "Questions before you start",
            "size_enable": true,
            "size_desktop": 44,
            "size_mobile": 30,
            "weight_enable": true,
            "weight": "700"
          }
        },
        "faq_item_1": {
          "type": "faq_item",
          "settings": {
            "question": "I have never used a reformer. Is that a problem?",
            "answer": "<p>No. Week one starts with setting up the machine and lying on it. Everything begins on light springs and builds slowly.</p>"
          }
        },
        "faq_item_2": {
          "type": "faq_item",
          "settings": {
            "question": "Which reformers does it work with?",
            "answer": "<p>Any studio or folding home reformer with springs, a footbar and straps. Spring colours differ by maker, so each lesson gives the load as light, medium or heavy.</p>"
          }
        },
        "faq_item_3": {
          "type": "faq_item",
          "settings": {
            "question": "What if I miss a live class?",
            "answer": "<p>Every class is recorded and added to the course the same day. Send your question beforehand and Maya answers it on the recording.</p>"
          }
        },
        "faq_item_4": {
          "type": "faq_item",
          "settings": {
            "question": "When are the live classes?",
            "answer": "<p>Wednesday evenings, one class for European time zones and one for American ones. You pick when you join. Change this to your own schedule.</p>"
          }
        },
        "card_text_1": {
          "type": "card_text",
          "settings": {
            "heading": "Not sure where to start?",
            "text": "<p>Tell us which reformer you have and how long you have practised. Maya replies within two days.</p>"
          }
        },
        "button_1": {
          "type": "button",
          "settings": {
            "label": "Ask a question",
            "link": "/pages/contact",
            "style": "primary",
            "radius": 6
          }
        },
        "contact_line_1": {
          "type": "contact_line",
          "settings": {
            "label": "Email",
            "text": "Add your email address",
            "link": "/pages/contact"
          }
        }
      },
      "block_order": [
        "heading_1",
