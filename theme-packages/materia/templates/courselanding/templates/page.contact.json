      "settings": {
        "color_scheme": "default",
        "btn_text": "Send message",
        "ph_website": "Your phone (optional)",
        "label_website": "Phone",
        "success_text": "Thank you. You will hear back within two working days."
      },
      "blocks": {
        "heading_1": {
          "type": "heading",
          "settings": {
            "text": "Write to us"
          }
        },
        "description_2": {
          "type": "description",
          "settings": {
            "text": "<p>A question before you join, a class time that does not work, or trouble with a lesson. It all comes to the same inbox.</p>"
          }
        },
        "info_3": {
          "type": "info",
          "settings": {
            "icon": "mail",
            "line1": "hola@charla.school",
            "line2": "Replace with your own address"
          }
        },
        "info_4": {
          "type": "info",
          "settings": {
            "icon": "map",
            "line1": "Replies",
            "line2": "Within two working days"
          }
        }
      },
      "block_order": [
        "heading_1",
        "description_2",
        "info_3",
        "info_4"
      ]
    },
    "faq": {
      "type": "faq-contact-card",
      "settings": {
        "color_scheme": "default",
        "section_width": "container",
        "first_item_open": true,
        "open_icon": "plus",
        "content_alignment": "left",
        "card_position": "right",
        "card_sticky": true,
        "max_content_width": 1160,
        "col_gap": 64,
        "gap_header_to_items": 28,
        "item_padding_y": 22,
        "enable_custom_style": true,
        "question_color": "#15171a",
        "hover_color": "#f25c05",
        "icon_color": "#f25c05",
        "answer_color": "#50545c",
        "divider_color": "#e6e7ea",
        "card_bg": "#f3f4f6",
        "card_border_color": "rgba(0,0,0,0)",
        "card_heading_color": "#15171a",
        "card_text_color": "#50545c",
        "reveal": false,
        "padding_top": 24,
        "padding_bottom": 104,
        "padding_top_mobile": 56,
        "padding_bottom_mobile": 56
      },
      "blocks": {
        "heading_1": {
          "type": "heading",
          "settings": {
            "text": "Questions before you start",
            "size_enable": true,
            "size_desktop": 44,
            "size_mobile": 30,
            "weight_enable": true,
            "weight": "700"
          }
        },
        "faq_item_1": {
          "type": "faq_item",
          "settings": {
            "question": "I have tried before and given up. Why would this be different?",
            "answer": "<p>Most people give up because they never speak. Here you speak in the first class, in a small group, and someone expects you there twice a week.</p>"
          }
        },
        "faq_item_2": {
          "type": "faq_item",
          "settings": {
            "question": "Which Spanish do you teach?",
            "answer": "<p>Spanish from Spain in the lessons, with notes on how Latin American Spanish differs. Teachers in the classes come from both.</p>"
          }
        },
        "faq_item_3": {
          "type": "faq_item",
          "settings": {
            "question": "What if I miss a class?",
            "answer": "<p>Join another group that week, or watch the recording and send a voice note instead. Life happens.</p>"
          }
        },
        "faq_item_4": {
          "type": "faq_item",
          "settings": {
            "question": "When are the classes?",
            "answer": "<p>Mornings and evenings in European and American time zones. You pick a group when you join. Change this to your own schedule.</p>"
          }
        },
        "card_text_1": {
          "type": "card_text",
          "settings": {
            "heading": "Not sure where you are?",
            "text": "<p>Tell us what Spanish you have now and why you are learning. Lucía replies within two days.</p>"
          }
        },
        "button_1": {
          "type": "button",
          "settings": {
            "label": "Ask a question",
            "link": "/pages/contact",
            "style": "primary",
            "radius": 6
          }
        },
        "contact_line_1": {
          "type": "contact_line",
          "settings": {
            "label": "Email",
            "text": "Add your email address",
            "link": "/pages/contact"
          }
        }
      },
      "block_order": [
        "heading_1",
        "faq_item_1",
        "faq_item_2",
        "faq_item_3",
        "faq_item_4",
        "card_text_1",
        "button_1",
        "contact_line_1"
      ]
    }
  },
