        },
        "faq_item_1": {
          "type": "faq_item",
          "settings": {
            "tab": "1",
            "question": "When do pre-orders ship?",
            "answer": "<p>On release day. Say when the record comes out and how long delivery takes after that.</p>"
          }
        },
        "faq_item_2": {
          "type": "faq_item",
          "settings": {
            "tab": "1",
            "question": "Is the vinyl signed?",
            "answer": "<p>Only where the product says so. Signed copies are limited and sell out first.</p>"
          }
        },
        "faq_item_3": {
          "type": "faq_item",
          "settings": {
            "tab": "1",
            "question": "My record arrived damaged",
            "answer": "<p>Send a photo of the sleeve and the box to the store team within 14 days and a new copy goes out.</p>"
          }
        },
        "faq_item_4": {
          "type": "faq_item",
          "settings": {
            "tab": "2",
            "question": "Can I change my order?",
            "answer": "<p>Write to us within a few hours of ordering and we will change the size or colour.</p>"
          }
        },
        "faq_item_5": {
          "type": "faq_item",
          "settings": {
            "tab": "2",
            "question": "Where is the size chart?",
            "answer": "<p>On every clothing page, under the size options. Measurements are of the garment, laid flat.</p>"
          }
        },
        "faq_item_6": {
          "type": "faq_item",
          "settings": {
            "tab": "3",
            "question": "How long does shipping take?",
            "answer": "<p>Orders leave within two working days. Add your delivery times by region.</p>"
          }
        },
        "faq_item_7": {
          "type": "faq_item",
          "settings": {
            "tab": "3",
            "question": "Can I return something?",
            "answer": "<p>Yes, within 30 days, unworn and unwashed. Say who pays for the return.</p>"
          }
        }
