{
  "type": "footer",
  "name": "t:sections.footer.name",
  "sections": {
    "footer": {
      "type": "footer",
      "settings": {
        "custom_text": "",
        "padding_top": 64,
        "show_social": true,
        "color_scheme": "default",
        "custom_image": "",
        "reset_spacing": true,
        "section_width": "fluid_container",
        "copyright_text": "© {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.",
        "heading_weight": "600",
        "padding_bottom": 24,
        "separator_line": "all-page",
        "arrow_icon_size": 14,
        "link_hover_color": "",
        "heading_transform": "none",
        "custom_text_italic": false,
        "custom_elements_gap": 22,
        "enable_custom_image": false,
        "enable_custom_style": false,
        "footer_heading_size": 17,
        "enable_custom_text_big": false,
        "enable_country_selector": false,
        "custom_image_size_mobile": 168,
        "enable_language_selector": false,
        "custom_image_size_desktop": 144,
        "custom_text_font_size_mobile": 94,
        "custom_text_font_size_desktop": 264,
        "show_policy_links": true
      },
      "blocks": {
        "store_info_1": {
          "type": "store_info",
          "settings": {
            "show_logo": false,
            "image_width": 110,
            "store_email": true,
            "store_phone": false,
            "store_address": false,
            "content_width": "33.333%",
            "store_heading": "",
            "store_description": "<p>Drawing lessons, a book, a club and a Sunday letter, for grown ups who stopped drawing at school.</p>"
          }
        },
        "link_list_1": {
          "type": "link_list",
          "settings": {
            "menu": "footer",
            "heading": "More",
            "content_width": "16%"
          }
        },
        "link_list_2": {
          "type": "link_list",
          "settings": {
            "menu": "free",
            "heading": "Free",
            "content_width": "16%"
          }
        },
        "link_list_3": {
          "type": "link_list",
          "settings": {
            "menu": "made",
            "heading": "Things I make",
            "content_width": "16%"
          }
        },
        "logo_row": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{%- if settings.logo != blank -%}<a href=\"{{ routes.root_url }}\" aria-label=\"{{ shop.name | escape }}\" style=\"display:inline-block;line-height:0\"><img src=\"{{ settings.logo | image_url: width: 480 }}\" alt=\"{{ shop.name | escape }}\" width=\"172\" height=\"36\" loading=\"lazy\" style=\"height:36px;width:auto;max-width:100%\"></a>{%- else -%}<a href=\"{{ routes.root_url }}\" class=\"heading-color no-underline\">{{ shop.name | escape }}</a>{%- endif -%}",
            "content_width": "100%"
          }
        }
      },
      "block_order": [
        "logo_row",
        "store_info_1",
        "link_list_1",
        "link_list_2",
        "link_list_3"
      ]
    }
  },
  "order": [
    "footer"
  ]
}
