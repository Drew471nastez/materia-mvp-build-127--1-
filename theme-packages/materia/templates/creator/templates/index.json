        "heading_plain": "Draw a little",
        "heading_serif": "every morning.",
        "underline_color": "#5ec3ea",
        "intro": "<p>I'm Ines. I teach grown ups who stopped drawing at school, and I wrote <a href=\"/collections/all\">Draw Before Breakfast</a>, forty exercises of ten minutes each.</p>",
