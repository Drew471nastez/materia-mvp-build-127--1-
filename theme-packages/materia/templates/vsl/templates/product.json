      "blocks": {
        "question_1": {
          "type": "question",
          "settings": {
            "question": "Do I need an audience first?",
            "answer": "<p>No. A list of past clients is enough for a first round of five to ten people. Week four covers where else to find them.</p>"
          }
        },
        "question_2": {
          "type": "question",
          "settings": {
            "question": "How much time does it take?",
            "answer": "<p>About two hours a week: one short lesson, one exercise and the Thursday call.</p>"
          }
        },
        "question_3": {
          "type": "question",
          "settings": {
            "question": "What exactly do I get?",
            "answer": "<p>Twelve short lessons, templates for the outline, the sales page and the emails, six live calls and their recordings.</p>"
          }
        },
        "question_4": {
          "type": "question",
          "settings": {
            "question": "What happens on the free call?",
            "answer": "<p>You tell us what you do and who for. We tell you honestly whether the course fits. If it does not, there is no pitch.</p>"
          }
        }
      },
