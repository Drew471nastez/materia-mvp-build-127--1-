    "reviews": {
      "type": "vsl-reviews",
      "settings": {
        "layout": "carousel",
        "autoplay": true,
        "eyebrow": "Students",
        "heading": "What students say",
        "text": "",
        "sample_note": "Sample reviews. Replace them with your students’ own words.",
        "prev_label": "Previous",
        "next_label": "Next",
        "columns": "3",
        "line_above": true,
        "padding_top": 96,
        "padding_bottom": 96,
        "padding_top_mobile": 64,
        "padding_bottom_mobile": 56
      },
      "blocks": {
        "review_1": {
          "type": "review",
          "settings": {
            "stars": 5,
            "headline": "Thirty videos in one month",
            "quote": "<p>I used to film one video and then stall for two weeks. The planning day gave me a month of ideas, and I filmed them in two afternoons.</p>",
            "name": "Maya Ruiz",
            "role": "Career coach"
          }
        },
        "review_2": {
          "type": "review",
          "settings": {
            "stars": 5,
            "headline": "People stay past the first second now",
            "quote": "<p>The first three seconds lesson changed everything. I stopped opening with hello and my videos stopped losing people straight away.</p>",
            "name": "Daniel Kim",
            "role": "Founder, ceramics studio"
          }
        },
        "review_3": {
          "type": "review",
          "settings": {
            "stars": 5,
            "headline": "Editing in forty minutes",
            "quote": "<p>Cut, captions, music, export. I follow the same order every time and it takes me under an hour, on my phone.</p>",
            "name": "Priya Shah",
            "role": "Nutritionist"
          }
        },
        "review_4": {
          "type": "review",
          "settings": {
            "stars": 5,
            "headline": "Our shop account finally has a plan",
            "quote": "<p>I run social for a small bakery. The weekly schedule means we post four times a week without it taking over my job.</p>",
            "name": "Tom Becker",
            "role": "Social media lead, bakery"
          }
        },
        "review_5": {
          "type": "review",
          "settings": {
            "stars": 5,
            "headline": "The Tuesday reviews are worth it alone",
            "quote": "<p>Hearing someone pick apart my video for two minutes taught me more than a month of guessing.</p>",
            "name": "Ana Lima",
            "role": "Yoga teacher"
          }
        }
      },
      "block_order": [
        "review_1",
        "review_2",
        "review_3",
        "review_4",
        "review_5"
      ]
    },
    "faq": {
      "type": "vsl-faq",
      "settings": {
        "eyebrow": "Questions",
        "heading": "Before you join",
        "text": "",
        "first_open": true,
        "max_width": 760,
        "line_above": true,
        "padding_top": 96,
        "padding_bottom": 96,
        "padding_top_mobile": 64,
        "padding_bottom_mobile": 56
      },
      "blocks": {
        "question_1": {
          "type": "question",
          "settings": {
            "question": "Do I need a camera?",
            "answer": "<p>No. Every lesson is filmed and edited on a phone. Week two has a short kit list, a clip on microphone and a small light, all under $100.</p>"
          }
        },
        "question_2": {
          "type": "question",
          "settings": {
            "question": "How much time does it take?",
            "answer": "<p>About three hours a week: two short lessons, filming and editing your videos, and the Tuesday review if you can make it.</p>"
          }
        },
        "question_3": {
          "type": "question",
          "settings": {
            "question": "Which platforms does it cover?",
            "answer": "<p>Vertical video for Reels, TikTok and Shorts. The same video works on all three, and one lesson shows what to change for each.</p>"
          }
        },
        "question_4": {
          "type": "question",
          "settings": {
            "question": "I hate being on camera. Will this work?",
            "answer": "<p>Yes. One module is about formats where you never show your face: hands, voiceover, screen and product videos.</p>"
          }
        },
        "question_5": {
          "type": "question",
          "settings": {
            "question": "Is it for brands or for personal accounts?",
            "answer": "<p>Both. The lessons work the same, and the examples include a coach, a bakery, a clothing shop and a software company.</p>"
          }
        }
      },
      "block_order": [
        "question_1",
        "question_2",
        "question_3",
