    "reviews": {
      "type": "vsl-reviews",
      "settings": {
        "layout": "carousel",
        "autoplay": true,
        "eyebrow": "Students",
        "heading": "What students *say*",
        "text": "",
        "sample_note": "Sample reviews. Replace them with your students’ own words.",
        "prev_label": "Previous",
        "next_label": "Next",
        "columns": "3",
        "line_above": true,
        "padding_top": 96,
        "padding_bottom": 96,
        "padding_top_mobile": 64,
        "padding_bottom_mobile": 56
      },
      "blocks": {
        "review_1": {
          "type": "review",
          "settings": {
            "stars": 5,
            "headline": "Episode one out in two weeks",
            "quote": "<p>I had been planning a show for two years. The format week made me pick one idea and record it, and the first episode was out by week two.</p>",
            "name": "Maya Ruiz",
            "role": "Career coach"
          }
        },
        "review_2": {
          "type": "review",
          "settings": {
            "stars": 5,
            "headline": "Editing stopped eating my weekend",
            "quote": "<p>The one hour edit is the reason I am still publishing. Cut, level, export, done. I used to lose a whole Sunday to it.</p>",
            "name": "Daniel Kim",
            "role": "Founder, design studio"
          }
        },
        "review_3": {
          "type": "review",
          "settings": {
            "stars": 5,
            "headline": "Guests said yes",
            "quote": "<p>I used the guest email from the kit word for word. Four of the six people I asked said yes in the first month.</p>",
            "name": "Priya Shah",
            "role": "Nutritionist"
          }
        },
        "review_4": {
          "type": "review",
          "settings": {
            "stars": 5,
            "headline": "Sounds like a real show",
            "quote": "<p>I bought the cheapest microphone on the gear list and recorded in a wardrobe. Nobody can tell.</p>",
            "name": "Tom Becker",
            "role": "Secondary school teacher"
          }
        },
        "review_5": {
          "type": "review",
          "settings": {
            "stars": 5,
            "headline": "A reason to keep going",
            "quote": "<p>The Thursday calls kept me going after the launch buzz wore off. Ten episodes out and I still look forward to recording.</p>",
            "name": "Ana Lima",
            "role": "Therapist"
          }
        }
      },
      "block_order": [
        "review_1",
        "review_2",
        "review_3",
        "review_4",
        "review_5"
      ]
