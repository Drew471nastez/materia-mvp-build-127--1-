    "inside": {
      "type": "vsl-cards",
      "settings": {
        "eyebrow": "Inside the course",
        "heading": "Six weeks, thirty videos",
        "text": "",
        "columns": "2",
        "number_style": "inline",
        "line_above": true,
        "padding_top": 96,
        "padding_bottom": 96,
        "padding_top_mobile": 64,
        "padding_bottom_mobile": 56
      },
      "blocks": {
        "card_1": {
          "type": "card",
          "settings": {
            "title": "The plan",
            "text": "<p>Week one. Pick three topics you can talk about every week, and write thirty video ideas in one sitting with our idea sheet.</p>"
          }
        },
        "card_2": {
          "type": "card",
          "settings": {
            "title": "The shoot",
            "text": "<p>Week two. Light, sound and framing with a phone by a window. Film a week of videos in one afternoon.</p>"
          }
        },
        "card_3": {
          "type": "card",
          "settings": {
            "title": "The edit",
            "text": "<p>Weeks three and four. Hooks, cuts, captions and music, in the same order every time. Under an hour per video.</p>"
          }
        },
        "card_4": {
          "type": "card",
          "settings": {
            "title": "The habit",
            "text": "<p>Weeks five and six. A posting schedule you can keep, reading your numbers, and turning one good video into five.</p>"
          }
        }
      },
      "block_order": [
        "card_1",
        "card_2",
        "card_3",
        "card_4"
      ]
    },
