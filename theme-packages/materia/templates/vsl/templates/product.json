        "collapsible_row_1": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What is inside",
            "content": "<p>Eight weeks in four parts: the show, the setup, the workflow and the launch. 24 lessons, each under twelve minutes, with one thing to do that week. Write your own module list here.</p>",
            "open": false
          }
        },
        "collapsible_row_2": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Who it is for",
            "content": "<p>Coaches, founders, teachers and anyone with a topic they could talk about for a year, who wants a weekly show that supports their work.</p>",
            "open": false
          }
        },
        "collapsible_row_3": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Refunds",
            "content": "<p>Write within 30 days of joining and you get your money back in full.</p>",
