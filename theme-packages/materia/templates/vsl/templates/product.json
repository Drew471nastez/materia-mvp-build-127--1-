    "inside": {
      "type": "vsl-cards",
      "settings": {
        "eyebrow": "Inside the course",
        "heading": "Eight weeks, *ten episodes*",
        "text": "",
        "columns": "2",
        "number_style": "inline",
        "line_above": true,
        "padding_top": 96,
        "padding_bottom": 96,
        "padding_top_mobile": 64,
        "padding_bottom_mobile": 56
      },
      "blocks": {
        "card_1": {
          "type": "card",
          "settings": {
            "title": "The show",
            "text": "<p>Weeks one and two. Pick a format you can repeat every week, name the show and write your first twenty episode ideas.</p>"
          }
        },
        "card_2": {
          "type": "card",
          "settings": {
            "title": "The setup",
            "text": "<p>Week three. One microphone, one quiet room and the settings that make it sound good. A shopping list at three budgets.</p>"
          }
        },
        "card_3": {
          "type": "card",
          "settings": {
            "title": "The workflow",
            "text": "<p>Weeks four and five. Record, edit and publish an episode in one afternoon, with our outline and show notes templates.</p>"
          }
        },
        "card_4": {
          "type": "card",
          "settings": {
            "title": "The launch",
            "text": "<p>Weeks six to eight. A trailer, three episodes on day one, your first guests booked and a plan for your first listeners.</p>"
          }
        }
      },
      "block_order": [
        "card_1",
        "card_2",
        "card_3",
        "card_4"
      ]
    },
