    "faq": {
      "type": "vsl-faq",
      "settings": {
        "eyebrow": "Questions",
        "heading": "Before you *join*",
        "text": "",
        "first_open": true,
        "max_width": 760,
        "line_above": true,
        "padding_top": 96,
        "padding_bottom": 96,
        "padding_top_mobile": 64,
        "padding_bottom_mobile": 56
      },
      "blocks": {
        "question_1": {
          "type": "question",
          "settings": {
            "question": "Do I need expensive gear?",
            "answer": "<p>No. A USB microphone and a quiet room are enough. Week three has a shopping list at three budgets, the cheapest is about $150.</p>"
          }
        },
        "question_2": {
          "type": "question",
          "settings": {
            "question": "How much time does it take?",
            "answer": "<p>About three hours a week: two short lessons, recording one episode and the Thursday call if you can make it.</p>"
          }
        },
        "question_3": {
          "type": "question",
          "settings": {
            "question": "Audio only, or video too?",
            "answer": "<p>Both are covered. The lessons start with audio, and one module shows how to film the same conversation for YouTube.</p>"
          }
        },
        "question_4": {
          "type": "question",
          "settings": {
            "question": "Do I need an audience first?",
            "answer": "<p>No. Week seven covers your first listeners: people you already know, guests who share their episode, and one place to post each week.</p>"
          }
        },
        "question_5": {
          "type": "question",
          "settings": {
            "question": "When does the next round start?",
            "answer": "<p>On the first Monday of each month. Change this to your own dates.</p>"
          }
        }
      },
      "block_order": [
        "question_1",
        "question_2",
        "question_3",
        "question_4",
        "question_5"
      ]
