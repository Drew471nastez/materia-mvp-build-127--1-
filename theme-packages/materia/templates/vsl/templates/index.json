    "why": {
      "type": "vsl-cards",
      "settings": {
        "eyebrow": "Why this course",
        "heading": "Why it *works*",
        "text": "<p>Most courses teach you to build a library. This one gets one workshop sold and run.</p>",
        "columns": "3",
        "number_style": "tile",
        "line_above": true,
        "padding_top": 96,
        "padding_bottom": 96,
        "padding_top_mobile": 64,
        "padding_bottom_mobile": 56
      },
      "blocks": {
        "card_1": {
          "type": "card",
          "settings": {
            "title": "One workshop, not an academy",
            "text": "<p>You build one thing people can buy this month. No membership site, no twenty module curriculum.</p>"
          }
        },
        "card_2": {
          "type": "card",
          "settings": {
            "title": "Sold before it is built",
            "text": "<p>You pitch the outline first and take payments, so you only build what people already want.</p>"
          }
        },
        "card_3": {
          "type": "card",
          "settings": {
            "title": "Run live, then reused",
            "text": "<p>The first round is live on video. Its recording becomes the version you sell next.</p>"
          }
        }
      },
      "block_order": [
        "card_1",
        "card_2",
        "card_3"
      ]
    },
    "inside": {
      "type": "vsl-cards",
