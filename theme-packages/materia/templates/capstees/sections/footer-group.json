            "content_width": "50%"
          }
        },
        "pay": {
          "type": "payment_badges",
          "settings": {
            "alignment": "right",
            "enable_visa": true,
            "enable_mastercard": true,
            "enable_amex": true,
            "enable_apple_pay": true,
            "enable_google_pay": true,
            "enable_paypal": false,
            "enable_klarna": false,
            "content_width": "100%"
          }
        }
      },
      "block_order": [
        "shop",
        "links",
        "news",
        "pay"
      ]
    }
