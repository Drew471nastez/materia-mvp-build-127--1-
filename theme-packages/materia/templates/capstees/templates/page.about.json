      "blocks": {
        "heading_1": {
          "type": "heading",
          "settings": {
            "text": "How we make them"
          }
        },
        "column_1": {
          "type": "column",
          "settings": {
            "label": "Cotton",
            "heading": "Heavy and soft",
            "text": "<p>Tees are 240 gsm combed cotton and crewnecks 400 gsm brushed fleece. Both soften with washing and keep their shape.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "column_2": {
          "type": "column",
          "settings": {
            "label": "Runs",
            "heading": "Fifty at a time",
            "text": "<p>We make each colour in runs of fifty. When a run sells out we make the next one, so there is never a pile left over.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "column_3": {
          "type": "column",
          "settings": {
            "label": "Print",
            "heading": "Ink that stays",
            "text": "<p>Water based ink pressed into the cotton and embroidery on the caps. Nothing to crack or peel after a few washes.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "column_4": {
          "type": "column",
          "settings": {
            "label": "Price",
            "heading": "One price",
            "text": "<p>No sales and no codes. A tee costs what it costs to make well, plus enough to make the next run.</p>",
            "link_label": "",
            "link": ""
          }
        }
      },
      "block_order": [
        "heading_1",
        "column_1",
        "column_2",
        "column_3",
        "column_4"
