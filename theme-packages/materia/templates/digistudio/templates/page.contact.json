/* Templates round 26: a contact form and the questions people ask most. */
{
  "sections": {
    "heading": {
      "type": "page-heading",
      "settings": {
        "color_scheme": "default",
        "section_width": "container",
        "reset_spacing": true,
        "alignment": "center",
        "height": "based_on_content",
        "padding_top": 64,
        "padding_bottom": 8
      },
      "blocks": {
        "heading_1": {
          "type": "heading",
          "settings": {
            "page_title": "Contact",
            "header_size": "large",
            "vertical_gap": 10
          }
        },
        "description_2": {
          "type": "description",
          "settings": {
            "description": "<p>Questions about a file, a licence or an order. We reply within two working days.</p>"
          }
        }
      },
      "block_order": [
        "heading_1",
        "description_2"
      ]
    },
    "form": {
      "type": "contactformsimple2",
      "settings": {
        "color_scheme": "default",
        "section_width": "container",
        "show_website": false,
        "btn_text": "Send message",
        "max_width": 1100,
        "enable_shadow": false,
        "reveal": false,
        "pad_top": 24,
        "pad_bottom": 56
      },
      "blocks": {
        "heading_1": {
          "type": "heading",
          "settings": {
            "text": "Send a message"
          }
        },
        "description_2": {
          "type": "description",
          "settings": {
            "text": "<p>Include your order number if it is about something you bought.</p>"
          }
        },
        "info_3": {
          "type": "info",
          "settings": {
            "icon": "mail",
            "line1": "hello@margin.studio",
            "line2": "Write any time"
          }
        },
        "info_4": {
          "type": "info",
          "settings": {
            "icon": "clock",
            "line1": "Within two working days",
            "line2": "Monday to Friday"
          }
        }
      },
      "block_order": [
        "heading_1",
        "description_2",
        "info_3",
        "info_4"
      ]
    },
    "faq": {
      "type": "faq",
      "settings": {
        "color_scheme": "default",
        "section_width": "container",
        "structured_data": true,
        "heading": "Before you write",
        "subheading": "<p>The answers people ask for most.</p>",
        "first_item_open": true,
        "allow_multiple_open": false,
        "open_icon": "plus",
        "content_alignment": "left",
        "max_content_width": 820,
        "gap_header_to_items": 32,
        "gap_heading_to_subheading": 10,
        "gap_between_items": 0,
        "item_padding_y": 20,
        "item_padding_x": 0,
        "item_radius": 0,
        "show_dividers": true,
        "enable_custom_style": true,
        "card_bg": "rgba(0,0,0,0)",
        "card_border_color": "#e4e3df",
        "question_color": "#17181a",
        "icon_color": "#17181a",
        "answer_color": "#4a4c50",
        "heading_size_desktop": 40,
        "heading_size_mobile": 30,
        "question_size_desktop": 18,
        "question_size_mobile": 16,
        "enable_custom_question_weight": true,
        "question_weight": "500",
        "answer_size_desktop": 16,
        "answer_size_mobile": 15,
        "reveal": false,
        "padding_top": 24,
        "padding_bottom": 96
      },
      "blocks": {
        "faq_item_1": {
          "type": "faq_item",
          "settings": {
            "question": "How do I get my files?",
            "answer": "<p>Straight after you pay. The download links are on the order confirmation page and in the email that arrives a minute later. Courses open in your account on this site.</p>"
          }
        },
        "faq_item_2": {
          "type": "faq_item",
          "settings": {
            "question": "Can I download them again later?",
            "answer": "<p>Yes. Sign in to your account, or use the link in your email, and download as many times as you need. Keep a copy on your own drive as well.</p>"
          }
        },
        "faq_item_3": {
          "type": "faq_item",
          "settings": {
            "question": "Can my team use them?",
            "answer": "<p>The standard licence is for one person. Pick the team option on the product page and up to five people can install and use the files.</p>"
          }
        },
        "faq_item_4": {
          "type": "faq_item",
          "settings": {
            "question": "Can I get a refund?",
            "answer": "<p>Digital files cannot be returned, so look at the previews first. If a file is broken or not what the page describes, write within 14 days and you get your money back.</p>"
          }
        }
      },
      "block_order": [
        "faq_item_1",
        "faq_item_2",
        "faq_item_3",
        "faq_item_4"
      ]
    }
  },
  "order": [
    "heading",
    "form",
    "faq"
  ]
}
