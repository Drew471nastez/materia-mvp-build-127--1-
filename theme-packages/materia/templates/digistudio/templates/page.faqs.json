      "blocks": {
        "faq_item_1": {
          "type": "faq_item",
          "settings": {
            "question": "How do I get my files?",
            "answer": "<p>Straight after you pay. The download links are on the order confirmation page and in the email that arrives a minute later. Courses open in your account on this site.</p>"
          }
        },
        "faq_item_2": {
          "type": "faq_item",
          "settings": {
            "question": "Can I download them again later?",
            "answer": "<p>Yes. Sign in to your account, or use the link in your email, and download as many times as you need. Keep a copy on your own drive as well.</p>"
          }
        },
        "faq_item_3": {
          "type": "faq_item",
          "settings": {
            "question": "What can I make with them?",
            "answer": "<p>Client work, products you sell, social posts, print and packaging. The standard licence covers one person and unlimited projects. Read the licence page for the few things it does not allow.</p>"
          }
        },
        "faq_item_4": {
          "type": "faq_item",
          "settings": {
            "question": "Can my team use them?",
            "answer": "<p>The standard licence is for one person. Pick the team option on the product page and up to five people can install and use the files.</p>"
          }
        },
        "faq_item_5": {
          "type": "faq_item",
          "settings": {
            "question": "Do I get updates?",
            "answer": "<p>Yes, for free. When a product changes, a new version or extra files, you get an email and the new download replaces the old one in your account.</p>"
          }
        },
        "faq_item_6": {
          "type": "faq_item",
          "settings": {
            "question": "Which apps do I need?",
            "answer": "<p>Each product page lists its files. Fonts install on Mac and Windows, presets work in Lightroom desktop and mobile, brushes need Procreate 5 or later, and the templates open in Figma, Canva or Google Docs.</p>"
          }
        },
        "faq_item_7": {
          "type": "faq_item",
          "settings": {
            "question": "Can I get a refund?",
            "answer": "<p>Digital files cannot be returned, so look at the previews first. If a file is broken or not what the page describes, write within 14 days and you get your money back.</p>"
          }
        },
        "faq_item_8": {
          "type": "faq_item",
          "settings": {
            "question": "Do you do custom work?",
            "answer": "<p>Not at the moment. If you need a font licence for an app or a large team, write and we will quote it.</p>"
          }
        }
      },
      "block_order": [
