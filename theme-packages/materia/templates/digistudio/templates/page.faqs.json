      "blocks": {
        "faq_item_1": {
          "type": "faq_item",
          "settings": {
            "question": "When do I get my files?",
            "answer": "<p>Straight after you pay. The download links are on the order confirmation page and in an email that arrives a minute later. Notion and Canva products open with a link, so there is nothing to install.</p>"
          }
        },
        "faq_item_2": {
          "type": "faq_item",
          "settings": {
            "question": "Which apps do I need?",
            "answer": "<p>Notion templates work on the free Notion plan. Canva templates open in the free Canva plan. Presets work in Lightroom Classic, Lightroom desktop and the free Lightroom mobile app. Ebooks and printables are PDFs, and the digital planner works in GoodNotes, Notability and other PDF apps.</p>"
          }
        },
        "faq_item_3": {
          "type": "faq_item",
          "settings": {
            "question": "Can I download them again later?",
            "answer": "<p>Yes. Use the link in your email or sign in to your account and download as many times as you need.</p>"
          }
        },
        "faq_item_4": {
          "type": "faq_item",
          "settings": {
            "question": "Do I get updates?",
            "answer": "<p>Yes, for free. When a product changes, you get an email and the new version replaces the old one in your account.</p>"
          }
        },
        "faq_item_5": {
          "type": "faq_item",
          "settings": {
            "question": "Can I use them for clients or my business?",
            "answer": "<p>Yes. Use the templates for your own business and for client work. You cannot resell or share the files themselves. The licence page has the details in plain words.</p>"
          }
        },
        "faq_item_6": {
          "type": "faq_item",
          "settings": {
            "question": "Can I get a refund?",
            "answer": "<p>Digital files cannot be returned, so look at the previews first. If a file is broken or not what the page describes, write within 14 days and you get your money back.</p>"
          }
        },
        "faq_item_7": {
          "type": "faq_item",
          "settings": {
            "question": "Do the Notion templates work on the free plan?",
            "answer": "<p>Yes. Every Notion template is built and tested on the free plan, on desktop and on the phone app.</p>"
          }
        },
        "faq_item_8": {
          "type": "faq_item",
          "settings": {
            "question": "Do you do custom work?",
            "answer": "<p>Not at the moment. If you need a version for a team, write and we will tell you what is possible.</p>"
          }
        }
      },
