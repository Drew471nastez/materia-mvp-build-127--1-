      "blocks": {
        "faq_item_1": {
          "type": "faq_item",
          "settings": {
            "question": "What you can do",
            "answer": "<p>Use the files in work for yourself and for clients, in as many projects as you like. Sell what you make with them: printed things, packaging, products, social posts and websites. Change the files to fit the job.</p>"
          }
        },
        "faq_item_2": {
          "type": "faq_item",
          "settings": {
            "question": "Who it covers",
            "answer": "<p>The standard licence is for one person. The team licence covers up to five people in the same business. Freelancers working for a client do not need to buy a second licence for that client.</p>"
          }
        },
        "faq_item_3": {
          "type": "faq_item",
          "settings": {
            "question": "What you cannot do",
            "answer": "<p>Resell or give away the files themselves, alone or in a pack, even if you change them. Put the fonts inside an app or a game, or register a logo set only in one of our fonts as a trademark, without asking first.</p>"
          }
        },
        "faq_item_4": {
          "type": "faq_item",
          "settings": {
            "question": "Fonts on the web",
            "answer": "<p>Pick the desktop and web option on a font page to use the WOFF2 files on your own websites and your clients'. There is no limit on page views.</p>"
          }
        },
        "faq_item_5": {
          "type": "faq_item",
          "settings": {
            "question": "Updates",
            "answer": "<p>Every update to a product is free for everyone who bought it, for as long as the shop sells it.</p>"
          }
        },
        "faq_item_6": {
          "type": "faq_item",
          "settings": {
            "question": "If you are not sure",
            "answer": "<p>Write before you buy and we will answer within two working days. Most questions are answered by yes.</p>"
          }
        }
      },
      "block_order": [
        "faq_item_1",
        "faq_item_2",
        "faq_item_3",
        "faq_item_4",
        "faq_item_5",
