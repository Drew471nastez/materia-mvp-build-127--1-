/* Templates round 26: the licence in plain words, then the bundles. */
{
  "sections": {
    "heading": {
      "type": "page-heading",
      "settings": {
        "color_scheme": "default",
        "section_width": "container",
        "reset_spacing": true,
        "alignment": "left",
        "height": "based_on_content",
        "padding_top": 64,
        "padding_bottom": 24
      },
      "blocks": {
        "heading_1": {
          "type": "heading",
          "settings": {
            "page_title": "The licence, in plain words",
            "header_size": "large",
            "vertical_gap": 10
          }
        },
        "description_2": {
          "type": "description",
          "settings": {
            "description": "<p>One licence comes with every product. This page is all of it.</p>"
          }
        }
      },
      "block_order": [
        "heading_1",
        "description_2"
      ]
    },
    "faq": {
      "type": "faq",
      "settings": {
        "color_scheme": "default",
        "section_width": "container",
        "structured_data": false,
        "heading": "",
        "subheading": "",
        "first_item_open": true,
        "allow_multiple_open": true,
        "open_icon": "plus",
        "content_alignment": "center",
        "max_content_width": 860,
        "gap_header_to_items": 32,
        "gap_heading_to_subheading": 10,
        "gap_between_items": 10,
        "item_padding_y": 22,
        "item_padding_x": 26,
        "item_radius": 10,
        "show_dividers": false,
        "enable_custom_style": true,
        "card_bg": "#f4f2ee",
        "card_border_color": "rgba(0,0,0,0)",
        "question_color": "#17171a",
        "icon_color": "#17171a",
        "answer_color": "#55565b",
        "heading_size_desktop": 40,
        "heading_size_mobile": 30,
        "question_size_desktop": 18,
        "question_size_mobile": 16,
        "enable_custom_question_weight": true,
        "question_weight": "500",
        "answer_size_desktop": 16,
        "answer_size_mobile": 15,
        "reveal": false,
        "padding_top": 16,
        "padding_bottom": 72
      },
      "blocks": {
        "faq_item_1": {
          "type": "faq_item",
          "settings": {
            "question": "What you can do",
            "answer": "<p>Use the templates, presets and guides for yourself, your own business and your clients, in as many projects as you like. Post, print and sell what you make with them.</p>"
          }
        },
        "faq_item_2": {
          "type": "faq_item",
          "settings": {
            "question": "Who it covers",
            "answer": "<p>One person. If a team of up to five uses the same files, write and we will send a team licence at a small extra cost.</p>"
          }
        },
        "faq_item_3": {
          "type": "faq_item",
          "settings": {
            "question": "What you cannot do",
            "answer": "<p>Resell, share or give away the files themselves, alone or in a pack, even if you change them, or sell them as your own templates.</p>"
          }
        },
        "faq_item_4": {
          "type": "faq_item",
          "settings": {
            "question": "Client work",
            "answer": "<p>Set a template up for a client and hand over the result. The client does not need to buy a copy unless they will edit the original files themselves.</p>"
          }
        },
        "faq_item_5": {
          "type": "faq_item",
          "settings": {
            "question": "Updates",
            "answer": "<p>Every update to a product is free for everyone who bought it, for as long as the shop sells it.</p>"
          }
        },
        "faq_item_6": {
          "type": "faq_item",
          "settings": {
            "question": "If you are not sure",
            "answer": "<p>Write before you buy and we will answer within two working days.</p>"
          }
        }
      },
      "block_order": [
        "faq_item_1",
        "faq_item_2",
        "faq_item_3",
        "faq_item_4",
        "faq_item_5",
        "faq_item_6"
      ]
    },
    "bundles": {
      "type": "products-listing",
      "settings": {
        "color_scheme": "default",
        "section_width": "container",
        "collection": "bundles",
        "items_to_show": 2,
        "heading": "Bundles",
        "show_view_all": false,
        "header_alignment": "left",
        "heading_subtext_gap": 10,
        "items_per_row": 2,
        "items_per_row_mobile": 1,
        "column_gap": 20,
        "row_gap": 32,
        "show_badges": true,
        "show_vendor": false,
        "show_rating": true,
        "show_short_description": false,
        "show_swatches": false,
        "show_price": true,
        "show_add_to_cart": true,
        "show_action": true,
        "reveal": false,
        "padding_top": 56,
        "padding_bottom": 96
      },
      "blocks": {
        "heading_1": {
          "type": "heading",
          "settings": {
            "text": "Bundles",
            "size_desktop": 40,
            "size_mobile": 30
          }
        },
        "subheading_2": {
          "type": "subheading",
          "settings": {
            "text": "<p>Every bundle comes with the same licence.</p>"
          }
        }
      },
      "block_order": [
        "heading_1",
        "subheading_2"
      ]
    }
  },
  "order": [
    "heading",
    "faq",
    "bundles"
  ]
}
