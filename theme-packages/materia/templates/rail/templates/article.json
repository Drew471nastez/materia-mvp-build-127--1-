{
  "sections": {
    "main": {
      "type": "main-article",
      "settings": {
        "padding_top": 24,
        "section_width": "container",
        "padding_bottom": 72,
        "author_margin_left": 0,
        "author_margin_right": 0,
        "content_width_desktop": 900,
        "article_style": "editorial"
      },
      "blocks": {
        "breadcrumb_r61": {
          "type": "breadcrumb",
          "settings": {}
        },
        "image": {
          "type": "featured_image",
          "settings": {
            "image_height": "small",
            "featured_image_top_padding": 0,
            "featured_image_border_radius": 12,
            "featured_image_bottom_padding": 0
          }
        },
        "category_r61": {
          "type": "category",
          "settings": {
            "enable_custom_style": false
          }
        },
        "title": {
          "type": "title",
          "settings": {
            "blog_title_font_size": 36
          }
        },
        "meta": {
          "type": "blog_meta",
          "settings": {
            "enable_custom_style": false,
            "blog_meta_border_radius": 0
          }
        },
        "content": {
          "type": "content_article",
          "settings": {}
        },
        "tags_share_r61": {
          "type": "tags_share",
          "settings": {
            "show_tags": true,
            "tags_label": "Tags:",
            "show_share": true
          }
        },
        "prev_next_r61": {
          "type": "prev_next",
          "settings": {
            "show_back": false
          }
        },
        "related_r61": {
          "type": "related",
          "settings": {
            "heading": "Related posts",
            "count": 6,
            "show_excerpt": true,
            "show_author": true,
            "show_date": true
          }
        },
        "comments_r61": {
          "type": "comments",
          "settings": {
            "heading": "Leave a comment",
            "text": "Your email address will not be published.",
            "button_label": "Post comment"
          }
        }
      },
      "block_order": [
        "breadcrumb_r61",
        "image",
        "category_r61",
        "title",
        "meta",
        "content",
        "tags_share_r61",
        "prev_next_r61",
        "related_r61",
        "comments_r61"
      ]
    }
  },
  "order": [
    "main"
  ]
}
