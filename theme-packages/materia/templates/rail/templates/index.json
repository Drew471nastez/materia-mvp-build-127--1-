      "blocks": {
        "h": {
          "type": "heading",
          "settings": {
            "text": "Questions, answered",
            "tag": "h2"
          }
        },
        "q1": {
          "type": "faq_item",
          "settings": {
            "question": "How do the hoodies fit?",
            "answer": "<p>Boxy: wide in the shoulder and a little short in the body. Take your usual size for the intended fit, or one down for a closer one. Every product page has the measurements.</p>"
          }
        },
        "q2": {
          "type": "faq_item",
          "settings": {
            "question": "When will my order ship?",
            "answer": "<p>Orders placed before 2 pm ship the same working day. You get a tracking link by email as soon as it leaves.</p>"
          }
        },
        "q3": {
          "type": "faq_item",
          "settings": {
            "question": "Can I change or cancel my order?",
            "answer": "<p>Write to us within an hour of ordering and we will change the size or cancel it. After that it is usually packed.</p>"
          }
        },
        "q4": {
          "type": "faq_item",
          "settings": {
            "question": "How do returns work?",
            "answer": "<p>Send anything unworn back within 30 days for a refund or another size. The returns page has the address and a printable label.</p>"
          }
        },
        "q5": {
          "type": "faq_item",
          "settings": {
            "question": "How should I wash heavyweight cotton?",
            "answer": "<p>Cold, inside out, and never in the dryer. Dry hoodies flat and tees on a wide hanger so they keep their length.</p>"
          }
        }
      },
      "block_order": [
        "h",
        "q1",
        "q2",
        "q3",
        "q4",
        "q5"
      ]
    },
