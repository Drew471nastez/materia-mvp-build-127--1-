        "faq_item_3": {
          "type": "faq_item",
          "settings": {
            "question": "Is this an ebook or a printed book?",
            "answer": "<p>An ebook. You get a PDF and an EPUB file by email straight after you pay, and you can read them on any phone, tablet, computer or e-reader.</p>"
          }
        },
        "faq_item_4": {
          "type": "faq_item",
          "settings": {
            "question": "What is the difference between the editions?",
            "answer": "<p>The ebook is the book. Ebook and audiobook adds the full audio, read by Hanna. The complete set adds ninety printable post prompts as well.</p>"
          }
        },
        "faq_item_5": {
          "type": "faq_item",
          "settings": {
            "question": "I have not posted in a year. Where do I start?",
            "answer": "<p>Start with chapter two and rewrite your headline, then use one prompt from the back of the book this week. Most people only need to post once to get going again.</p>"
          }
        },
        "faq_item_6": {
          "type": "faq_item",
          "settings": {
            "question": "Do I need a big network to start?",
            "answer": "<p>No. Most of the book is written for people with a few hundred connections, and chapter six covers growing them with people you would like to work with.</p>"
          }
        }
      },
