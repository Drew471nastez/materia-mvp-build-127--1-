        },
        "faq_item_4": {
          "type": "faq_item",
          "settings": {
            "question": "What is the difference between the editions?",
            "answer": "<p>The ebook is the book. Ebook and audiobook adds the full audio, read by Hanna. The complete set adds sixty printable copy templates as well.</p>"
          }
        },
        "faq_item_5": {
          "type": "faq_item",
          "settings": {
            "question": "I have never written copy. Where do I start?",
            "answer": "<p>Start with chapter two and rewrite the headline on your homepage, then use one template from the back of the book this week. You do not need to read it all before you change something.</p>"
          }
        },
