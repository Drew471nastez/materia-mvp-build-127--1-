/* Templates round 22: a money book for your twenties by Maya Okafor, built from the theme's own sections (product hero, quote, image with text, text columns, product grid, testimonial wall, newsletter with image, FAQ, banner); Libre Baskerville and Helvetica. */
{
  "sections": {
    "main": {
      "type": "main-search",
      "settings": {
        "color_scheme": "default",
        "section_width": "fluid_container",
        "reset_spacing": true,
        "heading": "Search",
        "sorting": true,
        "empty_text": "Nothing matched. Try book, audiobook or workbook.",
        "empty_link_label": "See everything",
        "empty_link_url": "/collections/all",
        "enable_filtering": false,
        "filter_layout": "drawer",
        "items_per_row": 3,
        "items_per_row_mobile": 1,
        "column_gap": 24,
        "items_to_show": 12,
        "pagination": "load_more_button",
        "button_show_more": "Show more",
        "padding_top": 56,
        "padding_bottom": 96,
        "number_products_per_page": true,
        "show_filter_counts": false
      }
    },
    "editions": {
      "type": "products-grid",
      "settings": {
        "color_scheme": "scheme-2b5c6c91-201d-4fb1-aba3-e6d562656976",
        "heading": "Get the book",
        "text": "<p>Paperback, ebook or audiobook, and a workbook to go with it.</p>",
        "items_to_show": 4,
        "items_per_row": 4,
        "show_add_to_cart": true,
        "button_label": "All editions",
        "button_link": "/collections/all",
        "header_alignment": "left"
      }
    },
    "chapter": {
      "type": "newsletter-split",
      "settings": {
        "color_scheme": "scheme-4faf0e4d-27f4-4d02-bc51-617383bab1a9",
        "image": "shopify://shop_images/authorbook-cover.webp",
        "image_alt": "The cover of Not Broke Anymore by Maya Okafor",
        "image_position": "left",
        "image_ratio": "portrait",
        "image_width": 40,
        "form_layout": "horizontal",
        "btn_text": "Send it to me",
        "email_placeholder": "Your email",
        "note": "Plus the Sunday money letter every other week. Leave whenever you like.",
        "success_text": "Done. The first chapter is in your inbox."
      },
      "blocks": {
        "heading_1": {
          "type": "heading",
          "settings": {
            "text": "Read the first chapter free"
          }
        },
        "subheading_2": {
          "type": "subheading",
          "settings": {
            "text": "<p>Chapter one and the money map, as a PDF. Twenty minutes to read, and you will know where last month's pay went.</p>"
          }
        }
      },
      "block_order": [
        "heading_1",
        "subheading_2"
      ]
    }
  },
  "order": [
    "main",
    "editions",
    "chapter"
  ]
}
