          "type": "chapter",
          "settings": {
            "title": "Twenty pages, same time every day",
            "line": "Mine are after dinner, before any screen."
          }
        },
        "chapter_2": {
          "type": "chapter",
          "settings": {
            "title": "Always know the next book",
            "line": "A short list of three, so a finished book never leaves a gap."
          }
        },
        "chapter_3": {
          "type": "chapter",
          "settings": {
            "title": "A pencil in every book",
            "line": "Three marks only: a line, a star and a question."
          }
        },
        "chapter_4": {
          "type": "chapter",
          "settings": {
            "title": "One page of notes, the day I finish",
            "line": "Three ideas and one thing to try that week."
          }
        },
        "chapter_5": {
          "type": "chapter",
          "settings": {
            "title": "Quit without guilt",
            "line": "Fifty pages is enough to know."
          }
        }
