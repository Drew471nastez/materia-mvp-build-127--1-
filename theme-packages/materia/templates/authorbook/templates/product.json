        "question_3": {
          "type": "question",
          "settings": {
            "question": "I do not read much now. Is it for me?",
            "answer": "<p>Yes. The book is written for people who used to read and stopped. Chapter one asks for twenty pages a day, nothing more.</p>"
          }
        },
        "question_4": {
          "type": "question",
          "settings": {
            "question": "What is the free chapter?",
            "answer": "<p>The whole of chapter one, The Twenty Page Day, as a PDF. Leave your email at the top of the page and it arrives in a minute.</p>"
