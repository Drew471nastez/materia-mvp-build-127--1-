        "subheading_2": {
          "type": "subheading",
          "settings": {
            "text": "<p>Twelve short chapters. Each ends with one thing to do that week, so you finish the book with a plan you are already using.</p>"
          }
        },
        "column_3": {
          "type": "column",
          "settings": {
            "label": "Chapter 1",
            "heading": "Where it all goes",
            "text": "<p>One month of tracking, without judging a single coffee.</p>"
          }
        },
        "column_4": {
          "type": "column",
          "settings": {
            "label": "Chapter 2",
            "heading": "The money map",
            "text": "<p>One page with your pay, your bills and what is left. You will use it every month.</p>"
          }
        },
        "column_5": {
          "type": "column",
          "settings": {
            "label": "Chapter 3",
            "heading": "A budget with fun in it",
            "text": "<p>Spending money you do not have to feel bad about, set on purpose.</p>"
          }
        },
        "column_6": {
          "type": "column",
          "settings": {
            "label": "Chapter 5",
            "heading": "Out of the overdraft",
            "text": "<p>A plan for cards, buy now pay later and student loans, smallest first.</p>"
          }
        },
        "column_7": {
          "type": "column",
          "settings": {
            "label": "Chapter 7",
            "heading": "One month in the bank",
            "text": "<p>A first emergency fund, built in small automatic steps.</p>"
          }
        },
        "column_8": {
          "type": "column",
          "settings": {
            "label": "Chapter 9",
            "heading": "Investing, the boring way",
            "text": "<p>Index funds, retirement accounts and why boring wins.</p>"
          }
        }
