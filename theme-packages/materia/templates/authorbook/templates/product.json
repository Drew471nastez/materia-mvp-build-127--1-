      "blocks": {
        "chapter_1": {
          "type": "chapter",
          "settings": {
            "title": "The Twenty Page Day",
            "line": "Why a small daily number beats a free hour that never comes."
          }
        },
        "chapter_2": {
          "type": "chapter",
          "settings": {
            "title": "Choosing the Next Book",
            "line": "A five minute way to pick books you will finish."
          }
        },
        "chapter_3": {
          "type": "chapter",
          "settings": {
            "title": "Reading With a Pencil",
            "line": "Three marks in the margin that make notes easy later."
          }
        },
        "chapter_4": {
          "type": "chapter",
          "settings": {
            "title": "Notes That Last",
            "line": "One page per book, written the day you finish it."
          }
        },
        "chapter_5": {
          "type": "chapter",
          "settings": {
            "title": "Quitting Books Well",
            "line": "When to stop, and how to keep what was good."
          }
        },
        "chapter_6": {
          "type": "chapter",
          "settings": {
            "title": "Reading Out Loud",
            "line": "Audiobooks, slow reading and remembering more."
          }
        },
        "chapter_7": {
          "type": "chapter",
          "settings": {
            "title": "The Yearly Shelf",
            "line": "Look back on a year of reading in one evening."
          }
        }
      },
