        "item_2": {
          "type": "item",
          "settings": {
            "label": "Step 1",
            "title": "Watch a short lesson",
            "text": "Each lesson is one idea, shown on real footage, in about ten minutes.",
            "image": "shopify://shop_images/landing-step-lesson.webp",
            "image_alt": "Watching a lesson on a desk monitor at night"
          }
        },
        "item_3": {
          "type": "item",
          "settings": {
            "label": "Step 2",
            "title": "Cut the same clips yourself",
            "text": "Download the raw footage and project file, then make the edit you just watched.",
            "image": "shopify://shop_images/landing-step-edit.webp",
            "image_alt": "Cutting the lesson footage on a laptop"
          }
        },
        "item_4": {
          "type": "item",
          "settings": {
            "label": "Step 3",
            "title": "Get notes on your cut",
            "text": "Bring your edit to the monthly feedback call and leave with notes at the exact timecode.",
            "image": "shopify://shop_images/landing-step-feedback.webp",
            "image_alt": "A feedback call with other students on a laptop"
          }
        },
        "button_5": {
          "type": "button",
