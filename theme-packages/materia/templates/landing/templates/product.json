        "faq_item_4": {
          "type": "faq_item",
          "settings": {
            "question": "I have never edited before. Where do I start?",
            "answer": "<p>The 7 Day Starter. It assumes nothing and ends with a finished one minute video.</p>"
          }
        },
        "faq_item_5": {
          "type": "faq_item",
          "settings": {
            "question": "How long do I have access?",
            "answer": "<p>For as long as the school is open. Watch at your own pace and come back to any lesson.</p>"
