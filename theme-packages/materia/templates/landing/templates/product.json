      "blocks": {
        "heading_1": {
          "type": "heading",
          "settings": {
            "text": "Questions before you start"
          }
        },
        "subheading_2": {
          "type": "subheading",
          "settings": {
            "text": "If yours is not here, write to us and you will hear back within a day."
          }
        },
        "faq_item_3": {
          "type": "faq_item",
          "settings": {
            "question": "Which editing app do I need?",
            "answer": "<p>Any of the common ones. Lessons show the idea first and the clicks second, and each lesson has notes for the three most used apps.</p>"
          }
        },
        "faq_item_4": {
          "type": "faq_item",
          "settings": {
            "question": "I have never edited before. Where do I start?",
            "answer": "<p>The 7 Day Starter. It assumes nothing and ends with a finished one minute video.</p>"
          }
        },
        "faq_item_5": {
          "type": "faq_item",
          "settings": {
            "question": "How long do I have access?",
            "answer": "<p>For as long as the school is open. Watch at your own pace and come back to any lesson.</p>"
          }
        },
        "faq_item_6": {
          "type": "faq_item",
          "settings": {
            "question": "Do I get the footage?",
            "answer": "<p>Yes. Every lesson comes with the raw clips, music and project files you see on screen.</p>"
          }
        },
        "faq_item_7": {
          "type": "faq_item",
          "settings": {
            "question": "How do the feedback calls work?",
            "answer": "<p>Once a month you send a cut of up to three minutes. On the call I go through a few of them on screen, with notes you can rewatch.</p>"
          }
        },
        "faq_item_8": {
          "type": "faq_item",
          "settings": {
            "question": "What if it is not for me?",
            "answer": "<p>Write within 30 days and you get your money back. Replace this with your own refund terms.</p>"
          }
        }
      },
