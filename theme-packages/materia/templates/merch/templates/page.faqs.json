          "settings": {
            "question": "When will my order ship?",
            "answer": "<p>Everything is printed after you order. It ships within five working days and you get a tracking link.</p>"
          }
        },
        "faq_item_4": {
          "type": "faq_item",
          "settings": {
            "question": "What sizes do you have?",
            "answer": "<p>Tees and hoodies come in XS to 3XL. The size chart on each product has chest and length measurements.</p>"
          }
        },
        "faq_item_5": {
          "type": "faq_item",
          "settings": {
            "question": "Can I return merch?",
            "answer": "<p>Yes, within 30 days if it is unworn. Misprints and damaged items are replaced free.</p>"
          }
        },
        "faq_item_6": {
          "type": "faq_item",
          "settings": {
            "question": "Do you ship worldwide?",
            "answer": "<p>Yes. Delivery prices for your country are shown at checkout.</p>"
