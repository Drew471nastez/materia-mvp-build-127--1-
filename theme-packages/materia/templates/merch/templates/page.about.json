        "column_1": {
          "type": "column",
          "settings": {
            "label": "Every Sunday",
            "heading": "The ingredients",
            "text": "<p>Each episode is cooked for real and eaten after. The shop buys the vegetables, the bones and the bread.</p>"
          }
        },
        "column_2": {
          "type": "column",
          "settings": {
            "label": "Monday to Friday",
            "heading": "An editor",
            "text": "<p>Three hours of stirring becomes twenty minutes you want to watch. That is Jo's job, and the shop pays for it.</p>"
          }
        },
        "column_3": {
          "type": "column",
          "settings": {
            "label": "All year",
            "heading": "The studio kitchen",
            "text": "<p>A rented kitchen with good light and a stove that takes a 20 litre pot. Without the shop it would be the flat again.</p>"
          }
        }
