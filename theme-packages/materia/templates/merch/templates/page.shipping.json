            "enable_custom_style": false,
            "use_theme_button": true,
            "radius": 6,
            "size": 16,
            "pad_x": 28,
            "pad_y": 14
          }
        },
        "text_1": {
          "type": "text",
          "settings": {
            "heading": "Dispatch",
            "text": "<p>Orders leave within two working days in a recycled mailer. Say which carrier you use.</p>"
          }
        },
        "text_2": {
          "type": "text",
          "settings": {
            "heading": "Delivery times",
            "text": "<p>List your delivery times and prices for each region you send to.</p>"
          }
        },
        "text_3": {
          "type": "text",
          "settings": {
            "heading": "Customs",
            "text": "<p>Say whether duties are paid at checkout or on delivery.</p>"
          }
        },
        "text_4": {
          "type": "text",
          "settings": {
            "heading": "Returns",
            "text": "<p>30 days from delivery, unworn and unwashed. Say how a return is started and when the refund is sent.</p>"
          }
        },
        "text_5": {
          "type": "text",
          "settings": {
            "heading": "Exchanges",
            "text": "<p>Want another size or colour? Say whether you swap it for free or treat it as a new order.</p>"
          }
        }
