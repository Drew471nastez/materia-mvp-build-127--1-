    "faq": {
      "type": "faq-tabs",
      "settings": {
        "color_scheme": "default",
        "section_width": "full_width",
        "tab_1_label": "Shipping",
        "tab_2_label": "Sizing",
        "tab_3_label": "The channel",
        "open_first": true,
        "allow_multiple_open": false,
        "header_align": "center",
        "padding_top_desktop": 88,
        "padding_bottom_desktop": 88,
        "padding_top_mobile": 56,
        "padding_bottom_mobile": 56
      },
      "blocks": {
        "heading_1": {
          "type": "heading",
          "settings": {
            "text": "Before you order",
            "tag": "h2"
          }
        },
        "subheading_1": {
          "type": "subheading",
          "settings": {
            "text": "<p>Shipping, sizing and where the money goes.</p>"
          }
        },
        "faq_1": {
          "type": "faq_item",
          "settings": {
            "tab": "1",
            "question": "How long does an order take?",
            "answer": "<p>Orders leave the kitchen within three working days. The delivery time for your country is shown at checkout, and a tracking link follows by email.</p>"
          }
        },
        "faq_2": {
          "type": "faq_item",
          "settings": {
            "tab": "1",
            "question": "Do you ship outside the UK?",
            "answer": "<p>Yes, to most countries. Any duties for your country are shown at checkout before you pay.</p>"
          }
        },
        "faq_3": {
          "type": "faq_item",
          "settings": {
            "tab": "1",
            "question": "Can I send something back?",
            "answer": "<p>Unworn clothes can come back within 30 days. A mug or print that arrives broken is replaced: send a photo of it.</p>"
          }
        },
        "faq_4": {
          "type": "faq_item",
          "settings": {
            "tab": "2",
            "question": "How do the tees fit?",
            "answer": "<p>Regular fit, true to size. Each product page has a size guide in centimetres, measured flat.</p>"
          }
        },
        "faq_5": {
          "type": "faq_item",
          "settings": {
            "tab": "2",
            "question": "Is the hoodie oversized?",
            "answer": "<p>Roomy, not oversized. Size down for a closer fit, or stay true to size to wear it over a tee.</p>"
          }
        },
        "faq_6": {
          "type": "faq_item",
          "settings": {
            "tab": "2",
            "question": "Will it shrink?",
            "answer": "<p>The cotton is washed before printing. Wash cold, hang it to dry and it keeps its size and print.</p>"
          }
        },
        "faq_7": {
          "type": "faq_item",
          "settings": {
            "tab": "3",
            "question": "Does my order support the channel?",
            "answer": "<p>Yes. The shop pays for the ingredients, the studio rent and the editor. That is how the episodes stay free and ad light.</p>"
          }
        },
        "faq_8": {
          "type": "faq_item",
          "settings": {
            "tab": "3",
            "question": "Will sold out pieces come back?",
            "answer": "<p>The tees, hoodie, cap and mug are reprinted between seasons. Limited pieces like the Season 4 apron are made once.</p>"
          }
        },
        "faq_9": {
          "type": "faq_item",
          "settings": {
            "tab": "3",
            "question": "Can I send a photo of my soup?",
            "answer": "<p>Please do. Use the contact page or tag #bowlclub. A few end up in the Sunday episode.</p>"
          }
        }
      },
