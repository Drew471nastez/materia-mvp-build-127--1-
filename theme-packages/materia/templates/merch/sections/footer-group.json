{
  "type": "footer",
  "name": "t:sections.footer.name",
  "sections": {
    "footer": {
      "type": "footer",
      "settings": {
        "custom_text": "OKTAV",
        "padding_top": 64,
        "show_social": true,
        "color_scheme": "default",
        "custom_image": "",
        "reset_spacing": true,
        "section_width": "fluid_container",
        "copyright_text": "© {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.",
        "heading_weight": "600",
        "padding_bottom": 28,
        "separator_line": "all-page",
        "arrow_icon_size": 14,
        "link_hover_color": "",
        "heading_transform": "none",
        "custom_text_italic": false,
        "custom_elements_gap": 8,
        "enable_custom_image": false,
        "enable_custom_style": false,
        "footer_heading_size": 13,
        "enable_custom_text_big": true,
        "enable_country_selector": false,
        "custom_image_size_mobile": 168,
        "enable_language_selector": false,
        "custom_image_size_desktop": 144,
        "custom_text_font_size_mobile": 96,
        "custom_text_font_size_desktop": 260,
        "custom_header_position": "bottom",
        "show_policy_links": true
      },
      "blocks": {
        "link_list_1": {
          "type": "link_list",
          "settings": {
            "menu": "main-menu",
            "heading": "Shop",
            "content_width": "16%"
          }
        },
        "link_list_2": {
          "type": "link_list",
          "settings": {
            "menu": "footer",
            "heading": "Care",
            "content_width": "16%"
          }
        },
        "store_info_1": {
          "type": "store_info",
          "settings": {
            "show_logo": false,
            "top_offset": 0,
            "image_width": 110,
            "store_email": true,
            "store_phone": false,
            "content_width": "33.333%",
            "store_address": false,
            "store_heading": "About",
            "store_description": "<p>Hoodies, trackpants and tees in black, grey and white. Heavy fabric, boxy cuts, made to be worn every day.</p>"
          }
        },
        "payment_badges_1": {
          "type": "payment_badges",
          "settings": {
            "alignment": "right",
            "enable_amex": true,
            "enable_visa": true,
            "content_width": "33.333%",
            "enable_klarna": false,
            "enable_paypal": true,
            "enable_apple_pay": true,
            "enable_google_pay": true,
            "enable_mastercard": true
          }
        }
      },
      "block_order": [
        "link_list_1",
        "link_list_2",
        "store_info_1",
        "payment_badges_1"
      ]
    }
  },
  "order": [
    "footer"
  ]
}