      "blocks": {
        "heading_1": {
          "type": "heading",
          "settings": {
            "text": "Questions"
          }
        },
        "subheading_2": {
          "type": "subheading",
          "settings": {
            "text": "<p>About coaching, the programs and the free call.</p>"
          }
        },
        "faq_item_3": {
          "type": "faq_item",
          "settings": {
            "question": "Do I need a gym?",
            "answer": "<p>No. Every program has a gym version and a home version for dumbbells and a bench. Online coaching works with whatever you have.</p>"
          }
        },
        "faq_item_4": {
          "type": "faq_item",
          "settings": {
            "question": "I have never lifted. Is that a problem?",
            "answer": "<p>Most people I coach started there. The first weeks teach the lifts with light weights and plenty of video feedback.</p>"
          }
        },
        "faq_item_5": {
          "type": "faq_item",
          "settings": {
            "question": "What happens on the free call?",
            "answer": "<p>Twenty minutes on video. We talk about your training, your week and what you want. If I am not the right coach for you, I say so and point you somewhere better.</p>"
          }
        },
        "faq_item_6": {
          "type": "faq_item",
          "settings": {
            "question": "Can I pause online coaching?",
            "answer": "<p>Yes. Pause or stop before your next month starts, by email or from your account. There is no minimum term.</p>"
          }
        },
        "faq_item_7": {
          "type": "faq_item",
          "settings": {
            "question": "Do you write meal plans?",
            "answer": "<p>I give simple guidance on protein, meals around training and sleep. For a full meal plan or a medical condition I refer you to a registered dietitian.</p>"
          }
        },
        "faq_item_8": {
          "type": "faq_item",
          "settings": {
            "question": "What if I get injured?",
            "answer": "<p>Tell me in your log. We train around it, and I point you to a physio when it needs one. I am a coach, not a doctor.</p>"
          }
        },
        "card_text_9": {
          "type": "card_text",
          "settings": {
            "heading": "Still deciding?",
            "text": "<p>Book the free call or send me a message. I answer every message myself, within a day.</p>"
          }
        },
        "button_10": {
          "type": "button",
          "settings": {
            "label": "Book a free call",
            "link": "/pages/book-a-call",
            "style": "primary",
