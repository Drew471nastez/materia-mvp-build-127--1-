        "subheading_3": {
          "type": "subheading",
          "settings": {
            "text": "<p>Four weeks at a time, built around the days and the kit you actually have.</p>"
          }
        },
        "step_4": {
          "type": "step",
          "settings": {
            "title": "A free call",
            "description": "<p>Twenty minutes on video: your training so far, your week, old injuries and what you want from the next three months.</p>"
          }
        },
        "step_5": {
          "type": "step",
          "settings": {
            "title": "Your first four weeks",
            "description": "<p>A plan written for you, in the app within three days. Every exercise has a short video and a weight to start with.</p>"
          }
        },
        "step_6": {
          "type": "step",
          "settings": {
            "title": "Train and log",
            "description": "<p>Log your weights and how each set felt. Film a set when I ask for one and I reply with what to change.</p>"
          }
        },
        "step_7": {
          "type": "step",
          "settings": {
            "title": "A review every Sunday",
            "description": "<p>I read your week, answer your questions and adjust the next one. A video call once a month.</p>"
          }
        },
