        "column_3": {
          "type": "column",
          "settings": {
            "label": "01",
            "heading": "Learn the lift first",
            "text": "<p>Light weights and good positions for the first weeks. Load comes once the movement is yours.</p>"
          }
        },
        "column_4": {
          "type": "column",
          "settings": {
            "label": "02",
            "heading": "Train for the week you have",
            "text": "<p>Three hours a week done for a year beats six hours a week done for a month. The plan fits your life, not the other way round.</p>"
          }
        },
        "column_5": {
          "type": "column",
          "settings": {
            "label": "03",
            "heading": "Honest numbers",
            "text": "<p>No promises about kilos lost by a date. We track what you lift, how you sleep and how you feel, and adjust from there.</p>"
          }
        }
      },
