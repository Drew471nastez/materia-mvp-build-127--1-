        "heading_1": {
          "type": "heading",
          "settings": {
            "text": "I'm Ada. I build each template for my own week first.",
            "column": "left",
            "size": 40,
            "size_mobile": 28
          }
        },
        "paragraph_1": {
          "type": "paragraph",
          "settings": {
            "text": "<p>I have run a small design studio from my kitchen table for six years. Freelance desk started as the page I used to stop losing track of invoices. Friends asked for copies, then friends of friends.</p>",
            "column": "right"
          }
        },
        "paragraph_2": {
          "type": "paragraph",
          "settings": {
            "text": "<p>Every template here is one I use, or one I built with someone who does. If a column is there, it earns its place.</p>",
            "column": "right"
          }
        },
