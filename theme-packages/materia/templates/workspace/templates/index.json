      "blocks": {
        "heading_1": {
          "type": "heading",
          "settings": {
            "text": "Questions people ask first"
          }
        },
        "subheading_1": {
          "type": "subheading",
          "settings": {
            "text": "<p>Still unsure? <a href=\"/pages/contact\">Write to me</a> and I will answer within a day or two.</p>"
          }
        },
        "faq_item_1": {
          "type": "faq_item",
          "settings": {
            "question": "Do I need a paid Notion plan?",
            "answer": "<p>No. Every template works on Notion's free plan. You only need an account.</p>",
            "keywords": "free, plan, price, account"
          }
        },
        "faq_item_2": {
          "type": "faq_item",
          "settings": {
            "question": "How do I get the template after I pay?",
            "answer": "<p>Your receipt has a link to the template. Open it while signed in to Notion and press Duplicate. It is in your workspace a few seconds later.</p>",
            "keywords": "download, link, duplicate, receipt"
          }
        },
        "faq_item_3": {
          "type": "faq_item",
          "settings": {
            "question": "Can I change it?",
            "answer": "<p>Yes. Once you duplicate it, it is your page. Rename columns, add properties, change the colours, delete what you do not use.</p>",
            "keywords": "edit, customise, change"
          }
        },
        "faq_item_4": {
          "type": "faq_item",
          "settings": {
            "question": "Does it work on my phone?",
            "answer": "<p>Yes. It works anywhere Notion does: the Mac and Windows apps, the browser, and the iPhone and Android apps.</p>",
            "keywords": "mobile, phone, app, ipad"
          }
        },
        "faq_item_5": {
          "type": "faq_item",
          "settings": {
            "question": "Can I share it with my team?",
            "answer": "<p>You can share your copy inside your own workspace. Please do not resell it or post the duplicate link publicly.</p>",
            "keywords": "share, team, licence, resell"
          }
        },
        "faq_item_6": {
          "type": "faq_item",
          "settings": {
            "question": "What if it is not right for me?",
            "answer": "<p>Write within 14 days and you get your money back. No form, just reply to your receipt.</p>",
            "keywords": "refund, return, money back"
          }
        }
      },
      "block_order": [
        "heading_1",
