{
  "sections": {
    "intro": {
      "type": "banner3",
      "settings": {
        "section_width": "stretch_width",
        "banner_surface": "section",
        "max_width": 760,
        "text_align": "center",
        "heading_tag": "h1",
        "stack_gap": 16,
        "sub_btn_gap": 28,
        "pad_top_desktop": 88,
        "pad_bottom_desktop": 40,
        "pad_top_mobile": 56,
        "pad_bottom_mobile": 24,
        "section_padding_top": 0,
        "section_padding_bottom": 0,
        "section_padding_top_mobile": 0,
        "section_padding_bottom_mobile": 0,
        "reveal": false
      },
      "blocks": {
        "eyebrow_1": {
          "type": "eyebrow",
          "settings": {
            "text": "About"
          }
        },
        "heading_1": {
          "type": "heading",
          "settings": {
            "text": "Hi, I'm Ada. I make the templates I wish I had found.",
            "enable_custom_style": true,
            "font": "heading",
            "weight": "700",
            "transform": "none",
            "letterspace": -0.02,
            "lineheight": "1.1",
            "size_d": 48,
            "size_m": 32,
            "max_width": 0
          }
        },
        "subheading_1": {
          "type": "subheading",
          "settings": {
            "text": "A designer who got tired of losing track of invoices, then of meals, then of books. Each fix became a page, and the pages became this shop.",
            "enable_custom_style": true,
            "font": "body",
            "weight": "theme",
            "transform": "none",
            "lineheight": "1.6",
            "size_d": 18,
            "size_m": 16,
            "max_width": 640,
            "opacity": 100
          }
        }
      },
      "block_order": [
        "eyebrow_1",
        "heading_1",
        "subheading_1"
      ]
    },
    "screen": {
      "type": "image-2",
      "settings": {
        "image": "shopify://shop_images/workspace-hero.webp",
        "image_alt": "The Freelance desk template open in Notion on a tablet",
        "aspect_w": 50,
        "aspect_h": 31,
        "radius": 0,
        "fit": "cover",
        "padding_top_desktop": 8,
        "padding_bottom_desktop": 24,
        "side_padding_desktop": 32,
        "padding_top_mobile": 4,
        "padding_bottom_mobile": 16,
        "side_padding_mobile": 8
      }
    },
    "story": {
      "type": "brand-info",
      "settings": {
        "left_column_width": 40,
        "column_gap": 80,
        "vertical_align": "start",
        "padding_top": 72,
        "padding_bottom": 72
      },
      "blocks": {
        "eyebrow_1": {
          "type": "eyebrow",
          "settings": {
            "text": "How it started",
            "column": "left"
          }
        },
        "heading_1": {
          "type": "heading",
          "settings": {
            "text": "One spreadsheet too many",
            "column": "left",
            "size": 36,
            "size_mobile": 28
          }
        },
        "paragraph_1": {
          "type": "paragraph",
          "settings": {
            "text": "<p>In 2020 I had a client list in one app, invoices in a spreadsheet and deadlines on sticky notes. I moved everything into one Notion page over a weekend, and for the first time I knew who owed me what without looking in three places.</p>",
            "column": "right"
          }
        },
        "paragraph_2": {
          "type": "paragraph",
          "settings": {
            "text": "<p>That page became Freelance desk. The meal planner came next, because the same question kept coming up at six every evening. The rest followed from friends asking for the same kind of help.</p>",
            "column": "right"
          }
        }
      },
      "block_order": [
        "eyebrow_1",
        "heading_1",
        "paragraph_1",
        "paragraph_2"
      ]
    },
    "rules": {
      "type": "image-with-text-bento",
      "settings": {
        "heading": "How I build them",
        "subheading": "Three rules every template follows.",
        "columns": "3",
        "gap_desktop": 16,
        "row_height_desktop": 190,
        "card_padding": 32,
        "card_radius": 18,
        "section_heading_size_desktop": 36,
        "card_heading_size_desktop": 20,
        "card_body_size": 15,
        "padding_top_desktop": 24,
        "padding_bottom_desktop": 88,
        "row_height_mobile": 170
      },
      "blocks": {
        "text_card_1": {
          "type": "text_card",
          "settings": {
            "caption": "",
            "heading": "Used for a month first",
            "heading_tag": "h3",
            "body": "Nothing goes on sale until I, or someone who does that job, has used it every day for a month.",
            "card_style": "tint",
            "enable_custom_style": true,
            "bg": "#f2f1ee",
            "text_color": "#1f1f1d",
            "col_span_desktop": "1",
            "row_span_desktop": "1"
          }
        },
        "text_card_2": {
          "type": "text_card",
          "settings": {
            "caption": "",
            "heading": "As few columns as possible",
            "heading_tag": "h3",
            "body": "Every property has to earn its place. You can always add more; it is harder to know what to delete.",
            "card_style": "tint",
            "enable_custom_style": true,
            "bg": "#f2f1ee",
            "text_color": "#1f1f1d",
            "col_span_desktop": "1",
            "row_span_desktop": "1"
          }
        },
        "text_card_3": {
          "type": "text_card",
          "settings": {
            "caption": "",
            "heading": "Free plan only",
            "heading_tag": "h3",
            "body": "If it needs a paid Notion plan or an outside tool, it does not ship.",
            "card_style": "inverse",
            "col_span_desktop": "1",
            "row_span_desktop": "1"
          }
        }
      },
      "block_order": [
        "text_card_1",
        "text_card_2",
        "text_card_3"
      ]
    },
    "newsletter": {
      "type": "newsletter",
      "settings": {
        "form_layout": "vertical",
        "email_placeholder": "you@example.com",
        "btn_text": "Sign up",
        "note": "One email per new template. Unsubscribe from any of them.",
        "padding_top": 96,
        "padding_bottom": 104
      },
      "blocks": {
        "heading_1": {
          "type": "heading",
          "settings": {
            "text": "Hear about the next template first"
          }
        },
        "subheading_1": {
          "type": "subheading",
          "settings": {
            "text": "<p>One short email when a new template is out, and a launch price for the first week. Nothing in between.</p>"
          }
        }
      },
      "block_order": [
        "heading_1",
        "subheading_1"
      ]
    }
  },
  "order": [
    "intro",
    "screen",
    "story",
    "rules",
    "newsletter"
  ]
}
