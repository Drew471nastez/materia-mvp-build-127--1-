      "blocks": {
        "faq_item_1": {
          "type": "faq_item",
          "settings": {
            "question": "Who are these templates for?",
            "answer": "<p>People who want their money, work, trips and week in one tidy place without building it from scratch. If you can type in a table, you can use them.</p>"
          }
        },
        "faq_item_2": {
          "type": "faq_item",
          "settings": {
            "question": "Do I need a paid Notion plan?",
            "answer": "<p>No. Every template works on Notion's free plan, on the web, the desktop app and the phone app.</p>"
          }
        },
        "faq_item_3": {
          "type": "faq_item",
          "settings": {
            "question": "How do I get a template after I pay?",
            "answer": "<p>The receipt page and the email both have a link. Open it while you are signed in to Notion, press Duplicate and the template is copied into your workspace.</p>"
          }
        },
        "faq_item_4": {
          "type": "faq_item",
          "settings": {
            "question": "Are the free templates really free?",
            "answer": "<p>Yes. Check out at $0, get the same link by email and keep the template. You can unsubscribe from emails at any time.</p>"
          }
        },
        "faq_item_5": {
          "type": "faq_item",
          "settings": {
            "question": "Can I change a template?",
            "answer": "<p>Every page, property and view is yours to edit. Rename things, add columns, delete pages you do not need.</p>"
          }
        },
        "faq_item_6": {
          "type": "faq_item",
          "settings": {
            "question": "What does the commercial licence cover?",
            "answer": "<p>The personal licence is for your own use. The commercial licence lets you use the template inside your business or set it up for one client. Reselling it is not allowed with either.</p>"
          }
        },
        "faq_item_7": {
          "type": "faq_item",
          "settings": {
            "question": "Will I get updates?",
            "answer": "<p>Yes. When a template changes, everyone who bought it gets an email with the new link, at no cost.</p>"
          }
        },
        "faq_item_8": {
