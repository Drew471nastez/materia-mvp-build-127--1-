            "question": "How do the sizes run?",
            "answer": "<p>Tees and hoodies are cut a little boxy. If you are between two sizes, take the smaller one. Each product page has a size chart.</p>"
          }
        },
        "question_2": {
          "type": "question",
          "settings": {
            "question": "How are the prints made?",
            "answer": "<p>Printed to order on heavy cotton with water based ink, so it stays soft and does not crack in the wash.</p>"
          }
        },
        "question_3": {
          "type": "question",
          "settings": {
            "question": "When will my order arrive?",
            "answer": "<p>Orders are printed and sent within three working days, tracked. Add your own delivery times here.</p>"
          }
