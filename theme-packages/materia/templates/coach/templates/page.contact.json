/* Templates round 22: a running coach, built from the theme's own sections (hero image, marquee, image with text, products, rows, steps, testimonials, gallery, FAQ with image, banner). */
{
  "sections": {
    "heading": {
      "type": "page-heading",
      "settings": {
        "height": "adapt",
        "alignment": "left",
        "padding_top": 72,
        "padding_bottom": 24,
        "color_scheme": "default",
        "reset_spacing": true,
        "section_width": "container",
        "overlay_opacity": 0
      },
      "blocks": {
        "heading_1": {
          "type": "heading",
          "settings": {
            "page_title": "",
            "header_size": "medium",
            "heading_font_size": 44
          }
        }
      },
      "block_order": [
        "heading_1"
      ]
    },
    "form": {
      "type": "contactformsimple2",
      "settings": {
        "color_scheme": "default",
        "btn_text": "Send message",
        "ph_website": "Your race and date (optional)",
        "label_website": "Race",
        "success_text": "Thank you. I reply within a day."
      },
      "blocks": {
        "heading_1": {
          "type": "heading",
          "settings": {
            "text": "Write to me"
          }
        },
        "description_2": {
          "type": "description",
          "settings": {
            "text": "<p>Tell me your last few weeks of running and what you are training for. I answer every message myself, within a day.</p>"
          }
        },
        "info_3": {
          "type": "info",
          "settings": {
            "icon": "mail",
            "line1": "hello@example.com",
            "line2": "Or use the form on this page"
          }
        },
        "info_4": {
          "type": "info",
          "settings": {
            "icon": "map",
            "line1": "Austin and online",
            "line2": "Group run Saturdays, 7:30, river trail"
          }
        }
      },
      "block_order": [
        "heading_1",
        "description_2",
        "info_3",
        "info_4"
      ]
    },
    "faq": {
      "type": "faq-side-image",
      "settings": {
        "color_scheme": "scheme-2b5c6c91-201d-4fb1-aba3-e6d562656976",
        "image": "shopify://shop_images/coach-amara-drills.webp",
        "image_position": "left",
        "image_aspect": "4_5",
        "open_first": true,
        "max_width": 1200
      },
      "blocks": {
        "heading_1": {
          "type": "heading",
          "settings": {
            "text": "Quick answers"
          }
        },
        "subheading_2": {
          "type": "subheading",
          "settings": {
            "text": "<p>Anything else? <a href=\"/pages/contact\">Write to me</a> and I answer within a day.</p>"
          }
        },
        "faq_item_3": {
          "type": "faq_item",
          "settings": {
            "question": "I have never run. Is the 5K plan for me?",
            "answer": "<p>Yes. It starts with walking and running in short pieces, three times a week, and builds to 30 minutes of running over eight weeks.</p>"
          }
        },
        "faq_item_4": {
          "type": "faq_item",
          "settings": {
            "question": "How do I get my plan?",
            "answer": "<p>Straight after checkout you get a PDF and a calendar file you can add to your phone, plus a copy by email.</p>"
          }
        },
        "faq_item_5": {
          "type": "faq_item",
          "settings": {
            "question": "What does monthly coaching add?",
            "answer": "<p>I write your plan four weeks at a time, read every run you log, answer messages within a day and adjust when life gets in the way.</p>"
          }
        },
        "faq_item_6": {
          "type": "faq_item",
          "settings": {
            "question": "Do I need a watch?",
            "answer": "<p>No. Every session works by time and effort. A watch is useful later, not to start.</p>"
          }
        },
        "faq_item_7": {
          "type": "faq_item",
          "settings": {
            "question": "I am coming back from an injury.",
            "answer": "<p>Get the all clear from a physio first, then start with monthly coaching so we can build back slowly together.</p>"
          }
        },
        "faq_item_8": {
          "type": "faq_item",
          "settings": {
            "question": "Can I join the Saturday group run?",
            "answer": "<p>Anyone can. It is free, we meet at 7:30 at the river trail, and there is a group for every pace.</p>"
          }
        }
      },
      "block_order": [
        "heading_1",
        "subheading_2",
        "faq_item_3",
        "faq_item_4",
        "faq_item_5",
        "faq_item_6",
        "faq_item_7",
        "faq_item_8"
      ]
    }
  },
  "order": [
    "heading",
    "form",
    "faq"
  ]
}
