/* Templates round 22: a running coach, built from the theme's own sections (hero image, marquee, image with text, products, rows, steps, testimonials, gallery, FAQ with image, banner). */
{
  "sections": {
    "heading": {
      "type": "page-heading",
      "settings": {
        "height": "based_on_content",
        "alignment": "center",
        "padding_top": 104,
        "color_scheme": "scheme-2b5c6c91-201d-4fb1-aba3-e6d562656976",
        "reset_spacing": true,
        "section_width": "container",
        "padding_bottom": 104,
        "overlay_opacity": 38,
        "background_image": "shopify://shop_images/coach-hero.webp",
        "text_on_image": "light"
      },
      "blocks": {
        "heading_xwFKKa": {
          "type": "heading",
          "settings": {
            "page_title": "",
            "header_size": "medium",
            "vertical_gap": 14,
            "heading_font_size": 36,
            "enable_heading_color": false
          }
        },
        "description_YRWpkt": {
          "type": "description",
          "settings": {
            "description": "<p>Notes on easy running, long runs, strength and race week.</p>",
            "enable_custom_style": false,
            "description_font_size": 16
          }
        },
        "breadcrumb_r61": {
          "type": "breadcrumb",
          "settings": {
            "separator": "dot",
            "font_size": 13,
            "uppercase": false
          }
        }
      },
      "block_order": [
        "breadcrumb_r61",
        "heading_xwFKKa",
        "description_YRWpkt"
      ]
    },
    "main": {
      "type": "main-blog",
      "settings": {
        "layout": "grid",
        "row_gap": 56,
        "show_date": true,
        "column_gap": 24,
        "margin_top": 0,
        "title_size": 19,
        "badge_width": 70,
        "image_ratio": "custom",
        "title_hover": "underline",
        "badge_height": 30,
        "custom_ratio": "16:10",
        "hover_effect": "zoom",
        "image_radius": 3,
        "show_excerpt": true,
        "excerpt_lines": 3,
        "items_per_row": 3,
        "items_to_show": 9,
        "margin_bottom": 0,
        "readmore_line": "style",
        "readmore_text": "Read more",
        "readmore_type": "underline",
        "reset_spacing": true,
        "section_width": "fluid_container",
        "show_category": true,
        "show_readmore": false,
        "button_show_more": "Load more",
        "content_alignment": "left",
        "badge_border_radius": 19,
        "enable_custom_style": true,
        "badge_text_font_size": 14,
        "items_per_row_mobile": 1,
        "badge_vertical_position": 16,
        "badge_horizontal_position": 16,
        "card_style": "editorial",
        "sidebar_position": "left",
        "show_author": true,
        "pagination": "default",
        "padding_top": 56,
        "padding_bottom": 72,
        "padding_top_mobile": 36,
        "padding_bottom_mobile": 48
      },
      "name": "Main blog",
      "blocks": {
        "categories_r61": {
          "type": "categories",
          "settings": {
            "heading": "Blog categories",
            "show_count": false
          }
        },
        "recent_r61": {
          "type": "recent",
          "settings": {
            "heading": "Popular posts",
            "count": 3,
            "show_image": true,
            "show_date": true
          }
        },
        "topics_r61": {
          "type": "topics",
          "settings": {
            "heading": "Tags",
            "all_label": ""
          }
        }
      },
      "block_order": [
        "categories_r61",
        "recent_r61",
        "topics_r61"
      ]
    },
    "cta": {
      "type": "banner3",
      "settings": {
        "color_scheme": "scheme-4faf0e4d-27f4-4d02-bc51-617383bab1a9",
        "banner_surface": "section",
        "max_width": 720,
        "pad_top_desktop": 96,
        "pad_bottom_desktop": 96,
        "text_align": "center"
      },
      "blocks": {
        "eyebrow_1": {
          "type": "eyebrow",
          "settings": {
            "text": "Free plan check",
            "transform": "uppercase"
          }
        },
        "heading_2": {
          "type": "heading",
          "settings": {
            "text": "Not sure which plan fits?",
            "transform": "none"
          }
        },
        "subheading_3": {
          "type": "subheading",
          "settings": {
            "text": "Send me your last few weeks of running and your race date. I will tell you where to start, free."
          }
        },
        "button_4": {
          "type": "button",
          "settings": {
            "label": "Ask Amara",
            "link": "/pages/contact"
          }
        }
      },
      "block_order": [
        "eyebrow_1",
        "heading_2",
        "subheading_3",
        "button_4"
      ]
    }
  },
  "order": [
    "heading",
    "main",
    "cta"
  ]
}
