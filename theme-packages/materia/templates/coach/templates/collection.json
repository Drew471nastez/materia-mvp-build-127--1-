        "heading": {
          "type": "heading",
          "settings": {
            "header_size": "default"
          }
        },
        "description": {
          "type": "description",
          "settings": {}
        }
      },
      "block_order": [
        "breadcrumb",
        "heading",
        "description"
      ]
    },
    "main-collection-product": {
