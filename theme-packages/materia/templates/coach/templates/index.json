    "hello": {
      "type": "Image-and-video-text",
      "settings": {
        "color_scheme": "default",
        "image": "shopify://shop_images/coach-amara-portrait.webp",
        "image_alt": "Amara Wells on the track, hands on her hips",
        "image_position": "right",
        "aspect_w": 4,
        "aspect_h": 5,
        "image_radius": 2,
        "text_column_width": 50,
        "padding_top_desktop": 112,
        "padding_bottom_desktop": 112
      },
      "blocks": {
        "eyebrow_1": {
          "type": "eyebrow",
          "settings": {
            "text": "Hi, I'm Amara"
          }
        },
        "heading_2": {
          "type": "heading",
          "settings": {
            "text": "I coach people who run before work",
            "size_desktop": 48
          }
        },
        "subheading_3": {
          "type": "subheading",
          "settings": {
            "text": "<p>I ran the 400 metres in college, then spent years getting injured doing too much, too fast. These days I coach nurses, teachers, parents and night shift workers who want to run a race and still feel good on Monday.</p><p>Most of my runners run less than they expect and finish stronger than they hoped.</p>"
          }
        },
        "button_4": {
          "type": "button",
          "settings": {
            "label": "My story",
            "link": "/pages/about",
            "button_style": "secondary"
          }
        }
      },
      "block_order": [
        "eyebrow_1",
        "heading_2",
        "subheading_3",
        "button_4"
      ]
    },
    "plans": {
      "type": "products-listing",
      "settings": {
        "color_scheme": "scheme-2b5c6c91-201d-4fb1-aba3-e6d562656976",
        "items_to_show": 4,
        "items_per_row": 4,
        "header_alignment": "left",
        "show_rating": false,
        "show_swatches": false,
        "show_vendor": false,
        "show_short_description": false
      },
      "blocks": {
        "eyebrow_1": {
          "type": "eyebrow",
          "settings": {
            "text": "Training plans"
          }
        },
        "heading_2": {
          "type": "heading",
          "settings": {
            "text": "Pick a plan, start Monday"
          }
        },
        "subheading_3": {
          "type": "subheading",
          "settings": {
            "text": "<p>Pay once, keep the plan. Every one comes with a printable week view and a calendar file.</p>"
          }
        },
        "button_4": {
          "type": "button",
          "settings": {
            "text": "All plans",
            "link": "/collections/all",
            "position": "header",
            "button_style": "secondary"
          }
        }
      },
      "block_order": [
        "eyebrow_1",
        "heading_2",
        "subheading_3",
        "button_4"
      ]
    },
    "distances_rows": {
      "type": "image-with-text-multirow",
      "settings": {
        "color_scheme": "default",
        "alternate_rows": true,
        "image_aspect_w": 1,
        "image_aspect_h": 1,
        "text_column_width": 50
      },
      "blocks": {
        "row_1": {
          "type": "row",
          "settings": {
            "image": "shopify://shop_images/coach-road.webp",
            "caption": "8 weeks",
            "heading": "Your first 5K",
            "body": "<p>Three short sessions a week. Walk and run in pieces, then a little more running each week until you run 30 minutes without stopping.</p>",
            "btn_label": "See the 5K plan",
            "btn_link": "/collections/all"
          }
        },
        "row_2": {
          "type": "row",
          "settings": {
            "image": "shopify://shop_images/coach-group.webp",
            "caption": "12 or 16 weeks",
            "heading": "A half marathon that feels good",
            "body": "<p>Mostly easy running, one steady session and a long run that grows slowly. Strength twice a week, 20 minutes, no gym.</p>",
            "btn_label": "See the half plan",
            "btn_link": "/collections/all"
          }
        },
        "row_3": {
          "type": "row",
          "settings": {
            "image": "shopify://shop_images/coach-race.webp",
            "caption": "18 weeks",
            "heading": "Marathon, start to finish line",
            "body": "<p>Built for a first or second marathon, with fuelling practice on the long runs and a pacing plan for race day.</p>",
            "btn_label": "See the marathon plan",
            "btn_link": "/collections/all"
          }
        }
      },
      "block_order": [
        "row_1",
        "row_2",
        "row_3"
      ]
    },
    "how": {
      "type": "steps",
      "settings": {
        "color_scheme": "scheme-4faf0e4d-27f4-4d02-bc51-617383bab1a9",
        "text_align": "center",
        "step_style": "numbered",
        "steps_max_width": 760
      },
      "blocks": {
        "eyebrow_1": {
          "type": "eyebrow",
          "settings": {
            "text": "Monthly coaching"
          }
        },
        "heading_2": {
          "type": "heading",
          "settings": {
            "text": "How coaching works"
          }
        },
        "subheading_3": {
          "type": "subheading",
          "settings": {
            "text": "<p>Four weeks at a time, built around the week you actually have.</p>"
          }
        },
        "step_4": {
          "type": "step",
          "settings": {
            "title": "Tell me about your running",
            "description": "<p>A short form: your recent weeks, your race, your job and how many days you can run.</p>"
          }
        },
        "step_5": {
          "type": "step",
          "settings": {
            "title": "Get four weeks of runs",
            "description": "<p>Every session with a time, an effort and a reason. Synced to your phone's calendar.</p>"
          }
        },
        "step_6": {
          "type": "step",
          "settings": {
            "title": "Run, log it, hear back",
            "description": "<p>Log each run with a line on how it felt. I read them all and reply within a day.</p>"
          }
        },
        "step_7": {
          "type": "step",
          "settings": {
            "title": "Race week",
            "description": "<p>A taper, a pacing plan for the course and a call two days before you run.</p>"
          }
        },
        "button_8": {
          "type": "button",
          "settings": {
            "label": "Start coaching",
            "url": "/pages/book"
          }
        }
      },
      "block_order": [
        "eyebrow_1",
        "heading_2",
        "subheading_3",
        "step_4",
        "step_5",
        "step_6",
        "step_7",
        "button_8"
      ]
    },
