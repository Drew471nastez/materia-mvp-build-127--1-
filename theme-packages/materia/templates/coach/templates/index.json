        "image": "shopify://shop_images/coach-hero.webp",
        "image_mobile": "shopify://shop_images/coach-hero-phone.webp",
        "image_alt": "Amara running on a floodlit track at night",
        "content_align": "left",
        "vertical_align": "center",
        "content_max_width": 640,
        "min_height_desktop": 760,
        "min_height_mobile": 640,
