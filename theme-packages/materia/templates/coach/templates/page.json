/* Templates round 22: a running coach, built from the theme's own sections (hero image, marquee, image with text, products, rows, steps, testimonials, gallery, FAQ with image, banner). */
{
  "sections": {
    "main": {
      "type": "page-default",
      "settings": {
        "padding_top": 64,
        "reset_spacing": true,
        "section_width": "container",
        "padding_bottom": 72
      }
    },
    "cta": {
      "type": "banner3",
      "settings": {
        "color_scheme": "scheme-4faf0e4d-27f4-4d02-bc51-617383bab1a9",
        "banner_surface": "section",
        "max_width": 720,
        "pad_top_desktop": 96,
        "pad_bottom_desktop": 96,
        "text_align": "center"
      },
      "blocks": {
        "eyebrow_1": {
          "type": "eyebrow",
          "settings": {
            "text": "Free plan check",
            "transform": "uppercase"
          }
        },
        "heading_2": {
          "type": "heading",
          "settings": {
            "text": "Not sure which plan fits?",
            "transform": "none"
          }
        },
        "subheading_3": {
          "type": "subheading",
          "settings": {
            "text": "Send me your last few weeks of running and your race date. I will tell you where to start, free."
          }
        },
        "button_4": {
          "type": "button",
          "settings": {
            "label": "Ask Amara",
            "link": "/pages/contact"
          }
        }
      },
      "block_order": [
        "eyebrow_1",
        "heading_2",
        "subheading_3",
        "button_4"
      ]
    }
  },
  "order": [
    "main",
    "cta"
  ]
}
