/* Templates round 22: a running coach, built from the theme's own sections (hero image, marquee, image with text, products, rows, steps, testimonials, gallery, FAQ with image, banner). */
{
  "sections": {
    "story": {
      "type": "Image-and-video-text",
      "settings": {
        "color_scheme": "default",
        "image": "shopify://shop_images/coach-amara-portrait.webp",
        "image_alt": "Amara Wells on the track",
        "image_position": "left",
        "aspect_w": 4,
        "aspect_h": 5,
        "image_radius": 2,
        "padding_top_desktop": 96,
        "padding_bottom_desktop": 96
      },
      "blocks": {
        "eyebrow_1": {
          "type": "eyebrow",
          "settings": {
            "text": "About"
          }
        },
        "heading_2": {
          "type": "heading",
          "settings": {
            "text": "Amara Wells, running coach",
            "tag": "h1",
            "size_desktop": 52
          }
        },
        "subheading_3": {
          "type": "subheading",
          "settings": {
            "text": "<p>I grew up sprinting and ran the 400 metres in college. After that I tried to become a marathoner by running more every week, and spent two years injured.</p><p>A coach fixed it by making most of my running slow. I have been passing that on for nine years, first at a club in Austin and now online.</p>"
          }
        }
      },
      "block_order": [
        "eyebrow_1",
        "heading_2",
        "subheading_3"
      ]
    },
    "beliefs": {
      "type": "text-columns",
      "settings": {
        "color_scheme": "scheme-2b5c6c91-201d-4fb1-aba3-e6d562656976",
        "columns_desktop": 3,
        "show_dividers": true
      },
      "blocks": {
        "heading_1": {
          "type": "heading",
          "settings": {
            "text": "How I coach"
          }
        },
        "subheading_2": {
          "type": "subheading",
          "settings": {
            "text": "<p>Three rules that are in every plan I write.</p>"
          }
        },
        "column_3": {
          "type": "column",
          "settings": {
            "label": "01",
            "heading": "Easy runs are easy",
            "text": "<p>You should be able to talk in full sentences. Most runners go too hard here and too soft on the days that count.</p>"
          }
        },
        "column_4": {
          "type": "column",
          "settings": {
            "label": "02",
            "heading": "Strength twice a week",
            "text": "<p>Twenty minutes at home: calves, hips and a plank. It is the cheapest injury insurance there is.</p>"
          }
        },
        "column_5": {
          "type": "column",
          "settings": {
            "label": "03",
            "heading": "The plan bends",
            "text": "<p>A sick child or a late shift moves the week. Missing one run changes nothing; forcing it can.</p>"
          }
        }
      },
      "block_order": [
        "heading_1",
        "subheading_2",
        "column_3",
        "column_4",
        "column_5"
      ]
    },
    "saturday": {
      "type": "Image-and-video-text",
      "settings": {
        "color_scheme": "default",
        "image": "shopify://shop_images/coach-group.webp",
        "image_alt": "A group of runners heading off along a street",
        "image_position": "right",
