      "blocks": {
        "eyebrow_1": {
          "type": "eyebrow",
          "settings": {
            "text": "Saturday group run"
          }
        },
        "heading_2": {
          "type": "heading",
          "settings": {
            "text": "Free, 7:30, at the river trail"
          }
        },
        "subheading_3": {
          "type": "subheading",
          "settings": {
            "text": "<p>Every Saturday we meet by the boathouse on the river trail. There is a group for every pace and nobody gets left behind. Coffee after, if you want it.</p>"
          }
        },
        "button_4": {
          "type": "button",
