    "how": {
      "type": "steps",
      "settings": {
        "color_scheme": "scheme-2b5c6c91-201d-4fb1-aba3-e6d562656976",
        "text_align": "center",
        "step_style": "numbered",
        "steps_max_width": 760
      },
      "blocks": {
        "eyebrow_1": {
          "type": "eyebrow",
          "settings": {
            "text": "Monthly coaching"
          }
        },
        "heading_2": {
          "type": "heading",
          "settings": {
            "text": "How coaching works"
          }
        },
        "subheading_3": {
          "type": "subheading",
          "settings": {
            "text": "<p>Four weeks at a time, built around the week you actually have.</p>"
          }
        },
        "step_4": {
          "type": "step",
          "settings": {
            "title": "Tell me about your running",
            "description": "<p>A short form: your recent weeks, your race, your job and how many days you can run.</p>"
          }
        },
        "step_5": {
          "type": "step",
          "settings": {
            "title": "Get four weeks of runs",
            "description": "<p>Every session with a time, an effort and a reason. Synced to your phone's calendar.</p>"
          }
        },
        "step_6": {
          "type": "step",
          "settings": {
            "title": "Run, log it, hear back",
            "description": "<p>Log each run with a line on how it felt. I read them all and reply within a day.</p>"
          }
        },
        "step_7": {
          "type": "step",
          "settings": {
            "title": "Race week",
            "description": "<p>A taper, a pacing plan for the course and a call two days before you run.</p>"
          }
        },
        "button_8": {
          "type": "button",
          "settings": {
            "label": "Start coaching",
            "url": "/pages/book"
          }
        }
      },
      "block_order": [
        "eyebrow_1",
        "heading_2",
        "subheading_3",
        "step_4",
        "step_5",
        "step_6",
        "step_7",
        "button_8"
      ]
    },
    "runners": {
      "type": "testimonials",
      "settings": {
        "color_scheme": "default",
        "display_mode": "carousel",
        "columns": 3,
        "header_alignment": "left",
        "card_style": "outline",
        "show_rating": false,
        "show_arrow": true,
        "carousel_pagination": "show",
        "pagination_style": "line",
        "pagination_position": "left",
        "avatar_shape": "circle"
      },
      "blocks": {
        "eyebrow_1": {
          "type": "eyebrow",
          "settings": {
            "enabled": true,
            "text": "Runners"
          }
        },
        "heading_2": {
          "type": "heading",
          "settings": {
            "enabled": true,
            "text": "From people I coach"
          }
        },
        "subheading_3": {
          "type": "subheading",
          "settings": {
            "enabled": true,
            "text": "<p>Sample words to show the layout. Replace them with quotes from your own runners, with their permission.</p>"
          }
        },
        "testimonial_4": {
          "type": "testimonial",
          "settings": {
            "quote": "<p>I had not run since school. Eight weeks later I ran 5K without stopping and I still run three times a week.</p>",
            "rating": 0,
            "name": "Sample runner",
            "role": "5K from scratch",
            "avatar": "shopify://shop_images/coach-client-2.webp"
          }
        },
        "testimonial_5": {
          "type": "testimonial",
          "settings": {
            "quote": "<p>My first half marathon felt good at mile 12, which nobody had told me was possible.</p>",
            "rating": 0,
            "name": "Sample runner",
            "role": "Half marathon plan",
            "avatar": "shopify://shop_images/coach-client-1.webp"
          }
        },
        "testimonial_6": {
          "type": "testimonial",
          "settings": {
            "quote": "<p>Amara cut my mileage, and I ran faster. The easy runs were the bit I had wrong for years.</p>",
            "rating": 0,
            "name": "Sample runner",
            "role": "Monthly coaching",
            "avatar": "shopify://shop_images/coach-client-3.webp"
          }
        },
        "testimonial_7": {
          "type": "testimonial",
          "settings": {
            "quote": "<p>The form video showed me I was overstriding. Two small changes and my shins stopped hurting.</p>",
            "rating": 0,
            "name": "Sample runner",
            "role": "Form check",
            "avatar": "shopify://shop_images/coach-client-5.webp"
          }
        },
        "testimonial_8": {
          "type": "testimonial",
          "settings": {
            "quote": "<p>I work shifts. She moved my long run every week and never made me feel bad about it.</p>",
            "rating": 0,
            "name": "Sample runner",
            "role": "Monthly coaching",
            "avatar": "shopify://shop_images/coach-client-4.webp"
          }
        }
      },
      "block_order": [
        "eyebrow_1",
        "heading_2",
        "subheading_3",
        "testimonial_4",
        "testimonial_5",
        "testimonial_6",
        "testimonial_7",
        "testimonial_8"
