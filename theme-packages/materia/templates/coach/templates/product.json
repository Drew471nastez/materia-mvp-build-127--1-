    "faq": {
      "type": "coach2-faq",
      "settings": {
        "background": "#f3f4f6",
        "main_heading": false,
        "eyebrow": "Questions",
        "heading": "Before you book",
        "text": "<p>Anything else? <a href=\"/pages/contact\">Send me a message</a> and I will answer within a working day.</p>",
        "padding_top": 104,
        "padding_bottom": 104
      },
      "blocks": {
        "question_1": {
          "type": "question",
          "settings": {
            "question": "Who do you work with?",
            "answer": "<p>People in their first few years of managing others: team leads, new heads of a function and founders hiring their first team. Most of my clients lead between three and twenty people.</p>"
          }
        },
        "question_2": {
          "type": "question",
          "settings": {
            "question": "What happens on the free call?",
            "answer": "<p>Twenty minutes on video. You tell me about your team and what is hard right now, I ask a few questions, and I say honestly whether I can help. There is no pitch at the end.</p>"
          }
        },
        "question_3": {
          "type": "question",
          "settings": {
            "question": "Can my company pay for it?",
            "answer": "<p>Often, yes. Many clients use a training or development budget. You get an invoice in the company's name, and I can send a short outline for your manager.</p>"
          }
        },
        "question_4": {
          "type": "question",
          "settings": {
            "question": "How long do clients usually stay?",
            "answer": "<p>Most stay four to six months on monthly coaching. You can stop or pause any month, with no notice period.</p>"
          }
        },
        "question_5": {
          "type": "question",
          "settings": {
            "question": "Is what I say kept private?",
            "answer": "<p>Yes. When a company pays, I share only that we are meeting, never what we talk about.</p>"
          }
        },
        "question_6": {
          "type": "question",
          "settings": {
            "question": "What if it is not working?",
            "answer": "<p>Tell me. If after the first month you feel it is not worth it, I refund that month.</p>"
          }
        }
      },
      "block_order": [
        "question_1",
        "question_2",
