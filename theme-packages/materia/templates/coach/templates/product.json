            "buy_appearance": "theme",
            "atc_icon_enable": false,
            "buy_icon_enable": false,
            "show_gift_card_recipient": false,
            "enable_custom_button_text": true,
            "atc_button_text": "Add to cart",
            "buy_button_text": "Buy now"
          }
        },
        "vertical_benefits_1": {
          "type": "vertical_benefits",
          "settings": {
            "vb_pt": 16,
            "vb_pb": 16,
            "vb_mt": 0,
            "vb_mb": 0,
            "vb_item_space": 10,
            "vb_maxw": 100,
            "vb_pl": 0,
            "vb_pr": 0,
            "vb_text_size_d": 14,
            "vb_text_size_m": 14,
            "vb_icon_gap": 12,
            "vb_icon_gap_m": 10,
            "vb_icon_size": 22,
            "vb_icon_size_m": 22,
            "vb_text_color": "",
            "vb_bg": "",
            "vb_icon_color": "#2b44ff",
            "item1_title": "Plan and calendar file sent straight away",
            "item1_icon_library": "clock",
            "item1_use_image": false,
            "item1_image_size": 50,
            "item2_title": "Every session with a time and an effort",
            "item2_icon_library": "check",
            "item2_use_image": false,
            "item2_image_size": 50,
            "item3_title": "Swap to another plan within 14 days",
            "item3_icon_library": "shield",
            "item3_use_image": false,
            "item3_image_size": 50
          }
        },
        "collapsible_row_1": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What is included",
            "content": "",
            "use_product_description": true,
            "open": true
          }
        },
        "collapsible_row_2": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How the plan works",
            "content": "<p>Each week has three to five runs and two short strength sessions. Every run has a time, an effort you can feel and one line on why it is there.</p>",
            "use_product_description": false,
            "open": false
          }
        },
        "collapsible_row_3": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Swaps and refunds",
            "content": "<p>Bought the wrong plan? Write within 14 days and I swap it. Monthly coaching can be stopped any month.</p>",
            "use_product_description": false,
            "open": false
          }
        },
        "collapsible_row_4": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Not sure which one?",
            "content": "<p>Send me your last few weeks of running and your race date and I will tell you where to start. <a href=\"/pages/contact\">Ask Amara</a></p>",
            "use_product_description": false,
            "open": false
          }
        }
      },
      "block_order": [
        "title_1",
        "price_1",
        "short_description_1",
        "variant_picker_1",
        "buy_buttons_1",
        "vertical_benefits_1",
        "collapsible_row_1",
        "collapsible_row_2",
        "collapsible_row_3",
        "collapsible_row_4"
