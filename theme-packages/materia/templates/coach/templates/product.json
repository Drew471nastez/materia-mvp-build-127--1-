/* Templates round 22: a running coach, built from the theme's own sections (hero image, marquee, image with text, products, rows, steps, testimonials, gallery, FAQ with image, banner). */
{
  "sections": {
    "breadcrumb": {
      "type": "breadcrumb",
      "settings": {
        "alignment": "left",
        "font_size": 13,
        "next_prev": false,
