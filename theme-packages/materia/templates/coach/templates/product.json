    "after": {
      "type": "coach2-steps",
      "settings": {
        "background": "#f3f4f6",
        "eyebrow": "How it works",
        "heading": "From the first call to a plan you use",
        "text": "<p>No long questionnaire and no theory. We work on your real team and your real calendar from week one.</p>",
        "button_label": "Book a free call",
        "button_link": "/pages/book",
        "heading_size": 52,
        "padding_top": 104,
        "padding_bottom": 104,
        "image": "shopify://shop_images/coach-mateo-board.webp",
        "image_alt": "Mateo at a whiteboard, explaining with both hands",
        "image_focus": "center"
      },
      "blocks": {
        "step_1": {
          "type": "step",
          "settings": {
            "title": "A free call",
            "time": "20 min",
            "text": "You tell me about your team and what is hard right now. I tell you honestly whether I can help, and how."
          }
        },
        "step_2": {
          "type": "step",
          "settings": {
            "title": "Look at your week",
            "time": "Week 1",
            "text": "Where your hours go, who needs what from you and what only you can do. One page that shows it."
          }
        },
        "step_3": {
          "type": "step",
          "settings": {
            "title": "Pick three changes",
            "time": "Week 2",
            "text": "Not twenty. Three habits with the most effect, each with a first step this week."
          }
        },
        "step_4": {
          "type": "step",
          "settings": {
            "title": "Do the work, check in",
            "time": "Every month",
            "text": "We meet, look at what moved and what did not, and adjust. You keep the plan between calls."
          }
        }
      },
      "block_order": [
        "step_1",
        "step_2",
        "step_3",
        "step_4"
      ]
    },
