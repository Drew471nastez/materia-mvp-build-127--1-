        "variant_picker_1": {
          "type": "variant_picker",
          "settings": {
            "variant_type": "swatches",
            "show_size_guide": false,
            "picker_swatch_style": "theme"
          }
        },
        "buy_buttons_1": {
          "type": "buy_buttons",
          "settings": {
            "show_add_to_cart": true,
            "show_dynamic_checkout": true,
            "show_quantity": false,
            "buttons_full_width": true,
            "quantity_right_of_atc": false,
            "show_wishlist_button": false,
            "atc_appearance": "theme",
            "buy_appearance": "theme",
            "atc_icon_enable": false,
            "buy_icon_enable": false,
            "show_gift_card_recipient": false,
            "enable_custom_button_text": true,
            "atc_button_text": "Add to cart",
            "buy_button_text": "Buy now"
          }
        },
        "collapsible_row_1": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What is included",
            "content": "",
            "use_product_description": true,
            "open": true
          }
        },
        "collapsible_row_2": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How the plan works",
            "content": "<p>Each week has three to five runs and two short strength sessions. Every run has a time, an effort you can feel and one line on why it is there.</p>",
            "use_product_description": false,
            "open": false
          }
        },
        "collapsible_row_3": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Swaps and refunds",
            "content": "<p>Bought the wrong plan? Write within 14 days and I swap it. Monthly coaching can be stopped any month.</p>",
            "use_product_description": false,
            "open": false
          }
        },
        "collapsible_row_4": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Not sure which one?",
            "content": "<p>Send me your last few weeks of running and your race date and I will tell you where to start. <a href=\"/pages/contact\">Ask Amara</a></p>",
            "use_product_description": false,
            "open": false
          }
        },
        "pp23_rating": {
          "type": "product_reviews",
          "settings": {
            "review_source": "product",
            "review_label": "reviews",
            "padding_top": 0,
            "padding_bottom": 10,
            "enable_counter_custom": false
          }
        },
        "pp23_sold": {
          "type": "sold_counter",
          "settings": {
            "sold_source": "product",
            "refresh_sold_count": true,
            "sold_label": "sold",
            "show_live_dot": true,
            "padding_top": 2,
            "padding_bottom": 16,
            "enable_counter_custom": false
          }
        },
        "pp23_info": {
          "type": "infotables",
          "settings": {
            "max_width": 760,
            "center_card": false,
            "section_pt_d": 6,
            "section_pb_d": 22,
            "section_pt_m": 6,
            "section_pb_m": 18,
            "pt_d": 16,
            "pb_d": 16,
            "pl_d": 20,
            "pr_d": 20,
            "pt_m": 14,
            "pb_m": 14,
            "pl_m": 16,
            "pr_m": 16,
            "font_size_d": 15,
            "font_size_m": 14,
            "line_height": 150,
            "font_weight": 400,
            "icon_gap": 16,
            "icon_size": 22,
            "border_style": "solid",
            "divider_style": "solid",
            "enable_custom_style": false,
            "row1_enable": true,
            "row2_enable": false,
            "row3_enable": true,
            "row1_highlight_weight": 600,
            "row2_highlight_weight": 600,
            "row3_highlight_weight": 600,
            "row1_custom_icon": true,
            "row2_custom_icon": false,
            "row3_custom_icon": true,
