/* Templates round 22: a running coach, built from the theme's own sections (hero image, marquee, image with text, products, rows, steps, testimonials, gallery, FAQ with image, banner). */
{
  "sections": {
    "faq": {
      "type": "faq-pro",
      "settings": {
        "color_scheme": "default",
        "first_item_open": true,
        "content_alignment": "left",
        "max_content_width": 860
      },
      "blocks": {
        "heading_1": {
          "type": "heading",
          "settings": {
            "text": "Questions",
            "tag": "h2"
          }
        },
        "subheading_2": {
          "type": "subheading",
          "settings": {
            "text": "<p>About the plans, coaching and the Saturday run.</p>"
          }
        },
        "faq_item_3": {
          "type": "faq_item",
          "settings": {
            "question": "I have never run. Is the 5K plan for me?",
            "answer": "<p>Yes. It starts with walking and running in short pieces, three times a week, and builds to 30 minutes of running over eight weeks.</p>"
          }
        },
        "faq_item_4": {
          "type": "faq_item",
          "settings": {
            "question": "How do I get my plan?",
            "answer": "<p>Straight after checkout you get a PDF and a calendar file you can add to your phone, plus a copy by email.</p>"
          }
        },
        "faq_item_5": {
          "type": "faq_item",
          "settings": {
            "question": "What does monthly coaching add?",
            "answer": "<p>I write your plan four weeks at a time, read every run you log, answer messages within a day and adjust when life gets in the way.</p>"
          }
        },
        "faq_item_6": {
          "type": "faq_item",
          "settings": {
            "question": "Do I need a watch?",
            "answer": "<p>No. Every session works by time and effort. A watch is useful later, not to start.</p>"
          }
        },
        "faq_item_7": {
          "type": "faq_item",
          "settings": {
            "question": "I am coming back from an injury.",
            "answer": "<p>Get the all clear from a physio first, then start with monthly coaching so we can build back slowly together.</p>"
          }
        },
        "faq_item_8": {
          "type": "faq_item",
          "settings": {
            "question": "Can I join the Saturday group run?",
            "answer": "<p>Anyone can. It is free, we meet at 7:30 at the river trail, and there is a group for every pace.</p>"
          }
        },
        "faq_item_9": {
          "type": "faq_item",
          "settings": {
            "question": "Can I change plans after I buy?",
            "answer": "<p>Write to me within 14 days and I swap it for another plan, no questions.</p>"
          }
        },
        "faq_item_10": {
          "type": "faq_item",
          "settings": {
            "question": "Is there a refund on coaching?",
            "answer": "<p>If after the first month it is not worth it to you, tell me and I refund that month.</p>"
          }
        },
        "button_11": {
          "type": "button",
          "settings": {
            "label": "Write to me",
            "link": "/pages/contact",
            "style": "secondary"
          }
        }
      },
      "block_order": [
        "heading_1",
        "subheading_2",
        "faq_item_3",
        "faq_item_4",
        "faq_item_5",
        "faq_item_6",
        "faq_item_7",
        "faq_item_8",
        "faq_item_9",
        "faq_item_10",
        "button_11"
      ]
    },
    "how": {
      "type": "steps",
      "settings": {
        "color_scheme": "scheme-2b5c6c91-201d-4fb1-aba3-e6d562656976",
        "text_align": "center",
        "step_style": "numbered",
        "steps_max_width": 760
      },
      "blocks": {
        "eyebrow_1": {
          "type": "eyebrow",
          "settings": {
            "text": "Monthly coaching"
          }
        },
        "heading_2": {
          "type": "heading",
          "settings": {
            "text": "How coaching works"
          }
        },
        "subheading_3": {
          "type": "subheading",
          "settings": {
            "text": "<p>Four weeks at a time, built around the week you actually have.</p>"
          }
        },
        "step_4": {
          "type": "step",
          "settings": {
            "title": "Tell me about your running",
            "description": "<p>A short form: your recent weeks, your race, your job and how many days you can run.</p>"
          }
        },
        "step_5": {
          "type": "step",
          "settings": {
            "title": "Get four weeks of runs",
            "description": "<p>Every session with a time, an effort and a reason. Synced to your phone's calendar.</p>"
          }
        },
        "step_6": {
          "type": "step",
          "settings": {
            "title": "Run, log it, hear back",
            "description": "<p>Log each run with a line on how it felt. I read them all and reply within a day.</p>"
          }
        },
        "step_7": {
          "type": "step",
          "settings": {
            "title": "Race week",
            "description": "<p>A taper, a pacing plan for the course and a call two days before you run.</p>"
          }
        },
        "button_8": {
          "type": "button",
          "settings": {
            "label": "Start coaching",
            "url": "/pages/book"
          }
        }
      },
      "block_order": [
        "eyebrow_1",
        "heading_2",
        "subheading_3",
        "step_4",
        "step_5",
        "step_6",
        "step_7",
        "button_8"
      ]
    },
    "cta": {
      "type": "banner3",
      "settings": {
        "color_scheme": "scheme-4faf0e4d-27f4-4d02-bc51-617383bab1a9",
        "banner_surface": "section",
        "max_width": 720,
        "pad_top_desktop": 96,
        "pad_bottom_desktop": 96,
        "text_align": "center"
      },
      "blocks": {
        "eyebrow_1": {
          "type": "eyebrow",
          "settings": {
            "text": "Free plan check",
            "transform": "uppercase"
          }
        },
        "heading_2": {
          "type": "heading",
          "settings": {
            "text": "Not sure which plan fits?",
            "transform": "none"
          }
        },
        "subheading_3": {
          "type": "subheading",
          "settings": {
            "text": "Send me your last few weeks of running and your race date. I will tell you where to start, free."
          }
        },
        "button_4": {
          "type": "button",
          "settings": {
            "label": "Ask Amara",
            "link": "/pages/contact"
          }
        }
      },
      "block_order": [
        "eyebrow_1",
        "heading_2",
        "subheading_3",
        "button_4"
      ]
    }
  },
  "order": [
    "faq",
    "how",
    "cta"
  ]
}
