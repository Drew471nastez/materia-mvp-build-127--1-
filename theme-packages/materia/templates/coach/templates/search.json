/* Templates round 22: a running coach, built from the theme's own sections (hero image, marquee, image with text, products, rows, steps, testimonials, gallery, FAQ with image, banner). */
{
  "sections": {
    "main": {
      "type": "main-search",
      "settings": {
        "sorting": true,
        "column_gap": 28,
        "pagination": "infinit_scrolling",
        "padding_top": 24,
        "filter_layout": "horizontal",
        "items_per_row": 3,
        "items_to_show": 12,
        "section_width": "container",
        "default_filter": "open_all",
        "padding_bottom": 48,
        "vertical_posion": "left",
        "button_show_more": "Show more",
        "enable_filtering": false,
        "show_filter_counts": true,
        "items_per_row_mobile": 1,
        "number_products_per_page": true
      }
    },
    "plans": {
      "type": "products-listing",
      "settings": {
        "color_scheme": "scheme-2b5c6c91-201d-4fb1-aba3-e6d562656976",
        "items_to_show": 4,
        "items_per_row": 4,
        "header_alignment": "left",
        "show_rating": false,
        "show_swatches": false
      },
      "blocks": {
        "heading_1": {
          "type": "heading",
          "settings": {
            "text": "Training plans"
          }
        },
        "button_2": {
          "type": "button",
          "settings": {
            "text": "All plans",
            "link": "/collections/all",
            "position": "header",
            "button_style": "secondary"
          }
        }
      },
      "block_order": [
        "heading_1",
        "button_2"
      ]
    },
    "cta": {
      "type": "banner3",
      "settings": {
        "color_scheme": "scheme-4faf0e4d-27f4-4d02-bc51-617383bab1a9",
        "banner_surface": "section",
        "max_width": 720,
        "pad_top_desktop": 96,
        "pad_bottom_desktop": 96,
        "text_align": "center"
      },
      "blocks": {
        "eyebrow_1": {
          "type": "eyebrow",
          "settings": {
            "text": "Free plan check",
            "transform": "uppercase"
          }
        },
        "heading_2": {
          "type": "heading",
          "settings": {
            "text": "Not sure which plan fits?",
            "transform": "none"
          }
        },
        "subheading_3": {
          "type": "subheading",
          "settings": {
            "text": "Send me your last few weeks of running and your race date. I will tell you where to start, free."
          }
        },
        "button_4": {
          "type": "button",
          "settings": {
            "label": "Ask Amara",
            "link": "/pages/contact"
          }
        }
      },
      "block_order": [
        "eyebrow_1",
        "heading_2",
        "subheading_3",
        "button_4"
      ]
    }
  },
  "order": [
    "main",
    "plans",
    "cta"
  ]
}
