    "curriculum": {
      "type": "renaissance-curriculum",
      "settings": {
        "background": "#0e0e0f",
        "accent": "#e3a63a",
        "gold": "#e3a63a",
        "text_color": "#aeaaa2",
        "anchor": "curriculum",
        "eyebrow": "Curriculum",
        "heading": "Six modules, one plan",
        "intro": "<p>Each module ends with one thing set up and working in your own business.</p>",
        "open_first": true,
        "button_label": "",
        "button_link": "/#shopify-section-pricing",
        "note": "Start the day you join. One module a week works well.",
        "caps": true,
        "button_text": "#15130f",
        "padding_top": 96
      },
      "blocks": {
        "module_1": {
          "type": "module",
          "settings": {
            "title": "Foundations that hold up",
            "topic": "Basics",
            "text": "Know what these tools are good at, what they get wrong, and how to ask so the answer is usable the first time.",
            "lesson_count": "6 lessons",
            "duration": "48 min",
            "lessons": "What AI is good at, and where it fails\nChoosing tools without the hype\nPrompts that work: role, task, context, format\nChecking answers you cannot trust yet\nClient data and privacy\nYour AI notebook"
          }
        },
        "module_2": {
          "type": "module",
          "settings": {
            "title": "Writing in your own voice",
            "topic": "Content",
            "text": "Build a voice guide once, then write emails, posts, pages and proposals that sound like you, in a fraction of the time.",
            "lesson_count": "7 lessons",
            "duration": "1 h 05 min",
            "lessons": "Build your voice guide\nEmails and replies in half the time\nProduct pages and descriptions\nA month of posts in an afternoon\nEditing, not generating\nProposals that win\nYour newsletter, drafted"
          }
        },
        "module_3": {
          "type": "module",
          "settings": {
            "title": "Customer service and sales",
            "topic": "Sales",
            "text": "Answer customers faster without sounding like a robot, and follow up on every lead without a spreadsheet.",
            "lesson_count": "7 lessons",
            "duration": "58 min",
            "lessons": "A reply library for the questions you get daily\nHandling refunds and complaints\nLead follow up that runs itself\nSales calls: prepare in five minutes\nTurning reviews into answers\nChat on your website, done carefully\nMeasuring what changed"
          }
        },
        "module_4": {
          "type": "module",
          "settings": {
            "title": "Research and decisions",
            "topic": "Strategy",
            "text": "Use AI as a fast research assistant: competitors, pricing, customer feedback and the numbers in your own business.",
            "lesson_count": "6 lessons",
            "duration": "52 min",
            "lessons": "Competitor research in an hour\nReading customer feedback at scale\nPricing checks\nYour numbers, explained in plain words\nPlanning a launch\nA decision journal"
          }
        },
        "module_5": {
          "type": "module",
          "settings": {
            "title": "Automations that run while you work",
            "topic": "Operations",
            "text": "Connect the tools you already pay for so invoices, bookings, reports and handovers happen without you.",
            "lesson_count": "8 lessons",
            "duration": "1 h 20 min",
            "lessons": "Where automation pays and where it does not\nYour first automation in 20 minutes\nInvoices that chase themselves\nBookings and reminders\nThe weekly report, written for you\nOnboarding new clients\nHandovers between people\nKeeping it all safe"
          }
        },
        "module_6": {
          "type": "module",
          "settings": {
            "title": "Your AI operating system",
            "topic": "Systems",
            "text": "Put it together: which jobs go to AI, which stay with people, and the weekly routine that keeps it working.",
            "lesson_count": "6 lessons",
            "duration": "44 min",
            "lessons": "Mapping your week\nWhat to hand over first\nTraining your team\nCosts and tools, reviewed\nThe weekly routine\nYour next 90 days"
          }
        }
      },
      "block_order": [
        "module_1",
        "module_2",
        "module_3",
        "module_4",
        "module_5",
        "module_6"
      ]
    },
