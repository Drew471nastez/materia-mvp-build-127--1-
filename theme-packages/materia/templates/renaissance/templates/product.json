    "guarantee": {
      "type": "renaissance-guarantee",
      "settings": {
        "background": "#07080d",
        "accent": "#3d5afe",
        "gold": "#f2bd4f",
        "text_color": "#a7adbf",
        "anchor": "guarantee",
        "days": "30",
