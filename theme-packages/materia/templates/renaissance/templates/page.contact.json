      "blocks": {
        "heading_1": {
          "type": "heading",
          "settings": {
            "text": "Get your questions answered",
            "size_enable": true,
            "size_desktop": 56,
            "size_mobile": 36,
            "weight": "700"
          }
        },
        "subheading_1": {
          "type": "subheading",
          "settings": {
            "text": "<p>Something else? <a href=\"/pages/contact\">Write to us</a> and a person answers within a working day.</p>"
          }
        },
        "faq_item_1": {
          "type": "faq_item",
          "settings": {
            "tab": "1",
            "question": "Do I need to be technical?",
            "answer": "<p>No. If you can write an email and use a spreadsheet, you can do every lesson. Module one starts from the very beginning.</p>"
          }
        },
        "faq_item_2": {
          "type": "faq_item",
          "settings": {
            "tab": "1",
            "question": "Which AI tools do I need?",
            "answer": "<p>One general chat assistant, free or paid, and the tools you already use for email and files. Every lesson says when a paid plan is worth it.</p>"
          }
        },
        "faq_item_3": {
          "type": "faq_item",
          "settings": {
            "tab": "1",
            "question": "Is my customers’ data safe?",
            "answer": "<p>Module one covers what never to paste into a chat, how to turn off training on your data and how to write a simple AI policy for your team.</p>"
          }
        },
        "faq_item_4": {
          "type": "faq_item",
          "settings": {
            "tab": "1",
            "question": "Will this work for my kind of business?",
            "answer": "<p>It is built for service businesses, shops, agencies and consultants. If most of your week is writing, answering, organising or researching, it fits.</p>"
          }
        },
        "faq_item_5": {
          "type": "faq_item",
          "settings": {
            "tab": "2",
            "question": "Can I pay in parts?",
            "answer": "<p>Yes. Every edition can be paid in full or in three monthly parts at checkout.</p>"
          }
        },
        "faq_item_6": {
          "type": "faq_item",
          "settings": {
            "tab": "2",
            "question": "What is the refund policy?",
            "answer": "<p>Do the first two modules. If it is not saving you time, write within 30 days and you get your money back.</p>"
          }
        },
        "faq_item_7": {
          "type": "faq_item",
          "settings": {
            "tab": "2",
            "question": "Do you invoice businesses?",
            "answer": "<p>Yes. The receipt shows your business name and tax number, and the team edition comes with one invoice.</p>"
          }
        },
        "faq_item_8": {
          "type": "faq_item",
          "settings": {
            "tab": "3",
            "question": "How long do I have access?",
            "answer": "<p>For as long as the course runs, including every update and new lesson.</p>"
          }
        },
        "faq_item_9": {
          "type": "faq_item",
          "settings": {
            "tab": "3",
            "question": "How much time does it take?",
            "answer": "<p>About two hours a week for six weeks. Lessons are short, and each ends with one thing to set up in your business.</p>"
          }
        },
        "faq_item_10": {
          "type": "faq_item",
          "settings": {
            "tab": "3",
            "question": "When are the live calls?",
            "answer": "<p>Thursdays at 6pm UK time for the cohort edition, recorded and posted the same evening. Change this to your own schedule.</p>"
          }
        }
      },
