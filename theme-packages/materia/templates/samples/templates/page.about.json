        "heading_1": {
          "type": "heading",
          "settings": {
            "text": "Sounds recorded through tape, then cut by hand",
            "tag": "h1",
            "enable_custom_style": false,
            "size_desktop": 44,
            "size_mobile": 32
          }
        },
        "subheading_1": {
          "type": "subheading",
          "settings": {
            "text": "<p>Tape Room is one producer, a four track cassette deck and a cupboard of old drum machines. Every sound in a pack is played or programmed here, printed to tape, then cut, tuned and named before it goes anywhere near the shop.</p><p>The packs are made for producers who finish records, so the folders are tidy and the names tell you the key and tempo.</p>",
            "enable_custom_style": false,
            "size_desktop": 17,
            "size_mobile": 15
          }
        },
        "button_1": {
