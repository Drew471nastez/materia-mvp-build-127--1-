          "settings": {
            "label": "01",
            "heading": "Recorded",
            "text": "<p>Drum machines, a Rhodes, a bass synth and a room mic, through the cassette deck and a small desk.</p>"
          }
        },
        "column_2": {
          "type": "column",
          "settings": {
            "label": "02",
            "heading": "Cut and tuned",
            "text": "<p>Every one shot is trimmed to its transient and tuned to a note. Every loop is cut on the bar.</p>"
          }
        },
        "column_3": {
          "type": "column",
          "settings": {
            "label": "03",
            "heading": "Tested in tracks",
            "text": "<p>Before a pack goes on sale, three beats are made with nothing but its sounds.</p>"
          }
        }
