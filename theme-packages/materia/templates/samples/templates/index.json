        "heading_1": {
          "type": "heading",
          "settings": {
            "text": "Before you download",
            "tag": "h2",
            "size_enable": true,
            "size_desktop": 44,
            "size_mobile": 30
          }
        },
        "subheading_1": {
          "type": "subheading",
          "settings": {
            "text": "<p>Files, the licence and your DAW.</p>"
          }
        },
        "faq_1": {
          "type": "faq_item",
          "settings": {
            "tab": "1",
            "question": "How do I get the files?",
            "answer": "<p>The download link is on the page straight after you pay, and in the receipt email. It works on any computer, as often as you need it.</p>"
          }
        },
        "faq_2": {
          "type": "faq_item",
          "settings": {
            "tab": "1",
            "question": "What format are the sounds?",
            "answer": "<p>24 bit WAV at 44.1 kHz. Loops carry their key and BPM in the file name, and MIDI files sit next to the loops they play.</p>"
          }
        },
        "faq_3": {
          "type": "faq_item",
          "settings": {
            "tab": "1",
            "question": "I lost my download. Can I get it again?",
            "answer": "<p>Yes. Open the link in your receipt email again, or <a href=\"/pages/contact\">write to us</a> with your order number and we send a fresh one.</p>"
          }
        },
        "faq_4": {
          "type": "faq_item",
          "settings": {
            "tab": "2",
            "question": "Can I release songs made with these sounds?",
            "answer": "<p>Yes, on every platform, and the royalties are all yours. You do not need to credit Tape Room.</p>"
          }
        },
        "faq_5": {
          "type": "faq_item",
          "settings": {
            "tab": "2",
            "question": "Can I use them in paid client work?",
            "answer": "<p>Yes. Beats for artists, sync, adverts, games and film are all covered.</p>"
          }
        },
        "faq_6": {
          "type": "faq_item",
          "settings": {
            "tab": "2",
            "question": "What is not allowed?",
            "answer": "<p>Selling or sharing the sounds as they are, putting them in another sample pack or library, and registering a sound on its own with a content ID service. <a href=\"/pages/licence\">Read the licence</a>.</p>"
          }
        },
        "faq_7": {
          "type": "faq_item",
          "settings": {
            "tab": "3",
            "question": "Which DAWs do the packs work in?",
            "answer": "<p>All of them. WAV and MIDI open in Ableton Live, FL Studio, Logic Pro, Cubase, Studio One, Reaper and Bitwig.</p>"
          }
        },
        "faq_8": {
          "type": "faq_item",
          "settings": {
            "tab": "3",
            "question": "Do I need a plugin?",
            "answer": "<p>No. Every sound is audio or MIDI, so nothing needs installing or activating.</p>"
          }
        },
        "faq_9": {
          "type": "faq_item",
          "settings": {
            "tab": "3",
            "question": "Can I hear a pack before I buy?",
            "answer": "<p>Get the <a href=\"/pages/free\">free sampler</a>: 40 sounds, at least one from every pack, at full quality.</p>"
          }
        }
      },
