    "faq": {
      "type": "faq-tabs",
      "settings": {
        "color_scheme": "scheme-tr-panel",
        "section_width": "full_width",
        "tab_1_label": "Downloads",
        "tab_2_label": "Licence",
        "tab_3_label": "Your DAW",
