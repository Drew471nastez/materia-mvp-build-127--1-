          "settings": {
            "text": "Questions before you download",
            "tag": "h2",
            "size_enable": true,
            "size_desktop": 40,
            "size_mobile": 30
          }
        },
        "subheading_1": {
          "type": "subheading",
          "settings": {
            "text": "<p>The licence, the files and paying.</p>"
          }
        },
        "faq_1": {
          "type": "faq_item",
          "settings": {
            "tab": "1",
            "question": "Are Loudlib packs royalty free?",
            "answer": "<p>Yes. Every sound is 100% royalty free, commercial releases included. Use the samples and presets in your own tracks and keep everything they earn.</p>"
          }
        },
        "faq_2": {
          "type": "faq_item",
          "settings": {
            "tab": "1",
            "question": "What is not allowed?",
            "answer": "<p>Sharing or reselling the packs, or their banks and packaging, and rendering a project file or template and releasing that exact song as your own. <a href=\"/pages/licence\">Read the licence</a>.</p>"
          }
        },
        "faq_3": {
          "type": "faq_item",
          "settings": {
            "tab": "2",
            "question": "How do I get the files?",
            "answer": "<p>Right after checkout you get an email receipt with your download page link. Packs come as a ZIP or RAR file of WAV samples.</p>"
          }
        },
        "faq_4": {
          "type": "faq_item",
          "settings": {
            "tab": "2",
            "question": "Which DAWs do the packs work in?",
            "answer": "<p>Every major one. The sounds are WAV files, so you drag them into Ableton Live, FL Studio, Logic Pro or any other DAW.</p>"
          }
        },
        "faq_5": {
          "type": "faq_item",
          "settings": {
            "tab": "2",
            "question": "Do I need a plugin?",
            "answer": "<p>Not for the sample packs. The Serum presets need Xfer Serum 1.368 or later, which is sold separately.</p>"
          }
        },
        "faq_6": {
          "type": "faq_item",
          "settings": {
            "tab": "3",
            "question": "I am having trouble with a download",
            "answer": "<p>Write to <a href=\"mailto:team@loudlib.net\">team@loudlib.net</a> or use the <a href=\"/pages/contact\">contact page</a> and we will sort it out.</p>"
          }
        },
        "faq_7": {
          "type": "faq_item",
          "settings": {
            "tab": "3",
            "question": "How can I pay?",
            "answer": "<p>With a credit or debit card (Visa, Mastercard, American Express and others) or with PayPal.</p>"
          }
        }
      },
