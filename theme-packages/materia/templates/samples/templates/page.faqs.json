        "faq_item_1": {
          "type": "faq_item",
          "settings": {
            "question": "How do I get the files?",
            "answer": "<p>The download link is on the page straight after you pay, and in the receipt email. It works on any computer, as often as you need it.</p>",
            "keywords": "link email download"
          }
        },
        "faq_item_2": {
          "type": "faq_item",
          "settings": {
            "question": "What format are the sounds?",
            "answer": "<p>24 bit WAV at 44.1 kHz. Loops carry their key and BPM in the file name, and MIDI files sit next to the loops they play. Serum presets come as .fxp files.</p>",
            "keywords": "wav format quality bit"
          }
        },
        "faq_item_3": {
          "type": "faq_item",
          "settings": {
            "question": "I lost my download. Can I get it again?",
            "answer": "<p>Yes. Open the link in your receipt email again, or <a href=\"/pages/contact\">write to us</a> with your order number and we send a fresh one.</p>",
            "keywords": "lost again redownload"
          }
        },
        "faq_item_4": {
          "type": "faq_item",
          "settings": {
            "question": "Can I release songs made with these sounds?",
            "answer": "<p>Yes, on every platform, and the royalties are all yours. You do not need to credit Loudlib.</p>",
            "keywords": "release royalties streaming"
          }
        },
        "faq_item_5": {
          "type": "faq_item",
          "settings": {
            "question": "Can I use them in paid client work?",
            "answer": "<p>Yes. Beats for artists, sync, adverts, games and film are all covered.</p>",
            "keywords": "client sync paid"
          }
        },
        "faq_item_6": {
          "type": "faq_item",
          "settings": {
            "question": "What is not allowed?",
            "answer": "<p>Selling or sharing the sounds as they are, putting them in another sample pack or library, and registering a sound on its own with a content ID service. <a href=\"/pages/licence\">Read the licence</a>.</p>",
            "keywords": "not allowed resell share"
          }
        },
        "faq_item_7": {
          "type": "faq_item",
          "settings": {
            "question": "Which DAWs do the packs work in?",
            "answer": "<p>All of them. WAV and MIDI open in Ableton Live, FL Studio, Logic Pro, Cubase, Studio One, Reaper and Bitwig.</p>",
            "keywords": "daw ableton fl logic"
          }
        },
        "faq_item_8": {
          "type": "faq_item",
          "settings": {
            "question": "Do I need a plugin?",
            "answer": "<p>Not for the sample packs: every sound is audio or MIDI. The Serum presets need Xfer Serum.</p>",
            "keywords": "plugin install"
          }
        },
        "faq_item_9": {
          "type": "faq_item",
          "settings": {
            "question": "Can I hear a pack before I buy?",
            "answer": "<p>Yes. Every pack has a demo on its page, and the <a href=\"/pages/free\">free downloads</a> are full quality.</p>",
            "keywords": "demo listen preview free"
          }
        },
        "faq_item_10": {
          "type": "faq_item",
          "settings": {
            "question": "Do you give refunds?",
            "answer": "<p>Downloads cannot be returned, so we refund a pack that has not been downloaded. If a file is broken, we fix it or refund it.</p>",
            "keywords": "refund money back"
          }
        },
        "faq_item_11": {
          "type": "faq_item",
          "settings": {
            "question": "Do packs get updated?",
            "answer": "<p>When a pack gets new sounds, everyone who bought it gets them at no cost through the same link.</p>",
            "keywords": "update new version"
          }
        }
      },
