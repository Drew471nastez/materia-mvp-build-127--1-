      "blocks": {
        "heading_1": {
          "type": "heading",
          "settings": {
            "text": "What you can and cannot do",
            "tag": "h2",
            "enable_custom_style": false,
            "weight": "theme",
            "size_desktop": 48,
            "size_mobile": 30,
            "line_height": 1.2,
            "tracking": 0
          }
        },
        "subheading_1": {
          "type": "subheading",
          "settings": {
            "text": "<p>Buying a pack gives you, and only you, the right to use its sounds in your own music.</p>",
            "enable_custom_style": false,
            "size": 16,
            "line_height": 1.5,
            "max_width": 560
          }
        },
        "positive_1": {
          "type": "positive",
          "settings": {
            "text": "Release music made with the sounds, commercially, on any platform",
            "icon_type": "check"
          }
        },
        "positive_2": {
          "type": "positive",
          "settings": {
            "text": "Use them in sync, adverts, games, film and client work",
            "icon_type": "check"
          }
        },
        "positive_3": {
          "type": "positive",
          "settings": {
            "text": "Edit, layer, pitch and resample them however you like",
            "icon_type": "check"
          }
        },
        "divider_1": {
          "type": "divider",
          "settings": {}
        },
        "negative_1": {
          "type": "negative",
          "settings": {
            "text": "Resell, share or give away the files, as they are or repackaged",
            "icon_type": "cross"
          }
        },
        "negative_2": {
          "type": "negative",
          "settings": {
            "text": "Use them to make another sample pack, preset bank or instrument",
            "icon_type": "cross"
          }
        },
        "negative_3": {
          "type": "negative",
          "settings": {
            "text": "Claim a sample by itself through a content ID system",
            "icon_type": "cross"
          }
        }
      },
