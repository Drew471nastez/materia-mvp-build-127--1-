          "type": "heading",
          "settings": {
            "text": "The details",
            "enable_custom_style": false,
            "enable_custom_fonts": false,
            "font": "assistant_n4",
            "weight_enable": false,
            "weight": "700",
            "size_enable": false,
            "size_desktop": 36,
            "size_mobile": 28,
            "line_height": 1.15,
            "tracking": 0
          }
        },
        "column_1": {
          "type": "column",
          "settings": {
            "label": "For good",
            "heading": "Yours to keep",
            "text": "<p>Every product you buy is yours for good, and the music you make with it stays cleared.</p>"
          }
        },
        "column_2": {
          "type": "column",
          "settings": {
            "label": "Free packs",
            "heading": "Free packs too",
            "text": "<p>The free downloads come with the same licence as the paid packs.</p>"
          }
        },
        "column_3": {
          "type": "column",
          "settings": {
            "label": "Anything else",
            "heading": "Ask first",
            "text": "<p>If a use is not covered here, write to <a href=\"mailto:team@loudlib.net\">team@loudlib.net</a> before you release.</p>"
          }
        }
      },
