      "blocks": {
        "heading_1": {
          "type": "heading",
          "settings": {
            "text": "The details",
            "enable_custom_style": false,
            "enable_custom_fonts": false,
            "font": "assistant_n4",
            "weight_enable": false,
            "weight": "700",
            "size_enable": false,
            "size_desktop": 36,
            "size_mobile": 28,
            "line_height": 1.15,
            "tracking": 0
          }
        },
        "column_1": {
          "type": "column",
          "settings": {
            "label": "Who",
            "heading": "One licence per person",
            "text": "<p>A duo or a studio sharing one pack needs one licence each. Labels can <a href=\"/pages/contact\">write to us</a> for a team licence.</p>"
          }
        },
        "column_2": {
          "type": "column",
          "settings": {
            "label": "How long",
            "heading": "It does not expire",
            "text": "<p>Tracks you release stay cleared, even if the pack leaves the shop.</p>"
          }
        },
        "column_3": {
          "type": "column",
          "settings": {
            "label": "Anything else",
            "heading": "Ask first",
            "text": "<p>If a use is not covered here, <a href=\"/pages/contact\">write to us</a> before you release.</p>"
          }
        }
      },
      "block_order": [
        "heading_1",
        "column_1",
