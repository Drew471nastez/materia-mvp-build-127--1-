        "faq_item_1": {
          "type": "faq_item",
          "settings": {
            "tab": "1",
            "question": "When is the next drop?",
            "answer": "<p>The date goes to the email list first, a day before the store opens.</p>"
          }
        },
        "faq_item_2": {
          "type": "faq_item",
          "settings": {
            "tab": "1",
            "question": "Will a sold out piece come back?",
            "answer": "<p>No. Each piece is made once. Say here if you ever make an exception.</p>"
          }
        },
        "faq_item_3": {
          "type": "faq_item",
          "settings": {
            "tab": "1",
            "question": "Can I buy more than one?",
            "answer": "<p>One of each size per order, so a run reaches more people.</p>"
          }
        },
        "faq_item_4": {
          "type": "faq_item",
          "settings": {
            "tab": "2",
            "question": "How do the pieces fit?",
            "answer": "<p>Say whether your cut runs boxy, true to size or small, and what to do between sizes.</p>"
          }
        },
        "faq_item_5": {
          "type": "faq_item",
          "settings": {
            "tab": "2",
            "question": "Where is the size chart?",
            "answer": "<p>On every product page, under the size options. Measurements are of the garment, laid flat.</p>"
          }
        },
        "faq_item_6": {
          "type": "faq_item",
          "settings": {
            "tab": "3",
            "question": "How long does shipping take?",
            "answer": "<p>Orders leave within 48 hours. Add your delivery times by region.</p>"
          }
        },
        "faq_item_7": {
          "type": "faq_item",
          "settings": {
            "tab": "3",
            "question": "Can I return a piece?",
            "answer": "<p>Yes, for 14 days, unworn and with the tags on. Say who pays for the return.</p>"
