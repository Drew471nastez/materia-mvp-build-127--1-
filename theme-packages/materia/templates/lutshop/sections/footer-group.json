/* Templates round 68: Coldframe's footer, the logo with a line about the shop, three menus and payment badges, on the panel scheme. */
{
  "type": "footer",
  "name": "t:sections.footer.name",
  "sections": {
    "footer": {
      "type": "footer",
      "settings": {
        "color_scheme": "scheme-3c9e1d42-6f1a-4b7e-9d20-5a8c0e7b1f31",
        "section_width": "container",
        "padding_top": 72,
        "padding_bottom": 32,
        "reset_spacing": true,
        "copyright_text": "© {{ 'now' | date: '%Y' }} Coldframe",
        "show_social": false,
        "show_policy_links": true,
        "separator_line": "unset",
        "heading_weight": "600",
        "footer_heading_size": 14
      },
      "blocks": {
        "store_info_1": {
          "type": "store_info",
          "settings": {
            "show_logo": true,
            "store_heading": "",
            "image_width": 150,
            "store_email": true,
            "store_phone": false,
            "store_address": false,
            "content_width": "34%",
            "store_description": "<p>LUT packs, transitions, overlays and sound effects for Premiere Pro, DaVinci Resolve, Final Cut Pro and CapCut. Made by a working colourist, downloaded the minute you pay.</p>"
          }
        },
        "link_list_1": {
          "type": "link_list",
          "settings": {
            "menu": "footer",
            "heading": "Shop",
            "content_width": "22%"
          }
        },
        "link_list_2": {
          "type": "link_list",
          "settings": {
            "menu": "footer-help",
            "heading": "Help",
            "content_width": "22%"
          }
        },
        "link_list_3": {
          "type": "link_list",
          "settings": {
            "menu": "footer-more",
            "heading": "Coldframe",
            "content_width": "22%"
          }
        },
        "payment_badges_1": {
          "type": "payment_badges",
          "settings": {
            "alignment": "right",
            "enable_amex": true,
            "enable_visa": true,
            "content_width": "100%",
            "enable_klarna": false,
            "enable_paypal": true,
            "enable_apple_pay": true,
            "enable_google_pay": true,
            "enable_mastercard": true
          }
        }
      },
      "block_order": [
        "store_info_1",
        "link_list_1",
        "link_list_2",
        "link_list_3",
        "payment_badges_1"
      ]
    }
  },
  "order": [
    "footer"
  ]
}
