            "question": "What you can do",
            "answer": "<p>Use the LUTs, transitions, overlays and sounds in videos for yourself and for clients, in as many projects as you like: social, YouTube, ads, music videos, weddings, films.</p>"
          }
        },
        "faq_item_2": {
          "type": "faq_item",
          "settings": {
            "question": "Who it covers",
            "answer": "<p>One editor. A team of up to five on the same projects can write for a team licence at a small extra cost.</p>"
          }
        },
        "faq_item_3": {
          "type": "faq_item",
          "settings": {
            "question": "What you cannot do",
            "answer": "<p>Resell, share or give away the files themselves, alone or in a pack, even if you change them, or sell your own LUTs made from these.</p>"
          }
        },
        "faq_item_4": {
          "type": "faq_item",
          "settings": {
            "question": "Client work",
            "answer": "<p>Deliver the finished video. The client does not need a copy unless they will grade or edit the project themselves.</p>"
          }
        },
