      "blocks": {
        "faq_item_1": {
          "type": "faq_item",
          "settings": {
            "question": "Which apps do the LUTs work in?",
            "answer": "<p>Every LUT is a .cube file, so it loads in Premiere Pro, DaVinci Resolve, Final Cut Pro and CapCut, and in After Effects, Photoshop and LumaFusion too. The PDF in each pack shows where it goes in each app.</p>"
          }
        },
        "faq_item_2": {
          "type": "faq_item",
          "settings": {
            "question": "Log or Rec.709, which one do I load?",
            "answer": "<p>Each pack has both. Shot in S-Log3, V-Log, C-Log3, F-Log or Apple Log? Load the version for your camera's log. Shot in a standard picture profile, or on a phone? Load the Rec.709 version.</p>"
          }
        },
        "faq_item_3": {
          "type": "faq_item",
          "settings": {
            "question": "When do I get the files?",
            "answer": "<p>Straight after you pay. The download link is on the confirmation page and in an email a minute later. It is a single zip per product.</p>"
          }
        },
        "faq_item_4": {
          "type": "faq_item",
          "settings": {
            "question": "Do the transitions work in CapCut?",
            "answer": "<p>The Clean Cuts pack has project files for Premiere Pro, DaVinci Resolve and Final Cut Pro, and the same transitions as video clips you lay over a cut in CapCut or any other editor.</p>"
          }
        },
        "faq_item_5": {
          "type": "faq_item",
          "settings": {
            "question": "Can I use them for client work?",
            "answer": "<p>Yes. Use them in videos for yourself and for clients, on social, YouTube, ads and films. You cannot resell or share the files themselves. The licence page has the details.</p>"
          }
        },
        "faq_item_6": {
          "type": "faq_item",
          "settings": {
            "question": "Can I get a refund?",
            "answer": "<p>Files cannot be returned once downloaded, so look at the before and after first. If a file is broken or not what the page shows, write within 14 days and we fix it or refund you.</p>"
          }
        },
        "faq_item_7": {
          "type": "faq_item",
          "settings": {
            "question": "Will a LUT fix my exposure or white balance?",
            "answer": "<p>No LUT can. Set exposure and white balance first, then add the look. The guide shows the order for each app.</p>"
          }
        },
        "faq_item_8": {
          "type": "faq_item",
          "settings": {
            "question": "Do I get updates?",
            "answer": "<p>Yes, for free. When a pack gains a look, the new zip replaces the old one in your account and you get an email.</p>"
          }
        }
      },
