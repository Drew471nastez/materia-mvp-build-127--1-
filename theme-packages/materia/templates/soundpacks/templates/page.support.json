/* Templates round 26: Lowmoth support: the four things people write about with a link each, a form a person reads, and quick answers on downloads and orders. */
{
  "sections": {
    "heading": {
      "type": "page-heading",
      "settings": {
        "height": "adapt",
        "alignment": "left",
        "padding_top": 72,
        "color_scheme": "",
        "reset_spacing": true,
        "section_width": "container",
        "padding_bottom": 24,
        "overlay_opacity": 0
      },
      "blocks": {
        "heading_1": {
          "type": "heading",
          "settings": {
            "page_title": "Support",
            "header_size": "large",
            "vertical_gap": 14,
            "heading_font_size": 56,
            "enable_heading_color": false
          }
        },
        "description_2": {
          "type": "description",
          "settings": {
            "description": "<p>Most problems have a quick answer below. If yours does not, write to us and a person replies within a day.</p>",
            "enable_custom_style": false,
            "description_font_size": 17
          }
        }
      },
      "block_order": [
        "heading_1",
        "description_2"
      ]
    },
    "topics": {
      "type": "text-columns",
      "settings": {
        "color_scheme": "default",
        "section_width": "container",
        "reset_spacing": true,
        "content_alignment": "left",
        "columns_desktop": 4,
        "columns_tablet": 2,
        "column_gap": 24,
        "header_gap": 24,
        "show_dividers": true,
        "enable_custom_style": true,
        "label_color": "#c6f432",
        "item_heading_color": "#f3f3f4",
        "text_color": "#a3a3ab",
        "divider_color": "#26262a",
        "item_heading_size": 21,
        "reveal": false,
        "padding_top": 24,
        "padding_bottom": 40,
        "mobile_layout": "stack",
        "show_arrows": false,
        "item_heading_size_mobile": 19,
        "padding_top_mobile": 16,
        "padding_bottom_mobile": 32
      },
      "blocks": {
        "col_1": {
          "type": "column",
          "settings": {
            "label": "Downloads",
            "heading": "A link that will not open",
            "text": "<p>Open it on a computer, not a phone, and let the ZIP finish before you unzip it. Each link works again and again.</p>",
            "link_label": "Download questions",
            "link": "/pages/faqs"
          }
        },
        "col_2": {
          "type": "column",
          "settings": {
            "label": "Licence",
            "heading": "What you can release",
            "text": "<p>Anything you make with the sounds, released or for a client. You cannot share or resell the sounds themselves.</p>",
            "link_label": "Read the licence",
            "link": "/pages/licence"
          }
        },
        "col_3": {
          "type": "column",
          "settings": {
            "label": "Refunds",
            "heading": "Not what you expected",
            "text": "<p>Write within 14 days of buying with your order number and we refund it. No form to fill in.</p>",
            "link_label": "Ask for a refund",
            "link": "/pages/contact"
          }
        },
        "col_4": {
          "type": "column",
          "settings": {
            "label": "Account",
            "heading": "Lost a download link",
            "text": "<p>Write with the email you bought with and we send every pack you own again, usually the same day.</p>",
            "link_label": "Ask for your links",
            "link": "/pages/contact"
          }
        }
      },
      "block_order": [
        "col_1",
        "col_2",
        "col_3",
        "col_4"
      ]
    },
    "form": {
      "type": "contact-form-simple",
      "settings": {
        "color_scheme": "default",
        "section_width": "full_width",
        "show_section_on": "all",
        "reset_spacing": true,
        "submit_label": "Send message",
        "success_message": "Thank you. Your message has been sent.",
        "error_message": "Please check the following:",
        "header_align": "center",
        "section_max_width_desktop": 960,
        "section_max_width_tablet": 900,
        "section_max_width_mobile": 560,
        "heading_sub_gap_desktop": 14,
        "heading_sub_gap_mobile": 8,
        "gap_subheading_content": 56,
        "gap_subheading_content_mobile": 32,
        "side_column_position": "right",
        "form_col_ratio": "3fr",
        "side_col_ratio": "2fr",
        "col_gap_desktop": 48,
        "col_gap_mobile": 32,
        "enable_custom_style": false,
        "field_gap": 16,
        "form_padding": 32,
        "form_radius": 16,
        "label_size": 14,
        "label_weight": "theme",
