        "use_theme_fields": true,
        "input_border_width": 1,
        "input_radius": 10,
        "input_padding_y": 14,
        "input_padding_x": 16,
        "input_size": 16,
        "submit_full_width": false,
        "use_theme_button": true,
        "submit_radius": 100,
        "submit_size": 16,
        "submit_pad_x": 32,
        "submit_pad_y": 16,
        "side_image_radius": 16,
        "enable_custom_fonts": false,
        "heading_font": "assistant_n4",
        "body_font": "assistant_n4",
        "padding_top_desktop": 72,
        "padding_bottom_desktop": 72,
        "section_margin_top_desktop": 0,
        "section_margin_bottom_desktop": 0,
        "padding_top_mobile": 56,
        "padding_bottom_mobile": 56,
        "section_margin_top_mobile": 0,
        "section_margin_bottom_mobile": 0
      },
      "blocks": {
        "heading_1": {
          "type": "heading",
          "settings": {
            "text": "Write to support",
            "tag": "h2",
            "enable_custom_style": false,
            "enable_custom_fonts": false,
            "font": "assistant_n4",
            "weight": "theme",
            "size_enable": false,
            "size_desktop": 44,
            "size_mobile": 30,
            "line_height": 1.2,
            "tracking": 0
          }
        },
        "subheading_1": {
          "type": "subheading",
          "settings": {
            "text": "<p>Add your order number if it is about something you bought. We answer every message within a day, Monday to Saturday.</p>",
            "max_width": 600,
            "enable_custom_style": false,
            "enable_custom_fonts": false,
            "font": "assistant_n4",
            "weight_enable": false,
            "weight": "400",
            "size_enable": false,
            "size": 16,
            "line_height": 1.5
          }
        },
        "field_1": {
          "type": "field",
          "settings": {
            "field_type": "text",
            "label": "Name",
            "name": "Name",
            "placeholder": "Your name",
            "required": true,
            "half_width": true
          }
        },
        "field_2": {
          "type": "field",
          "settings": {
            "field_type": "email",
            "label": "Email",
            "name": "Email",
            "placeholder": "The one you bought with",
            "required": true,
            "half_width": true
          }
        },
        "field_3": {
          "type": "field",
          "settings": {
            "field_type": "select",
            "label": "About",
            "name": "About",
            "placeholder": "Pick one",
            "required": false,
            "half_width": false,
            "options": "A download\nThe licence\nA refund\nMy account\nSomething else"
          }
        },
        "field_4": {
          "type": "field",
          "settings": {
            "field_type": "textarea",
            "label": "Message",
            "name": "Message",
            "placeholder": "How can we help?",
            "required": true,
            "half_width": false
          }
        },
        "submit_1": {
          "type": "submit",
          "settings": {
            "label": "Send message"
          }
        },
        "info_1": {
          "type": "info",
          "settings": {
            "icon": "mail",
            "label": "Email",
            "value": "hello@lowmoth.example"
          }
        },
        "info_2": {
          "type": "info",
          "settings": {
            "icon": "message",
            "label": "Instagram",
            "value": "@lowmoth"
          }
        }
      },
