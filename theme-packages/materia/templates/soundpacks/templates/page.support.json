        "color_scheme": "default",
        "section_width": "full_width",
        "structured_data": false,
        "open_first": true,
        "allow_multiple_open": false,
        "header_align": "left",
        "section_max_width_desktop": 860,
        "section_max_width_tablet": 720,
        "section_max_width_mobile": 560,
        "gap_subheading_tabs": 36,
