      "blocks": {
        "heading": {
          "type": "heading",
          "settings": {
            "text": "Licence questions.",
            "tag": "h2",
            "size_enable": true,
            "size_desktop": 44,
            "size_mobile": 32
          }
        },
        "q1": {
          "type": "faq_item",
          "settings": {
            "question": "Do I need to credit Lowmoth?",
            "answer": "<p>No. A credit is kind, never required.</p>"
          }
        },
        "q2": {
          "type": "faq_item",
          "settings": {
            "question": "Can I use the sounds in a beat I lease or sell?",
            "answer": "<p>Yes, inside a finished beat. Selling the loops on their own, or a sample pack built from them, is not allowed.</p>"
          }
        },
        "q3": {
          "type": "faq_item",
          "settings": {
            "question": "Can I put a loop in a project file I share?",
            "answer": "<p>Only with people working on the same track with you. Template and project file stores are not allowed.</p>"
          }
        },
        "q4": {
          "type": "faq_item",
          "settings": {
            "question": "Does the licence end?",
            "answer": "<p>No. Music you make with the sounds is yours for good, even if we stop selling the pack.</p>"
          }
        }
      },
