      "blocks": {
        "heading": {
          "type": "heading",
          "settings": {
            "text": "The licence, in plain words.",
            "size_enable": true,
            "size_desktop": 56,
            "size_mobile": 36
          }
        },
        "subheading": {
          "type": "subheading",
          "settings": {
            "text": "<p>One licence covers every Lowmoth pack, paid or free. It is yours for good once you have downloaded a pack.</p>"
          }
        },
        "col_1": {
          "type": "column",
          "settings": {
            "label": "You can",
            "heading": "Make and release music.",
            "text": "<p>Use the sounds in your own songs, beats and productions: released, streamed, synced, played live and sold, with no royalties or credit owed.</p>"
          }
        },
        "col_2": {
          "type": "column",
          "settings": {
            "label": "You can",
            "heading": "Work for clients.",
            "text": "<p>Use them inside finished music you make for someone else: a release, an advert, a game, a film or a podcast.</p>"
          }
        },
        "col_3": {
          "type": "column",
          "settings": {
            "label": "You cannot",
            "heading": "Share or resell the files.",
            "text": "<p>No uploading the sounds, alone or in a pack of your own, to a sample site, a store, a drive link or an AI training set.</p>"
          }
        },
        "col_4": {
          "type": "column",
          "settings": {
            "label": "You cannot",
            "heading": "Claim them in Content ID.",
            "text": "<p>Register a track built mostly from one of our loops and other producers who use the same loop get claims. Register only music that is yours.</p>"
          }
        }
      },
      "block_order": [
