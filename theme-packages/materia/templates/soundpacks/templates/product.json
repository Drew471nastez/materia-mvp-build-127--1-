        "review_1": {
          "type": "testimonial",
          "settings": {
            "quote": "<p>The two step loops swing the right amount out of the box. I cut two of them up and had a finished garage track by the weekend.</p>",
            "rating": 5,
            "name": "Sample buyer",
            "role": "Bought Night Bus",
            "avatar": "shopify://shop_images/soundpacks-avatar-1.webp"
          }
        },
        "review_2": {
          "type": "testimonial",
          "settings": {
            "quote": "<p>Clean and driven versions of every hit is the bit I did not know I wanted. The kicks sit in a mix without any EQ.</p>",
            "rating": 5,
            "name": "Sample buyer",
            "role": "Bought Chrome Drums",
            "avatar": "shopify://shop_images/soundpacks-avatar-2.webp"
          }
        },
        "review_3": {
          "type": "testimonial",
          "settings": {
            "quote": "<p>Every 808 is labelled with its key, so I stopped tuning by ear. That alone saved me an evening.</p>",
            "rating": 5,
            "name": "Sample buyer",
            "role": "Bought Heavy Water",
            "avatar": "shopify://shop_images/soundpacks-avatar-3.webp"
          }
        },
        "review_4": {
          "type": "testimonial",
          "settings": {
            "quote": "<p>Came for the free breaks, stayed for Soft Focus. Being able to play every pack on the page before paying made it an easy call.</p>",
            "rating": 5,
            "name": "Sample buyer",
            "role": "Took Small Hours for free",
            "avatar": "shopify://shop_images/soundpacks-avatar-4.webp"
          }
        }
      },
