      "blocks": {
        "heading": {
          "type": "heading",
          "settings": {
            "text": "Questions? Answers.",
            "tag": "h2",
            "size_enable": true,
            "size_desktop": 44,
            "size_mobile": 32
          }
        },
        "q1": {
          "type": "faq_item",
          "settings": {
            "question": "Can I hear a pack before I buy it?",
            "answer": "<p>Yes. Every pack has a demo and a table of its sounds on its page, and every card on the home page plays. Press play on anything; only one sound plays at a time.</p>"
          }
        },
        "q2": {
          "type": "faq_item",
          "settings": {
            "question": "Which DAW do I need?",
            "answer": "<p>Any. The sounds are 24 bit WAV files and the MIDI files are standard MIDI, so they open in Ableton Live, FL Studio, Logic Pro, Bitwig, Cubase, Studio One, Reaper and the rest.</p>"
          }
        },
        "q3": {
          "type": "faq_item",
          "settings": {
            "question": "Are the sounds royalty free?",
            "answer": "<p>Yes. Use them in your own music, released or not, and keep everything it earns. You cannot share or resell the sounds themselves. <a href=\"/pages/licence\">Read the licence</a>.</p>"
          }
        },
        "q4": {
          "type": "faq_item",
          "settings": {
            "question": "How do I get the files?",
            "answer": "<p>Right after checkout you get a download link on the receipt page and by email. Each pack is one ZIP file.</p>"
          }
        },
        "q5": {
          "type": "faq_item",
          "settings": {
            "question": "Do bundles include future packs?",
            "answer": "<p>The Full Shelf includes every paid pack released in the same year, added to your downloads when it comes out.</p>"
          }
        },
        "q6": {
          "type": "faq_item",
          "settings": {
            "question": "Something went wrong with a download",
            "answer": "<p>Write to us from the <a href=\"/pages/contact\">contact page</a> with your order number and we will send a new link.</p>"
          }
        }
      },
      "block_order": [
        "heading",
