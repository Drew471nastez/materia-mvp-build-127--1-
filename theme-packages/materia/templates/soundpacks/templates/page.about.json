        "heading": {
          "type": "heading",
          "settings": {
            "text": "How a pack is made.",
            "size_enable": true,
            "size_desktop": 44,
            "size_mobile": 32
          }
        },
        "col_1": {
          "type": "column",
          "settings": {
            "label": "Week 1",
            "heading": "Write a track.",
            "text": "<p>We start from a style we play ourselves and write one finished track in it.</p>"
          }
        },
        "col_2": {
          "type": "column",
          "settings": {
            "label": "Week 2",
            "heading": "Pull it apart.",
            "text": "<p>Every loop, hit and chord becomes a file, plus the variations we did not use.</p>"
          }
        },
        "col_3": {
          "type": "column",
          "settings": {
            "label": "Week 3",
            "heading": "Name and test.",
            "text": "<p>Files are named by type, BPM and key, then tested in a fresh project in three DAWs.</p>"
          }
        },
        "col_4": {
          "type": "column",
          "settings": {
            "label": "Week 4",
            "heading": "Release.",
            "text": "<p>The track becomes the demo on the pack page, and the pack goes on sale.</p>"
          }
        }
      },
      "block_order": [
        "heading",
        "col_1",
