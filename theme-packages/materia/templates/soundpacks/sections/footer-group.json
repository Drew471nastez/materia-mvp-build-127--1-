{
  "type": "footer",
  "name": "t:sections.footer.name",
  "sections": {
    "footer": {
      "type": "footer",
      "settings": {
        "color_scheme": "scheme-sp-deep",
        "section_width": "container",
        "padding_top": 64,
        "padding_bottom": 32,
        "reset_spacing": true,
        "copyright_text": "© {{ 'now' | date: '%Y' }} {{ shop.name }}. Every sound royalty free.",
        "show_social": true,
        "show_policy_links": true,
        "separator_line": "unset",
        "heading_weight": "700",
        "footer_heading_size": 15
      },
      "blocks": {
        "store_info_1": {
          "type": "store_info",
          "settings": {
            "show_logo": true,
            "store_heading": "",
            "image_width": 118,
            "store_email": true,
            "store_phone": false,
            "store_address": false,
            "content_width": "33%",
            "store_description": "<p>Sample packs made in one small room. Drums, bass, keys and textures, each with a preview you can play before you buy.</p>"
          }
        },
        "link_list_1": {
          "type": "link_list",
          "settings": {
            "menu": "footer-shop",
            "heading": "Shop",
            "content_width": "22%"
          }
        },
        "link_list_2": {
          "type": "link_list",
          "settings": {
            "menu": "footer-free",
            "heading": "Free",
            "content_width": "22%"
          }
        },
        "link_list_3": {
          "type": "link_list",
          "settings": {
            "menu": "footer",
            "heading": "Help",
            "content_width": "22%"
          }
        },
        "payment_badges_1": {
          "type": "payment_badges",
          "settings": {
            "alignment": "right",
            "enable_amex": true,
            "enable_visa": true,
            "content_width": "100%",
            "enable_klarna": false,
            "enable_paypal": true,
            "enable_apple_pay": true,
            "enable_google_pay": true,
            "enable_mastercard": true
          }
        }
      },
      "block_order": [
        "store_info_1",
        "link_list_1",
        "link_list_2",
        "link_list_3",
        "payment_badges_1"
      ]
    }
  },
  "order": [
    "footer"
  ]
}
