/* Templates round 68: Letterday's cart page, the funnel template's layout in Letterday's words and colour schemes. */
{
  "sections": {
    "heading": {
      "type": "page-heading",
      "settings": {
        "height": "adapt",
        "alignment": "center",
        "padding_top": 80,
        "color_scheme": "",
        "reset_spacing": true,
        "section_width": "stretch_width",
        "padding_bottom": 0,
        "overlay_opacity": 0
      },
      "blocks": {
        "breadcrumb_fkLpBa": {
          "type": "breadcrumb",
          "settings": {}
        },
        "heading_f6yAbL": {
          "type": "heading",
          "settings": {
            "page_title": "Your order",
            "header_size": "default",
            "vertical_gap": 8,
            "heading_color": "",
            "heading_font_size": 34,
            "enable_heading_color": false
          }
        }
      },
      "block_order": [
        "breadcrumb_fkLpBa",
        "heading_f6yAbL"
      ]
    },
    "cart-items": {
      "type": "main-cart-items",
      "settings": {
        "padding_top": 40,
        "reset_spacing": true,
