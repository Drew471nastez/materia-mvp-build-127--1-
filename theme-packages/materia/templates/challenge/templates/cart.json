          }
        },
        "faq_1": {
          "type": "faq",
          "settings": {
            "question": "When does it start?",
            "answer": "<p>Lesson one arrives the moment you pay. The round starts on the first Monday of the month.</p>"
          }
        },
        "faq_2": {
          "type": "faq",
          "settings": {
            "question": "Can I get a refund?",
            "answer": "<p>Yes, within 14 days, if you did the five days and it was not worth it.</p>"
          }
        },
        "faq_3": {
          "type": "faq",
          "settings": {
            "question": "Writing with a partner?",
            "answer": "<p>A second place for someone in the same home is half price. Write to us from the contact page.</p>"
          }
        },
        "payment_badges_67Mgyc": {
          "type": "payment_badges",
          "settings": {
            "show_amex": true,
            "show_visa": true,
            "show_amazon": false,
            "show_klarna": false,
            "show_paypal": true,
            "show_discover": false,
            "show_apple_pay": true,
            "show_google_pay": true,
            "show_mastercard": true,
            "show_payment_badges": true
          }
        }
      },
      "block_order": [
        "faq_section_1",
        "faq_1",
        "faq_2",
        "faq_3",
        "payment_badges_67Mgyc"
      ]
