{%- comment -%}
  Course landing: everything in the offer, on one dark card. A centred
  heading and line, then the card: a small label and the number of items,
  one row per item (an icon tile, a name, a sentence and what it sells for
  alone), and a foot with the items' total struck through beside today's
  price, read from the course product. Under the card a short note and the
  button straight to checkout. With no product the typed price is used.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign sid = section.id
  assign p = s.product
  assign buy = s.button_link | default: '/collections/all'
  assign today = s.price_today
  if p != blank and p.title != blank
    assign today = p.price | money_without_trailing_zeros
    if s.to_checkout
      assign v = p.selected_or_first_available_variant
      if v.id != blank
        assign buy = '/cart/' | append: v.id | append: ':1'
      endif
    endif
  endif
-%}
<style>
  #shopify-section-{{ sid }} .clk {
    --cl-accent: {{ s.accent | default: '#2f5bea' }};
    --cl-ink: {{ s.heading_color | default: '#141416' }};
    background: {{ s.background | default: '#f6f6f4' }};
    color: {{ s.text_color | default: '#5a5a62' }};
    padding: {{ s.padding_top_mobile | default: 48 }}px 0 {{ s.padding_bottom_mobile | default: 48 }}px;
    scroll-margin-top: 100px;
  }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .clk { padding: {{ s.padding_top | default: 88 }}px 0 {{ s.padding_bottom | default: 88 }}px; } }
  #shopify-section-{{ sid }} .clk__in { max-width: 820px; margin: 0 auto; padding: 0 16px; }
  #shopify-section-{{ sid }} .clk__head { max-width: 600px; margin: 0 auto 30px; text-align: center; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .clk__head { margin-bottom: 40px; } }
  #shopify-section-{{ sid }} .clk__title { margin: 0 0 12px; color: var(--cl-ink); font-family: var(--heading-font, inherit); font-weight: 600; font-size: 32px; line-height: 1.1; letter-spacing: -.03em; text-wrap: balance; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .clk__title { font-size: 44px; } }
  #shopify-section-{{ sid }} .clk__title span { color: var(--cl-accent); }
  #shopify-section-{{ sid }} .clk__text { font-size: 17px; line-height: 1.6; }
  #shopify-section-{{ sid }} .clk__text p { margin: 0; }
  #shopify-section-{{ sid }} .clk__card { border-radius: 22px; background: {{ s.card_color | default: '#151517' }}; color: #a9a9b1; overflow: hidden; box-shadow: 0 40px 70px -45px rgba(10,10,20,.55); }
  #shopify-section-{{ sid }} .clk__top { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 18px 20px; border-bottom: 1px solid rgba(255,255,255,.08); }
  @media (min-width: 750px) { #shopify-section-{{ sid }} .clk__top { padding: 22px 32px; } }
  #shopify-section-{{ sid }} .clk__label { font-size: 12px; letter-spacing: .16em; text-transform: uppercase; }
  #shopify-section-{{ sid }} .clk__count { padding: 4px 11px; border-radius: 999px; border: 1px solid color-mix(in srgb, var(--cl-accent) 65%, transparent); color: color-mix(in srgb, var(--cl-accent) 45%, #ffffff); font-size: 13px; font-weight: 600; }
  #shopify-section-{{ sid }} .clk__rows { margin: 0; padding: 0; list-style: none; }
  #shopify-section-{{ sid }} .clk__row { display: grid; grid-template-columns: 40px minmax(0, 1fr); gap: 14px; align-items: center; padding: 18px 20px; border-bottom: 1px solid rgba(255,255,255,.08); }
  @media (min-width: 750px) { #shopify-section-{{ sid }} .clk__row { grid-template-columns: 44px minmax(0, 1fr) auto; gap: 18px; padding: 20px 32px; } }
  #shopify-section-{{ sid }} .clk__ico { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 11px; background: color-mix(in srgb, var(--cl-accent) 22%, #151517); color: color-mix(in srgb, var(--cl-accent) 40%, #ffffff); }
  @media (min-width: 750px) { #shopify-section-{{ sid }} .clk__ico { width: 44px; height: 44px; } }
  #shopify-section-{{ sid }} .clk__ico svg { width: 20px; height: 20px; }
  #shopify-section-{{ sid }} .clk__name { display: block; color: #fff; font-size: 16px; font-weight: 600; }
  @media (min-width: 750px) { #shopify-section-{{ sid }} .clk__name { font-size: 17px; } }
  #shopify-section-{{ sid }} .clk__desc { display: block; margin-top: 3px; font-size: 14px; line-height: 1.45; }
  #shopify-section-{{ sid }} .clk__val { grid-column: 2; justify-self: start; padding: 5px 13px; border-radius: 999px; border: 1px solid rgba(255,255,255,.18); color: #fff; font-size: 14px; font-weight: 600; font-variant-numeric: tabular-nums; }
  @media (min-width: 750px) { #shopify-section-{{ sid }} .clk__val { grid-column: auto; justify-self: end; } }
  #shopify-section-{{ sid }} .clk__foot { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; padding: 20px 20px 24px; }
  @media (min-width: 750px) { #shopify-section-{{ sid }} .clk__foot { padding: 24px 32px 28px; } }
  #shopify-section-{{ sid }} .clk__small { display: block; margin-bottom: 6px; font-size: 12px; letter-spacing: .16em; text-transform: uppercase; }
  #shopify-section-{{ sid }} .clk__total { color: #8d8d96; font-size: 22px; font-weight: 600; text-decoration-color: color-mix(in srgb, var(--cl-accent) 70%, #ffffff); text-decoration-thickness: 2px; }
  #shopify-section-{{ sid }} .clk__today { text-align: right; }
  #shopify-section-{{ sid }} .clk__today .clk__small { color: color-mix(in srgb, var(--cl-accent) 45%, #ffffff); }
  #shopify-section-{{ sid }} .clk__price { color: #fff; font-family: var(--heading-font, inherit); font-size: 36px; font-weight: 700; letter-spacing: -.03em; line-height: 1; font-variant-numeric: tabular-nums; }
  @media (min-width: 750px) { #shopify-section-{{ sid }} .clk__price { font-size: 44px; } }
  #shopify-section-{{ sid }} .clk__note { display: flex; justify-content: center; align-items: flex-start; gap: 8px; margin: 18px auto 0; max-width: 560px; font-size: 14px; line-height: 1.5; text-align: center; }
  #shopify-section-{{ sid }} .clk__note svg { flex: none; width: 16px; height: 16px; margin-top: 2px; color: var(--cl-accent); }
  #shopify-section-{{ sid }} .clk__cta { margin-top: 26px; text-align: center; }
  #shopify-section-{{ sid }} .cl-btn { display: inline-flex; align-items: center; justify-content: center; gap: 12px; min-height: 60px; padding: 0 34px; border-radius: 14px; background: var(--cl-accent); color: #fff; font-size: 18px; font-weight: 600; text-decoration: none; box-shadow: 0 1px 0 rgba(255,255,255,.25) inset, 0 14px 34px -12px color-mix(in srgb, var(--cl-accent) 70%, transparent); transition: transform .25s ease; }
  #shopify-section-{{ sid }} .cl-btn:hover { transform: translateY(-2px); }
  #shopify-section-{{ sid }} .cl-btn svg { width: 18px; height: 18px; }
  @media (max-width: 749px) { #shopify-section-{{ sid }} .cl-btn { width: 100%; } }
  #shopify-section-{{ sid }} [data-clr].clr-wait { opacity: 0; transform: translate3d(0, 24px, 0); }
  #shopify-section-{{ sid }} [data-clr].clr-in { opacity: 1; transform: none; transition: opacity .85s cubic-bezier(.2,.65,.25,1) var(--d, 0ms), transform .85s cubic-bezier(.2,.65,.25,1) var(--d, 0ms); }
  @media (prefers-reduced-motion: reduce) { #shopify-section-{{ sid }} .cl-btn { transition: none; } }
</style>
<section class="clk"{% if s.anchor != blank %} id="{{ s.anchor | handleize }}"{% endif %}>
  <div class="clk__in">
    <div class="clk__head" data-clr>
      <h2 class="clk__title">{{ s.heading | escape }}{% if s.heading_accent != blank %} <span>{{ s.heading_accent | escape }}</span>{% endif %}</h2>
      {%- if s.text != blank -%}<div class="clk__text">{{ s.text }}</div>{%- endif -%}
    </div>
    <div class="clk__card" data-clr style="--d: 80ms">
      <div class="clk__top"><span class="clk__label">{{ s.card_label | escape }}</span>{%- if s.show_count -%}<span class="clk__count">{{ section.blocks.size }} {% if section.blocks.size == 1 %}{{ s.count_one | escape }}{% else %}{{ s.count_many | escape }}{% endif %}</span>{%- endif -%}</div>
      <ul class="clk__rows" role="list">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          <li class="clk__row" {{ block.shopify_attributes }}>
            <span class="clk__ico" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" focusable="false">
                {%- case b.icon -%}
                  {%- when 'play' -%}<rect x="3" y="4.5" width="18" height="15" rx="3"/><path d="M10 9l5 3-5 3z"/>
                  {%- when 'chat' -%}<path d="M4 5h16v11H9l-5 4z"/><path d="M8.5 10.5h7"/>
                  {%- when 'sliders' -%}<path d="M5 6h14M5 12h14M5 18h14"/><circle cx="9" cy="6" r="2" fill="currentColor"/><circle cx="15" cy="12" r="2" fill="currentColor"/><circle cx="8" cy="18" r="2" fill="currentColor"/>
                  {%- when 'cards' -%}<rect x="4" y="6" width="12" height="14" rx="2"/><path d="M8 4h10a2 2 0 0 1 2 2v12"/>
                  {%- when 'camera' -%}<rect x="3" y="7" width="18" height="13" rx="3"/><path d="M8.5 7l1.5-2.5h4L15.5 7"/><circle cx="12" cy="13.5" r="3.5"/>
                  {%- when 'users' -%}<circle cx="9" cy="8.5" r="3.5"/><path d="M2.5 20c.5-3.5 3.2-5.5 6.5-5.5s6 2 6.5 5.5"/><path d="M16 5.2a3.5 3.5 0 0 1 0 6.6M18.5 14.8c1.7.7 2.8 2.4 3 5.2"/>
                  {%- else -%}<path d="M12 3l2.6 5.6 6 .7-4.5 4.1 1.2 6L12 16.4 6.7 19.4l1.2-6L3.4 9.3l6-.7z"/>
                {%- endcase -%}
              </svg>
            </span>
            <span><span class="clk__name">{{ b.title | escape }}</span>{%- if b.text != blank -%}<span class="clk__desc">{{ b.text | escape }}</span>{%- endif -%}</span>
            {%- if b.value != blank -%}<span class="clk__val">{{ b.value | escape }}</span>{%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
      <div class="clk__foot">
        {%- if s.total != blank -%}<div><span class="clk__small">{{ s.total_label | escape }}</span><s class="clk__total"><span class="visually-hidden">Was </span>{{ s.total | escape }}</s></div>{%- else -%}<span></span>{%- endif -%}
        {%- if today != blank -%}<div class="clk__today"><span class="clk__small">{{ s.today_label | escape }}</span><span class="clk__price">{{ today }}</span></div>{%- endif -%}
      </div>
    </div>
    {%- if s.note != blank -%}<p class="clk__note" data-clr><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M8 1.8l5.2 2v4c0 3.3-2.2 5.4-5.2 6.6C5 13.2 2.8 11.1 2.8 7.8v-4z"/><path d="M5.6 8l1.7 1.7L10.6 6.4"/></svg><span>{{ s.note | escape }}</span></p>{%- endif -%}
    {%- if s.button_label != blank -%}
      <div class="clk__cta" data-clr><a class="cl-btn" href="{{ buy }}">{{ s.button_label | escape }}<svg viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3.5 9h11M10 4.5L14.5 9 10 13.5"/></svg></a></div>
    {%- endif -%}
  </div>
</section>
{%- unless request.design_mode -%}
<script>(function(){var r=document.getElementById('shopify-section-{{ sid }}');if(!r||!('IntersectionObserver' in window)||matchMedia('(prefers-reduced-motion: reduce)').matches)return;var h=innerHeight,io=new IntersectionObserver(function(es){es.forEach(function(e){if(!e.isIntersecting)return;var t=e.target;io.unobserve(t);requestAnimationFrame(function(){t.classList.add('clr-in')})})},{rootMargin:'0px 0px -6% 0px'});r.querySelectorAll('[data-clr]').forEach(function(el){if(el.getBoundingClientRect().top<h*.92)return;el.classList.add('clr-wait');io.observe(el)})})();</script>
{%- endunless -%}

{% schema %}
{
  "name": "Everything in the offer",
  "tag": "section",
  "class": "courselanding-stack-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Everything you get." },
    { "type": "text", "id": "heading_accent", "label": "Heading words in the accent colour", "default": "One price." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>List what comes with the course.</p>" },
    { "type": "text", "id": "anchor", "label": "Address on the page", "default": "join", "info": "A word a menu link or button can jump to, as /#word." },
    { "type": "header", "content": "Card" },
    { "type": "text", "id": "card_label", "label": "Label", "default": "What is included" },
    { "type": "checkbox", "id": "show_count", "label": "Show how many items", "default": true },
    { "type": "text", "id": "count_one", "label": "Word for one item", "default": "item" },
    { "type": "text", "id": "count_many", "label": "Word for several items", "default": "items" },
    { "type": "text", "id": "total_label", "label": "Label over the total", "default": "Sold separately" },
    { "type": "text", "id": "total", "label": "Total of the items sold alone", "default": "$240" },
    { "type": "text", "id": "today_label", "label": "Label over today's price", "default": "Your price" },
    { "type": "product", "id": "product", "label": "Course", "info": "Today's price and the button's checkout come from this product. Your first product when none is picked." },
    { "type": "text", "id": "price_today", "label": "Price when there is no product", "default": "$99" },
    { "type": "text", "id": "note", "label": "Note under the card", "default": "30 day refund. Watch the first week and decide." },
    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_label", "label": "Label", "default": "Join the course" },
    { "type": "checkbox", "id": "to_checkout", "label": "Button goes straight to checkout", "default": true },
    { "type": "url", "id": "button_link", "label": "Link when there is no product" },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "background", "label": "Background", "default": "#f6f6f4" },
    { "type": "color", "id": "card_color", "label": "Card", "default": "#151517" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#2f5bea" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#141416" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#5a5a62" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Space above on desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 88 },
    { "type": "range", "id": "padding_bottom", "label": "Space below on desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 88 },
    { "type": "range", "id": "padding_top_mobile", "label": "Space above on phones", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Space below on phones", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "play", "options": [ { "value": "play", "label": "Video" }, { "value": "chat", "label": "Message" }, { "value": "sliders", "label": "Sliders" }, { "value": "cards", "label": "Cards" }, { "value": "camera", "label": "Camera" }, { "value": "users", "label": "People" }, { "value": "star", "label": "Star" } ] },
        { "type": "text", "id": "title", "label": "Name", "default": "The course" },
        { "type": "text", "id": "text", "label": "Text", "default": "Say what it is in one line." },
        { "type": "text", "id": "value", "label": "Price when sold alone", "default": "$120" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Everything in the offer",
      "category": "Course landing",
      "blocks": [
        { "type": "item" },
        { "type": "item", "settings": { "icon": "chat", "title": "Feedback", "value": "$80" } },
        { "type": "item", "settings": { "icon": "cards", "title": "Worksheets", "value": "$40" } }
      ]
    }
  ]
}
{% endschema %}
