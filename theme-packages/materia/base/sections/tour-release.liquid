{%- comment -%}
  Tour merch template: the new record. The cover sits on one side with the
  record itself half out of its sleeve; the title, a line, two buttons and
  the formats it comes in sit on the other. On load the record slides out
  of the sleeve and the words rise in; nothing moves with reduced motion.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign placeholder = 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 400 400%22%3E%3Crect width=%22400%22 height=%22400%22 fill=%22%23202326%22/%3E%3C/svg%3E'
-%}
<style>
  #shopify-section-{{ sid }} .trel {
    background: {{ st.background | default: '#f3f1ec' }};
    color: {{ st.text_color | default: '#141414' }};
    padding: {{ st.padding_top_mobile | default: 36 }}px 20px {{ st.padding_bottom_mobile | default: 48 }}px;
    overflow: hidden;
  }
  #shopify-section-{{ sid }} .trel__inner { max-width: 1240px; margin: 0 auto; display: grid; grid-template-columns: 1fr; gap: 36px; align-items: center; }
  #shopify-section-{{ sid }} .trel__art { position: relative; width: 100%; max-width: 560px; margin: 0 auto; padding-right: 14%; }
  #shopify-section-{{ sid }} .trel__disc {
    position: absolute; top: 3%; right: 0; width: 94%; aspect-ratio: 1 / 1; border-radius: 50%;
    background:
      radial-gradient(circle at 50% 50%, {{ st.background | default: '#f3f1ec' }} 0 1.4%, {{ st.label_color | default: '#1c345c' }} 1.5% 16%, #0e0e0f 16.2% 17%, transparent 17.2%),
      repeating-radial-gradient(circle at 50% 50%, #111112 0 2px, #1b1b1d 2px 3px),
      #111112;
    box-shadow: 0 18px 40px rgba(20, 18, 14, 0.25);
    transform: translateX(-34%) rotate(-30deg);
    animation: trel-slide-{{ sid }} 1.6s cubic-bezier(0.2, 0.7, 0.2, 1) 0.3s forwards;
  }
  #shopify-section-{{ sid }} .trel__disc::after {
    content: ""; position: absolute; inset: 0; border-radius: 50%;
    background: conic-gradient(from 200deg, transparent 0 8%, rgba(255,255,255,0.09) 12%, transparent 18% 58%, rgba(255,255,255,0.07) 62%, transparent 68%);
  }
  @keyframes trel-slide-{{ sid }} { to { transform: translateX(0) rotate(0deg); } }
  #shopify-section-{{ sid }} .trel__cover { position: relative; z-index: 1; aspect-ratio: 1 / 1; box-shadow: 0 24px 50px rgba(20, 18, 14, 0.28); background: #202326; }
  #shopify-section-{{ sid }} .trel__cover img { width: 100%; height: 100%; object-fit: cover; display: block; margin: 0; }
  #shopify-section-{{ sid }} .trel__eyebrow { margin: 0 0 14px; font-size: 12px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: {{ st.accent_color | default: '#1c345c' }}; }
  #shopify-section-{{ sid }} .trel__title { margin: 0; font-family: var(--heading-font, inherit); font-weight: 400; font-size: {{ st.title_size_mobile | default: 56 }}px; line-height: 0.95; letter-spacing: -0.02em; color: inherit; }
  #shopify-section-{{ sid }} .trel__title em { font-style: italic; }
  #shopify-section-{{ sid }} .trel__artist { margin: 10px 0 0; font-size: 15px; color: {{ st.muted_color | default: '#5d5a54' }}; }
  #shopify-section-{{ sid }} .trel__text { margin: 20px 0 0; font-size: 16px; line-height: 1.6; max-width: 46ch; }
  #shopify-section-{{ sid }} .trel__text p { margin: 0; }
  #shopify-section-{{ sid }} .trel__buttons { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 26px; }
  #shopify-section-{{ sid }} .trel__formats { list-style: none; margin: 32px 0 0; padding: 0; border-top: 1px solid {{ st.line_color | default: '#d9d5cc' }}; max-width: 520px; }
  #shopify-section-{{ sid }} .trel__formats li { border-bottom: 1px solid {{ st.line_color | default: '#d9d5cc' }}; }
  #shopify-section-{{ sid }} .trel__format { display: flex; align-items: baseline; gap: 16px; padding: 14px 0; text-decoration: none; color: inherit; }
  #shopify-section-{{ sid }} .trel__format strong { font-weight: 600; font-size: 15px; min-width: 7.5em; }
  #shopify-section-{{ sid }} .trel__format span { flex: 1; font-size: 14px; color: {{ st.muted_color | default: '#5d5a54' }}; }
  #shopify-section-{{ sid }} .trel__format i { font-style: normal; transition: transform 0.25s ease; }
  #shopify-section-{{ sid }} a.trel__format:hover i { transform: translateX(4px); }
  #shopify-section-{{ sid }} .trel__copy > * { opacity: 0; transform: translateY(12px); animation: trel-rise-{{ sid }} 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) forwards; }
  #shopify-section-{{ sid }} .trel__copy > *:nth-child(2) { animation-delay: 0.08s; }
  #shopify-section-{{ sid }} .trel__copy > *:nth-child(3) { animation-delay: 0.16s; }
  #shopify-section-{{ sid }} .trel__copy > *:nth-child(4) { animation-delay: 0.24s; }
  #shopify-section-{{ sid }} .trel__copy > *:nth-child(n+5) { animation-delay: 0.32s; }
  @keyframes trel-rise-{{ sid }} { to { opacity: 1; transform: none; } }
  @media (min-width: 900px) {
    #shopify-section-{{ sid }} .trel { padding: {{ st.padding_top | default: 72 }}px 40px {{ st.padding_bottom | default: 88 }}px; }
    #shopify-section-{{ sid }} .trel__inner { grid-template-columns: 1.05fr 1fr; gap: 72px; }
    #shopify-section-{{ sid }} .trel__title { font-size: {{ st.title_size | default: 104 }}px; }
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .trel__disc { animation: none; transform: none; }
    #shopify-section-{{ sid }} .trel__copy > * { animation: none; opacity: 1; transform: none; }
    #shopify-section-{{ sid }} .trel__format i { transition: none; }
  }
</style>

<div class="trel">
  <div class="trel__inner">
    <div class="trel__art">
      {%- if st.show_disc -%}<div class="trel__disc" aria-hidden="true"></div>{%- endif -%}
      <div class="trel__cover">
        {%- if st.image != blank -%}
          <img
            src="{{ st.image | image_url: width: 1200 }}"
            srcset="{{ st.image | image_url: width: 600 }} 600w, {{ st.image | image_url: width: 900 }} 900w, {{ st.image | image_url: width: 1200 }} 1200w"
            sizes="(min-width: 900px) 520px, 90vw"
            width="{{ st.image.width | default: 1200 }}" height="{{ st.image.height | default: 1200 }}"
            alt="{{ st.image_alt | default: st.image.alt | escape }}" fetchpriority="high" decoding="async">
        {%- else -%}
          <img src="{{ placeholder }}" alt="" width="400" height="400">
        {%- endif -%}
      </div>
    </div>
    <div class="trel__copy">
      {%- if st.eyebrow != blank -%}<p class="trel__eyebrow">{{ st.eyebrow | escape }}</p>{%- endif -%}
      {%- if st.title != blank -%}<h1 class="trel__title">{% if st.title_italic %}<em>{{ st.title | escape }}</em>{% else %}{{ st.title | escape }}{% endif %}</h1>{%- endif -%}
      {%- if st.artist != blank -%}<p class="trel__artist">{{ st.artist | escape }}</p>{%- endif -%}
      {%- if st.text != blank -%}<div class="trel__text">{{ st.text }}</div>{%- endif -%}
      {%- if st.button_label != blank or st.button_2_label != blank -%}
        <div class="trel__buttons">
          {%- if st.button_label != blank -%}<a class="button inline-block btn-primary" href="{{ st.button_link | default: '/collections/all' }}">{{ st.button_label | escape }}</a>{%- endif -%}
          {%- if st.button_2_label != blank -%}<a class="button inline-block btn-secondary" href="{{ st.button_2_link | default: '/collections/all' }}">{{ st.button_2_label | escape }}</a>{%- endif -%}
        </div>
      {%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <ul class="trel__formats">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}
                <a class="trel__format" href="{{ block.settings.link }}"><strong>{{ block.settings.label | escape }}</strong><span>{{ block.settings.detail | escape }}</span><i aria-hidden="true">&rarr;</i></a>
              {%- else -%}
                <div class="trel__format"><strong>{{ block.settings.label | escape }}</strong><span>{{ block.settings.detail | escape }}</span></div>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "New record",
  "tag": "section",
  "class": "section sec__tour-release",
  "max_blocks": 6,
  "settings": [
    { "type": "header", "content": "Cover" },
    { "type": "image_picker", "id": "image", "label": "Cover picture", "info": "Square works best." },
    { "type": "text", "id": "image_alt", "label": "Alt text" },
    { "type": "checkbox", "id": "show_disc", "label": "Show the record coming out of the sleeve", "default": true },
    { "type": "color", "id": "label_color", "label": "Record label colour", "default": "#1c345c" },
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "eyebrow", "label": "Small line above", "default": "New album" },
    { "type": "text", "id": "title", "label": "Title", "default": "Album title" },
    { "type": "checkbox", "id": "title_italic", "label": "Title in italics", "default": true },
    { "type": "text", "id": "artist", "label": "Artist and date", "default": "Your name. Out now." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Say in a line or two what the record is.</p>" },
    { "type": "text", "id": "button_label", "label": "First button", "default": "Shop the record" },
    { "type": "url", "id": "button_link", "label": "First button link" },
    { "type": "text", "id": "button_2_label", "label": "Second button", "default": "Tour dates" },
    { "type": "url", "id": "button_2_link", "label": "Second button link" },
    { "type": "header", "content": "Colours and size" },
    { "type": "color", "id": "background", "label": "Background", "default": "#f3f1ec" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#141414" },
    { "type": "color", "id": "muted_color", "label": "Quiet text", "default": "#5d5a54" },
    { "type": "color", "id": "accent_color", "label": "Small line above", "default": "#1c345c" },
    { "type": "color", "id": "line_color", "label": "Lines", "default": "#d9d5cc" },
    { "type": "range", "id": "title_size", "label": "Title size, desktop", "min": 40, "max": 160, "step": 4, "unit": "px", "default": 104 },
    { "type": "range", "id": "title_size_mobile", "label": "Title size, phone", "min": 28, "max": 88, "step": 2, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_top", "label": "Space above, desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Space below, desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 88 },
    { "type": "range", "id": "padding_top_mobile", "label": "Space above, phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Space below, phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "format",
      "name": "Format",
      "settings": [
        { "type": "text", "id": "label", "label": "Format", "default": "Vinyl LP" },
        { "type": "text", "id": "detail", "label": "Detail", "default": "180g black vinyl" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "New record",
      "blocks": [
        { "type": "format", "settings": { "label": "Vinyl LP", "detail": "180g black vinyl" } },
        { "type": "format", "settings": { "label": "CD", "detail": "Card sleeve with lyrics" } }
      ]
    }
  ]
}
{% endschema %}
