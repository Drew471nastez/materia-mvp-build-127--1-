{%- comment -%}
  Merch template: "shop by look". One tall picture of an outfit and, beside
  it, the first products of a collection as the theme's own product cards,
  with a link to everything under them. A store with no products yet shows
  the theme's empty cards in their place.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign count = st.products_to_show | default: 2
  assign skip = st.skip | default: 0
  if st.collection.products.size <= skip
    assign skip = 0
  endif
  assign placeholder = 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 400 500%22%3E%3Crect width=%22400%22 height=%22500%22 fill=%22%23ececec%22/%3E%3C/svg%3E'
  assign all_href = st.link | default: st.collection.url | default: '/collections/all'
-%}
<style>
  #shopify-section-{{ sid }} .mlook { background: {{ st.background | default: '#ffffff' }}; padding: {{ st.padding_top_mobile | default: 40 }}px 16px {{ st.padding_bottom_mobile | default: 40 }}px; }
  #shopify-section-{{ sid }} .mlook__inner { max-width: 1200px; margin: 0 auto; }
  #shopify-section-{{ sid }} .mlook__heading {
    margin: 0 0 20px; font-family: var(--heading-font, inherit); font-weight: 800; text-transform: uppercase;
    font-size: {{ st.heading_size_mobile | default: 26 }}px; letter-spacing: -0.01em; line-height: 1.05; color: {{ st.heading_color | default: '#111111' }};
  }
  #shopify-section-{{ sid }} .mlook__grid { display: grid; grid-template-columns: 1fr; gap: 16px; }
  #shopify-section-{{ sid }} .mlook__media { position: relative; overflow: hidden; background: #ececec; aspect-ratio: 4 / 5; }
  #shopify-section-{{ sid }} .mlook__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; margin: 0; transition: transform 1.2s cubic-bezier(0.2, 0.7, 0.2, 1); }
  #shopify-section-{{ sid }} .mlook__media:hover img { transform: scale(1.025); }
  #shopify-section-{{ sid }} .mlook__side { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; align-content: start; }
  #shopify-section-{{ sid }} .mlook__side > * { min-width: 0; width: 100%; max-width: none; padding: 0; margin: 0; flex: none; }
  #shopify-section-{{ sid }} .mlook__all {
    grid-column: 1 / -1; justify-self: start;
    display: inline-flex; align-items: center; gap: 6px; text-decoration: none;
    font-weight: 700; font-size: 14px; color: {{ st.heading_color | default: '#111111' }};
    border-bottom: 1px solid currentColor; padding-bottom: 2px;
  }
  #shopify-section-{{ sid }} .mlook__all span { transition: transform 0.25s ease; display: inline-block; }
  #shopify-section-{{ sid }} .mlook__all:hover span { transform: translateX(3px); }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .mlook { padding: {{ st.padding_top | default: 64 }}px 32px {{ st.padding_bottom | default: 72 }}px; }
    #shopify-section-{{ sid }} .mlook__heading { font-size: {{ st.heading_size | default: 32 }}px; margin-bottom: 28px; }
    #shopify-section-{{ sid }} .mlook__grid { grid-template-columns: 2fr 1fr; gap: 20px; align-items: stretch; }
    #shopify-section-{{ sid }} .mlook__media { aspect-ratio: auto; min-height: 640px; }
    #shopify-section-{{ sid }} .mlook__side { grid-template-columns: 1fr; gap: 20px; }
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .mlook__media img, #shopify-section-{{ sid }} .mlook__all span { transition: none; }
  }
</style>

<div class="mlook">
  <div class="mlook__inner">
    {%- if st.heading != blank -%}<h2 class="mlook__heading">{{ st.heading | escape }}</h2>{%- endif -%}
    <div class="mlook__grid">
      <div class="mlook__media">
        {%- if st.image != blank -%}
          <img
            src="{{ st.image | image_url: width: 1600 }}"
            srcset="{{ st.image | image_url: width: 800 }} 800w, {{ st.image | image_url: width: 1200 }} 1200w, {{ st.image | image_url: width: 1800 }} 1800w"
            sizes="(min-width: 768px) 66vw, 100vw"
            width="{{ st.image.width | default: 1600 }}" height="{{ st.image.height | default: 2000 }}"
            alt="{{ st.image_alt | default: st.image.alt | escape }}"
            style="object-position: {{ st.focal_x | default: 50 }}% {{ st.focal_y | default: 30 }}%;"
            loading="lazy" decoding="async">
        {%- else -%}
          <img src="{{ placeholder }}" alt="" width="400" height="500">
        {%- endif -%}
      </div>
      <div class="mlook__side">
        {%- if st.collection.products.size > 0 -%}
          {%- for product in st.collection.products limit: count offset: skip -%}
            {% render 'product-item',
              card_product: product,
              section_id: sid,
              container: 'container',
              colunm: 3,
              colunm_mobile: 2,
              padding: 12,
              template_enable_action: false,
              template_enable_product_vendor: false,
              template_enable_rate: false,
              template_enable_product_short_description: false,
              template_enable_color_swatches: false,
              template_enable_price: true,
              template_enable_add_cart: false,
              indexFor: forloop.index,
              template_enable_product_badges: true
            %}
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..count) -%}
            {% render 'product-item',
              section_id: sid,
              container: 'container',
              colunm: 3,
              colunm_mobile: 2,
              padding: 12,
              template_enable_price: true,
              indexFor: forloop.index
            %}
          {%- endfor -%}
        {%- endif -%}
        {%- if st.link_label != blank -%}
          <a class="mlook__all" href="{{ all_href }}">{{ st.link_label | escape }} <span aria-hidden="true">&rarr;</span></a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Shop by look",
  "tag": "section",
  "class": "section sec__merch-look",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by look" },
    { "type": "image_picker", "id": "image", "label": "Picture" },
    { "type": "text", "id": "image_alt", "label": "Alt text" },
    { "type": "range", "id": "focal_x", "label": "Focal point, across", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
    { "type": "range", "id": "focal_y", "label": "Focal point, down", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 30 },
    { "type": "collection", "id": "collection", "label": "Products from", "info": "Empty: all products." },
    { "type": "range", "id": "skip", "label": "Skip the first products", "min": 0, "max": 12, "step": 1, "default": 0, "info": "To show different products from a carousel above." },
    { "type": "range", "id": "products_to_show", "label": "Products beside the picture", "min": 1, "max": 3, "step": 1, "default": 2 },
    { "type": "text", "id": "link_label", "label": "Link text", "default": "All products" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#111111" },
    { "type": "range", "id": "heading_size", "label": "Heading size, desktop", "min": 20, "max": 64, "step": 2, "unit": "px", "default": 32 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size, phone", "min": 18, "max": 40, "step": 2, "unit": "px", "default": 26 },
    { "type": "range", "id": "padding_top", "label": "Space above, desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Space below, desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_top_mobile", "label": "Space above, phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Space below, phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 }
  ],
  "presets": [ { "name": "Shop by look" } ]
}
{% endschema %}
