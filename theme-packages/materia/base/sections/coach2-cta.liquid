{%- comment -%}
  Coach, second look: the closing call. A coloured block with a large
  heading, a line, a button and a small note, beside a round photograph
  and a short list of what happens on the call. Also works as a page
  heading for the booking page when the button is left empty.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign color_scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
  assign tag = 'h2'
  if st.main_heading
    assign tag = 'h1'
  endif
-%}
<style>
  #shopify-section-{{ sid }} .c2c { background: {{ st.background }}; padding: {{ st.padding_top_mobile }}px 16px {{ st.padding_bottom_mobile }}px; }
  @media (min-width: 750px) { #shopify-section-{{ sid }} .c2c { padding: {{ st.padding_top }}px 32px {{ st.padding_bottom }}px; } }
  #shopify-section-{{ sid }} .c2c__box { max-width: var(--page-width, 1310px); margin: 0 auto; display: grid; grid-template-columns: minmax(0, 1fr); gap: 32px; align-items: center; padding: 36px 22px; border-radius: 10px; background: {{ st.panel }}; color: {{ st.text_color }}; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .c2c__box { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 64px; padding: 72px; } }
  #shopify-section-{{ sid }} .c2c__eyebrow { margin: 0 0 14px; font-size: 13px; font-weight: 600; letter-spacing: .04em; opacity: .85; }
  #shopify-section-{{ sid }} .c2c__h { margin: 0; color: {{ st.heading_color }}; font-family: var(--heading-font, inherit); font-weight: 700; letter-spacing: -0.04em; line-height: 1; font-size: 38px; text-wrap: balance; }
  @media (min-width: 750px) { #shopify-section-{{ sid }} .c2c__h { font-size: {{ st.heading_size }}px; } }
  #shopify-section-{{ sid }} .c2c__t { margin: 18px 0 0; font-size: 17px; line-height: 1.6; max-width: 48ch; }
  #shopify-section-{{ sid }} .c2c__t p { margin: 0; }
  #shopify-section-{{ sid }} .c2c__btn { display: inline-flex; align-items: center; gap: 10px; min-height: 56px; margin-top: 30px; padding: 0 28px; border-radius: 6px; background: {{ st.button_background }}; color: {{ st.button_text }}; font-size: 16px; font-weight: 600; text-decoration: none; transition: transform .2s ease, box-shadow .2s ease; }
  #shopify-section-{{ sid }} .c2c__btn:hover { transform: translateY(-1px); box-shadow: 0 8px 24px rgba(0,0,0,.18); }
  #shopify-section-{{ sid }} .c2c__btn svg { width: 18px; height: 18px; }
  #shopify-section-{{ sid }} .c2c__note { margin: 14px 0 0; font-size: 13.5px; opacity: .8; }
  #shopify-section-{{ sid }} .c2c__side { display: flex; flex-direction: column; gap: 18px; }
  #shopify-section-{{ sid }} .c2c__who { display: flex; align-items: center; gap: 14px; }
  #shopify-section-{{ sid }} .c2c__who img { width: 64px; height: 64px; border-radius: 50%; object-fit: cover; margin: 0; box-shadow: 0 0 0 3px rgba(255,255,255,.25); }
  #shopify-section-{{ sid }} .c2c__who b { display: block; color: {{ st.heading_color }}; font-size: 16px; }
  #shopify-section-{{ sid }} .c2c__who span { display: block; font-size: 14px; opacity: .85; }
  #shopify-section-{{ sid }} .c2c__list { margin: 0; padding: 0; list-style: none; border-top: 1px solid rgba(255,255,255,.22); }
  #shopify-section-{{ sid }} .c2c__list li { display: grid; grid-template-columns: 22px minmax(0, 1fr); gap: 10px; padding: 13px 0; border-bottom: 1px solid rgba(255,255,255,.22); font-size: 15px; line-height: 1.45; }
  #shopify-section-{{ sid }} .c2c__list svg { width: 18px; height: 18px; margin-top: 1px; color: {{ st.heading_color }}; }
</style>

<div class="c2c color-{{ color_scheme }}">
  <div class="c2c__box">
    <div>
      {%- if st.eyebrow != blank -%}<p class="c2c__eyebrow">{{ st.eyebrow | escape }}</p>{%- endif -%}
      {%- if st.heading != blank -%}<{{ tag }} class="c2c__h">{{ st.heading }}</{{ tag }}>{%- endif -%}
      {%- if st.text != blank -%}<div class="c2c__t">{{ st.text }}</div>{%- endif -%}
      {%- if st.button_label != blank -%}<a class="c2c__btn" href="{{ st.button_link | default: '/pages/book' }}">{{ st.button_label | escape }}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>{%- endif -%}
      {%- if st.note != blank -%}<p class="c2c__note">{{ st.note | escape }}</p>{%- endif -%}
    </div>
    <div class="c2c__side">
      {%- if st.name != blank -%}
        <div class="c2c__who">
          {%- if st.avatar != blank -%}<img src="{{ st.avatar | image_url: width: 160 }}" width="64" height="64" alt="" loading="lazy">{%- endif -%}
          <div><b>{{ st.name | escape }}</b>{%- if st.role != blank -%}<span>{{ st.role | escape }}</span>{%- endif -%}</div>
        </div>
      {%- endif -%}
      {%- assign lines = st.points | newline_to_br | split: '<br />' -%}
      {%- if st.points != blank -%}
        <ul class="c2c__list">
          {%- for l in lines -%}{%- assign lt = l | strip -%}{%- if lt != blank -%}<li><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10.5l4 4 8-9"/></svg><span>{{ lt | escape }}</span></li>{%- endif -%}{%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Coach closing call",
  "tag": "section",
  "class": "section sec__coach2-cta",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default-color-scheme" },
    { "type": "color", "id": "background", "label": "Around the block", "default": "#ffffff" },
    { "type": "color", "id": "panel", "label": "Block", "default": "#2b44ff" },
    { "type": "color", "id": "heading_color", "label": "Headings", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#e3e7ff" },
    { "type": "color", "id": "button_background", "label": "Button", "default": "#ffffff" },
    { "type": "color", "id": "button_text", "label": "Button text", "default": "#0f1115" },
    { "type": "checkbox", "id": "main_heading", "label": "This is the page's main heading", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Free first call" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Let's look at your week" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Twenty minutes on a video call. You say where the business is stuck; I say whether I can help.</p>" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Book a free call" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "note", "label": "Note under the button", "default": "No pitch. If we are not a fit, I will say so." },
    { "type": "image_picker", "id": "avatar", "label": "Round photo" },
    { "type": "text", "id": "name", "label": "Name", "default": "Your name" },
    { "type": "text", "id": "role", "label": "Under the name", "default": "Business coach" },
    { "type": "textarea", "id": "points", "label": "List", "info": "One point per line.", "default": "Where the business is now\nWhat is taking your time\nOne next step, either way" },
    { "type": "range", "id": "heading_size", "label": "Heading size, desktop", "min": 32, "max": 88, "step": 2, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_top", "label": "Space above, desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom", "label": "Space below, desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_top_mobile", "label": "Space above, phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 16 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Space below, phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "presets": [ { "name": "Coach closing call" } ]
}
{% endschema %}
