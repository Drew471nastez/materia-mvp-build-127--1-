{%- comment -%}
  Coach, second look: how it works. A photograph that stays in view on
  the left while numbered steps scroll past on the right, each with a
  title, a line and an optional time. Without a photograph the steps take
  the whole width in columns.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign color_scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
  assign steps = section.blocks | where: 'type', 'step'
-%}
<style>
  #shopify-section-{{ sid }} .c2s { --ink: {{ st.ink }}; --muted: {{ st.muted }}; --accent: {{ st.accent }}; --line: {{ st.line_color }}; background: {{ st.background }}; padding: {{ st.padding_top_mobile }}px 16px {{ st.padding_bottom_mobile }}px; }
  @media (min-width: 750px) { #shopify-section-{{ sid }} .c2s { padding: {{ st.padding_top }}px 32px {{ st.padding_bottom }}px; } }
  #shopify-section-{{ sid }} .c2s__inner { max-width: var(--page-width, 1310px); margin: 0 auto; display: grid; grid-template-columns: minmax(0, 1fr); gap: 36px; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .c2s--pic .c2s__inner { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 80px; align-items: start; } }
  #shopify-section-{{ sid }} .c2s__media { position: relative; margin: 0; aspect-ratio: 4 / 5; border-radius: 8px; overflow: hidden; background: #e8eaee; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .c2s__stick { position: sticky; top: 100px; } }
  #shopify-section-{{ sid }} .c2s__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: {{ st.image_focus }}; margin: 0; }
  #shopify-section-{{ sid }} .c2s__eyebrow { margin: 0 0 12px; color: var(--accent); font-size: 13px; font-weight: 600; letter-spacing: .04em; }
  #shopify-section-{{ sid }} .c2s__h { margin: 0; color: var(--ink); font-family: var(--heading-font, inherit); font-weight: 700; letter-spacing: -0.035em; line-height: 1.04; font-size: 34px; text-wrap: balance; }
  @media (min-width: 750px) { #shopify-section-{{ sid }} .c2s__h { font-size: {{ st.heading_size }}px; } }
  #shopify-section-{{ sid }} .c2s__t { margin: 16px 0 0; color: var(--muted); font-size: 16.5px; line-height: 1.6; max-width: 52ch; }
  #shopify-section-{{ sid }} .c2s__t p { margin: 0; }
  #shopify-section-{{ sid }} .c2s__list { margin: 36px 0 0; padding: 0; list-style: none; counter-reset: c2s; display: grid; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 750px) { #shopify-section-{{ sid }} .c2s--wide .c2s__list { grid-template-columns: repeat({{ steps.size | at_most: 4 | at_least: 1 }}, minmax(0, 1fr)); gap: 0 32px; } }
  #shopify-section-{{ sid }} .c2s__step { display: grid; grid-template-columns: 56px minmax(0, 1fr); gap: 6px; padding: 26px 0; border-top: 1px solid var(--line); }
  #shopify-section-{{ sid }} .c2s--wide .c2s__step { grid-template-columns: minmax(0, 1fr); gap: 14px; }
  #shopify-section-{{ sid }} .c2s__n { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--ink); color: #fff; font-size: 14px; font-weight: 700; font-variant-numeric: tabular-nums; }
  #shopify-section-{{ sid }} .c2s__step:first-child .c2s__n { background: var(--accent); }
  #shopify-section-{{ sid }} .c2s__title { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; margin: 6px 0 0; color: var(--ink); font-size: 21px; font-weight: 700; letter-spacing: -0.02em; line-height: 1.25; }
  #shopify-section-{{ sid }} .c2s__time { color: var(--muted); font-size: 13px; font-weight: 500; letter-spacing: 0; }
  #shopify-section-{{ sid }} .c2s__text { margin: 8px 0 0; color: var(--muted); font-size: 15.5px; line-height: 1.6; }
  #shopify-section-{{ sid }} .c2s__btn { display: inline-flex; align-items: center; min-height: 50px; margin-top: 28px; padding: 0 22px; border-radius: 6px; background: var(--ink); color: #fff; font-size: 15px; font-weight: 600; text-decoration: none; transition: background-color .2s ease; }
  #shopify-section-{{ sid }} .c2s__btn:hover { background: var(--accent); }
</style>

<div class="c2s color-{{ color_scheme }}{% if st.image != blank %} c2s--pic{% else %} c2s--wide{% endif %}">
  <div class="c2s__inner">
    {%- if st.image != blank -%}
      <div class="c2s__stick">
      <figure class="c2s__media">
        <img src="{{ st.image | image_url: width: 1000 }}" srcset="{{ st.image | image_url: width: 600 }} 600w, {{ st.image | image_url: width: 1000 }} 1000w" sizes="(min-width: 990px) 600px, 94vw" width="{{ st.image.width | default: 1000 }}" height="{{ st.image.height | default: 1250 }}" alt="{{ st.image_alt | escape }}" decoding="async">
      </figure>
      </div>
    {%- endif -%}
    <div>
      {%- if st.eyebrow != blank -%}<p class="c2s__eyebrow">{{ st.eyebrow | escape }}</p>{%- endif -%}
      {%- if st.heading != blank -%}<h2 class="c2s__h">{{ st.heading }}</h2>{%- endif -%}
      {%- if st.text != blank -%}<div class="c2s__t">{{ st.text }}</div>{%- endif -%}
      <ol class="c2s__list">
        {%- for b in steps -%}
          <li class="c2s__step" {{ b.shopify_attributes }}>
            <span class="c2s__n">{{ forloop.index }}</span>
            <div>
              <p class="c2s__title">{{ b.settings.title | escape }}{% if b.settings.time != blank %}<span class="c2s__time">{{ b.settings.time | escape }}</span>{% endif %}</p>
              {%- if b.settings.text != blank -%}<p class="c2s__text">{{ b.settings.text | escape }}</p>{%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ol>
      {%- if st.button_label != blank -%}<a class="c2s__btn" href="{{ st.button_link | default: '/pages/book' }}">{{ st.button_label | escape }}</a>{%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Coach steps",
  "tag": "section",
  "class": "section sec__coach2-steps",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default-color-scheme" },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "ink", "label": "Heading colour", "default": "#0f1115" },
    { "type": "color", "id": "muted", "label": "Text colour", "default": "#4b5160" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#2b44ff" },
    { "type": "color", "id": "line_color", "label": "Lines", "default": "#e4e6ea" },
    { "type": "image_picker", "id": "image", "label": "Photograph", "info": "Leave empty to show the steps across the whole width." },
    { "type": "text", "id": "image_alt", "label": "Alt text" },
    { "type": "select", "id": "image_focus", "label": "Keep in view", "options": [ { "value": "center", "label": "Middle" }, { "value": "left center", "label": "Left" }, { "value": "right center", "label": "Right" } ], "default": "center" },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "How it works" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "From first call to a plan you use" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "range", "id": "heading_size", "label": "Heading size, desktop", "min": 28, "max": 72, "step": 2, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_top", "label": "Space above, desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 104 },
    { "type": "range", "id": "padding_bottom", "label": "Space below, desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 104 },
    { "type": "range", "id": "padding_top_mobile", "label": "Space above, phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Space below, phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    { "type": "step", "name": "Step", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "A step" },
      { "type": "text", "id": "time", "label": "How long" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "What happens, in a line or two." }
    ] }
  ],
  "presets": [ { "name": "Coach steps", "blocks": [ { "type": "step" }, { "type": "step" }, { "type": "step" } ] } ]
}
{% endschema %}
