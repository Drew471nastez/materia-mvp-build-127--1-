{%- comment -%}
  Outerwear label (templates round 23): one customer review set large,
  after the owner's streetwear reference. A thin label row on top, then the
  stars, the quote in the heading font, the name, and a small card for the
  product it is about, with a photograph beside it. The quote is the
  creator's own: the template ships a placeholder that says so.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign color_scheme = st.color_scheme.id | default: st.color_scheme | default: 'default'
  assign p = st.product
  assign rating = st.rating | default: 5
-%}
<style>
  #shopify-section-{{ sid }} .owr { padding: {{ st.padding_top_mobile | default: 0 }}px 0 {{ st.padding_bottom_mobile | default: 0 }}px; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .owr { padding: {{ st.padding_top | default: 0 }}px 0 {{ st.padding_bottom | default: 0 }}px; } }
  #shopify-section-{{ sid }} .owr__label { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 18px 16px; border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .owr__label { padding: 20px; } }
  #shopify-section-{{ sid }} .owr__label-text { margin: 0; font-family: var(--body-font); font-size: 16px; font-weight: 500; text-transform: none; letter-spacing: 0; color: var(--color-heading); }
  #shopify-section-{{ sid }} .owr__row { display: grid; grid-template-columns: 1fr; }
  @media (min-width: 990px) {
    #shopify-section-{{ sid }} .owr__row { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    #shopify-section-{{ sid }} .owr__row.is-left .owr__media { order: -1; }
  }
  #shopify-section-{{ sid }} .owr__copy { display: flex; flex-direction: column; align-items: flex-start; gap: 22px; padding: 28px 16px 36px; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .owr__copy { padding: 28px 20px 40px; } }
  #shopify-section-{{ sid }} .owr__stars { display: flex; align-items: center; gap: 10px; font-size: 14px; color: var(--color-heading); }
  #shopify-section-{{ sid }} .owr__stars span { display: flex; gap: 3px; }
  #shopify-section-{{ sid }} .owr__stars svg { width: 15px; height: 15px; display: block; }
  #shopify-section-{{ sid }} .owr__stars .is-off { opacity: .3; }
  #shopify-section-{{ sid }} .owr__quote { margin: 0; font-size: {{ st.quote_size_mobile | default: 32 }}px; line-height: 1.02; max-width: 20ch; color: var(--color-heading); overflow-wrap: anywhere; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .owr__quote { font-size: {{ st.quote_size | default: 56 }}px; } }
  #shopify-section-{{ sid }} .owr__name { margin: -6px 0 0; font-size: 16px; }
  #shopify-section-{{ sid }} .owr__note { margin: -14px 0 0; font-size: 12px; opacity: .6; }
  #shopify-section-{{ sid }} .owr__card { display: flex; align-items: center; gap: 14px; width: 100%; max-width: 420px; padding: 10px; border: 1px solid var(--color-border); border-radius: 4px; color: var(--color-heading); text-decoration: none; transition: border-color .2s; }
  #shopify-section-{{ sid }} .owr__card:hover { border-color: var(--color-heading); }
  #shopify-section-{{ sid }} .owr__card-img { flex: 0 0 82px; aspect-ratio: 4 / 5; overflow: hidden; background: #d8d8d6; border-radius: 2px; }
  #shopify-section-{{ sid }} .owr__card-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  #shopify-section-{{ sid }} .owr__card-title { display: block; font-size: 16px; font-weight: 500; }
  #shopify-section-{{ sid }} .owr__card-price { display: block; margin-top: 4px; font-size: 15px; }
  #shopify-section-{{ sid }} .owr__media { position: relative; overflow: hidden; aspect-ratio: 4 / 5; background: var(--color-border); }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .owr__media { aspect-ratio: auto; min-height: {{ st.min_height | default: 640 }}px; } }
  #shopify-section-{{ sid }} .owr__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% {{ st.image_focus_y | default: 35 }}%; }
</style>
<div class="owr section color-{{ color_scheme }} gradient" data-section-type="outerwear-review" data-section-id="{{ sid }}">
  {%- if st.label != blank -%}
    <div class="owr__label"><p class="owr__label-text">{{ st.label | escape }}</p></div>
  {%- endif -%}
  <div class="owr__row{% if st.image_position == 'left' %} is-left{% endif %}">
    <div class="owr__copy">
      <div class="owr__stars" aria-label="{{ rating }} out of 5">
        <span>
          {%- for i in (1..5) -%}
            <svg viewBox="0 0 20 20" aria-hidden="true"{% if i > rating %} class="is-off"{% endif %}><path fill="currentColor" d="M10 1.5l2.6 5.6 6.1.7-4.5 4.2 1.2 6L10 15l-5.4 3 1.2-6L1.3 7.8l6.1-.7z"/></svg>
          {%- endfor -%}
        </span>
        {{ rating }} / 5
      </div>
      {%- if st.quote != blank -%}<p class="owr__quote h1">{{ st.quote | escape }}</p>{%- endif -%}
      {%- if st.author != blank -%}<p class="owr__name">{{ st.author | escape }}</p>{%- endif -%}
      {%- if st.note != blank -%}<p class="owr__note">{{ st.note | escape }}</p>{%- endif -%}
      {%- if p != blank -%}
        <a class="owr__card" href="{{ p.url }}">
          <span class="owr__card-img">{%- if p.featured_image != blank -%}{{ p.featured_image | image_url: width: 240 | image_tag: loading: 'lazy', alt: p.title }}{%- endif -%}</span>
          <span>
            <span class="owr__card-title">{{ p.title | escape }}</span>
            <span class="owr__card-price">{{ p.price | money }}</span>
          </span>
        </a>
      {%- endif -%}
    </div>
    <div class="owr__media">
      {%- if st.image != blank -%}
        {{ st.image | image_url: width: 1600 | image_tag: loading: 'lazy', alt: st.author, widths: '600, 900, 1200, 1600', sizes: '(min-width: 990px) 50vw, 100vw' }}
      {%- endif -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Review with product",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Reviews" },
    { "type": "range", "id": "rating", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
    { "type": "textarea", "id": "quote", "label": "Quote", "default": "Write what one of your customers said about a piece they bought." },
    { "type": "text", "id": "author", "label": "Name", "default": "Customer name" },
    { "type": "text", "id": "note", "label": "Small note under the name" },
    { "type": "product", "id": "product", "label": "Product the review is about" },
    { "type": "image_picker", "id": "image", "label": "Photograph" },
    { "type": "select", "id": "image_position", "label": "Photograph position", "default": "right", "options": [ { "value": "right", "label": "Right" }, { "value": "left", "label": "Left" } ] },
    { "type": "range", "id": "image_focus_y", "label": "Photograph focus, down", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 35 },
    { "type": "range", "id": "min_height", "label": "Height on a computer", "min": 400, "max": 900, "step": 20, "unit": "px", "default": 640 },
    { "type": "range", "id": "quote_size", "label": "Quote size", "min": 24, "max": 80, "step": 2, "unit": "px", "default": 56 },
    { "type": "range", "id": "quote_size_mobile", "label": "Quote size on phones", "min": 20, "max": 48, "step": 2, "unit": "px", "default": 32 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "default" },
    { "type": "range", "id": "padding_top", "label": "Space above", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Space below", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_top_mobile", "label": "Space above on phones", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Space below on phones", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 }
  ],
  "presets": [
    { "name": "Review with product" }
  ]
}
{% endschema %}
