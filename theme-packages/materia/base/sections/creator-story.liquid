{%- comment -%}
  Creator Landing: the story so far. A rounded panel with a two part heading,
  a few short paragraphs and a link on the left, three pictures of the work
  joined by a drawn line on the right, and a row of round buttons under it,
  set between two hairlines. The pictures rise in once; nothing moves with
  reduced motion.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign color_scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
  assign placeholder = 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 400 400%22%3E%3Crect width=%22400%22 height=%22400%22 fill=%22%23e6e0d5%22/%3E%3Cg fill=%22%23b9b0a2%22%3E%3Ccircle cx=%22170%22 cy=%22170%22 r=%2218%22/%3E%3Cpath d=%22M120 260l56-64 36 38 28-24 56 50z%22/%3E%3C/g%3E%3C/svg%3E'
-%}
<style>
  #shopify-section-{{ sid }} .chs {
    --chs-panel: {{ st.panel_color | default: '#f4f1ec' }};
    --chs-line: {{ st.underline_color | default: '#5ec3ea' }};
    --chs-thread: {{ st.thread_color | default: '#f6a27c' }};
    --chs-btn: {{ st.button_color | default: '#5ec3ea' }};
    --chs-btn-text: {{ st.button_text_color | default: '#1c1b2b' }};
    padding: {{ st.padding_top_mobile | default: 24 }}px 12px {{ st.padding_bottom_mobile | default: 40 }}px;
  }
  @media (min-width: 990px) {
    #shopify-section-{{ sid }} .chs { padding: {{ st.padding_top | default: 40 }}px 28px {{ st.padding_bottom | default: 72 }}px; }
  }
  #shopify-section-{{ sid }} .chs__panel {
    position: relative; overflow: hidden; max-width: 1280px; margin: 0 auto;
    background: var(--chs-panel); border-radius: 24px; padding: 44px 20px 36px;
  }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .chs__panel { border-radius: 32px; padding: 88px 88px 64px; } }
  #shopify-section-{{ sid }} .chs__panel::before {
    content: ""; position: absolute; pointer-events: none; width: 1200px; height: 1200px; left: -260px; top: -820px;
    border-radius: 50%; border: 90px solid rgba(255,255,255,0.45);
  }
  #shopify-section-{{ sid }} .chs__grid { position: relative; display: grid; gap: 40px; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .chs__grid { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 72px; align-items: center; } }
  #shopify-section-{{ sid }} .chs__heading {
    margin: 0 0 32px; color: var(--color-heading);
    font-size: {{ st.heading_size_mobile | default: 40 }}px; line-height: 1.04; letter-spacing: -0.03em;
  }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .chs__heading { font-size: {{ st.heading_size | default: 64 }}px; } }
  #shopify-section-{{ sid }} .chs__plain { display: block; font-family: var(--body-font, inherit); font-weight: 400; letter-spacing: -0.04em; }
  #shopify-section-{{ sid }} .chs__serif { position: relative; display: inline-block; font-family: var(--heading-font, inherit); font-weight: var(--heading-font-weight, 600); }
  #shopify-section-{{ sid }} .chs__swash { position: absolute; left: -2%; bottom: -0.2em; width: 104%; height: 0.3em; overflow: visible; }
  #shopify-section-{{ sid }} .chs__swash path { fill: none; stroke: var(--chs-line); stroke-width: 7; stroke-linecap: round; }
  #shopify-section-{{ sid }} .chs__text { color: var(--color-heading); font-size: 16px; line-height: 1.65; max-width: 44ch; }
  #shopify-section-{{ sid }} .chs__text p { margin: 0 0 18px; }
  #shopify-section-{{ sid }} .chs__link {
    display: inline-flex; align-items: center; gap: 10px; margin-top: 6px;
    font-size: 15px; font-weight: 600; color: var(--color-heading); text-decoration: underline; text-underline-offset: 4px;
  }
  #shopify-section-{{ sid }} .chs__link svg { width: 14px; height: 14px; }
  #shopify-section-{{ sid }} .chs__collage { position: relative; aspect-ratio: 1 / 1.02; max-width: 560px; width: 100%; margin: 0 auto; }
  #shopify-section-{{ sid }} .chs__thread { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  #shopify-section-{{ sid }} .chs__thread path { fill: none; stroke: var(--chs-thread); stroke-width: 2.5; stroke-linecap: round; }
  #shopify-section-{{ sid }} .chs__thread circle { fill: none; stroke: var(--chs-thread); stroke-width: 2.5; }
  #shopify-section-{{ sid }} .chs__pic {
    position: absolute; margin: 0; overflow: hidden; background: #e6e0d5;
    box-shadow: 0 24px 50px -28px rgba(60,44,20,0.45);
    opacity: 0; transform: translateY(14px);
    animation: chs-rise-{{ sid }} 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
  }
  #shopify-section-{{ sid }} .chs__pic img { display: block; width: 100%; height: 100%; object-fit: cover; margin: 0; }
  #shopify-section-{{ sid }} .chs__pic--1 { right: 0; top: 0; width: 64%; height: 52%; border-radius: 22px 120px 22px 22px; }
  #shopify-section-{{ sid }} .chs__pic--2 { left: 0; top: 34%; width: 32%; height: 26%; border-radius: 18px; animation-delay: 0.12s; }
  #shopify-section-{{ sid }} .chs__pic--3 { right: 12%; bottom: 0; width: 52%; height: 42%; border-radius: 22px 22px 96px 22px; animation-delay: 0.24s; }
  @keyframes chs-rise-{{ sid }} { to { opacity: 1; transform: none; } }
  #shopify-section-{{ sid }} .chs__buttons {
    position: relative; display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 12px; margin-top: 48px;
  }
  @media (min-width: 990px) {
    #shopify-section-{{ sid }} .chs__buttons { margin-top: 72px; gap: 16px; }
    #shopify-section-{{ sid }} .chs__buttons::before, #shopify-section-{{ sid }} .chs__buttons::after {
      content: ""; flex: 1 1 60px; max-width: 120px; height: 1px; background: rgba(28,27,43,0.14);
    }
  }
  #shopify-section-{{ sid }} .chs__btn {
    display: inline-flex; align-items: center; min-height: 46px; padding: 0 22px; border-radius: 999px;
    background: var(--chs-btn); color: var(--chs-btn-text); font-size: 15px; font-weight: 600; text-decoration: none;
    transition: transform 0.2s ease, filter 0.2s ease;
  }
  #shopify-section-{{ sid }} .chs__btn:hover { transform: translateY(-1px); filter: brightness(0.96); }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .chs__pic { animation: none; opacity: 1; transform: none; }
    #shopify-section-{{ sid }} .chs__btn { transition: none; }
  }
</style>

<div class="chs color-{{ color_scheme }}" data-section-id="{{ sid }}">
  <div class="chs__panel">
    <div class="chs__grid">
      <div class="chs__copy">
        <{{ st.heading_tag | default: 'h2' }} class="chs__heading">
          {%- if st.heading_plain != blank -%}<span class="chs__plain">{{ st.heading_plain | escape }}</span>{%- endif -%}
          {%- if st.heading_serif != blank -%}<span class="chs__serif">{{ st.heading_serif | escape }}<svg class="chs__swash" viewBox="0 0 400 30" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M4 18 C 120 6, 260 6, 396 16"/></svg></span>{%- endif -%}
        </{{ st.heading_tag | default: 'h2' }}>
        {%- if st.text != blank -%}<div class="chs__text">{{ st.text }}</div>{%- endif -%}
        {%- if st.link_label != blank -%}
          <a class="chs__link" href="{{ st.link | default: '/pages/about' }}">{{ st.link_label | escape }}<svg viewBox="0 0 14 14" fill="none" aria-hidden="true" focusable="false"><path d="M1 7h11M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        {%- endif -%}
      </div>
      <div class="chs__collage">
        <svg class="chs__thread" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M16 36 C 18 20, 28 16, 36 18 M 16 60 C 14 74, 22 84, 40 82" vector-effect="non-scaling-stroke"/><circle cx="36" cy="18" r="1.2" vector-effect="non-scaling-stroke"/><circle cx="40" cy="82" r="1.2" vector-effect="non-scaling-stroke"/></svg>
        {%- for n in (1..3) -%}
          {%- case n -%}
            {%- when 1 -%}{%- assign pic = st.image_1 -%}{%- assign alt = st.image_1_alt -%}
            {%- when 2 -%}{%- assign pic = st.image_2 -%}{%- assign alt = st.image_2_alt -%}
            {%- else -%}{%- assign pic = st.image_3 -%}{%- assign alt = st.image_3_alt -%}
          {%- endcase -%}
          <figure class="chs__pic chs__pic--{{ n }}">
            {%- if pic != blank -%}
              <img src="{{ pic | image_url: width: 900 }}" srcset="{{ pic | image_url: width: 500 }} 500w, {{ pic | image_url: width: 900 }} 900w" sizes="(min-width: 990px) 360px, 60vw" width="{{ pic.width | default: 900 }}" height="{{ pic.height | default: 900 }}" alt="{{ alt | default: pic.alt | escape }}" loading="lazy" decoding="async">
            {%- else -%}
              <img src="{{ placeholder }}" width="400" height="400" alt="">
            {%- endif -%}
          </figure>
        {%- endfor -%}
      </div>
    </div>
    {%- if section.blocks.size > 0 -%}
      <div class="chs__buttons">
        {%- for block in section.blocks -%}
          <a class="chs__btn" href="{{ block.settings.link | default: '/' }}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Creator story",
  "tag": "section",
  "class": "section sec__creator-story",
  "max_blocks": 4,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default-color-scheme" },
    { "type": "color", "id": "panel_color", "label": "Panel colour", "default": "#f4f1ec" },
    { "type": "text", "id": "heading_plain", "label": "Heading, plain line", "default": "Why I" },
    { "type": "text", "id": "heading_serif", "label": "Heading, underlined line", "default": "do this" },
    { "type": "color", "id": "underline_color", "label": "Underline colour", "default": "#5ec3ea" },
    { "type": "select", "id": "heading_tag", "label": "Heading level", "options": [ { "value": "h1", "label": "Page title (h1)" }, { "value": "h2", "label": "Section title (h2)" } ], "default": "h2" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Tell the short version of how you got here.</p>" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Read the full story" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "header", "content": "Pictures" },
    { "type": "image_picker", "id": "image_1", "label": "Large picture" },
    { "type": "text", "id": "image_1_alt", "label": "Large picture, alt text" },
    { "type": "image_picker", "id": "image_2", "label": "Small picture" },
    { "type": "text", "id": "image_2_alt", "label": "Small picture, alt text" },
    { "type": "image_picker", "id": "image_3", "label": "Lower picture" },
    { "type": "text", "id": "image_3_alt", "label": "Lower picture, alt text" },
    { "type": "color", "id": "thread_color", "label": "Line between the pictures", "default": "#f6a27c" },
    { "type": "header", "content": "Buttons" },
    { "type": "color", "id": "button_color", "label": "Button colour", "default": "#5ec3ea" },
    { "type": "color", "id": "button_text_color", "label": "Button text colour", "default": "#1c1b2b" },
    { "type": "header", "content": "Size and space" },
    { "type": "range", "id": "heading_size", "label": "Heading size, desktop", "min": 32, "max": 96, "step": 2, "unit": "px", "default": 64 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size, phone", "min": 24, "max": 56, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_top", "label": "Space above, desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Space below, desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_top_mobile", "label": "Space above, phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Space below, phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 }
  ],
  "blocks": [
    {
      "type": "button",
      "name": "Button",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Watch the lessons" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Creator story",
      "blocks": [ { "type": "button" }, { "type": "button" } ]
    }
  ]
}
{% endschema %}
