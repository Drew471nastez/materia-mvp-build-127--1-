{%- comment -%}
  Online course: what the course is, in numbers the creator knows to be
  true (modules, lessons, hours, the refund window). A row of outlined
  cards, each with a small filled icon square, a large figure and a label.
  Four across on desktop, two on a phone. They rise in one after another.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign sid = section.id
-%}
<style>
  #shopify-section-{{ sid }} .c2f {
    --c2-accent: {{ s.accent | default: '#12704f' }};
    --c2-ink: {{ s.heading_color | default: '#15171a' }};
    --c2-text: {{ s.text_color | default: '#5b616b' }};
    --c2-line: {{ s.line_color | default: '#e3e5e8' }};
    background: {{ s.background | default: '#ffffff' }};
    padding: {{ s.padding_top_mobile | default: 16 }}px 0 {{ s.padding_bottom_mobile | default: 48 }}px;
  }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .c2f { padding: {{ s.padding_top | default: 24 }}px 0 {{ s.padding_bottom | default: 96 }}px; } }
  #shopify-section-{{ sid }} .c2f__grid { max-width: 1200px; margin: 0 auto; padding: 0 20px; list-style: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .c2f__grid { padding: 0 40px; grid-template-columns: repeat({{ section.blocks.size | at_least: 1 | at_most: 4 }}, minmax(0, 1fr)); gap: 24px; } }
  #shopify-section-{{ sid }} .c2f__card { margin: 0; padding: 20px 18px 22px; border: 1px solid var(--c2-line); border-radius: 16px; background: #fff; min-width: 0; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .c2f__card { padding: 32px 32px 34px; } }
  #shopify-section-{{ sid }} .c2f__icon { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 10px; background: var(--c2-accent); color: #fff; margin-bottom: 22px; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .c2f__icon { width: 56px; height: 56px; margin-bottom: 34px; } }
  #shopify-section-{{ sid }} .c2f__icon svg { width: 22px; height: 22px; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .c2f__icon svg { width: 26px; height: 26px; } }
  #shopify-section-{{ sid }} .c2f__figure { display: block; color: var(--c2-ink); font-family: var(--heading-font, inherit); font-weight: 700; font-size: 34px; line-height: 1; letter-spacing: -.04em; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .c2f__figure { font-size: 52px; } }
  #shopify-section-{{ sid }} .c2f__label { display: block; margin-top: 10px; font-size: 14px; line-height: 1.4; color: var(--c2-text); }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .c2f__label { font-size: 17px; } }
  #shopify-section-{{ sid }} [data-c2r].c2r-wait { opacity: 0; transform: translate3d(0, 22px, 0); }
  #shopify-section-{{ sid }} [data-c2r].c2r-in { opacity: 1; transform: none; transition: opacity .8s cubic-bezier(.2,.65,.25,1) var(--d, 0ms), transform .8s cubic-bezier(.2,.65,.25,1) var(--d, 0ms); }
</style>
<div class="c2f">
  <ul class="c2f__grid" role="list">
    {%- for block in section.blocks limit: 4 -%}
      {%- assign b = block.settings -%}
      <li class="c2f__card" data-c2r style="--d: {{ forloop.index0 | times: 80 }}ms" {{ block.shopify_attributes }}>
        <span class="c2f__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" focusable="false">
            {%- case b.icon -%}
              {%- when 'play' -%}<rect x="3" y="4" width="18" height="16" rx="3"/><path d="M10 9l5 3-5 3z"/>
              {%- when 'list' -%}<path d="M9 6h11M9 12h11M9 18h11"/><circle cx="4.5" cy="6" r="1"/><circle cx="4.5" cy="12" r="1"/><circle cx="4.5" cy="18" r="1"/>
              {%- when 'clock' -%}<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>
              {%- when 'shield' -%}<path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z"/><path d="M9 12l2 2 4-4"/>
              {%- when 'cup' -%}<path d="M4 9h13v4a6 6 0 0 1-6 6h-1a6 6 0 0 1-6-6z"/><path d="M17 10.5h1.5a2.5 2.5 0 0 1 0 5H16.5"/><path d="M8 3.5c0 1.5 1.5 1.5 1.5 3M12 3.5c0 1.5 1.5 1.5 1.5 3"/>
              {%- when 'download' -%}<path d="M12 4v11M7.5 10.5L12 15l4.5-4.5"/><path d="M4.5 19.5h15"/>
              {%- when 'users' -%}<circle cx="9" cy="8.5" r="3.5"/><path d="M2.5 20c.5-3.5 3.2-5.5 6.5-5.5s6 2 6.5 5.5"/><path d="M16 5.2a3.5 3.5 0 0 1 0 6.6M18.5 14.8c1.7.7 2.8 2.4 3 5.2"/>
              {%- when 'chat' -%}<path d="M4 5h16v11H9l-5 4z"/>
              {%- when 'calendar' -%}<rect x="3.5" y="5" width="17" height="15.5" rx="2.5"/><path d="M3.5 10h17M8 3v4M16 3v4"/>
              {%- else -%}<path d="M12 3l2.6 5.6 6 .7-4.5 4.1 1.2 6L12 16.4 6.7 19.4l1.2-6L3.4 9.3l6-.7z"/>
            {%- endcase -%}
          </svg>
        </span>
        <span class="c2f__figure">{{ b.figure | escape }}</span>
        <span class="c2f__label">{{ b.label | escape }}</span>
      </li>
    {%- endfor -%}
  </ul>
</div>
{%- unless request.design_mode -%}
<script>(function(){var r=document.getElementById('shopify-section-{{ sid }}');if(!r||!('IntersectionObserver' in window)||matchMedia('(prefers-reduced-motion: reduce)').matches)return;var h=innerHeight,io=new IntersectionObserver(function(es){es.forEach(function(e){if(!e.isIntersecting)return;var t=e.target;io.unobserve(t);requestAnimationFrame(function(){t.classList.add('c2r-in')})})},{rootMargin:'0px 0px -6% 0px'});r.querySelectorAll('[data-c2r]').forEach(function(el){if(el.getBoundingClientRect().top<h*.92)return;el.classList.add('c2r-wait');io.observe(el)})})();</script>
{%- endunless -%}

{% schema %}
{
  "name": "Course in numbers",
  "tag": "section",
  "class": "course2-facts-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "paragraph", "content": "Use numbers that are true of the course: modules, lessons, hours, days to ask for a refund." },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "accent", "label": "Icon squares", "default": "#12704f" },
    { "type": "color", "id": "heading_color", "label": "Figures", "default": "#15171a" },
    { "type": "color", "id": "text_color", "label": "Labels", "default": "#5b616b" },
    { "type": "color", "id": "line_color", "label": "Card outline", "default": "#e3e5e8" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Space above on desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Space below on desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_top_mobile", "label": "Space above on phones", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 16 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Space below on phones", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Number",
      "limit": 4,
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "play", "options": [ { "value": "play", "label": "Video" }, { "value": "list", "label": "List" }, { "value": "clock", "label": "Clock" }, { "value": "shield", "label": "Shield" }, { "value": "cup", "label": "Cup" }, { "value": "download", "label": "Download" }, { "value": "users", "label": "People" }, { "value": "chat", "label": "Message" }, { "value": "calendar", "label": "Calendar" }, { "value": "star", "label": "Star" } ] },
        { "type": "text", "id": "figure", "label": "Figure", "default": "12" },
        { "type": "text", "id": "label", "label": "Label", "default": "video lessons" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Course in numbers",
      "category": "Online course",
      "blocks": [
        { "type": "fact", "settings": { "icon": "list", "figure": "6", "label": "modules" } },
        { "type": "fact", "settings": { "icon": "play", "figure": "40", "label": "video lessons" } },
        { "type": "fact", "settings": { "icon": "clock", "figure": "5h", "label": "of video" } },
        { "type": "fact", "settings": { "icon": "shield", "figure": "30", "label": "days to ask for a refund" } }
      ]
    }
  ]
}
{% endschema %}
