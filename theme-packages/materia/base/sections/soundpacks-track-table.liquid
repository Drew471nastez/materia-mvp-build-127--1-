{% schema %}
{
  "name": "Sound table",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "info": "Shown in the accent colour." },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Hear what is inside." },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "select", "id": "heading_align", "label": "Heading position", "default": "left", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Centre" }] },
    { "type": "richtext", "id": "note", "label": "Note under the table", "default": "<p>All previews are MP3 renders of the WAV files in the pack.</p>" },
    { "type": "text", "id": "anchor", "label": "Name to link to", "info": "A link to #name on the page scrolls here, e.g. #sounds." },
    { "type": "header", "content": "Column names" },
    { "type": "text", "id": "col_audio", "label": "Audio", "default": "Audio" },
    { "type": "text", "id": "col_type", "label": "Type", "default": "Type" },
    { "type": "text", "id": "col_name", "label": "Name", "default": "Name and file" },
    { "type": "text", "id": "col_bpm", "label": "BPM", "default": "BPM" },
    { "type": "text", "id": "col_key", "label": "Key", "default": "Key" },
    { "type": "checkbox", "id": "bpm_suffix", "label": "Write BPM after the number", "default": true },
    { "type": "header", "content": "Look" },
    { "type": "color", "id": "accent", "label": "Accent", "info": "The eyebrow and the playing wave. Left empty, the scheme's button colour." },
    { "type": "color", "id": "panel_color", "label": "Table colour", "info": "Left empty, a shade of the scheme's heading colour." },
    { "type": "checkbox", "id": "use_theme_radius", "label": "Use the theme's card corners", "default": false },
    { "type": "range", "id": "panel_radius", "label": "Table corners", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 28 },
    { "type": "range", "id": "max_width", "label": "Width", "min": 640, "max": 1400, "step": 20, "unit": "px", "default": 1200 },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 20, "max": 72, "step": 2, "unit": "px", "default": 48 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size on phones", "min": 18, "max": 48, "step": 2, "unit": "px", "default": 32 },
    { "type": "header", "content": "General" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default" },
    { "type": "select", "id": "section_width", "label": "Section width", "default": "container", "options": [{ "value": "container", "label": "Default" }, { "value": "fluid_container", "label": "Fluid container" }, { "value": "stretch_width", "label": "Stretched" }] },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 }
  ],
  "blocks": [
    {
      "type": "sound",
      "name": "Sound",
      "settings": [
        { "type": "text", "id": "title", "label": "Name", "default": "Drum loop 01" },
        { "type": "text", "id": "file", "label": "File name", "default": "Drum Loop 01 124BPM.wav" },
        { "type": "select", "id": "kind", "label": "Type", "default": "loop", "options": [{ "value": "one_shot", "label": "One shot" }, { "value": "loop", "label": "Loop" }, { "value": "demo", "label": "Demo track" }, { "value": "midi", "label": "MIDI" }] },
        { "type": "text", "id": "bpm", "label": "BPM", "default": "124" },
        { "type": "text", "id": "key", "label": "Key", "info": "Left empty, a dash." },
        { "type": "file_picker", "id": "audio", "label": "Audio file", "accept": ["audio"], "info": "An mp3, wav, m4a, ogg, aac or flac file, or an https link." },
        { "type": "number", "id": "seconds", "label": "Length in seconds", "info": "Shown before play. Nothing downloads until play is pressed." },
        { "type": "textarea", "id": "peaks", "label": "Waveform peaks", "info": "Optional: 120 numbers from 0 to 100, separated by commas. Left empty, the wave is read from the file the first time it plays." },
        { "type": "product", "id": "for_product", "label": "Only on this product's page", "info": "Pages that are not a product's show every sound." },
        { "type": "text", "id": "for_name", "label": "Or the product's name", "info": "The sound shows on the page of the product with this exact name." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sound table",
      "blocks": [
        { "type": "sound", "settings": { "title": "Kick 01", "file": "Kick 01.wav", "kind": "one_shot", "bpm": "" } },
        { "type": "sound", "settings": { "title": "Drum loop 01", "file": "Drum Loop 01 124BPM.wav", "kind": "loop", "bpm": "124" } },
        { "type": "sound", "settings": { "title": "Chords 01", "file": "Chords 01 124BPM Amin.wav", "kind": "loop", "bpm": "124", "key": "A minor" } }
      ]
    }
  ]
}
