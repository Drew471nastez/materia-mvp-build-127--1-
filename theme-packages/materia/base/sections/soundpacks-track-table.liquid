{%- comment -%}
  Sound packs (templates round 25): the sounds of a pack as a table, each
  row a player with the file's own waveform, its length, what kind of
  sound it is (one shot, loop, demo track, MIDI), its name and file name,
  its BPM and its key. A heading and a few lines sit above the table and a
  small note under it ("All previews are MP3 renders ...").

  A row tied to a product (picked, or named by the product's name) shows on
  that product's page only, and on pages that are not a product's. A row
  tied to nothing shows everywhere. When no row is left for a product's
  page, the section draws nothing there.

  The players are the theme's shared ones (samples-audio-tracks): one sound
  plays at a time across the page and nothing downloads before play.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign sid = section.id
  assign color_scheme = s.color_scheme.id | default: s.color_scheme | default: 'default'
  assign section_width = s.section_width | default: 'container'
  assign pt = s.padding_top | default: 72
  assign pb = s.padding_bottom | default: 72
  assign shown = 0
  for block in section.blocks
    assign mine = true
    if product != blank
      if block.settings.for_product != blank
        if block.settings.for_product.id != product.id
          assign mine = false
        endif
      elsif block.settings.for_name != blank
        assign want = block.settings.for_name | handleize
        if want != product.handle
          assign mine = false
        endif
      endif
    endif
    if mine
      assign shown = shown | plus: 1
    endif
  endfor
-%}
{%- if shown > 0 or request.design_mode -%}
<style>
  #shopify-section-{{ sid }} .spt { --spx-accent: {% if s.accent != blank %}{{ s.accent }}{% else %}var(--btn-primary-bg-color){% endif %}; --spt-panel: {% if s.panel_color != blank %}{{ s.panel_color }}{% else %}rgba(var(--color-heading-rgb), .04){% endif %}; padding-block: {{ pt | times: 0.65 | round }}px {{ pb | times: 0.65 | round }}px; }
  #shopify-section-{{ sid }} .ssp { --ssp-p: 0%; --ssp-h: 0%; --ssp-sw: 2px; --ssp-accent: var(--spx-accent); --ssp-base: rgba(var(--color-heading-rgb), .26); --ssp-done: var(--spx-accent); min-width: 0; }
  #shopify-section-{{ sid }} .ssp__btn { position: relative; flex: none; box-sizing: border-box; margin: 0; padding: 0; border: 0; border-radius: 50%; display: grid; place-items: center; cursor: pointer; -webkit-tap-highlight-color: transparent; transition: background-color .2s ease, color .2s ease, transform .2s ease, box-shadow .2s ease; }
  #shopify-section-{{ sid }} .ssp__btn:focus-visible, #shopify-section-{{ sid }} .ssp__wave:focus-visible { outline: 2px solid var(--spx-accent); outline-offset: 3px; }
  #shopify-section-{{ sid }} .ssp__btn[disabled] { cursor: default; opacity: .5; }
  #shopify-section-{{ sid }} .ssp__i { grid-area: 1 / 1; width: 42%; height: 42%; display: block; transition: opacity .2s ease, scale .2s ease; }
  #shopify-section-{{ sid }} .ssp__i--play { transform: translateX(-3.1%); } /* Round 26: the triangle's box sits right of centre in its 16 unit view; this puts its weight in the middle of the circle. */
  #shopify-section-{{ sid }} .ssp__i--pause { opacity: 0; scale: .7; }
  #shopify-section-{{ sid }} .ssp.is-playing .ssp__i--play { scale: .7; }
  #shopify-section-{{ sid }} .ssp.is-playing .ssp__i--pause { scale: 1; }
  #shopify-section-{{ sid }} .ssp.is-playing .ssp__i--play { opacity: 0; }
  #shopify-section-{{ sid }} .ssp.is-playing .ssp__i--pause { opacity: 1; }
  #shopify-section-{{ sid }} .ssp__btn::after { content: ""; position: absolute; inset: -3px; border-radius: 50%; border: 2px solid transparent; border-top-color: var(--spx-accent); opacity: 0; transition: opacity .2s ease; pointer-events: none; }
  #shopify-section-{{ sid }} .ssp.is-loading .ssp__btn::after { opacity: 1; animation: spx-spin .8s linear infinite; }
  #shopify-section-{{ sid }} .ssp__row { display: flex; align-items: center; gap: 10px; min-width: 0; }
  #shopify-section-{{ sid }} .ssp__wave { position: relative; flex: 1 1 auto; min-width: 0; cursor: pointer; touch-action: pan-y; -webkit-tap-highlight-color: transparent; }
  #shopify-section-{{ sid }} .ssp--off .ssp__wave { cursor: default; }
  #shopify-section-{{ sid }} .ssp__svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; fill: none; stroke: var(--ssp-base); stroke-width: var(--ssp-sw); stroke-linecap: round; pointer-events: none; transform-origin: 50% 50%; }
  #shopify-section-{{ sid }} .ssp__svg--hover { stroke: rgba(var(--color-heading-rgb), .55); clip-path: inset(-2px calc(100% - var(--ssp-h)) -2px 0); opacity: 0; transition: opacity .2s ease; }
  #shopify-section-{{ sid }} .ssp__svg--done { stroke: var(--ssp-done); clip-path: inset(-2px calc(100% - var(--ssp-p)) -2px 0); }
  #shopify-section-{{ sid }} .ssp:not(.is-started) .ssp__svg--done { visibility: hidden; }
  #shopify-section-{{ sid }} .ssp__head { position: absolute; top: 6%; bottom: 6%; left: var(--ssp-p); width: 2px; margin-left: -1px; border-radius: 2px; background: rgb(var(--color-heading-rgb)); opacity: 0; transition: opacity .2s ease; pointer-events: none; }
  #shopify-section-{{ sid }} .ssp.is-started .ssp__head { opacity: .9; }
  #shopify-section-{{ sid }} .ssp__tip { position: absolute; bottom: calc(100% + 6px); left: var(--ssp-h); transform: translateX(-50%); padding: 3px 7px; border-radius: 6px; background: rgb(var(--color-heading-rgb)); color: var(--color-background); font-size: 11px; font-weight: 600; line-height: 1.2; font-variant-numeric: tabular-nums; white-space: nowrap; opacity: 0; transition: opacity .15s ease; pointer-events: none; z-index: 2; }
  #shopify-section-{{ sid }} .ssp--flat .ssp__svg { stroke: rgba(var(--color-heading-rgb), .18); }
  #shopify-section-{{ sid }} .ssp--drawn .ssp__svg { animation: spx-grow .5s cubic-bezier(.2,.7,.2,1) both; }
  #shopify-section-{{ sid }} .ssp__time { flex: none; font-size: 12px; line-height: 1; color: var(--color-text); font-variant-numeric: tabular-nums; white-space: nowrap; }
  #shopify-section-{{ sid }} .ssp.is-started .ssp__time { color: var(--color-heading); }
  @media (hover: hover) and (pointer: fine) {
    #shopify-section-{{ sid }} .ssp:not(.ssp--off) .ssp__wave:hover .ssp__svg--hover, #shopify-section-{{ sid }} .ssp.has-len:not(.ssp--off) .ssp__wave:hover .ssp__tip { opacity: 1; }
  }
  @keyframes spx-spin { to { transform: rotate(360deg); } }
  @keyframes spx-grow { from { transform: scaleY(.08); } to { transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .ssp__btn, #shopify-section-{{ sid }} .ssp__i, #shopify-section-{{ sid }} .ssp__svg--hover, #shopify-section-{{ sid }} .ssp__head, #shopify-section-{{ sid }} .ssp__tip { transition: none; }
    #shopify-section-{{ sid }} .ssp--drawn .ssp__svg { animation: none; }
  }
  #shopify-section-{{ sid }} .spt__inner { max-width: {{ s.max_width | default: 1200 }}px; margin-inline: auto; }
  #shopify-section-{{ sid }} .spt__head { max-width: 640px; margin: 0 0 28px; }
  #shopify-section-{{ sid }} .spt__head--center { margin-inline: auto; text-align: center; }
  #shopify-section-{{ sid }} .spt__eyebrow { margin: 0 0 8px; font-size: 15px; font-weight: 600; color: var(--spx-accent); }
  #shopify-section-{{ sid }} .spt__heading { margin: 0; font-size: {{ s.heading_size_mobile | default: 32 }}px; line-height: 1.05; letter-spacing: -0.02em; text-wrap: balance; }
  #shopify-section-{{ sid }} .spt__text { margin-top: 14px; font-size: 15px; line-height: 1.6; color: var(--color-text); }
  #shopify-section-{{ sid }} .spt__text p { margin: 0; }
  #shopify-section-{{ sid }} .spt__text p + p { margin-top: 10px; }
  #shopify-section-{{ sid }} .spt__text strong { color: var(--color-heading); font-weight: 600; }
  #shopify-section-{{ sid }} .spt__panel { border-radius: {% if s.use_theme_radius %}var(--card-radius, 16px){% else %}{{ s.panel_radius | default: 28 }}px{% endif %}; background: var(--spt-panel); padding: 8px 8px 18px; }
  #shopify-section-{{ sid }} .spt__cols { display: none; }
  #shopify-section-{{ sid }} .spt__list { list-style: none; margin: 0; padding: 0; }
  #shopify-section-{{ sid }} .spt__row { display: grid; grid-template-columns: minmax(0, 1fr); align-items: center; padding: 12px 10px; border-radius: 12px; transition: background-color .2s ease; }
  #shopify-section-{{ sid }} .spt__row + .spt__row { border-top: 1px solid rgba(var(--color-heading-rgb), .06); }
  #shopify-section-{{ sid }} .spt__row:has(.ssp.is-started) { background: rgba(var(--color-heading-rgb), .06); border-top-color: transparent; }
  #shopify-section-{{ sid }} .spt__row:has(.ssp.is-started) + .spt__row { border-top-color: transparent; }
  #shopify-section-{{ sid }} .spt .ssp { display: grid; grid-template-columns: 28px minmax(0, 1fr) auto; grid-template-areas: "btn name meta" "wave wave wave"; align-items: center; column-gap: 10px; row-gap: 10px; }
  #shopify-section-{{ sid }} .spt .ssp__btn { grid-area: btn; width: 28px; height: 28px; background: transparent; color: var(--color-heading); }
  #shopify-section-{{ sid }} .spt .ssp__i { width: 62%; height: 62%; }
  #shopify-section-{{ sid }} .spt .ssp.is-playing .ssp__btn { color: var(--spx-accent); }
  #shopify-section-{{ sid }} .spt .ssp__row { grid-area: wave; }
  #shopify-section-{{ sid }} .spt .ssp__wave { height: 30px; }
  #shopify-section-{{ sid }} .spt .ssp__time { min-width: 2.4em; text-align: right; }
  #shopify-section-{{ sid }} .spt__type { display: none; color: var(--color-text); }
  #shopify-section-{{ sid }} .spt__type svg { width: 18px; height: 18px; display: block; }
  #shopify-section-{{ sid }} .spt__name { grid-area: name; min-width: 0; }
  #shopify-section-{{ sid }} .spt__title { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 14px; font-weight: 600; line-height: 1.3; color: var(--color-heading); }
  #shopify-section-{{ sid }} .spt__file { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 12px; line-height: 1.4; color: var(--color-text); }
  #shopify-section-{{ sid }} .spt__meta { grid-area: meta; display: flex; gap: 10px; font-size: 12px; color: var(--color-text); white-space: nowrap; font-variant-numeric: tabular-nums; }
  #shopify-section-{{ sid }} .spt__bpm, #shopify-section-{{ sid }} .spt__key { min-width: 0; }
  #shopify-section-{{ sid }} .spt__meta .is-empty { display: none; }
  #shopify-section-{{ sid }} .spt__note { margin: 18px 16px 0; font-size: 12px; line-height: 1.5; text-align: center; color: var(--color-text); }
  #shopify-section-{{ sid }} .spt__note p { margin: 0; }
  #shopify-section-{{ sid }} .spt__empty { margin: 0; padding: 24px; font-size: 15px; }
  @media (min-width: 750px) {
    #shopify-section-{{ sid }} .spt { padding-block: {{ pt }}px {{ pb }}px; }
    #shopify-section-{{ sid }} .spt__heading { font-size: {{ s.heading_size | default: 48 }}px; }
    #shopify-section-{{ sid }} .spt__text { font-size: 16px; }
    #shopify-section-{{ sid }} .spt__head { margin-bottom: 40px; }
    #shopify-section-{{ sid }} .spt__panel { padding: 22px 40px 26px; }
    #shopify-section-{{ sid }} .spt__cols, #shopify-section-{{ sid }} .spt .ssp { display: grid; grid-template-columns: 28px minmax(140px, 1.15fr) 36px 30px minmax(0, 1.3fr) 76px 60px; grid-template-areas: "btn wave wave type name bpm key"; column-gap: 16px; align-items: center; }
    #shopify-section-{{ sid }} .spt__cols { padding: 6px 10px 14px; margin-bottom: 4px; border-bottom: 1px solid rgba(var(--color-heading-rgb), .08); font-size: 11px; color: var(--color-text); }
    #shopify-section-{{ sid }} .spt__cols span:nth-child(1) { grid-column: 2; }
    #shopify-section-{{ sid }} .spt__cols span:nth-child(2) { grid-column: 4; }
    #shopify-section-{{ sid }} .spt__cols span:nth-child(3) { grid-column: 5; }
    #shopify-section-{{ sid }} .spt__cols span:nth-child(4) { grid-column: 6; }
    #shopify-section-{{ sid }} .spt__cols span:nth-child(5) { grid-column: 7; }
    #shopify-section-{{ sid }} .spt__row { padding: 9px 10px; }
    #shopify-section-{{ sid }} .spt__row + .spt__row { border-top: 0; }
    #shopify-section-{{ sid }} .spt .ssp__row { grid-area: wave; gap: 14px; }
    #shopify-section-{{ sid }} .spt .ssp__wave { height: 28px; }
    #shopify-section-{{ sid }} .spt__type { display: block; grid-area: type; }
    #shopify-section-{{ sid }} .spt__meta { display: contents; }
    #shopify-section-{{ sid }} .spt__bpm { grid-area: bpm; }
    #shopify-section-{{ sid }} .spt__key { grid-area: key; }
    #shopify-section-{{ sid }} .spt__dot { display: none; }
    #shopify-section-{{ sid }} .spt__meta .is-empty { display: block; }
  }
  @media (hover: hover) and (pointer: fine) {
    #shopify-section-{{ sid }} .spt__row:hover { background: rgba(var(--color-heading-rgb), .04); }
    #shopify-section-{{ sid }} .spt .ssp__btn:hover { color: var(--spx-accent); }
  }
</style>
<div class="spt section color-{{ color_scheme }} gradient" data-section-id="{{ sid }}"{% if s.anchor != blank %} id="{{ s.anchor | handleize }}" style="scroll-margin-top: 96px;"{% endif %}>
  <div class="{{ section_width }}">
    <div class="spt__inner">
      {%- if s.heading != blank or s.text != blank or s.eyebrow != blank -%}
        <div class="spt__head{% if s.heading_align == 'center' %} spt__head--center{% endif %}">
          {%- if s.eyebrow != blank -%}<p class="spt__eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
          {%- if s.heading != blank -%}<h2 class="spt__heading h2">{{ s.heading }}</h2>{%- endif -%}
          {%- if s.text != blank -%}<div class="spt__text">{{ s.text }}</div>{%- endif -%}
        </div>
      {%- endif -%}
      <div class="spt__panel">
        {%- if shown > 0 -%}
          <div class="spt__cols" aria-hidden="true"><span>{{ s.col_audio | default: 'Audio' | escape }}</span><span>{{ s.col_type | default: 'Type' | escape }}</span><span>{{ s.col_name | default: 'Name and file' | escape }}</span><span>{{ s.col_bpm | default: 'BPM' | escape }}</span><span>{{ s.col_key | default: 'Key' | escape }}</span></div>
          <ul class="spt__list" role="list">
            {%- for block in section.blocks -%}
              {%- liquid
                assign b = block.settings
                if product != blank
                  if b.for_product != blank
                    if b.for_product.id != product.id
                      continue
                    endif
                  elsif b.for_name != blank
                    assign want = b.for_name | handleize
                    if want != product.handle
                      continue
                    endif
                  endif
                endif
                assign ssp_audio = b.audio
                assign ssp_title = b.title
                assign ssp_peaks = b.peaks
                assign ssp_len = b.seconds
                assign ssp_id = 'ssp-' | append: sid | append: '-' | append: block.id
                assign ssp_class = 'spt__player'
                assign ssp_before = ''
                assign kind = b.kind | default: 'loop'
              -%}
              {%- capture ssp_after -%}
                <span class="spt__type" title="{{ kind | replace: '_', ' ' | capitalize }}">
                  {%- case kind -%}
                    {%- when 'one_shot' -%}<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10v0M7 6v8M10 3v14M13 7v6M16 9v2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" fill="none"/></svg>
                    {%- when 'demo' -%}<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M8 15.5V4.5l8-1.5v11" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><circle cx="6" cy="15.5" r="2" fill="currentColor"/><circle cx="14" cy="14" r="2" fill="currentColor"/></svg>
                    {%- when 'midi' -%}<svg viewBox="0 0 20 20" aria-hidden="true"><rect x="3" y="4" width="14" height="12" rx="2" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M7.5 4v7M12.5 4v7M10 11v5M5 11v5M15 11v5" stroke="currentColor" stroke-width="1.4"/></svg>
                    {%- else -%}<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 8a5 5 0 0 1 9-2.5M15 12a5 5 0 0 1-9 2.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M14.5 2.5v3.3h-3.3M5.5 17.5v-3.3h3.3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {%- endcase -%}
                </span>
                <span class="spt__name"><span class="spt__title">{{ b.title | escape }}</span>{%- if b.file != blank -%}<span class="spt__file">{{ b.file | escape }}</span>{%- endif -%}</span>
                <span class="spt__meta"><span class="spt__bpm{% if b.bpm == blank %} is-empty{% endif %}">{% if b.bpm != blank %}{{ b.bpm | escape }}{% if s.bpm_suffix %} BPM{% endif %}{% else %}-{% endif %}</span>{%- if b.bpm != blank and b.key != blank -%}<span class="spt__dot" aria-hidden="true">·</span>{%- endif -%}<span class="spt__key{% if b.key == blank %} is-empty{% endif %}">{{ b.key | default: '-' | escape }}</span></span>
              {%- endcapture -%}
              <li class="spt__row" {{ block.shopify_attributes }}>
{%- liquid
  assign ssp_src = ssp_audio | strip
  if ssp_src != blank
    if ssp_src contains 'shopify://shop_images/'
      assign ssp_src = ssp_src | remove_first: 'shopify://shop_images/' | asset_url
    elsif ssp_src contains '/'
    else
      assign ssp_src = ssp_src | asset_url
    endif
  endif
  assign ssp_d = ''
  assign ssp_pk = ssp_peaks | strip | split: ','
  assign ssp_n = ssp_pk.size
  assign ssp_flat = false
  if ssp_n < 16
    assign ssp_n = 120
    assign ssp_flat = true
    for i in (1..120)
      assign ssp_x = i | minus: 0.5
      assign ssp_d = ssp_d | append: 'M' | append: ssp_x | append: ' 48.6V51.4'
    endfor
  else
    for ssp_v in ssp_pk
      assign ssp_hh = ssp_v | strip | plus: 0 | times: 0.46 | at_least: 1.4 | round: 1
      assign ssp_x = forloop.index | minus: 0.5
      assign ssp_y1 = 50 | minus: ssp_hh | round: 1
      assign ssp_y2 = 50 | plus: ssp_hh | round: 1
      assign ssp_d = ssp_d | append: 'M' | append: ssp_x | append: ' ' | append: ssp_y1 | append: 'V' | append: ssp_y2
    endfor
  endif
  assign ssp_label = ssp_title | default: 'track' | escape
  assign ssp_clock = '0:00'
  assign ssp_secs = ssp_len | plus: 0 | round
  if ssp_secs > 0
    assign ssp_m = ssp_secs | divided_by: 60
    assign ssp_s = ssp_secs | modulo: 60 | prepend: '0' | slice: -2, 2
    assign ssp_clock = ssp_m | append: ':' | append: ssp_s
  endif
-%}
<div class="ssp {{ ssp_class }}{% if ssp_src == blank %} ssp--off{% endif %}{% if ssp_flat %} ssp--flat{% endif %}{% if ssp_secs > 0 %} has-len{% endif %}" data-ssp{% if ssp_src != blank %} data-src="{{ ssp_src }}"{% endif %} data-title="{{ ssp_label }}"{% if ssp_secs > 0 %} data-len="{{ ssp_len | plus: 0 }}"{% endif %}{% unless ssp_flat %} data-peaks="{{ ssp_pk | join: ',' | strip | escape }}"{% endunless %}>
  {{ ssp_before }}
  <button class="ssp__btn" type="button" data-ssp-btn aria-label="Play {{ ssp_label }}"{% if ssp_src == blank %} disabled{% endif %}>
    <svg class="ssp__i ssp__i--play" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M4.6 2.9v10.2c0 .6.6.9 1.1.6l7.9-5.1c.5-.3.5-1 0-1.3L5.7 2.3c-.5-.3-1.1 0-1.1.6Z" fill="currentColor"/></svg>
    <svg class="ssp__i ssp__i--pause" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><rect x="3.8" y="2.8" width="3" height="10.4" rx="1" fill="currentColor"/><rect x="9.2" y="2.8" width="3" height="10.4" rx="1" fill="currentColor"/></svg>
  </button>
  <div class="ssp__row">
  <div class="ssp__wave" data-ssp-wave{% if ssp_src != blank %} role="slider" tabindex="0" aria-label="Seek in {{ ssp_label }}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-valuetext="0:00"{% endif %}>
    <svg class="ssp__svg" viewBox="0 0 {{ ssp_n }} 100" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path id="{{ ssp_id }}" d="{{ ssp_d }}" vector-effect="non-scaling-stroke"/></svg>
    <svg class="ssp__svg ssp__svg--hover" viewBox="0 0 {{ ssp_n }} 100" preserveAspectRatio="none" aria-hidden="true" focusable="false"><use href="#{{ ssp_id }}"/></svg>
    <svg class="ssp__svg ssp__svg--done" viewBox="0 0 {{ ssp_n }} 100" preserveAspectRatio="none" aria-hidden="true" focusable="false"><use href="#{{ ssp_id }}"/></svg>
    {%- if ssp_src != blank -%}<span class="ssp__head" aria-hidden="true"></span><span class="ssp__tip" aria-hidden="true" data-ssp-tip>0:00</span>{%- endif -%}
  </div>
  <span class="ssp__time" data-ssp-time>{% if ssp_src == blank %}No preview{% else %}{{ ssp_clock }}{% endif %}</span>
  </div>
  {{ ssp_after }}
</div>
              </li>
            {%- endfor -%}
          </ul>
        {%- else -%}
          <p class="spt__empty">Add a sound to this table. Each one takes an audio file, a name, the file's name, its BPM and its key.</p>
        {%- endif -%}
        {%- if s.note != blank -%}<div class="spt__note">{{ s.note }}</div>{%- endif -%}
      </div>
    </div>
  </div>
</div>
<script>
  /* The sample players (samples-audio-tracks, samples-pack-cards, samples-release-hero and the soundpacks sections): one copy runs, whichever section loads first, so one sound plays at a time across the page. */
  (function () {
    var V = 5;
    if (window.__ssp && window.__ssp.v >= V) { window.__ssp.scan(); return; }
    var current = null, N = 120, PITCH = 4, KEY = 'ssp-peaks:', reduce = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
    function fmt(t) { if (!isFinite(t) || t < 0) t = 0; var m = Math.floor(t / 60), s = Math.floor(t % 60); return m + ':' + (s < 10 ? '0' : '') + s; }
