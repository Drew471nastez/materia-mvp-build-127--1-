{%- comment -%}
  Coach creator: the free resource. A dark rounded panel: a picture on one
  side, on the other a label, a serif heading, a line, what is inside as a
  short checked list, and a first name, email and button on one line on a
  computer (stacked on a phone). Sign-ups reach Emails > Subscribers with
  the tag set below.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign points = st.points | newline_to_br | split: '<br />'
  assign hf = settings.font_heading_google_family
-%}
{%- if hf != blank and hf != 'none' -%}<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ hf | replace: ' ', '+' }}:ital@0;1&display=swap">{%- endif -%}
<style>
  #shopify-section-{{ sid }} .cpf { --cpf-accent: {{ st.accent_color | default: '#ff6a3d' }}; background: {{ st.background | default: '#fbf8f4' }}; padding: {{ st.padding_top_mobile | default: 24 }}px 12px {{ st.padding_bottom_mobile | default: 56 }}px; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .cpf { padding: {{ st.padding_top | default: 40 }}px 40px {{ st.padding_bottom | default: 96 }}px; } }
  #shopify-section-{{ sid }} .cpf__panel { max-width: 1180px; margin: 0 auto; display: grid; grid-template-columns: minmax(0, 1fr); overflow: hidden; border-radius: 26px; background: {{ st.panel_color | default: '#16120f' }}; color: {{ st.text_color | default: '#cfc6bc' }}; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .cpf__panel { grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); border-radius: 30px; } }
  #shopify-section-{{ sid }} .cpf__media { position: relative; margin: 0; min-height: 300px; aspect-ratio: 16 / 11; background: #2a231e; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .cpf__media { aspect-ratio: auto; min-height: 560px; } }
  #shopify-section-{{ sid }} .cpf__media img, #shopify-section-{{ sid }} .cpf__media svg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% {{ st.focus_y | default: 40 }}%; }
  #shopify-section-{{ sid }} .cpf__body { padding: 32px 22px 36px; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .cpf__body { padding: 72px 72px 72px 64px; align-self: center; } }
  #shopify-section-{{ sid }} .cpf__label { display: inline-flex; align-items: center; gap: 8px; margin: 0 0 18px; padding: 7px 12px; border-radius: 999px; background: color-mix(in srgb, var(--cpf-accent) 18%, transparent); color: var(--cpf-accent); font-size: 12px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
  #shopify-section-{{ sid }} .cpf__title { margin: 0 0 14px; color: {{ st.heading_color | default: '#ffffff' }}; font-family: var(--heading-font, serif); font-weight: 400; font-size: 38px; line-height: 1.02; letter-spacing: -.01em; text-wrap: balance; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .cpf__title { font-size: 56px; } }
  #shopify-section-{{ sid }} .cpf__title em { font-style: italic; color: var(--cpf-accent); }
  #shopify-section-{{ sid }} .cpf__text { font-size: 16.5px; line-height: 1.65; max-width: 34em; }
  #shopify-section-{{ sid }} .cpf__text p { margin: 0; }
  #shopify-section-{{ sid }} .cpf__points { display: grid; gap: 10px; margin: 22px 0 28px; padding: 0; list-style: none; }
  #shopify-section-{{ sid }} .cpf__points li { display: flex; gap: 12px; align-items: flex-start; color: {{ st.heading_color | default: '#ffffff' }}; font-size: 15.5px; line-height: 1.45; }
  #shopify-section-{{ sid }} .cpf__points svg { flex: 0 0 auto; width: 20px; height: 20px; margin-top: 1px; color: var(--cpf-accent); }
  #shopify-section-{{ sid }} .cpf__row { display: flex; flex-direction: column; gap: 10px; max-width: 620px; }
  @media (min-width: 750px) { #shopify-section-{{ sid }} .cpf__row { flex-direction: row; gap: 8px; } }
  #shopify-section-{{ sid }} .cpf__input { flex: 1 1 0; min-width: 0; height: 54px; margin: 0; padding: 0 18px; border: 1px solid rgba(255,255,255,.16); border-radius: 999px; background: rgba(255,255,255,.06); color: #fff; font: inherit; font-size: 15px; }
  #shopify-section-{{ sid }} .cpf__input::placeholder { color: rgba(255,255,255,.55); }
  #shopify-section-{{ sid }} .cpf__input:focus-visible { outline: 2px solid var(--cpf-accent); outline-offset: 1px; }
  #shopify-section-{{ sid }} .cpf__submit { flex: 0 0 auto; height: 54px; margin: 0; padding: 0 26px; border: 0; border-radius: 999px; background: var(--cpf-accent); color: {{ st.button_text_color | default: '#16120f' }}; font: inherit; font-size: 15.5px; font-weight: 600; white-space: nowrap; cursor: pointer; transition: transform .25s ease; }
  #shopify-section-{{ sid }} .cpf__submit:hover { transform: translateY(-1px); }
  #shopify-section-{{ sid }} .cpf__note { margin: 14px 0 0; font-size: 13px; color: {{ st.note_color | default: '#a39a90' }}; }
  #shopify-section-{{ sid }} .cpf__msg { margin: 12px 0 0; color: #fff; font-size: 14px; }
  #shopify-section-{{ sid }} .cpf__hp, #shopify-section-{{ sid }} .cpf__vh { position: absolute !important; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
</style>
<section class="cpf" id="{{ st.anchor | default: 'free-guide' | handleize }}">
  <div class="cpf__panel">
    <figure class="cpf__media">
      {%- if st.image != blank -%}
        <img src="{{ st.image | image_url: width: 880 }}" srcset="{{ st.image | image_url: width: 520 }} 520w, {{ st.image | image_url: width: 880 }} 880w" sizes="(min-width: 990px) 500px, 96vw" width="{{ st.image.width | default: 880 }}" height="{{ st.image.height | default: 1000 }}" alt="{{ st.image_alt | default: st.image.alt | escape }}" loading="lazy" decoding="async">
      {%- else -%}
        {{ 'image' | placeholder_svg_tag }}
      {%- endif -%}
    </figure>
    <div class="cpf__body">
      {%- if st.label != blank -%}<p class="cpf__label">{{ st.label | escape }}</p>{%- endif -%}
      {%- if st.heading != blank -%}<h2 class="cpf__title">{{ st.heading }}</h2>{%- endif -%}
      {%- if st.text != blank -%}<div class="cpf__text">{{ st.text }}</div>{%- endif -%}
      {%- if st.points != blank -%}
        <ul class="cpf__points">
          {%- for p in points -%}{%- assign line = p | strip -%}{%- if line != blank -%}<li><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="10" cy="10" r="8.5"/><path d="M6.5 10.2l2.4 2.4 4.6-5"/></svg>{{ line | escape }}</li>{%- endif -%}{%- endfor -%}
        </ul>
      {%- endif -%}
      {%- form 'customer', id: 'CoachproOptin-' | append: sid, data-storelib-form: 'subscribe' -%}
        <input type="hidden" name="contact[tags]" value="{{ st.tag | default: 'free-guide' | escape }}">
        <span hidden data-mt-words data-success-message="{{ st.success_text | default: 'Thank you. Check your inbox in a minute.' | escape }}" data-invalid-message="{{ st.invalid_text | default: 'Enter a valid email address.' | escape }}"></span>
        <div class="cpf__hp" aria-hidden="true" data-mt-trap>
          <label for="CoachproOptinHp-{{ sid }}">Leave this field empty</label>
          <input id="CoachproOptinHp-{{ sid }}" type="text" name="company" tabindex="-1" autocomplete="off" pattern="^$" maxlength="0" value="">
        </div>
        <div class="cpf__row">
          {%- if st.show_name -%}
            <label class="cpf__vh" for="CoachproOptinName-{{ sid }}">{{ st.name_placeholder | default: 'First name' | escape }}</label>
            <input class="cpf__input" id="CoachproOptinName-{{ sid }}" type="text" name="contact[first_name]" autocomplete="given-name" maxlength="80" placeholder="{{ st.name_placeholder | default: 'First name' | escape }}">
          {%- endif -%}
          <label class="cpf__vh" for="CoachproOptinEmail-{{ sid }}">{{ st.email_placeholder | default: 'Your email' | escape }}</label>
          <input class="cpf__input" id="CoachproOptinEmail-{{ sid }}" type="email" name="contact[email]" required inputmode="email" autocomplete="email" autocapitalize="off" spellcheck="false" maxlength="254" placeholder="{{ st.email_placeholder | default: 'Your email' | escape }}">
          <button type="submit" class="cpf__submit">{{ st.button_label | default: 'Send it to me' | escape }}</button>
        </div>
        {%- if form.posted_successfully? -%}<p class="cpf__msg form-status--success">{{ st.success_text | default: 'Thank you. Check your inbox in a minute.' | escape }}</p>{%- endif -%}
        {%- if form.errors -%}<p class="cpf__msg" role="alert">{{ st.invalid_text | default: 'Enter a valid email address.' | escape }}</p>{%- endif -%}
      {%- endform -%}
      {%- if st.note != blank -%}<p class="cpf__note">{{ st.note | escape }}</p>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Coach creator free resource",
  "tag": "section",
  "class": "coachpro-optin-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "anchor", "label": "Name for links to this place", "default": "free-guide", "info": "Link to /#free-guide to scroll here." },
    { "type": "image_picker", "id": "image", "label": "Picture" },
    { "type": "text", "id": "image_alt", "label": "Alt text" },
    { "type": "range", "id": "focus_y", "label": "Keep this height of the picture in view", "min": 0, "max": 100, "step": 2, "unit": "%", "default": 40 },
    { "type": "text", "id": "label", "label": "Label", "default": "Free guide" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "The free <em>starter guide</em>" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Say what it is and what someone can do after reading it.</p>" },
    { "type": "textarea", "id": "points", "label": "What is inside, one per line", "default": "A short video\nA printable worksheet\nOne email a week after" },
    { "type": "checkbox", "id": "show_name", "label": "Ask for a first name", "default": true },
    { "type": "text", "id": "name_placeholder", "label": "Name field", "default": "First name" },
    { "type": "text", "id": "email_placeholder", "label": "Email field", "default": "Your email" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Send it to me" },
    { "type": "text", "id": "tag", "label": "Tag for the people who sign up", "default": "free-guide" },
    { "type": "text", "id": "note", "label": "Small note", "default": "No spam. Unsubscribe in one click." },
    { "type": "text", "id": "success_text", "label": "Message after signing up", "default": "Thank you. Check your inbox in a minute." },
    { "type": "text", "id": "invalid_text", "label": "Message for an address that will not work", "default": "Enter a valid email address." },
    { "type": "header", "content": "Look" },
    { "type": "color", "id": "background", "label": "Background", "default": "#fbf8f4" },
    { "type": "color", "id": "panel_color", "label": "Panel", "default": "#16120f" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#ff6a3d" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#cfc6bc" },
    { "type": "color", "id": "note_color", "label": "Small note", "default": "#a39a90" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#16120f" },
    { "type": "range", "id": "padding_top", "label": "Space above on a computer", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Space below on a computer", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_top_mobile", "label": "Space above on a phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Space below on a phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "presets": [ { "name": "Coach creator free resource", "category": "Coach creator" } ]
}
{% endschema %}
