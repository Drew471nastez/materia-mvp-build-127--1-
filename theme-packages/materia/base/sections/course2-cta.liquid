{%- comment -%}
  Online course: the last call. A wide rounded panel in the accent colour
  with a heading, a line, the button straight to checkout (the course in
  "Course", the shop's first product when none is picked) and a short
  promise under it. A soft light rises from the bottom of the panel.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign sid = section.id
  assign p = s.product
  assign buy = s.button_link | default: '/collections/all'
  if s.to_checkout and p != blank and p.title != blank
    assign v = p.selected_or_first_available_variant
    if v.id != blank
      assign buy = '/cart/' | append: v.id | append: ':1'
    endif
  endif
-%}
<style>
  #shopify-section-{{ sid }} .c2x { background: {% if s.use_color_scheme and s.background == blank %}var(--color-background){% else %}{{ s.background | default: '#ffffff' }}{% endif %}; padding: {{ s.padding_top_mobile | default: 24 }}px 0 {{ s.padding_bottom_mobile | default: 24 }}px; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .c2x { padding: {{ s.padding_top | default: 48 }}px 0 {{ s.padding_bottom | default: 48 }}px; } }
  #shopify-section-{{ sid }} .c2x__in { max-width: 1200px; margin: 0 auto; padding: 0 20px; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .c2x__in { padding: 0 40px; } }
  #shopify-section-{{ sid }} .c2x__panel { position: relative; overflow: hidden; padding: 48px 22px; border-radius: 22px; background: {{ s.panel_color | default: '#12704f' }}; color: {% if s.use_color_scheme and s.text_color == blank %}var(--color-text){% else %}{{ s.text_color | default: '#d8ebe2' }}{% endif %}; text-align: center; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .c2x__panel { padding: 88px 40px; } }
  #shopify-section-{{ sid }} .c2x__panel::before { content: ""; position: absolute; left: 50%; bottom: -60%; width: 120%; height: 100%; transform: translateX(-50%); border-radius: 50%; background: radial-gradient(closest-side, rgba(255,255,255,.16), transparent); pointer-events: none; }
  #shopify-section-{{ sid }} .c2x__title { position: relative; margin: 0 auto 16px; max-width: 18em; color: {% if s.use_color_scheme and s.heading_color == blank %}var(--color-heading){% else %}{{ s.heading_color | default: '#ffffff' }}{% endif %}; font-family: var(--heading-font, inherit); font-weight: 700; font-size: 32px; line-height: 1.06; letter-spacing: -.035em; text-wrap: balance; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .c2x__title { font-size: {{ s.heading_size | default: 52 }}px; } }
  #shopify-section-{{ sid }} .c2x__text { position: relative; max-width: 36em; margin: 0 auto; font-size: 17px; line-height: 1.6; }
  #shopify-section-{{ sid }} .c2x__text p { margin: 0; }
  #shopify-section-{{ sid }} .c2x__btn { position: relative; display: inline-flex; align-items: center; justify-content: center; min-height: 56px; margin-top: 30px; padding: 0 34px; border-radius: 10px; background: {{ s.button_color | default: '#ffffff' }}; color: {{ s.button_text_color | default: '#12704f' }}; font-size: 16px; font-weight: 600; text-decoration: none; transition: transform .25s ease, box-shadow .25s ease; }
  #shopify-section-{{ sid }} .c2x__btn:hover { transform: translateY(-1px); box-shadow: 0 10px 30px -12px rgba(0,0,0,.35); }
  #shopify-section-{{ sid }} .c2x__note { position: relative; margin: 16px 0 0; font-size: 14px; }
  #shopify-section-{{ sid }} [data-c2r].c2r-wait { opacity: 0; transform: translate3d(0, 22px, 0); }
  #shopify-section-{{ sid }} [data-c2r].c2r-in { opacity: 1; transform: none; transition: opacity .8s cubic-bezier(.2,.65,.25,1) var(--d, 0ms), transform .8s cubic-bezier(.2,.65,.25,1) var(--d, 0ms); }
  @media (prefers-reduced-motion: reduce) { #shopify-section-{{ sid }} .c2x__btn { transition: none; } }
</style>
<section class="c2x{% if s.use_color_scheme %} color-{{ s.color_scheme.id | default: s.color_scheme | default: 'default' }}{% endif %}">{% render 'bg-picture', image: s.background_image, overlay: s.overlay_color, opacity: s.overlay_opacity %}
  <div class="c2x__in">
    <div class="c2x__panel" data-c2r>
      <h2 class="c2x__title">{{ s.heading | escape }}</h2>
      {%- if s.text != blank -%}<div class="c2x__text">{{ s.text }}</div>{%- endif -%}
      {%- if s.button_label != blank -%}<a class="c2x__btn" href="{{ buy }}">{{ s.button_label | escape }}</a>{%- endif -%}
      {%- if s.note != blank -%}<p class="c2x__note">{{ s.note | escape }}</p>{%- endif -%}
    </div>
  </div>
</section>
{%- unless request.design_mode -%}
<script>(function(){var r=document.getElementById('shopify-section-{{ sid }}');if(!r||!('IntersectionObserver' in window)||matchMedia('(prefers-reduced-motion: reduce)').matches)return;var h=innerHeight,io=new IntersectionObserver(function(es){es.forEach(function(e){if(!e.isIntersecting)return;var t=e.target;io.unobserve(t);requestAnimationFrame(function(){t.classList.add('c2r-in')})})},{rootMargin:'0px 0px -6% 0px'});r.querySelectorAll('[data-c2r]').forEach(function(el){if(el.getBoundingClientRect().top<h*.92)return;el.classList.add('c2r-wait');io.observe(el)})})();</script>
{%- endunless -%}

{% schema %}
{
  "name": "Course last call",
  "tag": "section",
  "class": "course2-cta-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "checkbox", "id": "use_color_scheme", "label": "Use a colour scheme", "default": false, "info": "Background, heading, text and line colours left empty below follow the scheme." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default", "visible_if": "{{ section.settings.use_color_scheme }}" },
    { "type": "header", "content": "Background picture" },
    { "type": "image_picker", "id": "background_image", "label": "Background picture" },
    { "type": "color", "id": "overlay_color", "label": "Overlay on the picture", "default": "#000000", "visible_if": "{{ section.settings.background_image != blank }}" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay strength", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 50, "visible_if": "{{ section.settings.background_image != blank }}" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Start with the first lesson tonight" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Say what someone gets and what it costs, in one line.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Buy the course" },
    { "type": "product", "id": "product", "label": "Course", "info": "The button goes straight to checkout with this product. Your first product when none is picked." },
    { "type": "checkbox", "id": "to_checkout", "label": "Button goes straight to checkout", "default": true },
    { "type": "url", "id": "button_link", "label": "Link when there is no product" },
    { "type": "text", "id": "note", "label": "Line under the button", "default": "30 day refund. Lifetime access." },
    { "type": "range", "id": "heading_size", "label": "Heading size on desktop", "min": 28, "max": 72, "step": 2, "unit": "px", "default": 52 },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "background", "label": "Background around the panel", "default": "#ffffff" },
    { "type": "color", "id": "panel_color", "label": "Panel", "default": "#12704f" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#d8ebe2" },
    { "type": "color", "id": "button_color", "label": "Button", "default": "#ffffff" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#12704f" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Space above on desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Space below on desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_top_mobile", "label": "Space above on phones", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Space below on phones", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24 }
  ],
  "presets": [ { "name": "Course last call", "category": "Online course" } ]
}
{% endschema %}
