            this.f('cart').hidden = false;
            clearTimeout(this._added); this._added = setTimeout(() => this.paint(), 2400);
          } else this.close();
        }
        catch (e) { msg.textContent = e.message || {{ 'sections.cart.cart_error' | t | json }}; }
        finally { atc.removeAttribute('aria-busy'); }
      }
    });
  }
