{% render 'theme-type' %}
{%- comment -%}
  Materia Themes. Boutique Rail: garments hang on a clothes rail. Hovering a
  garment turns it to face the shopper while its neighbours slide aside and
  its hanger swings; clicking lifts it into a focus view with front and back,
  sizes and Add to cart (the theme's cart drawer). Phones swipe the rail.

  What hangs: the products of Collection (and Collection 2, as a second tab
  named after it). A Garment block whose product is on the rail gives that
  product its own side / front / back pictures; a Garment block whose product
  is in neither collection hangs after the first collection's products. With
  no collection the rail is the Garment blocks, as they are ordered.

  Pictures: transparent PNG / WebP of each garment on a hanger. Product photos
  with a background hang as tidy cards instead (Product pictures setting).
  Every picture is asked for at the size it is shown. No app, no external script.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign color_scheme = st.color_scheme.id | default: st.color_scheme | default: 'default'
  assign g_h = st.garment_height | default: 300
  assign g_hm = st.garment_height_mobile | default: 230
  # Display sizes: a side view is about 0.42 of the garment height wide, a front
  # view about 0.86; pictures are asked for at twice that, for sharp screens.
  assign side_w = g_h | times: 0.84 | ceil
  assign front_w = g_h | times: 1.72 | ceil
  # image_tag wants its widths as text ("126,252"): the display size and twice it.
  assign side_half = side_w | divided_by: 2
  assign front_half = front_w | divided_by: 2
  assign side_ws = side_half | append: ',' | append: side_w
  assign front_ws = front_half | append: ',' | append: front_w
  assign side_sz = side_half | append: 'px'
  assign front_sz = front_half | append: 'px'
  assign focus_w = 1200

  assign garments = section.blocks | where: 'type', 'garment'

  # Tabs: one per chosen collection (Collection first). No collection: one rail of Garment blocks.
  assign col_1 = ''
  assign col_2 = ''
  assign label_1 = ''
  assign label_2 = ''
  assign bg_1 = ''
  assign bg_2 = ''
  if st.collection != blank
    assign col_1 = st.collection
    assign label_1 = st.collection.title
    assign bg_1 = st.collection_image
    if st.collection_2 != blank
      assign col_2 = st.collection_2
      assign label_2 = st.collection_2.title
      assign bg_2 = st.collection_2_image
    endif
  elsif st.collection_2 != blank
    assign col_1 = st.collection_2
    assign label_1 = st.collection_2.title
    assign bg_1 = st.collection_2_image
  endif
  # Storelib: a plain-text eyebrow cannot switch tabs, so only the first collection hangs.
  if st.eyebrow_clickable == false
    assign col_2 = ''
  endif
  if col_2 != blank and st.tab_names == 'eyebrow'
    if st.eyebrow != blank
      assign label_1 = st.eyebrow
    endif
    if st.eyebrow_secondary != blank
      assign label_2 = st.eyebrow_secondary
    endif
  endif
  assign tab_count = 0
  assign list_1 = empty
  assign list_2 = empty
  if col_1 != blank
    assign tab_count = 1
    assign list_1 = col_1.products | slice: 0, st.products_limit
  endif
  if col_2 != blank
    assign tab_count = 2
    assign list_2 = col_2.products | slice: 0, st.products_limit
  endif
  assign track_count = tab_count | at_least: 1

  assign section_bg = ''
  if st.style == 'image' and st.background_image != blank
    assign section_bg = st.background_image
  endif
  assign ph_names = st.sample_names | split: ','
  # Storelib: the eyebrow's links (each part, or the collection's page)
  assign eb_link_1 = st.eyebrow_link
  if eb_link_1 == blank and col_1 != blank
    assign eb_link_1 = col_1.url
  endif
  assign eb_link_2 = st.eyebrow_secondary_link
  assign show_hooks = true
  if st.show_hooks == false
    assign show_hooks = false
  endif
-%}
<style>
  #shopify-section-{{ sid }} .brail *, #shopify-section-{{ sid }} .brail *::before, #shopify-section-{{ sid }} .brail *::after { box-sizing: border-box; }
  #shopify-section-{{ sid }} .brail {
    --g-h: {{ g_hm }}px;
    --gap: {{ st.garment_gap_mobile | default: 6 }}px;
    --side-gap: {{ st.hover_side_gap }}px;
    --turn: {{ st.turn_speed }}ms;
    --swing: {{ st.hanger_swing }}deg;
    --side-box: calc(var(--g-h) * 0.42);
    --front-box: calc(var(--g-h) * 0.86);
    --shift: calc((var(--front-box) - var(--side-box)) / 2 + var(--side-gap));
    --ease: cubic-bezier(.22, 1, .36, 1);
    --line: var(--color-border, color-mix(in srgb, var(--color-text) 14%, transparent));
    /* A custom element is inline by default, and an inline box ignores top and
       bottom padding for its content: block, so the padding settings apply. */
    display: block;
    position: relative;
    overflow: hidden;
    background: var(--color-background);
    color: var(--color-text);
    padding-block: {{ st.padding_top_mobile }}px {{ st.padding_bottom_mobile }}px;
    {%- if st.full_height %} min-height: calc(100svh - var(--header-offset, 0px)); display: flex; flex-direction: column; justify-content: center;{% endif %}
  }
  @media (min-width: 990px) {
    #shopify-section-{{ sid }} .brail { --g-h: {{ g_h }}px; --gap: {{ st.garment_gap }}px; padding-block: {{ st.padding_top }}px {{ st.padding_bottom }}px; }
  }
  {%- case st.section_spacing -%}
    {%- when 'none' %} #shopify-section-{{ sid }} .brail { margin-block: 0; }
    {%- when 'top' %} #shopify-section-{{ sid }} .brail { margin-block: var(--section-spacing) 0; }
    {%- when 'bottom' %} #shopify-section-{{ sid }} .brail { margin-block: 0 var(--section-spacing); }
    {%- else %} #shopify-section-{{ sid }} .brail { margin-block: var(--section-spacing); }
  {%- endcase %}

  /* Background pictures: the section's, and one per collection tab (cross-fade on switch) */
  #shopify-section-{{ sid }} .brail__bg { position: absolute; inset: 0; z-index: 0; opacity: 0; transition: opacity .6s ease; }
  #shopify-section-{{ sid }} .brail__bg.is-on { opacity: 1; }
  #shopify-section-{{ sid }} .brail__bg img { width: 100%; height: 100%; object-fit: cover; display: block; }
  #shopify-section-{{ sid }} .brail__bg::after { content: ''; position: absolute; inset: 0; background: rgb(0 0 0 / {{ st.overlay_opacity }}%); }
  #shopify-section-{{ sid }} .brail__inner { position: relative; z-index: 1; }

  /* Heading: eyebrow, or the collections as tabs */
  #shopify-section-{{ sid }} .brail__head { text-align: center; padding-inline: 20px; margin-bottom: clamp(18px, 3vw, 36px); }
  #shopify-section-{{ sid }} .brail__eyebrow { display: inline-flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 8px 12px; margin: 0; font-size: 11px; font-weight: 600; letter-spacing: .18em; text-transform: uppercase; color: var(--color-heading); }
  #shopify-section-{{ sid }} .brail__eyebrow > span + span { padding-left: 12px; border-left: 1px solid var(--line); opacity: .55; }
  #shopify-section-{{ sid }} .brail__tabs { display: inline-flex; flex-wrap: wrap; justify-content: center; align-items: center; margin: 0; padding: 0; }
  #shopify-section-{{ sid }} .brail__tab {
    position: relative; padding: 8px 14px; border: 0; background: none; cursor: pointer; color: var(--color-heading);
    font: inherit; font-size: 11px; font-weight: 600; letter-spacing: .18em; text-transform: uppercase; opacity: .5; transition: opacity .25s ease;
  }
  #shopify-section-{{ sid }} .brail__tab + .brail__tab::before { content: ''; position: absolute; left: 0; top: 30%; bottom: 30%; width: 1px; background: currentColor; opacity: .35; }
  #shopify-section-{{ sid }} .brail__tab::after { content: ''; position: absolute; left: 14px; right: 14px; bottom: 2px; height: 1px; background: currentColor; scale: 0 1; transition: scale .4s var(--ease); }
  #shopify-section-{{ sid }} .brail__tab[aria-pressed='true'] { opacity: 1; }
  #shopify-section-{{ sid }} .brail__tab[aria-pressed='true']::after { scale: 1 1; }
  @media (hover: hover) { #shopify-section-{{ sid }} .brail__tab:hover { opacity: .85; } }
  #shopify-section-{{ sid }} .brail__heading { margin: 14px 0 0; color: var(--color-heading); letter-spacing: -0.02em; text-wrap: balance; }

  /* The rail */
  #shopify-section-{{ sid }} .brail__stage { position: relative; }
  #shopify-section-{{ sid }} .brail__bar { position: absolute; left: 0; right: 0; top: 14px; height: 6px; border-radius: 3px; z-index: 0; pointer-events: none;
    background: linear-gradient(180deg, #e9e9e9 0%, #b9b9b9 45%, #8d8d8d 100%); box-shadow: 0 2px 4px rgb(0 0 0 / .12); }
  #shopify-section-{{ sid }} .brail__bar::before, #shopify-section-{{ sid }} .brail__bar::after { content: ''; position: absolute; top: -5px; width: 16px; height: 16px; border-radius: 3px; background: linear-gradient(180deg, #ddd, #9a9a9a); }
  #shopify-section-{{ sid }} .brail__bar::before { left: 0; } #shopify-section-{{ sid }} .brail__bar::after { right: 0; }
  #shopify-section-{{ sid }} .brail__track {
    position: relative; z-index: 1;
    display: flex; align-items: flex-start; gap: var(--gap);
    list-style: none; margin: 0; padding: 0 max(20px, calc((100% - var(--rail-w, 100%)) / 2)) 24px;
    overflow-x: auto; overflow-y: hidden; scroll-snap-type: x mandatory; scrollbar-width: none; -webkit-overflow-scrolling: touch;
    overscroll-behavior-x: contain;
  }
  #shopify-section-{{ sid }} .brail__track[hidden] { display: none; }
  #shopify-section-{{ sid }} .brail__track::-webkit-scrollbar { display: none; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .brail__track { justify-content: safe center; scroll-snap-type: none; padding-inline: 40px; } }
  #shopify-section-{{ sid }} .brail__item { flex: 0 0 var(--side-box); scroll-snap-align: center; transition: transform var(--turn) var(--ease); }

  #shopify-section-{{ sid }} .brail__g {
    position: relative; display: block; width: var(--side-box); height: calc(var(--g-h) + 34px);
    padding: 0; border: 0; background: none; cursor: pointer; color: inherit; font: inherit;
    transform-origin: 50% 14px; -webkit-tap-highlight-color: transparent; outline: none;
  }
  /* Storelib (r67): the keyboard ring hugs the garment's own place on the rail, not the wider box its front view turns into. */
  #shopify-section-{{ sid }} .brail__g:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; border-radius: 6px; }
  #shopify-section-{{ sid }} .brail__hook { position: absolute; top: 4px; left: 50%; width: 22px; height: 30px; translate: -50% 0; color: #8c8c8c; }
  #shopify-section-{{ sid }} .brail__tag {
    position: absolute; top: 30px; left: 50%; z-index: 3; translate: calc(-50% + 10px) 0; rotate: -4deg;
    padding: 3px 6px; border-radius: 3px; background: #fff; color: #111; box-shadow: 0 1px 3px rgb(0 0 0 / .18);
    font-size: 10px; font-weight: 700; line-height: 1.2; white-space: nowrap; font-variant-numeric: tabular-nums;
  }
  #shopify-section-{{ sid }} .brail__pic { position: absolute; left: 50%; top: 26px; width: var(--front-box); height: var(--g-h); translate: -50% 0; pointer-events: none; perspective: 900px; }
  #shopify-section-{{ sid }} .brail__pic img, #shopify-section-{{ sid }} .brail__pic svg {
    position: absolute; inset: 0; margin: auto; width: 100%; height: 100%; object-fit: contain; object-position: 50% 0;
    backface-visibility: hidden; transition: transform var(--turn) var(--ease), opacity calc(var(--turn) * .4) ease;
    filter: drop-shadow(0 10px 12px rgb(0 0 0 / .14));
  }
  #shopify-section-{{ sid }} .brail__g--sample { cursor: default; }
  #shopify-section-{{ sid }} .brail__side { transform: rotateY(0deg); }
  /* Storelib (r67): a shorter turn (50 degrees each side, with the two views swapping quickly) instead of a full quarter turn,
     where both views showed half turned and see-through at once and the garment looked grey mid-turn. */
  #shopify-section-{{ sid }} .brail__front { transform: rotateY(-50deg); opacity: 0; }
  /* Product photos with a background hang as tidy cards: a narrow crop on the rail, the whole picture when it turns. */
  #shopify-section-{{ sid }} .brail__pic--card img { inset: 4px 0 auto; margin: 0 auto; object-position: 50% 50%; border-radius: 6px; background: #fff; filter: none; box-shadow: 0 14px 26px -14px rgb(0 0 0 / .45), 0 0 0 1px rgb(0 0 0 / .04); }
  #shopify-section-{{ sid }} .brail__pic--card .brail__side { width: calc(var(--side-box) * .94); height: calc(var(--side-box) * 1.38); object-fit: cover; }
  #shopify-section-{{ sid }} .brail__pic--card .brail__front { width: calc(var(--front-box) * .9); height: min(var(--g-h), calc(var(--front-box) * 1.12)); object-fit: contain; padding: 6px; }

  /* Hover (and keyboard focus): the garment turns to face you, its neighbours slide aside, the hanger swings. */
  @media (hover: hover) and (pointer: fine) {
    #shopify-section-{{ sid }} .brail__item.is-hot .brail__side { transform: rotateY(50deg); opacity: 0; }
    #shopify-section-{{ sid }} .brail__item.is-hot .brail__front { transform: rotateY(0deg); opacity: 1; }
    #shopify-section-{{ sid }} .brail__item.is-hot { z-index: 2; position: relative; }
    #shopify-section-{{ sid }} .brail__track:has(.is-hot) .brail__item:has(~ .is-hot) { transform: translateX(calc(-1 * var(--shift))); }
    #shopify-section-{{ sid }} .brail__item.is-hot ~ .brail__item { transform: translateX(var(--shift)); }
    #shopify-section-{{ sid }} .brail__item.is-hot .brail__tag { translate: calc(-50% + var(--front-box) * .28) 0; transition: translate var(--turn) var(--ease); }
    #shopify-section-{{ sid }} .brail__item.is-hot .brail__pic { translate: -50% -6px; }
  }
  #shopify-section-{{ sid }} .brail__tag { transition: translate var(--turn) var(--ease); }
  /* The swing itself is a small damped pendulum run in script (see push()): only the garment pointed at swings, once. */
  #shopify-section-{{ sid }} .brail__pic { transition: translate var(--turn) cubic-bezier(.22, 1, .36, 1); }

  /* Garments settle onto the rail once, when it first comes into view: a short fall with no bounce.
     Storelib (r67): switching Fleece and Jersey no longer replays it; the rail cross-fades (switchTo). */
  #shopify-section-{{ sid }} [data-drop] .brail__g { opacity: 0; transform: translateY(-14px); }
  #shopify-section-{{ sid }} [data-drop].is-in .brail__g { opacity: 1; transform: none; transition: opacity .4s ease-out, transform .5s var(--ease); transition-delay: calc(min(var(--i, 0), 8) * 30ms); }
  #shopify-section-{{ sid }} [data-drop].is-in.is-dropped .brail__g { transition-delay: 0s; }

  /* Arrows (desktop, when the rail is wider than the screen) */
  #shopify-section-{{ sid }} .brail__arrow { position: absolute; top: calc(26px + var(--g-h) / 2); z-index: 4; translate: 0 -50%; display: none; place-items: center; width: 46px; height: 46px; border-radius: 50%; border: 0; background: color-mix(in srgb, var(--color-background) 85%, transparent); color: var(--color-heading); box-shadow: 0 4px 18px rgb(0 0 0 / .12); cursor: pointer; transition: opacity .25s ease, transform .25s ease; }
  #shopify-section-{{ sid }} .brail__arrow--prev { left: 16px; } #shopify-section-{{ sid }} .brail__arrow--next { right: 16px; }
  #shopify-section-{{ sid }} .brail__arrow[disabled] { opacity: 0; pointer-events: none; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} [data-overflow] .brail__arrow { display: grid; } }

  /* Caption, dots, button */
  #shopify-section-{{ sid }} .brail__foot { display: flex; flex-direction: column; align-items: center; gap: 16px; padding: 8px 20px 0; text-align: center; }
  /* Storelib: the caption and the hovered garment's name share one cell. The cell is as tall as the caption
     (two lines at most) and the name is one line, so hovering never changes the height of anything: the
     button, the section and its background stay exactly where they are. The two cross-fade. */
  #shopify-section-{{ sid }} .brail__lines { display: grid; width: 100%; max-width: 52ch; min-height: 1.5em; line-height: 1.5; font-size: 15px; font-weight: 500; color: var(--color-heading); }
  #shopify-section-{{ sid }} .brail__lines > * { grid-area: 1 / 1; align-self: center; margin: 0; transition: opacity .28s ease, transform .36s var(--ease); }
  #shopify-section-{{ sid }} .brail__caption { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
  #shopify-section-{{ sid }} .brail__caption:empty { display: block; }
  #shopify-section-{{ sid }} .brail__name { min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; opacity: 0; transform: translateY(5px); }
  #shopify-section-{{ sid }} .brail__name small { margin-left: 8px; font-size: inherit; font-weight: 400; opacity: .65; }
  #shopify-section-{{ sid }} .brail.is-naming .brail__name { opacity: 1; transform: none; }
  #shopify-section-{{ sid }} .brail.is-naming .brail__caption { opacity: 0; transform: translateY(-5px); }
  #shopify-section-{{ sid }} .brail__lines--empty { min-height: 1.5em; }
  /* Storelib: the eyebrow's parts as links */
  #shopify-section-{{ sid }} .brail__eyebrow a { color: inherit; text-decoration: none; background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat; padding-bottom: 2px; transition: background-size .35s var(--ease), opacity .2s ease; }
  @media (hover: hover) { #shopify-section-{{ sid }} .brail__eyebrow a:hover { background-size: 100% 1px; } }
  #shopify-section-{{ sid }} .brail__eyebrow a:focus-visible, #shopify-section-{{ sid }} .brail__tab:focus-visible { outline: 1px solid currentColor; outline-offset: 3px; border-radius: 2px; }
  /* Storelib: pictures that show their own hanger hang from the bar, with no hook drawn */
  #shopify-section-{{ sid }} .brail--no-hooks .brail__hook { display: none; }
  #shopify-section-{{ sid }} .brail--no-hooks .brail__pic { top: 12px; }
  #shopify-section-{{ sid }} .brail--no-hooks .brail__tag { top: 22px; }
  /* Storelib: a garment's own size on the rail (Garment block > Size on the rail) */
  #shopify-section-{{ sid }} .brail__pic { height: calc(var(--g-h) * var(--k, 1)); }
  /* Storelib: a garment that has just come back from the focus view lands facing you, then turns to its side */
  #shopify-section-{{ sid }} .brail__item.is-facing .brail__side { transform: rotateY(50deg); opacity: 0; }
  #shopify-section-{{ sid }} .brail__item.is-facing .brail__front { transform: rotateY(0deg); opacity: 1; }
  /* Storelib: the garment in the focus view leaves its hanger empty while it is there */
  #shopify-section-{{ sid }} .brail__item.is-lifted .brail__pic { visibility: hidden; }
  /* Storelib (r67): a garment put into its facing pose while hidden takes it at once, so it lands exactly as the copy that flew back */
  #shopify-section-{{ sid }} .brail__item.is-snap .brail__pic, #shopify-section-{{ sid }} .brail__item.is-snap .brail__pic img { transition: none !important; }
  #shopify-section-{{ sid }} .brail__dots { display: inline-flex; gap: 5px; padding: 6px 10px; border-radius: 99px; background: color-mix(in srgb, var(--color-text) 6%, transparent); }
  #shopify-section-{{ sid }} .brail__dots:empty { display: none; }
  #shopify-section-{{ sid }} .brail__dot { width: 5px; height: 5px; border-radius: 99px; background: color-mix(in srgb, var(--color-text) 25%, transparent); transition: width .3s var(--ease), background-color .3s ease; }
  #shopify-section-{{ sid }} .brail__dot.is-on { width: 22px; background: var(--color-heading); }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .brail__dots { display: none; } }
  @media (max-width: 989px) {
    #shopify-section-{{ sid }} .brail__head { margin-bottom: 14px; }
    #shopify-section-{{ sid }} .brail__tab { padding: 8px 10px; letter-spacing: .14em; }
    #shopify-section-{{ sid }} .brail__tab::after { left: 10px; right: 10px; }
    #shopify-section-{{ sid }} .brail__caption { font-size: 14px; }
  }

  /* Focus view */
  /* Storelib (round 28): the focus view wears a colour scheme (Focus view > Colour scheme, or the section's),
     so its background, words, links, pills, quantity and buttons (with their hover states) are the theme's,
     set in Theme settings. The two colour pickers still override the background and the words.
     Its background is its own layer, so it can fade while the garment flies from its hanger. It opens in
     about a third of a second and closes in about a fifth: transform and opacity only, nothing waits.
     The picture area is neutral (no border, shadow, line or tint), so any product photo sits in it cleanly,
     and a product with several pictures swipes like the theme's product gallery, with dots and arrows.
     It scrolls on a small screen, with no scroll bar showing. */
  #shopify-section-{{ sid }} .brail__focus { position: fixed; inset: 0; z-index: 60; width: 100%; height: 100%; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; outline: 0; background: transparent; color: var(--color-text); overflow-x: hidden; overflow-y: auto; overscroll-behavior: contain; scrollbar-width: none; -ms-overflow-style: none; }
  #shopify-section-{{ sid }} .brail__focus::-webkit-scrollbar { display: none; width: 0; height: 0; }
  #shopify-section-{{ sid }} .brail__focus::backdrop { background: transparent; }
  #shopify-section-{{ sid }} .bf__bg { position: fixed; inset: 0; z-index: 0; background: var(--color-background); pointer-events: none; }
  #shopify-section-{{ sid }} .brail__focus[data-glass] .bf__bg { background: color-mix(in srgb, var(--color-background) var(--bf-glass, 82%), transparent); -webkit-backdrop-filter: blur(24px) saturate(1.1); backdrop-filter: blur(24px) saturate(1.1); }
  #shopify-section-{{ sid }} .brail__focus.is-closing { pointer-events: none; }
  #shopify-section-{{ sid }} .bf__fly { position: fixed; left: 0; top: 0; z-index: 3; margin: 0; border: 0; pointer-events: none; transform-origin: 0 0; will-change: transform, opacity; object-fit: contain; }
  #shopify-section-{{ sid }} .bf__media.is-flying .bf__slide:first-child img { visibility: hidden; }
  #shopify-section-{{ sid }} .bf__ghost { position: absolute; inset: 0; z-index: 1; width: 100%; height: 100%; object-fit: contain; pointer-events: none; }
  #shopify-section-{{ sid }} .bf { position: relative; z-index: 1; min-height: 100%; display: grid; grid-template-columns: 1fr; align-items: center; gap: 24px; padding: 64px 20px calc(28px + env(safe-area-inset-bottom, 0px)); }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .bf { grid-template-columns: minmax(0, 1.25fr) minmax(320px, 420px); gap: clamp(32px, 6vw, 110px); padding: 56px clamp(32px, 7vw, 120px); } }

  /* The pictures: a row that scrolls sideways and snaps, one picture at a time (a swipe on a phone, the arrows,
     the dots or a trackpad on a computer). No frame of its own: whatever the photo's background is, it shows as it is. */
  #shopify-section-{{ sid }} .bf__media { position: relative; height: min(70svh, 720px); min-width: 0; border: 0; outline: 0; background: none; box-shadow: none; }
  @media (max-width: 989px) { #shopify-section-{{ sid }} .bf__media { height: 50svh; margin-inline: -20px; } }
  #shopify-section-{{ sid }} .bf__slides { display: flex; height: 100%; overflow-x: auto; overflow-y: hidden; scroll-snap-type: x mandatory; scroll-behavior: auto; overscroll-behavior-x: contain; scrollbar-width: none; -webkit-overflow-scrolling: touch; outline: 0; }
  #shopify-section-{{ sid }} .bf__slides::-webkit-scrollbar { display: none; }
  #shopify-section-{{ sid }} .bf__slide { position: relative; flex: 0 0 100%; height: 100%; scroll-snap-align: center; scroll-snap-stop: always; margin: 0; }
  #shopify-section-{{ sid }} .bf__slide img { display: block; width: 100%; height: 100%; object-fit: contain; object-position: 50% 50%; border: 0; border-radius: var(--bf-media-r, 0); box-shadow: none; filter: none; background: none; -webkit-user-drag: none; user-select: none; }
  #shopify-section-{{ sid }} .bf__media--cut .bf__slide:first-child img { object-position: 50% 0; }
  #shopify-section-{{ sid }} .bf__inav { position: absolute; top: 50%; z-index: 2; display: grid; place-items: center; width: 40px; height: 40px; margin-top: -20px; padding: 0; border: max(1px, var(--btn-border-width, 1px)) solid var(--color-border); border-radius: 50%; background: var(--color-background); color: var(--color-heading); cursor: pointer; opacity: 0; transition: opacity .2s ease, border-color .2s ease, background-color .2s ease, color .2s ease; }
  #shopify-section-{{ sid }} .bf__inav--prev { left: 8px; } #shopify-section-{{ sid }} .bf__inav--next { right: 8px; }
  #shopify-section-{{ sid }} .bf__inav[hidden] { display: none; }
  #shopify-section-{{ sid }} .bf__inav:disabled { opacity: 0 !important; pointer-events: none; }
  @media (hover: hover) {
    #shopify-section-{{ sid }} .bf__media:hover .bf__inav, #shopify-section-{{ sid }} .bf__inav:focus-visible { opacity: 1; }
    #shopify-section-{{ sid }} .bf__inav:hover { border-color: var(--color-heading); background: var(--color-heading); color: var(--color-background); }
  }
  #shopify-section-{{ sid }} .bf__dots { position: absolute; left: 50%; bottom: 4px; z-index: 2; translate: -50% 0; display: flex; gap: 6px; margin: 0; padding: 6px 8px; }
  #shopify-section-{{ sid }} .bf__dots[hidden] { display: none; }
  #shopify-section-{{ sid }} .bf__dot { width: 6px; height: 6px; padding: 0; border: 0; border-radius: 99px; background: color-mix(in srgb, var(--color-heading) 25%, transparent); cursor: pointer; transition: width .3s var(--ease), background-color .25s ease; }
  #shopify-section-{{ sid }} .bf__dot[aria-current='true'] { width: 20px; background: var(--color-heading); }
  #shopify-section-{{ sid }} .bf__dot::before { content: ''; position: absolute; inset: -10px -4px; }
  #shopify-section-{{ sid }} .bf__dot { position: relative; }

  #shopify-section-{{ sid }} .bf__info { display: flex; flex-direction: column; gap: 14px; max-width: 420px; width: 100%; justify-self: center; }
  #shopify-section-{{ sid }} .bf__count { font-size: 11px; letter-spacing: .14em; opacity: .55; font-variant-numeric: tabular-nums; }
  #shopify-section-{{ sid }} .bf__title { margin: 0; font-size: clamp(22px, 2.4vw, 30px); line-height: 1.15; color: var(--color-heading); }
  #shopify-section-{{ sid }} .bf__price { display: flex; gap: 10px; align-items: baseline; margin: 0; font-size: 16px; font-weight: 600; color: var(--color-heading); }
  #shopify-section-{{ sid }} .bf__price s { font-weight: 400; opacity: .55; font-size: 14px; }
  #shopify-section-{{ sid }} .bf__opt { border: 0; margin: 0; padding: 0; min-width: 0; display: flex; flex-direction: column; gap: 8px; }
  #shopify-section-{{ sid }} .bf__opt legend { padding: 0; font-size: 11px; letter-spacing: .12em; text-transform: uppercase; opacity: .65; margin-bottom: 8px; }
  #shopify-section-{{ sid }} .bf__vals { display: flex; flex-wrap: wrap; gap: 8px; }
  /* Pills: the theme's button corners and border width; the chosen one is the scheme's primary button. */
  #shopify-section-{{ sid }} .bf__val { min-width: 44px; height: 44px; padding: 0 14px; border-radius: var(--pill-radius, var(--btn-radius, 99px)); border: max(1px, var(--btn-border-width, 1px)) solid var(--color-border); background: transparent; color: var(--color-heading); font: inherit; font-size: 13px; cursor: pointer; transition: background-color .2s ease, color .2s ease, border-color .2s ease; }
  @media (hover: hover) { #shopify-section-{{ sid }} .bf__val:hover { border-color: var(--color-heading); } }
  #shopify-section-{{ sid }} .bf__val[aria-pressed='true'] { background: var(--btn-primary-bg-color, var(--color-heading)); border-color: var(--btn-primary-bg-color, var(--color-heading)); color: var(--btn-primary-color, var(--color-background)); }
  #shopify-section-{{ sid }} .bf__val.is-off { opacity: .4; text-decoration: line-through; }
  #shopify-section-{{ sid }} .bf__val:focus-visible, #shopify-section-{{ sid }} .bf__dot:focus-visible, #shopify-section-{{ sid }} .bf__close:focus-visible, #shopify-section-{{ sid }} .bf__nav:focus-visible, #shopify-section-{{ sid }} .bf__inav:focus-visible, #shopify-section-{{ sid }} .bf__plus:focus-visible { outline: 2px solid color-mix(in srgb, var(--color-heading) 55%, transparent); outline-offset: 2px; }
  /* Quantity and Add to cart on one row: the theme's quantity box (its colours, border and corners from Theme settings) and the theme's primary button. */
  #shopify-section-{{ sid }} .bf__buy { display: flex; gap: 10px; align-items: stretch; }
  #shopify-section-{{ sid }} .bf__buy .quantity { flex: none; min-height: 52px; }
  #shopify-section-{{ sid }} .bf__buy .quantity > button, #shopify-section-{{ sid }} .bf__buy .quantity > input { height: 50px !important; }
  #shopify-section-{{ sid }} .bf__buy .quantity > button { flex-basis: 40px; width: 40px !important; min-width: 40px; }
  #shopify-section-{{ sid }} .bf__buy .quantity svg { width: 12px; height: 12px; }
  #shopify-section-{{ sid }} .bf__atc { flex: 1 1 auto; width: 100%; min-height: 52px; display: inline-flex; align-items: center; justify-content: center; gap: 10px; margin: 0; }
  #shopify-section-{{ sid }} .bf__atc[aria-busy='true'] { opacity: .6; pointer-events: none; }
  #shopify-section-{{ sid }} .bf__atc[aria-busy='true']::before { content: ''; width: 14px; height: 14px; border-radius: 50%; border: 2px solid currentColor; border-right-color: transparent; animation: brailSpin .7s linear infinite; }
  #shopify-section-{{ sid }} .bf__atc.is-added { pointer-events: none; }
  #shopify-section-{{ sid }} .bf__msg { min-height: 1.2em; margin: 0; font-size: 13px; }
  #shopify-section-{{ sid }} .bf__msg:empty { min-height: 0; margin-top: -14px; }
  #shopify-section-{{ sid }} .bf__cart, #shopify-section-{{ sid }} .bf__more a { color: var(--color-link, var(--color-heading)); text-decoration: underline; text-decoration-color: color-mix(in srgb, currentColor 35%, transparent); text-underline-offset: 4px; transition: color .2s ease, text-decoration-color .2s ease; }
  @media (hover: hover) { #shopify-section-{{ sid }} .bf__cart:hover, #shopify-section-{{ sid }} .bf__more a:hover { color: var(--color-link-hover, var(--color-heading)); text-decoration-color: currentColor; } }
  #shopify-section-{{ sid }} .bf__cart { font-size: 13px; align-self: flex-start; }
  #shopify-section-{{ sid }} .bf__cart[hidden] { display: none; }
  #shopify-section-{{ sid }} .bf__with { display: flex; flex-direction: column; gap: 8px; margin-top: 6px; }
  #shopify-section-{{ sid }} .bf__with[hidden] { display: none; }
  #shopify-section-{{ sid }} [data-f-pairs] { display: grid; gap: 8px; }
  #shopify-section-{{ sid }} .bf__with-h { margin: 0; font-size: 11px; letter-spacing: .14em; text-transform: uppercase; opacity: .65; }
  #shopify-section-{{ sid }} .bf__pair { display: grid; grid-template-columns: 56px minmax(0, 1fr) 40px; align-items: center; gap: 14px; padding: 8px 10px 8px 8px; border: 1px solid var(--color-border); border-radius: var(--card-radius, 8px); }
  #shopify-section-{{ sid }} .bf__pair img { width: 56px; height: 64px; object-fit: contain; border-radius: 4px; background: color-mix(in srgb, var(--color-text) 5%, var(--color-background)); }
  #shopify-section-{{ sid }} .bf__pair a { display: block; color: var(--color-heading); font-size: 14px; font-weight: 600; text-decoration: none; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  @media (hover: hover) { #shopify-section-{{ sid }} .bf__pair a:hover { text-decoration: underline; text-underline-offset: 3px; } }
  #shopify-section-{{ sid }} .bf__pair span { display: block; font-size: 13px; opacity: .7; }
  #shopify-section-{{ sid }} .bf__plus { position: relative; display: grid; place-items: center; width: 40px; height: 40px; border-radius: var(--btn-radius, 50%); border: max(1px, var(--btn-border-width, 1px)) solid var(--color-border); background: none; color: var(--color-heading); cursor: pointer; transition: background-color .2s ease, color .2s ease, border-color .2s ease; }
  @media (hover: hover) { #shopify-section-{{ sid }} .bf__plus:hover { border-color: var(--color-heading); } }
  #shopify-section-{{ sid }} .bf__plus svg { transition: transform .3s var(--ease); }
  #shopify-section-{{ sid }} .bf__plus.is-done { background: var(--btn-primary-bg-color, var(--color-heading)); border-color: var(--btn-primary-bg-color, var(--color-heading)); color: var(--btn-primary-color, var(--color-background)); }
  #shopify-section-{{ sid }} .bf__plus.is-done svg { transform: rotate(45deg) scale(0); }
  #shopify-section-{{ sid }} .bf__plus.is-done::after { content: ''; position: absolute; width: 12px; height: 7px; border: solid currentColor; border-width: 0 0 2px 2px; rotate: -45deg; translate: 0 -2px; }
  #shopify-section-{{ sid }} .bf__plus[aria-busy='true'] { opacity: .5; pointer-events: none; }
  #shopify-section-{{ sid }} .bf__plus:disabled { opacity: .4; cursor: default; }
  #shopify-section-{{ sid }} .bf__more { display: flex; justify-content: space-between; gap: 16px; padding-top: 14px; border-top: 1px solid var(--color-border); font-size: 13px; }
  #shopify-section-{{ sid }} .bf__more a[hidden] { display: none; }
  #shopify-section-{{ sid }} .bf__close, #shopify-section-{{ sid }} .bf__nav { position: absolute; z-index: 2; display: grid; place-items: center; width: 44px; height: 44px; padding: 0; border-radius: 50%; border: max(1px, var(--btn-border-width, 1px)) solid var(--color-border); background: var(--color-background); color: var(--color-heading); cursor: pointer; transition: border-color .2s ease, background-color .2s ease, color .2s ease, transform .3s var(--ease); }
  @media (hover: hover) { #shopify-section-{{ sid }} .bf__close:hover { border-color: var(--color-heading); background: var(--color-heading); color: var(--color-background); } }
  #shopify-section-{{ sid }} .bf__close { top: 14px; right: 14px; }
  #shopify-section-{{ sid }} .bf__nav { top: 14px; border-color: transparent; background: transparent; width: 48px; height: 48px; }
  #shopify-section-{{ sid }} .bf__nav svg { width: 24px; height: 24px; }
  #shopify-section-{{ sid }} .bf__nav--prev { left: 8px; } #shopify-section-{{ sid }} .bf__nav--next { left: 56px; }
  #shopify-section-{{ sid }} .bf__nav[hidden] { display: none; }
  @media (min-width: 990px) {
    #shopify-section-{{ sid }} .bf__nav { top: 50%; translate: 0 -50%; }
    #shopify-section-{{ sid }} .bf__nav--prev { left: clamp(12px, 2vw, 32px); }
    #shopify-section-{{ sid }} .bf__nav--next { left: auto; right: clamp(12px, 2vw, 32px); }
    #shopify-section-{{ sid }} .bf__nav--prev:hover { transform: translateX(-4px); } #shopify-section-{{ sid }} .bf__nav--next:hover { transform: translateX(4px); }
  }
  @keyframes brailSpin { to { rotate: 360deg; } }
  html.brail-lock { overflow: hidden; }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .brail * { transition: none !important; animation: none !important; }
    #shopify-section-{{ sid }} [data-drop] .brail__g { opacity: 1; transform: none; }
  }
</style>

{%- capture hanger -%}<svg class="brail__hook" viewBox="0 0 22 30" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M11 30V16c0-1.7 3.5-2.3 3.5-5.5a3.5 3.5 0 1 0-7 0"/></svg>{%- endcapture -%}

<boutique-rail class="brail color-{{ color_scheme }} gradient{% unless show_hooks %} brail--no-hooks{% endunless %}" data-after-add="{{ st.after_add | default: 'stay' }}" data-focus="{{ st.focus_view }}" aria-label="{{ label_1 | default: st.eyebrow | default: section.name | escape }}">
  {%- comment -%} Backgrounds: 0 is the section's own; 1 and 2 belong to the collection tabs and take over while that tab is open. {%- endcomment -%}
  {%- if section_bg != blank -%}
    <div class="brail__bg{% if bg_1 == blank %} is-on{% endif %}" data-bg="0" aria-hidden="true">{{ section_bg | image_url: width: 2400 | image_tag: widths: '750,1100,1500,1900,2400', sizes: '100vw', loading: 'lazy', alt: '' }}</div>
  {%- endif -%}
  {%- if bg_1 != blank -%}
    <div class="brail__bg is-on" data-bg="1" aria-hidden="true">{{ bg_1 | image_url: width: 2400 | image_tag: widths: '750,1100,1500,1900,2400', sizes: '100vw', loading: 'lazy', alt: '' }}</div>
  {%- endif -%}
  {%- if bg_2 != blank -%}
    <div class="brail__bg" data-bg="2" aria-hidden="true">{{ bg_2 | image_url: width: 2400 | image_tag: widths: '750,1100,1500,1900,2400', sizes: '100vw', loading: 'lazy', alt: '' }}</div>
  {%- endif -%}
  <div class="brail__inner">
    {%- liquid
      assign show_eyebrow = false
      if tab_count > 0 or st.eyebrow != blank or st.eyebrow_secondary != blank
        assign show_eyebrow = true
      endif
    -%}
    {%- if show_eyebrow or st.heading != blank -%}
      <div class="brail__head">
        {%- if tab_count == 2 -%}
          <div class="brail__tabs" data-tabs>
            <button type="button" class="brail__tab" data-tab="1" aria-pressed="true" aria-controls="BrailTrack-{{ sid }}-1" data-url="{{ col_1.url }}">{{ label_1 | escape }}</button>
            <button type="button" class="brail__tab" data-tab="2" aria-pressed="false" aria-controls="BrailTrack-{{ sid }}-2" data-url="{{ col_2.url }}">{{ label_2 | escape }}</button>
          </div>
        {%- elsif tab_count == 1 -%}
          <p class="brail__eyebrow">{%- if st.eyebrow != blank -%}<span>{%- if st.eyebrow_clickable and st.eyebrow_link != blank -%}<a href="{{ st.eyebrow_link }}">{{ st.eyebrow | escape }}</a>{%- else -%}{{ st.eyebrow | escape }}{%- endif -%}</span>{%- endif -%}<span>{%- if st.eyebrow_clickable -%}<a href="{{ col_1.url }}">{{ label_1 | escape }}</a>{%- else -%}{{ label_1 | escape }}{%- endif -%}</span></p>
        {%- elsif st.eyebrow != blank or st.eyebrow_secondary != blank -%}
          <p class="brail__eyebrow">
            {%- if st.eyebrow != blank -%}<span>{%- if st.eyebrow_clickable and eb_link_1 != blank -%}<a href="{{ eb_link_1 }}">{{ st.eyebrow | escape }}</a>{%- else -%}{{ st.eyebrow | escape }}{%- endif -%}</span>{%- endif -%}
            {%- if st.eyebrow_secondary != blank -%}<span>{%- if st.eyebrow_clickable and eb_link_2 != blank -%}<a href="{{ eb_link_2 }}">{{ st.eyebrow_secondary | escape }}</a>{%- else -%}{{ st.eyebrow_secondary | escape }}{%- endif -%}</span>{%- endif -%}
          </p>
        {%- endif -%}
        {%- if st.heading != blank -%}<h2 class="brail__heading {{ st.heading_size }}">{{ st.heading }}</h2>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="brail__stage">
      {%- if st.show_bar -%}<span class="brail__bar" aria-hidden="true"></span>{%- endif -%}
      <button type="button" class="brail__arrow brail__arrow--prev" data-prev aria-label="{{ 'accessibility.previous' | t }}"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12H5"/><path d="m11 6-6 6 6 6"/></svg></button>
      <button type="button" class="brail__arrow brail__arrow--next" data-next aria-label="{{ 'accessibility.next' | t }}"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h15"/><path d="m13 6 6 6-6 6"/></svg></button>

      {%- for t in (1..track_count) -%}
        {%- liquid
          # What hangs on this tab's rail: its collection's products, then (first tab
          # only) the Garment blocks whose product is in neither collection. With no
          # collection: the Garment blocks. Sample garments fill a rail that is empty.
          if tab_count == 0
            assign list = garments
          elsif t == 1
            assign list = list_1 | concat: garments
          else
            assign list = list_2
          endif
          assign shown = 0
          assign sample_i = 0
        -%}
        <ul class="brail__track" id="BrailTrack-{{ sid }}-{{ t }}" role="list" data-track="{{ t }}"{% if st.drop_in %} data-drop{% endif %}{% if t > 1 %} hidden{% endif %}>
          {%- for entry in list -%}
            {%- liquid
              assign p = ''
              assign bs = ''
              assign side_img = ''
              assign front_img = ''
              assign back_img = ''
              assign link_text = st.link_text
              assign link_url = ''
              assign attrs = ''
              assign show_item = true
              assign is_sample = false

              if entry.settings
                # A Garment block
                assign bs = entry.settings
                assign p = bs.product
                assign attrs = entry.shopify_attributes
                if tab_count > 0
                  # With collections, a block only hangs here when its product is in neither collection
                  # (or it has pictures of its own and no product); empty blocks stay out of the way.
                  if p != blank
                    for q in list_1
                      if q.id == p.id
                        assign show_item = false
                        break
                      endif
                    endfor
                    for q in list_2
                      if q.id == p.id
                        assign show_item = false
                        break
                      endif
                    endfor
                  elsif bs.side_image == blank and bs.front_image == blank
                    assign show_item = false
                  endif
                endif
              else
                # A collection product: a Garment block for it gives its own pictures and link
                assign p = entry
                for g in garments
                  if g.settings.product != blank and g.settings.product.id == p.id
                    assign bs = g.settings
                    assign attrs = g.shopify_attributes
                    break
                  endif
                endfor
              endif

              if bs != blank
                assign side_img = bs.side_image
                assign front_img = bs.front_image
                assign back_img = bs.back_image
                if bs.link_text != blank
                  assign link_text = bs.link_text
                endif
                assign link_url = bs.link_url
              endif
              # Pictures uploaded on a block are cut-outs; the product's own photos follow Product pictures.
              assign card = false
              if side_img == blank and front_img == blank and p != blank and st.product_photos == 'card'
                assign card = true
              endif
              if p != blank
                if front_img == blank
                  assign front_img = p.featured_image
                endif
                if back_img == blank and p.images.size > 1
                  assign back_img = p.images[1]
                endif
                if link_url == blank
                  assign link_url = p.url
                endif
              endif
              if side_img == blank
                assign side_img = front_img
              endif
              if front_img == blank
                assign front_img = side_img
              endif
              if show_item and side_img == blank
                if st.show_placeholders
                  assign is_sample = true
                else
                  assign show_item = false
                endif
              endif
            -%}
            {%- if show_item -%}
              {%- liquid
                assign idx = shown
                assign shown = shown | plus: 1
                assign g_k = 100
                if bs != blank and bs.rail_size != blank
                  assign g_k = bs.rail_size
                endif
                if is_sample
                  assign pn = sample_i | modulo: ph_names.size
                  assign sample_name = ph_names[pn] | strip
                endif
              -%}
              <li class="brail__item" style="--i: {{ idx }}{% if g_k != 100 %}; --k: {{ g_k | divided_by: 100.0 }}{% endif %}" {{ attrs }}{% if is_sample and p == blank %} data-title="{{ sample_name | escape }}"{% endif %}>
                <button type="button" class="brail__g{% if p == blank %} brail__g--sample{% endif %}" aria-label="{% if p != blank %}{{ p.title | escape }}{% elsif is_sample %}{{ sample_name | escape }}{% else %}{{ 'accessibility.product_label' | t }}{% endif %}">
                  {{ hanger }}
                  {%- if st.show_tags -%}
                    {%- if bs.tag_text != blank -%}<span class="brail__tag">{{ bs.tag_text | escape }}</span>
                    {%- elsif p != blank -%}<span class="brail__tag">{{ p.price | money_without_trailing_zeros }}</span>
                    {%- elsif is_sample -%}<span class="brail__tag">{{ 9900 | money_without_trailing_zeros }}</span>{%- endif -%}
                  {%- endif -%}
                  <span class="brail__pic{% if card %} brail__pic--card{% endif %}">
                    {%- if is_sample -%}
                      {%- render 'boutique-rail-sample', index: sample_i, view: 'side', sizes: side_sz -%}
                      {%- render 'boutique-rail-sample', index: sample_i, view: 'front', sizes: front_sz -%}
                      {%- assign sample_i = sample_i | plus: 1 -%}
                    {%- else -%}
                      {%- assign img_alt = '' -%}
                      {{ side_img | image_url: width: side_w | image_tag: class: 'brail__side', widths: side_ws, sizes: side_sz, loading: 'lazy', alt: img_alt }}
                      {{ front_img | image_url: width: front_w | image_tag: class: 'brail__front', widths: front_ws, sizes: front_sz, loading: 'lazy', alt: img_alt }}
                    {%- endif -%}
                  </span>
                </button>
                {%- if p != blank -%}
                  <script type="application/json" data-g-data>
                    {
                      "title": {{ p.title | json }},
                      "url": {{ link_url | json }},
                      "productUrl": {{ p.url | json }},
                      "linkText": {{ link_text | json }},
                      "photo": {{ card | json }},
                      "price": {{ p.price | money | json }},
                      "with": [{%- if bs.wear_with != blank -%}{%- for w in bs.wear_with limit: 3 -%}{%- assign wv = w.selected_or_first_available_variant -%}{"title": {{ w.title | json }}, "url": {{ w.url | json }}, "price": {{ wv.price | money | json }}, "variant": {{ wv.id | json }}, "available": {{ wv.available | json }}, "option": {% if w.has_only_default_variant %}""{% else %}{{ wv.title | json }}{% endif %}, "image": {% if w.featured_image %}{{ w.featured_image | image_url: width: 160 | json }}{% else %}null{% endif %}}{% unless forloop.last %},{% endunless %}{%- endfor -%}{%- endif -%}],
                      "front": {% if front_img != blank %}{{ front_img | image_url: width: focus_w | json }}{% else %}null{% endif %},
                      "back": {% if back_img != blank %}{{ back_img | image_url: width: focus_w | json }}{% else %}null{% endif %},
                      {%- comment -%} Storelib (round 28): every picture the focus view swipes through: the garment's front and back, then the product's own photos (Focus view > Pictures), each once (a photo with the same file name as one already in is skipped). {%- endcomment -%}
                      {%- liquid
                        assign seen = '|'
                        assign img_json = ''
                        for im in (1..2)
                          if im == 1
                            assign one = front_img
                          else
                            assign one = back_img
                          endif
                          if one != blank
                            assign one_url = one | image_url: width: focus_w
                            # The file's own name, from a plain address (.../name.webp?v=1&width=1200) or an image service's (...?url=%2F__media%2Fname.webp&w=1200)
                            assign one_key = one_url | replace: '%2F', '/' | split: '&' | first
                            if one_key contains 'url='
                              assign one_key = one_key | split: 'url=' | last
                            endif
                            assign one_key = one_key | split: '?' | first | split: '/' | last
                            unless seen contains one_key
                              assign seen = seen | append: one_key | append: '|'
                              if img_json != blank
                                assign img_json = img_json | append: ','
                              endif
                              assign one_q = one_url | json
                              assign img_json = img_json | append: one_q
                            endunless
                          endif
                        endfor
                        if st.focus_images != 'garment'
                          for one in p.images limit: 10
                            assign one_url = one | image_url: width: focus_w
                            # The file's own name, from a plain address (.../name.webp?v=1&width=1200) or an image service's (...?url=%2F__media%2Fname.webp&w=1200)
                            assign one_key = one_url | replace: '%2F', '/' | split: '&' | first
                            if one_key contains 'url='
                              assign one_key = one_key | split: 'url=' | last
                            endif
                            assign one_key = one_key | split: '?' | first | split: '/' | last
                            unless seen contains one_key
                              assign seen = seen | append: one_key | append: '|'
                              if img_json != blank
                                assign img_json = img_json | append: ','
                              endif
                              assign one_q = one_url | json
                              assign img_json = img_json | append: one_q
                            endunless
                          endfor
                        endif
                      -%}
                      "images": [{{ img_json }}],
                      "options": {{ p.options_with_values | map: 'name' | json }},
                      "variants": [{%- for v in p.variants -%}{"id": {{ v.id | json }}, "available": {{ v.available | json }}, "price": {{ v.price | money | json }}, "compare": {% if v.compare_at_price > v.price %}{{ v.compare_at_price | money | json }}{% else %}null{% endif %}, "options": {{ v.options | json }}}{% unless forloop.last %},{% endunless %}{%- endfor -%}]
                    }
                  </script>
                {%- endif -%}
              </li>
            {%- endif -%}
          {%- endfor -%}
          {%- if shown == 0 and st.show_placeholders -%}
            {%- comment -%} An empty rail (a collection with no products yet, or a new section) hangs the sample garments. {%- endcomment -%}
            {%- for i in (0..7) -%}
              {%- liquid
                assign pn = i | modulo: ph_names.size
                assign sample_name = ph_names[pn] | strip
              -%}
              <li class="brail__item" style="--i: {{ i }}" data-title="{{ sample_name | escape }}">
                <button type="button" class="brail__g brail__g--sample" aria-label="{{ sample_name | escape }}">
                  {{ hanger }}
                  {%- if st.show_tags -%}<span class="brail__tag">{{ 9900 | money_without_trailing_zeros }}</span>{%- endif -%}
                  <span class="brail__pic">
                    {%- render 'boutique-rail-sample', index: i, view: 'side', sizes: side_sz -%}
                    {%- render 'boutique-rail-sample', index: i, view: 'front', sizes: front_sz -%}
                  </span>
                </button>
              </li>
            {%- endfor -%}
          {%- endif -%}
        </ul>
      {%- endfor -%}
    </div>

    <div class="brail__foot">
      <div class="brail__dots" aria-hidden="true" data-dots></div>
      <div class="brail__lines">
        <p class="brail__caption" data-caption data-default="{{ st.caption | escape }}">{{ st.caption | escape }}</p>
        <p class="brail__name" data-name aria-live="polite"></p>
      </div>
      {%- if st.button_label != blank -%}
        <a class="btn {% if st.button_style == 'primary' %}btn-primary{% else %}btn-outline{% endif %} no-underline" data-button{% if st.button_link == blank and tab_count > 0 %} data-follow-tab{% endif %} href="{{ st.button_link | default: col_1.url | default: routes.all_products_collection_url }}">{{ st.button_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>

  {%- if st.focus_view -%}
    {%- liquid
      # Storelib (round 28): the focus view's colour scheme is the section's unless Focus view > Use its own colour scheme is on.
      assign focus_scheme = color_scheme
      if st.focus_own_scheme and st.focus_color_scheme != blank
        assign focus_scheme = st.focus_color_scheme.id | default: st.focus_color_scheme
      endif
    -%}
    {%- capture bf_style -%}{%- if st.focus_color != blank and st.focus_color != 'rgba(0,0,0,0)' -%}--color-background: {{ st.focus_color }}; --bf-bg: {{ st.focus_color }};{%- endif -%}{%- if st.focus_text != blank and st.focus_text != 'rgba(0,0,0,0)' -%}--color-text: {{ st.focus_text }}; --color-heading: {{ st.focus_text }}; --color-link: {{ st.focus_text }}; --bf-text: {{ st.focus_text }};{%- endif -%}--bf-glass: {{ st.focus_glass_opacity | default: 82 }}%; --bf-media-r: {{ st.focus_media_radius | default: 0 }}px{%- endcapture -%}
    <dialog class="brail__focus color-{{ focus_scheme }}" data-focus-dialog aria-label="{{ label_1 | default: st.eyebrow | default: section.name | escape }}" style="{{ bf_style }}"{% if st.focus_background == 'glass' %} data-glass{% endif %}>
      <span class="bf__bg" data-f-bg aria-hidden="true"></span>
      <div class="bf">
        <button type="button" class="bf__nav bf__nav--prev" data-f-prev aria-label="{{ 'accessibility.previous' | t }}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12H5"/><path d="m11 6-6 6 6 6"/></svg></button>
        <button type="button" class="bf__nav bf__nav--next" data-f-next aria-label="{{ 'accessibility.next' | t }}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h15"/><path d="m13 6 6 6-6 6"/></svg></button>
        <button type="button" class="bf__close" data-f-close aria-label="{{ 'accessibility.close' | t }}"><svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="m1 1 12 12M13 1 1 13"/></svg></button>
        <div class="bf__media" data-f-media>
          <div class="bf__slides" data-f-slides tabindex="-1"><figure class="bf__slide"><img data-f-front alt="" width="1200" height="1500" draggable="false"></figure></div>
          <button type="button" class="bf__inav bf__inav--prev" data-f-iprev aria-label="{{ 'accessibility.ui.previous_slide' | t }}" hidden><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 6-6 6 6 6"/></svg></button>
          <button type="button" class="bf__inav bf__inav--next" data-f-inext aria-label="{{ 'accessibility.ui.next_slide' | t }}" hidden><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg></button>
          <div class="bf__dots" data-f-dots hidden></div>
        </div>
        <div class="bf__info">
          <span class="bf__count" data-f-count></span>
          <h3 class="bf__title" data-f-title></h3>
          <p class="bf__price" data-f-price></p>
          <div data-f-options></div>
          <div class="bf__buy">
            {%- if st.focus_quantity -%}
              <quantity-input class="quantity bf__qty" data-f-qty>
                <button type="button" name="minus"><span class="visually-hidden">{{ 'products.product.quantity.decrease' | t: product: '' | escape }}</span><svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M2 6h8"/></svg></button>
                <input type="number" name="quantity" value="1" min="1" step="1" inputmode="numeric" aria-label="{{ 'general.cart.headings.quantity' | t | escape }}">
                <button type="button" name="plus"><span class="visually-hidden">{{ 'products.product.quantity.increase' | t: product: '' | escape }}</span><svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M2 6h8M6 2v8"/></svg></button>
              </quantity-input>
            {%- endif -%}
            <button type="button" class="btn btn-primary bf__atc" data-f-atc data-sl-button data-button-role="primary" data-theme-button="primary">{{ 'products.product.add_to_cart' | t }}</button>
          </div>
          <p class="bf__msg" role="status" aria-live="polite" data-f-msg></p>
          <a class="bf__cart" href="{{ routes.cart_url }}" data-f-cart hidden>{{ 'general.cart.viewcart' | t }}</a>
          <div class="bf__with" data-f-with hidden>{%- if st.with_heading != blank -%}<p class="bf__with-h">{{ st.with_heading | escape }}</p>{%- endif -%}<div data-f-pairs></div></div>
          <div class="bf__more"><span data-f-name></span><a href="#" data-f-link></a></div>
        </div>
      </div>
    </dialog>
  {%- endif -%}
</boutique-rail>

<script>
  /* Adds lines to the cart the way the theme's own forms do (the drawer's sections, the count), at /cart/add.js,
     which the Storelib store answers. opts.open === false keeps the drawer shut (the caller says it is added). */
  window.MateriaAddItems = window.MateriaAddItems || async function (items, opts) {
    opts = opts || {};
    const cart = document.querySelector('cart-drawer') || document.querySelector('cart-notification');
    const sections = cart && cart.getSectionsToRender ? cart.getSectionsToRender().map(s => s.id) : [];
    const base = ((window.routes && window.routes.cart_add_url) || '/cart/add').replace(/\.js$/, '');
    const res = await fetch(base + '.js', {
      method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
      body: JSON.stringify({ items, sections, sections_url: location.pathname })
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok || data.status || data.errors) throw new Error(data.description || data.message || data.errors || res.statusText);
    fetch('/cart.json').then(r => r.json()).then(c => document.querySelectorAll('.cart-count').forEach(el => { el.textContent = el.classList.contains('cart-count-drawer') ? '(' + c.item_count + ')' : (c.item_count > 100 ? '~' : c.item_count); })).catch(() => {});
    if (typeof window.publish === 'function' && window.PUB_SUB_EVENTS) { try { window.publish(window.PUB_SUB_EVENTS.cartUpdate, { source: 'materia-add-items', cartData: data }); } catch (_) {} }
    if (cart) {
      if (data.sections) cart.getSectionsToRender().forEach(s => {
        const el = document.getElementById(s.id); if (!el || !data.sections[s.id]) return;
        const incoming = new DOMParser().parseFromString(data.sections[s.id], 'text/html').querySelector('#minicart-form');
        if (incoming && !(window.materiaPatchDrawerCart && window.materiaPatchDrawerCart(el, incoming))) el.innerHTML = incoming.innerHTML;
      });
      if (opts.open !== false) {
        if (typeof cart.cartAction === 'function') cart.cartAction();
        if (typeof cart.open === 'function') cart.open();
      }
    } else if (opts.open !== false) { location.href = (window.routes && window.routes.cart_url) || '/cart'; }
    return data;
  };

  if (!customElements.get('boutique-rail')) {
    customElements.define('boutique-rail', class extends HTMLElement {
      connectedCallback() {
        if (this._ready) return; this._ready = true;
        this.tracks = [...this.querySelectorAll('[data-track]')];
        this.caption = this.querySelector('[data-caption]');
        this.nameEl = this.querySelector('[data-name]');
        this.dots = this.querySelector('[data-dots]');
        this.button = this.querySelector('[data-button]');
        const fine = matchMedia('(hover: hover) and (pointer: fine)');
        // Every garment on every tab is wired once; the rail that is showing is this.track.
        this.tracks.forEach(track => {
          const items = [...track.querySelectorAll('.brail__item')];
          track._items = items;
          items.forEach((li, i) => {
            const btn = li.querySelector('.brail__g');
            const data = li.querySelector('[data-g-data]');
            li._data = data ? JSON.parse(data.textContent) : null;
            btn.addEventListener('pointerenter', () => { if (fine.matches && !this.busy()) this.hot(li, this._vx || 1); });
            btn.addEventListener('pointerdown', () => this.preload(li));
            btn.addEventListener('focus', () => { if (!this._refocus) this.hot(li); });
            btn.addEventListener('click', () => this.open(i, btn));
          });
          track.addEventListener('pointermove', e => { if (this._lx != null) { const v = e.clientX - this._lx; if (v) this._vx = v; } this._lx = e.clientX; });
          // While the focus view is open (or opening) the rail stays as it was clicked: the garment comes back to the same pose.
          track.addEventListener('pointerleave', () => { this._lx = null; if (!this.busy()) this.hot(null); });
          track.addEventListener('focusout', e => { if (!track.contains(e.relatedTarget) && !this.busy()) this.hot(null); });
          track.addEventListener('scroll', () => this.queueSync(), { passive: true });
          if ('ResizeObserver' in window) new ResizeObserver(() => this.queueSync()).observe(track);
        });
        this.setTrack(this.tracks.find(t => !t.hidden) || this.tracks[0]);
        // Arrows
        const step = () => this.track.clientWidth * 0.7;
        this.querySelector('[data-prev]')?.addEventListener('click', () => this.track.scrollBy({ left: -step(), behavior: 'smooth' }));
        this.querySelector('[data-next]')?.addEventListener('click', () => this.track.scrollBy({ left: step(), behavior: 'smooth' }));
        // Collection tabs
        this.tabs = [...this.querySelectorAll('[data-tab]')];
        this.tabs.forEach(tab => tab.addEventListener('click', () => this.switchTo(tab)));
        // The other rail's garments are fetched before they are needed (lazy pictures in a hidden rail never load on their
        // own), so the switch fades in whole garments rather than pictures still arriving. Pointing at a tab asks at once.
        const warm = () => this.tracks.forEach(t => { if (t.hidden) t.querySelectorAll('.brail__side').forEach(im => { im.loading = 'eager'; }); });
        this.tabs.forEach(tab => ['pointerenter', 'pointerdown', 'focus'].forEach(ev => tab.addEventListener(ev, warm, { once: true })));
        const idle = () => (window.requestIdleCallback ? requestIdleCallback(warm, { timeout: 2500 }) : setTimeout(warm, 1200));
        if (this.tabs.length) { if (document.readyState === 'complete') idle(); else addEventListener('load', idle, { once: true }); }
        // Drop onto the rail when it comes into view (at once when the editor redraws it, or with reduced motion)
        if (this.track && this.track.hasAttribute('data-drop')) {
          // Every rail is marked dropped once the first has settled, so a tab opened later shows its garments at once (it cross-fades as a whole).
          const show = () => { this._seen = true; this.track.classList.add('is-in'); setTimeout(() => this.tracks.forEach(t => t.classList.add('is-in', 'is-dropped')), 900); };
          if (this.closest('[data-mt-redrawn]') || this.calm() || !('IntersectionObserver' in window)) show();
          else { const io = new IntersectionObserver(es => { if (es.some(e => e.isIntersecting)) { show(); io.disconnect(); } }, { threshold: 0.2 }); io.observe(this); }
        } else this._seen = true;
        this.setupFocus();
        // The editor: selecting a Garment block opens the tab it hangs on and brings it into view.
        this.addEventListener('shopify:block:select', e => {
          const li = e.target.closest && e.target.closest('.brail__item'); if (!li) return;
          const track = li.closest('[data-track]');
          if (track && track !== this.track) { const tab = this.tabs.find(b => b.dataset.tab === track.dataset.track); if (tab) this.switchTo(tab, true); }
          li.scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'smooth' });
        });
      }
      calm() { return matchMedia('(prefers-reduced-motion: reduce)').matches; }
      busy() { return !!(this._opening || (this.dialog && this.dialog.open)); }
      setTrack(track) {
        this.track = track; this.items = track ? track._items : [];
        if (this.dots) this.dots.innerHTML = this.items.length > 1 ? this.items.map(() => '<span class="brail__dot"></span>').join('') : '';
        this.queueSync();
      }
      queueSync() { if (!this._raf) this._raf = requestAnimationFrame(() => { this._raf = 0; this.sync(); }); }
      sync() {
        const t = this.track; if (!t) return;
        // Measured with no garment turned, so a hover (whose neighbours slide aside) never shows or hides the arrows.
        const max = t.scrollWidth - t.clientWidth;
        if (!this._hot) this.toggleAttribute('data-overflow', max > 4);
        const prev = this.querySelector('[data-prev]'), next = this.querySelector('[data-next]');
        if (prev) prev.disabled = t.scrollLeft < 4; if (next) next.disabled = t.scrollLeft > max - 4;
        if (this.dots && this.dots.children.length) {
          const idx = max > 0 ? Math.round((t.scrollLeft / max) * (this.items.length - 1)) : 0;
          [...this.dots.children].forEach((d, k) => d.classList.toggle('is-on', k === idx));
        }
      }
      // Open another collection (r67): the rail on show fades out (140 ms), the other fades in (260 ms) in the same
      // place, opacity only, so the section never changes height and nothing drops, bounces or flashes. A second
      // press during the fade turns it round from where it is.
      switchTo(tab, instant) {
        const next = this.tracks.find(t => t.dataset.track === tab.dataset.tab);
        if (!next || next === (this._target || this.track)) return;
        this.tabs.forEach(b => b.setAttribute('aria-pressed', String(b === tab)));
        const n = tab.dataset.tab, own = this.querySelector('[data-bg="' + n + '"]');
        this.querySelectorAll('[data-bg]').forEach(bg => bg.classList.toggle('is-on', own ? bg === own : bg.dataset.bg === '0'));
        if (this.button && this.button.hasAttribute('data-follow-tab') && tab.dataset.url) this.button.href = tab.dataset.url;
        this.hot(null);
        const cur = this.track, token = (this._switch = (this._switch || 0) + 1);
        const at = cur ? +getComputedStyle(cur).opacity : 1;
        (this._fade || []).forEach(a => a.cancel()); this._fade = [];
        const calm = instant || this.calm() || !cur || !cur.animate;
        // Back to the rail that was still fading out: it fades back in from where it is.
        if (next === cur) {
          this._target = null;
          if (!calm && at < 1) this._fade = [cur.animate([{ opacity: at }, { opacity: 1 }], { duration: Math.round(260 * (1 - at)) + 1, easing: 'cubic-bezier(.2, 0, 0, 1)' })];
          return;
        }
        this._target = next;
        const enter = () => {
          if (token !== this._switch) return;
          this._target = null;
          this.tracks.forEach(t => { if (t !== next) t.hidden = true; t.classList.add('is-in', 'is-dropped'); });
          next.hidden = false; next.scrollLeft = 0; this.setTrack(next);
          if (calm) return;
          this._fade = [next.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 260, easing: 'cubic-bezier(.2, 0, 0, 1)' })];
        };
        if (calm) return enter();
        const out = cur.animate([{ opacity: at }, { opacity: 0 }], { duration: Math.round(140 * at) + 1, easing: 'cubic-bezier(.4, 0, 1, 1)', fill: 'forwards' });
        this._fade = [out];
        out.finished.then(() => { if (token !== this._switch) return; enter(); out.cancel(); }, () => {});
      }
      hot(li, vx = 1) {
        if (this._hot === li) return;
        const dir = vx < 0 ? -1 : 1, speed = Math.min(1.25, Math.max(0.6, Math.abs(vx) / 12));
        if (this._hot) this._hot.classList.remove('is-hot');
        this._hot = li;
        if (li) {
          li.classList.add('is-hot');
          // Storelib (r67): only the garment pointed at swings, once; its neighbours and the one left behind keep still.
          this.push(li, speed * dir);
          this.preload(li);
        }
        // The name takes the caption's place in the same cell, on one line: nothing under the rail moves.
        if (!this.nameEl) return;
        const d = li && li._data, title = li ? ((d && d.title) || li.dataset.title || '') : '';
        if (title) {
          this.nameEl.textContent = title;
          if (d && d.price) { const sm = document.createElement('small'); sm.textContent = d.price; this.nameEl.appendChild(sm); }
          this.classList.add('is-naming');
        } else this.classList.remove('is-naming');
      }
      // The focus view's picture, fetched as soon as a garment is pointed at or pressed.
      preload(li) {
        const d = li && li._data; if (!d || li._pre) return;
        // Decoded ahead too (r67), so the focus view never draws it for the first time in the middle of the flight.
        li._pre = [d.front].filter(Boolean).map(src => { const im = new Image(); im.decoding = 'async'; im.src = src; if (im.decode) im.decode().catch(() => {}); return im; });
      }
      // Damped pendulum: a gentle push, then smaller and smaller swings until it hangs still (about 2.5 s).
      push(li, kick) {
        const g = li && li.querySelector && li.querySelector('.brail__g'); if (!g) return;
        if (this._swing == null) this._swing = this.calm() ? 0 : parseFloat(getComputedStyle(this).getPropertyValue('--swing')) || 0;
        if (!this._swing) return;
        const s = g._sw || (g._sw = { a: 0, v: 0 });
        s.v -= kick * this._swing * 4.4;
        (this._sw || (this._sw = new Set())).add(g);
        if (!this._swRaf) { this._swT = performance.now(); this._swRaf = requestAnimationFrame(t => this.swingTick(t)); }
      }
      swingTick(t) {
        const dt = Math.min(0.033, Math.max(0, (t - this._swT) / 1000)), lim = this._swing * 1.8; this._swT = t;
        this._sw.forEach(g => {
          const s = g._sw; s.v += (-44 * s.a - 2.6 * s.v) * dt; s.a = Math.max(-lim, Math.min(lim, s.a + s.v * dt));
          if (Math.abs(s.a) < 0.02 && Math.abs(s.v) < 0.08) { s.a = s.v = 0; g.style.rotate = ''; this._sw.delete(g); }
          else g.style.rotate = s.a.toFixed(3) + 'deg';
        });
        this._swRaf = this._sw.size ? requestAnimationFrame(n => this.swingTick(n)) : 0;
      }
      setupFocus() {
        const d = this.querySelector('[data-focus-dialog]'); this.dialog = d; if (!d) return;
        this.f = n => d.querySelector('[data-f-' + n + ']');
        this.f('close').addEventListener('click', () => this.close());
        this.f('prev').addEventListener('click', () => this.step(-1));
        this.f('next').addEventListener('click', () => this.step(1));
        d.addEventListener('cancel', e => { e.preventDefault(); this.close(); });
        // Storelib (r67): the view opens in the top layer as a popover, so the page is not made inert (which restyled
        // every element on the page, about a third of a second on a slow phone, before the first frame). Escape and
        // Tab are kept inside it here instead.
        document.addEventListener('keydown', e => {
          if (!d.open || this._modal) return;
          if (e.key === 'Escape') { e.preventDefault(); this.close(); return; }
          if (e.key !== 'Tab') return;
          const list = [...d.querySelectorAll('button:not([disabled]):not([hidden]), a[href]:not([hidden]), input, [tabindex="0"]')].filter(x => x.offsetParent || x.getClientRects().length);
          if (!list.length) return;
          const first = list[0], last = list[list.length - 1], inside = d.contains(document.activeElement);
          if (e.shiftKey && (!inside || document.activeElement === first)) { e.preventDefault(); last.focus(); }
          else if (!e.shiftKey && (!inside || document.activeElement === last)) { e.preventDefault(); first.focus(); }
        });
