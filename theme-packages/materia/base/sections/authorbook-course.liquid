{%- comment -%}
  Author: a free email course. On the left a heading and ticked points,
  each a bold first line and a sentence; on the right a white card with a
  short heading, the email field, a full width button and a note on how
  often the emails come. A picture can sit above the card. Stacks on a
  phone. Sign-ups reach the store's subscribers with the tag below.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign color_scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
-%}
<style>
  #shopify-section-{{ sid }} .abe { background: {{ st.background | default: '#f5f2ec' }}; padding: {{ st.padding_top_mobile | default: 56 }}px 20px {{ st.padding_bottom_mobile | default: 56 }}px; scroll-margin-top: 80px; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .abe { padding: {{ st.padding_top | default: 104 }}px 40px {{ st.padding_bottom | default: 104 }}px; } }
  #shopify-section-{{ sid }} .abe__inner { max-width: 1140px; margin: 0 auto; display: grid; grid-template-columns: minmax(0, 1fr); gap: 36px; align-items: center; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .abe__inner { grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: 88px; } }
  #shopify-section-{{ sid }} .abe__eyebrow { margin: 0 0 14px; font-size: 13px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: {{ st.accent_color | default: '#c4471f' }}; }
  #shopify-section-{{ sid }} .abe__heading { margin: 0; color: var(--color-heading); font-family: var(--heading-font, inherit); font-weight: var(--heading-weight, 400); font-size: {{ st.heading_size_mobile | default: 36 }}px; line-height: 1.08; letter-spacing: -0.01em; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .abe__heading { font-size: {{ st.heading_size | default: 48 }}px; } }
  #shopify-section-{{ sid }} .abe__heading em { font-style: italic; color: {{ st.accent_color | default: '#c4471f' }}; }
  #shopify-section-{{ sid }} .abe__points { list-style: none; margin: 28px 0 0; padding: 0; display: grid; gap: 20px; }
  #shopify-section-{{ sid }} .abe__point { display: grid; grid-template-columns: 26px minmax(0, 1fr); gap: 14px; }
  #shopify-section-{{ sid }} .abe__tick { width: 26px; height: 26px; border-radius: 50%; display: grid; place-items: center; background: {{ st.tick_color | default: '#f0643a' }}; color: #fff; margin-top: 1px; }
  #shopify-section-{{ sid }} .abe__tick svg { width: 14px; height: 14px; }
  #shopify-section-{{ sid }} .abe__point-title { margin: 0; color: var(--color-heading); font-size: 17px; font-weight: 700; line-height: 1.4; }
  #shopify-section-{{ sid }} .abe__point-text { margin: 4px 0 0; color: var(--color-text); font-size: 16px; line-height: 1.6; }
  #shopify-section-{{ sid }} .abe__card { position: relative; background: #fff; border-radius: {{ st.card_radius | default: 12 }}px; padding: 28px 22px; text-align: center; box-shadow: 0 1px 2px rgba(20,22,28,0.05), 0 30px 60px -30px rgba(20,22,28,0.25); }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .abe__card { padding: 40px 44px; } }
  #shopify-section-{{ sid }} .abe__card-media { margin: -28px -22px 24px; overflow: hidden; border-radius: {{ st.card_radius | default: 12 }}px {{ st.card_radius | default: 12 }}px 0 0; aspect-ratio: 16 / 9; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .abe__card-media { margin: -40px -44px 28px; } }
  #shopify-section-{{ sid }} .abe__card-media img { display: block; width: 100%; height: 100%; object-fit: cover; margin: 0; }
  #shopify-section-{{ sid }} .abe__card-title { margin: 0 auto; max-width: 22ch; color: var(--color-heading); font-size: 20px; font-weight: 700; line-height: 1.35; }
  #shopify-section-{{ sid }} .abe__form { margin-top: 20px; display: grid; gap: 10px; }
  #shopify-section-{{ sid }} .abe__input { --input-height: 54px; height: 54px !important; min-height: 54px !important; width: 100%; height: 54px; margin: 0; padding: 0 18px; border: 1.5px solid {{ st.field_border | default: '#d9d4c8' }}; border-radius: {{ st.button_radius | default: 6 }}px; font: inherit; font-size: 16px; text-align: center; color: var(--color-heading); background: #fff; }
  #shopify-section-{{ sid }} .abe__input:focus-visible { outline: 2px solid {{ st.button_color | default: '#1d2b4f' }}; outline-offset: 1px; }
  #shopify-section-{{ sid }} .abe__submit { width: 100%; height: 54px; margin: 0; border: 0; cursor: pointer; border-radius: {{ st.button_radius | default: 6 }}px; background: {{ st.button_color | default: '#1d2b4f' }}; color: {{ st.button_text_color | default: '#ffffff' }}; font: inherit; font-size: 15.5px; font-weight: 700; transition: filter 0.2s ease; }
  #shopify-section-{{ sid }} .abe__submit:hover { filter: brightness(1.15); }
  #shopify-section-{{ sid }} .abe__note { margin: 16px auto 0; max-width: 34ch; color: var(--color-text); font-size: 14px; line-height: 1.5; font-style: italic; }
  #shopify-section-{{ sid }} .abe__msg { margin: 10px 0 0; font-size: 14px; color: var(--color-heading); }
  #shopify-section-{{ sid }} .abe__hp, #shopify-section-{{ sid }} .abe__vh { position: absolute !important; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
</style>
<div class="abe color-{{ color_scheme }}" id="{{ st.anchor | default: 'course' | handleize }}" data-section-id="{{ sid }}">
  <div class="abe__inner">
    <div>
      {%- if st.eyebrow != blank -%}<p class="abe__eyebrow">{{ st.eyebrow | escape }}</p>{%- endif -%}
      {%- if st.heading != blank -%}<h2 class="abe__heading">{{ st.heading }}</h2>{%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <ul class="abe__points" role="list">
          {%- for block in section.blocks -%}
            <li class="abe__point" {{ block.shopify_attributes }}>
              <span class="abe__tick" aria-hidden="true"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 8.5l3 3 6-7"/></svg></span>
              <div>
                <p class="abe__point-title">{{ block.settings.title | escape }}</p>
                {%- if block.settings.text != blank -%}<p class="abe__point-text">{{ block.settings.text | escape }}</p>{%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
    <div class="abe__card">
      {%- if st.image != blank -%}<div class="abe__card-media"><img src="{{ st.image | image_url: width: 900 }}" srcset="{{ st.image | image_url: width: 500 }} 500w, {{ st.image | image_url: width: 900 }} 900w" sizes="(min-width: 990px) 460px, 90vw" width="900" height="506" alt="{{ st.image_alt | default: st.image.alt | escape }}" loading="lazy" decoding="async"></div>{%- endif -%}
      {%- if st.card_title != blank -%}<p class="abe__card-title">{{ st.card_title | escape }}</p>{%- endif -%}
      {%- form 'customer', id: 'AuthorCourseForm-' | append: sid, class: 'abe__form', data-storelib-form: 'subscribe' -%}
        <input type="hidden" name="contact[tags]" value="{{ st.tag | default: 'email-course' | escape }}">
        <span hidden data-mt-words data-success-message="{{ st.success_text | default: 'You are in. The first lesson is on its way.' | escape }}" data-invalid-message="{{ st.invalid_text | default: 'Enter a valid email address.' | escape }}"></span>
        <div class="abe__hp" aria-hidden="true" data-mt-trap>
          <label for="AuthorCourseHp-{{ sid }}">Leave this field empty</label>
          <input id="AuthorCourseHp-{{ sid }}" type="text" name="company" tabindex="-1" autocomplete="off" pattern="^$" maxlength="0" value="">
        </div>
        <label class="abe__vh" for="AuthorCourseEmail-{{ sid }}">{{ st.email_placeholder | default: 'Email address' | escape }}</label>
        <input class="abe__input" id="AuthorCourseEmail-{{ sid }}" type="email" name="contact[email]" required inputmode="email" autocomplete="email" autocapitalize="off" spellcheck="false" maxlength="254" placeholder="{{ st.email_placeholder | default: 'Email address' | escape }}">
        <button type="submit" class="abe__submit">{{ st.button_label | default: 'Send the first lesson' | escape }}</button>
        {%- if form.posted_successfully? -%}<p class="abe__msg form-status--success">{{ st.success_text | default: 'You are in. The first lesson is on its way.' | escape }}</p>{%- endif -%}
        {%- if form.errors -%}<p class="abe__msg" role="alert">{{ st.invalid_text | default: 'Enter a valid email address.' | escape }}</p>{%- endif -%}
      {%- endform -%}
      {%- if st.note != blank -%}<p class="abe__note">{{ st.note | escape }}</p>{%- endif -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Author email course",
  "tag": "section",
  "class": "section sec__authorbook-course",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default-color-scheme" },
    { "type": "color", "id": "background", "label": "Background", "default": "#f5f2ec" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#c4471f" },
    { "type": "color", "id": "tick_color", "label": "Ticks", "default": "#f0643a" },
    { "type": "text", "id": "anchor", "label": "Name for links to this section", "default": "course" },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Free email course" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "A short course by email, <em>free</em>" },
    { "type": "header", "content": "Card" },
    { "type": "image_picker", "id": "image", "label": "Picture at the top of the card" },
    { "type": "text", "id": "image_alt", "label": "Alt text" },
    { "type": "range", "id": "card_radius", "label": "Card corners", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 12 },
    { "type": "text", "id": "card_title", "label": "Card heading", "default": "Join the free course and get the first lesson today" },
    { "type": "text", "id": "email_placeholder", "label": "Email field", "default": "Email address" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Send the first lesson" },
    { "type": "color", "id": "button_color", "label": "Button colour", "default": "#1d2b4f" },
    { "type": "color", "id": "button_text_color", "label": "Button text colour", "default": "#ffffff" },
    { "type": "color", "id": "field_border", "label": "Field border", "default": "#d9d4c8" },
    { "type": "range", "id": "button_radius", "label": "Field and button corners", "min": 0, "max": 30, "step": 1, "unit": "px", "default": 6 },
    { "type": "text", "id": "tag", "label": "Tag for the people who sign up", "default": "email-course" },
    { "type": "text", "id": "note", "label": "Note under the button", "default": "One short email every other day. Leave whenever you like." },
    { "type": "text", "id": "success_text", "label": "Message after signing up", "default": "You are in. The first lesson is on its way." },
    { "type": "text", "id": "invalid_text", "label": "Message for an address that will not work", "default": "Enter a valid email address." },
    { "type": "range", "id": "heading_size", "label": "Heading size, desktop", "min": 28, "max": 72, "step": 2, "unit": "px", "default": 48 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size, phone", "min": 24, "max": 48, "step": 2, "unit": "px", "default": 36 },
    { "type": "range", "id": "padding_top", "label": "Space above, desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 104 },
    { "type": "range", "id": "padding_bottom", "label": "Space below, desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 104 },
    { "type": "range", "id": "padding_top_mobile", "label": "Space above, phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Space below, phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    { "type": "point", "name": "Point", "settings": [
      { "type": "text", "id": "title", "label": "First line", "default": "What the reader gets." },
      { "type": "text", "id": "text", "label": "Sentence", "default": "One sentence on why it helps." }
    ] }
  ],
  "max_blocks": 6,
  "presets": [ { "name": "Author email course", "blocks": [ { "type": "point" }, { "type": "point" }, { "type": "point" } ] } ]
}
{% endschema %}
