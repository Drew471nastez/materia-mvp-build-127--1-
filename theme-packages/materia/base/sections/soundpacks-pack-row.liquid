{% schema %}
{
  "name": "Pack cards with previews",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "New packs." },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "link_label", "label": "Link label" },
    { "type": "url", "id": "link_url", "label": "Link", "info": "Left empty, all products." },
    { "type": "text", "id": "anchor", "label": "Name to link to", "info": "A link to #name on the page scrolls here, e.g. #packs." },
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "layout", "label": "Layout", "default": "row", "options": [{ "value": "row", "label": "A row with arrows" }, { "value": "grid", "label": "Grid" }] },
    { "type": "range", "id": "columns", "label": "Cards across on a computer", "min": 3, "max": 5, "step": 1, "default": 4 },
    { "type": "range", "id": "card_width_mobile", "label": "Card width on phones (row)", "min": 60, "max": 92, "step": 2, "unit": "%", "default": 78 },
    { "type": "range", "id": "columns_mobile", "label": "Cards across on phones (grid)", "min": 1, "max": 2, "step": 1, "default": 1 },
    { "type": "header", "content": "Cards" },
    { "type": "color", "id": "card_color", "label": "Card colour", "info": "Left empty, a shade of the scheme's heading colour." },
    { "type": "checkbox", "id": "use_theme_radius", "label": "Use the theme's card corners", "default": false },
    { "type": "range", "id": "card_radius", "label": "Card corners", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 20 },
    { "type": "checkbox", "id": "title_uppercase", "label": "Pack names in capitals", "default": true },
    { "type": "color", "id": "accent", "label": "Accent", "info": "The playing wave, sale prices and badges. Left empty, the scheme's button colour." },
    { "type": "text", "id": "free_label", "label": "Price word for free packs", "default": "Free" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 20, "max": 72, "step": 2, "unit": "px", "default": 44 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size on phones", "min": 18, "max": 48, "step": 2, "unit": "px", "default": 30 },
    { "type": "range", "id": "title_size", "label": "Pack name size", "min": 14, "max": 36, "step": 1, "unit": "px", "default": 24 },
    { "type": "range", "id": "title_size_mobile", "label": "Pack name size on phones", "min": 14, "max": 30, "step": 1, "unit": "px", "default": 20 },
    { "type": "header", "content": "General" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default" },
    { "type": "select", "id": "section_width", "label": "Section width", "default": "container", "options": [{ "value": "container", "label": "Default" }, { "value": "fluid_container", "label": "Fluid container" }, { "value": "stretch_width", "label": "Stretched" }] },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 }
  ],
  "blocks": [
    {
      "type": "pack",
      "name": "Pack",
      "settings": [
        { "type": "text", "id": "product", "label": "Product", "info": "The product's handle or exact name. Its name, cover, price and page are used; the fields below fill what it leaves out." },
        { "type": "text", "id": "title", "label": "Name", "default": "Pack name" },
        { "type": "text", "id": "type", "label": "Type line", "default": "Sample pack" },
        { "type": "text", "id": "badge", "label": "Badge", "info": "A word in the accent colour, e.g. New." },
        { "type": "image_picker", "id": "cover", "label": "Cover", "info": "A pack box or cover on a transparent ground looks best." },
        { "type": "text", "id": "price", "label": "Price", "info": "Used when no product is found. Left empty, the free word." },
        { "type": "text", "id": "compare", "label": "Price before the sale" },
        { "type": "url", "id": "link", "label": "Link", "info": "Left empty, the product's page." },
        { "type": "header", "content": "Preview" },
        { "type": "file_picker", "id": "audio", "label": "Audio file", "accept": ["audio"], "info": "An mp3, wav, m4a, ogg, aac or flac file, or an https link. A short loop loads fastest." },
        { "type": "text", "id": "track_title", "label": "What plays", "info": "Read out to screen readers, e.g. Drum loop, 126 BPM." },
        { "type": "number", "id": "seconds", "label": "Length in seconds" },
        { "type": "textarea", "id": "peaks", "label": "Waveform peaks", "info": "Optional: 120 numbers from 0 to 100, separated by commas. Left empty, the wave is read from the file the first time it plays." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pack cards with previews",
      "blocks": [
        { "type": "pack", "settings": { "title": "First pack", "type": "Sample pack", "price": "$24.00" } },
        { "type": "pack", "settings": { "title": "Second pack", "type": "Drum kit", "price": "$19.00" } },
        { "type": "pack", "settings": { "title": "Third pack", "type": "Loops", "price": "$29.00" } },
        { "type": "pack", "settings": { "title": "Free pack", "type": "Free download", "price": "" } }
      ]
    }
  ]
}
{% endschema %}
