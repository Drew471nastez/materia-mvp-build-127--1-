{%- comment -%}
  Sound packs (templates round 25): pack cards in a row that scrolls
  sideways with arrows, or in a grid. Each card has a small type line, the
  pack's name, its cover with a play button in the middle, the preview's
  own waveform under the cover, the price and an arrow to the pack.

  A card follows a product of the shop when "Product" names one (its
  handle or its exact name): the name, cover, price and link come from it,
  and the card's own fields fill what the product leaves out. Naming a
  product the shop does not have draws the card from its own fields.

  The previews use the theme's shared players (samples-audio-tracks): one
  sound plays at a time across the page, nothing downloads before play is
  pressed. Colours, corners and fonts follow the theme settings and the
  colour scheme; the accent is a setting that falls back to the scheme's
  button colour.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign sid = section.id
  assign color_scheme = s.color_scheme.id | default: s.color_scheme | default: 'default'
  assign section_width = s.section_width | default: 'container'
  assign layout = s.layout | default: 'row'
  assign cols = s.columns | default: 4
  assign pt = s.padding_top | default: 80
  assign pb = s.padding_bottom | default: 80
-%}
<style>
  #shopify-section-{{ sid }} .spr { --spx-accent: {% if s.accent != blank %}{{ s.accent }}{% else %}var(--btn-primary-bg-color){% endif %}; --spr-card: {% if s.card_color != blank %}{{ s.card_color }}{% else %}rgba(var(--color-heading-rgb), .055){% endif %}; --spr-radius: {% if s.use_theme_radius %}var(--card-radius, 16px){% else %}{{ s.card_radius | default: 20 }}px{% endif %}; padding-block: {{ pt | times: 0.65 | round }}px {{ pb | times: 0.65 | round }}px; }
  #shopify-section-{{ sid }} .ssp { --ssp-p: 0%; --ssp-h: 0%; --ssp-sw: 2px; --ssp-accent: var(--spx-accent); --ssp-base: rgba(var(--color-heading-rgb), .26); --ssp-done: var(--spx-accent); min-width: 0; }
  #shopify-section-{{ sid }} .ssp__btn { position: relative; flex: none; box-sizing: border-box; margin: 0; padding: 0; border: 0; border-radius: 50%; display: grid; place-items: center; cursor: pointer; -webkit-tap-highlight-color: transparent; transition: background-color .2s ease, color .2s ease, transform .2s ease, box-shadow .2s ease; }
  #shopify-section-{{ sid }} .ssp__btn:focus-visible, #shopify-section-{{ sid }} .ssp__wave:focus-visible { outline: 2px solid var(--spx-accent); outline-offset: 3px; }
  #shopify-section-{{ sid }} .ssp__btn[disabled] { cursor: default; opacity: .5; }
  #shopify-section-{{ sid }} .ssp__i { grid-area: 1 / 1; width: 42%; height: 42%; display: block; transition: opacity .18s ease; }
  #shopify-section-{{ sid }} .ssp__i--play { transform: translateX(4%); }
  #shopify-section-{{ sid }} .ssp__i--pause { opacity: 0; }
  #shopify-section-{{ sid }} .ssp.is-playing .ssp__i--play { opacity: 0; }
  #shopify-section-{{ sid }} .ssp.is-playing .ssp__i--pause { opacity: 1; }
  #shopify-section-{{ sid }} .ssp__btn::after { content: ""; position: absolute; inset: -3px; border-radius: 50%; border: 2px solid transparent; border-top-color: var(--spx-accent); opacity: 0; transition: opacity .2s ease; pointer-events: none; }
  #shopify-section-{{ sid }} .ssp.is-loading .ssp__btn::after { opacity: 1; animation: spx-spin .8s linear infinite; }
  #shopify-section-{{ sid }} .ssp__row { display: flex; align-items: center; gap: 10px; min-width: 0; }
  #shopify-section-{{ sid }} .ssp__wave { position: relative; flex: 1 1 auto; min-width: 0; cursor: pointer; touch-action: pan-y; -webkit-tap-highlight-color: transparent; }
  #shopify-section-{{ sid }} .ssp--off .ssp__wave { cursor: default; }
  #shopify-section-{{ sid }} .ssp__svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; fill: none; stroke: var(--ssp-base); stroke-width: var(--ssp-sw); stroke-linecap: round; pointer-events: none; transform-origin: 50% 50%; }
  #shopify-section-{{ sid }} .ssp__svg--hover { stroke: rgba(var(--color-heading-rgb), .55); clip-path: inset(-2px calc(100% - var(--ssp-h)) -2px 0); opacity: 0; transition: opacity .2s ease; }
  #shopify-section-{{ sid }} .ssp__svg--done { stroke: var(--ssp-done); clip-path: inset(-2px calc(100% - var(--ssp-p)) -2px 0); }
  #shopify-section-{{ sid }} .ssp:not(.is-started) .ssp__svg--done { visibility: hidden; }
  #shopify-section-{{ sid }} .ssp__head { position: absolute; top: 6%; bottom: 6%; left: var(--ssp-p); width: 2px; margin-left: -1px; border-radius: 2px; background: rgb(var(--color-heading-rgb)); opacity: 0; transition: opacity .2s ease; pointer-events: none; }
  #shopify-section-{{ sid }} .ssp.is-started .ssp__head { opacity: .9; }
  #shopify-section-{{ sid }} .ssp__tip { position: absolute; bottom: calc(100% + 6px); left: var(--ssp-h); transform: translateX(-50%); padding: 3px 7px; border-radius: 6px; background: rgb(var(--color-heading-rgb)); color: var(--color-background); font-size: 11px; font-weight: 600; line-height: 1.2; font-variant-numeric: tabular-nums; white-space: nowrap; opacity: 0; transition: opacity .15s ease; pointer-events: none; z-index: 2; }
  #shopify-section-{{ sid }} .ssp--flat .ssp__svg { stroke: rgba(var(--color-heading-rgb), .18); }
  #shopify-section-{{ sid }} .ssp--drawn .ssp__svg { animation: spx-grow .5s cubic-bezier(.2,.7,.2,1) both; }
  #shopify-section-{{ sid }} .ssp__time { flex: none; font-size: 12px; line-height: 1; color: var(--color-text); font-variant-numeric: tabular-nums; white-space: nowrap; }
  #shopify-section-{{ sid }} .ssp.is-started .ssp__time { color: var(--color-heading); }
  @media (hover: hover) and (pointer: fine) {
    #shopify-section-{{ sid }} .ssp:not(.ssp--off) .ssp__wave:hover .ssp__svg--hover, #shopify-section-{{ sid }} .ssp.has-len:not(.ssp--off) .ssp__wave:hover .ssp__tip { opacity: 1; }
  }
  @keyframes spx-spin { to { transform: rotate(360deg); } }
  @keyframes spx-grow { from { transform: scaleY(.08); } to { transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .ssp__btn, #shopify-section-{{ sid }} .ssp__i, #shopify-section-{{ sid }} .ssp__svg--hover, #shopify-section-{{ sid }} .ssp__head, #shopify-section-{{ sid }} .ssp__tip { transition: none; }
    #shopify-section-{{ sid }} .ssp--drawn .ssp__svg { animation: none; }
  }
  #shopify-section-{{ sid }} .spr__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px 32px; margin-bottom: 24px; }
  #shopify-section-{{ sid }} .spr__heading { margin: 0; font-size: {{ s.heading_size_mobile | default: 30 }}px; line-height: 1.05; letter-spacing: -0.02em; overflow-wrap: anywhere; }
  #shopify-section-{{ sid }} .spr__text { margin: 8px 0 0; max-width: 52ch; font-size: 15px; line-height: 1.5; color: var(--color-text); }
  #shopify-section-{{ sid }} .spr__text p { margin: 0; }
  #shopify-section-{{ sid }} .spr__side { display: flex; align-items: center; gap: 16px; flex: none; }
  #shopify-section-{{ sid }} .spr__more { font-size: 14px; font-weight: 600; color: var(--color-heading); text-decoration: none; white-space: nowrap; }
  #shopify-section-{{ sid }} .spr__more:hover { text-decoration: underline; text-underline-offset: 4px; }
  #shopify-section-{{ sid }} .spr__arrows { display: none; gap: 8px; }
  #shopify-section-{{ sid }} .spr__arrow { width: 36px; height: 36px; border-radius: 50%; border: 0; padding: 0; display: grid; place-items: center; cursor: pointer; background: rgba(var(--color-heading-rgb), .1); color: var(--color-heading); transition: background-color .2s ease, opacity .2s ease; }
  #shopify-section-{{ sid }} .spr__arrow svg { width: 16px; height: 16px; }
  #shopify-section-{{ sid }} .spr__arrow:hover:not([disabled]) { background: rgba(var(--color-heading-rgb), .2); }
  #shopify-section-{{ sid }} .spr__arrow[disabled] { opacity: .35; cursor: default; }
  #shopify-section-{{ sid }} .spr__track { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  #shopify-section-{{ sid }} .spr--row .spr__track { grid-auto-flow: column; grid-auto-columns: {{ s.card_width_mobile | default: 78 }}%; overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scrollbar-width: none; margin-inline: calc(var(--container-gutter, 16px) * -1); padding-inline: var(--container-gutter, 16px); scroll-padding-inline: var(--container-gutter, 16px); }
  #shopify-section-{{ sid }} .spr--row .spr__track::-webkit-scrollbar { display: none; }
  #shopify-section-{{ sid }} .spr--grid .spr__track { grid-template-columns: repeat({{ s.columns_mobile | default: 1 }}, minmax(0, 1fr)); }
  #shopify-section-{{ sid }} .spr__card { position: relative; display: flex; flex-direction: column; min-width: 0; padding: 18px 18px 16px; border-radius: var(--spr-radius); background: var(--spr-card); scroll-snap-align: start; color: var(--color-text); transition: background-color .25s ease; }
  #shopify-section-{{ sid }} .spr__top { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; min-height: 14px; }
  #shopify-section-{{ sid }} .spr__type { font-size: 11px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--color-text); }
  #shopify-section-{{ sid }} .spr__badge { font-size: 11px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--spx-accent); white-space: nowrap; }
  #shopify-section-{{ sid }} .spr__title { margin: 4px 0 0; font-size: {{ s.title_size_mobile | default: 20 }}px; line-height: 1.1; letter-spacing: -0.01em; text-transform: {% if s.title_uppercase %}uppercase{% else %}none{% endif %}; }
  #shopify-section-{{ sid }} .spr__title a { color: var(--color-heading); text-decoration: none; }
  #shopify-section-{{ sid }} .spr__title a::after { content: ""; position: absolute; inset: 0; border-radius: inherit; z-index: 0; }
  #shopify-section-{{ sid }} .spr__card .ssp { position: relative; z-index: 1; display: flex; flex-direction: column; gap: 10px; margin-top: 10px; }
  #shopify-section-{{ sid }} .spr__cover { position: relative; display: block; aspect-ratio: 1; margin: 0 -6px; }
  #shopify-section-{{ sid }} .spr__cover img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; display: block; transition: transform .45s cubic-bezier(.2,.7,.2,1); }
  #shopify-section-{{ sid }} .spr__cover--empty { border-radius: calc(var(--spr-radius) * .6); background: rgba(var(--color-heading-rgb), .06); }
  #shopify-section-{{ sid }} .spr__card .ssp__btn { position: absolute; left: 50%; top: calc(50% - 26px); width: 56px; height: 56px; margin: -28px 0 0 -28px; background: rgba(var(--color-heading-rgb), .92); color: var(--color-background); box-shadow: 0 6px 24px rgba(0, 0, 0, .35); z-index: 2; }
  #shopify-section-{{ sid }} .spr__card .ssp.is-playing .ssp__btn { background: var(--spx-accent); color: var(--btn-primary-color, #fff); }
  #shopify-section-{{ sid }} .spr__card .ssp__wave { height: 26px; }
  #shopify-section-{{ sid }} .spr__card .ssp__time { min-width: 2.4em; text-align: right; }
  #shopify-section-{{ sid }} .spr__foot { position: relative; display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-top: 14px; }
  #shopify-section-{{ sid }} .spr__price { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 8px; font-size: 15px; font-weight: 600; color: var(--color-heading); font-variant-numeric: tabular-nums; }
  #shopify-section-{{ sid }} .spr__price s { font-weight: 500; color: var(--color-text); }
  #shopify-section-{{ sid }} .spr__price .is-sale { color: var(--spx-accent); }
  #shopify-section-{{ sid }} .spr__go { position: relative; z-index: 1; flex: none; width: 32px; height: 32px; border-radius: 50%; display: grid; place-items: center; background: rgba(var(--color-heading-rgb), .88); color: var(--color-background); transition: transform .2s ease, background-color .2s ease; }
  #shopify-section-{{ sid }} .spr__go svg { width: 14px; height: 14px; }
  #shopify-section-{{ sid }} .spr__card:hover .spr__go { transform: translateX(2px); background: rgb(var(--color-heading-rgb)); }
  #shopify-section-{{ sid }} .spr__note { margin: 6px 0 0; font-size: 12px; color: var(--color-text); }
  #shopify-section-{{ sid }} .spr__empty { padding: 24px; border-radius: var(--spr-radius); background: var(--spr-card); font-size: 15px; }
  @media (hover: hover) and (pointer: fine) {
    #shopify-section-{{ sid }} .spr__card:hover { background: color-mix(in srgb, var(--spr-card), rgb(var(--color-heading-rgb)) 4%); }
    #shopify-section-{{ sid }} .spr__card:hover .spr__cover img { transform: translateY(-4px) scale(1.02); }
    #shopify-section-{{ sid }} .spr__card .ssp__btn:hover { transform: scale(1.06); }
  }
  @media (min-width: 750px) {
    #shopify-section-{{ sid }} .spr { padding-block: {{ pt }}px {{ pb }}px; }
    #shopify-section-{{ sid }} .spr__heading { font-size: {{ s.heading_size | default: 44 }}px; }
    #shopify-section-{{ sid }} .spr__text { font-size: 16px; }
    #shopify-section-{{ sid }} .spr__head { margin-bottom: 32px; }
    #shopify-section-{{ sid }} .spr__arrows { display: flex; }
    #shopify-section-{{ sid }} .spr__track { gap: 16px; }
    #shopify-section-{{ sid }} .spr--row .spr__track { grid-auto-columns: calc((100% - 16px) / 2.3); margin-inline: 0; padding-inline: 0; }
    #shopify-section-{{ sid }} .spr--grid .spr__track { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    #shopify-section-{{ sid }} .spr__card { padding: 22px 22px 18px; }
    #shopify-section-{{ sid }} .spr__title { font-size: {{ s.title_size | default: 24 }}px; }
  }
  @media (min-width: 1100px) {
    #shopify-section-{{ sid }} .spr--row .spr__track { grid-auto-columns: calc((100% - {{ cols | minus: 1 | times: 16 }}px) / {{ cols }}); }
    #shopify-section-{{ sid }} .spr--grid .spr__track { grid-template-columns: repeat({{ cols }}, minmax(0, 1fr)); }
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .spr__cover img, #shopify-section-{{ sid }} .spr__go { transition: none; }
  }
</style>
<div class="spr spr--{{ layout }} section color-{{ color_scheme }} gradient" data-section-id="{{ sid }}"{% if s.anchor != blank %} id="{{ s.anchor | handleize }}" style="scroll-margin-top: 96px;"{% endif %}>
  <div class="{{ section_width }}">
    {%- if s.heading != blank or s.text != blank or s.link_label != blank -%}
      <div class="spr__head">
        <div>
          {%- if s.heading != blank -%}<h2 class="spr__heading h2">{{ s.heading }}</h2>{%- endif -%}
          {%- if s.text != blank -%}<div class="spr__text">{{ s.text }}</div>{%- endif -%}
        </div>
        <div class="spr__side">
          {%- if s.link_label != blank -%}<a class="spr__more" href="{{ s.link_url | default: routes.all_products_collection_url }}">{{ s.link_label | escape }}</a>{%- endif -%}
          {%- if layout == 'row' and section.blocks.size > 1 -%}
            <div class="spr__arrows">
              <button class="spr__arrow" type="button" data-spr-prev aria-label="Previous packs" disabled><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3 5 8l5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
              <button class="spr__arrow" type="button" data-spr-next aria-label="Next packs"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="m6 3 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <ul class="spr__track" role="list" data-spr-track>
        {%- for block in section.blocks -%}
          {%- liquid
            assign b = block.settings
            assign p = nil
            if b.product != blank
              assign want = b.product | handleize
              assign p = all_products[want]
              if p.id == blank
                assign p = nil
              endif
            endif
            assign title = b.title
            if p
              assign title = b.title | default: p.title
            endif
            assign link = b.link
            if p and link == blank
              assign link = p.url
            endif
            assign cover = b.cover
            if cover == blank and p
              assign cover = p.featured_image
            endif
            assign free = false
            if p
              if p.price == 0
                assign free = true
              endif
            elsif b.price == blank
              assign free = true
            endif
            assign ssp_audio = b.audio
            assign ssp_title = b.track_title | default: title
            assign ssp_peaks = b.peaks
            assign ssp_len = b.seconds
            assign ssp_id = 'ssp-' | append: sid | append: '-' | append: block.id
            assign ssp_class = 'spr__player'
          -%}
          {%- capture ssp_before -%}
            <span class="spr__cover{% if cover == blank %} spr__cover--empty{% endif %}">
              {%- if cover != blank -%}{{ cover | image_url: width: 720 | image_tag: loading: 'lazy', widths: '320, 480, 720', sizes: '(min-width: 1100px) 25vw, (min-width: 750px) 45vw, 78vw', alt: title }}{%- endif -%}
            </span>
          {%- endcapture -%}
          {%- assign ssp_after = '' -%}
          <li class="spr__card" {{ block.shopify_attributes }}>
            <div class="spr__top">
              <span class="spr__type">{{ b.type | escape }}</span>
              {%- if b.badge != blank -%}<span class="spr__badge">{{ b.badge | escape }}</span>{%- endif -%}
            </div>
            <h3 class="spr__title">{% if link != blank %}<a href="{{ link }}">{{ title | escape }}</a>{% else %}{{ title | escape }}{% endif %}</h3>
{%- liquid
  assign ssp_src = ssp_audio | strip
  if ssp_src != blank
    if ssp_src contains 'shopify://shop_images/'
      assign ssp_src = ssp_src | remove_first: 'shopify://shop_images/' | asset_url
    elsif ssp_src contains '/'
    else
      assign ssp_src = ssp_src | asset_url
    endif
  endif
  assign ssp_d = ''
  assign ssp_pk = ssp_peaks | strip | split: ','
  assign ssp_n = ssp_pk.size
  assign ssp_flat = false
  if ssp_n < 16
    assign ssp_n = 120
    assign ssp_flat = true
    for i in (1..120)
      assign ssp_x = i | minus: 0.5
      assign ssp_d = ssp_d | append: 'M' | append: ssp_x | append: ' 48.6V51.4'
    endfor
  else
    for ssp_v in ssp_pk
      assign ssp_hh = ssp_v | strip | plus: 0 | times: 0.46 | at_least: 1.4 | round: 1
      assign ssp_x = forloop.index | minus: 0.5
      assign ssp_y1 = 50 | minus: ssp_hh | round: 1
      assign ssp_y2 = 50 | plus: ssp_hh | round: 1
      assign ssp_d = ssp_d | append: 'M' | append: ssp_x | append: ' ' | append: ssp_y1 | append: 'V' | append: ssp_y2
    endfor
  endif
  assign ssp_label = ssp_title | default: 'track' | escape
  assign ssp_clock = '0:00'
  assign ssp_secs = ssp_len | plus: 0 | round
  if ssp_secs > 0
    assign ssp_m = ssp_secs | divided_by: 60
    assign ssp_s = ssp_secs | modulo: 60 | prepend: '0' | slice: -2, 2
    assign ssp_clock = ssp_m | append: ':' | append: ssp_s
  endif
-%}
<div class="ssp {{ ssp_class }}{% if ssp_src == blank %} ssp--off{% endif %}{% if ssp_flat %} ssp--flat{% endif %}{% if ssp_secs > 0 %} has-len{% endif %}" data-ssp{% if ssp_src != blank %} data-src="{{ ssp_src }}"{% endif %} data-title="{{ ssp_label }}"{% if ssp_secs > 0 %} data-len="{{ ssp_len | plus: 0 }}"{% endif %}{% unless ssp_flat %} data-peaks="{{ ssp_pk | join: ',' | strip | escape }}"{% endunless %}>
  {{ ssp_before }}
  <button class="ssp__btn" type="button" data-ssp-btn aria-label="Play {{ ssp_label }}"{% if ssp_src == blank %} disabled{% endif %}>
    <svg class="ssp__i ssp__i--play" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M4.6 2.9v10.2c0 .6.6.9 1.1.6l7.9-5.1c.5-.3.5-1 0-1.3L5.7 2.3c-.5-.3-1.1 0-1.1.6Z" fill="currentColor"/></svg>
    <svg class="ssp__i ssp__i--pause" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><rect x="3.8" y="2.8" width="3" height="10.4" rx="1" fill="currentColor"/><rect x="9.2" y="2.8" width="3" height="10.4" rx="1" fill="currentColor"/></svg>
  </button>
  <div class="ssp__row">
  <div class="ssp__wave" data-ssp-wave{% if ssp_src != blank %} role="slider" tabindex="0" aria-label="Seek in {{ ssp_label }}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-valuetext="0:00"{% endif %}>
    <svg class="ssp__svg" viewBox="0 0 {{ ssp_n }} 100" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path id="{{ ssp_id }}" d="{{ ssp_d }}" vector-effect="non-scaling-stroke"/></svg>
    <svg class="ssp__svg ssp__svg--hover" viewBox="0 0 {{ ssp_n }} 100" preserveAspectRatio="none" aria-hidden="true" focusable="false"><use href="#{{ ssp_id }}"/></svg>
    <svg class="ssp__svg ssp__svg--done" viewBox="0 0 {{ ssp_n }} 100" preserveAspectRatio="none" aria-hidden="true" focusable="false"><use href="#{{ ssp_id }}"/></svg>
    {%- if ssp_src != blank -%}<span class="ssp__head" aria-hidden="true"></span><span class="ssp__tip" aria-hidden="true" data-ssp-tip>0:00</span>{%- endif -%}
  </div>
  <span class="ssp__time" data-ssp-time>{% if ssp_src == blank %}No preview{% else %}{{ ssp_clock }}{% endif %}</span>
  </div>
  {{ ssp_after }}
</div>
            <div class="spr__foot">
              <div class="spr__price">
                {%- if free -%}
                  <span>{{ s.free_label | default: 'Free' | escape }}</span>
                {%- elsif p -%}
                  {%- if p.compare_at_price > p.price -%}<s>{{ p.compare_at_price | money }}</s><span class="is-sale">{{ p.price | money }}</span>{%- else -%}<span>{% if p.price_varies %}From {% endif %}{{ p.price | money }}</span>{%- endif -%}
                {%- else -%}
                  {%- if b.compare != blank -%}<s>{{ b.compare | escape }}</s><span class="is-sale">{{ b.price | escape }}</span>{%- else -%}<span>{{ b.price | escape }}</span>{%- endif -%}
                {%- endif -%}
              </div>
              {%- if link != blank -%}<span class="spr__go" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="m6 3 5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>{%- endif -%}
            </div>
            {%- if ssp_audio == blank and request.design_mode -%}<p class="spr__note">Add a preview file to make this card play.</p>{%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- elsif request.design_mode -%}
      <p class="spr__empty">Add a pack to this section. Each pack takes a product, a cover and a short preview.</p>
    {%- endif -%}
  </div>
</div>
<script>
  (function () {
    var root = document.querySelector('#shopify-section-{{ sid }} [data-spr-track]');
    if (!root) return;
    var sec = root.closest('.spr'), prev = sec.querySelector('[data-spr-prev]'), next = sec.querySelector('[data-spr-next]');
    if (!prev || !next) return;
    function step() { var c = root.querySelector('.spr__card'); return c ? c.getBoundingClientRect().width + 16 : root.clientWidth; }
    function sync() { var max = root.scrollWidth - root.clientWidth - 2; prev.disabled = root.scrollLeft <= 2; next.disabled = root.scrollLeft >= max; }
    prev.addEventListener('click', function () { root.scrollBy({ left: -step(), behavior: 'smooth' }); });
    next.addEventListener('click', function () { root.scrollBy({ left: step(), behavior: 'smooth' }); });
    root.addEventListener('scroll', function () { requestAnimationFrame(sync); }, { passive: true });
    if (window.ResizeObserver) new ResizeObserver(sync).observe(root);
    sync();
  })();
</script>
<script>
