{%- comment -%}
  Content creator: where to find them. A heading, then a tile per place
  (YouTube, Instagram, TikTok, LinkedIn, X, a podcast or the newsletter):
  its mark in a coloured square, the name, the handle and a line on what
  is posted there, every tile a link with an arrow that turns on hover.
  Three across on a computer, one on a phone.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign color_scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
-%}
<style>
  #shopify-section-{{ sid }} .cpz { background: {{ st.background | default: '#ffffff' }}; padding: {{ st.padding_top_mobile | default: 56 }}px 20px {{ st.padding_bottom_mobile | default: 56 }}px; scroll-margin-top: 80px; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .cpz { padding: {{ st.padding_top | default: 96 }}px 40px {{ st.padding_bottom | default: 96 }}px; } }
  #shopify-section-{{ sid }} .cpz__inner { max-width: 1200px; margin: 0 auto; }
  #shopify-section-{{ sid }} .cpz__eyebrow { margin: 0 0 12px; color: {{ st.accent_color | default: '#ff5a36' }}; font-size: 14px; font-weight: 700; }
  #shopify-section-{{ sid }} .cpz__heading { margin: 0; color: var(--color-heading); font-family: var(--heading-font, inherit); font-weight: var(--heading-weight, 700); font-size: {{ st.heading_size_mobile | default: 34 }}px; line-height: 1.05; letter-spacing: -0.03em; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .cpz__heading { font-size: {{ st.heading_size | default: 52 }}px; } }
  #shopify-section-{{ sid }} .cpz__heading em { font-style: normal; color: {{ st.accent_color | default: '#ff5a36' }}; }
  #shopify-section-{{ sid }} .cpz__grid { list-style: none; margin: 36px 0 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px; }
  @media (min-width: 750px) { #shopify-section-{{ sid }} .cpz__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .cpz__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin-top: 48px; } }
  #shopify-section-{{ sid }} .cpz__tile { display: grid; grid-template-columns: 52px minmax(0, 1fr) 24px; gap: 16px; align-items: center; padding: 18px 20px; border-radius: {{ st.radius | default: 18 }}px; border: 1px solid {{ st.line_color | default: '#e6e4de' }}; color: var(--color-heading); text-decoration: none; transition: border-color 0.2s ease, background-color 0.2s ease; }
  #shopify-section-{{ sid }} .cpz__tile:hover { border-color: var(--color-heading); background: {{ st.hover_color | default: '#f5f4f0' }}; }
  #shopify-section-{{ sid }} .cpz__mark { width: 52px; height: 52px; border-radius: 14px; display: grid; place-items: center; color: #fff; }
  #shopify-section-{{ sid }} .cpz__mark svg { width: 24px; height: 24px; }
  #shopify-section-{{ sid }} .cpz__name { display: block; font-size: 17px; font-weight: 700; }
  #shopify-section-{{ sid }} .cpz__handle { display: block; color: var(--color-text); font-size: 14px; }
  #shopify-section-{{ sid }} .cpz__line { display: block; margin-top: 4px; color: var(--color-text); font-size: 14px; line-height: 1.45; }
  #shopify-section-{{ sid }} .cpz__arrow { width: 20px; height: 20px; transition: transform 0.25s ease; }
  #shopify-section-{{ sid }} .cpz__tile:hover .cpz__arrow { transform: rotate(-45deg); }
  @media (prefers-reduced-motion: reduce) { #shopify-section-{{ sid }} .cpz__arrow { transition: none; } }
</style>
<div class="cpz color-{{ color_scheme }}" id="{{ st.anchor | default: 'follow' | handleize }}" data-section-id="{{ sid }}">
  <div class="cpz__inner">
    {%- if st.eyebrow != blank -%}<p class="cpz__eyebrow">{{ st.eyebrow | escape }}</p>{%- endif -%}
    {%- if st.heading != blank -%}<h2 class="cpz__heading">{{ st.heading }}</h2>{%- endif -%}
    <ul class="cpz__grid" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          case b.platform
            when 'youtube'
              assign bg = '#ff0033'
              assign name = 'YouTube'
            when 'instagram'
              assign bg = '#d62976'
              assign name = 'Instagram'
            when 'tiktok'
              assign bg = '#101114'
              assign name = 'TikTok'
            when 'linkedin'
              assign bg = '#0a66c2'
              assign name = 'LinkedIn'
            when 'x'
              assign bg = '#101114'
              assign name = 'X'
            when 'podcast'
              assign bg = '#7c3aed'
              assign name = 'Podcast'
            else
              assign bg = st.accent_color | default: '#ff5a36'
              assign name = 'Newsletter'
          endcase
          if b.name != blank
            assign name = b.name
          endif
          assign external = false
          if b.link contains 'http'
            assign external = true
          endif
        -%}
        <li {{ block.shopify_attributes }}>
          <a class="cpz__tile" href="{{ b.link | default: '/' }}"{% if external %} target="_blank" rel="noopener"{% endif %}>
            <span class="cpz__mark" style="background: {{ bg }}" aria-hidden="true">
              {%- case b.platform -%}
                {%- when 'youtube' -%}<svg viewBox="0 0 24 24" fill="currentColor"><path d="M23 7.2a3 3 0 0 0-2.1-2.1C19 4.6 12 4.6 12 4.6s-7 0-8.9.5A3 3 0 0 0 1 7.2 31 31 0 0 0 .5 12a31 31 0 0 0 .5 4.8 3 3 0 0 0 2.1 2.1c1.9.5 8.9.5 8.9.5s7 0 8.9-.5a3 3 0 0 0 2.1-2.1 31 31 0 0 0 .5-4.8 31 31 0 0 0-.5-4.8zM9.7 15.1V8.9L15.5 12z"/></svg>
                {%- when 'instagram' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
                {%- when 'tiktok' -%}<svg viewBox="0 0 24 24" fill="currentColor"><path d="M16.6 3c.3 2.3 1.7 3.9 4 4.1v3.1a7 7 0 0 1-4-1.3v6.2c0 3.5-2.6 5.9-5.8 5.9A5.8 5.8 0 0 1 5 15.2c0-3.4 2.9-6 6.4-5.6v3.2c-1.6-.4-3.2.7-3.2 2.4 0 1.5 1.2 2.6 2.6 2.6 1.6 0 2.7-1.1 2.7-3V3z"/></svg>
                {%- when 'linkedin' -%}<svg viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9.5h4V21H3zM9.5 9.5h3.8v1.6h.1c.5-1 1.8-2 3.8-2 4 0 4.8 2.6 4.8 6V21h-4v-5.2c0-1.3 0-2.9-1.8-2.9s-2 1.4-2 2.8V21h-4z"/></svg>
                {%- when 'x' -%}<svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.8 3h3.1l-6.8 7.7L22 21h-6.2l-4.9-6.3L5.3 21H2.2l7.2-8.2L1.8 3h6.4l4.4 5.8zm-1.1 16.2h1.7L7.4 4.7H5.6z"/></svg>
                {%- when 'podcast' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="9" y="2.5" width="6" height="11" rx="3"/><path d="M5.5 11a6.5 6.5 0 0 0 13 0M12 17.5V21"/></svg>
                {%- else -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="M3.5 6.5l8.5 6.5 8.5-6.5"/></svg>
              {%- endcase -%}
            </span>
            <span>
              <span class="cpz__name">{{ name | escape }}</span>
              {%- if b.handle != blank -%}<span class="cpz__handle">{{ b.handle | escape }}</span>{%- endif -%}
              {%- if b.line != blank -%}<span class="cpz__line">{{ b.line | escape }}</span>{%- endif -%}
            </span>
            <svg class="cpz__arrow" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10h12M11 5l5 5-5 5"/></svg>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>
{% schema %}
{
  "name": "Creator social links",
  "tag": "section",
  "class": "section sec__creatorpro-social",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default-color-scheme" },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#ff5a36" },
    { "type": "color", "id": "line_color", "label": "Tile border", "default": "#e6e4de" },
    { "type": "color", "id": "hover_color", "label": "Tile on hover", "default": "#f5f4f0" },
    { "type": "range", "id": "radius", "label": "Tile corners", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 18 },
    { "type": "text", "id": "anchor", "label": "Name for links to this section", "default": "follow" },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Follow along" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Find me <em>online</em>" },
    { "type": "range", "id": "heading_size", "label": "Heading size, desktop", "min": 28, "max": 80, "step": 2, "unit": "px", "default": 52 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size, phone", "min": 24, "max": 52, "step": 2, "unit": "px", "default": 34 },
    { "type": "range", "id": "padding_top", "label": "Space above, desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Space below, desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_top_mobile", "label": "Space above, phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Space below, phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    { "type": "place", "name": "Place", "settings": [
      { "type": "select", "id": "platform", "label": "Where", "default": "youtube", "options": [
        { "value": "youtube", "label": "YouTube" }, { "value": "instagram", "label": "Instagram" }, { "value": "tiktok", "label": "TikTok" },
        { "value": "linkedin", "label": "LinkedIn" }, { "value": "x", "label": "X" }, { "value": "podcast", "label": "Podcast" }, { "value": "newsletter", "label": "Newsletter" }
      ] },
      { "type": "text", "id": "name", "label": "Name", "info": "Leave empty to use the name of the place." },
      { "type": "text", "id": "handle", "label": "Handle", "default": "@yourname" },
      { "type": "text", "id": "line", "label": "Line", "default": "What you post there." },
      { "type": "text", "id": "link", "label": "Link" }
    ] }
  ],
  "max_blocks": 9,
  "presets": [ { "name": "Creator social links", "blocks": [ { "type": "place" }, { "type": "place", "settings": { "platform": "instagram" } }, { "type": "place", "settings": { "platform": "newsletter" } } ] } ]
}
{% endschema %}
