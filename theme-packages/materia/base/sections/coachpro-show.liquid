{%- comment -%}
  Coach creator: the show. A cover card (a portrait with the show's name set
  on it), a heading, a line, and buttons for the places to watch or listen;
  then the latest episodes as a numbered list, each with a round play
  button that opens the episode. Episodes are blocks; "Listen on" links are
  settings, so they can be left empty.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign hf = settings.font_heading_google_family
-%}
{%- if hf != blank and hf != 'none' -%}<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ hf | replace: ' ', '+' }}:ital@0;1&display=swap">{%- endif -%}
<style>
  #shopify-section-{{ sid }} .cps { --cps-ink: {{ st.heading_color | default: '#16120f' }}; --cps-accent: {{ st.accent_color | default: '#c2421f' }}; background: {{ st.background | default: '#f8ddd2' }}; color: {{ st.text_color | default: '#4a3a33' }}; padding: {{ st.padding_top_mobile | default: 56 }}px 20px {{ st.padding_bottom_mobile | default: 56 }}px; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .cps { padding: {{ st.padding_top | default: 104 }}px 40px {{ st.padding_bottom | default: 104 }}px; } }
  #shopify-section-{{ sid }} .cps__in { max-width: 1180px; margin: 0 auto; display: grid; grid-template-columns: minmax(0, 1fr); gap: 44px; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .cps__in { grid-template-columns: minmax(0, .82fr) minmax(0, 1fr); gap: 88px; align-items: start; } #shopify-section-{{ sid }} .cps__side { position: sticky; top: 110px; } }
  #shopify-section-{{ sid }} .cps__cover { position: relative; margin: 0 0 28px; aspect-ratio: 4 / 4.4; border-radius: 22px; overflow: hidden; background: #16120f; box-shadow: 0 30px 60px -34px rgba(60,20,10,.55); }
  #shopify-section-{{ sid }} .cps__cover img, #shopify-section-{{ sid }} .cps__cover svg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 20%; }
  #shopify-section-{{ sid }} .cps__cover::after { content: ""; position: absolute; inset: 0; background: linear-gradient(to top, rgba(14,10,8,.86) 0%, rgba(14,10,8,.15) 46%, transparent 70%); }
  #shopify-section-{{ sid }} .cps__mast { position: absolute; z-index: 1; left: 24px; right: 24px; bottom: 22px; color: #fff; }
  #shopify-section-{{ sid }} .cps__kind { display: inline-block; margin-bottom: 10px; padding: 5px 10px; border-radius: 999px; background: var(--cps-accent); font-size: 11px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
  #shopify-section-{{ sid }} .cps__show { display: block; font-family: var(--heading-font, serif); font-size: 44px; line-height: .95; letter-spacing: -.01em; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .cps__show { font-size: 54px; } }
  #shopify-section-{{ sid }} .cps__host { display: block; margin-top: 8px; font-size: 14px; opacity: .85; }
  #shopify-section-{{ sid }} .cps__eyebrow { margin: 0 0 12px; color: var(--cps-accent); font-size: 12px; font-weight: 700; letter-spacing: .2em; text-transform: uppercase; }
  #shopify-section-{{ sid }} .cps__title { margin: 0 0 14px; color: var(--cps-ink); font-family: var(--heading-font, serif); font-weight: 400; font-size: 40px; line-height: 1.02; letter-spacing: -.01em; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .cps__title { font-size: 52px; } }
  #shopify-section-{{ sid }} .cps__title em { font-style: italic; }
  #shopify-section-{{ sid }} .cps__text { font-size: 16.5px; line-height: 1.65; max-width: 34em; }
  #shopify-section-{{ sid }} .cps__text p { margin: 0 0 10px; }
  #shopify-section-{{ sid }} .cps__on { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 20px; }
  #shopify-section-{{ sid }} .cps__on a { display: inline-flex; align-items: center; gap: 9px; min-height: 46px; padding: 0 18px 0 14px; border-radius: 999px; background: #fff; color: var(--cps-ink); font-size: 14.5px; font-weight: 600; text-decoration: none; transition: transform .25s ease, box-shadow .25s ease; }
  #shopify-section-{{ sid }} .cps__on a:hover { transform: translateY(-2px); box-shadow: 0 10px 24px -14px rgba(60,20,10,.5); }
  #shopify-section-{{ sid }} .cps__on svg { width: 18px; height: 18px; color: var(--cps-accent); }
  #shopify-section-{{ sid }} .cps__latest { margin: 0 0 8px; color: var(--cps-ink); font-family: var(--heading-font, serif); font-weight: 400; font-size: 34px; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .cps__latest { font-size: 44px; } }
  #shopify-section-{{ sid }} .cps__list { margin: 0; padding: 0; list-style: none; }
  #shopify-section-{{ sid }} .cps__ep { border-bottom: 1px solid color-mix(in srgb, var(--cps-ink) 22%, transparent); }
  #shopify-section-{{ sid }} .cps__ep a { display: grid; grid-template-columns: 52px minmax(0, 1fr) 48px; gap: 14px; align-items: start; padding: 24px 0; color: inherit; text-decoration: none; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .cps__ep a { grid-template-columns: 64px minmax(0, 1fr) 56px; padding: 30px 0; } }
  #shopify-section-{{ sid }} .cps__no { padding-top: 6px; color: var(--cps-accent); font-size: 13px; font-weight: 600; letter-spacing: .04em; }
  #shopify-section-{{ sid }} .cps__ept { display: block; color: var(--cps-ink); font-family: var(--heading-font, serif); font-size: 24px; line-height: 1.15; transition: color .2s ease; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .cps__ept { font-size: 29px; } }
  #shopify-section-{{ sid }} .cps__meta { display: block; margin-top: 8px; font-size: 14px; }
  #shopify-section-{{ sid }} .cps__play { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%; background: #fff; color: var(--cps-ink); transition: background-color .25s ease, color .25s ease, transform .25s ease; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .cps__play { width: 56px; height: 56px; } }
  #shopify-section-{{ sid }} .cps__play svg { width: 14px; height: 14px; margin-left: 3px; }
  #shopify-section-{{ sid }} .cps__ep a:hover .cps__play { background: var(--cps-ink); color: #fff; transform: scale(1.05); }
  #shopify-section-{{ sid }} .cps__all { display: inline-flex; align-items: center; min-height: 52px; margin-top: 30px; padding: 0 26px; border-radius: 999px; background: var(--cps-ink); color: #fff; font-size: 15px; font-weight: 600; text-decoration: none; }
</style>
<section data-own-size class="cps"{% if st.anchor != blank %} id="{{ st.anchor | handleize }}"{% endif %}>
  <div class="cps__in">
    <div class="cps__side">
      <figure class="cps__cover">
        {%- if st.image != blank -%}
          <img src="{{ st.image | image_url: width: 800 }}" srcset="{{ st.image | image_url: width: 480 }} 480w, {{ st.image | image_url: width: 800 }} 800w" sizes="(min-width: 990px) 460px, 92vw" width="{{ st.image.width | default: 800 }}" height="{{ st.image.height | default: 1000 }}" alt="{{ st.image_alt | default: st.image.alt | escape }}" loading="lazy" decoding="async">
        {%- else -%}
          {{ 'image' | placeholder_svg_tag }}
        {%- endif -%}
        <figcaption class="cps__mast">
          {%- if st.kind != blank -%}<span class="cps__kind">{{ st.kind | escape }}</span>{%- endif -%}
          <span class="cps__show">{{ st.show_name | escape }}</span>
          {%- if st.host != blank -%}<span class="cps__host">{{ st.host | escape }}</span>{%- endif -%}
        </figcaption>
      </figure>
      {%- if st.eyebrow != blank -%}<p class="cps__eyebrow">{{ st.eyebrow | escape }}</p>{%- endif -%}
      {%- if st.heading != blank -%}<h2 class="cps__title">{{ st.heading }}</h2>{%- endif -%}
      {%- if st.text != blank -%}<div class="cps__text">{{ st.text }}</div>{%- endif -%}
      <div class="cps__on">
        {%- if st.youtube_label != blank -%}<a href="{{ st.youtube_url | default: '#' }}" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.6 7.2a2.6 2.6 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4A2.6 2.6 0 0 0 2.4 7.2 27 27 0 0 0 2 12a27 27 0 0 0 .4 4.8 2.6 2.6 0 0 0 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4a2.6 2.6 0 0 0 1.8-1.8A27 27 0 0 0 22 12a27 27 0 0 0-.4-4.8zM10 15V9l5.2 3z"/></svg>{{ st.youtube_label | escape }}</a>{%- endif -%}
        {%- if st.apple_label != blank -%}<a href="{{ st.apple_url | default: '#' }}" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="10" r="2.6"/><path d="M12 14.5v6M7.2 15.6a7 7 0 1 1 9.6 0"/></svg>{{ st.apple_label | escape }}</a>{%- endif -%}
        {%- if st.spotify_label != blank -%}<a href="{{ st.spotify_url | default: '#' }}" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"/><path d="M7.5 9.6c3-1 6.6-.7 9.2.8M8 12.7c2.5-.7 5.3-.4 7.4.8M8.6 15.6c2-.5 4-.3 5.6.6"/></svg>{{ st.spotify_label | escape }}</a>{%- endif -%}
      </div>
    </div>
    <div class="cps__main">
      {%- if st.list_heading != blank -%}<h3 class="cps__latest">{{ st.list_heading | escape }}</h3>{%- endif -%}
      <ol class="cps__list">
        {%- for block in section.blocks -%}
          <li class="cps__ep" {{ block.shopify_attributes }}>
            <a href="{{ block.settings.url | default: '#' }}">
              <span class="cps__no">{{ block.settings.number | escape }}</span>
              <span><span class="cps__ept">{{ block.settings.title | escape }}</span>{%- if block.settings.meta != blank -%}<span class="cps__meta">{{ block.settings.meta | escape }}</span>{%- endif -%}</span>
              <span class="cps__play" aria-hidden="true"><svg viewBox="0 0 12 14" fill="currentColor"><path d="M0 0l12 7-12 7z"/></svg></span>
            </a>
          </li>
        {%- endfor -%}
      </ol>
      {%- if st.all_label != blank -%}<a class="cps__all" href="{{ st.all_url | default: '#' }}">{{ st.all_label | escape }}</a>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Coach creator show",
  "tag": "section",
  "class": "coachpro-show-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "anchor", "label": "Name for links to this place", "default": "show", "info": "Link to /#show to scroll here." },
    { "type": "header", "content": "Cover" },
    { "type": "image_picker", "id": "image", "label": "Picture" },
    { "type": "text", "id": "image_alt", "label": "Alt text" },
    { "type": "text", "id": "kind", "label": "Label", "default": "Podcast" },
    { "type": "text", "id": "show_name", "label": "Show name", "default": "The Show" },
    { "type": "text", "id": "host", "label": "Host line", "default": "with Your Name" },
    { "type": "header", "content": "Words" },
    { "type": "text", "id": "eyebrow", "label": "Small line above", "default": "Watch and listen" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Watch it. Listen to it. <em>Use it.</em>" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>What the show is about and when new episodes come out.</p>" },
    { "type": "text", "id": "youtube_label", "label": "Video button", "default": "Watch on YouTube" },
    { "type": "url", "id": "youtube_url", "label": "Video link" },
    { "type": "text", "id": "apple_label", "label": "Podcast button", "default": "Apple Podcasts" },
    { "type": "url", "id": "apple_url", "label": "Podcast link" },
    { "type": "text", "id": "spotify_label", "label": "Third button", "default": "Spotify" },
    { "type": "url", "id": "spotify_url", "label": "Third link" },
    { "type": "header", "content": "Episodes" },
    { "type": "text", "id": "list_heading", "label": "Heading over the list", "default": "The latest" },
    { "type": "text", "id": "all_label", "label": "Button under the list", "default": "All episodes" },
    { "type": "url", "id": "all_url", "label": "Button link" },
    { "type": "header", "content": "Look" },
    { "type": "color", "id": "background", "label": "Background", "default": "#f8ddd2" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#c2421f" },
    { "type": "color", "id": "heading_color", "label": "Headings", "default": "#16120f" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#4a3a33" },
    { "type": "range", "id": "padding_top", "label": "Space above on a computer", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 104 },
    { "type": "range", "id": "padding_bottom", "label": "Space below on a computer", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 104 },
    { "type": "range", "id": "padding_top_mobile", "label": "Space above on a phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Space below on a phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    { "type": "episode", "name": "Episode", "limit": 8, "settings": [
      { "type": "text", "id": "number", "label": "Number", "default": "#01" },
      { "type": "text", "id": "title", "label": "Title", "default": "Episode title" },
      { "type": "text", "id": "meta", "label": "Guest or length", "default": "34 min" },
      { "type": "url", "id": "url", "label": "Link to the episode" }
    ] }
  ],
  "presets": [ { "name": "Coach creator show", "category": "Coach creator", "blocks": [ { "type": "episode" }, { "type": "episode", "settings": { "number": "#02" } }, { "type": "episode", "settings": { "number": "#03" } } ] } ]
}
{% endschema %}
