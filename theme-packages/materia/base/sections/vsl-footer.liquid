{%- comment -%}
Video sales letter: a small footer. The name or logo on the left, a few
  links on the right, a thin line and the copyright under them.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
-%}
{%- liquid
  assign menu = st.menu
-%}
<style>
  .vsl { position: relative; color: var(--vsl-text, #a3a3a8); font-family: var(--body-font, inherit); -webkit-font-smoothing: antialiased; }
  .vsl *, .vsl *::before, .vsl *::after { box-sizing: border-box; }
  .vsl__inner { position: relative; max-width: var(--vsl-max, 1120px); margin: 0 auto; padding: 0 20px; }
  .vsl__head { text-align: center; margin: 0 auto 44px; max-width: 760px; }
  .vsl__eyebrow { display: flex; align-items: center; justify-content: center; gap: 14px; margin: 0 0 18px; font-size: 11px; font-weight: 500; letter-spacing: .24em; text-transform: uppercase; color: rgba(255,255,255,.6); }
  .vsl__eyebrow::before, .vsl__eyebrow::after { content: ""; flex: 0 0 34px; height: 1px; background: linear-gradient(90deg, rgba(255,255,255,0), rgba(255,255,255,.5)); }
  .vsl__eyebrow::after { background: linear-gradient(270deg, rgba(255,255,255,0), rgba(255,255,255,.5)); }
  .vsl__title { margin: 0; color: var(--vsl-head, #fff); font-family: var(--heading-font, inherit); font-weight: 700; font-size: clamp(32px, 4.6vw, 52px); line-height: 1.06; letter-spacing: -.035em; text-wrap: balance; }
  .vsl__title em, .vsl em.vsl-serif { font-style: normal; color: rgba(255,255,255,.6); }
  .vsl__lede { margin: 16px auto 0; max-width: 580px; font-size: 15px; line-height: 1.65; }
  .vsl__lede p { margin: 0; }
  .vsl-btn {
    position: relative; isolation: isolate; overflow: hidden;
    display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 48px; padding: 0 24px;
    border-radius: 999px; border: 1px solid rgba(255,255,255,.24); background: rgba(10,10,12,.85); color: #fff;
    font-family: var(--body-font, inherit); font-size: 14px; font-weight: 600; letter-spacing: -.005em; text-decoration: none; white-space: nowrap;
    box-shadow: inset 0 1px 0 rgba(255,255,255,.22), 0 0 0 4px rgba(255,255,255,.03), 0 14px 40px -14px rgba(255,255,255,.35);
    transition: transform .35s cubic-bezier(.2,.7,.2,1), border-color .35s, box-shadow .35s;
  }
  .vsl-btn::before { content: ""; position: absolute; z-index: -1; top: -1px; left: -40%; width: 40%; height: 2px; background: linear-gradient(90deg, transparent, #fff, transparent); opacity: .9; transition: transform 1.1s cubic-bezier(.2,.7,.2,1); }
  .vsl-btn:hover { transform: translateY(-1px); border-color: rgba(255,255,255,.5); box-shadow: inset 0 1px 0 rgba(255,255,255,.3), 0 0 0 4px rgba(255,255,255,.05), 0 18px 50px -14px rgba(255,255,255,.45); }
  .vsl-btn:hover::before { transform: translateX(350%); }
  .vsl-btn:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
  .vsl-btn svg { width: 16px; height: 16px; flex: none; transition: transform .35s cubic-bezier(.2,.7,.2,1); }
  .vsl-btn:hover svg { transform: translateX(3px); }
  .vsl-btn--light { background: #fff; color: #0a0a0a; border-color: #fff; box-shadow: 0 14px 40px -14px rgba(255,255,255,.5); }
  .vsl-btn--light::before { display: none; }
  .vsl-btn--ghost { background: transparent; box-shadow: none; border-color: rgba(255,255,255,.16); }
  .vsl__actions { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 12px; margin-top: 30px; }
  .vsl-card {
    position: relative; border-radius: 18px; border: 1px solid rgba(255,255,255,.09);
    background: linear-gradient(180deg, rgba(255,255,255,.06), rgba(255,255,255,.015) 60%), rgba(12,12,14,.72);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.07), 0 30px 60px -40px rgba(0,0,0,.9);
  }
  .vsl--line { padding-top: 1px; }
  .vsl--line::before { content: ""; position: absolute; left: 50%; top: 0; width: min(1120px, calc(100% - 40px)); height: 1px; transform: translateX(-50%); background: linear-gradient(90deg, rgba(255,255,255,0), rgba(255,255,255,.26) 50%, rgba(255,255,255,0)); }
  .vsl--line::after { content: ""; position: absolute; left: 50%; top: 0; width: min(900px, 90%); height: 180px; transform: translateX(-50%); pointer-events: none; background: radial-gradient(50% 100% at 50% 0, rgba(255,255,255,.07), rgba(255,255,255,0)); }
  @media (max-width: 749px) { .vsl__eyebrow { letter-spacing: .18em; gap: 10px; } .vsl__eyebrow::before, .vsl__eyebrow::after { flex-basis: 22px; } .vsl__head { margin-bottom: 32px; } }
  html.vsl-js .vsl [data-motion][data-vsl-armed] { opacity: 0; transform: translate3d(0, 12px, 0); transition: opacity .45s cubic-bezier(.25,.6,.3,1), transform .45s cubic-bezier(.25,.6,.3,1); transition-delay: var(--d, 0ms); }
  html.vsl-js .vsl [data-motion][data-vsl-armed].is-in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    html.vsl-js .vsl [data-motion] { opacity: 1; transform: none; transition: none; }
    .vsl-btn, .vsl-btn::before, .vsl-btn svg { transition: none; }
  }

  #shopify-section-{{ sid }} .vsl { padding-top: {{ st.padding_top_mobile | default: 64 }}px; padding-bottom: {{ st.padding_bottom_mobile | default: 64 }}px; }
  @media (min-width: 750px) { #shopify-section-{{ sid }} .vsl { padding-top: {{ st.padding_top | default: 96 }}px; padding-bottom: {{ st.padding_bottom | default: 96 }}px; } }

  .vsl-foot__row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px 32px; padding-bottom: 26px; border-bottom: 1px solid rgba(255,255,255,.1); }
  .vsl-foot__brand { display: inline-flex; align-items: center; gap: 12px; color: #fff; text-decoration: none; font-size: 22px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
  .vsl-foot__brand svg { width: 28px; height: 28px; }
  #shopify-section-{{ sid }} .vsl-foot__brand img { display: block; width: {{ st.logo_width | default: 140 }}px; height: auto; }
  .vsl-foot__links { display: flex; flex-wrap: wrap; gap: 10px 26px; margin: 0; padding: 0; list-style: none; }
  .vsl-foot__links a { color: rgba(255,255,255,.62); font-size: 13px; text-decoration: none; transition: color .25s; }
  .vsl-foot__links a:hover { color: #fff; }
  .vsl-foot__pol { justify-content: center; margin-top: 18px; }
  .vsl-foot__pol a { font-size: 12px; color: rgba(255,255,255,.5); }
  .vsl-foot__pay { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin: 22px 0 0; padding: 0; list-style: none; }
  .vsl-foot__pay svg { display: block; width: 38px; height: 24px; }
  .vsl-foot__copy { margin: 22px 0 0; text-align: center; font-size: 12px; color: rgba(255,255,255,.42); }
  @media (max-width: 749px) { .vsl-foot__row { flex-direction: column; align-items: flex-start; } }
</style>
<footer data-own-font class="vsl{% if st.line_above %} vsl--line{% endif %} vsl-foot">
  <div class="vsl__inner">
    <div class="vsl-foot__row">
      <a class="vsl-foot__brand" href="{{ routes.root_url }}">
        {%- if st.logo != blank -%}
          {{ st.logo | image_url: width: 480 | image_tag: alt: shop.name, loading: 'lazy' }}
        {%- else -%}
          {%- if st.show_mark -%}{%- case st.mark -%}{%- when 'frame' -%}<svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 8V5a2 2 0 0 1 2-2h3M16 3h3a2 2 0 0 1 2 2v3M21 16v3a2 2 0 0 1-2 2h-3M8 21H5a2 2 0 0 1-2-2v-3"/><path d="M10 8.5v7l6-3.5z" fill="#fff" stroke="none"/></svg>{%- when 'wave' -%}<svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M3 10v4M7.5 6.5v11M12 3.5v17M16.5 7.5v9M21 10.5v3"/></svg>{%- when 'dot' -%}<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" fill="none" stroke="#fff" stroke-width="1.6" opacity=".5"/><circle cx="12" cy="12" r="4.5" fill="#fff"/></svg>{%- else -%}<svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M19.5 14.2A8 8 0 1 1 9.8 4.5a6.4 6.4 0 0 0 9.7 9.7z" fill="#fff"/><circle cx="18.3" cy="5.6" r="1.1" fill="#fff"/></svg>{%- endcase -%}{%- endif -%}
          <span>{{ st.brand_text | default: shop.name | escape }}</span>
        {%- endif -%}
      </a>
      {%- if menu != blank and menu.links.size > 0 -%}
        <ul class="vsl-foot__links" role="list">
          {%- for link in menu.links -%}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
    {%- if st.show_policies and shop.policies.size > 0 -%}
      <ul class="vsl-foot__links vsl-foot__pol" role="list">{%- for policy in shop.policies -%}<li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>{%- endfor -%}</ul>
    {%- endif -%}
    {%- if st.show_payment -%}
      <ul class="vsl-foot__pay" role="list" aria-label="Payment methods">
        <li>{% render 'payment-icon', method: 'visa', icon_class: 'icon icon--full-color' %}</li>
        <li>{% render 'payment-icon', method: 'master', icon_class: 'icon icon--full-color' %}</li>
        <li>{% render 'payment-icon', method: 'american_express', icon_class: 'icon icon--full-color' %}</li>
        <li>{% render 'payment-icon', method: 'paypal', icon_class: 'icon icon--full-color' %}</li>
        <li>{% render 'payment-icon', method: 'apple_pay', icon_class: 'icon icon--full-color' %}</li>
        <li>{% render 'payment-icon', method: 'google_pay', icon_class: 'icon icon--full-color' %}</li>
      </ul>
    {%- endif -%}
    <p class="vsl-foot__copy">&copy; {{ 'now' | date: '%Y' }} {{ st.copyright | default: shop.name | escape }}</p>
  </div>
</footer>

<script>
  (function () {
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;
    var still = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!('IntersectionObserver' in window) || still) return;
    document.documentElement.classList.add('vsl-js');
    if (!window.__vslSeen) {
      window.__vslSeen = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('is-in'); window.__vslSeen.unobserve(e.target); } });
      }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
    }
    /* Round 69: what is in the first screen is simply there; only what starts below it waits (armed). */
    root.querySelectorAll('[data-motion]:not(.is-in)').forEach(function (el) { var r = el.getBoundingClientRect(); if (r.top < innerHeight && r.bottom > 0) { el.classList.add('is-in'); return; } el.setAttribute('data-vsl-armed', ''); window.__vslSeen.observe(el); });
  })();
</script>

{%- liquid
  assign sp_show = false
  if st.sticky_on
    if st.sticky_pages == 'all'
      assign sp_show = true
    elsif request.page_type == 'index'
      assign sp_show = true
    elsif request.page_type == 'product' and st.sticky_pages == 'home_product'
      assign sp_show = true
    endif
  endif
-%}
{%- if sp_show -%}
{%- liquid
  assign sp_p = st.sticky_product
  if sp_p == blank or sp_p.title == blank
    assign sp_p = collections.all.products.first
  endif
  assign sp_title = st.sticky_text
  assign sp_amount = ''
  if sp_p != blank and sp_p.title != blank
    if sp_title == blank
      assign sp_title = sp_p.title
    endif
    assign sp_amount = sp_p.price | money_without_trailing_zeros
  endif
-%}
<style>
  .vsl-sticky-{{ sid }} { position: fixed; z-index: 45; left: 50%; bottom: calc(14px + env(safe-area-inset-bottom, 0px)); width: min(680px, calc(100% - 24px)); transform: translate3d(-50%, calc(100% + 40px), 0); opacity: 0;
    transition: transform .55s cubic-bezier(.2,.75,.2,1), opacity .4s; font-family: var(--body-font, inherit); -webkit-font-smoothing: antialiased; pointer-events: none; }
  .vsl-sticky-{{ sid }}.is-up { transform: translate3d(-50%, 0, 0); opacity: 1; pointer-events: auto; }
  .vsl-sticky__in { display: flex; align-items: center; gap: 14px; padding: 8px 8px 8px 20px; border-radius: 999px; border: 1px solid rgba(255,255,255,.14);
    background: rgba(14,14,16,.82); -webkit-backdrop-filter: blur(16px) saturate(140%); backdrop-filter: blur(16px) saturate(140%);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.12), 0 24px 60px -20px rgba(0,0,0,.9); }
  .vsl-sticky__text { flex: 1; min-width: 0; margin: 0; color: #fff; font-size: 14px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .vsl-sticky__price { margin-left: 8px; color: rgba(255,255,255,.6); font-weight: 500; font-variant-numeric: tabular-nums; }
  .vsl-sticky__btn { display: inline-flex; align-items: center; gap: 8px; min-height: 42px; padding: 0 20px; border-radius: 999px; background: #fff; color: #0a0a0a; font-size: 14px; font-weight: 600; text-decoration: none; white-space: nowrap; transition: background-color .3s; }
  .vsl-sticky__btn:hover { background: #e7e7ea; }
  .vsl-sticky__btn:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
  .vsl-sticky__btn svg { width: 15px; height: 15px; }
  {%- if st.sticky_phone_only %}@media (min-width: 750px) { .vsl-sticky-{{ sid }} { display: none; } }{% endif %}
  @media (max-width: 420px) { .vsl-sticky__price { display: none; } .vsl-sticky__in { padding-left: 16px; } }
  @media (prefers-reduced-motion: reduce) { .vsl-sticky-{{ sid }} { transition: opacity .2s; transform: translate3d(-50%, 0, 0); } }
</style>
<div class="vsl-sticky vsl-sticky-{{ sid }}" data-vsl-sticky data-after="{{ st.sticky_after | default: 700 }}">
  <div class="vsl-sticky__in">
    <p class="vsl-sticky__text">{{ sp_title | escape }}{%- if sp_amount != blank and st.sticky_show_price -%}<span class="vsl-sticky__price">{{ sp_amount }}</span>{%- endif -%}</p>
    <a class="vsl-sticky__btn" href="{% if request.page_type == 'product' %}#MainContent{% else %}{{ st.sticky_button_link | default: '#join' }}{% endif %}" tabindex="-1">{{ st.sticky_button_label | default: 'Join' | escape }}<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 8h10M9 4l4 4-4 4"/></svg></a>
  </div>
</div>
<script>
  (function () {
    var bar = document.querySelector('#shopify-section-{{ sid }} [data-vsl-sticky]');
    if (!bar || bar.hasAttribute('data-ready')) return;
    bar.setAttribute('data-ready', '');
    var btn = bar.querySelector('a'), after = Number(bar.dataset.after) || 700, blocked = 0, ticking = false;
    function set() {
      ticking = false;
      var up = window.scrollY > after && blocked === 0;
      if (up !== bar.classList.contains('is-up')) { bar.classList.toggle('is-up', up); btn.tabIndex = up ? 0 : -1; }
    }
    window.addEventListener('scroll', function () { if (!ticking) { ticking = true; requestAnimationFrame(set); } }, { passive: true });
    if ('IntersectionObserver' in window) {
      var seen = new Set();
      var io = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) seen.add(e.target); else seen.delete(e.target); }); blocked = seen.size; set(); });
      document.querySelectorAll('.vsl-offer, .vsl-foot, .shopify-section-group-footer-group, .product__info-wrapper, [data-vsl-video]').forEach(function (el) { io.observe(el); });
    }
    set();
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Small footer",
  "tag": "section",
  "class": "vsl-footer-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 60,
      "max": 260,
      "step": 4,
      "unit": "px",
      "default": 140
    },
    {
      "type": "text",
      "id": "brand_text",
      "label": "Name, when there is no logo",
      "info": "Empty: the store's name."
    },
    {
      "type": "checkbox",
      "id": "show_mark",
      "label": "Small mark before the name",
      "default": true
    },
    {
      "type": "select",
      "id": "mark",
      "label": "Mark",
      "default": "moon",
      "options": [
        {
          "value": "moon",
          "label": "Moon"
        },
        {
          "value": "frame",
          "label": "Viewfinder"
        },
        {
          "value": "wave",
          "label": "Sound wave"
        },
        {
          "value": "dot",
          "label": "Dot"
        }
      ]
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Links",
      "default": "footer"
    },
    {
      "type": "checkbox",
      "id": "show_policies",
      "label": "Links to the store's policies",
      "default": true,
      "info": "Each one the store has written in Website settings."
    },
    {
      "type": "checkbox",
      "id": "show_payment",
      "label": "Payment icons",
      "default": true,
      "info": "Visa, Mastercard, American Express, PayPal, Apple Pay and Google Pay."
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "After the copyright sign",
      "info": "Empty: the store's name."
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "checkbox",
      "id": "line_above",
      "label": "Thin glowing line above",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Space above, desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Space below, desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Space above, phone",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Space below, phone",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "header",
      "content": "Sticky offer bar"
    },
    {
      "type": "checkbox",
      "id": "sticky_on",
      "label": "Show a bar that rises from the bottom",
      "default": false,
      "info": "It appears once the visitor scrolls past the opening, and steps aside while the price card or the footer is on screen."
    },
    {
      "type": "select",
      "id": "sticky_pages",
      "label": "On",
      "default": "home_product",
      "options": [
        {
          "value": "home",
          "label": "The home page"
        },
        {
          "value": "home_product",
          "label": "The home page and product pages"
        },
        {
          "value": "all",
          "label": "Every page"
        }
      ]
    },
    {
      "type": "product",
      "id": "sticky_product",
      "label": "Course",
      "info": "Name and price come from this product. Your first product when none is picked."
    },
    {
      "type": "text",
      "id": "sticky_text",
      "label": "Words on the bar",
      "info": "Leave empty to use the product's name."
    },
    {
      "type": "checkbox",
      "id": "sticky_show_price",
      "label": "Show the price",
      "default": true
    },
    {
      "type": "text",
      "id": "sticky_button_label",
      "label": "Button",
      "default": "Join"
    },
    {
      "type": "url",
      "id": "sticky_button_link",
      "label": "Button link",
      "info": "Empty scrolls to the price card (#join)."
    },
    {
      "type": "range",
      "id": "sticky_after",
      "label": "Shows after scrolling",
      "min": 200,
      "max": 2000,
      "step": 50,
      "unit": "px",
      "default": 700
    },
    {
      "type": "checkbox",
      "id": "sticky_phone_only",
      "label": "Only on phones",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Small footer",
      "category": "Video sales letter"
    }
  ]
}
{% endschema %}
