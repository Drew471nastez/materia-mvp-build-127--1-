{%- comment -%}
  Coach, second look: ways to work together. A heading row, then cards
  side by side: a photograph, a label, a name, a price with what it covers,
  a line, a short list and a button. One card can be marked as the one
  most people start with; it takes the accent colour.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign color_scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
  assign cards = section.blocks | where: 'type', 'offer'
-%}
<style>
  #shopify-section-{{ sid }} .c2o { --ink: {{ st.ink }}; --muted: {{ st.muted }}; --accent: {{ st.accent }}; --line: {{ st.line_color }}; background: {{ st.background }}; padding: {{ st.padding_top_mobile }}px 16px {{ st.padding_bottom_mobile }}px; }
  @media (min-width: 750px) { #shopify-section-{{ sid }} .c2o { padding: {{ st.padding_top }}px 32px {{ st.padding_bottom }}px; } }
  #shopify-section-{{ sid }} .c2o__inner { max-width: var(--page-width, 1310px); margin: 0 auto; }
  #shopify-section-{{ sid }} .c2o__head { display: grid; gap: 14px; margin-bottom: 40px; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .c2o__head { grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr); align-items: end; gap: 64px; } }
  #shopify-section-{{ sid }} .c2o__eyebrow { margin: 0 0 12px; color: var(--accent); font-size: 13px; font-weight: 600; letter-spacing: .04em; }
  #shopify-section-{{ sid }} .c2o__h { margin: 0; color: var(--ink); font-family: var(--heading-font, inherit); font-weight: 700; letter-spacing: -0.035em; line-height: 1.04; font-size: 34px; text-wrap: balance; }
  @media (min-width: 750px) { #shopify-section-{{ sid }} .c2o__h { font-size: 52px; } }
  #shopify-section-{{ sid }} .c2o__t { margin: 0; color: var(--muted); font-size: 16.5px; line-height: 1.6; }
  #shopify-section-{{ sid }} .c2o__t p { margin: 0; }
  #shopify-section-{{ sid }} .c2o__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 16px; }
  @media (min-width: 750px) { #shopify-section-{{ sid }} .c2o__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1100px) { #shopify-section-{{ sid }} .c2o__grid { grid-template-columns: repeat({{ cards.size | at_most: 3 | at_least: 1 }}, minmax(0, 1fr)); gap: 20px; } }
  #shopify-section-{{ sid }} .c2o__card { display: flex; flex-direction: column; border: 1px solid var(--line); border-radius: 10px; background: #fff; overflow: hidden; }
  #shopify-section-{{ sid }} .c2o__card--on { background: var(--ink); border-color: var(--ink); }
  #shopify-section-{{ sid }} .c2o__pic { position: relative; aspect-ratio: 16 / 10; margin: 0; background: #e8eaee; overflow: hidden; }
  #shopify-section-{{ sid }} .c2o__pic img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; margin: 0; transition: transform .6s ease; }
  #shopify-section-{{ sid }} .c2o__card:hover .c2o__pic img { transform: scale(1.03); }
  #shopify-section-{{ sid }} .c2o__flag { position: absolute; top: 14px; left: 14px; padding: 6px 10px; border-radius: 4px; background: var(--accent); color: #fff; font-size: 12px; font-weight: 600; letter-spacing: .02em; }
  #shopify-section-{{ sid }} .c2o__body { display: flex; flex-direction: column; flex: 1; padding: 26px; }
  #shopify-section-{{ sid }} .c2o__label { margin: 0 0 8px; color: var(--muted); font-size: 13px; font-weight: 600; }
  #shopify-section-{{ sid }} .c2o__name { margin: 0; color: var(--ink); font-family: var(--heading-font, inherit); font-size: 26px; font-weight: 700; letter-spacing: -0.025em; line-height: 1.12; }
  #shopify-section-{{ sid }} .c2o__price { display: flex; align-items: baseline; gap: 8px; margin: 16px 0 0; color: var(--ink); }
  #shopify-section-{{ sid }} .c2o__price b { font-family: var(--heading-font, inherit); font-size: 34px; font-weight: 700; letter-spacing: -0.03em; }
  #shopify-section-{{ sid }} .c2o__price span { color: var(--muted); font-size: 14px; }
  #shopify-section-{{ sid }} .c2o__text { margin: 12px 0 0; color: var(--muted); font-size: 15px; line-height: 1.55; }
  #shopify-section-{{ sid }} .c2o__list { margin: 18px 0 0; padding: 18px 0 0; border-top: 1px solid var(--line); list-style: none; display: grid; gap: 10px; }
  #shopify-section-{{ sid }} .c2o__list li { display: grid; grid-template-columns: 18px minmax(0, 1fr); gap: 10px; color: var(--ink); font-size: 14.5px; line-height: 1.45; }
  #shopify-section-{{ sid }} .c2o__list svg { width: 18px; height: 18px; margin-top: 1px; color: var(--accent); }
  #shopify-section-{{ sid }} .c2o__btn { display: flex; align-items: center; justify-content: center; min-height: 50px; margin-top: auto; border-radius: 6px; border: 1.5px solid var(--ink); color: var(--ink); font-size: 15px; font-weight: 600; text-decoration: none; transition: background-color .2s ease, color .2s ease; }
  #shopify-section-{{ sid }} .c2o__spacer { flex: 1; min-height: 24px; }
  #shopify-section-{{ sid }} .c2o__btn:hover { background: var(--ink); color: #fff; }
  #shopify-section-{{ sid }} .c2o__card--on .c2o__name, #shopify-section-{{ sid }} .c2o__card--on .c2o__price, #shopify-section-{{ sid }} .c2o__card--on .c2o__list li { color: #fff; }
  #shopify-section-{{ sid }} .c2o__card--on .c2o__label, #shopify-section-{{ sid }} .c2o__card--on .c2o__text, #shopify-section-{{ sid }} .c2o__card--on .c2o__price span { color: #b7bcc8; }
  #shopify-section-{{ sid }} .c2o__card--on .c2o__list { border-color: #2a2e37; }
  #shopify-section-{{ sid }} .c2o__card--on .c2o__list svg { color: #8c9aff; }
  #shopify-section-{{ sid }} .c2o__card--on .c2o__btn { background: var(--accent); border-color: var(--accent); color: #fff; }
  #shopify-section-{{ sid }} .c2o__card--on .c2o__btn:hover { background: #fff; border-color: #fff; color: var(--ink); }
  #shopify-section-{{ sid }} .c2o__note { margin: 22px 0 0; color: var(--muted); font-size: 14px; text-align: center; }
  #shopify-section-{{ sid }} .c2o__note a { color: var(--ink); text-underline-offset: 3px; }
</style>

<div class="c2o color-{{ color_scheme }}">
  <div class="c2o__inner">
    <div class="c2o__head">
      <div>
        {%- if st.eyebrow != blank -%}<p class="c2o__eyebrow">{{ st.eyebrow | escape }}</p>{%- endif -%}
        {%- if st.heading != blank -%}<h2 class="c2o__h">{{ st.heading }}</h2>{%- endif -%}
      </div>
      {%- if st.text != blank -%}<div class="c2o__t">{{ st.text }}</div>{%- endif -%}
    </div>
    <div class="c2o__grid">
      {%- for b in cards -%}
        {%- assign bs = b.settings -%}
        <article class="c2o__card{% if bs.featured %} c2o__card--on{% endif %}" {{ b.shopify_attributes }}>
          {%- if bs.image != blank -%}
            <figure class="c2o__pic">
              <img src="{{ bs.image | image_url: width: 800 }}" srcset="{{ bs.image | image_url: width: 500 }} 500w, {{ bs.image | image_url: width: 800 }} 800w" sizes="(min-width: 1100px) 420px, (min-width: 750px) 46vw, 94vw" width="{{ bs.image.width | default: 800 }}" height="{{ bs.image.height | default: 500 }}" alt="{{ bs.image_alt | escape }}" loading="lazy" decoding="async">
              {%- if bs.featured and bs.flag != blank -%}<span class="c2o__flag">{{ bs.flag | escape }}</span>{%- endif -%}
            </figure>
          {%- endif -%}
          <div class="c2o__body">
            {%- if bs.label != blank -%}<p class="c2o__label">{{ bs.label | escape }}</p>{%- endif -%}
            <h3 class="c2o__name">{{ bs.title | escape }}</h3>
            {%- if bs.price != blank -%}<p class="c2o__price"><b>{{ bs.price | escape }}</b>{% if bs.per != blank %}<span>{{ bs.per | escape }}</span>{% endif %}</p>{%- endif -%}
            {%- if bs.text != blank -%}<p class="c2o__text">{{ bs.text | escape }}</p>{%- endif -%}
            {%- assign lines = bs.points | newline_to_br | split: '<br />' -%}
            {%- if bs.points != blank -%}
              <ul class="c2o__list">
                {%- for l in lines -%}{%- assign lt = l | strip -%}{%- if lt != blank -%}<li><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10.5l4 4 8-9"/></svg><span>{{ lt | escape }}</span></li>{%- endif -%}{%- endfor -%}
              </ul>
            {%- endif -%}
            <div class="c2o__spacer"></div>
            {%- if bs.button_label != blank -%}<a class="c2o__btn" href="{{ bs.button_link | default: '/pages/book' }}">{{ bs.button_label | escape }}</a>{%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
    {%- if st.note != blank -%}<div class="c2o__note">{{ st.note }}</div>{%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Coach offers",
  "tag": "section",
  "class": "section sec__coach2-offers",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default-color-scheme" },
    { "type": "color", "id": "background", "label": "Background", "default": "#f3f4f6" },
    { "type": "color", "id": "ink", "label": "Heading colour", "default": "#0f1115" },
    { "type": "color", "id": "muted", "label": "Text colour", "default": "#4b5160" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#2b44ff" },
    { "type": "color", "id": "line_color", "label": "Lines", "default": "#e4e6ea" },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Work with me" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Ways to work together" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "richtext", "id": "note", "label": "Line under the cards" },
    { "type": "range", "id": "padding_top", "label": "Space above, desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 104 },
    { "type": "range", "id": "padding_bottom", "label": "Space below, desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 104 },
    { "type": "range", "id": "padding_top_mobile", "label": "Space above, phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Space below, phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    { "type": "offer", "name": "Offer", "settings": [
      { "type": "image_picker", "id": "image", "label": "Photograph" },
      { "type": "text", "id": "image_alt", "label": "Alt text" },
      { "type": "checkbox", "id": "featured", "label": "Mark as the one most people start with", "default": false },
      { "type": "text", "id": "flag", "label": "Mark", "default": "Most people start here" },
      { "type": "text", "id": "label", "label": "Small label", "default": "One to one" },
      { "type": "text", "id": "title", "label": "Name", "default": "Offer name" },
      { "type": "text", "id": "price", "label": "Price", "default": "$0" },
      { "type": "text", "id": "per", "label": "After the price", "default": "a month" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "Who it is for and what it gets done." },
      { "type": "textarea", "id": "points", "label": "List", "info": "One point per line.", "default": "First point\nSecond point\nThird point" },
      { "type": "text", "id": "button_label", "label": "Button", "default": "Book a call" },
      { "type": "url", "id": "button_link", "label": "Button link" }
    ] }
  ],
  "presets": [ { "name": "Coach offers", "blocks": [ { "type": "offer" }, { "type": "offer", "settings": { "featured": true } }, { "type": "offer" } ] } ]
}
{% endschema %}
