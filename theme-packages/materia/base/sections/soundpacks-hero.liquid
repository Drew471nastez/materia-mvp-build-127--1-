{% schema %}
{
  "name": "Hero with floating previews",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "inline_richtext", "id": "pill", "label": "Pill", "info": "Bold words take the accent colour." },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Sounds for your next track." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Sample packs made in our own studio. Press play on any of them.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Browse packs" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "button_2_label", "label": "Second button label" },
    { "type": "url", "id": "button_2_link", "label": "Second button link" },
    { "type": "text", "id": "note", "label": "Line under the buttons" },
    { "type": "text", "id": "chips_label", "label": "Name of the previews, for screen readers", "default": "Previews" },
    { "type": "header", "content": "Look" },
    { "type": "color", "id": "button_from", "label": "Button gradient, first colour", "info": "Set both to lay a gradient over the primary button." },
    { "type": "color", "id": "button_to", "label": "Button gradient, second colour" },
    { "type": "color", "id": "accent", "label": "Accent", "info": "Bold words in the pill and the playing wave. Left empty, the scheme's button colour." },
    { "type": "checkbox", "id": "show_glow", "label": "Glow behind the heading", "default": true },
    { "type": "color", "id": "glow_color", "label": "Glow colour", "default": "#ff7a6b" },
    { "type": "range", "id": "glow_strength", "label": "Glow strength", "min": 0, "max": 60, "step": 2, "unit": "%", "default": 14 },
    { "type": "checkbox", "id": "show_lines", "label": "Thin vertical lines", "default": true },
    { "type": "image_picker", "id": "background", "label": "Background picture" },
    { "type": "range", "id": "image_opacity", "label": "Picture strength", "min": 5, "max": 100, "step": 5, "unit": "%", "default": 30 },
    { "type": "checkbox", "id": "float", "label": "Previews float gently", "default": true },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 36, "max": 120, "step": 2, "unit": "px", "default": 84 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size on phones", "min": 28, "max": 64, "step": 2, "unit": "px", "default": 44 },
    { "type": "range", "id": "content_width", "label": "Text width", "min": 480, "max": 1000, "step": 20, "unit": "px", "default": 760 },
    { "type": "range", "id": "min_height", "label": "Height on a computer", "min": 400, "max": 900, "step": 20, "unit": "px", "default": 640 },
    { "type": "header", "content": "General" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 120 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 120 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top padding on phones", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom padding on phones", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 56 }
