  .r98-icons { position: relative; z-index: 2; display: flex; flex-wrap: wrap; gap: 4px; padding: 14px 10px 2px; margin: 0 auto; max-width: 1180px; list-style: none; }
  .r98-icon { width: 84px; display: flex; flex-direction: column; align-items: center; gap: 4px; padding: 4px 2px; color: #fff; text-decoration: none; text-align: center; outline: none; }
  .r98-icon .r98-ico { width: 36px; height: 36px; }
  .r98-icon span { padding: 1px 3px; font-family: var(--r-px); font-size: 13px; line-height: 1.2; text-shadow: 1px 1px 0 rgba(0,0,0,.55); border: 1px dotted transparent; }
  .r98-icon:hover span, .r98-icon:focus-visible span { background: var(--r-sel); border-color: #ffff80; text-shadow: none; }
  .r98-icon:hover .r98-ico, .r98-icon:focus-visible .r98-ico { filter: brightness(.7) sepia(1) hue-rotate(190deg) saturate(3); }
  @media (min-width: 1400px) {
    .r98-icons { position: absolute; left: 14px; top: 18px; flex-direction: column; padding: 0; gap: 10px; max-width: none; }
  }
  @media (max-width: 749px) {
    .r98-icons { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); padding: 12px 6px 4px; gap: 6px 0; }
    .r98-icon { width: auto; }
  }

  .r98-task { position: fixed; left: 0; right: 0; bottom: 0; z-index: 60; background: var(--r-face); padding-bottom: env(safe-area-inset-bottom, 0px); box-shadow: inset 0 1px var(--r-light), inset 0 2px var(--r-hi); font-family: var(--r-px); }
  .r98-task__in { display: flex; align-items: center; gap: 4px; height: 44px; padding: 4px 4px 2px; }
  .r98-start { display: inline-flex; align-items: center; gap: 6px; height: 34px; min-width: 0; padding: 0 10px 0 6px; font-weight: 700; font-size: 17px; }
  .r98-start .r98-ico { width: 22px; height: 22px; }
  .r98-task__sep { align-self: stretch; width: 2px; margin: 2px 2px; box-shadow: inset 1px 0 var(--r-shadow), inset -1px 0 var(--r-hi); }
  .r98-task__wins { flex: 1; min-width: 0; display: flex; gap: 4px; overflow: hidden; }
  .r98-tw { cursor: default; justify-content: flex-start; min-width: 0; max-width: 200px; flex: 0 1 200px; height: 34px; padding: 0 8px; font-size: 14px; }
  button.r98-tw { cursor: pointer; }
  .r98-tw span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .r98-tw .r98-ico { width: 16px; height: 16px; flex: none; }
  .r98-tw.is-current { background-image: repeating-conic-gradient(#c0c0c0 0 25%, #fff 0 50%); background-size: 2px 2px; font-weight: 700; }
  .r98-tray { display: flex; align-items: center; gap: 2px; height: 34px; padding: 0 6px 0 4px; flex: none; }
  .r98-tray a { position: relative; display: grid; place-items: center; width: 30px; height: 30px; color: #000; }
  .r98-tray a:focus-visible { outline: 1px dotted #000; }
  .r98-tray .r98-ico { width: 20px; height: 20px; }
  .r98-count { position: absolute; top: 0; right: -2px; min-width: 16px; height: 15px; padding: 0 3px; background: #e0201b; color: #fff; font-size: 11px; line-height: 15px; text-align: center; box-shadow: 1px 1px 0 #000; }
  .r98-count[hidden] { display: none; }
  .r98-clock { min-width: 62px; padding: 0 4px 0 6px; font-size: 14px; text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .r98-menu { position: fixed; left: 2px; bottom: calc(44px + env(safe-area-inset-bottom, 0px)); z-index: 61; display: flex; width: min(300px, calc(100vw - 4px)); max-height: calc(100vh - 60px); overflow: auto;
    transform-origin: 0 100%; transition: transform .16s steps(4), opacity .16s steps(4); }
  .r98-menu[hidden] { display: none; }
  .r98-menu.is-opening { transform: translateY(12px); opacity: 0; }
  .r98-menu__side { flex: 0 0 30px; display: flex; align-items: flex-end; justify-content: center; padding: 8px 0; background: linear-gradient(0deg, var(--r-t1), var(--r-t2)); }
  .r98-menu__side span { writing-mode: vertical-rl; transform: rotate(180deg); color: #fff; font-family: var(--r-px); font-weight: 700; font-size: 20px; letter-spacing: .02em; white-space: nowrap; }
  .r98-menu__list { flex: 1; min-width: 0; margin: 0; padding: 2px 0; list-style: none; }
  .r98-menu__list a { display: flex; align-items: center; gap: 10px; min-height: 40px; padding: 4px 12px 4px 8px; color: #000; text-decoration: none; font-family: var(--r-px); font-size: 16px; }
  .r98-menu__list a:hover, .r98-menu__list a:focus-visible { background: var(--r-sel); color: #fff; outline: none; }
  .r98-menu__list .r98-ico { width: 28px; height: 28px; flex: none; }
  .r98-menu__rule { height: 2px; margin: 3px 4px; box-shadow: inset 0 1px var(--r-shadow), inset 0 -1px var(--r-hi); }
  @media (max-width: 749px) {
    .r98-task__wins { display: none; }
    .r98-task__sep { display: none; }
    .r98-tray { margin-left: auto; }
    .r98-tray .r98-tray__acc { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .r98-menu { transition: none; } }
