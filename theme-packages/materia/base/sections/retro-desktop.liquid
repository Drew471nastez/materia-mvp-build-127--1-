  {%- elsif wall == 'dots' %}
  #shopify-section-{{ sid }} .r98-wall { background-color: {{ wall_color }}; background-image: radial-gradient(rgba(255,255,255,.12) 1px, transparent 1.2px); background-size: 6px 6px; }
