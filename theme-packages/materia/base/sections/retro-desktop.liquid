{%- comment -%}
Retro desktop: the computer the whole website sits on. Placed in the
  header group, so every page has it:

  the wallpaper, drawn here (a teal screen, green hills under a blue sky, or
  a dusk), fixed behind the page and painted once;

  the taskbar along the bottom with a Start button (the main menu, the
  footer menu, search, account and cart), the cart with its count and a
  clock;

  desktop icons (blocks) down the left of a wide screen, or in a row above
  the first window on a narrow one;

  and, with "Draw every section as a window", the theme's own sections (the
  product, the cart, search, the blog) in a grey window with a title bar.
  The title bar names the page. Nothing here is a picture file: the icons
  are drawn pixel by pixel in SVG.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
-%}
{%- capture r98_title -%}
  {%- case request.page_type -%}
    {%- when 'index' -%}{{ st.home_title | default: shop.name }}
    {%- when 'product' -%}{{ product.title }}
    {%- when 'collection' -%}{{ collection.title | default: 'Shop' }}
    {%- when 'list-collections' -%}Collections
    {%- when 'cart' -%}Cart
    {%- when 'search' -%}Search
    {%- when 'page' -%}{{ page.title }}
    {%- when 'blog' -%}{{ blog.title | default: 'Journal' }}
    {%- when 'article' -%}{{ article.title }}
    {%- when '404' -%}Not found
    {%- when 'policy' -%}{{ page_title }}
    {%- else -%}{{ page_title | default: shop.name }}
  {%- endcase -%}
{%- endcapture -%}
{%- assign r98_title = r98_title | strip | strip_newlines | replace: '\', '' | replace: '"', "'" | replace: '<', '' | replace: '>', '' -%}
{%- assign r98_shop = shop.name | replace: '\', '' | replace: '"', "'" | replace: '<', '' | replace: '>', '' -%}
{%- liquid
  assign wall = st.wallpaper | default: 'teal'
  assign wall_color = st.wall_color | default: '#008080'
  assign show_icons = true
  if st.icons_home_only and request.page_type != 'index'
    assign show_icons = false
  endif
  assign menu = st.menu
  assign menu2 = st.menu_2
-%}
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Pixelify+Sans:wght@400;500;600;700&display=swap" data-r98-font>
<style>
  .r98 { --r-face: #c0c0c0; --r-light: #dfdfdf; --r-hi: #ffffff; --r-shadow: #808080; --r-dark: #0a0a0a; --r-t1: #000080; --r-t2: #1084d0; --r-sel: #000080;
    --r-px: 'Pixelify Sans', ui-monospace, 'Courier New', monospace; color: #111; font-family: var(--body-font, Arial, sans-serif); font-size: 14px; line-height: 1.5; }
  .r98 *, .r98 *::before, .r98 *::after { box-sizing: border-box; }
  .r98-win { position: relative; background: var(--r-face); padding: 3px; box-shadow: inset -1px -1px var(--r-dark), inset 1px 1px var(--r-light), inset -2px -2px var(--r-shadow), inset 2px 2px var(--r-hi), 6px 6px 0 rgba(0,0,0,.18); }
  .r98-bar { display: flex; align-items: center; gap: 6px; min-height: 26px; padding: 2px 3px 2px 5px; background: linear-gradient(90deg, var(--r-t1), var(--r-t2)); color: #fff; font-family: var(--r-px); font-size: 15px; font-weight: 600; letter-spacing: .01em; user-select: none; -webkit-user-select: none; }
  .r98-bar .r98-ico { width: 16px; height: 16px; flex: none; }
  .r98-bar__title { flex: 1; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; margin: 0; font: inherit; color: inherit; }
  .r98-bar__btns { display: flex; gap: 2px; flex: none; }
  .r98-ctl { display: grid; place-items: center; width: 22px; height: 20px; margin: 0; padding: 0; border: 0; border-radius: 0; cursor: pointer; color: #000; background: var(--r-face);
    box-shadow: inset -1px -1px var(--r-dark), inset 1px 1px var(--r-hi), inset -2px -2px var(--r-shadow), inset 2px 2px var(--r-light); }
  .r98-ctl svg { width: 10px; height: 10px; }
  .r98-ctl:active { box-shadow: inset 1px 1px var(--r-dark), inset -1px -1px var(--r-hi), inset 2px 2px var(--r-shadow), inset -2px -2px var(--r-light); }
  .r98-ctl:active svg { transform: translate(1px, 1px); }
  .r98-ctl:focus-visible, .r98-btn:focus-visible { outline: 1px dotted #000; outline-offset: -5px; }
  .r98-btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 36px; min-width: 96px; margin: 0; padding: 0 18px; border: 0; border-radius: 0; cursor: pointer;
    background: var(--r-face); color: #111; font-family: var(--r-px); font-size: 16px; font-weight: 500; line-height: 1; text-decoration: none; white-space: nowrap;
    box-shadow: inset -1px -1px var(--r-dark), inset 1px 1px var(--r-hi), inset -2px -2px var(--r-shadow), inset 2px 2px var(--r-light); }
  .r98-btn:hover { background: #cacaca; color: #111; }
  .r98-btn:active, .r98-btn[aria-pressed="true"] { box-shadow: inset 1px 1px var(--r-dark), inset -1px -1px var(--r-hi), inset 2px 2px var(--r-shadow), inset -2px -2px var(--r-light); padding-top: 2px; padding-left: 20px; padding-right: 16px; }
  .r98-btn--default { outline: 1px solid #000; outline-offset: 0; }
  .r98-btn--blue { background: var(--r-t1); color: #fff; box-shadow: inset -1px -1px var(--r-dark), inset 1px 1px #5a7ad8, inset -2px -2px #00004a, inset 2px 2px #2f4fb0; }
  .r98-btn--blue:hover { background: #0a0a9a; color: #fff; }
  .r98-btn .r98-ico { width: 20px; height: 20px; }
  .r98-field { background: #fff; box-shadow: inset -1px -1px var(--r-hi), inset 1px 1px var(--r-shadow), inset -2px -2px var(--r-light), inset 2px 2px var(--r-dark); }
  .r98-sunken { box-shadow: inset -1px -1px var(--r-hi), inset 1px 1px var(--r-shadow); }
  .r98-raised { box-shadow: inset -1px -1px var(--r-shadow), inset 1px 1px var(--r-hi); }
  .r98-h { margin: 0; font-family: var(--r-px); font-weight: 600; color: #000; line-height: 1.1; letter-spacing: 0; }
  .r98 .r98-ico { image-rendering: pixelated; }
  .r98-win.is-min .r98-body, .r98-win.is-min .r98-hide-min { display: none; }
  .r98-win.is-max { position: relative; z-index: 3; }
  .r98-win[data-r98-window] { transition: transform .35s cubic-bezier(.2,.8,.2,1), opacity .25s; }
  .r98-win.is-closing { opacity: 0; transform: scale(.96); }
  html.r98-js .r98 [data-motion] { opacity: 0; transform: translate3d(0, 14px, 0) scale(.985); transition: opacity .55s cubic-bezier(.2,.7,.2,1), transform .55s cubic-bezier(.2,.7,.2,1); transition-delay: var(--d, 0ms); }
  html.r98-js .r98 [data-motion].is-in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    html.r98-js .r98 [data-motion] { opacity: 1; transform: none; transition: none; }
    .r98-win[data-r98-window] { transition: none; }
  }

  html { background-color: {{ wall_color }} !important; scroll-behavior: auto; }
  body { background: transparent !important; padding-bottom: calc(46px + env(safe-area-inset-bottom, 0px)); }
  #shopify-section-{{ sid }} { position: static !important; margin: 0 !important; padding: 0 !important; }
  #shopify-section-{{ sid }} .r98-wall { position: fixed; inset: 0; z-index: -1; pointer-events: none; background: {{ wall_color }}; }
