 height=%2218%22 fill=%22%23808080%22/%3E%3Crect x=%221%22 y=%2218%22 width=%2220%22 height=%221%22 fill=%22%23808080%22/%3E%3Cpath d=%22M7 5h2v1h1v1h2V6h1V5h2v2h-1v1h-1v2h1v1h1v2h-2v-1h-1v-1h-2v1H9v1H7v-2h1v-1h1V8H8V7H7z%22 fill=%22%23000%22/%3E%3C/g%3E%3C/svg%3E") no-repeat;
  }
  main#MainContent > .shopify-section:not([class*="retro-"]) > * { background-color: var(--color-background, #fff); }
  main#MainContent > [data-section-type="related-products"], main#MainContent > [data-section-type="products-carousel"], main#MainContent > [data-section-type="recently-viewed"] { --r98-t: "{{ st.related_title | default: 'You may also like' | replace: '"', "'" }}"; }
  main#MainContent > [data-section-type="main-cart-items"] { --r98-t: "Cart"; }
  main#MainContent > [data-section-type="main-search"] { --r98-t: "Search"; }
  main#MainContent > [data-section-type="page-404"] { --r98-t: "Error"; }
  main#MainContent > [data-section-type="main-collection-product"] { --r98-t: "{{ r98_title }}"; }
  main#MainContent > [data-section-type="contactformsimple2"], main#MainContent > [data-section-type="page-contact"], main#MainContent > [data-section-type="contact-form-simple"] { --r98-t: "New message"; }
  main#MainContent > [data-section-type="blog-posts"] { --r98-t: "More from the journal"; }
  /* A heading section and the section under it are one window: the title bar on the first, one frame round both. */
  main#MainContent > :is([data-section-type="main-collection-heading"], [data-section-type="page-heading"]):has(+ .shopify-section:not([class*="retro-"])) {
    margin-bottom: 0; padding-bottom: 0; box-shadow: inset -1px 0 #0a0a0a, inset 1px 1px #dfdfdf, inset -2px 0 #808080, inset 2px 2px #fff, 6px 0 0 rgba(0,0,0,.18);
  }
  main#MainContent > :is([data-section-type="main-collection-heading"], [data-section-type="page-heading"]) + .shopify-section:not([class*="retro-"]) {
    margin-top: 0; padding-top: 0; box-shadow: inset -1px -1px #0a0a0a, inset 1px 0 #dfdfdf, inset -2px -2px #808080, inset 2px 0 #fff, 6px 6px 0 rgba(0,0,0,.18);
  }
  main#MainContent > :is([data-section-type="main-collection-heading"], [data-section-type="page-heading"]) + .shopify-section:not([class*="retro-"]) > * { margin-top: 0 !important; }
  main#MainContent > :is([data-section-type="main-collection-heading"], [data-section-type="page-heading"]) + .shopify-section:not([class*="retro-"])::before,
  main#MainContent > :is([data-section-type="main-collection-heading"], [data-section-type="page-heading"]) + .shopify-section:not([class*="retro-"])::after { display: none; }
  @media (max-width: 749px) {
    main#MainContent { padding: 6px 6px 0; }
    main#MainContent > .shopify-section:not([class*="retro-"]) { margin-bottom: 16px; padding-top: 30px; box-shadow: inset -1px -1px #0a0a0a, inset 1px 1px #dfdfdf, inset -2px -2px #808080, inset 2px 2px #fff, 4px 4px 0 rgba(0,0,0,.18); }
  }
  /* Buttons, fields and choices across the theme, in the same grey. */
  main#MainContent .btn, main#MainContent .button, main#MainContent button.btn-primary, main#MainContent .btn-primary, main#MainContent .btn-secondary, main#MainContent .shopify-payment-button__button, main#MainContent [type="submit"]:not(.r98-btn):not(.r98-ctl) {
    border-radius: 0 !important; font-family: 'Pixelify Sans', ui-monospace, monospace !important; letter-spacing: 0 !important; text-transform: none !important;
  }
  main#MainContent :is(h1, h2, h3, .h1, .h2, .h3, .product__title, .heading-style) { font-family: 'Pixelify Sans', ui-monospace, monospace !important; letter-spacing: 0 !important; }
  /* The theme's buttons take their paint from --mb-* tokens (theme-button-contract.css): given here, they are grey and bevelled. */
  main#MainContent :is(.btn, .btn-primary, .btn-secondary, .btn-outline, .product-form__submit, .shopify-payment-button__button, [data-theme-button], [data-sl-button]):not(.r98-btn):not(.r98-ctl) {
    --mb-bg: #c0c0c0; --mb-rest: #c0c0c0; --mb-ink: #000; --mb-line: transparent; --mb-text: #000; --mb-border: transparent; --mb-border-width: 0px; --mb-radius: 0px; --mb-hover-bg: #cacaca; --mb-hover-text: #000; --mb-hover-border: transparent;
    --mb-font: 'Pixelify Sans', ui-monospace, monospace; --btn-shadow: inset -1px -1px #0a0a0a, inset 1px 1px #fff, inset -2px -2px #808080, inset 2px 2px #dfdfdf;
    background: #c0c0c0; color: #000; border: 0; border-radius: 0; box-shadow: var(--btn-shadow); min-height: 44px;
  }
  main#MainContent :is(.btn, .btn-primary, .btn-secondary, .btn-outline, .product-form__submit, .shopify-payment-button__button, [data-theme-button], [data-sl-button]):not(.r98-btn):not(.r98-ctl):active {
