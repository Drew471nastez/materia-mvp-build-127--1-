<circle cx="12" cy="12" r="9.3" fill="url(#xq1-{{ sid }})" stroke="#2f6fdc" stroke-width="1.8"/><path d="M12 6.8V12l3.6 2.2" fill="none" stroke="#223" stroke-width="1.6" stroke-linecap="round"/></symbol>
<symbol id="xpi-info-{{ sid }}" viewBox="0 0 24 24"><radialGradient id="xa1-{{ sid }}" cx=".35" cy=".3" r=".8"><stop offset="0" stop-color="#8fc0ff"/><stop offset=".6" stop-color="#2f6fdc"/><stop offset="1" stop-color="#1b4bb0"/></radialGradient>
