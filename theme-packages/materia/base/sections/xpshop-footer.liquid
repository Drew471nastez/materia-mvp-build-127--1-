</defs></svg>
<footer data-own-font class="xp xp-sec">
  <div class="xp-place">
    <div class="xp-win xpf" data-xp-window>
      <div class="xp-bar">
  <svg class="xp-ico" width="20" height="20" aria-hidden="true" focusable="false"><use href="#xpi-{{ bar_icon | default: 'folder' }}-{{ sid }}"/></svg>
  <p class="xp-bar__title">{{ bar_title | escape }}</p>
  <span class="xp-ctls">
    <button class="xp-ctl xp-ctl--opt" type="button" data-xp-min aria-label="Minimise" aria-expanded="true"><svg viewBox="0 0 12 12" aria-hidden="true" focusable="false"><rect x="1" y="8.5" width="7" height="2.5" fill="currentColor"/></svg></button>
    <button class="xp-ctl xp-ctl--opt" type="button" data-xp-max aria-label="Maximise"><svg viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M1 1h10v10H1z" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M1 1h10v2.6H1z" fill="currentColor"/></svg></button>
    <button class="xp-ctl xp-ctl--close" type="button" data-xp-close aria-label="Close"><svg viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="m2 2 8 8M10 2 2 10" stroke="currentColor" stroke-width="2.1" stroke-linecap="round"/></svg></button>
  </span>
</div>

      <div class="xp-body">
        <div class="xpf__grid">
          <div>
            <p class="xpf__brand">{{ shop.name | escape }}</p>
            {%- if st.line != blank -%}<p class="xpf__line">{{ st.line | escape }}</p>{%- endif -%}
            <div class="xpf__social">
              {%- if st.instagram != blank -%}<a href="{{ st.instagram }}" target="_blank" rel="noopener" aria-label="Instagram"><svg class="xp-ico" width="24" height="24" aria-hidden="true" focusable="false"><use href="#xpi-camera-{{ sid }}"/></svg></a>{%- endif -%}
              {%- if st.tiktok != blank -%}<a href="{{ st.tiktok }}" target="_blank" rel="noopener" aria-label="TikTok"><svg class="xp-ico" width="24" height="24" aria-hidden="true" focusable="false"><use href="#xpi-music-{{ sid }}"/></svg></a>{%- endif -%}
              {%- if st.youtube != blank -%}<a href="{{ st.youtube }}" target="_blank" rel="noopener" aria-label="YouTube"><svg class="xp-ico" width="24" height="24" aria-hidden="true" focusable="false"><use href="#xpi-play-{{ sid }}"/></svg></a>{%- endif -%}
              {%- if st.pinterest != blank -%}<a href="{{ st.pinterest }}" target="_blank" rel="noopener" aria-label="Pinterest"><svg class="xp-ico" width="24" height="24" aria-hidden="true" focusable="false"><use href="#xpi-heart-{{ sid }}"/></svg></a>{%- endif -%}
            </div>
          </div>
          {%- if st.menu != blank -%}
            <nav aria-label="{{ st.menu_heading | default: st.menu.title | escape }}"><p class="xpf__h">{{ st.menu_heading | default: st.menu.title | escape }}</p><ul class="xpf__links" role="list">{%- for link in st.menu.links -%}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{%- endfor -%}</ul></nav>
          {%- endif -%}
          {%- if st.menu_2 != blank -%}
            <nav aria-label="{{ st.menu_2_heading | default: st.menu_2.title | escape }}"><p class="xpf__h">{{ st.menu_2_heading | default: st.menu_2.title | escape }}</p><ul class="xpf__links" role="list">{%- for link in st.menu_2.links -%}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{%- endfor -%}</ul></nav>
          {%- endif -%}
        </div>
        {%- if st.sign_text != blank -%}
          <div class="xpf__sign"><p><svg class="xp-ico" width="24" height="24" aria-hidden="true" focusable="false"><use href="#xpi-mail-{{ sid }}"/></svg><span>{{ st.sign_text | escape }}</span></p>{%- if st.sign_label != blank -%}<a class="xp-btn xp-btn--go" href="{{ st.sign_link | default: '#open-form-newsletter' }}">{{ st.sign_label | escape }}</a>{%- endif -%}</div>
        {%- endif -%}
        <div class="xpf__small"><span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}{% if st.copyright != blank %}. {{ st.copyright | escape }}{% endif %}</span>{%- if st.note != blank -%}<span>{{ st.note | escape }}</span>{%- endif -%}</div>
      </div>
    </div>
  </div>
</footer>
<script>
  (function () {
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;
    var still = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
    if ('IntersectionObserver' in window && !still && !(window.Shopify && window.Shopify.designMode)) {
      document.documentElement.classList.add('xp-js');
      if (!window.__xpSeen) window.__xpSeen = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('is-in'); window.__xpSeen.unobserve(e.target); } }); }, { rootMargin: '0px 0px -5% 0px', threshold: 0.04 });
      root.querySelectorAll('[data-motion]:not(.is-in)').forEach(function (el) {
        var r = el.getBoundingClientRect();
        if (r.top < innerHeight && r.bottom > 0) { el.classList.add('is-in'); return; }
        window.__xpSeen.observe(el);
      });
    }
    root.querySelectorAll('[data-xp-window]').forEach(function (win) {
      if (win.__xp) return; win.__xp = true;
      var narrow = function () { return window.matchMedia('(max-width: 749px)').matches; };
      var min = win.querySelector('[data-xp-min]'), max = win.querySelector('[data-xp-max]'), close = win.querySelector('[data-xp-close]');
      if (min) min.addEventListener('click', function () { var on = !win.classList.contains('is-min'); win.classList.toggle('is-min', on); min.setAttribute('aria-expanded', on ? 'false' : 'true'); });
      if (max) max.addEventListener('click', function () { win.classList.toggle('is-max'); win.classList.remove('is-min'); });
      if (close) close.addEventListener('click', function () {
        if (narrow() || !window.__xpPark) { win.classList.add('is-min'); return; }
        win.classList.add('is-closing');
        setTimeout(function () { win.classList.remove('is-closing'); win.hidden = true; window.__xpPark(win); }, still ? 0 : 200);
      });
    });
  })();
</script>


{% schema %}
{
  "name": "XP footer",
  "tag": "section",
  "class": "xpshop-footer-section",
  "settings": [
    { "type": "text", "id": "title", "label": "Title bar", "info": "Empty: the shop's name." },
    { "type": "select", "id": "icon", "label": "Title bar icon", "default": "home", "options": [{"value": "folder", "label": "Folder"}, {"value": "tee", "label": "Tee"}, {"value": "cap", "label": "Cap"}, {"value": "help", "label": "Help"}, {"value": "mail", "label": "Letter"}, {"value": "cart", "label": "Cart"}, {"value": "search", "label": "Search"}, {"value": "user", "label": "Person"}, {"value": "note", "label": "Note"}, {"value": "home", "label": "Home"}, {"value": "star", "label": "Star"}, {"value": "truck", "label": "Delivery van"}, {"value": "shield", "label": "Shield"}, {"value": "refresh", "label": "Returns arrow"}, {"value": "leaf", "label": "Leaf"}, {"value": "sticker", "label": "Sticker"}, {"value": "heart", "label": "Heart"}, {"value": "clock", "label": "Clock"}, {"value": "info", "label": "Information"}, {"value": "camera", "label": "Camera"}, {"value": "music", "label": "Music"}, {"value": "play", "label": "Video"}, {"value": "globe", "label": "Globe"}] },
    { "type": "text", "id": "line", "label": "Line under the name" },
    { "type": "link_list", "id": "menu", "label": "First menu", "default": "main-menu" },
    { "type": "text", "id": "menu_heading", "label": "First menu heading" },
    { "type": "link_list", "id": "menu_2", "label": "Second menu", "default": "footer" },
    { "type": "text", "id": "menu_2_heading", "label": "Second menu heading" },
    { "type": "header", "content": "Sign up row" },
    { "type": "text", "id": "sign_text", "label": "Words", "default": "One email when a new drop is out." },
    { "type": "text", "id": "sign_label", "label": "Button", "default": "Sign up" },
    { "type": "url", "id": "sign_link", "label": "Button link", "info": "#open-form-newsletter opens the form popup named newsletter." },
    { "type": "header", "content": "Social pages" },
    { "type": "url", "id": "instagram", "label": "Instagram" },
    { "type": "url", "id": "tiktok", "label": "TikTok" },
    { "type": "url", "id": "youtube", "label": "YouTube" },
    { "type": "url", "id": "pinterest", "label": "Pinterest" },
    { "type": "header", "content": "Small print" },
    { "type": "text", "id": "copyright", "label": "After the copyright" },
    { "type": "text", "id": "note", "label": "Note on the right" }
  ],
  "presets": [
    { "name": "XP footer", "category": "XP shop" }
  ]
}
{% endschema %}
