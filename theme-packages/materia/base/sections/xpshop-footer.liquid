<path d="M9 17.5V5.5l11-2v12" fill="none" stroke="url(#xz1-{{ sid }})" stroke-width="2.2" stroke-linejoin="round"/><ellipse cx="6.6" cy="17.6" rx="3" ry="2.4" fill="#5b33c8"/><ellipse cx="17.6" cy="15.6" rx="3" ry="2.4" fill="#5b33c8"/></symbol>
