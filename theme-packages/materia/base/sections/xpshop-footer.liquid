<rect x="2.5" y="6.5" width="19" height="13" rx="2.5" fill="url(#xp1-{{ sid }})" stroke="#262a33" stroke-width=".8"/><path d="M8 6.5 9.4 4h5.2L16 6.5" fill="#5a5f6b" stroke="#262a33" stroke-width=".8"/><circle cx="12" cy="13" r="4" fill="#9cc8ff" stroke="#e8eef8" stroke-width="1.4"/></symbol>
