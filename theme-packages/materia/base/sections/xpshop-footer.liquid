<circle cx="9" cy="11" r="1.1" fill="#7a3a06"/><circle cx="13" cy="14.6" r="0" fill="none"/><path d="M8 15.2c1.6 1.4 4 1.4 5.6 0" fill="none" stroke="#7a3a06" stroke-width="1.2" stroke-linecap="round"/></symbol>
