<rect x="2" y="5" width="20" height="14" rx="4" fill="url(#xy1-{{ sid }})" stroke="#9e2412" stroke-width=".8"/><path d="m10 8.8 5.4 3.2-5.4 3.2z" fill="#fff"/></symbol>
