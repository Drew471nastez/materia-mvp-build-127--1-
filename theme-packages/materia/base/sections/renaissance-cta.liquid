{%- comment -%}
  Digital Renaissance: the last call. The course mark (drawn here, so it
  stays sharp) over a light rising from the bottom edge, a large heading
  with words in the gold serif, a line, the main button, a quieter link
  (it can open the sign up window: #open-form-access) and a note.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
-%}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap">
<style>
  #shopify-section-{{ sid }} .rnx { --gold: {{ st.gold | default: '#f2bd4f' }}; --lapis: {{ st.accent | default: '#3d5afe' }}; position: relative; overflow: hidden; background: {{ st.background | default: '#07080d' }}; color: {{ st.text_color | default: '#a7adbf' }}; padding: {{ st.padding_top_mobile | default: 72 }}px 20px {{ st.padding_bottom_mobile | default: 80 }}px; text-align: center; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .rnx { padding: {{ st.padding_top | default: 128 }}px 40px {{ st.padding_bottom | default: 136 }}px; } }
  #shopify-section-{{ sid }} .rnx::before { content: ""; position: absolute; left: 50%; bottom: -60%; width: 1300px; height: 900px; transform: translateX(-50%); border-radius: 50%; background: radial-gradient(closest-side, color-mix(in srgb, var(--lapis) 45%, transparent), transparent); pointer-events: none; }
  #shopify-section-{{ sid }} .rnx__in { position: relative; max-width: 860px; margin: 0 auto; }
  #shopify-section-{{ sid }} .rnx__mark { width: 56px; height: 56px; margin: 0 auto 26px; }
  #shopify-section-{{ sid }} .rnx__title { margin: 0 0 18px; color: #fff; font-family: var(--heading-font, sans-serif); font-weight: 600; font-size: 38px; line-height: 1.04; letter-spacing: -.04em; text-wrap: balance; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .rnx__title { font-size: 68px; } }
  #shopify-section-{{ sid }} .rnx__title em { font-family: 'Instrument Serif', Georgia, serif; font-weight: 400; letter-spacing: -.01em; color: var(--gold); }
  #shopify-section-{{ sid }} .rnx__text { max-width: 36em; margin: 0 auto; font-size: 17px; line-height: 1.65; }
  #shopify-section-{{ sid }} .rnx__text p { margin: 0; }
  #shopify-section-{{ sid }} .rnx__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 34px; }
  #shopify-section-{{ sid }} .rnx__btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 58px; padding: 0 32px; border-radius: 12px; background: var(--lapis); color: #fff; font-size: 16.5px; font-weight: 600; text-decoration: none; box-shadow: 0 1px 0 rgba(255,255,255,.25) inset, 0 18px 44px -14px color-mix(in srgb, var(--lapis) 90%, transparent); transition: transform .25s ease; }
  #shopify-section-{{ sid }} .rnx__btn:hover { transform: translateY(-2px); }
  #shopify-section-{{ sid }} .rnx__btn svg { width: 16px; height: 16px; }
  #shopify-section-{{ sid }} .rnx__link { display: inline-flex; align-items: center; min-height: 58px; padding: 0 22px; border-radius: 12px; border: 1px solid rgba(255,255,255,.18); color: #fff; font-size: 15.5px; font-weight: 600; text-decoration: none; }
  #shopify-section-{{ sid }} .rnx__link:hover { background: rgba(255,255,255,.06); }
  @media (max-width: 599px) { #shopify-section-{{ sid }} .rnx__btn, #shopify-section-{{ sid }} .rnx__link { width: 100%; } }
  #shopify-section-{{ sid }} .rnx__note { margin: 16px 0 0; font-size: 13.5px; color: #8a90a3; }
</style>
<section data-own-size class="rnx"{% if st.anchor != blank %} id="{{ st.anchor | handleize }}"{% endif %}>
  <div class="rnx__in">
    {%- if st.show_mark -%}<svg class="rnx__mark" viewBox="0 0 48 48" aria-hidden="true"><rect width="48" height="48" rx="12" fill="var(--lapis)"/><circle cx="24" cy="24" r="13" fill="none" stroke="var(--gold)" stroke-width="2"/><path d="M24 8.5c1.3 10.2 5.3 14.2 15.5 15.5-10.2 1.3-14.2 5.3-15.5 15.5-1.3-10.2-5.3-14.2-15.5-15.5 10.2-1.3 14.2-5.3 15.5-15.5z" fill="#fff"/></svg>{%- endif -%}
    {%- if st.heading != blank -%}<h2 class="rnx__title">{{ st.heading }}</h2>{%- endif -%}
    {%- if st.text != blank -%}<div class="rnx__text">{{ st.text }}</div>{%- endif -%}
    <div class="rnx__actions">
      {%- if st.button_label != blank -%}<a class="rnx__btn" href="{{ st.button_link | default: '#' }}">{{ st.button_label | escape }}<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg></a>{%- endif -%}
      {%- if st.link_label != blank -%}<a class="rnx__link" href="{{ st.link_url | default: '#' }}">{{ st.link_label | escape }}</a>{%- endif -%}
    </div>
    {%- if st.note != blank -%}<p class="rnx__note">{{ st.note | escape }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Renaissance last call",
  "tag": "section",
  "class": "renaissance-cta-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "anchor", "label": "Name for links to this place", "default": "join" },
    { "type": "checkbox", "id": "show_mark", "label": "Show the course mark", "default": true },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Start <em>today</em>" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>One line on what happens after someone joins.</p>" },
    { "type": "text", "id": "button_label", "label": "Main button", "default": "Join the course" },
    { "type": "url", "id": "button_link", "label": "Main button link" },
    { "type": "text", "id": "link_label", "label": "Second button", "default": "Get the first module free" },
    { "type": "text", "id": "link_url", "label": "Second button link", "default": "#open-form-access" },
    { "type": "text", "id": "note", "label": "Line under the buttons", "default": "30 day refund. Lifetime access." },
    { "type": "color", "id": "background", "label": "Background", "default": "#07080d" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#3d5afe" },
    { "type": "color", "id": "gold", "label": "Highlight", "default": "#f2bd4f" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#a7adbf" },
    { "type": "range", "id": "padding_top", "label": "Space above on a computer", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 128 },
    { "type": "range", "id": "padding_bottom", "label": "Space below on a computer", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 136 },
    { "type": "range", "id": "padding_top_mobile", "label": "Space above on a phone", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Space below on a phone", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 80 }
  ],
  "presets": [ { "name": "Renaissance last call", "category": "Digital Renaissance" } ]
}
{% endschema %}
