{% render 'page-popup-dialog', sid: sid, st: st %}
<div id="loudz-{{ sid }}" class="loudz-newsletter-4 loudz-{{ sid }} color-{{ color_scheme }}" data-pg-root="promotionalpopup2" data-pg-section="{{ sid }}"{% if request.design_mode %} data-pg-settings="{{ st | json | escape }}"{% endif %}{% if st.enable_custom_fonts %} data-pg-fonts data-own-font{% endif %}{% if st.reset_spacing %} data-pp2-reset{% endif %}
     data-popup-root="{{ sid }}" data-popup-config="{{ pp2_config | strip_newlines | escape }}" aria-hidden="true"
     style="{{ pp2_vars | strip_newlines | strip }}">
  <dialog class="pg-dialog" data-pg-dialog aria-labelledby="loudz-title-{{ sid }}">
  <div class="loudz__popup loudz__popup--{{ pp2_pos }}" data-pg-frame>
    <div class="loudz__content-box" data-pg-card tabindex="-1">
      <button type="button" class="loudz__close loudz__close--{{ st.close_button_position | default: 'right' }}" data-popup-close aria-label="{{ 'accessibility.close' | t }}">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M15 9L9 15" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          <path d="M9 9L15 15" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>

      <div class="loudz__image-wrapper"{% if block_image != blank %} data-pg-block="{{ block_image.id }}" data-pg-type="image"{% if request.design_mode %} data-pg-settings="{{ ib | json | escape }}"{% endif %} {{ block_image.shopify_attributes }}{% endif %}>
        <template data-pg-ph>{{ 'lifestyle-1' | placeholder_svg_tag: 'loudz__placeholder-image' }}</template>
        {%- if ib.image == blank -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'loudz__placeholder-image' }}
        {%- else -%}
          {%- assign pp2_alt = ib.image.alt | default: '' -%}{{ ib.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: pp2_alt, class: pp2_filter, sizes: '(min-width: 768px) 480px, 100vw', widths: '400,600,900' }}
        {%- endif -%}
      </div>

      <div class="loudz__content-inner">
        {%- if block_heading != blank %}
          <h2 class="loudz__heading" id="loudz-title-{{ sid }}"{% unless hb.weight == 'theme' %} data-own-weight{% endunless %} data-pg-block="{{ block_heading.id }}" data-pg-type="heading"{% if request.design_mode %} data-pg-settings="{{ hb | json | escape }}"{% endif %}{% if hb.text == blank %} hidden{% endif %} {{ block_heading.shopify_attributes }}>{{ hb.text }}</h2>
        {%- endif %}
        {%- if block_description != blank %}
          <p class="loudz__description" data-pg-block="{{ block_description.id }}" data-pg-type="description"{% if request.design_mode %} data-pg-settings="{{ db | json | escape }}"{% endif %}{% if db.text == blank %} hidden{% endif %} {{ block_description.shopify_attributes }}>{{ db.text }}</p>
        {%- endif %}
        {%- comment -%} The store's customer form (tag newsletter), posted the ordinary way so the platform's spam check (CAPTCHA) can add its token; the page comes back on the form's #id and the popup reopens on the result. {%- endcomment -%}
        {%- liquid
          assign pp2_form_id = 'PromoPopupForm-' | append: sid
          assign pp2_success = fb.success_text | strip
          if pp2_success == blank
            assign pp2_success = 'Thanks, you are on the list.'
          endif
        -%}
        <div class="loudz__signup-wrap"{% if block_form != blank %} data-pg-block="{{ block_form.id }}" data-pg-type="form"{% if request.design_mode %} data-pg-settings="{{ fb | json | escape }}"{% endif %}{% endif %}>
        {%- form 'customer', id: pp2_form_id, class: 'loudz__form', data-storelib-form: 'subscribe' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input type="hidden" name="contact[accepts_marketing]" value="true">
          <span hidden data-mt-words data-success-message="{{ pp2_success | strip_html | escape }}" data-already-message="{{ pp2_success | strip_html | escape }}" data-invalid-message="{{ 'newsletter.error' | t | escape }}" data-error-message="{{ 'newsletter.error' | t | escape }}"></span>
          <input type="email" name="contact[email]" autocomplete="email" autocapitalize="off" spellcheck="false" maxlength="254" placeholder="{{ fb.email_placeholder | escape }}" aria-label="{{ fb.email_placeholder | default: 'Email' | escape }}" required data-popup-autofocus>
          <button type="submit" class="loudz__button btn-primary" data-theme-button="primary" data-sl-button{% unless pp2_use_theme_button %} data-own-shape{% endunless %}{% if block_form != blank %} {{ block_form.shopify_attributes }}{% endif %}>{{ fb.button_text }}</button>
          <p class="loudz__success" role="status" data-storelib-success hidden>{{ pp2_success }}</p>
          {%- if form.errors -%}
            {%- capture pp2_err -%}{%- for field in form.errors -%}{{ form.errors.translated_fields[field] }} {{ form.errors.messages[field] }} {% endfor -%}{%- endcapture -%}
            <p class="loudz__error" role="alert" data-mt-form-errors="{{ pp2_err | strip | escape }}">{{ 'newsletter.error' | t }}</p>
          {%- elsif form.posted_successfully? -%}
            <span hidden data-mt-form-posted></span>
          {%- endif -%}
        {%- endform -%}
        </div>
      </div>
    </div>
  </div>
  </dialog>
</div>

<script src="{{ 'materia-popups.js' | asset_url }}" defer="defer"></script>
<script>
(function(){
  var SID = {{ section.id | json }};
  function setup(P){
    var root = document.querySelector('[data-popup-root="' + SID + '"]');
    if (!root || root.__pp2) return;
    root.__pp2 = true;
    var CFG = JSON.parse(root.getAttribute('data-popup-config') || '{}');
    var popup = root.querySelector('.loudz__popup');
    var form = root.querySelector('form');
    var api = P.register({
      id: SID, root: root, dialog: root.querySelector('.loudz__content-box'), backdrop: popup,
      design: CFG.design, preview: CFG.preview,
      trigger: Object.assign({ selector: '[data-loudz-open="' + SID + '"]' }, CFG.trigger),
      frequency: { mode: CFG.frequency.mode === 'every_visit' ? 'always' : CFG.frequency.mode, days: CFG.frequency.days },
      open: function(){ popup.classList.add('active'); },
      close: function(){ popup.classList.remove('active'); }
    });
    // Signed up (Storelib marks the form done): thank them, then not again for 20 days.
    if (form) new MutationObserver(function(){
      if (form.getAttribute('data-state') === 'done' && api) api.done(20);
    }).observe(form, { attributes: true, attributeFilter: ['data-state'] });
    // Back from the post (the page comes back on this form's #id): reopen on the result.
    var back = form && !CFG.design && P.posted ? P.posted(form) : '';
    if (back && api) {
      if (back === 'ok') {
        var msg = form.querySelector('[data-storelib-success]'); if (msg) msg.hidden = false;
        var err = form.querySelector('[data-mt-form-errors]'); if (err) err.hidden = true;
        form.setAttribute('data-state', 'done');
      }
      api.show();
    }
  }
  function boot(){ (window.MateriaPopupsQueue = window.MateriaPopupsQueue || []).push(setup); }
  boot();
  function reload(e){ if (e.detail && String(e.detail.sectionId) === SID) boot(); }
  document.addEventListener('storelib:section-load', reload);
  document.addEventListener('shopify:section:load', reload);
})();
</script>

{% schema %}
{
  "name": "Promotional Popup 2",
  "class": "loudz-section loudz-newsletter-4 s-tt s-promotionalpopup2 has-popup",
  "tag": "section",
  "enabled_on": {
    "groups": [
      "custom.overlay"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default"
    },
    {
      "type": "header",
      "content": "Trigger"
    },
    {
      "type": "select",
      "id": "open_mode",
      "label": "Opens",
      "options": [
        {
          "value": "immediate",
          "label": "On page load"
        },
        {
          "value": "delay",
          "label": "After a delay"
        },
        {
          "value": "scroll",
          "label": "On scroll"
        },
        {
          "value": "exit",
          "label": "On exit intent"
        },
        {
          "value": "pageviews",
          "label": "After page views"
        },
        {
          "value": "manual",
          "label": "From a link"
        }
      ],
      "default": "delay"
    },
    {
      "type": "number",
      "id": "popup_delay",
      "label": "Delay (seconds)",
      "default": 0
    },
    {
      "type": "range",
      "id": "scroll_pct",
      "label": "Scrolled",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50,
      "visible_if": "{{ section.settings.open_mode == 'scroll' }}"
    },
    {
      "type": "range",
      "id": "page_views",
      "label": "Page views",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 2,
      "visible_if": "{{ section.settings.open_mode == 'pageviews' }}"
    },
    {
      "type": "header",
      "content": "Behaviour"
    },
    {
      "type": "select",
      "id": "after_dismiss",
      "label": "Show again",
      "options": [
        {
          "value": "every_visit",
          "label": "Every visit"
        },
        {
          "value": "after_days",
          "label": "After days"
        },
        {
          "value": "never",
          "label": "Never"
        }
      ],
      "default": "after_days"
    },
    {
      "type": "range",
      "id": "hide_days",
      "label": "Days",
      "visible_if": "{{ section.settings.after_dismiss == 'after_days' }}",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "d",
      "default": 1
    },
    {
      "type": "checkbox",
      "id": "enable_customization_mode",
      "label": "Show in the builder",
      "default": false
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "popup_position",
      "label": "Position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Text",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "number",
      "id": "inner_width_px",
      "label": "Width (px)",
      "default": 400
    },
    {
      "type": "select",
      "id": "close_button_position",
      "label": "Close button",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
