{%- comment -%}
  New Leaf (templates round 29): the top of a template's page, above the
  product information. A strip of the product's own cover art runs across
  the top and fades into the section's colour, then the way back (Templates
  / the product's category) and the template's icon.

  Everything comes from the product: the strip is the top of its first
  picture (where a template's cover art is), the category is the one it is
  filed under, and the icon is cut from the first picture at the place the
  settings give (where New Leaf's pictures have it). With the icon set to
  None, no icon is shown. Put the product information right under it in
  the same colour scheme, with its top padding at zero.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign sid = section.id
  assign color_scheme = s.color_scheme.id | default: s.color_scheme | default: 'default'
  assign pic = product.featured_image
  assign cat = product.type
  if cat == 'digital' or cat == 'physical'
    assign cat = ''
  endif
  assign cat_url = ''
  if cat != blank
    assign cat_handle = cat | handleize
    assign cat_col = collections[cat_handle]
    if cat_col != blank and cat_col.url != blank
      assign cat_url = cat_col.url
    endif
  endif
-%}
<style>
  #shopify-section-{{ sid }} .nlb { --strip: {{ s.strip_height_mobile }}px; position: relative; overflow: hidden; padding-top: calc(var(--strip) * .62); }
  #shopify-section-{{ sid }} .nlb__strip { position: absolute; left: 0; right: 0; top: 0; height: var(--strip); overflow: hidden; pointer-events: none; }
  #shopify-section-{{ sid }} .nlb__strip img { position: absolute; left: 50%; top: 0; height: calc(var(--strip) * 3.2); width: auto; min-width: 100%; max-width: none; object-fit: cover; object-position: top center; transform: translateX(-50%); display: block; }
  #shopify-section-{{ sid }} .nlb__strip::after { content: ""; position: absolute; inset: 0; background: linear-gradient(to bottom, transparent 10%, var(--color-background) 100%); }
  #shopify-section-{{ sid }} .nlb__strip::before { content: ""; position: absolute; inset: 0; z-index: 1; background: var(--color-background); opacity: {{ s.strip_dim | divided_by: 100.0 }}; }
  #shopify-section-{{ sid }} .nlb__inner { position: relative; z-index: 1; }
  #shopify-section-{{ sid }} .nlb__crumbs { display: flex; flex-wrap: wrap; gap: 6px; margin: 0; padding: 0; list-style: none; font-size: 13.5px; color: var(--color-text); }
  #shopify-section-{{ sid }} .nlb__crumbs a { color: var(--color-heading); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: rgba(var(--color-heading-rgb), .45); }
  #shopify-section-{{ sid }} .nlb__crumbs a:hover { text-decoration-color: currentColor; }
  #shopify-section-{{ sid }} .nlb__crumbs li + li::before { content: "/"; margin-right: 6px; opacity: .7; }
  #shopify-section-{{ sid }} .nlb__icon { position: relative; display: block; width: {{ s.icon_tile }}px; height: {{ s.icon_tile }}px; margin-top: 18px; border-radius: {{ s.icon_tile | times: 0.22 | round }}px; overflow: hidden; box-shadow: 0 6px 18px -6px rgba(0, 0, 0, .5); }
  #shopify-section-{{ sid }} .nlb__icon img { position: absolute; max-width: none; width: calc({{ s.icon_tile }}px * 100 / {{ s.icon_size | default: 7.5 }}); height: auto; left: calc({{ s.icon_tile }}px * -{{ s.icon_x | default: 7.35 }} / {{ s.icon_size | default: 7.5 }}); top: calc({{ s.icon_tile }}px * -{{ s.icon_y | default: 19.9 }} / {{ s.icon_size | default: 7.5 }}); }
  @media (min-width: 990px) {
    #shopify-section-{{ sid }} .nlb { --strip: {{ s.strip_height }}px; }
  }
</style>
<div class="nlb color-{{ color_scheme }} gradient">
  {%- if s.show_strip and pic != blank -%}
    <div class="nlb__strip" aria-hidden="true">{{ pic | image_url: width: 1800 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '800, 1200, 1800', sizes: '100vw', alt: '' }}</div>
  {%- endif -%}
  <div class="nlb__inner {{ s.section_width | default: 'container' }}">
    {%- if s.show_crumbs -%}
      <nav aria-label="{{ s.crumbs_label | escape }}">
        <ol class="nlb__crumbs">
          <li><a href="{{ s.root_link | default: routes.all_products_collection_url }}">{{ s.root_label | escape }}</a></li>
          {%- if cat != blank -%}<li>{%- if cat_url != blank -%}<a href="{{ cat_url }}">{{ cat | escape }}</a>{%- else -%}{{ cat | escape }}{%- endif -%}</li>{%- endif -%}
        </ol>
      </nav>
    {%- endif -%}
    {%- if s.icon == 'crop' and pic != blank -%}
      <span class="nlb__icon" aria-hidden="true">{{ pic | image_url: width: 1200 | image_tag: loading: 'eager', alt: '' }}</span>
    {%- endif -%}
  </div>
</div>
{% schema %}
{
  "name": "Template page band",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "checkbox", "id": "show_strip", "label": "Strip of the product's cover art", "default": true, "info": "The top of the product's first picture." },
    { "type": "range", "id": "strip_height", "label": "Strip height", "min": 60, "max": 260, "step": 10, "unit": "px", "default": 150 },
    { "type": "range", "id": "strip_height_mobile", "label": "Strip height on phones", "min": 40, "max": 200, "step": 10, "unit": "px", "default": 100 },
    { "type": "range", "id": "strip_dim", "label": "Strip dimmed by", "min": 0, "max": 60, "step": 5, "unit": "%", "default": 0 },
    { "type": "checkbox", "id": "show_crumbs", "label": "Show the way back", "default": true },
    { "type": "text", "id": "root_label", "label": "First link", "default": "Templates" },
    { "type": "url", "id": "root_link", "label": "First link address" },
    { "type": "text", "id": "crumbs_label", "label": "Name of the way back for screen readers", "default": "Breadcrumb" },
    { "type": "header", "content": "Icon" },
    { "type": "select", "id": "icon", "label": "Icon", "default": "crop", "options": [{ "value": "crop", "label": "Cut from the first picture" }, { "value": "none", "label": "None" }] },
    { "type": "range", "id": "icon_tile", "label": "Icon size", "min": 40, "max": 96, "step": 2, "unit": "px", "default": 64 },
    { "type": "number", "id": "icon_x", "label": "Icon's left edge, % of the picture's width", "default": 7.35 },
    { "type": "number", "id": "icon_y", "label": "Icon's top edge, % of the picture's width", "default": 19.9 },
    { "type": "number", "id": "icon_size", "label": "Icon's width, % of the picture's width", "default": 7.5, "info": "Where the icon sits in your pictures, all measured against the picture's width. New Leaf's own pictures have it at 7.35, 19.9 and 7.5." },
    { "type": "header", "content": "General" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default" },
    { "type": "select", "id": "section_width", "label": "Section width", "default": "container", "options": [{ "value": "container", "label": "Default" }, { "value": "fluid_container", "label": "Fluid container" }, { "value": "stretch_width", "label": "Stretched" }] }
  ],
  "presets": [{ "name": "Template page band" }]
}
{% endschema %}
