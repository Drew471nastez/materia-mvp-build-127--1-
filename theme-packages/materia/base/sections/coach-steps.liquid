{%- comment -%}
  Coach: how it works, in numbered steps. A centred label and heading, then
  the steps side by side, each under a thin rule with an italic numeral, a
  short name and a line or two. Stacked on a phone.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign color_scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
-%}
{%- assign coach_hf = settings.font_heading_google_family -%}
{%- if coach_hf != blank and coach_hf != 'none' -%}<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ coach_hf | replace: ' ', '+' }}:ital@1&display=swap">{%- endif -%}
<style>
  #shopify-section-{{ sid }} .cop {
    --cop-accent: {{ st.accent_color | default: '#a5582a' }};
    background: {{ st.background | default: '#faf6f0' }};
    padding: {{ st.padding_top_mobile | default: 56 }}px 20px {{ st.padding_bottom_mobile | default: 56 }}px;
  }
  @media (min-width: 990px) {
    #shopify-section-{{ sid }} .cop { padding: {{ st.padding_top | default: 88 }}px 40px {{ st.padding_bottom | default: 88 }}px; }
  }
  #shopify-section-{{ sid }} .cop__inner { max-width: 1120px; margin: 0 auto; }
  #shopify-section-{{ sid }} .cop__head { text-align: center; margin: 0 auto 44px; max-width: 640px; }
  #shopify-section-{{ sid }} .cop__eyebrow { margin: 0 0 14px; color: var(--cop-accent); font-size: 12px; font-weight: 500; letter-spacing: 0.2em; text-transform: uppercase; }
  #shopify-section-{{ sid }} .cop__heading {
    margin: 0; color: var(--color-heading);
    font-family: var(--heading-font, inherit); font-weight: var(--heading-weight, 500);
    font-size: {{ st.heading_size_mobile | default: 34 }}px; line-height: 1.12;
  }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .cop__heading { font-size: {{ st.heading_size | default: 44 }}px; } }
  #shopify-section-{{ sid }} .cop__heading em { font-style: italic; color: var(--cop-accent); }
  #shopify-section-{{ sid }} .cop__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 28px; }
  @media (min-width: 750px) { #shopify-section-{{ sid }} .cop__list { grid-template-columns: repeat({{ section.blocks.size | at_least: 1 | at_most: 4 }}, minmax(0, 1fr)); gap: 40px; } }
  #shopify-section-{{ sid }} .cop__step { margin: 0; padding-top: 22px; border-top: 1px solid {{ st.line_color | default: '#d9c6b0' }}; }
  #shopify-section-{{ sid }} .cop__num {
    display: block; margin-bottom: 14px; color: var(--cop-accent);
    font-family: var(--heading-font, inherit); font-style: italic; font-size: 40px; line-height: 1; font-variant-numeric: lining-nums;
  }
  #shopify-section-{{ sid }} .cop__title { margin: 0 0 8px; color: var(--color-heading); font-family: var(--heading-font, inherit); font-weight: var(--heading-weight, 500); font-size: 24px; line-height: 1.2; }
  #shopify-section-{{ sid }} .cop__text { margin: 0; color: var(--color-text); font-size: 15.5px; line-height: 1.65; }
</style>

<div class="cop color-{{ color_scheme }}" data-section-id="{{ sid }}">
  <div class="cop__inner">
    {%- if st.eyebrow != blank or st.heading != blank -%}
      <div class="cop__head">
        {%- if st.eyebrow != blank -%}<p class="cop__eyebrow">{{ st.eyebrow | escape }}</p>{%- endif -%}
        {%- if st.heading != blank -%}<h2 class="cop__heading">{{ st.heading }}</h2>{%- endif -%}
      </div>
    {%- endif -%}
    <ol class="cop__list">
      {%- for block in section.blocks -%}
        <li class="cop__step" {{ block.shopify_attributes }}>
          <span class="cop__num">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
          {%- if block.settings.title != blank -%}<h3 class="cop__title">{{ block.settings.title | escape }}</h3>{%- endif -%}
          {%- if block.settings.text != blank -%}<p class="cop__text">{{ block.settings.text | escape }}</p>{%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
  </div>
</div>

{% schema %}
{
  "name": "Coach steps",
  "tag": "section",
  "class": "section sec__coach-steps",
  "max_blocks": 4,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default-color-scheme" },
    { "type": "color", "id": "background", "label": "Background", "default": "#faf6f0" },
    { "type": "color", "id": "accent_color", "label": "Accent colour", "default": "#a5582a" },
    { "type": "color", "id": "line_color", "label": "Rule colour", "default": "#d9c6b0" },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "How it works" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Three steps to <em>a plan you keep</em>" },
    { "type": "range", "id": "heading_size", "label": "Heading size, desktop", "min": 28, "max": 64, "step": 2, "unit": "px", "default": 44 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size, phone", "min": 24, "max": 44, "step": 2, "unit": "px", "default": 34 },
    { "type": "range", "id": "padding_top", "label": "Space above, desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 88 },
    { "type": "range", "id": "padding_bottom", "label": "Space below, desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 88 },
    { "type": "range", "id": "padding_top_mobile", "label": "Space above, phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Space below, phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Name", "default": "Talk" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "One or two lines on what happens at this step." }
      ]
    }
  ],
  "presets": [
    { "name": "Coach steps", "blocks": [ { "type": "step" }, { "type": "step" }, { "type": "step" } ] }
  ]
}
{% endschema %}
