{%- comment -%}
  Course landing: the first screen of a one offer sales page. Centred: a
  first line in the accent colour over a two line heading, a row of small
  ticked pills, then a picture (the course on screens) beside a ticked list
  with a thin rule between them, one large button with a soft glow straight
  to checkout, and a short line under it. The parts settle in once on load;
  nothing moves with reduced motion or in the editor.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign sid = section.id
  assign p = s.product
  assign buy = s.button_link | default: '/collections/all'
  if s.to_checkout and p != blank and p.title != blank
    assign v = p.selected_or_first_available_variant
    if v.id != blank
      assign buy = '/cart/' | append: v.id | append: ':1'
    endif
  endif
  assign pills = s.pills | newline_to_br | split: '<br />'
  assign points = s.points | newline_to_br | split: '<br />'
-%}
<style>
  #shopify-section-{{ sid }} .clh {
    --cl-accent: {{ s.accent | default: '#2f5bea' }};
    --cl-ink: {{ s.heading_color | default: '#141416' }};
    --cl-text: {{ s.text_color | default: '#4b4b52' }};
    background: {{ s.background | default: '#f6f6f4' }};
    color: var(--cl-text);
    text-align: center;
    padding: {{ s.padding_top_mobile | default: 28 }}px 0 {{ s.padding_bottom_mobile | default: 56 }}px;
    overflow: hidden;
  }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .clh { padding: {{ s.padding_top | default: 40 }}px 0 {{ s.padding_bottom | default: 104 }}px; } }
  #shopify-section-{{ sid }} .clh__in { max-width: 1040px; margin: 0 auto; padding: 0 20px; }
  #shopify-section-{{ sid }} .clh__title { margin: 0 auto; max-width: 15em; color: var(--cl-ink); font-family: var(--heading-font, inherit); font-weight: 600; font-size: {{ s.heading_size_mobile | default: 34 }}px; line-height: 1.12; letter-spacing: -.03em; text-wrap: balance; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .clh__title { font-size: {{ s.heading_size | default: 52 }}px; } }
  #shopify-section-{{ sid }} .clh__first { display: block; color: var(--cl-accent); }
  #shopify-section-{{ sid }} .clh__pills { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin: 22px 0 0; padding: 0; list-style: none; }
  #shopify-section-{{ sid }} .clh__pills li { display: inline-flex; align-items: center; gap: 7px; padding: 6px 12px; border-radius: 8px; border: 1px solid color-mix(in srgb, var(--cl-accent) 22%, transparent); background: color-mix(in srgb, var(--cl-accent) 7%, #ffffff); color: var(--cl-ink); font-size: 13px; font-weight: 500; }
  #shopify-section-{{ sid }} .clh__pills svg { width: 13px; height: 13px; color: var(--cl-accent); }
  #shopify-section-{{ sid }} .clh__row { display: grid; gap: 20px; align-items: center; margin: 28px auto 0; max-width: 860px; }
  @media (min-width: 750px) { #shopify-section-{{ sid }} .clh__row { grid-template-columns: minmax(0, 1.25fr) 1px minmax(0, 1fr); gap: 44px; margin-top: 36px; } }
  #shopify-section-{{ sid }} .clh__media { margin: 0 auto; max-width: 520px; width: 100%; }
  #shopify-section-{{ sid }} .clh__media img { display: block; width: 100%; height: auto; margin: 0; }
  #shopify-section-{{ sid }} .clh__rule { display: none; align-self: stretch; background: linear-gradient(to bottom, transparent, #dcdcd8 20%, #dcdcd8 80%, transparent); }
  @media (min-width: 750px) { #shopify-section-{{ sid }} .clh__rule { display: block; } }
  #shopify-section-{{ sid }} .clh__points { margin: 0 auto; padding: 0; list-style: none; display: grid; gap: 18px; text-align: left; max-width: 320px; }
  #shopify-section-{{ sid }} .clh__points li { display: grid; grid-template-columns: 24px 1fr; gap: 14px; align-items: center; color: var(--cl-ink); font-size: 16px; font-weight: 600; line-height: 1.35; }
  #shopify-section-{{ sid }} .clh__points span.clh__tick { display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; background: var(--cl-accent); color: #fff; }
  #shopify-section-{{ sid }} .clh__points svg { width: 12px; height: 12px; }
  #shopify-section-{{ sid }} .clh__cta { margin-top: 32px; }
  #shopify-section-{{ sid }} .cl-btn { position: relative; display: inline-flex; align-items: center; justify-content: center; gap: 12px; min-height: 60px; padding: 0 34px; border-radius: 14px; background: var(--cl-accent); color: #fff; font-size: 18px; font-weight: 600; text-decoration: none; box-shadow: 0 1px 0 rgba(255,255,255,.25) inset, 0 14px 34px -12px color-mix(in srgb, var(--cl-accent) 70%, transparent); transition: transform .25s ease, box-shadow .25s ease; }
  #shopify-section-{{ sid }} .cl-btn:hover { transform: translateY(-2px); box-shadow: 0 1px 0 rgba(255,255,255,.25) inset, 0 20px 40px -12px color-mix(in srgb, var(--cl-accent) 80%, transparent); }
  #shopify-section-{{ sid }} .cl-btn svg { width: 18px; height: 18px; transition: transform .25s ease; }
  #shopify-section-{{ sid }} .cl-btn:hover svg { transform: translateX(3px); }
  @media (max-width: 749px) { #shopify-section-{{ sid }} .cl-btn { width: 100%; } }
  #shopify-section-{{ sid }} .clh__note { margin: 14px 0 0; font-size: 14px; color: #6d6d74; }
  #shopify-section-{{ sid }} .clh [data-clh] { animation: clh-in-{{ sid }} .9s cubic-bezier(.2,.65,.25,1) both; animation-delay: var(--d, 0ms); }
  @keyframes clh-in-{{ sid }} { from { opacity: 0; transform: translate3d(0, 16px, 0); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .clh [data-clh] { animation: none; }
    #shopify-section-{{ sid }} .cl-btn, #shopify-section-{{ sid }} .cl-btn svg { transition: none; }
  }
  {%- if request.design_mode -%}#shopify-section-{{ sid }} .clh [data-clh] { animation: none; }{%- endif -%}
</style>
<section class="clh">
  <div class="clh__in">
    <h1 class="clh__title" data-clh>{%- if s.heading_first != blank -%}<span class="clh__first">{{ s.heading_first | escape }}</span>{%- endif -%}{{ s.heading | escape }}</h1>
    {%- if s.pills != blank -%}
      <ul class="clh__pills" role="list" data-clh style="--d: 80ms">
        {%- for line in pills -%}{%- assign t = line | strip -%}{%- if t != blank -%}<li><svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2.5 7.5l2.8 2.7L11.5 4"/></svg>{{ t | escape }}</li>{%- endif -%}{%- endfor -%}
      </ul>
    {%- endif -%}
    <div class="clh__row">
      <figure class="clh__media" data-clh style="--d: 140ms">
        {%- if s.image != blank -%}
          <img src="{{ s.image | image_url: width: 1100 }}" srcset="{{ s.image | image_url: width: 600 }} 600w, {{ s.image | image_url: width: 1100 }} 1100w, {{ s.image | image_url: width: 1300 }} 1300w" sizes="(min-width: 750px) 480px, 92vw" width="{{ s.image.width | default: 1300 }}" height="{{ s.image.height | default: 1100 }}" alt="{{ s.image_alt | default: s.image.alt | escape }}" loading="eager" fetchpriority="high" decoding="async">
        {%- endif -%}
      </figure>
      <span class="clh__rule" aria-hidden="true"></span>
      <ul class="clh__points" role="list" data-clh style="--d: 200ms">
        {%- for line in points -%}{%- assign t = line | strip -%}{%- if t != blank -%}<li><span class="clh__tick" aria-hidden="true"><svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M2.5 6.3l2.3 2.2L9.5 3.5"/></svg></span><span>{{ t | escape }}</span></li>{%- endif -%}{%- endfor -%}
      </ul>
    </div>
    <div class="clh__cta" data-clh style="--d: 260ms">
      {%- if s.button_label != blank -%}<a class="cl-btn" href="{{ buy }}">{{ s.button_label | escape }}<svg viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3.5 9h11M10 4.5L14.5 9 10 13.5"/></svg></a>{%- endif -%}
      {%- if s.note != blank -%}<p class="clh__note">{{ s.note | escape }}</p>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Course sales hero",
  "tag": "section",
  "class": "courselanding-hero-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "heading_first", "label": "First line, in the accent colour", "default": "The course:" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Say what someone will be able to do at the end" },
    { "type": "textarea", "id": "pills", "label": "Small ticked pills", "info": "One per line.", "default": "No experience needed\nShort lessons\nAt your own pace" },
    { "type": "image_picker", "id": "image", "label": "Picture", "info": "The course on screens works well, on a transparent ground." },
    { "type": "text", "id": "image_alt", "label": "Picture description" },
    { "type": "textarea", "id": "points", "label": "What is included", "info": "One per line.", "default": "Video lessons\nWeekly feedback\nWorksheets" },
    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_label", "label": "Label", "default": "Join the course" },
    { "type": "product", "id": "product", "label": "Course", "info": "The button goes straight to checkout with this product. Your first product when none is picked." },
    { "type": "checkbox", "id": "to_checkout", "label": "Button goes straight to checkout", "default": true },
    { "type": "url", "id": "button_link", "label": "Link when there is no product" },
    { "type": "text", "id": "note", "label": "Line under the button", "default": "One payment. 30 day refund." },
    { "type": "header", "content": "Type" },
    { "type": "range", "id": "heading_size", "label": "Heading size on desktop", "min": 32, "max": 80, "step": 2, "unit": "px", "default": 52 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size on phones", "min": 24, "max": 48, "step": 2, "unit": "px", "default": 34 },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "background", "label": "Background", "default": "#f6f6f4" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#2f5bea" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#141416" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#4b4b52" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Space above on desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Space below on desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 104 },
    { "type": "range", "id": "padding_top_mobile", "label": "Space above on phones", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 28 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Space below on phones", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "presets": [ { "name": "Course sales hero", "category": "Course landing" } ]
}
{% endschema %}
