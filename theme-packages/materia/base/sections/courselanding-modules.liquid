{%- comment -%}
  Course landing: the curriculum as weeks. A centred heading and line, then
  a grid of white cards, one per week or module: a small accent label, a
  title, a sentence and the lessons as a numbered list. Two across on
  desktop, one on a phone; cards rise in one after another.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign sid = section.id
-%}
<style>
  #shopify-section-{{ sid }} .clm {
    --cl-accent: {{ s.accent | default: '#2f5bea' }};
    --cl-ink: {{ s.heading_color | default: '#141416' }};
    --cl-text: {{ s.text_color | default: '#5a5a62' }};
    background: {{ s.background | default: '#f6f6f4' }};
    color: var(--cl-text);
    padding: {{ s.padding_top_mobile | default: 48 }}px 0 {{ s.padding_bottom_mobile | default: 48 }}px;
    scroll-margin-top: 100px;
  }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .clm { padding: {{ s.padding_top | default: 88 }}px 0 {{ s.padding_bottom | default: 88 }}px; } }
  #shopify-section-{{ sid }} .clm__in { max-width: 1164px; margin: 0 auto; padding: 0 20px; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .clm__in { padding: 0 32px; } }
  #shopify-section-{{ sid }} .clm__head { max-width: 640px; margin: 0 auto 32px; text-align: center; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .clm__head { margin-bottom: 52px; } }
  #shopify-section-{{ sid }} .clm__title { margin: 0 0 12px; color: var(--cl-ink); font-family: var(--heading-font, inherit); font-weight: 600; font-size: 32px; line-height: 1.1; letter-spacing: -.03em; text-wrap: balance; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .clm__title { font-size: 44px; } }
  #shopify-section-{{ sid }} .clm__title span { color: var(--cl-accent); }
  #shopify-section-{{ sid }} .clm__text { font-size: 17px; line-height: 1.6; }
  #shopify-section-{{ sid }} .clm__text p { margin: 0; }
  #shopify-section-{{ sid }} .clm__grid { margin: 0; padding: 0; list-style: none; display: grid; gap: 14px; }
  @media (min-width: 750px) { #shopify-section-{{ sid }} .clm__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; } }
  #shopify-section-{{ sid }} .clm__card { padding: 26px 22px; border-radius: 18px; background: #fff; border: 1px solid #e6e6e2; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .clm__card { padding: 32px 32px 30px; } }
  #shopify-section-{{ sid }} .clm__label { display: inline-block; margin: 0 0 14px; padding: 5px 10px; border-radius: 7px; background: color-mix(in srgb, var(--cl-accent) 9%, #ffffff); color: var(--cl-accent); font-size: 13px; font-weight: 600; }
  #shopify-section-{{ sid }} .clm__name { margin: 0 0 8px; color: var(--cl-ink); font-family: var(--heading-font, inherit); font-weight: 600; font-size: 22px; line-height: 1.2; letter-spacing: -.02em; }
  #shopify-section-{{ sid }} .clm__desc { margin: 0 0 18px; font-size: 15px; line-height: 1.55; }
  #shopify-section-{{ sid }} .clm__lessons { margin: 0; padding: 16px 0 0; list-style: none; border-top: 1px solid #ececea; display: grid; gap: 10px; counter-reset: clm; }
  #shopify-section-{{ sid }} .clm__lessons li { counter-increment: clm; display: grid; grid-template-columns: 26px 1fr; gap: 10px; align-items: baseline; color: var(--cl-ink); font-size: 15px; line-height: 1.45; }
  #shopify-section-{{ sid }} .clm__lessons li::before { content: counter(clm, decimal-leading-zero); color: #9a9aa2; font-size: 13px; font-variant-numeric: tabular-nums; }
  #shopify-section-{{ sid }} [data-clr].clr-wait { opacity: 0; transform: translate3d(0, 24px, 0); }
  #shopify-section-{{ sid }} [data-clr].clr-in { opacity: 1; transform: none; transition: opacity .85s cubic-bezier(.2,.65,.25,1) var(--d, 0ms), transform .85s cubic-bezier(.2,.65,.25,1) var(--d, 0ms); }
</style>
<section class="clm"{% if s.anchor != blank %} id="{{ s.anchor | handleize }}"{% endif %}>
  <div class="clm__in">
    <div class="clm__head" data-clr>
      <h2 class="clm__title">{{ s.heading | escape }}{% if s.heading_accent != blank %} <span>{{ s.heading_accent | escape }}</span>{% endif %}</h2>
      {%- if s.text != blank -%}<div class="clm__text">{{ s.text }}</div>{%- endif -%}
    </div>
    <ul class="clm__grid" role="list">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        {%- assign lessons = b.lessons | newline_to_br | split: '<br />' -%}
        <li class="clm__card" data-clr style="--d: {{ forloop.index0 | modulo: 2 | times: 90 }}ms" {{ block.shopify_attributes }}>
          {%- if b.label != blank -%}<span class="clm__label">{{ b.label | escape }}</span>{%- endif -%}
          <h3 class="clm__name">{{ b.title | escape }}</h3>
          {%- if b.text != blank -%}<p class="clm__desc">{{ b.text | escape }}</p>{%- endif -%}
          <ol class="clm__lessons" role="list">
            {%- for line in lessons -%}{%- assign t = line | strip -%}{%- if t != blank -%}<li>{{ t | escape }}</li>{%- endif -%}{%- endfor -%}
          </ol>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>
{%- unless request.design_mode -%}
<script>(function(){var r=document.getElementById('shopify-section-{{ sid }}');if(!r||!('IntersectionObserver' in window)||matchMedia('(prefers-reduced-motion: reduce)').matches)return;var h=innerHeight,io=new IntersectionObserver(function(es){es.forEach(function(e){if(!e.isIntersecting)return;var t=e.target;io.unobserve(t);requestAnimationFrame(function(){t.classList.add('clr-in')})})},{rootMargin:'0px 0px -6% 0px'});r.querySelectorAll('[data-clr]').forEach(function(el){if(el.getBoundingClientRect().top<h*.92)return;el.classList.add('clr-wait');io.observe(el)})})();</script>
{%- endunless -%}

{% schema %}
{
  "name": "Curriculum cards",
  "tag": "section",
  "class": "courselanding-modules-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What you will learn," },
    { "type": "text", "id": "heading_accent", "label": "Heading words in the accent colour", "default": "week by week" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Say how the course is paced.</p>" },
    { "type": "text", "id": "anchor", "label": "Address on the page", "default": "curriculum", "info": "A word a menu link can jump to, as /#word." },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "background", "label": "Background", "default": "#f6f6f4" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#2f5bea" },
    { "type": "color", "id": "heading_color", "label": "Headings", "default": "#141416" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#5a5a62" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Space above on desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 88 },
    { "type": "range", "id": "padding_bottom", "label": "Space below on desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 88 },
    { "type": "range", "id": "padding_top_mobile", "label": "Space above on phones", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Space below on phones", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "module",
      "name": "Week or module",
      "settings": [
        { "type": "text", "id": "label", "label": "Small label", "default": "Week 1" },
        { "type": "text", "id": "title", "label": "Title", "default": "The basics" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Say what this part is about." },
        { "type": "textarea", "id": "lessons", "label": "Lessons", "info": "One per line.", "default": "First lesson\nSecond lesson\nThird lesson" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Curriculum cards",
      "category": "Course landing",
      "blocks": [
        { "type": "module" },
        { "type": "module", "settings": { "label": "Week 2", "title": "Going further" } }
      ]
    }
  ]
}
{% endschema %}
