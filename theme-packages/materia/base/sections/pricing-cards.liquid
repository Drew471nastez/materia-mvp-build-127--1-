{%- comment -%}
  Pricing cards: one card per plan, side by side. Each plan block carries
  its own name, price (typed, or read from a product), compare at price,
  short note, features (one per line), button and badge. Colours come from
  the section's colour scheme, type from the theme's fonts, buttons from
  Theme settings > Buttons, corners from Theme settings > Corners and the
  space around it from Theme settings > Layout unless set here.
  The rows of every card line up (subgrid), so buttons sit level however
  long a description is.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign sid = section.id
  assign scheme = s.color_scheme.id | default: s.color_scheme | default: 'default-color-scheme'
  assign plans = section.blocks | where: 'type', 'plan'
  assign count = plans.size
  if count > 4
    assign count = 4
  endif
  if count < 1
    assign count = 1
  endif
  assign animation = settings.scroll_animation | default: 'none'
-%}
<style>
  #shopify-section-{{ sid }} { margin-top: 0 !important; margin-bottom: 0 !important; }
  .pcards-{{ sid }} {
    --pc-cols: {{ count }};
    --pc-gap: {{ s.card_gap | default: 20 }}px;
    --pc-radius: {% if s.use_theme_corners %}var(--card-radius, 6px){% else %}{{ s.card_radius | default: 8 }}px{% endif %};
    --pc-line: rgba(var(--color-heading-rgb), .14);
    --pc-soft: rgba(var(--color-heading-rgb), .04);
    background: var(--color-background);
    color: var(--color-text);
    padding-block: {% if s.use_theme_spacing %}var(--section-spacing, 64px){% else %}{{ s.padding_top_mobile }}px {{ s.padding_bottom_mobile }}px{% endif %};
  }
  @media (min-width: 768px) {
    .pcards-{{ sid }} { padding-block: {% if s.use_theme_spacing %}var(--section-spacing, 90px){% else %}{{ s.padding_top }}px {{ s.padding_bottom }}px{% endif %}; }
  }
  .pcards-{{ sid }} .pcards__inner { margin-inline: auto; padding-inline: var(--container-gutter, 20px); max-width: {% case s.section_width %}{% when 'container' %}calc(var(--page-width, 1200px) + var(--container-gutter, 20px) * 2){% when 'fluid_container' %}calc(var(--fluid-container-width, 1410px) + var(--container-gutter, 20px) * 2){% else %}none{% endcase %}; }
  .pcards-{{ sid }} .pcards__head { max-width: 640px; margin: 0 0 clamp(28px, 4vw, 48px); text-align: {{ s.heading_align }}; {% if s.heading_align == 'center' %}margin-inline: auto;{% endif %} }
  .pcards-{{ sid }} .pcards__eyebrow { margin: 0 0 10px; font-size: 1.3rem; letter-spacing: .08em; text-transform: uppercase; color: rgba(var(--color-text-rgb), .72); }
  .pcards-{{ sid }} .pcards__title { margin: 0; }
  .pcards-{{ sid }} .pcards__intro { margin-top: 12px; font-size: 1.5rem; line-height: 1.6; }
  .pcards-{{ sid }} .pcards__intro p { margin: 0; }
  .pcards-{{ sid }} .pcards__grid { display: grid; gap: var(--pc-gap); grid-template-columns: 1fr; margin: 0; padding: 0; list-style: none; }
  @media (min-width: 750px) { .pcards-{{ sid }} .pcards__grid { grid-template-columns: repeat(min(2, var(--pc-cols)), minmax(0, 1fr)); } }
  @media (min-width: 1025px) { .pcards-{{ sid }} .pcards__grid { grid-template-columns: repeat(var(--pc-cols), minmax(0, 1fr)); } }
  {%- if s.mobile_layout == 'swipe' %}
  @media (max-width: 749px) {
    .pcards-{{ sid }} .pcards__grid { grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: 84%; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--container-gutter, 20px); margin-inline: calc(var(--container-gutter, 20px) * -1); padding-inline: var(--container-gutter, 20px); padding-bottom: 4px; scrollbar-width: none; }
    .pcards-{{ sid }} .pcards__grid::-webkit-scrollbar { display: none; }
    .pcards-{{ sid }} .pcard { scroll-snap-align: start; }
  }
  {%- endif %}
  .pcards-{{ sid }} .pcards__grid:has(.pcard__badge) { padding-top: 14px; }
  .pcards-{{ sid }} .pcard { position: relative; display: grid; grid-template-rows: subgrid; grid-row: span 5; row-gap: 0; padding: clamp(24px, 2.6vw, 36px); border-radius: var(--pc-radius); min-width: 0; --pc-check-bg: rgba(var(--color-heading-rgb), .08); --pc-check-ink: var(--color-heading); transition: border-color .3s ease, box-shadow .3s ease, transform .3s cubic-bezier(.2,.7,.2,1), background-color .3s ease; }
  .pcards-{{ sid }} .pcard[data-featured] { --pc-check-bg: var(--btn-primary-bg-color, var(--color-heading)); --pc-check-ink: var(--btn-primary-color, var(--color-background)); }
  .pcards-{{ sid }}[data-style='outline'] .pcard { border: 1px solid var(--pc-line); }
  .pcards-{{ sid }}[data-style='filled'] .pcard { background: var(--pc-soft); }
  .pcards-{{ sid }}[data-style='lines'] .pcards__grid { gap: 0; }
  .pcards-{{ sid }}[data-style='lines'] .pcard { border-radius: 0; border-top: 1px solid var(--pc-line); padding-inline: 0; }
  @media (min-width: 750px) {
    .pcards-{{ sid }}[data-style='lines'] .pcard { padding-inline: clamp(20px, 2.4vw, 36px); border-top: 0; border-left: 1px solid var(--pc-line); }
    .pcards-{{ sid }}[data-style='lines'] .pcard:first-child { border-left: 0; padding-left: 0; }
  }
  /* The plan that stands out: a firmer edge (a ring, so the card keeps its size and its rows stay level with the others), a faint wash and a soft shadow under it. */
  .pcards-{{ sid }}[data-style='outline'] .pcard[data-featured] { border-color: var(--color-heading); box-shadow: 0 0 0 1px var(--color-heading), 0 24px 48px -30px rgba(0, 0, 0, .35); background: rgba(var(--color-heading-rgb), .025); }
  .pcards-{{ sid }}[data-style='filled'] .pcard[data-featured] { background: var(--color-background); box-shadow: inset 0 0 0 1.5px var(--color-heading), 0 24px 48px -30px rgba(0, 0, 0, .35); }
  @media (hover: hover) and (pointer: fine) {
    .pcards-{{ sid }}[data-style='outline'] .pcard:not([data-featured]):hover { border-color: rgba(var(--color-heading-rgb), .34); box-shadow: 0 18px 40px -30px rgba(0, 0, 0, .3); transform: translateY(-2px); }
    .pcards-{{ sid }}[data-style='filled'] .pcard:not([data-featured]):hover { background: rgba(var(--color-heading-rgb), .065); transform: translateY(-2px); }
  }
  @media (prefers-reduced-motion: reduce) { .pcards-{{ sid }} .pcard { transition: none; transform: none !important; } }
  .pcards-{{ sid }} .pcard__top { display: flex; flex-direction: column; gap: 8px; padding-bottom: 24px; }
  /* The badge sits on the card's top edge, out of the flow, so every plan's name starts on the same line. */
  .pcards-{{ sid }} .pcard__badge { position: absolute; top: 0; left: clamp(24px, 2.6vw, 36px); transform: translateY(-50%); padding: 5px 11px; border-radius: var(--bages-radius, 4px); background: var(--badge-background, var(--color-heading)); color: var(--badge-text, var(--color-background)); font-size: 1.1rem; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; line-height: 1.3; white-space: nowrap; }
  .pcards-{{ sid }}[data-style='lines'] .pcard__badge { position: static; transform: none; align-self: flex-start; order: -1; margin-bottom: 4px; }
  .pcards-{{ sid }} .pcard__name { margin: 0; --size: 2rem; }
  .pcards-{{ sid }} .pcard__desc { margin: 0; font-size: 1.4rem; line-height: 1.55; color: rgba(var(--color-text-rgb), .74); }
  .pcards-{{ sid }} .pcard__desc p { margin: 0; }
  .pcards-{{ sid }} .pcard__price { display: flex; flex-wrap: wrap; align-items: baseline; align-content: end; gap: 6px 10px; padding-bottom: 22px; }
  .pcards-{{ sid }} .pcard__amount { font-family: var(--heading-font); font-weight: var(--heading-weight); letter-spacing: var(--heading-letter-spacing, -0.01em); color: var(--color-heading); font-size: clamp(3rem, 3vw, {{ s.price_size | default: 40 | divided_by: 10.0 }}rem); line-height: 1; font-variant-numeric: tabular-nums; }
  .pcards-{{ sid }} .pcard__compare { font-size: 1.5rem; color: rgba(var(--color-text-rgb), .55); text-decoration-thickness: 1px; }
  .pcards-{{ sid }} .pcard__note { flex-basis: 100%; font-size: 1.3rem; color: rgba(var(--color-text-rgb), .66); }
  .pcards-{{ sid }} .pcard__cta { padding-bottom: 26px; }
  .pcards-{{ sid }} .pcard__cta [data-theme-button] { width: 100%; }
  .pcards-{{ sid }} .pcard__features { margin: 0; padding: 22px 0 0; list-style: none; border-top: 1px solid var(--pc-line); display: flex; flex-direction: column; gap: 12px; font-size: 1.4rem; line-height: 1.45; }
  .pcards-{{ sid }} .pcard__features li { display: grid; grid-template-columns: 18px 1fr; gap: 12px; align-items: start; }
  /* Included: a small filled dot with a check in it (the button colour on the plan that stands out). Not included: a short dash, quieter text. */
  .pcards-{{ sid }} .pcard__features svg { width: 18px; height: 18px; margin-top: 1px; overflow: visible; }
  .pcards-{{ sid }} .pcard__features svg circle { fill: var(--pc-check-bg); }
  .pcards-{{ sid }} .pcard__features svg path { stroke: var(--pc-check-ink); }
  .pcards-{{ sid }} .pcard__features li[data-off] { color: rgba(var(--color-text-rgb), .48); }
  .pcards-{{ sid }} .pcard__features li[data-off] svg path { stroke: currentColor; }
  .pcards-{{ sid }} .pcards__foot { margin-top: 24px; font-size: 1.3rem; color: rgba(var(--color-text-rgb), .72); text-align: {{ s.heading_align }}; }
  .pcards-{{ sid }} .pcards__foot p { margin: 0; }
  .pcards-{{ sid }} .pcards__empty { padding: 32px; border: 1px dashed var(--pc-line); border-radius: var(--pc-radius); text-align: center; font-size: 1.4rem; }
</style>
<section class="pcards pcards-{{ sid }} color-{{ scheme }} gradient" data-style="{{ s.card_style | default: 'outline' }}" aria-labelledby="pcards-title-{{ sid }}">
  <div class="pcards__inner">
    {%- if s.eyebrow != blank or s.heading != blank or s.intro != blank -%}
      <header class="pcards__head">
        {%- if s.eyebrow != blank -%}<p class="pcards__eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="pcards__title {{ s.heading_size | default: 'h2' }}" id="pcards-title-{{ sid }}">{{ s.heading | escape }}</h2>{%- endif -%}
        {%- if s.intro != blank -%}<div class="pcards__intro">{{ s.intro }}</div>{%- endif -%}
      </header>
    {%- endif -%}
    {%- if plans.size > 0 -%}
      <ul class="pcards__grid" role="list">
        {%- for block in plans limit: 4 -%}
          {%- liquid
            assign b = block.settings
            assign p = b.plan_product
            if p != blank and p.title != blank
              assign amount = p.price | money_without_trailing_zeros
              assign was = ''
              if p.compare_at_price > p.price
                assign was = p.compare_at_price | money_without_trailing_zeros
              endif
              assign href = p.url
            else
              assign amount = b.price
              assign was = b.compare_price
              assign href = b.button_link
            endif
            assign style = b.button_style
            if style == 'auto'
              if b.featured
                assign style = 'primary'
              else
                assign style = 'secondary'
              endif
            endif
            assign lines = b.features | newline_to_br | split: '<br />'
          -%}
          <li class="pcard"{% if b.featured %} data-featured{% endif %} {{ block.shopify_attributes }}>
            <div class="pcard__top">
              {%- if b.badge != blank -%}<span class="pcard__badge">{{ b.badge | escape }}</span>{%- endif -%}
              <h3 class="pcard__name h5">{{ b.name | escape }}</h3>
              {%- if b.description != blank -%}<div class="pcard__desc">{{ b.description }}</div>{%- endif -%}
            </div>
            <div class="pcard__price">
              {%- if amount != blank -%}<span class="pcard__amount">{{ amount }}</span>{%- endif -%}
              {%- if was != blank -%}<s class="pcard__compare"><span class="visually-hidden">Was </span>{{ was }}</s>{%- endif -%}
              {%- if b.note != blank -%}<span class="pcard__note">{{ b.note | escape }}</span>{%- endif -%}
            </div>
            <div class="pcard__cta">
              {%- if b.button_label != blank -%}
                <a {% if href != blank %}href="{{ href }}"{% else %}role="link" aria-disabled="true"{% endif %} data-theme-button="{{ style }}" data-sl-button>{{ b.button_label | escape }}</a>
              {%- endif -%}
            </div>
            <ul class="pcard__features" role="list">
              {%- for line in lines -%}
                {%- assign t = line | strip -%}
                {%- if t == blank -%}{%- continue -%}{%- endif -%}
                {%- assign first = t | slice: 0 -%}
                {%- if first == '-' -%}
                  <li data-off><svg viewBox="0 0 18 18" fill="none" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M6 9h6"/></svg><span><span class="visually-hidden">Not included: </span>{{ t | remove_first: '-' | strip | escape }}</span></li>
                {%- else -%}
                  <li><svg viewBox="0 0 18 18" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="9" cy="9" r="9"/><path d="M5.6 9.3l2.2 2.1 4.6-4.8"/></svg><span>{{ t | escape }}</span></li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </li>
        {%- endfor -%}
      </ul>
    {%- elsif request.design_mode -%}
      <p class="pcards__empty">Add a plan to show a card.</p>
    {%- endif -%}
    {%- if s.footnote != blank -%}<div class="pcards__foot">{{ s.footnote }}</div>{%- endif -%}
  </div>
</section>
{%- if animation != 'none' -%}
<style>#shopify-section-{{ sid }}.scroll-trigger { --animation-duration: {{ settings.animation_duration | default: 700 }}ms; --animation-delay: {{ settings.animation_delay | default: 0 }}ms; }</style>
<script>(function(){var el=document.getElementById('shopify-section-{{ sid }}');if(!el||el.classList.contains('scroll-trigger'))return;el.classList.add('scroll-trigger',{{ animation | json }});})();</script>
{%- endif -%}

{% schema %}
{
  "name": "Pricing cards",
  "tag": "div",
  "class": "pricing-cards-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "default" },
    { "type": "text", "id": "eyebrow", "label": "Small text above", "default": "Pricing" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pick what suits you" },
    { "type": "richtext", "id": "intro", "label": "Text under the heading", "default": "<p>Pay once. Keep it for good.</p>" },
    {
      "type": "select", "id": "heading_size", "label": "Heading size", "default": "h2",
      "options": [ { "value": "h3", "label": "Small" }, { "value": "h2", "label": "Medium" }, { "value": "h1", "label": "Large" } ]
    },
    {
      "type": "select", "id": "heading_align", "label": "Heading alignment", "default": "center",
      "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Centre" } ]
    },
    { "type": "richtext", "id": "footnote", "label": "Small print under the cards" },
    { "type": "header", "content": "Cards" },
    {
      "type": "select", "id": "card_style", "label": "Card style", "default": "outline",
      "options": [ { "value": "outline", "label": "Outline" }, { "value": "filled", "label": "Filled" }, { "value": "lines", "label": "Columns with lines" } ]
    },
    { "type": "checkbox", "id": "use_theme_corners", "label": "Use the theme's corners", "default": true },
    { "type": "range", "id": "card_radius", "label": "Corners", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 8 },
    { "type": "range", "id": "card_gap", "label": "Space between cards", "min": 0, "max": 48, "step": 4, "unit": "px", "default": 20 },
    { "type": "range", "id": "price_size", "label": "Price size", "min": 28, "max": 64, "step": 2, "unit": "px", "default": 40 },
    {
      "type": "select", "id": "mobile_layout", "label": "On phones", "default": "stack",
      "options": [ { "value": "stack", "label": "One under another" }, { "value": "swipe", "label": "Swipe sideways" } ]
    },
    { "type": "header", "content": "Layout" },
    {
      "type": "select", "id": "section_width", "label": "Width", "default": "container",
      "options": [ { "value": "container", "label": "Default" }, { "value": "fluid_container", "label": "Wide" }, { "value": "full_width", "label": "Full width" } ]
    },
    { "type": "checkbox", "id": "use_theme_spacing", "label": "Use the theme's space between sections", "default": true },
    { "type": "range", "id": "padding_top", "label": "Space above on desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Space below on desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_top_mobile", "label": "Space above on phones", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Space below on phones", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "plan",
      "name": "Plan",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "name", "label": "Plan name", "default": "Plan" },
        { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Who this plan is for, in one line.</p>" },
        { "type": "text", "id": "badge", "label": "Badge" },
        { "type": "checkbox", "id": "featured", "label": "Stand out from the others", "default": false },
        { "type": "header", "content": "Price" },
        { "type": "product", "id": "plan_product", "label": "Product", "info": "Takes the price, compare at price and link from the product. Leave empty to type them." },
        { "type": "text", "id": "price", "label": "Price", "default": "$29" },
        { "type": "text", "id": "compare_price", "label": "Compare at price" },
        { "type": "text", "id": "note", "label": "Note under the price", "default": "One payment" },
        { "type": "header", "content": "Features" },
        { "type": "textarea", "id": "features", "label": "Features", "info": "One per line. Start a line with a minus sign to show it as not included.", "default": "Everything in the guide\nFree updates\n- One to one call" },
        { "type": "header", "content": "Button" },
        { "type": "text", "id": "button_label", "label": "Label", "default": "Choose" },
        { "type": "url", "id": "button_link", "label": "Link" },
        {
          "type": "select", "id": "button_style", "label": "Style", "default": "auto",
          "options": [ { "value": "auto", "label": "Filled when it stands out" }, { "value": "primary", "label": "Filled" }, { "value": "secondary", "label": "Outline" } ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pricing cards",
      "category": "Pricing",
      "blocks": [
        { "type": "plan", "settings": { "name": "Guide", "description": "<p>The book and nothing else.</p>", "price": "$24", "note": "One payment", "features": "The 64 page PDF\nFree updates\n- Worksheets\n- Video walkthrough", "button_label": "Get the guide" } },
        { "type": "plan", "settings": { "name": "Guide and worksheets", "description": "<p>The book with every exercise ready to fill in.</p>", "price": "$34", "note": "One payment", "badge": "Most chosen", "featured": true, "features": "The 64 page PDF\nFree updates\nTwelve worksheets\n- Video walkthrough", "button_label": "Get both" } },
        { "type": "plan", "settings": { "name": "Complete", "description": "<p>Everything, plus an hour of video.</p>", "price": "$59", "compare_price": "$72", "note": "One payment", "features": "The 64 page PDF\nFree updates\nTwelve worksheets\nVideo walkthrough", "button_label": "Get everything" } }
      ]
    }
  ]
}
{% endschema %}
