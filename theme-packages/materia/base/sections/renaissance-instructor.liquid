{%- comment -%}
  Digital Renaissance: the instructor. A tall portrait in a thin frame
  with a soft accent light behind it and a name card over its corner;
  beside it a small label, a heading, the story in a few lines, a short
  list of credentials (one per line), a quote and social links.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign creds = st.credentials | newline_to_br | split: '<br />'
-%}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap">
<style>
  #shopify-section-{{ sid }} .rni { --gold: {{ st.gold | default: '#f2bd4f' }}; --lapis: {{ st.accent | default: '#3d5afe' }}; background: {{ st.background | default: '#07080d' }}; color: {{ st.text_color | default: '#a7adbf' }}; padding: {{ st.padding_top_mobile | default: 56 }}px 20px {{ st.padding_bottom_mobile | default: 56 }}px; overflow: hidden; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .rni { padding: {{ st.padding_top | default: 112 }}px 40px {{ st.padding_bottom | default: 112 }}px; } }
  #shopify-section-{{ sid }} .rni__in { max-width: 1120px; margin: 0 auto; display: grid; grid-template-columns: minmax(0, 1fr); gap: 40px; align-items: center; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .rni__in { grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); gap: 88px; } }
  #shopify-section-{{ sid }} .rni__media { position: relative; margin: 0 auto; width: 100%; max-width: 460px; }
  #shopify-section-{{ sid }} .rni__media::before { content: ""; position: absolute; inset: 10% -14% -6% -14%; background: radial-gradient(closest-side, color-mix(in srgb, var(--lapis) 45%, transparent), transparent); pointer-events: none; }
  #shopify-section-{{ sid }} .rni__frame { position: relative; aspect-ratio: 4 / 5; border-radius: 22px; overflow: hidden; border: 1px solid rgba(255,255,255,.12); background: #10121a; }
  #shopify-section-{{ sid }} .rni__frame img, #shopify-section-{{ sid }} .rni__frame > svg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 20%; }
  #shopify-section-{{ sid }} .rni__card { position: absolute; right: -8px; bottom: 22px; padding: 12px 16px; border-radius: 14px; background: rgba(12,13,20,.82); border: 1px solid rgba(255,255,255,.12); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .rni__card { right: -28px; } }
  #shopify-section-{{ sid }} .rni__card b { display: block; color: #fff; font-size: 15px; font-weight: 600; }
  #shopify-section-{{ sid }} .rni__card span { display: block; color: var(--gold); font-size: 12.5px; }
  #shopify-section-{{ sid }} .rni__eyebrow { margin: 0 0 12px; color: var(--gold); font-size: 12px; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; }
  #shopify-section-{{ sid }} .rni__title { margin: 0 0 18px; color: #fff; font-family: var(--heading-font, sans-serif); font-weight: 600; font-size: 34px; line-height: 1.06; letter-spacing: -.035em; text-wrap: balance; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .rni__title { font-size: 50px; } }
  #shopify-section-{{ sid }} .rni__title em { font-family: 'Instrument Serif', Georgia, serif; font-weight: 400; color: var(--gold); }
  #shopify-section-{{ sid }} .rni__text { font-size: 16.5px; line-height: 1.65; }
  #shopify-section-{{ sid }} .rni__text p { margin: 0 0 12px; }
  #shopify-section-{{ sid }} .rni__creds { display: grid; grid-template-columns: minmax(0, 1fr); gap: 10px; margin: 22px 0 0; padding: 0; list-style: none; }
  @media (min-width: 600px) { #shopify-section-{{ sid }} .rni__creds { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  #shopify-section-{{ sid }} .rni__creds li { display: flex; gap: 10px; align-items: flex-start; color: #e3e5ee; font-size: 14.5px; line-height: 1.45; }
  #shopify-section-{{ sid }} .rni__creds svg { flex: 0 0 auto; width: 16px; height: 16px; margin-top: 2px; color: var(--gold); }
  #shopify-section-{{ sid }} .rni__quote { margin: 28px 0 0; padding: 0 0 0 20px; border: 0; border-left: 2px solid var(--lapis); background: none; color: #fff; font-family: 'Instrument Serif', Georgia, serif; font-style: italic; font-size: 24px; line-height: 1.3; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .rni__quote { font-size: 28px; } }
  #shopify-section-{{ sid }} .rni__social { display: flex; flex-wrap: wrap; gap: 8px; margin: 26px 0 0; padding: 0; list-style: none; }
  #shopify-section-{{ sid }} .rni__social a { display: inline-flex; align-items: center; gap: 8px; min-height: 40px; padding: 0 14px; border-radius: 10px; border: 1px solid rgba(255,255,255,.14); color: #fff; font-size: 13.5px; font-weight: 500; text-decoration: none; transition: background-color .2s ease; }
  #shopify-section-{{ sid }} .rni__social a:hover { background: rgba(255,255,255,.08); }
</style>
<section data-own-size class="rni"{% if st.anchor != blank %} id="{{ st.anchor | handleize }}"{% endif %}>
  <div class="rni__in">
    <div class="rni__media">
      <figure class="rni__frame" style="margin:0">
        {%- if st.image != blank -%}
          <img src="{{ st.image | image_url: width: 960 }}" srcset="{{ st.image | image_url: width: 520 }} 520w, {{ st.image | image_url: width: 960 }} 960w" sizes="(min-width: 990px) 460px, 92vw" width="{{ st.image.width | default: 960 }}" height="{{ st.image.height | default: 1200 }}" alt="{{ st.image_alt | default: st.image.alt | escape }}" loading="lazy" decoding="async">
        {%- else -%}
          {{ 'image' | placeholder_svg_tag }}
        {%- endif -%}
      </figure>
      {%- if st.name != blank -%}<p class="rni__card" style="margin:0"><b>{{ st.name | escape }}</b><span>{{ st.role | escape }}</span></p>{%- endif -%}
    </div>
    <div>
      {%- if st.eyebrow != blank -%}<p class="rni__eyebrow">{{ st.eyebrow | escape }}</p>{%- endif -%}
      {%- if st.heading != blank -%}<h2 class="rni__title">{{ st.heading }}</h2>{%- endif -%}
      {%- if st.text != blank -%}<div class="rni__text">{{ st.text }}</div>{%- endif -%}
      {%- if st.credentials != blank -%}
        <ul class="rni__creds">{%- for c in creds -%}{%- assign line = c | strip -%}{%- if line != blank -%}<li><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 1.8c.6 4 2.2 5.6 6.2 6.2-4 .6-5.6 2.2-6.2 6.2C7.4 10.2 5.8 8.6 1.8 8c4-.6 5.6-2.2 6.2-6.2z"/></svg>{{ line | escape }}</li>{%- endif -%}{%- endfor -%}</ul>
      {%- endif -%}
      {%- if st.quote != blank -%}<blockquote class="rni__quote">{{ st.quote | escape }}</blockquote>{%- endif -%}
      {%- if st.social1_label != blank or st.social2_label != blank -%}
        <ul class="rni__social">
          {%- if st.social1_label != blank -%}<li><a href="{{ st.social1_url | default: '#' }}" target="_blank" rel="noopener">{{ st.social1_label | escape }}</a></li>{%- endif -%}
          {%- if st.social2_label != blank -%}<li><a href="{{ st.social2_url | default: '#' }}" target="_blank" rel="noopener">{{ st.social2_label | escape }}</a></li>{%- endif -%}
          {%- if st.social3_label != blank -%}<li><a href="{{ st.social3_url | default: '#' }}" target="_blank" rel="noopener">{{ st.social3_label | escape }}</a></li>{%- endif -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</section>
{%- if st.next_anchor != blank -%}<span id="{{ st.next_anchor | handleize }}" class="rni-next" aria-hidden="true" style="display:block;height:0;scroll-margin-top:72px"></span>{%- endif -%}

{% schema %}
{
  "name": "Renaissance instructor",
  "tag": "section",
  "class": "renaissance-instructor-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "anchor", "label": "Name for links to this place", "default": "instructor" },
    { "type": "text", "id": "next_anchor", "label": "Name for links to the section after this one", "info": "For a section without its own name, such as Pricing cards: links to /#pricing land just below this section." },
    { "type": "image_picker", "id": "image", "label": "Portrait" },
    { "type": "text", "id": "image_alt", "label": "Alt text" },
    { "type": "text", "id": "name", "label": "Name on the card", "default": "Your name" },
    { "type": "text", "id": "role", "label": "Line on the card", "default": "Your instructor" },
    { "type": "text", "id": "eyebrow", "label": "Small line above", "default": "Your instructor" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Learn from someone who <em>does it daily</em>" },
    { "type": "richtext", "id": "text", "label": "Story", "default": "<p>Who you are and why you teach this, in a few honest lines.</p>" },
    { "type": "textarea", "id": "credentials", "label": "Credentials, one per line", "default": "Ten years in the field\nTaught at workshops\nRuns a small studio\nWrites a weekly letter" },
    { "type": "text", "id": "quote", "label": "Quote" },
    { "type": "text", "id": "social1_label", "label": "Link 1", "default": "YouTube" },
    { "type": "url", "id": "social1_url", "label": "Link 1 goes to" },
    { "type": "text", "id": "social2_label", "label": "Link 2", "default": "LinkedIn" },
    { "type": "url", "id": "social2_url", "label": "Link 2 goes to" },
    { "type": "text", "id": "social3_label", "label": "Link 3" },
    { "type": "url", "id": "social3_url", "label": "Link 3 goes to" },
    { "type": "color", "id": "background", "label": "Background", "default": "#07080d" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#3d5afe" },
    { "type": "color", "id": "gold", "label": "Highlight", "default": "#f2bd4f" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#a7adbf" },
    { "type": "range", "id": "padding_top", "label": "Space above on a computer", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 112 },
    { "type": "range", "id": "padding_bottom", "label": "Space below on a computer", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 112 },
    { "type": "range", "id": "padding_top_mobile", "label": "Space above on a phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Space below on a phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "presets": [ { "name": "Renaissance instructor", "category": "Digital Renaissance" } ]
}
{% endschema %}
