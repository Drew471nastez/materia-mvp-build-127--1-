{%- comment -%}
Video sales letter: a centred call to action, a label, a two part heading,
  a line and one or two buttons, with a soft light behind it. Used for
  booking a call and for the last word on the page.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
-%}
<style>
  .vsl { position: relative; color: var(--vsl-text, #a3a3a8); font-family: var(--body-font, inherit); -webkit-font-smoothing: antialiased; }
  .vsl *, .vsl *::before, .vsl *::after { box-sizing: border-box; }
  .vsl__inner { position: relative; max-width: var(--vsl-max, 1120px); margin: 0 auto; padding: 0 20px; }
  .vsl__head { text-align: center; margin: 0 auto 44px; max-width: 760px; }
  .vsl__eyebrow { display: flex; align-items: center; justify-content: center; gap: 14px; margin: 0 0 18px; font-size: 11px; font-weight: 500; letter-spacing: .24em; text-transform: uppercase; color: rgba(var(--vsl-ink-rgb, 255,255,255),.6); }
  .vsl__eyebrow::before, .vsl__eyebrow::after { content: ""; flex: 0 0 34px; height: 1px; background: linear-gradient(90deg, rgba(var(--vsl-ink-rgb, 255,255,255),0), rgba(var(--vsl-ink-rgb, 255,255,255),.5)); }
  .vsl__eyebrow::after { background: linear-gradient(270deg, rgba(var(--vsl-ink-rgb, 255,255,255),0), rgba(var(--vsl-ink-rgb, 255,255,255),.5)); }
  .vsl__title { margin: 0; color: var(--vsl-head, rgb(var(--vsl-ink-rgb, 255,255,255))); font-family: var(--heading-font, inherit); font-weight: 700; font-size: clamp(32px, 4.6vw, 52px); line-height: 1.06; letter-spacing: -.035em; text-wrap: balance; }
  .vsl__title em, .vsl em.vsl-serif { font-style: normal; color: rgba(var(--vsl-ink-rgb, 255,255,255),.6); }
  .vsl__lede { margin: 16px auto 0; max-width: 580px; font-size: 15px; line-height: 1.65; }
  .vsl__lede p { margin: 0; }
  .vsl-btn {
    position: relative; isolation: isolate; overflow: hidden;
    display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 48px; padding: 0 24px;
    border-radius: 999px; border: 1px solid rgba(var(--vsl-ink-rgb, 255,255,255),.24); background: rgba(var(--vsl-surface-rgb, 10,10,12),.85); color: rgb(var(--vsl-ink-rgb, 255,255,255));
    font-family: var(--body-font, inherit); font-size: 14px; font-weight: 600; letter-spacing: -.005em; text-decoration: none; white-space: nowrap;
    box-shadow: inset 0 1px 0 rgba(var(--vsl-ink-rgb, 255,255,255),.22), 0 0 0 4px rgba(var(--vsl-ink-rgb, 255,255,255),.03), 0 14px 40px -14px rgba(var(--vsl-ink-rgb, 255,255,255),.35);
    transition: transform .35s cubic-bezier(.2,.7,.2,1), border-color .35s, box-shadow .35s;
  }
  .vsl-btn::before { content: ""; position: absolute; z-index: -1; top: -1px; left: -40%; width: 40%; height: 2px; background: linear-gradient(90deg, transparent, rgb(var(--vsl-ink-rgb, 255,255,255)), transparent); opacity: .9; transition: transform 1.1s cubic-bezier(.2,.7,.2,1); }
  .vsl-btn:hover { transform: translateY(-1px); border-color: rgba(var(--vsl-ink-rgb, 255,255,255),.5); box-shadow: inset 0 1px 0 rgba(var(--vsl-ink-rgb, 255,255,255),.3), 0 0 0 4px rgba(var(--vsl-ink-rgb, 255,255,255),.05), 0 18px 50px -14px rgba(var(--vsl-ink-rgb, 255,255,255),.45); }
  .vsl-btn:hover::before { transform: translateX(350%); }
  .vsl-btn:focus-visible { outline: 2px solid rgb(var(--vsl-ink-rgb, 255,255,255)); outline-offset: 3px; }
  .vsl-btn svg { width: 16px; height: 16px; flex: none; transition: transform .35s cubic-bezier(.2,.7,.2,1); }
  .vsl-btn:hover svg { transform: translateX(3px); }
  .vsl-btn--light { background: rgb(var(--vsl-ink-rgb, 255,255,255)); color: rgb(var(--vsl-surface-rgb, 10,10,10)); border-color: rgb(var(--vsl-ink-rgb, 255,255,255)); box-shadow: 0 14px 40px -14px rgba(var(--vsl-ink-rgb, 255,255,255),.5); }
  .vsl-btn--light::before { display: none; }
  .vsl-btn--ghost { background: transparent; box-shadow: none; border-color: rgba(var(--vsl-ink-rgb, 255,255,255),.16); }
  .vsl__actions { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 12px; margin-top: 30px; }
  .vsl-card {
    position: relative; border-radius: 18px; border: 1px solid rgba(var(--vsl-ink-rgb, 255,255,255),.09);
    background: linear-gradient(180deg, rgba(var(--vsl-ink-rgb, 255,255,255),.06), rgba(var(--vsl-ink-rgb, 255,255,255),.015) 60%), rgba(var(--vsl-surface-rgb, 12,12,14),.72);
    box-shadow: inset 0 1px 0 rgba(var(--vsl-ink-rgb, 255,255,255),.07), 0 30px 60px -40px rgba(0,0,0,.9);
  }
  .vsl--line { padding-top: 1px; }
  .vsl--line::before { content: ""; position: absolute; left: 50%; top: 0; width: min(1120px, calc(100% - 40px)); height: 1px; transform: translateX(-50%); background: linear-gradient(90deg, rgba(var(--vsl-ink-rgb, 255,255,255),0), rgba(var(--vsl-ink-rgb, 255,255,255),.26) 50%, rgba(var(--vsl-ink-rgb, 255,255,255),0)); }
  .vsl--line::after { content: ""; position: absolute; left: 50%; top: 0; width: min(900px, 90%); height: 180px; transform: translateX(-50%); pointer-events: none; background: radial-gradient(50% 100% at 50% 0, rgba(var(--vsl-ink-rgb, 255,255,255),.07), rgba(var(--vsl-ink-rgb, 255,255,255),0)); }
  @media (max-width: 749px) { .vsl__eyebrow { letter-spacing: .18em; gap: 10px; } .vsl__eyebrow::before, .vsl__eyebrow::after { flex-basis: 22px; } .vsl__head { margin-bottom: 32px; } }
  html.vsl-js .vsl [data-motion][data-vsl-armed] { opacity: 0; transform: translate3d(0, 12px, 0); transition: opacity .45s cubic-bezier(.25,.6,.3,1), transform .45s cubic-bezier(.25,.6,.3,1); transition-delay: var(--d, 0ms); }
  html.vsl-js .vsl [data-motion][data-vsl-armed].is-in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    html.vsl-js .vsl [data-motion] { opacity: 1; transform: none; transition: none; }
    .vsl-btn, .vsl-btn::before, .vsl-btn svg { transition: none; }
  }

  #shopify-section-{{ sid }} .vsl { padding-top: {{ st.padding_top_mobile | default: 64 }}px; padding-bottom: {{ st.padding_bottom_mobile | default: 64 }}px; }
  @media (min-width: 750px) { #shopify-section-{{ sid }} .vsl { padding-top: {{ st.padding_top | default: 96 }}px; padding-bottom: {{ st.padding_bottom | default: 96 }}px; } }

  .vsl-cta { overflow: hidden; }
  .vsl-cta__glow { position: absolute; left: 50%; top: 50%; width: min(820px, 120%); height: 420px; transform: translate(-50%, -50%); pointer-events: none;
    background: radial-gradient(50% 50% at 50% 50%, rgba(var(--vsl-ink-rgb, 255,255,255),.09), rgba(var(--vsl-ink-rgb, 255,255,255),0) 70%); }
  .vsl-cta .vsl__head { margin-bottom: 0; }
  .vsl-cta--big .vsl__title { font-size: clamp(36px, 5.4vw, 64px); }
  .vsl-cta__note { margin: 16px 0 0; font-size: 13px; color: rgba(var(--vsl-ink-rgb, 255,255,255),.5); }
</style>
<div data-own-font class="vsl{% render 'vsl-frame', section: section, part: 'class' %}{% if st.line_above %} vsl--line{% endif %} vsl-cta{% if st.size == 'big' %} vsl-cta--big{% endif %}" style="{% render 'vsl-frame', section: section, part: 'style' %}">{% render 'vsl-frame', section: section, part: 'bg' %}
  {%- if st.glow -%}<div class="vsl-cta__glow" aria-hidden="true"></div>{%- endif -%}
  <div class="vsl__inner">
    {%- if st.eyebrow != blank or st.heading != blank or st.text != blank -%}
      <div class="vsl__head" data-motion>
        {%- if st.eyebrow != blank -%}<p class="vsl__eyebrow"><span>{{ st.eyebrow | escape }}</span></p>{%- endif -%}
        {%- if st.heading != blank -%}<h2 class="vsl__title">{%- assign vsl_parts = st.heading | escape | split: '*' -%}{%- for vsl_part in vsl_parts -%}{%- assign vsl_odd = forloop.index0 | modulo: 2 -%}{%- if vsl_odd == 1 -%}<em>{{ vsl_part | replace: '|', '<br>' }}</em>{%- else -%}{{ vsl_part | replace: '|', '<br>' }}{%- endif -%}{%- endfor -%}</h2>{%- endif -%}
        {%- if st.text != blank -%}<div class="vsl__lede">{{ st.text }}</div>{%- endif -%}
        {%- if st.button_label != blank or st.button2_label != blank -%}
          <div class="vsl__actions">
            {%- if st.button_label != blank -%}<a class="vsl-btn" href="{{ st.button_link | default: '#' }}">{{ st.button_label | escape }}<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 8h10M9 4l4 4-4 4"/></svg></a>{%- endif -%}
            {%- if st.button2_label != blank -%}<a class="vsl-btn vsl-btn--ghost" href="{{ st.button2_link | default: '#' }}">{{ st.button2_label | escape }}</a>{%- endif -%}
          </div>
        {%- endif -%}
        {%- if st.note != blank -%}<p class="vsl-cta__note">{{ st.note | escape }}</p>{%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;
    var still = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!('IntersectionObserver' in window) || still) return;
    document.documentElement.classList.add('vsl-js');
    if (!window.__vslSeen) {
      window.__vslSeen = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('is-in'); window.__vslSeen.unobserve(e.target); } });
      }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
    }
    /* Round 69: what is in the first screen is simply there; only what starts below it waits (armed). */
    root.querySelectorAll('[data-motion]:not(.is-in)').forEach(function (el) { var r = el.getBoundingClientRect(); if (r.top < innerHeight && r.bottom > 0) { el.classList.add('is-in'); return; } el.setAttribute('data-vsl-armed', ''); window.__vslSeen.observe(el); });
  })();
</script>

{% schema %}
{
  "name": "Call to action",
  "tag": "section",
  "class": "vsl-cta-section",
  "settings": [
    { "type": "header", "content": "Colours and background" },
    { "type": "select", "id": "vsl_colors", "label": "Colours", "default": "designed", "options": [{ "value": "designed", "label": "As designed (light on dark)" }, { "value": "scheme", "label": "Colour scheme" }] },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default", "visible_if": "{{ section.settings.vsl_colors == 'scheme' }}" },
    { "type": "color", "id": "background_color", "label": "Background colour", "info": "Empty keeps the page's background." },
    { "type": "image_picker", "id": "background_image", "label": "Background picture" },
    { "type": "color", "id": "overlay_color", "label": "Overlay on the picture", "default": "#000000", "visible_if": "{{ section.settings.background_image != blank }}" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay strength", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 55, "visible_if": "{{ section.settings.background_image != blank }}" },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small label",
      "default": "Schedule a call"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Not sure yet? Talk it through",
      "info": "Words between asterisks are set a shade lighter, like *this*. A | starts a new line."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Pick a time and we look at your idea together, in thirty minutes.</p>"
    },
    {
      "type": "select",
      "id": "size",
      "label": "Heading size",
      "default": "normal",
      "options": [
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "big",
          "label": "Big"
        }
      ]
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Book a free call"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "default": "/pages/book-a-call"
    },
    {
      "type": "text",
      "id": "button2_label",
      "label": "Second button label"
    },
    {
      "type": "url",
      "id": "button2_link",
      "label": "Second button link"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Small note under the buttons"
    },
    {
      "type": "checkbox",
      "id": "glow",
      "label": "Soft light behind",
      "default": true
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "checkbox",
      "id": "line_above",
      "label": "Thin glowing line above",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Space above, desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 112
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Space below, desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 112
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Space above, phone",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Space below, phone",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "Call to action",
      "category": "Video sales letter"
    }
  ]
}
{% endschema %}
