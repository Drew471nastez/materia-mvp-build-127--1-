{%- comment -%}
  Poster shop: questions with a small drawn icon in front of each, opening
  in place (details and summary: no script, keyboard and screen readers
  work as they do everywhere).
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign sid = section.id
  assign icon_color = s.icon_color | default: '#1f1f1f'
-%}
<style>
  .pfq-{{ sid }} { padding: {{ s.padding_top | default: 64 }}px 0 {{ s.padding_bottom | default: 64 }}px; color: {{ s.text_color | default: '#2b2b2b' }}; {% if s.background != blank and s.background != 'rgba(0,0,0,0)' %}background: {{ s.background }};{% endif %} }
  .pfq-{{ sid }} .pfq__inner { max-width: {{ s.max_width | default: 760 }}px; margin: 0 auto; padding: 0 24px; }
  .pfq-{{ sid }} .pfq__heading { margin: 0 0 10px; text-align: center; font-size: {{ s.heading_size | default: 32 }}px; color: {{ s.heading_color | default: '#1f1f1f' }}; }
  .pfq-{{ sid }} .pfq__intro { margin: 0 0 32px; text-align: center; font-size: 15px; opacity: .85; }
  .pfq-{{ sid }} .pfq__intro p { margin: 0; }
  .pfq-{{ sid }} details { border-bottom: 1px solid {{ s.divider_color | default: '#e6e1d8' }}; }
  .pfq-{{ sid }} details:first-of-type { border-top: 1px solid {{ s.divider_color | default: '#e6e1d8' }}; }
  .pfq-{{ sid }} summary { list-style: none; display: flex; align-items: center; gap: 14px; padding: 16px 4px; cursor: pointer; font-size: {{ s.question_size | default: 15 }}px; font-weight: 600; }
  .pfq-{{ sid }} summary::-webkit-details-marker { display: none; }
  .pfq-{{ sid }} .pfq__icon { flex: 0 0 auto; width: 22px; height: 22px; color: {{ icon_color }}; }
  .pfq-{{ sid }} .pfq__q { flex: 1 1 auto; }
  .pfq-{{ sid }} .pfq__chev { flex: 0 0 auto; width: 14px; height: 14px; transition: transform .2s; opacity: .7; }
  .pfq-{{ sid }} details[open] .pfq__chev { transform: rotate(180deg); }
  .pfq-{{ sid }} .pfq__a { padding: 0 4px 18px 40px; font-size: 14px; line-height: 1.6; }
  .pfq-{{ sid }} .pfq__a p { margin: 0 0 .6em; }
  @media (max-width: 749px) { .pfq-{{ sid }} .pfq__heading { font-size: {{ s.heading_size | default: 32 | times: 0.75 | round }}px; } .pfq-{{ sid }} .pfq__inner { padding: 0 20px; } }
  @media (prefers-reduced-motion: reduce) { .pfq-{{ sid }} .pfq__chev { transition: none; } }
</style>
<div class="pfq pfq-{{ sid }}">
  <div class="pfq__inner">
    {%- if s.heading != blank -%}<h2 class="pfq__heading">{{ s.heading | escape }}</h2>{%- endif -%}
    {%- if s.intro != blank -%}<div class="pfq__intro">{{ s.intro }}</div>{%- endif -%}
    {%- for block in section.blocks -%}
      <details {{ block.shopify_attributes }}{% if forloop.first and s.first_open %} open{% endif %}>
        <summary>
          <svg class="pfq__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            {%- case block.settings.icon -%}
              {%- when 'frame' -%}<rect x="4" y="3" width="16" height="18" rx="1"/><rect x="7.5" y="6.5" width="9" height="11"/>
              {%- when 'paper' -%}<path d="M6 3h9l4 4v14H6z"/><path d="M15 3v4h4"/><path d="M9 12h7M9 16h5"/>
              {%- when 'truck' -%}<path d="M3 6h11v10H3z"/><path d="M14 9h4l3 3v4h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/>
              {%- when 'return' -%}<path d="M9 7H5V3"/><path d="M5.5 7A8 8 0 1 1 4 12"/>
              {%- when 'size' -%}<path d="M3 17L17 3l4 4L7 21z"/><path d="M7 13l2 2M10 10l2 2M13 7l2 2"/>
              {%- when 'gift' -%}<rect x="3" y="9" width="18" height="12"/><path d="M3 13h18M12 9v12"/><path d="M12 9c-2-4-6-4-6-1.5S10 9 12 9zM12 9c2-4 6-4 6-1.5S14 9 12 9z"/>
              {%- else -%}<circle cx="12" cy="12" r="9"/><path d="M9.5 9.5a2.5 2.5 0 1 1 3.5 2.3c-.6.3-1 .9-1 1.6v.6"/><circle cx="12" cy="17" r=".6" fill="currentColor"/>
            {%- endcase -%}
          </svg>
          <span class="pfq__q">{{ block.settings.question | escape }}</span>
          <svg class="pfq__chev" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false"><path d="M3 5l4 4 4-4"/></svg>
        </summary>
        <div class="pfq__a">{{ block.settings.answer }}</div>
      </details>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Questions with icons",
  "tag": "section",
  "class": "posters-faq-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Questions"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Text under the heading"
    },
    {
      "type": "checkbox",
      "id": "first_open",
      "label": "First question open",
      "default": false
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 18,
      "max": 56,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "question_size",
      "label": "Question size",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Width",
      "min": 480,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 760
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#1f1f1f"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#2b2b2b"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icons",
      "default": "#1f1f1f"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Lines",
      "default": "#e6e1d8"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Space above",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Space below",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "question",
          "options": [
            { "value": "question", "label": "Question mark" },
            { "value": "frame", "label": "Frame" },
            { "value": "paper", "label": "Paper" },
            { "value": "truck", "label": "Delivery" },
            { "value": "return", "label": "Return" },
            { "value": "size", "label": "Ruler" },
            { "value": "gift", "label": "Gift" }
          ]
        },
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What sizes do the prints come in?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>List your sizes and say which frames they fit.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Questions with icons",
      "category": "Poster shop",
      "blocks": [
        { "type": "question", "settings": { "icon": "size" } },
        { "type": "question", "settings": { "icon": "paper", "question": "What paper do you print on?", "answer": "<p>Name the paper, its weight and finish.</p>" } },
        { "type": "question", "settings": { "icon": "truck", "question": "How are prints sent?", "answer": "<p>Say how prints are packed and how long they take.</p>" } }
      ]
    }
  ]
}
{% endschema %}
