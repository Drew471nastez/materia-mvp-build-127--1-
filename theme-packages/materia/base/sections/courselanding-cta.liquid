{%- comment -%}
  Course landing: the last call. Optionally a refund promise first (a round
  seal with the number of days, a heading and a line), then a dark rounded
  panel with a small mark, a heading with one word in the accent colour, a
  line, the button straight to checkout and a note, over a soft light from
  the bottom edge.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign sid = section.id
  assign p = s.product
  assign buy = s.button_link | default: '/collections/all'
  if s.to_checkout and p != blank and p.title != blank
    assign v = p.selected_or_first_available_variant
    if v.id != blank
      assign buy = '/cart/' | append: v.id | append: ':1'
    endif
  endif
-%}
<style>
  #shopify-section-{{ sid }} .clc {
    --cl-accent: {{ s.accent | default: '#2f5bea' }};
    background: {{ s.background | default: '#f6f6f4' }};
    padding: {{ s.padding_top_mobile | default: 32 }}px 0 {{ s.padding_bottom_mobile | default: 48 }}px;
  }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .clc { padding: {{ s.padding_top | default: 48 }}px 0 {{ s.padding_bottom | default: 88 }}px; } }
  #shopify-section-{{ sid }} .clc__in { max-width: 1164px; margin: 0 auto; padding: 0 12px; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .clc__in { padding: 0 32px; } }
  #shopify-section-{{ sid }} .clc__promise { display: grid; grid-template-columns: 76px minmax(0, 1fr); gap: 18px; align-items: center; max-width: 720px; margin: 0 auto 40px; padding: 0 8px; }
  @media (min-width: 750px) { #shopify-section-{{ sid }} .clc__promise { grid-template-columns: 104px minmax(0, 1fr); gap: 28px; margin-bottom: 64px; } }
  #shopify-section-{{ sid }} .clc__seal { position: relative; display: grid; place-items: center; width: 76px; height: 76px; border-radius: 50%; border: 2px solid var(--cl-accent); color: var(--cl-accent); text-align: center; line-height: 1; }
  @media (min-width: 750px) { #shopify-section-{{ sid }} .clc__seal { width: 104px; height: 104px; } }
  #shopify-section-{{ sid }} .clc__seal::before { content: ""; position: absolute; inset: 5px; border-radius: 50%; border: 1px dashed color-mix(in srgb, var(--cl-accent) 55%, transparent); }
  #shopify-section-{{ sid }} .clc__days { display: block; font-family: var(--heading-font, inherit); font-size: 26px; font-weight: 700; letter-spacing: -.03em; }
  @media (min-width: 750px) { #shopify-section-{{ sid }} .clc__days { font-size: 34px; } }
  #shopify-section-{{ sid }} .clc__unit { display: block; margin-top: 3px; font-size: 10px; letter-spacing: .14em; text-transform: uppercase; font-weight: 600; }
  #shopify-section-{{ sid }} .clc__ptitle { margin: 0 0 6px; color: {{ s.promise_heading_color | default: '#141416' }}; font-family: var(--heading-font, inherit); font-size: 20px; font-weight: 600; letter-spacing: -.02em; }
  @media (min-width: 750px) { #shopify-section-{{ sid }} .clc__ptitle { font-size: 24px; } }
  #shopify-section-{{ sid }} .clc__ptext { margin: 0; color: #5a5a62; font-size: 15px; line-height: 1.6; }
  #shopify-section-{{ sid }} .clc__panel { position: relative; overflow: hidden; padding: 52px 22px 48px; border-radius: 24px; background: {{ s.panel_color | default: '#151517' }}; color: {{ s.text_color | default: '#b4b4bb' }}; text-align: center; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .clc__panel { padding: 80px 48px 76px; border-radius: 28px; } }
  #shopify-section-{{ sid }} .clc__panel::after { content: ""; position: absolute; left: 50%; bottom: -55%; width: 90%; height: 90%; transform: translateX(-50%); border-radius: 50%; background: radial-gradient(closest-side, color-mix(in srgb, var(--cl-accent) 42%, transparent), transparent); pointer-events: none; }
  #shopify-section-{{ sid }} .clc__mark { position: relative; z-index: 1; width: 26px; height: 26px; margin: 0 auto 16px; color: var(--cl-accent); }
  #shopify-section-{{ sid }} .clc__title { position: relative; z-index: 1; margin: 0 auto 14px; max-width: 18em; color: {{ s.heading_color | default: '#ffffff' }}; font-family: var(--heading-font, inherit); font-weight: 600; font-size: 30px; line-height: 1.12; letter-spacing: -.03em; text-wrap: balance; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .clc__title { font-size: 44px; } }
  #shopify-section-{{ sid }} .clc__title span { color: color-mix(in srgb, var(--cl-accent) 70%, #ffffff); }
  #shopify-section-{{ sid }} .clc__text { position: relative; z-index: 1; max-width: 36em; margin: 0 auto; font-size: 16px; line-height: 1.6; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .clc__text { font-size: 17px; } }
  #shopify-section-{{ sid }} .clc__text p { margin: 0; }
  #shopify-section-{{ sid }} .clc__cta { position: relative; z-index: 1; margin-top: 28px; }
  #shopify-section-{{ sid }} .cl-btn { display: inline-flex; align-items: center; justify-content: center; gap: 12px; min-height: 60px; padding: 0 34px; border-radius: 14px; background: var(--cl-accent); color: #fff; font-size: 18px; font-weight: 600; text-decoration: none; box-shadow: 0 1px 0 rgba(255,255,255,.25) inset, 0 14px 34px -12px color-mix(in srgb, var(--cl-accent) 70%, transparent); transition: transform .25s ease; }
  #shopify-section-{{ sid }} .cl-btn:hover { transform: translateY(-2px); }
  #shopify-section-{{ sid }} .cl-btn svg { width: 18px; height: 18px; }
  @media (max-width: 749px) { #shopify-section-{{ sid }} .cl-btn { width: 100%; } }
  #shopify-section-{{ sid }} .clc__note { position: relative; z-index: 1; margin: 14px 0 0; font-size: 14px; }
  #shopify-section-{{ sid }} [data-clr].clr-wait { opacity: 0; transform: translate3d(0, 24px, 0); }
  #shopify-section-{{ sid }} [data-clr].clr-in { opacity: 1; transform: none; transition: opacity .85s cubic-bezier(.2,.65,.25,1) var(--d, 0ms), transform .85s cubic-bezier(.2,.65,.25,1) var(--d, 0ms); }
  @media (prefers-reduced-motion: reduce) { #shopify-section-{{ sid }} .cl-btn { transition: none; } }
</style>
<section class="clc">
  <div class="clc__in">
    {%- if s.promise_title != blank -%}
      <div class="clc__promise" data-clr>
        <div class="clc__seal" aria-hidden="true"><span><span class="clc__days">{{ s.promise_days | escape }}</span><span class="clc__unit">{{ s.promise_unit | escape }}</span></span></div>
        <div><h2 class="clc__ptitle">{{ s.promise_title | escape }}</h2>{%- if s.promise_text != blank -%}<p class="clc__ptext">{{ s.promise_text | escape }}</p>{%- endif -%}</div>
      </div>
    {%- endif -%}
    <div class="clc__panel" data-clr>
      <svg class="clc__mark" viewBox="0 0 26 26" fill="currentColor" aria-hidden="true" focusable="false"><path d="M11 3c.8 4.6 2.4 6.2 7 7-4.6.8-6.2 2.4-7 7-.8-4.6-2.4-6.2-7-7 4.6-.8 6.2-2.4 7-7z"/><path d="M20 15c.4 2.3 1.2 3.1 3.5 3.5-2.3.4-3.1 1.2-3.5 3.5-.4-2.3-1.2-3.1-3.5-3.5 2.3-.4 3.1-1.2 3.5-3.5z"/></svg>
      <h2 class="clc__title">{{ s.heading | escape }}{% if s.heading_accent != blank %} <span>{{ s.heading_accent | escape }}</span>{% endif %}{% if s.heading_after != blank %} {{ s.heading_after | escape }}{% endif %}</h2>
      {%- if s.text != blank -%}<div class="clc__text">{{ s.text }}</div>{%- endif -%}
      {%- if s.button_label != blank -%}
        <div class="clc__cta"><a class="cl-btn" href="{{ buy }}">{{ s.button_label | escape }}<svg viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3.5 9h11M10 4.5L14.5 9 10 13.5"/></svg></a></div>
      {%- endif -%}
      {%- if s.note != blank -%}<p class="clc__note">{{ s.note | escape }}</p>{%- endif -%}
    </div>
  </div>
</section>
{%- unless request.design_mode -%}
<script>(function(){var r=document.getElementById('shopify-section-{{ sid }}');if(!r||!('IntersectionObserver' in window)||matchMedia('(prefers-reduced-motion: reduce)').matches)return;var h=innerHeight,io=new IntersectionObserver(function(es){es.forEach(function(e){if(!e.isIntersecting)return;var t=e.target;io.unobserve(t);requestAnimationFrame(function(){t.classList.add('clr-in')})})},{rootMargin:'0px 0px -6% 0px'});r.querySelectorAll('[data-clr]').forEach(function(el){if(el.getBoundingClientRect().top<h*.92)return;el.classList.add('clr-wait');io.observe(el)})})();</script>
{%- endunless -%}

{% schema %}
{
  "name": "Promise and last call",
  "tag": "section",
  "class": "courselanding-cta-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "header", "content": "Refund promise" },
    { "type": "text", "id": "promise_days", "label": "Number in the seal", "default": "30" },
    { "type": "text", "id": "promise_unit", "label": "Word under it", "default": "days" },
    { "type": "text", "id": "promise_title", "label": "Heading", "default": "Try it for 30 days", "info": "Leave empty to hide the promise." },
    { "type": "text", "id": "promise_text", "label": "Text", "default": "Say how someone gets their money back if the course is not for them." },
    { "type": "header", "content": "Panel" },
    { "type": "text", "id": "heading", "label": "Heading start", "default": "Your first lesson is" },
    { "type": "text", "id": "heading_accent", "label": "Words in the accent colour", "default": "one click" },
    { "type": "text", "id": "heading_after", "label": "Heading end", "default": "away" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Say what someone gets and what it costs, in one line.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Join the course" },
    { "type": "product", "id": "product", "label": "Course", "info": "The button goes straight to checkout with this product. Your first product when none is picked." },
    { "type": "checkbox", "id": "to_checkout", "label": "Button goes straight to checkout", "default": true },
    { "type": "url", "id": "button_link", "label": "Link when there is no product" },
    { "type": "text", "id": "note", "label": "Line under the button", "default": "One payment. Yours to keep." },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "background", "label": "Background", "default": "#f6f6f4" },
    { "type": "color", "id": "panel_color", "label": "Panel", "default": "#151517" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#2f5bea" },
    { "type": "color", "id": "promise_heading_color", "label": "Promise heading", "default": "#141416" },
    { "type": "color", "id": "heading_color", "label": "Panel heading", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Panel text", "default": "#b4b4bb" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Space above on desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Space below on desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 88 },
    { "type": "range", "id": "padding_top_mobile", "label": "Space above on phones", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Space below on phones", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "presets": [ { "name": "Promise and last call", "category": "Course landing" } ]
}
{% endschema %}
