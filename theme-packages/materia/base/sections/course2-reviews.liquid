{%- comment -%}
  Online course: what students say. A label, a heading and a paragraph;
  then a picture beside one large quote on a soft panel, and a row of
  smaller quote cards with stars, an initial in a circle, a name and a
  line about them. A small "sample" mark can sit on every quote so a new
  store never shows invented reviews as real ones; the creator turns it off
  once the quotes are their students' own.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign sid = section.id
-%}
<style>
  #shopify-section-{{ sid }} .c2r {
    --c2-accent: {{ s.accent | default: '#12704f' }};
    --c2-ink: {{ s.heading_color | default: '#15171a' }};
    --c2-text: {{ s.text_color | default: '#3f444c' }};
    --c2-line: {{ s.line_color | default: '#e3e5e8' }};
    --c2-panel: {{ s.panel_color | default: '#f1f7f4' }};
    background: {{ s.background | default: '#ffffff' }};
    color: var(--c2-text);
    padding: {{ s.padding_top_mobile | default: 48 }}px 0 {{ s.padding_bottom_mobile | default: 48 }}px;
    scroll-margin-top: 80px;
  }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .c2r { padding: {{ s.padding_top | default: 96 }}px 0 {{ s.padding_bottom | default: 96 }}px; } }
  #shopify-section-{{ sid }} .c2r__in { max-width: 1200px; margin: 0 auto; padding: 0 20px; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .c2r__in { padding: 0 40px; } }
  #shopify-section-{{ sid }} .c2-tag { display: inline-block; margin: 0 0 22px; padding: 8px 12px; border: 1px solid #d9dce1; border-radius: 6px; font-size: 13px; line-height: 1; letter-spacing: .05em; text-transform: uppercase; color: var(--c2-ink); }
  #shopify-section-{{ sid }} .c2r__title { margin: 0 0 18px; color: var(--c2-ink); font-family: var(--heading-font, inherit); font-weight: 700; font-size: 34px; line-height: 1.06; letter-spacing: -.035em; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .c2r__title { font-size: {{ s.heading_size | default: 48 }}px; } }
  #shopify-section-{{ sid }} .c2r__title em { font-style: normal; color: var(--c2-accent); }
  #shopify-section-{{ sid }} .c2r__text { max-width: 36em; font-size: 17px; line-height: 1.6; }
  #shopify-section-{{ sid }} .c2r__text p { margin: 0; }
  #shopify-section-{{ sid }} .c2r__top { margin-top: 40px; display: grid; gap: 16px; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .c2r__top { margin-top: 52px; grid-template-columns: minmax(0, 1fr) minmax(0, 2.05fr); gap: 24px; } }
  #shopify-section-{{ sid }} .c2r__media { margin: 0; border-radius: 18px; overflow: hidden; background: #e9e6e1; aspect-ratio: 6 / 5; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .c2r__media { aspect-ratio: auto; min-height: 320px; } }
  #shopify-section-{{ sid }} .c2r__media img { display: block; width: 100%; height: 100%; object-fit: cover; margin: 0; }
  #shopify-section-{{ sid }} .c2r__big { position: relative; display: flex; flex-direction: column; justify-content: space-between; gap: 28px; padding: 28px 24px; border-radius: 18px; background: linear-gradient(120deg, color-mix(in srgb, var(--c2-panel) 60%, #ffffff), var(--c2-panel)); }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .c2r__big { padding: 40px 44px; } }
  #shopify-section-{{ sid }} .c2r__bigq { margin: 0; color: var(--c2-ink); font-family: var(--heading-font, inherit); font-weight: 700; font-size: 23px; line-height: 1.22; letter-spacing: -.03em; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .c2r__bigq { font-size: 32px; } }
  #shopify-section-{{ sid }} .c2r__stars { display: flex; gap: 4px; color: var(--c2-accent); margin-bottom: 18px; }
  #shopify-section-{{ sid }} .c2r__stars svg { width: 17px; height: 17px; }
  #shopify-section-{{ sid }} .c2r__who { display: flex; align-items: center; gap: 12px; }
  #shopify-section-{{ sid }} .c2r__ini { flex: none; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 10px; background: color-mix(in srgb, var(--c2-accent) 14%, #ffffff); color: var(--c2-accent); font-weight: 700; font-size: 17px; }
  #shopify-section-{{ sid }} .c2r__name { display: block; color: var(--c2-ink); font-size: 16px; font-weight: 600; }
  #shopify-section-{{ sid }} .c2r__role { display: block; font-size: 14px; color: #6b7079; }
  #shopify-section-{{ sid }} .c2r__sample { position: absolute; top: 16px; right: 16px; padding: 4px 8px; border-radius: 5px; border: 1px dashed color-mix(in srgb, var(--c2-ink) 30%, transparent); font-size: 11px; letter-spacing: .06em; text-transform: uppercase; color: #5b616b; background: rgba(255,255,255,.7); }
  #shopify-section-{{ sid }} .c2r__grid { margin: 16px 0 0; padding: 0; list-style: none; display: grid; gap: 16px; }
  @media (min-width: 750px) { #shopify-section-{{ sid }} .c2r__grid { grid-template-columns: repeat({{ section.blocks.size | at_least: 1 | at_most: 3 }}, minmax(0, 1fr)); } }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .c2r__grid { margin-top: 24px; gap: 24px; } }
  #shopify-section-{{ sid }} .c2r__card { position: relative; display: flex; flex-direction: column; justify-content: space-between; gap: 26px; padding: 28px 24px 26px; border: 1px solid var(--c2-line); border-radius: 18px; background: #fff; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .c2r__card { padding: 32px 32px 30px; } }
  #shopify-section-{{ sid }} .c2r__q { margin: 0; font-size: 17px; line-height: 1.55; color: var(--c2-ink); }
  #shopify-section-{{ sid }} [data-c2r].c2r-wait { opacity: 0; transform: translate3d(0, 22px, 0); }
  #shopify-section-{{ sid }} [data-c2r].c2r-in { opacity: 1; transform: none; transition: opacity .8s cubic-bezier(.2,.65,.25,1) var(--d, 0ms), transform .8s cubic-bezier(.2,.65,.25,1) var(--d, 0ms); }
</style>
{%- capture stars -%}<div class="c2r__stars" role="img" aria-label="5 stars">{%- for i in (1..5) -%}<svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false"><path d="M10 1.8l2.5 5.2 5.7.8-4.1 4 1 5.6L10 14.8 4.9 17.4l1-5.6-4.1-4 5.7-.8z"/></svg>{%- endfor -%}</div>{%- endcapture -%}
<section class="c2r"{% if s.anchor != blank %} id="{{ s.anchor | handleize }}"{% endif %}>
  <div class="c2r__in">
    {%- if s.tag != blank -%}<p class="c2-tag" data-c2r>{{ s.tag | escape }}</p>{%- endif -%}
    <h2 class="c2r__title" data-c2r style="--d: 60ms">{{ s.heading | escape }}{% if s.heading_accent != blank %} <em>{{ s.heading_accent | escape }}</em>{% endif %}</h2>
    {%- if s.text != blank -%}<div class="c2r__text" data-c2r style="--d: 120ms">{{ s.text }}</div>{%- endif -%}
    {%- if s.quote != blank -%}
      <div class="c2r__top">
        <figure class="c2r__media" data-c2r>
          {%- if s.image != blank -%}<img src="{{ s.image | image_url: width: 900 }}" srcset="{{ s.image | image_url: width: 600 }} 600w, {{ s.image | image_url: width: 900 }} 900w" sizes="(min-width: 990px) 370px, 92vw" width="{{ s.image.width | default: 900 }}" height="{{ s.image.height | default: 760 }}" alt="{{ s.image_alt | default: s.image.alt | escape }}" loading="lazy" decoding="async">{%- endif -%}
        </figure>
        <figure class="c2r__big" data-c2r style="--d: 100ms">
          {%- if s.sample_label != blank -%}<span class="c2r__sample">{{ s.sample_label | escape }}</span>{%- endif -%}
          <div>{{ stars }}<blockquote class="c2r__bigq">{{ s.quote | escape }}</blockquote></div>
          <figcaption class="c2r__who"><span><span class="c2r__name">{{ s.name | escape }}</span><span class="c2r__role">{{ s.role | escape }}</span></span></figcaption>
        </figure>
      </div>
    {%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <ul class="c2r__grid" role="list">
        {%- for block in section.blocks limit: 3 -%}
          {%- assign b = block.settings -%}
          <li class="c2r__card" data-c2r style="--d: {{ forloop.index0 | times: 90 }}ms" {{ block.shopify_attributes }}>
            {%- if s.sample_label != blank -%}<span class="c2r__sample">{{ s.sample_label | escape }}</span>{%- endif -%}
            <div>{{ stars }}<blockquote class="c2r__q">{{ b.quote | escape }}</blockquote></div>
            <div class="c2r__who"><span class="c2r__ini" aria-hidden="true">{{ b.name | slice: 0 | upcase }}</span><span><span class="c2r__name">{{ b.name | escape }}</span><span class="c2r__role">{{ b.role | escape }}</span></span></div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>
{%- unless request.design_mode -%}
<script>(function(){var r=document.getElementById('shopify-section-{{ sid }}');if(!r||!('IntersectionObserver' in window)||matchMedia('(prefers-reduced-motion: reduce)').matches)return;var h=innerHeight,io=new IntersectionObserver(function(es){es.forEach(function(e){if(!e.isIntersecting)return;var t=e.target;io.unobserve(t);requestAnimationFrame(function(){t.classList.add('c2r-in')})})},{rootMargin:'0px 0px -6% 0px'});r.querySelectorAll('[data-c2r]').forEach(function(el){if(el.getBoundingClientRect().top<h*.92)return;el.classList.add('c2r-wait');io.observe(el)})})();</script>
{%- endunless -%}

{% schema %}
{
  "name": "Student quotes",
  "tag": "section",
  "class": "course2-reviews-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "tag", "label": "Label above", "default": "Students" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What students" },
    { "type": "text", "id": "heading_accent", "label": "Heading words in the accent colour", "default": "say" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "sample_label", "label": "Mark on every quote", "default": "Sample", "info": "Keep it until the quotes are real ones from your students, then clear it." },
    { "type": "text", "id": "anchor", "label": "Address on the page", "info": "A word a menu link can jump to, as /#word." },
    { "type": "header", "content": "Large quote" },
    { "type": "image_picker", "id": "image", "label": "Picture beside it" },
    { "type": "text", "id": "image_alt", "label": "Picture description" },
    { "type": "textarea", "id": "quote", "label": "Quote", "default": "Write the quote that says most about what changed for a student." },
    { "type": "text", "id": "name", "label": "Name", "default": "Student name" },
    { "type": "text", "id": "role", "label": "About them", "default": "What they do" },
    { "type": "range", "id": "heading_size", "label": "Heading size on desktop", "min": 28, "max": 72, "step": 2, "unit": "px", "default": 48 },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "panel_color", "label": "Large quote panel", "default": "#f1f7f4" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#12704f" },
    { "type": "color", "id": "heading_color", "label": "Headings", "default": "#15171a" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#3f444c" },
    { "type": "color", "id": "line_color", "label": "Card outline", "default": "#e3e5e8" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Space above on desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Space below on desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_top_mobile", "label": "Space above on phones", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Space below on phones", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Quote",
      "limit": 3,
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "Write what a student said, in their words." },
        { "type": "text", "id": "name", "label": "Name", "default": "Student name" },
        { "type": "text", "id": "role", "label": "About them", "default": "What they do" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Student quotes",
      "category": "Online course",
      "blocks": [ { "type": "quote" }, { "type": "quote" }, { "type": "quote" } ]
    }
  ]
}
{% endschema %}
