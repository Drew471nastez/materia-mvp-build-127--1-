{%- comment -%}
  Author: everything else the author makes, on a dark band above the
  footer. A short heading, then a row of square pictures, each with a name
  and a small line under it, every one a link. Four across on a computer,
  two on a phone. The picture lifts a little on hover.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign color_scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
-%}
<style>
  #shopify-section-{{ sid }} .abs { background: {{ st.background | default: '#111318' }}; color: {{ st.text_color | default: '#a7acb8' }}; padding: {{ st.padding_top_mobile | default: 56 }}px 20px {{ st.padding_bottom_mobile | default: 48 }}px; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .abs { padding: {{ st.padding_top | default: 88 }}px 40px {{ st.padding_bottom | default: 72 }}px; } }
  #shopify-section-{{ sid }} .abs__inner { max-width: 1040px; margin: 0 auto; }
  #shopify-section-{{ sid }} .abs__heading { margin: 0 0 32px; text-align: center; color: {{ st.heading_color | default: '#ffffff' }}; font-family: var(--heading-font, inherit); font-weight: var(--heading-weight, 400); font-size: {{ st.heading_size_mobile | default: 28 }}px; line-height: 1.1; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .abs__heading { margin-bottom: 44px; font-size: {{ st.heading_size | default: 36 }}px; } }
  #shopify-section-{{ sid }} .abs__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 16px; }
  @media (min-width: 750px) { #shopify-section-{{ sid }} .abs__grid { grid-template-columns: repeat({{ section.blocks.size | at_least: 1 | at_most: 4 }}, minmax(0, 1fr)); gap: 32px; } }
  #shopify-section-{{ sid }} .abs__link { display: block; color: inherit; text-decoration: none; text-align: center; }
  #shopify-section-{{ sid }} .abs__media { aspect-ratio: 1 / 1; overflow: hidden; border-radius: {{ st.radius | default: 6 }}px; background: #1d2027; transition: transform 0.3s ease; }
  #shopify-section-{{ sid }} .abs__media img { display: block; width: 100%; height: 100%; object-fit: cover; margin: 0; }
  #shopify-section-{{ sid }} .abs__link:hover .abs__media { transform: translateY(-4px); }
  #shopify-section-{{ sid }} .abs__name { margin: 14px 0 0; color: {{ st.heading_color | default: '#ffffff' }}; font-size: 15px; font-weight: 600; }
  #shopify-section-{{ sid }} .abs__line { margin: 3px 0 0; font-size: 13.5px; }
  @media (prefers-reduced-motion: reduce) { #shopify-section-{{ sid }} .abs__media { transition: none; } }
</style>
<div class="abs color-{{ color_scheme }}" data-section-id="{{ sid }}">
  <div class="abs__inner">
    {%- if st.heading != blank -%}<h2 class="abs__heading">{{ st.heading | escape }}</h2>{%- endif -%}
    <ul class="abs__grid" role="list">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>
          <a class="abs__link" href="{{ block.settings.link | default: '/collections/all' }}">
            <div class="abs__media">{%- if block.settings.image != blank -%}<img src="{{ block.settings.image | image_url: width: 600 }}" width="600" height="600" alt="" loading="lazy" decoding="async">{%- endif -%}</div>
            <p class="abs__name">{{ block.settings.title | escape }}</p>
            {%- if block.settings.line != blank -%}<p class="abs__line">{{ block.settings.line | escape }}</p>{%- endif -%}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>
{% schema %}
{
  "name": "Author shelf",
  "tag": "section",
  "class": "section sec__authorbook-shelf",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default-color-scheme" },
    { "type": "color", "id": "background", "label": "Background", "default": "#111318" },
    { "type": "color", "id": "heading_color", "label": "Heading and names", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Small lines", "default": "#a7acb8" },
    { "type": "range", "id": "radius", "label": "Picture corners", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 6 },
    { "type": "text", "id": "heading", "label": "Heading", "default": "More from me" },
    { "type": "range", "id": "heading_size", "label": "Heading size, desktop", "min": 24, "max": 60, "step": 2, "unit": "px", "default": 36 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size, phone", "min": 20, "max": 44, "step": 2, "unit": "px", "default": 28 },
    { "type": "range", "id": "padding_top", "label": "Space above, desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 88 },
    { "type": "range", "id": "padding_bottom", "label": "Space below, desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_top_mobile", "label": "Space above, phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Space below, phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    { "type": "item", "name": "Item", "settings": [
      { "type": "image_picker", "id": "image", "label": "Picture", "info": "Square." },
      { "type": "text", "id": "title", "label": "Name", "default": "Something I make" },
      { "type": "text", "id": "line", "label": "Line" },
      { "type": "url", "id": "link", "label": "Link" }
    ] }
  ],
  "max_blocks": 4,
  "presets": [ { "name": "Author shelf", "blocks": [ { "type": "item" }, { "type": "item" }, { "type": "item" }, { "type": "item" } ] } ]
}
{% endschema %}
