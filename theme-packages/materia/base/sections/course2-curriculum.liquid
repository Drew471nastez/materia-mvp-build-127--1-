{%- comment -%}
  Online course: the curriculum. A label, a heading and a paragraph that
  stay in place on the left while the modules scroll on the right. Each
  module is a row that opens (details and summary, animated by
  snippets/smooth-details) to show its lessons, one per line with a small
  play mark; the row shows its number, title and how long it is. The totals
  line under the intro is typed by the creator.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign sid = section.id
-%}
{%- render 'smooth-details' -%}
<style>
  #shopify-section-{{ sid }} .c2c {
    --c2-accent: {{ s.accent | default: '#12704f' }};
    --c2-ink: {% if s.use_color_scheme and s.heading_color == blank %}var(--color-heading){% else %}{{ s.heading_color | default: '#15171a' }}{% endif %};
    --c2-text: {% if s.use_color_scheme and s.text_color == blank %}var(--color-text){% else %}{{ s.text_color | default: '#4a4f57' }}{% endif %};
    --c2-line: {% if s.use_color_scheme and s.line_color == blank %}var(--color-border){% else %}{{ s.line_color | default: '#e3e5e8' }}{% endif %};
    background: {% if s.use_color_scheme and s.background == blank %}var(--color-background){% else %}{{ s.background | default: '#ffffff' }}{% endif %};
    color: var(--c2-text);
    padding: {{ s.padding_top_mobile | default: 48 }}px 0 {{ s.padding_bottom_mobile | default: 48 }}px;
    scroll-margin-top: 80px;
  }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .c2c { padding: {{ s.padding_top | default: 96 }}px 0 {{ s.padding_bottom | default: 96 }}px; } }
  #shopify-section-{{ sid }} .c2c__in { max-width: 1200px; margin: 0 auto; padding: 0 20px; display: grid; gap: 36px; align-items: start; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .c2c__in { padding: 0 40px; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: 80px; } #shopify-section-{{ sid }} .c2c__head { position: sticky; top: 104px; } }
  #shopify-section-{{ sid }} .c2-tag { margin: 0 0 16px; font-size: 13px; font-weight: 600; line-height: 1.2; letter-spacing: .08em; text-transform: uppercase; color: var(--c2-accent); }
  #shopify-section-{{ sid }} .c2c__title { margin: 0 0 18px; color: var(--c2-ink); font-family: var(--heading-font, inherit); font-weight: 700; font-size: 34px; line-height: 1.08; letter-spacing: -.03em; text-wrap: balance; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .c2c__title { font-size: {{ s.heading_size | default: 48 }}px; } }
  #shopify-section-{{ sid }} .c2c__title em { font-style: normal; color: var(--c2-accent); }
  #shopify-section-{{ sid }} .c2c__text { font-size: 17px; line-height: 1.6; max-width: 30em; }
  #shopify-section-{{ sid }} .c2c__text p { margin: 0 0 12px; }
  /* The totals: one plain line of facts, not badges. */
  #shopify-section-{{ sid }} .c2c__total { display: flex; flex-wrap: wrap; gap: 4px 0; margin: 20px 0 0; padding: 0; list-style: none; color: var(--c2-ink); font-size: 15px; font-weight: 600; font-variant-numeric: tabular-nums; }
  #shopify-section-{{ sid }} .c2c__total li + li::before { content: ""; display: inline-block; width: 4px; height: 4px; margin: 0 12px; border-radius: 50%; background: currentColor; opacity: .35; vertical-align: middle; }
  /* The modules: a plain numbered list between two lines. Each row is its number, its title and how long it is; the chevron turns as it opens. */
  #shopify-section-{{ sid }} .c2c__list { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--c2-ink); }
  #shopify-section-{{ sid }} .c2c__mod { border-bottom: 1px solid var(--c2-line); --sd-time: .44s; }
  #shopify-section-{{ sid }} .c2c__mod summary { list-style: none; display: grid; grid-template-columns: 34px minmax(0, 1fr) 20px; gap: 12px; align-items: baseline; padding: 22px 0; cursor: pointer; -webkit-tap-highlight-color: transparent; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .c2c__mod summary { grid-template-columns: 44px minmax(0, 1fr) auto 20px; gap: 20px; padding: 26px 0; } }
  #shopify-section-{{ sid }} .c2c__mod summary::-webkit-details-marker { display: none; }
  #shopify-section-{{ sid }} .c2c__mod summary:focus-visible { outline: 2px solid var(--c2-accent); outline-offset: 4px; }
  #shopify-section-{{ sid }} .c2c__n { color: var(--c2-text); opacity: .7; font-size: 15px; font-weight: 500; font-variant-numeric: tabular-nums; }
  #shopify-section-{{ sid }} .c2c__name { color: var(--c2-ink); font-family: var(--heading-font, inherit); font-weight: 600; font-size: 18px; line-height: 1.3; letter-spacing: -.015em; transition: color .25s ease; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .c2c__name { font-size: 21px; } }
  @media (hover: hover) { #shopify-section-{{ sid }} .c2c__mod summary:hover .c2c__name { color: var(--c2-accent); } }
  #shopify-section-{{ sid }} .c2c__meta { font-size: 14px; color: var(--c2-text); white-space: nowrap; font-variant-numeric: tabular-nums; }
  @media (max-width: 989px) { #shopify-section-{{ sid }} .c2c__meta { display: block; margin-top: 4px; font-family: var(--body-font, inherit); font-weight: 400; font-size: 13.5px; letter-spacing: 0; } #shopify-section-{{ sid }} .c2c__meta--wide { display: none; } }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .c2c__meta--small { display: none; } }
  #shopify-section-{{ sid }} .c2c__chev { align-self: center; width: 20px; height: 20px; color: var(--c2-ink); transition: transform .44s cubic-bezier(.2, .7, .2, 1); }
  #shopify-section-{{ sid }} details[open]:not([data-sd-closing]) .c2c__chev { transform: rotate(180deg); }
  #shopify-section-{{ sid }} .c2c__lessons { margin: 0; padding: 0 0 26px 46px; list-style: none; display: grid; gap: 12px; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .c2c__lessons { padding-left: 64px; padding-right: 40px; } }
  #shopify-section-{{ sid }} .c2c__lessons li { display: grid; grid-template-columns: 10px 1fr; gap: 14px; align-items: baseline; font-size: 15.5px; line-height: 1.5; }
  #shopify-section-{{ sid }} .c2c__lessons svg { width: 9px; height: 10px; color: var(--c2-accent); transform: translateY(1px); }
  #shopify-section-{{ sid }} [data-c2r].c2r-wait { opacity: 0; transform: translate3d(0, 22px, 0); }
  #shopify-section-{{ sid }} [data-c2r].c2r-in { opacity: 1; transform: none; transition: opacity .8s cubic-bezier(.2,.65,.25,1) var(--d, 0ms), transform .8s cubic-bezier(.2,.65,.25,1) var(--d, 0ms); }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .c2c__chev, #shopify-section-{{ sid }} .c2c__name { transition: none; }
  }
</style>
<section class="c2c{% if s.use_color_scheme %} color-{{ s.color_scheme.id | default: s.color_scheme | default: 'default' }}{% endif %}"{% if s.anchor != blank %} id="{{ s.anchor | handleize }}"{% endif %}>{% render 'bg-picture', image: s.background_image, overlay: s.overlay_color, opacity: s.overlay_opacity %}
  <div class="c2c__in">
    <div class="c2c__head">
      {%- if s.tag != blank -%}<p class="c2-tag" data-c2r>{{ s.tag | escape }}</p>{%- endif -%}
      <h2 class="c2c__title" data-c2r style="--d: 60ms">{{ s.heading | escape }}{% if s.heading_accent != blank %} <em>{{ s.heading_accent | escape }}</em>{% endif %}</h2>
      {%- if s.text != blank -%}<div class="c2c__text" data-c2r style="--d: 120ms">{{ s.text }}</div>{%- endif -%}
      {%- if s.totals != blank -%}
        {%- assign totals = s.totals | split: ',' -%}
        <ul class="c2c__total" role="list" data-c2r style="--d: 180ms">{%- for t in totals -%}{%- assign tt = t | strip -%}{%- if tt != blank -%}<li>{{ tt | escape }}</li>{%- endif -%}{%- endfor -%}</ul>
      {%- endif -%}
    </div>
    <ol class="c2c__list" role="list" data-c2r style="--d: 120ms">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        {%- assign lessons = b.lessons | newline_to_br | split: '<br />' -%}
        {%- assign is_open = false -%}
        {%- if forloop.first and s.first_open -%}{%- assign is_open = true -%}{%- endif -%}
        <li {{ block.shopify_attributes }}>
          <details class="c2c__mod" data-smooth{% if is_open %} open{% endif %}>
            <summary aria-expanded="{{ is_open }}">
              <span class="c2c__n" aria-hidden="true">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
              <span class="c2c__name">{{ b.title | escape }}{% if b.meta != blank %}<span class="c2c__meta c2c__meta--small">{{ b.meta | escape }}</span>{% endif %}</span>
              {%- if b.meta != blank -%}<span class="c2c__meta c2c__meta--wide">{{ b.meta | escape }}</span>{%- endif -%}
              <svg class="c2c__chev" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 7.5l5 5 5-5"/></svg>
            </summary>
            <div class="sd-body">
              <div>
                <ul class="c2c__lessons" role="list">
                  {%- for line in lessons -%}
                    {%- assign t = line | strip -%}
                    {%- if t != blank -%}<li><svg viewBox="0 0 9 10" aria-hidden="true" focusable="false"><path d="M0 0l9 5-9 5z" fill="currentColor"/></svg><span>{{ t | escape }}</span></li>{%- endif -%}
                  {%- endfor -%}
                </ul>
              </div>
            </div>
          </details>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>
{%- unless request.design_mode -%}
<script>(function(){var r=document.getElementById('shopify-section-{{ sid }}');if(!r||!('IntersectionObserver' in window)||matchMedia('(prefers-reduced-motion: reduce)').matches)return;var h=innerHeight,io=new IntersectionObserver(function(es){es.forEach(function(e){if(!e.isIntersecting)return;var t=e.target;io.unobserve(t);requestAnimationFrame(function(){t.classList.add('c2r-in')})})},{rootMargin:'0px 0px -6% 0px'});r.querySelectorAll('[data-c2r]').forEach(function(el){if(el.getBoundingClientRect().top<h*.92)return;el.classList.add('c2r-wait');io.observe(el)})})();</script>
{%- endunless -%}

{% schema %}
{
  "name": "Curriculum",
  "tag": "section",
  "class": "course2-curriculum-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "checkbox", "id": "use_color_scheme", "label": "Use a colour scheme", "default": false, "info": "Background, heading, text and line colours left empty below follow the scheme." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default", "visible_if": "{{ section.settings.use_color_scheme }}" },
    { "type": "header", "content": "Background picture" },
    { "type": "image_picker", "id": "background_image", "label": "Background picture" },
    { "type": "color", "id": "overlay_color", "label": "Overlay on the picture", "default": "#000000", "visible_if": "{{ section.settings.background_image != blank }}" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay strength", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 50, "visible_if": "{{ section.settings.background_image != blank }}" },
    { "type": "text", "id": "tag", "label": "Label above", "default": "Curriculum" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What you will learn," },
    { "type": "text", "id": "heading_accent", "label": "Heading words in the accent colour", "default": "in order" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Say how the course is put together and how long it takes.</p>" },
    { "type": "text", "id": "totals", "label": "Totals", "info": "Short facts separated by commas, such as 6 modules, 40 lessons.", "default": "6 modules, 40 lessons, 5 hours" },
    { "type": "checkbox", "id": "first_open", "label": "First module open", "default": true },
    { "type": "text", "id": "anchor", "label": "Address on the page", "default": "curriculum", "info": "A word a menu link can jump to, as /#word." },
    { "type": "range", "id": "heading_size", "label": "Heading size on desktop", "min": 28, "max": 72, "step": 2, "unit": "px", "default": 48 },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#12704f" },
    { "type": "color", "id": "heading_color", "label": "Headings", "default": "#15171a" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#4a4f57" },
    { "type": "color", "id": "line_color", "label": "Lines", "default": "#e3e5e8" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Space above on desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Space below on desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_top_mobile", "label": "Space above on phones", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Space below on phones", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "module",
      "name": "Module",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Getting started" },
        { "type": "text", "id": "meta", "label": "Length", "default": "5 lessons, 30 min" },
        { "type": "textarea", "id": "lessons", "label": "Lessons", "info": "One per line.", "default": "What you need\nYour first try\nWhat to look for" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Curriculum",
      "category": "Online course",
      "blocks": [
        { "type": "module" },
        { "type": "module", "settings": { "title": "The basics, properly" } },
        { "type": "module", "settings": { "title": "Putting it together" } }
      ]
    }
  ]
}
{% endschema %}
