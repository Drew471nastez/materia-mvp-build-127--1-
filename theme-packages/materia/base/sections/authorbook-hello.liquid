{%- comment -%}
  Author: "Hi, I'm ..." A portrait on one side (below the heading on a
  phone) and on the other a small label, the greeting, a few lines about
  the author, links to their social profiles, a button, and a short list of
  recent letters or articles, each a link with an arrow. Nothing moves.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign color_scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
  assign placeholder = 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 800 1000%22%3E%3Crect width=%22800%22 height=%221000%22 fill=%22%23e7e2d8%22/%3E%3Ccircle cx=%22400%22 cy=%22380%22 r=%2290%22 fill=%22%23d3ccbe%22/%3E%3Cpath d=%22M220 760c20-130 90-200 180-200s160 70 180 200z%22 fill=%22%23d3ccbe%22/%3E%3C/svg%3E'
  assign letters = section.blocks | where: 'type', 'letter'
-%}
<style>
  #shopify-section-{{ sid }} .abhi { background: {{ st.background | default: '#ffffff' }}; padding: {{ st.padding_top_mobile | default: 56 }}px 20px {{ st.padding_bottom_mobile | default: 56 }}px; scroll-margin-top: 80px; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .abhi { padding: {{ st.padding_top | default: 104 }}px 40px {{ st.padding_bottom | default: 104 }}px; } }
  #shopify-section-{{ sid }} .abhi__inner { max-width: 1140px; margin: 0 auto; display: grid; grid-template-columns: minmax(0, 1fr); gap: 32px; align-items: center; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .abhi__inner { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr); gap: 88px; } }
  #shopify-section-{{ sid }} .abhi--flip .abhi__media { order: 2; }
  #shopify-section-{{ sid }} .abhi__media { position: relative; margin: 0; }
  #shopify-section-{{ sid }} .abhi__media::before {
    content: ""; position: absolute; inset: 18px -18px -18px 18px; border-radius: {{ st.image_radius | default: 10 }}px;
    background: {{ st.frame_color | default: '#f0643a' }}; opacity: {{ st.frame_opacity | default: 100 | divided_by: 100.0 }};
  }
  #shopify-section-{{ sid }} .abhi__frame { position: relative; overflow: hidden; border-radius: {{ st.image_radius | default: 10 }}px; aspect-ratio: {{ st.image_ratio | default: '4 / 5' }}; background: #e7e2d8; }
  #shopify-section-{{ sid }} .abhi__frame img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: {{ st.image_focus | default: '50% 40%' }}; margin: 0; }
  @media (max-width: 989px) { #shopify-section-{{ sid }} .abhi__media { margin-right: 18px; } }
  #shopify-section-{{ sid }} .abhi__eyebrow { margin: 0 0 14px; font-size: 13px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: {{ st.accent_color | default: '#c4471f' }}; }
  #shopify-section-{{ sid }} .abhi__heading { margin: 0; color: var(--color-heading); font-family: var(--heading-font, inherit); font-weight: var(--heading-weight, 400); font-size: {{ st.heading_size_mobile | default: 40 }}px; line-height: 1.05; letter-spacing: -0.01em; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .abhi__heading { font-size: {{ st.heading_size | default: 56 }}px; } }
  #shopify-section-{{ sid }} .abhi__heading em { font-style: italic; color: {{ st.accent_color | default: '#c4471f' }}; }
  #shopify-section-{{ sid }} .abhi__text { margin-top: 20px; color: var(--color-text); font-size: 17px; line-height: 1.7; max-width: 50ch; }
  #shopify-section-{{ sid }} .abhi__text p { margin: 0 0 14px; }
  #shopify-section-{{ sid }} .abhi__text a { color: var(--color-heading); text-decoration: underline; text-decoration-color: {{ st.accent_color | default: '#c4471f' }}; text-decoration-thickness: 2px; text-underline-offset: 4px; }
  #shopify-section-{{ sid }} .abhi__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 18px 22px; margin-top: 24px; }
  #shopify-section-{{ sid }} .abhi__btn {
    display: inline-flex; align-items: center; justify-content: center; min-height: 50px; padding: 0 24px; border-radius: {{ st.button_radius | default: 6 }}px;
    background: {{ st.button_color | default: '#1d2b4f' }}; color: {{ st.button_text_color | default: '#ffffff' }}; font-size: 15px; font-weight: 700; text-decoration: none;
    transition: filter 0.2s ease;
  }
  #shopify-section-{{ sid }} .abhi__btn:hover { filter: brightness(1.15); }
  #shopify-section-{{ sid }} .abhi__social { display: flex; gap: 8px; margin: 0; padding: 0; list-style: none; }
  #shopify-section-{{ sid }} .abhi__social a {
    display: grid; place-items: center; width: 42px; height: 42px; border-radius: 50%; color: var(--color-heading);
    border: 1px solid {{ st.line_color | default: '#e1dbcf' }}; transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  #shopify-section-{{ sid }} .abhi__social a:hover { background: var(--color-heading); color: {{ st.background | default: '#ffffff' }}; border-color: var(--color-heading); }
  #shopify-section-{{ sid }} .abhi__social svg { width: 18px; height: 18px; }
  #shopify-section-{{ sid }} .abhi__letters { margin-top: 34px; padding-top: 24px; border-top: 1px solid {{ st.line_color | default: '#e1dbcf' }}; }
  #shopify-section-{{ sid }} .abhi__letters-title { margin: 0 0 8px; font-size: 14px; font-weight: 700; color: var(--color-heading); }
  #shopify-section-{{ sid }} .abhi__letters ul { list-style: none; margin: 0; padding: 0; }
  #shopify-section-{{ sid }} .abhi__letters a {
    display: flex; justify-content: space-between; gap: 16px; padding: 12px 0; border-bottom: 1px solid {{ st.line_color | default: '#e1dbcf' }};
    color: var(--color-heading); font-size: 16px; line-height: 1.4; text-decoration: none;
  }
  #shopify-section-{{ sid }} .abhi__letters a span:last-child { flex: 0 0 auto; color: {{ st.accent_color | default: '#c4471f' }}; transition: transform 0.2s ease; }
  #shopify-section-{{ sid }} .abhi__letters a:hover span:last-child { transform: translateX(4px); }
  @media (prefers-reduced-motion: reduce) { #shopify-section-{{ sid }} .abhi__letters a span:last-child { transition: none; } }
</style>

<div class="abhi color-{{ color_scheme }}{% if st.image_side == 'right' %} abhi--flip{% endif %}" id="{{ st.anchor | default: 'about' | handleize }}" data-section-id="{{ sid }}">
  <div class="abhi__inner">
    <figure class="abhi__media">
      <div class="abhi__frame">
        {%- if st.image != blank -%}
          <img src="{{ st.image | image_url: width: 1000 }}" srcset="{{ st.image | image_url: width: 600 }} 600w, {{ st.image | image_url: width: 1000 }} 1000w" sizes="(min-width: 990px) 500px, 90vw" width="1000" height="1250" alt="{{ st.image_alt | default: st.image.alt | escape }}" loading="lazy" decoding="async">
        {%- else -%}
          <img src="{{ placeholder }}" width="800" height="1000" alt="">
        {%- endif -%}
      </div>
    </figure>
    <div class="abhi__body">
      {%- if st.eyebrow != blank -%}<p class="abhi__eyebrow">{{ st.eyebrow | escape }}</p>{%- endif -%}
      {%- if st.heading != blank -%}<h2 class="abhi__heading">{{ st.heading }}</h2>{%- endif -%}
      {%- if st.text != blank -%}<div class="abhi__text">{{ st.text }}</div>{%- endif -%}
      <div class="abhi__actions">
        {%- if st.button_label != blank -%}<a class="abhi__btn" href="{{ st.button_link | default: '/pages/about' }}">{{ st.button_label | escape }}</a>{%- endif -%}
        {%- if st.instagram != blank or st.youtube != blank or st.x != blank or st.linkedin != blank or st.tiktok != blank -%}
          <ul class="abhi__social" role="list">
            {%- if st.instagram != blank -%}<li><a href="{{ st.instagram }}" target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg></a></li>{%- endif -%}
            {%- if st.youtube != blank -%}<li><a href="{{ st.youtube }}" target="_blank" rel="noopener" aria-label="YouTube"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23 7.2a3 3 0 0 0-2.1-2.1C19 4.6 12 4.6 12 4.6s-7 0-8.9.5A3 3 0 0 0 1 7.2 31 31 0 0 0 .5 12a31 31 0 0 0 .5 4.8 3 3 0 0 0 2.1 2.1c1.9.5 8.9.5 8.9.5s7 0 8.9-.5a3 3 0 0 0 2.1-2.1 31 31 0 0 0 .5-4.8 31 31 0 0 0-.5-4.8zM9.7 15.1V8.9L15.5 12z"/></svg></a></li>{%- endif -%}
            {%- if st.x != blank -%}<li><a href="{{ st.x }}" target="_blank" rel="noopener" aria-label="X"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.8 3h3.1l-6.8 7.7L22 21h-6.2l-4.9-6.3L5.3 21H2.2l7.2-8.2L1.8 3h6.4l4.4 5.8zm-1.1 16.2h1.7L7.4 4.7H5.6z"/></svg></a></li>{%- endif -%}
            {%- if st.linkedin != blank -%}<li><a href="{{ st.linkedin }}" target="_blank" rel="noopener" aria-label="LinkedIn"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9.5h4V21H3zM9.5 9.5h3.8v1.6h.1c.5-1 1.8-2 3.8-2 4 0 4.8 2.6 4.8 6V21h-4v-5.2c0-1.3 0-2.9-1.8-2.9s-2 1.4-2 2.8V21h-4z"/></svg></a></li>{%- endif -%}
            {%- if st.tiktok != blank -%}<li><a href="{{ st.tiktok }}" target="_blank" rel="noopener" aria-label="TikTok"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.6 3c.3 2.3 1.7 3.9 4 4.1v3.1a7 7 0 0 1-4-1.3v6.2c0 3.5-2.6 5.9-5.8 5.9A5.8 5.8 0 0 1 5 15.2c0-3.4 2.9-6 6.4-5.6v3.2c-1.6-.4-3.2.7-3.2 2.4 0 1.5 1.2 2.6 2.6 2.6 1.6 0 2.7-1.1 2.7-3V3z"/></svg></a></li>{%- endif -%}
          </ul>
        {%- endif -%}
      </div>
      {%- if letters.size > 0 -%}
        <div class="abhi__letters">
          {%- if st.letters_title != blank -%}<p class="abhi__letters-title">{{ st.letters_title | escape }}</p>{%- endif -%}
          <ul role="list">
            {%- for block in letters -%}
              <li {{ block.shopify_attributes }}><a href="{{ block.settings.link | default: '/blogs/news' }}"><span>{{ block.settings.title | escape }}</span><span aria-hidden="true">&rarr;</span></a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Author hello",
  "tag": "section",
  "class": "section sec__authorbook-hello",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default-color-scheme" },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#c4471f" },
    { "type": "color", "id": "line_color", "label": "Lines", "default": "#e1dbcf" },
    { "type": "text", "id": "anchor", "label": "Name for links to this section", "default": "about" },
    { "type": "header", "content": "Portrait" },
    { "type": "image_picker", "id": "image", "label": "Picture" },
    { "type": "text", "id": "image_alt", "label": "Alt text" },
    { "type": "select", "id": "image_side", "label": "Side", "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ], "default": "left" },
    { "type": "select", "id": "image_ratio", "label": "Shape", "options": [ { "value": "4 / 5", "label": "Portrait" }, { "value": "1 / 1", "label": "Square" }, { "value": "4 / 3", "label": "Landscape" } ], "default": "4 / 5" },
    { "type": "text", "id": "image_focus", "label": "Focus point (x% y%)", "default": "50% 40%" },
    { "type": "range", "id": "image_radius", "label": "Corners", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 10 },
    { "type": "color", "id": "frame_color", "label": "Block behind the picture", "default": "#f0643a" },
    { "type": "range", "id": "frame_opacity", "label": "Block opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "About the author" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Hi, I'm <em>your name</em>" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Say who you are, what you write about and why readers trust you, in a few lines.</p>" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "More about me" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "button_color", "label": "Button colour", "default": "#1d2b4f" },
    { "type": "color", "id": "button_text_color", "label": "Button text colour", "default": "#ffffff" },
    { "type": "range", "id": "button_radius", "label": "Button corners", "min": 0, "max": 30, "step": 1, "unit": "px", "default": 6 },
    { "type": "header", "content": "Social links" },
    { "type": "url", "id": "instagram", "label": "Instagram" },
    { "type": "url", "id": "youtube", "label": "YouTube" },
    { "type": "url", "id": "x", "label": "X" },
    { "type": "url", "id": "linkedin", "label": "LinkedIn" },
    { "type": "url", "id": "tiktok", "label": "TikTok" },
    { "type": "header", "content": "Recent letters" },
    { "type": "text", "id": "letters_title", "label": "Title over the list", "default": "Recent letters" },
    { "type": "header", "content": "Size and space" },
    { "type": "range", "id": "heading_size", "label": "Heading size, desktop", "min": 32, "max": 80, "step": 2, "unit": "px", "default": 56 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size, phone", "min": 26, "max": 52, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_top", "label": "Space above, desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 104 },
    { "type": "range", "id": "padding_bottom", "label": "Space below, desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 104 },
    { "type": "range", "id": "padding_top_mobile", "label": "Space above, phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Space below, phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    { "type": "letter", "name": "Letter or article", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "A recent letter" },
      { "type": "url", "id": "link", "label": "Link" }
    ] }
  ],
  "max_blocks": 5,
  "presets": [ { "name": "Author hello", "blocks": [ { "type": "letter" }, { "type": "letter" }, { "type": "letter" } ] } ]
}
{% endschema %}
