kness | default: 0 | json }},"desktop_text_size":{{ section.settings.desktop_text_size | default: 0 | json }},"font_weight":{{ section.settings.font_weight | append: '' | json }},"enable_custom_fonts":{% if section.settings.enable_custom_fonts %}true{% else %}false{% endif %},"heading_font":{"family":{{ section.settings.heading_font.family | append: '' | json }},"fallback_families":{{ section.settings.heading_font.fallback_families | append: '' | json }}},"body_font":{"family":{{ section.settings.body_font.family | append: '' | json }},"fallback_families":{{ section.settings.body_font.fallback_families | append: '' | json }}},"reveal":{% if section.settings.reveal %}true{% else %}false{% endif %},"desktop_top_padding":{{ section.settings.desktop_top_padding | default: 0 | json }},"desktop_bottom_padding":{{ section.settings.desktop_bottom_padding | default: 0 | json }},"section_margin_top_desktop":{{ section.settings.section_margin_top_desktop | default: 0 | json }},"section_margin_bottom_desktop":{{ section.settings.section_margin_bottom_desktop | default: 0 | json }},"mobile_image_position":{{ section.settings.mobile_image_position | append: '' | json }},"mobile_ratio":{{ section.settings.mobile_ratio | append: '' | json }},"mobile_text_size":{{ section.settings.mobile_text_size | default: 0 | json }},"mobile_container_gap":{{ section.settings.mobile_container_gap | default: 0 | json }},"mobile_top_padding":{{ section.settings.mobile_top_padding | default: 0 | json }},"mobile_bottom_padding":{{ section.settings.mobile_bottom_padding | default: 0 | json }},"section_margin_top_mobile":{{ section.settings.section_margin_top_mobile | default: 0 | json }},"section_margin_bottom_mobile":{{ section.settings.section_margin_bottom_mobile | default: 0 | json }}}{% endcapture %}{% capture cl_vars %}--cl-inner_width_px: {{ section.settings.inner_width_px | default: 0 }}px;--cl-image_border_radius: {{ section.settings.image_border_radius | default: 0 }}px;--cl-desktop_text_size: {{ section.settings.desktop_text_size | default: 0 }}px;--cl-mobile_text_size: {{ section.settings.mobile_text_size | default: 0 }}px;--cl-font_weight: {% if section.settings.font_weight == blank or section.settings.font_weight == 'theme' %}var(--heading-weight, 700){% else %}{{ section.settings.font_weight }}{% endif %};--cl-underline_thickness: {{ section.settings.underline_thickness | default: 0 }}px;--cl-desktop_container_gap: {{ section.settings.desktop_container_gap | default: 0 }}px;--cl-mobile_container_gap: {{ section.settings.mobile_container_gap | default: 0 }}px;--cl-desktop_menu_offset: {{ section.settings.desktop_menu_offset | default: 0 }}%;--cl-desktop_top_padding: {{ section.settings.desktop_top_padding | default: 0 }}px;--cl-desktop_bottom_padding: {{ section.settings.desktop_bottom_padding | default: 0 }}px;--cl-mobile_top_padding: {{ section.settings.mobile_top_padding | default: 0 }}px;--cl-mobile_bottom_padding: {{ section.settings.mobile_bottom_padding | default: 0 }}px;--cl-desktop_image_position: {{ section.settings.desktop_image_position }};--cl-mobile_image_position: {{ section.settings.mobile_image_position }};--cl-object_fit: {{ section.settings.object_fit }};--cl-desktop_ratio: {% if section.settings.desktop_ratio == 'coverfit' %}auto{% elsif section.settings.desktop_ratio == 'auto' %}auto{% elsif section.settings.desktop_ratio == 'landscape' %}16 / 9{% elsif section.settings.desktop_ratio == 'portrait' %}3 / 4{% elsif section.settings.desktop_ratio == 'square' %}1 / 1{% elsif section.settings.desktop_ratio == 'square_portrait' %}4 / 5{% elsif section.settings.desktop_ratio == 'rectangle' %}3 / 2{% else %}auto{% endif %};--cl-mobile_ratio: {% if section.settings.mobile_ratio == 'coverfit' %}1 / 1{% elsif section.settings.mobile_ratio == 'auto' %}auto{% elsif section.settings.mobile_ratio == 'landscape' %}16 / 9{% elsif section.settings.mobile_ratio == 'portrait' %}3 / 4{% elsif section.settings.mobile_ratio == 'square' %}1 / 1{% elsif section.settings.mobile_ratio == 'square_portrait' %}4 / 5{% elsif section.settings.mobile_ratio == 'rectangle' %}3 / 2{% else %}1 / 1{% endif %};{% if section.settings.enable_custom_style %}--cl-background_color: {% render 'scheme-color', color: section.settings.background_color, fallback: 'var(--color-background)' %};{% else %}--cl-background_color: var(--color-background);{% endif %}{% if section.settings.enable_custom_style %}--cl-background_gradient: {% if section.settings.background_gradient == blank %}none{% else %}{{ section.settings.background_gradient }}{% endif %};{% else %}--cl-background_gradient: none;{% endif %}{% if section.settings.enable_custom_style %}--cl-title_color: {% render 'scheme-color', color: section.settings.title_color, fallback: 'var(--color-heading)' %};{% else %}--cl-title_color: var(--color-heading);{% endif %}{% if section.settings.enable_custom_style %}--cl-hover_color: {% render 'scheme-color', color: section.settings.hover_color, fallback: 'var(--color-primary)' %};{% else %}--cl-hover_color: var(--color-primary);{% endif %}{% if section.settings.enable_custom_style %}--cl-underline_color: {% render 'scheme-color', color: section.settings.underline_color, fallback: 'currentColor' %};{% else %}--cl-underline_color: currentColor;{% endif %}{% if section.settings.enable_custom_fonts and section.settings.heading_font.family != blank %}--heading-font: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families | default: 'sans-serif' }};{% endif %}{% if section.settings.enable_custom_fonts and section.settings.body_font.family != blank %}--body-font: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families | default: 'sans-serif' }};{% endif %}{% endcapture %}data-cl-root="collectionnlist" data-cl-section="{{ section.id }}" data-cl-settings="{{ cl_json | escape }}" data-cl-defaults='{"color_scheme":"default","section_width":"full_width","reset_spacing":true,"button_link_target":"_self","show_product_count":false,"inner_width_px":1440,"desktop_image_position":"row","desktop_container_gap":50,"desktop_menu_offset":15,"desktop_ratio":"coverfit","image_border_radius":12,"object_fit":"cover","enable_custom_style":false,"enable_underline":true,"underline_thickness":2,"desktop_text_size":28,"font_weight":"theme","enable_custom_fonts":false,"heading_font":"assistant_n4","body_font":"assistant_n4","reveal":true,"desktop_top_padding":40,"desktop_bottom_padding":50,"section_margin_top_desktop":0,"section_margin_bottom_desktop":0,"mobile_image_position":"column","mobile_ratio":"coverfit","mobile_text_size":18,"mobile_container_gap":30,"mobile_top_padding":30,"mobile_bottom_padding":40,"section_margin_top_mobile":0,"section_margin_bottom_mobile":0}' data-cl-block-defaults='{"item":{"title":"Featured Collection"}}' style="{{ cl_vars | strip }}" data-underline="{% if section.settings.enable_underline %}true{% else %}false{% endif %}" data-ratio-d="{{ section.settings.desktop_ratio }}" data-ratio-m="{{ section.settings.mobile_ratio }}"{% if section.settings.enable_custom_fonts %}{% if section.settings.heading_font.family != blank or section.settings.body_font.family != blank %} data-own-font{% endif %}{% endif %}>
  {%- if item_count > 0 -%}
  <div class="cnl__inner">
    <ul class="cnl__list" role="list">
      {%- assign first_done = false -%}
      {%- for block in section.blocks -%}
        {%- assign bs = block.settings -%}
        {%- assign coll = bs.collection -%}
        {%- if request.design_mode or coll != blank or bs.title != blank -%}
        <li {% capture clb_json %}{"collection":{{ block.settings.collection.handle | append: '' | json }},"title":{{ block.settings.title | append: '' | json }},"image":{% if block.settings.image != blank %}{"src":{{ block.settings.image | image_url: width: 1600 | json }},"width":{{ block.settings.image.width | default: 0 | json }},"height":{{ block.settings.image.height | default: 0 | json }},"alt":{{ block.settings.image.alt | append: '' | json }}}{% else %}null{% endif %}}{% endcapture %}{% capture clb_vars %}{% endcapture %}data-cl-block="{{ block.id }}" data-cl-type="item" data-cl-settings="{{ clb_json | escape }}" style="{{ clb_vars | strip }}" data-cl-coll-title="{{ coll.title | escape }}" data-cl-coll-url="{{ coll.url }}" data-cl-coll-count="{% if coll != blank %}{{ coll.products_count }}{% endif %}" {{ block.shopify_attributes }}>
          <a class="cnl__link" href="{{ coll.url | default: routes.all_products_collection_url }}" target="{{ st.button_link_target }}"{% if st.button_link_target == '_blank' %} rel="noopener"{% endif %} data-cnl-for="{{ block.id }}"{% unless first_done %} aria-current="true"{% endunless %}>
            <span class="cnl__label">{{ bs.title | default: coll.title | escape }}</span>
            <span class="cnl__count"{% if coll == blank or bs.title != blank or st.show_product_count == false %} hidden{% endif %}>{{ coll.products_count }}</span>
          </a>
        </li>
        {%- assign first_done = true -%}
        {%- endif -%}
      {%- endfor -%}
    </ul>
    <div class="cnl__media">
      {%- assign first_done = false -%}
      {%- for block in section.blocks -%}
        {%- liquid
          assign bs = block.settings
          assign coll = bs.collection
          assign img = bs.image | default: coll.image | default: coll.featured_image
        -%}
        {%- if request.design_mode or coll != blank or bs.title != blank -%}
          {%- if img != blank -%}
            <img class="cnl__img{% unless first_done %} is-active{% endunless %}" data-cnl-img="{{ block.id }}" data-cl-of="{{ block.id }}" src="{{ img | image_url: width: 1400 }}" alt="{{ bs.title | default: coll.title | escape }}" width="{{ img.width }}" height="{{ img.height }}"{% if first_done %} loading="lazy"{% endif %}>
          {%- else -%}
            {%- capture ph_cls -%}cnl__ph{% unless first_done %} is-active{% endunless %}{%- endcapture -%}
            {%- assign ph_attr = 'data-cl-ph data-cnl-img="' | append: block.id | append: '" data-cl-of="' | append: block.id | append: '"' -%}
            {%- render 'placeholder-image', type: 'collection', index: forloop.index, class: ph_cls, attrs: ph_attr -%}
          {%- endif -%}
          {%- assign first_done = true -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
  {%- elsif request.design_mode -%}
    <p class="cnl__empty">Add a Collection item block to show your first collection.</p>
  {%- endif -%}
</div>{% schema %}
{
  "name": "Collection List",
  "class": "loudz-section loudz-collection-list-1 s-collectionnlist s-tt",
  "tag": "section",
  "max_blocks": 7,
  "disabled_on": {
    "groups": [
      "header"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "full_width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "select",
      "id": "button_link_target",
      "label": "Open links in",
      "options": [
        {
          "value": "_self",
          "label": "Same tab"
        },
        {
          "value": "_blank",
          "label": "New tab"
        }
      ],
      "default": "_self"
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "label": "Show product count",
      "default": false,
      "info": "Next to a title that comes from a collection."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "number",
      "id": "inner_width_px",
      "label": "Max width (px)",
      "default": 1440,
      "info": "With the full section width.",
      "visible_if": "{{ section.settings.section_width == 'full_width' }}"
    },
    {
      "type": "select",
      "id": "desktop_image_position",
      "label": "Picture side",
      "options": [
        {
          "value": "row",
          "label": "Right"
        },
        {
          "value": "row-reverse",
          "label": "Left"
        }
      ],
      "default": "row"
    },
    {
      "type": "range",
      "id": "desktop_container_gap",
      "label": "Gap between list and picture",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "desktop_menu_offset",
