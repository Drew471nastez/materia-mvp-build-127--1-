{%- comment -%}
  Digital Renaissance: the offer. On a near black ground with a soft light
  from the top: the course mark and a small label, a heading with words in
  a gold italic serif, a line, the main button, a quieter one (it can open
  the sign up window: #open-form-access), a note and three facts. Beside
  it, a course window drawn in HTML, not a picture: a module list with
  progress, the lesson playing and an assistant answering a question, so
  every word in it can be edited and it stays sharp on any screen.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign modules = st.modules | newline_to_br | split: '<br />'
-%}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap">
<style>
  #shopify-section-{{ sid }} .rnh { --gold: {{ st.gold | default: '#f2bd4f' }}; --lapis: {{ st.accent | default: '#3d5afe' }}; position: relative; overflow: hidden; background: {{ st.background | default: '#07080d' }}; color: {{ st.text_color | default: '#a7adbf' }}; padding: {{ st.padding_top_mobile | default: 40 }}px 20px {{ st.padding_bottom_mobile | default: 64 }}px; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .rnh { padding: {{ st.padding_top | default: 72 }}px 40px {{ st.padding_bottom | default: 112 }}px; } }
  #shopify-section-{{ sid }} .rnh::before { content: ""; position: absolute; left: 50%; top: -420px; width: 1100px; height: 760px; transform: translateX(-30%); background: radial-gradient(closest-side, color-mix(in srgb, var(--lapis) 38%, transparent), transparent); pointer-events: none; }
  #shopify-section-{{ sid }} .rnh::after { content: ""; position: absolute; inset: 0; background-image: linear-gradient(rgba(255,255,255,.035) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.035) 1px, transparent 1px); background-size: 56px 56px; -webkit-mask-image: radial-gradient(ellipse at 70% 20%, #000 0%, transparent 65%); mask-image: radial-gradient(ellipse at 70% 20%, #000 0%, transparent 65%); pointer-events: none; }
  #shopify-section-{{ sid }} .rnh__in { position: relative; z-index: 1; max-width: 1220px; margin: 0 auto; display: grid; grid-template-columns: minmax(0, 1fr); gap: 48px; align-items: center; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .rnh__in { grid-template-columns: minmax(0, 1fr) minmax(0, 1.02fr); gap: 64px; } }
  #shopify-section-{{ sid }} .rnh__pill { display: inline-flex; align-items: center; gap: 10px; margin: 0 0 22px; padding: 6px 14px 6px 6px; border-radius: 999px; border: 1px solid rgba(255,255,255,.12); background: rgba(255,255,255,.04); color: #e6e8f0; font-size: 13px; font-weight: 500; }
  #shopify-section-{{ sid }} .rnh__pill b { padding: 4px 9px; border-radius: 999px; background: var(--lapis); color: #fff; font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  #shopify-section-{{ sid }} .rnh__title { margin: 0; color: {{ st.heading_color | default: '#ffffff' }}; font-family: var(--heading-font, sans-serif); font-weight: 600; font-size: {{ st.heading_size_mobile | default: 42 }}px; line-height: 1.04; letter-spacing: -.035em; text-wrap: balance; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .rnh__title { font-size: clamp(52px, 5.2vw, {{ st.heading_size | default: 72 }}px); } }
  #shopify-section-{{ sid }} .rnh__title em, #shopify-section-{{ sid }} .rnh__title i { font-family: 'Instrument Serif', Georgia, serif; font-style: italic; font-weight: 400; letter-spacing: -.01em; color: var(--gold); }
  #shopify-section-{{ sid }} .rnh__text { max-width: 33em; margin: 22px 0 0; font-size: 17px; line-height: 1.6; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .rnh__text { font-size: 18px; } }
  #shopify-section-{{ sid }} .rnh__text p { margin: 0; }
  #shopify-section-{{ sid }} .rnh__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  #shopify-section-{{ sid }} .rn-btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 56px; padding: 0 28px; border-radius: 12px; font-size: 16px; font-weight: 600; text-decoration: none; transition: transform .25s ease, background-color .25s ease, box-shadow .25s ease; }
  #shopify-section-{{ sid }} .rn-btn--main { background: var(--lapis); color: #fff; box-shadow: 0 1px 0 rgba(255,255,255,.25) inset, 0 16px 40px -14px color-mix(in srgb, var(--lapis) 90%, transparent); }
  #shopify-section-{{ sid }} .rn-btn--main:hover { transform: translateY(-2px); }
  #shopify-section-{{ sid }} .rn-btn--ghost { border: 1px solid rgba(255,255,255,.18); color: #fff; background: rgba(255,255,255,.03); }
  #shopify-section-{{ sid }} .rn-btn--ghost:hover { background: rgba(255,255,255,.08); }
  #shopify-section-{{ sid }} .rn-btn svg { width: 16px; height: 16px; }
  @media (max-width: 599px) { #shopify-section-{{ sid }} .rn-btn { width: 100%; } }
  #shopify-section-{{ sid }} .rnh__note { margin: 14px 0 0; font-size: 13.5px; color: #8a90a3; }
  #shopify-section-{{ sid }} .rnh__facts { display: flex; flex-wrap: wrap; gap: 0; margin: 36px 0 0; padding: 0; list-style: none; }
  #shopify-section-{{ sid }} .rnh__facts li { padding: 0 22px; border-left: 1px solid rgba(255,255,255,.12); }
  #shopify-section-{{ sid }} .rnh__facts li:first-child { padding-left: 0; border-left: 0; }
  #shopify-section-{{ sid }} .rnh__facts b { display: block; color: #fff; font-family: var(--heading-font, sans-serif); font-size: 26px; font-weight: 600; letter-spacing: -.03em; }
  #shopify-section-{{ sid }} .rnh__facts span { font-size: 13px; }
  @media (max-width: 420px) { #shopify-section-{{ sid }} .rnh__facts li { padding: 0 14px; } #shopify-section-{{ sid }} .rnh__facts b { font-size: 22px; } }
  /* the course window */
  #shopify-section-{{ sid }} .rnw { position: relative; border-radius: 18px; border: 1px solid rgba(255,255,255,.1); background: linear-gradient(180deg, #11131c, #0b0c12); box-shadow: 0 40px 90px -40px rgba(0,0,0,.9), 0 0 0 1px rgba(0,0,0,.4); overflow: hidden; }
  #shopify-section-{{ sid }} .rnw__bar { display: flex; align-items: center; gap: 7px; padding: 12px 14px; border-bottom: 1px solid rgba(255,255,255,.07); }
  #shopify-section-{{ sid }} .rnw__bar i { width: 9px; height: 9px; border-radius: 50%; background: rgba(255,255,255,.16); }
  #shopify-section-{{ sid }} .rnw__bar span { margin-left: 10px; color: #6f7588; font-size: 12px; }
  #shopify-section-{{ sid }} .rnw__body { display: grid; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 750px) { #shopify-section-{{ sid }} .rnw__body { grid-template-columns: 200px minmax(0, 1fr); } }
  #shopify-section-{{ sid }} .rnw__side { display: none; padding: 16px 12px; border-right: 1px solid rgba(255,255,255,.07); }
  @media (min-width: 750px) { #shopify-section-{{ sid }} .rnw__side { display: block; } }
  #shopify-section-{{ sid }} .rnw__brand { display: flex; align-items: center; gap: 8px; margin: 0 4px 16px; color: #fff; font-size: 12.5px; font-weight: 600; }
  #shopify-section-{{ sid }} .rnw__brand svg { width: 22px; height: 22px; }
  #shopify-section-{{ sid }} .rnw__mods { margin: 0; padding: 0; list-style: none; display: grid; gap: 2px; }
  #shopify-section-{{ sid }} .rnw__mods li { display: flex; align-items: center; gap: 9px; padding: 8px 8px; border-radius: 8px; color: #8d93a6; font-size: 12px; line-height: 1.3; }
  #shopify-section-{{ sid }} .rnw__mods li.is-now { background: rgba(255,255,255,.06); color: #fff; }
  #shopify-section-{{ sid }} .rnw__tick { flex: 0 0 auto; display: grid; place-items: center; width: 16px; height: 16px; border-radius: 50%; border: 1px solid rgba(255,255,255,.2); }
  #shopify-section-{{ sid }} .rnw__mods li.is-done .rnw__tick { border-color: transparent; background: var(--lapis); }
  #shopify-section-{{ sid }} .rnw__mods li.is-now .rnw__tick { border-color: var(--gold); }
  #shopify-section-{{ sid }} .rnw__tick svg { width: 9px; height: 9px; color: #fff; }
  #shopify-section-{{ sid }} .rnw__main { padding: 16px; }
  @media (min-width: 750px) { #shopify-section-{{ sid }} .rnw__main { padding: 20px; } }
  #shopify-section-{{ sid }} .rnw__crumb { margin: 0 0 6px; color: var(--gold); font-size: 11px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; }
  #shopify-section-{{ sid }} .rnw__lesson { margin: 0 0 14px; color: #fff; font-size: 16px; font-weight: 600; letter-spacing: -.01em; }
  #shopify-section-{{ sid }} .rnw__video { position: relative; aspect-ratio: 16 / 9; border-radius: 12px; overflow: hidden; background: radial-gradient(120% 90% at 80% 10%, color-mix(in srgb, var(--lapis) 70%, #000) 0%, #0d1020 55%, #07080d 100%); }
  #shopify-section-{{ sid }} .rnw__video::before { content: ""; position: absolute; inset: 0; background-image: linear-gradient(rgba(255,255,255,.05) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.05) 1px, transparent 1px); background-size: 28px 28px; }
  #shopify-section-{{ sid }} .rnw__mark { position: absolute; right: 8%; top: 50%; width: 34%; transform: translateY(-50%); opacity: .95; }
  #shopify-section-{{ sid }} .rnw__vt { position: absolute; left: 6%; top: 50%; transform: translateY(-50%); max-width: 52%; color: #fff; font-family: var(--heading-font, sans-serif); font-size: clamp(14px, 2.2vw, 22px); font-weight: 600; line-height: 1.15; letter-spacing: -.02em; }
  #shopify-section-{{ sid }} .rnw__vt em { font-family: 'Instrument Serif', Georgia, serif; font-weight: 400; color: var(--gold); }
  #shopify-section-{{ sid }} .rnw__ctrl { position: absolute; left: 12px; right: 12px; bottom: 10px; display: flex; align-items: center; gap: 10px; color: #fff; font-size: 11px; }
  #shopify-section-{{ sid }} .rnw__play { display: grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; background: rgba(255,255,255,.16); }
  #shopify-section-{{ sid }} .rnw__play svg { width: 9px; height: 9px; margin-left: 1px; }
  #shopify-section-{{ sid }} .rnw__track { flex: 1 1 auto; height: 3px; border-radius: 3px; background: rgba(255,255,255,.2); overflow: hidden; }
  #shopify-section-{{ sid }} .rnw__track i { display: block; width: 38%; height: 100%; background: var(--gold); }
  #shopify-section-{{ sid }} .rnw__chat { display: grid; gap: 8px; margin-top: 14px; }
  #shopify-section-{{ sid }} .rnw__msg { max-width: 88%; padding: 10px 12px; border-radius: 12px; font-size: 12.5px; line-height: 1.45; }
  #shopify-section-{{ sid }} .rnw__msg--you { justify-self: end; background: var(--lapis); color: #fff; border-bottom-right-radius: 4px; }
  #shopify-section-{{ sid }} .rnw__msg--ai { background: rgba(255,255,255,.06); color: #d7dae4; border: 1px solid rgba(255,255,255,.07); border-bottom-left-radius: 4px; }
  #shopify-section-{{ sid }} .rnw__msg--ai b { display: block; margin-bottom: 3px; color: var(--gold); font-size: 11px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; }
  #shopify-section-{{ sid }} .rnw__msg--ai.is-typing { opacity: 0; transform: translateY(6px); }
  #shopify-section-{{ sid }} .rnw__msg--ai.is-in { opacity: 1; transform: none; transition: opacity .6s ease, transform .6s ease; }
  #shopify-section-{{ sid }} .rnh__visual { position: relative; }
  #shopify-section-{{ sid }} .rnh__badge { position: absolute; left: -14px; bottom: 28px; display: none; align-items: center; gap: 10px; padding: 10px 14px 10px 10px; border-radius: 14px; background: #fff; color: #0b0c12; box-shadow: 0 20px 40px -18px rgba(0,0,0,.7); font-size: 13px; font-weight: 600; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .rnh__badge { display: inline-flex; } }
  #shopify-section-{{ sid }} .rnh__badge i { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 9px; background: var(--gold); }
  #shopify-section-{{ sid }} .rnh__badge svg { width: 16px; height: 16px; }
  #shopify-section-{{ sid }} .rnh__badge small { display: block; color: #5d6274; font-size: 11.5px; font-weight: 500; }
  @media (prefers-reduced-motion: reduce) { #shopify-section-{{ sid }} .rn-btn { transition: none; } }
</style>
<section data-own-size class="rnh"{% if st.anchor != blank %} id="{{ st.anchor | handleize }}"{% endif %}>
  <div class="rnh__in">
    <div>
      {%- if st.pill_text != blank -%}<p class="rnh__pill">{%- if st.pill_tag != blank -%}<b>{{ st.pill_tag | escape }}</b>{%- endif -%}{{ st.pill_text | escape }}</p>{%- endif -%}
      <h1 class="rnh__title">{{ st.heading }}</h1>
      {%- if st.text != blank -%}<div class="rnh__text">{{ st.text }}</div>{%- endif -%}
      <div class="rnh__actions">
        {%- if st.button_label != blank -%}<a class="rn-btn rn-btn--main" href="{{ st.button_link | default: '#' }}">{{ st.button_label | escape }}<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg></a>{%- endif -%}
        {%- if st.button2_label != blank -%}<a class="rn-btn rn-btn--ghost" href="{{ st.button2_link | default: '#' }}">{{ st.button2_label | escape }}</a>{%- endif -%}
      </div>
      {%- if st.note != blank -%}<p class="rnh__note">{{ st.note | escape }}</p>{%- endif -%}
      {%- if st.fact1_value != blank -%}
        <ul class="rnh__facts">
          <li><b>{{ st.fact1_value | escape }}</b><span>{{ st.fact1_label | escape }}</span></li>
          {%- if st.fact2_value != blank -%}<li><b>{{ st.fact2_value | escape }}</b><span>{{ st.fact2_label | escape }}</span></li>{%- endif -%}
          {%- if st.fact3_value != blank -%}<li><b>{{ st.fact3_value | escape }}</b><span>{{ st.fact3_label | escape }}</span></li>{%- endif -%}
        </ul>
      {%- endif -%}
    </div>
    <div class="rnh__visual">
      <div class="rnw" aria-hidden="true">
        <div class="rnw__bar"><i></i><i></i><i></i><span>{{ st.window_title | escape }}</span></div>
        <div class="rnw__body">
          <div class="rnw__side">
            <p class="rnw__brand"><svg viewBox="0 0 48 48"><rect width="48" height="48" rx="12" fill="var(--lapis)"/><circle cx="24" cy="24" r="13" fill="none" stroke="var(--gold)" stroke-width="2"/><path d="M24 8.5c1.3 10.2 5.3 14.2 15.5 15.5-10.2 1.3-14.2 5.3-15.5 15.5-1.3-10.2-5.3-14.2-15.5-15.5 10.2-1.3 14.2-5.3 15.5-15.5z" fill="#fff"/></svg>{{ st.window_brand | escape }}</p>
            <ul class="rnw__mods">
              {%- assign now = st.current_module | default: 3 -%}
              {%- for m in modules -%}{%- assign line = m | strip -%}{%- if line != blank -%}
                <li class="{% if forloop.index < now %}is-done{% elsif forloop.index == now %}is-now{% endif %}"><span class="rnw__tick">{%- if forloop.index < now -%}<svg viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 5.2 4.2 7.4 8 3"/></svg>{%- endif -%}</span>{{ line | escape }}</li>
              {%- endif -%}{%- endfor -%}
            </ul>
          </div>
          <div class="rnw__main">
            <p class="rnw__crumb">{{ st.lesson_label | escape }}</p>
            <p class="rnw__lesson">{{ st.lesson_title | escape }}</p>
            <div class="rnw__video">
              <span class="rnw__vt">{{ st.video_text }}</span>
              <svg class="rnw__mark" viewBox="0 0 48 48"><circle cx="24" cy="24" r="17" fill="none" stroke="var(--gold)" stroke-width="1.2" opacity=".8"/><circle cx="24" cy="24" r="22.5" fill="none" stroke="rgba(255,255,255,.18)" stroke-width=".6"/><path d="M24 4c1.7 13.3 6.7 18.3 20 20-13.3 1.7-18.3 6.7-20 20-1.7-13.3-6.7-18.3-20-20 13.3-1.7 18.3-6.7 20-20z" fill="#fff"/></svg>
              <div class="rnw__ctrl"><span class="rnw__play"><svg viewBox="0 0 12 14" fill="currentColor"><path d="M0 0l12 7-12 7z"/></svg></span><span class="rnw__track"><i></i></span><span>{{ st.video_time | escape }}</span></div>
            </div>
            <div class="rnw__chat">
              {%- if st.question != blank -%}<p class="rnw__msg rnw__msg--you">{{ st.question | escape }}</p>{%- endif -%}
              {%- if st.answer != blank -%}<p class="rnw__msg rnw__msg--ai" data-rnw-answer><b>{{ st.answer_label | escape }}</b>{{ st.answer | escape }}</p>{%- endif -%}
            </div>
          </div>
        </div>
      </div>
      {%- if st.badge_title != blank -%}<p class="rnh__badge" aria-hidden="true"><i><svg viewBox="0 0 16 16" fill="none" stroke="#0b0c12" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8.5 6.2 11.5 13 4.5"/></svg></i><span>{{ st.badge_title | escape }}<small>{{ st.badge_text | escape }}</small></span></p>{%- endif -%}
    </div>
  </div>
</section>
{%- unless request.design_mode -%}
<script>(function(){var r=document.getElementById('shopify-section-{{ sid }}');if(!r||matchMedia('(prefers-reduced-motion: reduce)').matches||!('IntersectionObserver' in window))return;var a=r.querySelector('[data-rnw-answer]');if(!a)return;a.classList.add('is-typing');var io=new IntersectionObserver(function(es){if(!es[0].isIntersecting)return;io.disconnect();setTimeout(function(){a.classList.add('is-in')},700)});io.observe(a)})();</script>
{%- endunless -%}

{% schema %}
{
  "name": "Renaissance hero",
  "tag": "section",
  "class": "renaissance-hero-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "anchor", "label": "Name for links to this place", "default": "top" },
    { "type": "text", "id": "pill_tag", "label": "Label tag", "default": "New" },
    { "type": "text", "id": "pill_text", "label": "Label", "default": "Spring cohort opens soon" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Learn the skill in <em>six weeks</em>", "info": "Words in italics show in the gold serif." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Who it is for and what they will be able to do at the end.</p>" },
    { "type": "text", "id": "button_label", "label": "Main button", "default": "Join the course" },
    { "type": "url", "id": "button_link", "label": "Main button link" },
    { "type": "text", "id": "button2_label", "label": "Second button", "default": "Get the first module free" },
    { "type": "text", "id": "button2_link", "label": "Second button link", "default": "#open-form-access", "info": "#open-form-access opens a Form popup named access." },
    { "type": "text", "id": "note", "label": "Line under the buttons", "default": "One payment. Lifetime access." },
    { "type": "text", "id": "fact1_value", "label": "Fact 1", "default": "6" },
    { "type": "text", "id": "fact1_label", "label": "Fact 1 label", "default": "modules" },
    { "type": "text", "id": "fact2_value", "label": "Fact 2", "default": "40" },
    { "type": "text", "id": "fact2_label", "label": "Fact 2 label", "default": "short lessons" },
    { "type": "text", "id": "fact3_value", "label": "Fact 3", "default": "12" },
    { "type": "text", "id": "fact3_label", "label": "Fact 3 label", "default": "live calls" },
    { "type": "header", "content": "Course window" },
    { "type": "text", "id": "window_title", "label": "Window title", "default": "learn.yourcourse.com" },
    { "type": "text", "id": "window_brand", "label": "Course name in the window", "default": "Your course" },
    { "type": "textarea", "id": "modules", "label": "Modules, one per line", "default": "Start here\nThe basics\nYour first project\nGoing further\nPutting it together" },
    { "type": "range", "id": "current_module", "label": "Module being watched", "min": 1, "max": 8, "step": 1, "default": 3 },
    { "type": "text", "id": "lesson_label", "label": "Small line above the lesson", "default": "Module 3, lesson 2" },
    { "type": "text", "id": "lesson_title", "label": "Lesson title", "default": "Your first project" },
    { "type": "inline_richtext", "id": "video_text", "label": "Words on the video", "default": "Lesson <em>title</em>" },
    { "type": "text", "id": "video_time", "label": "Video time", "default": "6:12" },
    { "type": "text", "id": "question", "label": "A question asked", "default": "How do I start?" },
    { "type": "text", "id": "answer_label", "label": "Answer label", "default": "Assistant" },
    { "type": "text", "id": "answer", "label": "The answer", "default": "Begin with the lesson on the left." },
    { "type": "text", "id": "badge_title", "label": "Card beside the window", "default": "Lesson finished" },
    { "type": "text", "id": "badge_text", "label": "Card second line", "default": "Next one unlocked" },
    { "type": "header", "content": "Look" },
    { "type": "color", "id": "background", "label": "Background", "default": "#07080d" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#3d5afe" },
    { "type": "color", "id": "gold", "label": "Highlight", "default": "#f2bd4f" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#a7adbf" },
    { "type": "range", "id": "heading_size", "label": "Heading size on a computer", "min": 44, "max": 96, "step": 2, "unit": "px", "default": 72 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size on a phone", "min": 30, "max": 60, "step": 2, "unit": "px", "default": 42 },
    { "type": "range", "id": "padding_top", "label": "Space above on a computer", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Space below on a computer", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 112 },
    { "type": "range", "id": "padding_top_mobile", "label": "Space above on a phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Space below on a phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "presets": [ { "name": "Renaissance hero", "category": "Digital Renaissance" } ]
}
{% endschema %}
