{%- comment -%}
  Coach: a row of square pictures from edge to edge with a small label
  above, like a social profile's grid, linking to the profile. Five across
  on desktop; on a phone the row scrolls sideways with the next picture
  peeking in.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign color_scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
  assign placeholder = 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 400 400%22%3E%3Crect width=%22400%22 height=%22400%22 fill=%22%23eadfd1%22/%3E%3C/svg%3E'
-%}
<style>
  #shopify-section-{{ sid }} .cog {
    background: {{ st.background | default: '#faf6f0' }};
    padding: {{ st.padding_top_mobile | default: 40 }}px 0 {{ st.padding_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 990px) {
    #shopify-section-{{ sid }} .cog { padding: {{ st.padding_top | default: 56 }}px 0 {{ st.padding_bottom | default: 0 }}px; }
  }
  #shopify-section-{{ sid }} .cog__label {
    margin: 0 0 22px; padding: 0 20px; text-align: center; color: {{ st.accent_color | default: '#a5582a' }};
    font-size: 12px; font-weight: 500; letter-spacing: 0.2em; text-transform: uppercase;
  }
  #shopify-section-{{ sid }} .cog__label a { color: inherit; text-decoration: none; }
  #shopify-section-{{ sid }} .cog__label a:hover { text-decoration: underline; text-underline-offset: 4px; }
  #shopify-section-{{ sid }} .cog__row {
    display: grid; grid-auto-flow: column; grid-auto-columns: 62%; gap: {{ st.gap | default: 4 }}px;
    overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; overscroll-behavior-x: contain;
  }
  #shopify-section-{{ sid }} .cog__row::-webkit-scrollbar { display: none; }
  @media (min-width: 750px) {
    #shopify-section-{{ sid }} .cog__row { grid-auto-flow: row; grid-template-columns: repeat({{ section.blocks.size | at_least: 1 | at_most: 6 }}, minmax(0, 1fr)); overflow: visible; }
  }
  #shopify-section-{{ sid }} .cog__tile { position: relative; display: block; aspect-ratio: 1 / 1; overflow: hidden; scroll-snap-align: start; background: #eadfd1; }
  #shopify-section-{{ sid }} .cog__tile img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; margin: 0; transition: transform 0.6s ease, opacity 0.3s ease; }
  #shopify-section-{{ sid }} .cog__tile:hover img { transform: scale(1.04); opacity: 0.92; }
  @media (prefers-reduced-motion: reduce) { #shopify-section-{{ sid }} .cog__tile img { transition: none; } #shopify-section-{{ sid }} .cog__tile:hover img { transform: none; } }
</style>

<div class="cog color-{{ color_scheme }}" data-section-id="{{ sid }}">
  {%- if st.label != blank -%}
    <p class="cog__label">{%- if st.link != blank -%}<a href="{{ st.link }}">{{ st.label | escape }}</a>{%- else -%}{{ st.label | escape }}{%- endif -%}</p>
  {%- endif -%}
  <div class="cog__row">
    {%- for block in section.blocks -%}
      {%- assign b = block.settings -%}
      <a class="cog__tile" href="{{ b.link | default: st.link | default: '/blogs/news' }}" {{ block.shopify_attributes }}>
        {%- if b.image != blank -%}
          <img src="{{ b.image | image_url: width: 640 }}" srcset="{{ b.image | image_url: width: 400 }} 400w, {{ b.image | image_url: width: 640 }} 640w" sizes="(min-width: 750px) 20vw, 62vw" width="{{ b.image.width | default: 640 }}" height="{{ b.image.height | default: 640 }}" alt="{{ b.alt | default: b.image.alt | escape }}" loading="lazy" decoding="async">
        {%- else -%}
          <img src="{{ placeholder }}" width="400" height="400" alt="">
        {%- endif -%}
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Coach picture row",
  "tag": "section",
  "class": "section sec__coach-gallery",
  "max_blocks": 6,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default-color-scheme" },
    { "type": "color", "id": "background", "label": "Background", "default": "#faf6f0" },
    { "type": "color", "id": "accent_color", "label": "Label colour", "default": "#a5582a" },
    { "type": "text", "id": "label", "label": "Label", "default": "Follow along" },
    { "type": "url", "id": "link", "label": "Link for the label and the pictures", "info": "Your social profile, for example." },
    { "type": "range", "id": "gap", "label": "Gap", "min": 0, "max": 16, "step": 1, "unit": "px", "default": 4 },
    { "type": "range", "id": "padding_top", "label": "Space above, desktop", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Space below, desktop", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_top_mobile", "label": "Space above, phone", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Space below, phone", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 }
  ],
  "blocks": [
    {
      "type": "picture",
      "name": "Picture",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Picture" },
        { "type": "text", "id": "alt", "label": "Alt text" },
        { "type": "url", "id": "link", "label": "Link", "info": "Leave empty to use the section's link." }
      ]
    }
  ],
  "presets": [
    { "name": "Coach picture row", "blocks": [ { "type": "picture" }, { "type": "picture" }, { "type": "picture" }, { "type": "picture" }, { "type": "picture" } ] }
  ]
}
{% endschema %}
