{%- comment -%}
  Coach, second look: the coach. A photograph beside a heading, a few
  paragraphs, a short list of facts, the places they post and a button.
  The heading can be the page's main heading, for an About page.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign color_scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
  assign tag = 'h2'
  if st.main_heading
    assign tag = 'h1'
  endif
-%}
<style>
  #shopify-section-{{ sid }} .c2a { --ink: {{ st.ink }}; --muted: {{ st.muted }}; --accent: {{ st.accent }}; --line: {{ st.line_color }}; background: {{ st.background }}; padding: {{ st.padding_top_mobile }}px 16px {{ st.padding_bottom_mobile }}px; }
  @media (min-width: 750px) { #shopify-section-{{ sid }} .c2a { padding: {{ st.padding_top }}px 32px {{ st.padding_bottom }}px; } }
  #shopify-section-{{ sid }} .c2a__inner { max-width: var(--page-width, 1310px); margin: 0 auto; display: grid; grid-template-columns: minmax(0, 1fr); gap: 36px; align-items: center; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .c2a__inner { grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr); gap: 80px; } #shopify-section-{{ sid }} .c2a--right .c2a__media { order: 2; } }
  #shopify-section-{{ sid }} .c2a__media { position: relative; margin: 0; aspect-ratio: {{ st.image_ratio }}; border-radius: 8px; overflow: hidden; background: #e8eaee; }
  #shopify-section-{{ sid }} .c2a__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: {{ st.image_focus }}; margin: 0; }
  #shopify-section-{{ sid }} .c2a__eyebrow { margin: 0 0 12px; color: var(--accent); font-size: 13px; font-weight: 600; letter-spacing: .04em; }
  #shopify-section-{{ sid }} .c2a__h { margin: 0; color: var(--ink); font-family: var(--heading-font, inherit); font-weight: 700; letter-spacing: -0.035em; line-height: 1.04; font-size: {{ st.heading_size_mobile }}px; text-wrap: balance; }
  @media (min-width: 750px) { #shopify-section-{{ sid }} .c2a__h { font-size: {{ st.heading_size }}px; } }
  #shopify-section-{{ sid }} .c2a__h em { font-style: normal; color: var(--accent); }
  #shopify-section-{{ sid }} .c2a__t { margin: 20px 0 0; color: var(--muted); font-size: 16.5px; line-height: 1.7; max-width: 58ch; }
  #shopify-section-{{ sid }} .c2a__t p { margin: 0 0 14px; }
  #shopify-section-{{ sid }} .c2a__facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 24px; margin: 22px 0 0; padding: 0; list-style: none; border-top: 1px solid var(--line); }
  #shopify-section-{{ sid }} .c2a__facts li { padding: 14px 0; border-bottom: 1px solid var(--line); }
  #shopify-section-{{ sid }} .c2a__facts small { display: block; color: var(--muted); font-size: 12.5px; }
  #shopify-section-{{ sid }} .c2a__facts b { display: block; margin-top: 2px; color: var(--ink); font-size: 15.5px; font-weight: 600; }
  #shopify-section-{{ sid }} .c2a__row { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 18px; margin-top: 28px; }
  #shopify-section-{{ sid }} .c2a__btn { display: inline-flex; align-items: center; min-height: 50px; padding: 0 22px; border-radius: 6px; background: var(--accent); color: #fff; font-size: 15px; font-weight: 600; text-decoration: none; transition: background-color .2s ease; }
  #shopify-section-{{ sid }} .c2a__btn:hover { background: var(--ink); }
  #shopify-section-{{ sid }} .c2a__social { display: flex; gap: 8px; margin: 0; padding: 0; list-style: none; }
  #shopify-section-{{ sid }} .c2a__social a { display: grid; place-items: center; width: 44px; height: 44px; border: 1px solid var(--line); border-radius: 50%; color: var(--ink); transition: background-color .2s ease, color .2s ease, border-color .2s ease; }
  #shopify-section-{{ sid }} .c2a__social a:hover { background: var(--ink); border-color: var(--ink); color: #fff; }
  #shopify-section-{{ sid }} .c2a__social svg { width: 18px; height: 18px; }
</style>

<div class="c2a color-{{ color_scheme }}{% if st.image_position == 'right' %} c2a--right{% endif %}">
  <div class="c2a__inner">
    <figure class="c2a__media">
      {%- if st.image != blank -%}
        <img src="{{ st.image | image_url: width: 1100 }}" srcset="{{ st.image | image_url: width: 600 }} 600w, {{ st.image | image_url: width: 1100 }} 1100w" sizes="(min-width: 990px) 600px, 94vw" width="{{ st.image.width | default: 1100 }}" height="{{ st.image.height | default: 1100 }}" alt="{{ st.image_alt | escape }}" {% if st.main_heading %}fetchpriority="high"{% else %}loading="lazy"{% endif %} decoding="async">
      {%- endif -%}
    </figure>
    <div>
      {%- if st.eyebrow != blank -%}<p class="c2a__eyebrow">{{ st.eyebrow | escape }}</p>{%- endif -%}
      {%- if st.heading != blank -%}<{{ tag }} class="c2a__h">{{ st.heading }}</{{ tag }}>{%- endif -%}
      {%- if st.text != blank -%}<div class="c2a__t">{{ st.text }}</div>{%- endif -%}
      {%- if st.fact_1 != blank or st.fact_2 != blank -%}
        <ul class="c2a__facts">
          {%- for f in (1..4) -%}
            {%- assign k = 'fact_' | append: f -%}
            {%- if st[k] != blank -%}{%- assign parts = st[k] | split: ':' -%}<li><small>{{ parts[0] | strip | escape }}</small><b>{{ parts[1] | strip | escape }}</b></li>{%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
      <div class="c2a__row">
        {%- if st.button_label != blank -%}<a class="c2a__btn" href="{{ st.button_link | default: '/pages/book' }}">{{ st.button_label | escape }}</a>{%- endif -%}
        <ul class="c2a__social">
          {%- if st.linkedin != blank -%}<li><a href="{{ st.linkedin }}" target="_blank" rel="noopener" aria-label="LinkedIn"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9.5h4V21H3V9.5zm7 0h3.8v1.6h.1c.5-1 1.8-2 3.8-2 4 0 4.8 2.6 4.8 6V21h-4v-5.1c0-1.2 0-2.8-1.7-2.8s-2 1.3-2 2.7V21h-4V9.5z"/></svg></a></li>{%- endif -%}
          {%- if st.instagram != blank -%}<li><a href="{{ st.instagram }}" target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg></a></li>{%- endif -%}
          {%- if st.youtube != blank -%}<li><a href="{{ st.youtube }}" target="_blank" rel="noopener" aria-label="YouTube"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.6 7.2c-.2-.9-.9-1.6-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4c-.9.2-1.6.9-1.8 1.8C2 8.8 2 12 2 12s0 3.2.4 4.8c.2.9.9 1.6 1.8 1.8 1.6.4 7.8.4 7.8.4s6.2 0 7.8-.4c.9-.2 1.6-.9 1.8-1.8.4-1.6.4-4.8.4-4.8s0-3.2-.4-4.8zM10 15V9l5.2 3L10 15z"/></svg></a></li>{%- endif -%}
          {%- if st.x != blank -%}<li><a href="{{ st.x }}" target="_blank" rel="noopener" aria-label="X"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.8 3h3.1l-6.8 7.7 8 10.3h-6.2l-4.9-6.3L5.4 21H2.3l7.2-8.3L1.8 3h6.4l4.4 5.8L17.8 3zm-1.1 16.2h1.7L7.4 4.7H5.6l11.1 14.5z"/></svg></a></li>{%- endif -%}
          {%- if st.tiktok != blank -%}<li><a href="{{ st.tiktok }}" target="_blank" rel="noopener" aria-label="TikTok"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.6 3c.3 2.2 1.6 3.6 3.9 3.8v3.2c-1.4.1-2.6-.3-3.9-1.1v5.9c0 3.6-2.6 6.2-6 6.2S4.6 18.4 4.6 15c0-3.5 2.9-6 6.4-5.7v3.3c-1.6-.3-3.1.7-3.1 2.4 0 1.5 1.2 2.6 2.7 2.6 1.6 0 2.7-1 2.7-3V3h3.3z"/></svg></a></li>{%- endif -%}
        </ul>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Coach about",
  "tag": "section",
  "class": "section sec__coach2-about",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default-color-scheme" },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "ink", "label": "Heading colour", "default": "#0f1115" },
    { "type": "color", "id": "muted", "label": "Text colour", "default": "#4b5160" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#2b44ff" },
    { "type": "color", "id": "line_color", "label": "Lines", "default": "#e4e6ea" },
    { "type": "image_picker", "id": "image", "label": "Photograph" },
    { "type": "text", "id": "image_alt", "label": "Alt text" },
    { "type": "select", "id": "image_ratio", "label": "Proportions", "options": [ { "value": "1 / 1", "label": "Square" }, { "value": "4 / 5", "label": "Portrait" }, { "value": "4 / 3", "label": "Landscape" } ], "default": "4 / 5" },
    { "type": "select", "id": "image_focus", "label": "Keep in view", "options": [ { "value": "center", "label": "Middle" }, { "value": "center top", "label": "Top" }, { "value": "left center", "label": "Left" }, { "value": "right center", "label": "Right" } ], "default": "center" },
    { "type": "select", "id": "image_position", "label": "Picture side, desktop", "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ], "default": "left" },
    { "type": "checkbox", "id": "main_heading", "label": "This is the page's main heading", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "About" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "A heading about you" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Where you come from and why people work with you.</p>" },
    { "type": "text", "id": "fact_1", "label": "Fact 1", "info": "A label and a value with a colon between, like Based in: Austin.", "default": "Based in: Your city" },
    { "type": "text", "id": "fact_2", "label": "Fact 2", "default": "Works with: Owners of small companies" },
    { "type": "text", "id": "fact_3", "label": "Fact 3" },
    { "type": "text", "id": "fact_4", "label": "Fact 4" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Book a free call" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Where you post", "info": "Leave a place empty to hide it." },
    { "type": "url", "id": "linkedin", "label": "LinkedIn" },
    { "type": "url", "id": "instagram", "label": "Instagram" },
    { "type": "url", "id": "youtube", "label": "YouTube" },
    { "type": "url", "id": "x", "label": "X" },
    { "type": "url", "id": "tiktok", "label": "TikTok" },
    { "type": "range", "id": "heading_size", "label": "Heading size, desktop", "min": 28, "max": 80, "step": 2, "unit": "px", "default": 48 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size, phone", "min": 24, "max": 52, "step": 2, "unit": "px", "default": 34 },
    { "type": "range", "id": "padding_top", "label": "Space above, desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 104 },
    { "type": "range", "id": "padding_bottom", "label": "Space below, desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 104 },
    { "type": "range", "id": "padding_top_mobile", "label": "Space above, phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Space below, phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "presets": [ { "name": "Coach about" } ]
}
{% endschema %}
