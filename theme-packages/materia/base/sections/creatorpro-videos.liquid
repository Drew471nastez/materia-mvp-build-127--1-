{%- comment -%}
  Content creator: the latest videos. A heading with a subscribe button,
  then the first video large on the left and the next ones as a list on
  the right, each a thumbnail with its length, a title and a short line.
  With a YouTube video id the large one plays in place when clicked (the
  player loads only then); without one, every video links out. Stacked on
  a phone.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign color_scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
-%}
<style>
  #shopify-section-{{ sid }} .cpv { background: {{ st.background | default: '#ffffff' }}; padding: {{ st.padding_top_mobile | default: 56 }}px 20px {{ st.padding_bottom_mobile | default: 56 }}px; scroll-margin-top: 80px; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .cpv { padding: {{ st.padding_top | default: 96 }}px 40px {{ st.padding_bottom | default: 96 }}px; } }
  #shopify-section-{{ sid }} .cpv__inner { max-width: 1200px; margin: 0 auto; }
  #shopify-section-{{ sid }} .cpv__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 18px 40px; margin-bottom: 36px; }
  #shopify-section-{{ sid }} .cpv__eyebrow { margin: 0 0 12px; color: {{ st.accent_color | default: '#ff5a36' }}; font-size: 14px; font-weight: 700; }
  #shopify-section-{{ sid }} .cpv__heading { margin: 0; color: var(--color-heading); font-family: var(--heading-font, inherit); font-weight: var(--heading-weight, 700); font-size: {{ st.heading_size_mobile | default: 34 }}px; line-height: 1.05; letter-spacing: -0.03em; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .cpv__heading { font-size: {{ st.heading_size | default: 52 }}px; } }
  #shopify-section-{{ sid }} .cpv__heading em { font-style: normal; color: {{ st.accent_color | default: '#ff5a36' }}; }
  #shopify-section-{{ sid }} .cpv__sub { display: inline-flex; align-items: center; gap: 10px; min-height: 50px; padding: 0 22px; border-radius: {{ st.button_radius | default: 12 }}px; background: {{ st.button_color | default: '#ff0033' }}; color: #fff; font-size: 15px; font-weight: 700; text-decoration: none; transition: filter 0.2s ease; }
  #shopify-section-{{ sid }} .cpv__sub:hover { filter: brightness(1.1); }
  #shopify-section-{{ sid }} .cpv__sub svg { width: 20px; height: 20px; }
  #shopify-section-{{ sid }} .cpv__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 28px; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .cpv__grid { grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr); gap: 40px; } }
  #shopify-section-{{ sid }} .cpv__thumb { position: relative; display: block; overflow: hidden; aspect-ratio: 16 / 9; border-radius: {{ st.radius | default: 18 }}px; background: #1a1b1f; }
  #shopify-section-{{ sid }} .cpv__thumb img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; margin: 0; transition: transform 0.5s ease; }
  #shopify-section-{{ sid }} a:hover .cpv__thumb img, #shopify-section-{{ sid }} .cpv__big:hover img { transform: scale(1.03); }
  #shopify-section-{{ sid }} .cpv__thumb iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  #shopify-section-{{ sid }} .cpv__len { position: absolute; right: 10px; bottom: 10px; padding: 3px 7px; border-radius: 6px; background: rgba(0,0,0,0.78); color: #fff; font-size: 12.5px; font-weight: 600; }
  #shopify-section-{{ sid }} .cpv__play { position: absolute; left: 50%; top: 50%; width: 76px; height: 76px; margin: -38px 0 0 -38px; border-radius: 50%; display: grid; place-items: center; background: rgba(255,255,255,0.94); color: #101114; box-shadow: 0 10px 30px rgba(0,0,0,0.3); transition: transform 0.25s ease; }
  #shopify-section-{{ sid }} .cpv__big:hover .cpv__play { transform: scale(1.06); }
  #shopify-section-{{ sid }} .cpv__play svg { width: 26px; height: 26px; margin-left: 4px; }
  #shopify-section-{{ sid }} .cpv__big { display: block; color: inherit; text-decoration: none; cursor: pointer; }
  #shopify-section-{{ sid }} .cpv__big-title { margin: 18px 0 0; color: var(--color-heading); font-size: 24px; font-weight: 700; line-height: 1.25; letter-spacing: -0.015em; }
  #shopify-section-{{ sid }} .cpv__line { margin: 6px 0 0; color: var(--color-text); font-size: 15.5px; line-height: 1.5; }
  #shopify-section-{{ sid }} .cpv__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 20px; align-content: start; }
  #shopify-section-{{ sid }} .cpv__item { display: grid; grid-template-columns: 44% minmax(0, 1fr); gap: 16px; align-items: center; color: inherit; text-decoration: none; }
  #shopify-section-{{ sid }} .cpv__item .cpv__thumb { border-radius: {{ st.radius | default: 18 }}px; border-radius: calc({{ st.radius | default: 18 }}px * 0.65); }
  #shopify-section-{{ sid }} .cpv__item-title { margin: 0; color: var(--color-heading); font-size: 16.5px; font-weight: 700; line-height: 1.3; }
  #shopify-section-{{ sid }} .cpv__item:hover .cpv__item-title { color: {{ st.accent_color | default: '#ff5a36' }}; }
  #shopify-section-{{ sid }} .cpv__item .cpv__line { font-size: 14px; }
  @media (prefers-reduced-motion: reduce) { #shopify-section-{{ sid }} .cpv__thumb img, #shopify-section-{{ sid }} .cpv__play { transition: none; } }
</style>
<div class="cpv color-{{ color_scheme }}" id="{{ st.anchor | default: 'videos' | handleize }}" data-section-id="{{ sid }}">
  <div class="cpv__inner">
    <div class="cpv__head">
      <div>
        {%- if st.eyebrow != blank -%}<p class="cpv__eyebrow">{{ st.eyebrow | escape }}</p>{%- endif -%}
        {%- if st.heading != blank -%}<h2 class="cpv__heading">{{ st.heading }}</h2>{%- endif -%}
      </div>
      {%- if st.button_label != blank -%}<a class="cpv__sub" href="{{ st.button_link | default: 'https://www.youtube.com' }}" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23 7.2a3 3 0 0 0-2.1-2.1C19 4.6 12 4.6 12 4.6s-7 0-8.9.5A3 3 0 0 0 1 7.2 31 31 0 0 0 .5 12a31 31 0 0 0 .5 4.8 3 3 0 0 0 2.1 2.1c1.9.5 8.9.5 8.9.5s7 0 8.9-.5a3 3 0 0 0 2.1-2.1 31 31 0 0 0 .5-4.8 31 31 0 0 0-.5-4.8zM9.7 15.1V8.9L15.5 12z"/></svg>{{ st.button_label | escape }}</a>{%- endif -%}
    </div>
    <div class="cpv__grid">
      {%- for block in section.blocks limit: 1 -%}
        {%- assign b = block.settings -%}
        <a class="cpv__big" href="{{ b.url | default: st.button_link | default: 'https://www.youtube.com' }}" target="_blank" rel="noopener"{% if b.youtube_id != blank %} data-cpv-id="{{ b.youtube_id | escape }}"{% endif %} {{ block.shopify_attributes }}>
          <span class="cpv__thumb">
            {%- if b.image != blank -%}<img src="{{ b.image | image_url: width: 1200 }}" srcset="{{ b.image | image_url: width: 700 }} 700w, {{ b.image | image_url: width: 1200 }} 1200w" sizes="(min-width: 990px) 680px, 92vw" width="1200" height="675" alt="" loading="lazy" decoding="async">{%- endif -%}
            <span class="cpv__play" aria-hidden="true"><svg viewBox="0 0 20 20" fill="currentColor"><path d="M5 3.5v13l11-6.5z"/></svg></span>
            {%- if b.length != blank -%}<span class="cpv__len">{{ b.length | escape }}</span>{%- endif -%}
          </span>
          <span class="cpv__big-title" style="display:block">{{ b.title | escape }}</span>
          {%- if b.line != blank -%}<span class="cpv__line" style="display:block">{{ b.line | escape }}</span>{%- endif -%}
        </a>
      {%- endfor -%}
      {%- if section.blocks.size > 1 -%}
        <ul class="cpv__list" role="list">
          {%- for block in section.blocks offset: 1 -%}
            {%- assign b = block.settings -%}
            <li {{ block.shopify_attributes }}>
              <a class="cpv__item" href="{{ b.url | default: st.button_link | default: 'https://www.youtube.com' }}" target="_blank" rel="noopener">
                <span class="cpv__thumb">
                  {%- if b.image != blank -%}<img src="{{ b.image | image_url: width: 600 }}" width="600" height="338" alt="" loading="lazy" decoding="async">{%- endif -%}
                  {%- if b.length != blank -%}<span class="cpv__len">{{ b.length | escape }}</span>{%- endif -%}
                </span>
                <span>
                  <span class="cpv__item-title" style="display:block">{{ b.title | escape }}</span>
                  {%- if b.line != blank -%}<span class="cpv__line" style="display:block">{{ b.line | escape }}</span>{%- endif -%}
                </span>
              </a>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</div>
<script>
  (function () {
    var a = document.querySelector('#shopify-section-{{ sid }} [data-cpv-id]');
    if (!a || a.dataset.ready) return; a.dataset.ready = '1';
    a.addEventListener('click', function (e) {
      var id = a.getAttribute('data-cpv-id'); if (!/^[\w-]{6,20}$/.test(id)) return;
      e.preventDefault();
      var box = a.querySelector('.cpv__thumb'); if (!box || box.querySelector('iframe')) return;
      var f = document.createElement('iframe');
      f.src = 'https://www.youtube-nocookie.com/embed/' + id + '?autoplay=1&rel=0';
      f.title = a.querySelector('.cpv__big-title') ? a.querySelector('.cpv__big-title').textContent : 'Video';
      f.allow = 'autoplay; encrypted-media; picture-in-picture'; f.allowFullscreen = true;
      box.appendChild(f);
    });
  })();
</script>
{% schema %}
{
  "name": "Creator videos",
  "tag": "section",
  "class": "section sec__creatorpro-videos",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default-color-scheme" },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#ff5a36" },
    { "type": "range", "id": "radius", "label": "Thumbnail corners", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 18 },
    { "type": "text", "id": "anchor", "label": "Name for links to this section", "default": "videos" },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "On YouTube" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Latest <em>videos</em>" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Subscribe" },
    { "type": "url", "id": "button_link", "label": "Channel link" },
    { "type": "color", "id": "button_color", "label": "Button colour", "default": "#ff0033" },
    { "type": "range", "id": "button_radius", "label": "Button corners", "min": 0, "max": 30, "step": 1, "unit": "px", "default": 12 },
    { "type": "range", "id": "heading_size", "label": "Heading size, desktop", "min": 28, "max": 80, "step": 2, "unit": "px", "default": 52 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size, phone", "min": 24, "max": 52, "step": 2, "unit": "px", "default": 34 },
    { "type": "range", "id": "padding_top", "label": "Space above, desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Space below, desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_top_mobile", "label": "Space above, phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Space below, phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    { "type": "video", "name": "Video", "settings": [
      { "type": "image_picker", "id": "image", "label": "Thumbnail", "info": "16 by 9." },
      { "type": "text", "id": "title", "label": "Title", "default": "Video title" },
      { "type": "text", "id": "line", "label": "Line" },
      { "type": "text", "id": "length", "label": "Length", "default": "12:40" },
      { "type": "url", "id": "url", "label": "Link to the video" },
      { "type": "text", "id": "youtube_id", "label": "YouTube video id", "info": "Optional. The first video then plays in place." }
    ] }
  ],
  "max_blocks": 5,
  "presets": [ { "name": "Creator videos", "blocks": [ { "type": "video" }, { "type": "video" }, { "type": "video" }, { "type": "video" } ] } ]
}
{% endschema %}
