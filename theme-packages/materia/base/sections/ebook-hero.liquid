{%- comment -%}
  Ebook: the first screen of a book's site. On the left a small label, the
  title (italic words take the accent colour), a line on what the book does,
  three short facts, the price with an optional earlier price, a buy button,
  a link to a free chapter and a line on formats. On the right the cover,
  standing on a soft panel. Under the text on a phone. Nothing moves.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign color_scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
  assign facts = st.facts | newline_to_br | split: '<br />'
-%}
{%- assign ebook_hf = settings.font_heading_google_family -%}
{%- if ebook_hf != blank and ebook_hf != 'none' -%}<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ ebook_hf | replace: ' ', '+' }}:ital@1&display=swap">{%- endif -%}
<style>
  #shopify-section-{{ sid }} .ebh {
    --ebh-bg: {{ st.background | default: '#f7f4ee' }};
    --ebh-panel: {{ st.panel_color | default: '#e6ebe2' }};
    --ebh-accent: {{ st.accent_color | default: '#9a6a32' }};
    --ebh-btn: {{ st.button_color | default: '#1f3b33' }};
    --ebh-btn-text: {{ st.button_text_color | default: '#f7f4ee' }};
    background: var(--ebh-bg);
    padding: {{ st.padding_top_mobile | default: 28 }}px 20px {{ st.padding_bottom_mobile | default: 48 }}px;
  }
  @media (min-width: 990px) {
    #shopify-section-{{ sid }} .ebh { padding: {{ st.padding_top | default: 40 }}px 40px {{ st.padding_bottom | default: 80 }}px; }
  }
  #shopify-section-{{ sid }} .ebh__inner {
    max-width: 1200px; margin: 0 auto;
    display: grid; grid-template-columns: minmax(0, 1fr); gap: 36px; align-items: center;
  }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .ebh__inner { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 72px; } }
  #shopify-section-{{ sid }} .ebh__eyebrow { margin: 0 0 18px; color: var(--ebh-accent); font-size: 13px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; }
  #shopify-section-{{ sid }} .ebh__title {
    margin: 0; color: var(--color-heading);
    font-family: var(--heading-font, inherit); font-weight: var(--heading-weight, 500);
    font-size: {{ st.heading_size_mobile | default: 50 }}px; line-height: 1.02; letter-spacing: -0.015em;
  }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .ebh__title { font-size: {{ st.heading_size | default: 84 }}px; } }
  #shopify-section-{{ sid }} .ebh__title em { font-style: italic; color: var(--ebh-accent); }
  #shopify-section-{{ sid }} .ebh__text { margin-top: 22px; max-width: 46ch; color: var(--color-text); font-size: 18px; line-height: 1.6; }
  #shopify-section-{{ sid }} .ebh__text p { margin: 0 0 10px; }
  #shopify-section-{{ sid }} .ebh__facts { list-style: none; margin: 26px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 22px; }
  #shopify-section-{{ sid }} .ebh__facts li { position: relative; color: var(--color-heading); font-size: 14.5px; }
  #shopify-section-{{ sid }} .ebh__facts li + li::before { content: ""; position: absolute; left: -12px; top: 50%; width: 3px; height: 3px; border-radius: 50%; background: currentColor; opacity: 0.5; }
  #shopify-section-{{ sid }} .ebh__buy { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 22px; margin-top: 32px; padding-top: 28px; border-top: 1px solid var(--color-border, #e2ddd2); }
  #shopify-section-{{ sid }} .ebh__price { display: flex; align-items: baseline; gap: 10px; }
  #shopify-section-{{ sid }} .ebh__now { color: var(--color-heading); font-family: var(--heading-font, inherit); font-size: 34px; line-height: 1; font-variant-numeric: lining-nums; }
  #shopify-section-{{ sid }} .ebh__was { color: var(--color-text); font-size: 16px; text-decoration: line-through; opacity: 0.7; }
  #shopify-section-{{ sid }} .ebh__btn {
    display: inline-flex; align-items: center; justify-content: center; min-height: 52px; padding: 0 28px;
    border-radius: {{ st.button_radius | default: 6 }}px; background: var(--ebh-btn); color: var(--ebh-btn-text);
    font-size: 15px; font-weight: 600; text-decoration: none; transition: background-color 0.25s ease, transform 0.25s ease;
  }
  #shopify-section-{{ sid }} .ebh__btn:hover { background: var(--color-heading); transform: translateY(-1px); }
  #shopify-section-{{ sid }} .ebh__link { color: var(--color-heading); font-size: 15px; font-weight: 500; text-decoration: underline; text-underline-offset: 5px; text-decoration-thickness: 1px; }
  #shopify-section-{{ sid }} .ebh__note { margin: 16px 0 0; color: var(--color-text); font-size: 13.5px; }
  @media (max-width: 520px) { #shopify-section-{{ sid }} .ebh__btn { flex: 1 1 100%; } }
  #shopify-section-{{ sid }} .ebh__stage {
    position: relative; margin: 0; border-radius: {{ st.panel_radius | default: 8 }}px; background: var(--ebh-panel);
    aspect-ratio: 1 / 1; display: grid; place-items: center; overflow: hidden;
  }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .ebh__stage { aspect-ratio: 5 / 6; } }
  #shopify-section-{{ sid }} .ebh__stage::after {
    content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 22%;
    background: linear-gradient(to top, rgba(0,0,0,0.035), rgba(0,0,0,0));
  }
  #shopify-section-{{ sid }} .ebh__cover { position: relative; z-index: 1; display: block; width: {{ st.cover_width | default: 78 }}%; height: auto; margin: 0; }
  #shopify-section-{{ sid }} .ebh__tag {
    position: absolute; z-index: 2; top: 20px; right: 20px; padding: 8px 14px; border-radius: 999px;
    background: var(--ebh-bg); color: var(--color-heading); font-size: 13px; font-weight: 600;
  }
  @media (prefers-reduced-motion: reduce) { #shopify-section-{{ sid }} .ebh__btn { transition: none; } #shopify-section-{{ sid }} .ebh__btn:hover { transform: none; } }
</style>

<div class="ebh color-{{ color_scheme }}" data-section-id="{{ sid }}">
  <div class="ebh__inner">
    <div class="ebh__body">
      {%- if st.eyebrow != blank -%}<p class="ebh__eyebrow">{{ st.eyebrow | escape }}</p>{%- endif -%}
      {%- if st.title != blank -%}<h1 class="ebh__title">{{ st.title }}</h1>{%- endif -%}
      {%- if st.text != blank -%}<div class="ebh__text">{{ st.text }}</div>{%- endif -%}
      {%- if st.facts != blank -%}
        <ul class="ebh__facts">{%- for f in facts -%}{%- assign line = f | strip -%}{%- if line != blank -%}<li>{{ line | escape }}</li>{%- endif -%}{%- endfor -%}</ul>
      {%- endif -%}
      <div class="ebh__buy">
        {%- if st.price != blank -%}
          <p class="ebh__price"><span class="ebh__now">{{ st.price | escape }}</span>{%- if st.compare_price != blank -%}<span class="ebh__was">{{ st.compare_price | escape }}</span>{%- endif -%}</p>
        {%- endif -%}
        {%- if st.button_label != blank -%}<a class="ebh__btn" href="{{ st.button_link | default: '/collections/all' }}">{{ st.button_label | escape }}</a>{%- endif -%}
        {%- if st.link_label != blank -%}<a class="ebh__link" href="{{ st.link_url | default: '/collections/all' }}">{{ st.link_label | escape }}</a>{%- endif -%}
      </div>
      {%- if st.note != blank -%}<p class="ebh__note">{{ st.note | escape }}</p>{%- endif -%}
    </div>
    <figure class="ebh__stage">
      {%- if st.tag != blank -%}<span class="ebh__tag">{{ st.tag | escape }}</span>{%- endif -%}
      {%- if st.image != blank -%}
        <img class="ebh__cover" src="{{ st.image | image_url: width: 1000 }}" srcset="{{ st.image | image_url: width: 600 }} 600w, {{ st.image | image_url: width: 1000 }} 1000w" sizes="(min-width: 990px) 460px, 80vw" width="{{ st.image.width | default: 1000 }}" height="{{ st.image.height | default: 1200 }}" alt="{{ st.image_alt | default: st.image.alt | escape }}" loading="eager" fetchpriority="high" decoding="async">
      {%- else -%}
        <svg class="ebh__cover" viewBox="0 0 300 420" role="img" aria-label="Book cover"><rect x="40" y="20" width="220" height="330" rx="4" fill="#1f3b33"/><rect x="40" y="20" width="10" height="330" fill="#173029"/><text x="150" y="210" fill="#f3ede2" font-family="Georgia, serif" font-size="26" text-anchor="middle">Your book</text></svg>
      {%- endif -%}
    </figure>
  </div>
</div>

{% schema %}
{
  "name": "Ebook hero",
  "tag": "section",
  "class": "section sec__ebook-hero",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default-color-scheme" },
    { "type": "color", "id": "background", "label": "Background", "default": "#f7f4ee" },
    { "type": "color", "id": "panel_color", "label": "Panel behind the cover", "default": "#e6ebe2" },
    { "type": "color", "id": "accent_color", "label": "Accent colour", "default": "#9a6a32" },
    { "type": "header", "content": "Book" },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "A new book" },
    { "type": "inline_richtext", "id": "title", "label": "Title", "info": "Put the words you want in italic in italics.", "default": "Your book's <em>title</em>" },
    { "type": "richtext", "id": "text", "label": "What it does for the reader", "default": "<p>One or two lines on what a reader can do after reading it.</p>" },
    { "type": "textarea", "id": "facts", "label": "Short facts, one per line", "default": "200 pages\n10 chapters\nPDF and EPUB" },
    { "type": "header", "content": "Buying" },
    { "type": "text", "id": "price", "label": "Price", "default": "$24" },
    { "type": "text", "id": "compare_price", "label": "Earlier price", "info": "Shown crossed out. Leave empty for none." },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Buy the ebook" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "The book's product page." },
    { "type": "text", "id": "link_label", "label": "Second link", "default": "Read the first chapter" },
    { "type": "url", "id": "link_url", "label": "Second link address" },
    { "type": "color", "id": "button_color", "label": "Button colour", "default": "#1f3b33" },
    { "type": "color", "id": "button_text_color", "label": "Button text colour", "default": "#f7f4ee" },
    { "type": "range", "id": "button_radius", "label": "Button corners", "min": 0, "max": 30, "step": 1, "unit": "px", "default": 6 },
    { "type": "text", "id": "note", "label": "Line under the button", "default": "Sent to your inbox the minute you pay." },
    { "type": "header", "content": "Cover" },
    { "type": "image_picker", "id": "image", "label": "Cover or book picture", "info": "A picture with a transparent background stands on the panel." },
    { "type": "text", "id": "image_alt", "label": "Alt text" },
    { "type": "range", "id": "cover_width", "label": "Cover size", "min": 50, "max": 100, "step": 2, "unit": "%", "default": 78 },
    { "type": "text", "id": "tag", "label": "Label on the panel", "info": "For example: New edition. Leave empty for none." },
    { "type": "range", "id": "panel_radius", "label": "Panel corners", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 8 },
    { "type": "header", "content": "Size and space" },
    { "type": "range", "id": "heading_size", "label": "Title size, desktop", "min": 40, "max": 120, "step": 2, "unit": "px", "default": 84 },
    { "type": "range", "id": "heading_size_mobile", "label": "Title size, phone", "min": 30, "max": 64, "step": 2, "unit": "px", "default": 50 },
    { "type": "range", "id": "padding_top", "label": "Space above, desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Space below, desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_top_mobile", "label": "Space above, phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 28 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Space below, phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "presets": [ { "name": "Ebook hero" } ]
}
{% endschema %}
