                {%- endif -%}
              </span></span>
              <h3 class="cc__name"{% if own and bs.name_weight != blank and bs.name_weight != 'theme' %} data-own-weight{% endif %}>{% if coll != blank %}{{ coll.title | escape }}{% else %}Collection{% endif %}</h3>
            {%- if coll != blank -%}</a>{%- else -%}</div>{%- endif -%}
          </li>
          {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </ul>
