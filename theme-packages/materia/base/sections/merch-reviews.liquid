{%- comment -%}
  Merch template: a centred heading and three short reviews side by side,
  each with its stars, the words and a first name. On a phone they stack.
  The defaults are marked as samples for the shop to replace. Nothing moves.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
-%}
<style>
  #shopify-section-{{ sid }} .mrev { background: {{ st.background | default: '#ffffff' }}; color: {{ st.text_color | default: '#1a1a1a' }}; padding: {{ st.padding_mobile | default: 48 }}px 16px; text-align: center; }
  #shopify-section-{{ sid }} .mrev__head { max-width: 640px; margin: 0 auto 32px; }
  #shopify-section-{{ sid }} .mrev__heading { margin: 0; font-family: var(--heading-font, inherit); font-weight: 800; text-transform: uppercase; letter-spacing: -0.01em; font-size: {{ st.heading_size_mobile | default: 26 }}px; line-height: 1.05; color: {{ st.heading_color | default: '#111111' }}; }
  #shopify-section-{{ sid }} .mrev__sub { margin: 10px 0 0; font-size: 14px; color: {{ st.muted_color | default: '#5c5c5c' }}; }
  #shopify-section-{{ sid }} .mrev__grid { max-width: 1080px; margin: 0 auto; display: grid; grid-template-columns: 1fr; gap: 36px; }
  #shopify-section-{{ sid }} .mrev__item { margin: 0; display: flex; flex-direction: column; align-items: center; gap: 12px; }
  #shopify-section-{{ sid }} .mrev__stars { display: flex; gap: 3px; color: {{ st.star_color | default: '#111111' }}; }
  #shopify-section-{{ sid }} .mrev__stars svg { width: 15px; height: 15px; }
  #shopify-section-{{ sid }} .mrev__stars .is-off { opacity: 0.2; }
  #shopify-section-{{ sid }} .mrev__quote { margin: 0; padding: 0; border: 0; background: none; font-family: var(--body-font, inherit); font-weight: 400; font-style: normal; font-size: 15px; line-height: 1.6; max-width: 34ch; color: inherit; }
  #shopify-section-{{ sid }} .mrev__quote::before, #shopify-section-{{ sid }} .mrev__quote::after { content: none; display: none; }
  #shopify-section-{{ sid }} .mrev__name { margin: 0; font-weight: 700; font-size: 14px; font-style: normal; color: {{ st.heading_color | default: '#111111' }}; }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .mrev { padding: {{ st.padding | default: 80 }}px 32px; }
    #shopify-section-{{ sid }} .mrev__head { margin-bottom: 48px; }
    #shopify-section-{{ sid }} .mrev__heading { font-size: {{ st.heading_size | default: 36 }}px; }
    #shopify-section-{{ sid }} .mrev__grid { grid-template-columns: repeat({{ section.blocks.size | at_least: 1 | at_most: 3 }}, minmax(0, 1fr)); gap: 48px; }
  }
</style>

<div class="mrev">
  <div class="mrev__head">
    {%- if st.heading != blank -%}<h2 class="mrev__heading">{{ st.heading | escape }}</h2>{%- endif -%}
    {%- if st.subheading != blank -%}<p class="mrev__sub">{{ st.subheading | escape }}</p>{%- endif -%}
  </div>
  <div class="mrev__grid">
    {%- for block in section.blocks -%}
      {%- assign b = block.settings -%}
      <figure class="mrev__item" {{ block.shopify_attributes }}>
        <div class="mrev__stars" role="img" aria-label="{{ b.rating }} out of 5">
          {%- for i in (1..5) -%}
            <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"{% if i > b.rating %} class="is-off"{% endif %}><path d="M10 1.5l2.6 5.6 6.1.6-4.6 4.1 1.3 6-5.4-3.1-5.4 3.1 1.3-6L1.3 7.7l6.1-.6z"/></svg>
          {%- endfor -%}
        </div>
        {%- if b.quote != blank -%}<blockquote class="mrev__quote">{{ b.quote | escape }}</blockquote>{%- endif -%}
        {%- if b.name != blank -%}<figcaption class="mrev__name">{{ b.name | escape }}</figcaption>{%- endif -%}
      </figure>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Short reviews",
  "tag": "section",
  "class": "section sec__merch-reviews",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What people say" },
    { "type": "text", "id": "subheading", "label": "Line under the heading", "default": "Sample reviews. Replace them with your own." },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "heading_color", "label": "Heading and names", "default": "#111111" },
    { "type": "color", "id": "text_color", "label": "Reviews", "default": "#1a1a1a" },
    { "type": "color", "id": "muted_color", "label": "Line under the heading", "default": "#5c5c5c" },
    { "type": "color", "id": "star_color", "label": "Stars", "default": "#111111" },
    { "type": "range", "id": "heading_size", "label": "Heading size, desktop", "min": 20, "max": 64, "step": 2, "unit": "px", "default": 36 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size, phone", "min": 18, "max": 40, "step": 2, "unit": "px", "default": 26 },
    { "type": "range", "id": "padding", "label": "Space above and below, desktop", "min": 16, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_mobile", "label": "Space above and below, phone", "min": 16, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "rating", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Review", "default": "Sample review. Put a customer's own words here." },
        { "type": "text", "id": "name", "label": "Name", "default": "Sample name" }
      ]
    }
  ],
  "presets": [
    { "name": "Short reviews", "blocks": [ { "type": "review" }, { "type": "review" }, { "type": "review" } ] }
  ]
}
{% endschema %}
