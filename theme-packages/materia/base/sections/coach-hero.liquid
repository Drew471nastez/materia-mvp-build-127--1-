{%- comment -%}
  Coach: the first screen of a coach's site. A small label, a serif heading
  whose italic words take the accent colour, one or two lines on who the
  coach helps, two buttons and a short note. The portrait sits in an arch on
  the right (below the text on a phone). Nothing moves.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign color_scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
  assign placeholder = 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 800 1000%22%3E%3Crect width=%22800%22 height=%221000%22 fill=%22%23eadfd1%22/%3E%3Ccircle cx=%22400%22 cy=%22380%22 r=%2290%22 fill=%22%23d6c6b2%22/%3E%3Cpath d=%22M220 760c20-130 90-200 180-200s160 70 180 200z%22 fill=%22%23d6c6b2%22/%3E%3C/svg%3E'
-%}
{%- assign coach_hf = settings.font_heading_google_family -%}
{%- if coach_hf != blank and coach_hf != 'none' -%}<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ coach_hf | replace: ' ', '+' }}:ital@1&display=swap">{%- endif -%}
<style>
  #shopify-section-{{ sid }} .coh {
    --coh-bg: {{ st.background | default: '#faf6f0' }};
    --coh-accent: {{ st.accent_color | default: '#a5582a' }};
    --coh-btn: {{ st.button_color | default: '#a5582a' }};
    --coh-btn-text: {{ st.button_text_color | default: '#ffffff' }};
    background: var(--coh-bg);
    padding: {{ st.padding_top_mobile | default: 32 }}px 20px {{ st.padding_bottom_mobile | default: 48 }}px;
  }
  @media (min-width: 990px) {
    #shopify-section-{{ sid }} .coh { padding: {{ st.padding_top | default: 56 }}px 40px {{ st.padding_bottom | default: 88 }}px; }
  }
  #shopify-section-{{ sid }} .coh__inner {
    max-width: 1200px; margin: 0 auto;
    display: grid; grid-template-columns: minmax(0, 1fr); gap: 40px; align-items: center;
  }
  @media (min-width: 990px) {
    #shopify-section-{{ sid }} .coh__inner { grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr); gap: 72px; }
  }
  #shopify-section-{{ sid }} .coh__eyebrow {
    margin: 0 0 22px; color: var(--coh-accent);
    font-size: 12px; font-weight: 500; letter-spacing: 0.2em; text-transform: uppercase;
  }
  #shopify-section-{{ sid }} .coh__heading {
    margin: 0; color: var(--color-heading);
    font-family: var(--heading-font, inherit); font-weight: var(--heading-weight, 500);
    font-size: {{ st.heading_size_mobile | default: 46 }}px; line-height: 1.04; letter-spacing: -0.01em;
    max-width: 13.5ch;
  }
  @media (min-width: 990px) {
    #shopify-section-{{ sid }} .coh__heading { font-size: {{ st.heading_size | default: 76 }}px; }
  }
  #shopify-section-{{ sid }} .coh__heading em { font-style: italic; color: var(--coh-accent); }
  #shopify-section-{{ sid }} .coh__text {
    margin-top: 26px; max-width: 44ch; color: var(--color-text);
    font-size: 17px; line-height: 1.65;
  }
  #shopify-section-{{ sid }} .coh__text p { margin: 0 0 10px; }
  #shopify-section-{{ sid }} .coh__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
  #shopify-section-{{ sid }} .coh__btn {
    display: inline-flex; align-items: center; justify-content: center; min-height: 50px; padding: 0 26px;
    border: 1px solid var(--coh-btn); border-radius: {{ st.button_radius | default: 2 }}px;
    font-size: 12.5px; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; text-decoration: none;
    transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease;
  }
  #shopify-section-{{ sid }} .coh__btn--solid { background: var(--coh-btn); color: var(--coh-btn-text); }
  #shopify-section-{{ sid }} .coh__btn--solid:hover { background: var(--color-heading); border-color: var(--color-heading); }
  #shopify-section-{{ sid }} .coh__btn--line { background: transparent; color: var(--color-heading); border-color: currentColor; }
  #shopify-section-{{ sid }} .coh__btn--line:hover { background: var(--color-heading); color: var(--coh-bg); border-color: var(--color-heading); }
  @media (max-width: 480px) { #shopify-section-{{ sid }} .coh__btn { flex: 1 1 100%; } }
  #shopify-section-{{ sid }} .coh__note { margin: 22px 0 0; font-size: 13.5px; color: var(--color-text); opacity: 0.85; }
  #shopify-section-{{ sid }} .coh__media { margin: 0; justify-self: center; width: 100%; max-width: 460px; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .coh__media { justify-self: end; max-width: 500px; } }
  #shopify-section-{{ sid }} .coh__frame {
    position: relative; overflow: hidden; aspect-ratio: 4 / 5;
    border-radius: {% if st.image_shape == 'rounded' %}24px{% else %}999px 999px 18px 18px{% endif %};
    background: #eadfd1;
  }
  #shopify-section-{{ sid }} .coh__frame img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: {{ st.image_focus | default: '50% 30%' }}; margin: 0; }
</style>

<div class="coh color-{{ color_scheme }}" data-section-id="{{ sid }}">
  <div class="coh__inner">
    <div class="coh__body">
      {%- if st.eyebrow != blank -%}<p class="coh__eyebrow">{{ st.eyebrow | escape }}</p>{%- endif -%}
      {%- if st.heading != blank -%}<h1 class="coh__heading">{{ st.heading }}</h1>{%- endif -%}
      {%- if st.text != blank -%}<div class="coh__text">{{ st.text }}</div>{%- endif -%}
      {%- if st.button_label != blank or st.button2_label != blank -%}
        <div class="coh__actions">
          {%- if st.button_label != blank -%}<a class="coh__btn coh__btn--solid" href="{{ st.button_link | default: '/pages/contact' }}">{{ st.button_label | escape }}</a>{%- endif -%}
          {%- if st.button2_label != blank -%}<a class="coh__btn coh__btn--line" href="{{ st.button2_link | default: '/collections/all' }}">{{ st.button2_label | escape }}</a>{%- endif -%}
        </div>
      {%- endif -%}
      {%- if st.note != blank -%}<p class="coh__note">{{ st.note | escape }}</p>{%- endif -%}
    </div>
    <figure class="coh__media">
      <div class="coh__frame">
        {%- if st.image != blank -%}
          <img src="{{ st.image | image_url: width: 1000 }}" srcset="{{ st.image | image_url: width: 500 }} 500w, {{ st.image | image_url: width: 800 }} 800w, {{ st.image | image_url: width: 1000 }} 1000w" sizes="(min-width: 990px) 500px, 90vw" width="{{ st.image.width | default: 1000 }}" height="{{ st.image.height | default: 1250 }}" alt="{{ st.image_alt | default: st.image.alt | escape }}" loading="eager" fetchpriority="high" decoding="async">
        {%- else -%}
          <img src="{{ placeholder }}" width="800" height="1000" alt="">
        {%- endif -%}
      </div>
    </figure>
  </div>
</div>

{% schema %}
{
  "name": "Coach hero",
  "tag": "section",
  "class": "section sec__coach-hero",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default-color-scheme" },
    { "type": "color", "id": "background", "label": "Background", "default": "#faf6f0" },
    { "type": "color", "id": "accent_color", "label": "Accent colour (label and italic words)", "default": "#a5582a" },
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Life and business coach" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "info": "Put the words you want in italic in italics.", "default": "Make room for the life you <em>want</em>" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Say who you help and what changes for them, in one or two lines.</p>" },
    { "type": "text", "id": "button_label", "label": "First button", "default": "Book a free call" },
    { "type": "url", "id": "button_link", "label": "First button link" },
    { "type": "text", "id": "button2_label", "label": "Second button", "default": "See the sessions" },
    { "type": "url", "id": "button2_link", "label": "Second button link" },
    { "type": "color", "id": "button_color", "label": "Button colour", "default": "#a5582a" },
    { "type": "color", "id": "button_text_color", "label": "Button text colour", "default": "#ffffff" },
    { "type": "range", "id": "button_radius", "label": "Button corners", "min": 0, "max": 30, "step": 1, "unit": "px", "default": 2 },
    { "type": "text", "id": "note", "label": "Small note under the buttons", "default": "In person and online" },
    { "type": "header", "content": "Portrait" },
    { "type": "image_picker", "id": "image", "label": "Picture" },
    { "type": "text", "id": "image_alt", "label": "Alt text" },
    { "type": "select", "id": "image_shape", "label": "Shape", "options": [ { "value": "arch", "label": "Arch" }, { "value": "rounded", "label": "Rounded" } ], "default": "arch" },
    { "type": "text", "id": "image_focus", "label": "Focus point (x% y%)", "default": "50% 30%" },
    { "type": "header", "content": "Size and space" },
    { "type": "range", "id": "heading_size", "label": "Heading size, desktop", "min": 40, "max": 110, "step": 2, "unit": "px", "default": 76 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size, phone", "min": 30, "max": 64, "step": 2, "unit": "px", "default": 46 },
    { "type": "range", "id": "padding_top", "label": "Space above, desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Space below, desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 88 },
    { "type": "range", "id": "padding_top_mobile", "label": "Space above, phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Space below, phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "presets": [ { "name": "Coach hero" } ]
}
{% endschema %}
