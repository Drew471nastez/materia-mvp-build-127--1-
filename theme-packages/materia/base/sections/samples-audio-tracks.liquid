{% schema %}
{
  "name": "Audio tracks",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "header", "content": "Content" },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "list",
      "options": [
        { "value": "list", "label": "List, with covers" },
        { "value": "grid", "label": "Grid of small players" },
        { "value": "feature", "label": "One large player" },
        { "value": "compact", "label": "Compact list" }
      ]
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Hear the packs" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "link_label", "label": "Link label", "info": "List layouts only." },
    { "type": "url", "id": "link_url", "label": "Link" },
    {
      "type": "checkbox",
      "id": "match_product",
      "label": "Only this product's tracks",
      "default": false,
      "info": "On a product page, tracks with no product are left out when the product has tracks of its own."
    },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "columns", "label": "Columns in the grid", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "range", "id": "max_width", "label": "Width", "min": 600, "max": 1400, "step": 20, "unit": "px", "default": 1040 },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 18, "max": 72, "step": 2, "unit": "px", "default": 44 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size on phones", "min": 16, "max": 48, "step": 2, "unit": "px", "default": 30 },
    { "type": "color", "id": "accent", "label": "Playing title colour", "info": "Left empty, the heading colour." },
    { "type": "header", "content": "General" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default" },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "container",
      "options": [
        { "value": "container", "label": "Default" },
        { "value": "fluid_container", "label": "Fluid container" },
        { "value": "stretch_width", "label": "Stretched" },
        { "value": "full_width", "label": "Full width" }
      ]
    },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 }
  ],
  "blocks": [
    {
      "type": "track",
      "name": "Track",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Track title" },
        { "type": "text", "id": "subtitle", "label": "BPM and key", "default": "124 BPM, A minor", "info": "Or a few words on what the loop is." },
        {
          "type": "file_picker",
          "id": "audio",
          "label": "Audio file",
          "accept": ["audio"],
          "info": "An mp3, wav, m4a, ogg, aac or flac file, or an https link. A short preview loads fastest."
        },
        { "type": "text", "id": "length", "label": "Length shown before play", "placeholder": "0:30" },
        {
          "type": "textarea",
          "id": "peaks",
          "label": "Waveform peaks",
          "info": "Optional: 120 numbers from 0 to 100, separated by commas. Left empty, the waveform is read from the file the first time it plays."
        },
        { "type": "image_picker", "id": "cover", "label": "Cover", "info": "List layout only." },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Get the pack" },
        { "type": "url", "id": "link", "label": "Link", "info": "Left empty, the picked product's page." },
        { "type": "product", "id": "product", "label": "Product", "info": "Picked, the track shows on that product's page and on pages without a product." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Audio tracks",
      "settings": { "layout": "list" },
      "blocks": [
        { "type": "track", "settings": { "title": "First track", "subtitle": "124 BPM, A minor" } },
        { "type": "track", "settings": { "title": "Second track", "subtitle": "126 BPM, F minor" } },
