{%- comment -%}
  Materia Themes. Audio tracks (Sample packs template): sound previews a
  visitor plays in the page, one at a time across the whole page.

  Layouts
    List      rows with a cover, the title and its BPM and key, the player
              and a link to the pack.
    Grid      a panel of small players in three columns, the title under
              each wave (a product page's "hear what is inside").
    Feature   one large player, for the top of a product page.
    Compact   short rows without covers.

  The file: each track's "Audio file" is an upload in the editor (mp3, wav,
  m4a, ogg, aac or flac) or a pasted https address. A file of the theme's
  own assets (shopify://shop_images/<name> or a bare name) is how the
  template ships its demos.

  The waveform is the file's own: "Waveform peaks" holds 120 numbers from
  0 to 100 read from the audio ahead of time. Left empty, the row draws a
  flat line and the player reads the peaks from the file the first time
  the track plays, then keeps them in the visitor's browser. Nothing
  downloads before play is pressed: the audio element is made on the
  first press.

  On a product page, a track with a product picked shows only on that
  product's page. "Only this product's tracks" leaves out the tracks with
  no product whenever the product has its own.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign sid = section.id
  assign color_scheme = s.color_scheme.id | default: s.color_scheme | default: 'default'
  assign section_width = s.section_width | default: 'container'
  assign layout = s.layout | default: 'list'
  assign pt = s.padding_top | default: 72
  assign pb = s.padding_bottom | default: 72
  assign own = 0
  assign loose = 0
  for block in section.blocks
    if block.settings.product != blank and product != blank
      if block.settings.product.id == product.id
        assign own = own | plus: 1
      endif
    elsif block.settings.product == blank
      assign loose = loose | plus: 1
    endif
  endfor
  assign strict = false
  if s.match_product and product != blank and own > 0
    assign strict = true
  endif
  assign shown = loose | plus: own
  if strict
    assign shown = own
  endif
  if layout == 'feature' and shown > 1
    assign shown = 1
  endif
  assign cols = s.columns | default: 3
-%}
{%- if shown > 0 or request.design_mode -%}
<style>
  .ssp { --ssp-p: 0%; --ssp-h: 0%; --ssp-sw: 1.6px; --ssp-btn: 36px; --ssp-wave: 36px; --ssp-base: rgba(var(--color-heading-rgb), .24); --ssp-done: rgb(var(--color-heading-rgb)); display: flex; align-items: center; gap: 12px; min-width: 0; }
  .ssp__btn { position: relative; flex: none; width: var(--ssp-btn); height: var(--ssp-btn); margin: 0; padding: 0; border-radius: 50%; border: 1.5px solid rgba(var(--color-heading-rgb), .5); background: transparent; color: var(--color-heading); display: grid; place-items: center; cursor: pointer; transition: background-color .2s ease, border-color .2s ease, color .2s ease, transform .2s ease; -webkit-tap-highlight-color: transparent; }
  .ssp__btn:hover { border-color: rgb(var(--color-heading-rgb)); }
  .ssp__btn:active { transform: scale(.94); }
  .ssp__btn:focus-visible, .ssp__wave:focus-visible { outline: 2px solid var(--ssp-done); outline-offset: 3px; }
  .ssp__btn[disabled] { cursor: default; opacity: .35; transform: none; }
  .ssp__i { grid-area: 1 / 1; width: 42%; height: 42%; display: block; transition: opacity .15s ease, transform .2s ease; }
  .ssp__i--pause { opacity: 0; transform: scale(.6); }
  .ssp.is-playing .ssp__i--play { opacity: 0; transform: scale(.6); }
  .ssp.is-playing .ssp__i--pause { opacity: 1; transform: none; }
  .ssp.is-playing .ssp__btn { background: rgb(var(--color-heading-rgb)); border-color: transparent; color: var(--color-background); }
  .ssp__btn::after { content: ""; position: absolute; inset: -4px; border-radius: 50%; border: 1.5px solid transparent; border-top-color: rgb(var(--color-heading-rgb)); opacity: 0; transition: opacity .2s ease; }
  .ssp.is-loading .ssp__btn::after { opacity: 1; animation: ssp-spin .8s linear infinite; }
  .ssp__wave { position: relative; flex: 1 1 auto; min-width: 0; height: var(--ssp-wave); cursor: pointer; touch-action: pan-y; -webkit-tap-highlight-color: transparent; border-radius: 2px; }
  .ssp--off .ssp__wave { cursor: default; }
  .ssp__svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; fill: none; stroke: var(--ssp-base); stroke-width: var(--ssp-sw); stroke-linecap: round; pointer-events: none; transform-origin: 50% 50%; }
  .ssp__svg--hover { stroke: rgba(var(--color-heading-rgb), .5); clip-path: inset(0 calc(100% - var(--ssp-h)) 0 0); opacity: 0; transition: opacity .15s ease; }
  .ssp__svg--done { stroke: var(--ssp-done); clip-path: inset(0 calc(100% - var(--ssp-p)) 0 0); }
  .ssp:not(.is-started) .ssp__svg--done { visibility: hidden; }
  .ssp--flat .ssp__svg { stroke: rgba(var(--color-heading-rgb), .18); }
  .ssp--off .ssp__svg { stroke: rgba(var(--color-heading-rgb), .1); }
  .ssp--drawn .ssp__svg { animation: ssp-grow .5s cubic-bezier(.2,.7,.2,1) both; }
  .ssp__time { flex: none; min-width: 4.2em; text-align: right; font-size: 13px; line-height: 1; color: var(--color-text); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .ssp.is-started .ssp__time { color: var(--color-heading); }
  @media (hover: hover) and (pointer: fine) {
    .ssp:not(.ssp--off) .ssp__wave:hover .ssp__svg--hover { opacity: 1; }
    .ssp__btn:hover { transform: scale(1.05); }
  }
  @keyframes ssp-spin { to { transform: rotate(360deg); } }
  @keyframes ssp-grow { from { transform: scaleY(.08); } to { transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    .ssp__btn, .ssp__i, .ssp__svg--hover { transition: none; }
    .ssp--drawn .ssp__svg { animation: none; }
    .ssp.is-loading .ssp__btn::after { animation-duration: 2s; }
  }
  #shopify-section-{{ sid }} .sat { padding-block: {{ pt | times: 0.7 | round }}px {{ pb | times: 0.7 | round }}px; }
  #shopify-section-{{ sid }} .sat__inner { max-width: {{ s.max_width | default: 1040 }}px; margin-inline: auto; }
  #shopify-section-{{ sid }} .sat__head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 12px 32px; margin-bottom: 28px; }
  #shopify-section-{{ sid }} .sat__head--center { flex-direction: column; align-items: center; text-align: center; }
  #shopify-section-{{ sid }} .sat__eyebrow { margin: 0 0 10px; font-size: 12px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--color-text); }
  #shopify-section-{{ sid }} .sat__heading { margin: 0; overflow-wrap: anywhere; font-size: {{ s.heading_size_mobile | default: 30 }}px; line-height: 1.1; }
  #shopify-section-{{ sid }} .sat__text { margin: 10px 0 0; max-width: 56ch; color: var(--color-text); font-size: 15px; }
  #shopify-section-{{ sid }} .sat__head--center .sat__text { margin-inline: auto; }
  #shopify-section-{{ sid }} .sat__text > :first-child { margin-top: 0; }
  #shopify-section-{{ sid }} .sat__text > :last-child { margin-bottom: 0; }
  #shopify-section-{{ sid }} .sat__more { font-size: 15px; font-weight: 600; color: var(--color-heading); text-decoration: underline; text-underline-offset: 4px; text-decoration-color: rgba(var(--color-heading-rgb), .35); white-space: nowrap; }
  #shopify-section-{{ sid }} .sat__more:hover { text-decoration-color: currentColor; }
  #shopify-section-{{ sid }} .sat__empty { margin: 0; padding: 20px 0; font-size: 15px; color: var(--color-text); border-block: 1px solid var(--color-border); }
  #shopify-section-{{ sid }} .sat__note { margin: 6px 0 0; font-size: 13px; color: var(--color-text); }
  /* List */
  #shopify-section-{{ sid }} .sat__list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--color-border); }
  #shopify-section-{{ sid }} .sat__row { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; grid-template-areas: "cover meta link" "player player player"; align-items: center; column-gap: 14px; row-gap: 12px; padding: 14px 0; border-bottom: 1px solid var(--color-border); transition: background-color .2s ease; }
  #shopify-section-{{ sid }} .sat__row--nocover { grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: "meta link" "player player"; }
  #shopify-section-{{ sid }} .sat__cover { grid-area: cover; width: 52px; height: 52px; display: block; }
  #shopify-section-{{ sid }} .sat__cover img { width: 100%; height: 100%; object-fit: contain; display: block; }
  #shopify-section-{{ sid }} .sat__meta { grid-area: meta; min-width: 0; }
  #shopify-section-{{ sid }} .sat__title { margin: 0; font-size: 16px; font-weight: 600; line-height: 1.3; color: var(--color-heading); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; transition: color .2s ease; }
  #shopify-section-{{ sid }} .sat__title a { color: inherit; text-decoration: none; }
  #shopify-section-{{ sid }} .sat__title a:hover { text-decoration: underline; text-underline-offset: 3px; }
  #shopify-section-{{ sid }} .sat__sub { margin: 3px 0 0; font-size: 13px; line-height: 1.4; color: var(--color-text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-variant-numeric: tabular-nums; }
  #shopify-section-{{ sid }} .sat__player { grid-area: player; min-width: 0; }
  #shopify-section-{{ sid }} .sat__link { grid-area: link; font-size: 14px; font-weight: 600; color: var(--color-heading); text-decoration: none; white-space: nowrap; padding: 8px 0; }
  #shopify-section-{{ sid }} .sat__link:hover { text-decoration: underline; text-underline-offset: 4px; }
  #shopify-section-{{ sid }} .sat__row:has(.ssp.is-started) .sat__title { color: var(--sat-accent, var(--color-heading)); }
  /* Grid */
  #shopify-section-{{ sid }} .sat__panel { border-radius: 16px; background: rgba(var(--color-heading-rgb), .035); border: 1px solid rgba(var(--color-heading-rgb), .07); padding: 28px 18px 30px; }
  #shopify-section-{{ sid }} .sat__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 22px 40px; }
  #shopify-section-{{ sid }} .sat__cell .ssp { --ssp-btn: 30px; --ssp-wave: 34px; gap: 10px; }
  #shopify-section-{{ sid }} .sat__cell .ssp__btn { border-color: transparent; background: transparent; }
  #shopify-section-{{ sid }} .sat__cell .ssp__i { width: 50%; height: 50%; }
  #shopify-section-{{ sid }} .sat__cell .ssp.is-playing .ssp__btn { background: rgb(var(--color-heading-rgb)); }
  #shopify-section-{{ sid }} .sat__cell .ssp__time { display: none; }
  #shopify-section-{{ sid }} .sat__cap { margin: 6px 0 0 40px; font-size: 13px; line-height: 1.35; color: var(--color-text); text-align: center; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  #shopify-section-{{ sid }} .sat__cap b { font-weight: 600; color: var(--color-heading); }
  /* Feature */
  #shopify-section-{{ sid }} .sat__feature { border-radius: 16px; background: rgba(var(--color-heading-rgb), .035); border: 1px solid rgba(var(--color-heading-rgb), .07); padding: 22px 18px; }
  #shopify-section-{{ sid }} .sat__feature .sat__ftop { display: flex; align-items: baseline; justify-content: space-between; gap: 6px 16px; flex-wrap: wrap; margin-bottom: 14px; }
  #shopify-section-{{ sid }} .sat__feature .sat__title { font-size: 17px; white-space: normal; }
  #shopify-section-{{ sid }} .sat__feature .ssp { --ssp-btn: 52px; --ssp-wave: 84px; gap: 16px; }
  /* Compact */
  #shopify-section-{{ sid }} .sat--compact .sat__row { padding: 10px 0; row-gap: 8px; }
  #shopify-section-{{ sid }} .sat--compact .sat__title { font-size: 15px; }
  #shopify-section-{{ sid }} .sat--compact .ssp { --ssp-btn: 34px; --ssp-wave: 30px; }
  @media (min-width: 750px) {
    #shopify-section-{{ sid }} .sat { padding-block: {{ pt }}px {{ pb }}px; }
    #shopify-section-{{ sid }} .sat__heading { font-size: {{ s.heading_size | default: 44 }}px; }
    #shopify-section-{{ sid }} .sat__head { margin-bottom: 36px; }
    #shopify-section-{{ sid }} .sat__row { grid-template-columns: auto minmax(150px, 250px) minmax(0, 1fr) auto; grid-template-areas: "cover meta player link"; column-gap: 20px; padding: 14px 8px; }
    #shopify-section-{{ sid }} .sat__row--nocover { grid-template-columns: minmax(140px, 240px) minmax(0, 1fr) auto; grid-template-areas: "meta player link"; }
    #shopify-section-{{ sid }} .sat__panel { padding: 40px 44px 44px; }
    #shopify-section-{{ sid }} .sat__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    #shopify-section-{{ sid }} .sat__feature { padding: 30px 34px 32px; }
    #shopify-section-{{ sid }} .sat__feature .ssp { --ssp-btn: 60px; --ssp-wave: 110px; gap: 22px; }
    #shopify-section-{{ sid }} .sat__feature .sat__title { font-size: 19px; }
  }
  @media (min-width: 1000px) {
    #shopify-section-{{ sid }} .sat__grid { grid-template-columns: repeat({{ cols }}, minmax(0, 1fr)); }
  }
  @media (hover: hover) {
    #shopify-section-{{ sid }} .sat__row:hover { background: rgba(var(--color-heading-rgb), .03); }
  }
</style>
<div class="sat sat--{{ layout }} section color-{{ color_scheme }} gradient" data-section-id="{{ sid }}"{% if s.accent != blank %} style="--sat-accent: {{ s.accent }};"{% endif %}>
  <div class="{{ section_width }}">
    <div class="sat__inner">
      {%- capture head -%}
        {%- if s.heading != blank or s.text != blank or s.eyebrow != blank -%}
          <div class="sat__head{% if layout == 'grid' or layout == 'feature' %} sat__head--center{% endif %}">
            <div>
              {%- if s.eyebrow != blank -%}<p class="sat__eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
              {%- if s.heading != blank -%}<h2 class="sat__heading h2">{{ s.heading }}</h2>{%- endif -%}
              {%- if s.text != blank -%}<div class="sat__text rte">{{ s.text }}</div>{%- endif -%}
            </div>
            {%- if s.link_label != blank and s.link_url != blank and layout != 'grid' and layout != 'feature' -%}<a class="sat__more" href="{{ s.link_url }}">{{ s.link_label | escape }}</a>{%- endif -%}
          </div>
        {%- endif -%}
      {%- endcapture -%}
      {%- if layout == 'grid' -%}<div class="sat__panel">{%- endif -%}
      {{ head }}
      {%- if shown > 0 -%}
        {%- if layout == 'grid' -%}<ul class="sat__grid" role="list">{%- elsif layout == 'feature' -%}<div class="sat__feature">{%- else -%}<ul class="sat__list" role="list">{%- endif -%}
        {%- assign drawn = 0 -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign b = block.settings
            if b.product != blank and product != blank and b.product.id != product.id
              continue
            endif
            if strict and b.product == blank
              continue
            endif
            if layout == 'feature' and drawn > 0
              continue
            endif
            assign drawn = drawn | plus: 1
            assign ssp_src = b.audio | strip
            if ssp_src != blank
              if ssp_src contains 'shopify://shop_images/'
                assign ssp_src = ssp_src | remove_first: 'shopify://shop_images/' | asset_url
              elsif ssp_src contains '/'
              else
                assign ssp_src = ssp_src | asset_url
              endif
            endif
            assign ssp_title = b.title | default: 'Untitled track'
            assign ssp_peaks = b.peaks
            assign ssp_len = b.length
            assign ssp_id = 'ssp-' | append: sid | append: '-' | append: block.id
            assign ssp_empty = 'No audio'
            assign link = b.link
            if link == blank and b.product != blank
              assign link = b.product.url
            endif
            assign has_cover = false
            if layout == 'list' and b.cover != blank
              assign has_cover = true
            endif
          -%}
          {%- capture player -%}
{%- liquid
  assign ssp_d = ''
  assign ssp_pk = ssp_peaks | strip | split: ','
  assign ssp_n = ssp_pk.size
  assign ssp_flat = false
  if ssp_n < 16
    assign ssp_n = 120
    assign ssp_flat = true
    for i in (1..120)
      assign ssp_x = i | minus: 0.5
      assign ssp_d = ssp_d | append: 'M' | append: ssp_x | append: ' 48.6V51.4'
    endfor
  else
    for ssp_v in ssp_pk
      assign ssp_hh = ssp_v | strip | plus: 0 | times: 0.46 | at_least: 1.4 | round: 1
      assign ssp_x = forloop.index | minus: 0.5
      assign ssp_y1 = 50 | minus: ssp_hh | round: 1
      assign ssp_y2 = 50 | plus: ssp_hh | round: 1
      assign ssp_d = ssp_d | append: 'M' | append: ssp_x | append: ' ' | append: ssp_y1 | append: 'V' | append: ssp_y2
    endfor
  endif
  assign ssp_label = ssp_title | default: 'track' | escape
-%}
<div class="ssp{% if ssp_src == blank %} ssp--off{% endif %}{% if ssp_flat %} ssp--flat{% endif %}" data-ssp{% if ssp_src != blank %} data-src="{{ ssp_src }}"{% endif %} data-title="{{ ssp_label }}">
  <button class="ssp__btn" type="button" data-ssp-btn aria-label="Play {{ ssp_label }}"{% if ssp_src == blank %} disabled{% endif %}>
    <svg class="ssp__i ssp__i--play" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M5.2 3.1v9.8c0 .5.5.8.9.5l7.5-4.9c.4-.2.4-.8 0-1L6.1 2.6c-.4-.3-.9 0-.9.5Z" fill="currentColor"/></svg>
    <svg class="ssp__i ssp__i--pause" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><rect x="4" y="3" width="2.7" height="10" rx=".8" fill="currentColor"/><rect x="9.3" y="3" width="2.7" height="10" rx=".8" fill="currentColor"/></svg>
  </button>
  <div class="ssp__wave" data-ssp-wave{% if ssp_src != blank %} role="slider" tabindex="0" aria-label="Seek in {{ ssp_label }}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-valuetext="0:00"{% endif %}>
    <svg class="ssp__svg" viewBox="0 0 {{ ssp_n }} 100" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path id="{{ ssp_id }}" d="{{ ssp_d }}" vector-effect="non-scaling-stroke"/></svg>
    <svg class="ssp__svg ssp__svg--hover" viewBox="0 0 {{ ssp_n }} 100" preserveAspectRatio="none" aria-hidden="true" focusable="false"><use href="#{{ ssp_id }}"/></svg>
    <svg class="ssp__svg ssp__svg--done" viewBox="0 0 {{ ssp_n }} 100" preserveAspectRatio="none" aria-hidden="true" focusable="false"><use href="#{{ ssp_id }}"/></svg>
  </div>
  <span class="ssp__time" data-ssp-time>{% if ssp_src == blank %}{{ ssp_empty | default: 'No preview' }}{% else %}{{ ssp_len | default: '0:00' | escape }}{% endif %}</span>
</div>
          {%- endcapture -%}
          {%- if layout == 'grid' -%}
            <li class="sat__cell" {{ block.shopify_attributes }}>
              {{ player }}
              <p class="sat__cap"><b>{{ ssp_title | escape }}</b>{% if b.subtitle != blank %} · {{ b.subtitle | escape }}{% endif %}</p>
            </li>
          {%- elsif layout == 'feature' -%}
            <div class="sat__ftop" {{ block.shopify_attributes }}>
              <p class="sat__title">{% if link != blank %}<a href="{{ link }}">{{ ssp_title | escape }}</a>{% else %}{{ ssp_title | escape }}{% endif %}</p>
              {%- if b.subtitle != blank -%}<p class="sat__sub">{{ b.subtitle | escape }}</p>{%- endif -%}
            </div>
            {{ player }}
          {%- else -%}
            <li class="sat__row{% unless has_cover %} sat__row--nocover{% endunless %}" {{ block.shopify_attributes }}>
              {%- if has_cover -%}
                {%- if link != blank -%}<a class="sat__cover" href="{{ link }}" tabindex="-1" aria-hidden="true">{%- else -%}<span class="sat__cover">{%- endif -%}
                {{ b.cover | image_url: width: 160 | image_tag: loading: 'lazy', width: 52, height: 52, alt: '' }}
                {%- if link != blank -%}</a>{%- else -%}</span>{%- endif -%}
              {%- endif -%}
              <div class="sat__meta">
                <p class="sat__title">{% if link != blank %}<a href="{{ link }}">{{ ssp_title | escape }}</a>{% else %}{{ ssp_title | escape }}{% endif %}</p>
                {%- if b.subtitle != blank -%}<p class="sat__sub">{{ b.subtitle | escape }}</p>{%- endif -%}
              </div>
              <div class="sat__player">{{ player }}</div>
              {%- if layout == 'list' and b.link_label != blank and link != blank -%}
                <a class="sat__link" href="{{ link }}">{{ b.link_label | escape }}</a>
              {%- endif -%}
            </li>
          {%- endif -%}
          {%- if ssp_src == blank and request.design_mode -%}<p class="sat__note">Add an audio file to "{{ ssp_title | escape }}" to make it play.</p>{%- endif -%}
        {%- endfor -%}
        {%- if layout == 'grid' or layout == 'list' or layout == 'compact' -%}</ul>{%- else -%}</div>{%- endif -%}
      {%- elsif request.design_mode -%}
        <p class="sat__empty">Add a track to this section. Each track takes an audio file, a title and a line for its BPM and key.</p>
      {%- endif -%}
      {%- if layout == 'grid' -%}</div>{%- endif -%}
    </div>
  </div>
</div>
<script>
  /* The sample players (samples-audio-tracks, samples-pack-cards, samples-release-hero): one copy runs, whichever section loads first. */
  (function () {
    var V = 3;
    if (window.__ssp && window.__ssp.v >= V) { window.__ssp.scan(); return; }
    var current = null, N = 120, KEY = 'ssp-peaks:', reduce = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
    function fmt(t) { if (!isFinite(t) || t < 0) t = 0; var m = Math.floor(t / 60), s = Math.floor(t % 60); return m + ':' + (s < 10 ? '0' : '') + s; }
    function remember(k, v) { try { localStorage.setItem(KEY + k, v); } catch (e) {} }
    function recall(k) { try { return localStorage.getItem(KEY + k); } catch (e) { return null; } }
    function pathOf(list) { var d = ''; for (var i = 0; i < list.length; i++) { var h = Math.max(1.4, list[i] * 0.46); d += 'M' + (i + 0.5) + ' ' + (50 - h).toFixed(1) + 'V' + (50 + h).toFixed(1); } return d; }
    function draw(el, list) {
      var path = el.querySelector('.ssp__svg path'); if (!path || !list.length) return;
      path.setAttribute('d', pathOf(list));
      el.querySelectorAll('.ssp__svg').forEach(function (s) { s.setAttribute('viewBox', '0 0 ' + list.length + ' 100'); });
      el.classList.remove('ssp--flat'); if (!reduce) el.classList.add('ssp--drawn');
    }
    /* A track saved without its peaks: read them from the file after it starts playing, when the browser has it anyway, and keep them for the next visit. */
    function measure(el) {
      var src = el.getAttribute('data-src'), AC = window.OfflineAudioContext || window.webkitOfflineAudioContext;
      if (!src || el.__measured || !AC || !window.fetch || !el.classList.contains('ssp--flat')) return;
      el.__measured = true;
      (window.requestIdleCallback || function (f) { return setTimeout(f, 400); })(function () {
