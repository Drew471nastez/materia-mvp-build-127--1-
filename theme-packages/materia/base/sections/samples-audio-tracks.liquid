{%- comment -%}
  Materia Themes. Audio tracks (Sample packs template): a list of tracks a
  visitor can play in the page, each with its title, a line under it (BPM
  and key), an optional cover and an optional link to the pack.

  The file: each track's "Audio file" is an upload in the editor (mp3, wav,
  m4a, ogg, aac or flac, stored in the creator's Storelib storage) or a
  pasted https address. A file of the theme's own assets, written as
  shopify://shop_images/<name> or as a bare name, is how the template
  ships its demo loops.

  The player: play and pause, a waveform you can click, drag or move with
  the arrow keys to seek, the time, and one track playing at a time across
  the whole page. Nothing downloads until play is pressed (preload none).
  The waveform is drawn from the track's title, so it is a look, not the
  file's real peaks: reading those would mean downloading every file.

  Layout "Compact" is the product page version: smaller rows, no covers. A
  track with a product chosen shows only on that product's page.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign sid = section.id
  assign color_scheme = s.color_scheme.id | default: s.color_scheme | default: 'default-color-scheme'
  assign section_width = s.section_width | default: 'container'
  assign compact = false
  if s.layout == 'compact'
    assign compact = true
  endif
  assign pt = s.padding_top | default: 72
  assign pb = s.padding_bottom | default: 72
  if compact
    assign pt = s.padding_top | default: 24
    assign pb = s.padding_bottom | default: 24
  endif
  assign shown = 0
  for block in section.blocks
    if block.settings.product != blank and product != blank and block.settings.product.id != product.id
      continue
    endif
    assign shown = shown | plus: 1
  endfor
-%}
<style>
  #shopify-section-{{ sid }} .sat { padding-block: {{ pt | times: 0.65 | round }}px {{ pb | times: 0.65 | round }}px; }
  #shopify-section-{{ sid }} .sat__inner { max-width: {% if compact %}760px{% else %}{{ s.max_width | default: 1040 }}px{% endif %}; margin-inline: {% if compact %}0{% else %}auto{% endif %}; }
  #shopify-section-{{ sid }} .sat__head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 12px 32px; margin-bottom: {% if compact %}14px{% else %}28px{% endif %}; }
  #shopify-section-{{ sid }} .sat__eyebrow { margin: 0 0 10px; font-size: 13px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--btn-primary-bg-color); }
  #shopify-section-{{ sid }} .sat__heading { margin: 0; overflow-wrap: anywhere; {% if compact %}font-size: 18px;{% else %}font-size: {{ s.heading_size_mobile | default: 30 }}px;{% endif %} line-height: 1.1; }
  #shopify-section-{{ sid }} .sat__text { margin: 10px 0 0; max-width: 56ch; color: var(--color-text); font-size: {% if compact %}14px{% else %}16px{% endif %}; }
  #shopify-section-{{ sid }} .sat__text > :first-child { margin-top: 0; }
  #shopify-section-{{ sid }} .sat__text > :last-child { margin-bottom: 0; }
  #shopify-section-{{ sid }} .sat__more { font-size: 15px; font-weight: 600; color: var(--color-heading); text-decoration: underline; text-underline-offset: 4px; text-decoration-color: rgba(var(--color-heading-rgb), .35); white-space: nowrap; }
  #shopify-section-{{ sid }} .sat__more:hover { text-decoration-color: currentColor; }
  #shopify-section-{{ sid }} .sat__list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--color-border); }
  #shopify-section-{{ sid }} .sat__row { --sat-accent: var(--btn-primary-bg-color); display: grid; grid-template-columns: auto auto minmax(0, 1fr) auto; grid-template-areas: "cover play meta link" "wave wave wave wave"; align-items: center; column-gap: 14px; row-gap: 12px; padding: 14px 4px; border-bottom: 1px solid var(--color-border); position: relative; }
  #shopify-section-{{ sid }} .sat__row--nocover { grid-template-columns: auto minmax(0, 1fr) auto; grid-template-areas: "play meta link" "wave wave wave"; }
  #shopify-section-{{ sid }} .sat__cover { grid-area: cover; width: 52px; height: 52px; border-radius: 6px; overflow: hidden; background: rgba(var(--color-heading-rgb), .06); flex: none; }
  #shopify-section-{{ sid }} .sat__cover img { width: 100%; height: 100%; object-fit: cover; display: block; }
  #shopify-section-{{ sid }} .sat__play { grid-area: play; width: 44px; height: 44px; border-radius: 50%; border: 0; padding: 0; display: grid; place-items: center; cursor: pointer; background: var(--sat-accent); color: var(--btn-primary-color); transition: transform .15s ease, opacity .15s ease, background-color .15s ease; flex: none; }
  #shopify-section-{{ sid }} .sat__play:hover { transform: scale(1.06); }
  #shopify-section-{{ sid }} .sat__play:focus-visible, #shopify-section-{{ sid }} .sat__wave:focus-visible { outline: 2px solid var(--sat-accent); outline-offset: 3px; }
  #shopify-section-{{ sid }} .sat__play[disabled] { cursor: default; background: rgba(var(--color-heading-rgb), .12); color: rgba(var(--color-heading-rgb), .45); transform: none; }
  #shopify-section-{{ sid }} .sat__play svg { width: 16px; height: 16px; display: block; }
  #shopify-section-{{ sid }} .sat__play .sat__i-pause, #shopify-section-{{ sid }} .sat__row.is-playing .sat__play .sat__i-play { display: none; }
  #shopify-section-{{ sid }} .sat__row.is-playing .sat__play .sat__i-pause { display: block; }
  #shopify-section-{{ sid }} .sat__row.is-loading .sat__play { opacity: .7; }
  #shopify-section-{{ sid }} .sat__meta { grid-area: meta; min-width: 0; }
  #shopify-section-{{ sid }} .sat__title { margin: 0; font-size: 16px; font-weight: 600; line-height: 1.3; color: var(--color-heading); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  #shopify-section-{{ sid }} .sat__sub { margin: 2px 0 0; font-size: 13px; line-height: 1.4; color: var(--color-text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-variant-numeric: tabular-nums; }
  #shopify-section-{{ sid }} .sat__link { grid-area: link; display: none; font-size: 14px; font-weight: 600; color: var(--color-heading); text-decoration: none; white-space: nowrap; padding: 8px 0; }
  #shopify-section-{{ sid }} .sat__title a { color: inherit; text-decoration: none; }
  #shopify-section-{{ sid }} .sat__title a:hover { text-decoration: underline; text-underline-offset: 3px; }
  #shopify-section-{{ sid }} .sat__link:hover { text-decoration: underline; text-underline-offset: 4px; }
  #shopify-section-{{ sid }} .sat__wavewrap { grid-area: wave; display: flex; align-items: center; gap: 12px; min-width: 0; }
  #shopify-section-{{ sid }} .sat__wave { position: relative; flex: 1 1 auto; min-width: 0; height: {% if compact %}30px{% else %}36px{% endif %}; cursor: pointer; touch-action: none; border-radius: 2px; }
  #shopify-section-{{ sid }} .sat__wave::before { content: ""; position: absolute; left: 0; right: 0; top: 50%; height: 1px; background: rgba(var(--color-heading-rgb), .16); }
  #shopify-section-{{ sid }} .sat__bars { position: absolute; inset: 0; display: flex; align-items: center; gap: 2px; pointer-events: none; }
  #shopify-section-{{ sid }} .sat__bars i { flex: 1 1 0; min-width: 1px; border-radius: 2px; background: rgba(var(--color-heading-rgb), .24); }
  #shopify-section-{{ sid }} .sat__bars--done { clip-path: inset(0 calc(100% - var(--sat-p, 0%)) 0 0); }
  #shopify-section-{{ sid }} .sat__bars--done i { background: var(--sat-accent); }
  #shopify-section-{{ sid }} .sat__row:not(.is-started) .sat__bars--done { visibility: hidden; }
  #shopify-section-{{ sid }} .sat__wave.is-empty { cursor: default; }
  #shopify-section-{{ sid }} .sat__wave.is-empty .sat__bars i { background: rgba(var(--color-heading-rgb), .1); }
  #shopify-section-{{ sid }} .sat__time { flex: none; min-width: 6.5em; text-align: right; font-size: 13px; color: var(--color-text); font-variant-numeric: tabular-nums; }
  #shopify-section-{{ sid }} .sat__note { grid-column: 1 / -1; margin: -4px 0 0; font-size: 13px; color: var(--color-text); }
  #shopify-section-{{ sid }} .sat__empty { margin: 0; padding: 20px 0; font-size: 15px; color: var(--color-text); border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); }
  {%- if compact -%}
  #shopify-section-{{ sid }} .sat__row { padding: 10px 0; column-gap: 12px; row-gap: 8px; }
  #shopify-section-{{ sid }} .sat__play { width: 38px; height: 38px; }
  #shopify-section-{{ sid }} .sat__play svg { width: 14px; height: 14px; }
  #shopify-section-{{ sid }} .sat__title { font-size: 15px; }
  {%- endif -%}
  @media (min-width: 750px) {
    #shopify-section-{{ sid }} .sat { padding-block: {{ pt }}px {{ pb }}px; }
    #shopify-section-{{ sid }} .sat__heading { {% if compact %}font-size: 20px;{% else %}font-size: {{ s.heading_size | default: 44 }}px;{% endif %} }
    #shopify-section-{{ sid }} .sat__row { grid-template-columns: auto auto minmax(140px, 260px) minmax(0, 1fr) auto; grid-template-areas: "cover play meta wave link"; column-gap: 18px; padding: {% if compact %}10px 0{% else %}16px 8px{% endif %}; }
    #shopify-section-{{ sid }} .sat__row--nocover { grid-template-columns: auto minmax(120px, 220px) minmax(0, 1fr) auto; grid-template-areas: "play meta wave link"; }
    #shopify-section-{{ sid }} .sat__link { display: block; padding-left: 8px; }
  }
  @media (hover: hover) {
    #shopify-section-{{ sid }} .sat__row:hover { background: rgba(var(--color-heading-rgb), .035); }
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .sat__play { transition: none; }
    #shopify-section-{{ sid }} .sat__play:hover { transform: none; }
  }
</style>
<div class="sat section color-{{ color_scheme }} gradient{% if compact %} sat--compact{% endif %}" data-sat data-section-id="{{ sid }}">
  <div class="{% if compact %}{{ section_width }}{% else %}{{ section_width }}{% endif %}">
    <div class="sat__inner">
      {%- if s.heading != blank or s.text != blank or s.eyebrow != blank or s.link_label != blank -%}
        <div class="sat__head">
          <div>
            {%- if s.eyebrow != blank -%}<p class="sat__eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
            {%- if s.heading != blank -%}<h2 class="sat__heading h2">{{ s.heading }}</h2>{%- endif -%}
            {%- if s.text != blank -%}<div class="sat__text rte">{{ s.text }}</div>{%- endif -%}
          </div>
          {%- if s.link_label != blank and s.link_url != blank -%}<a class="sat__more" href="{{ s.link_url }}">{{ s.link_label | escape }}</a>{%- endif -%}
        </div>
      {%- endif -%}
      {%- if shown > 0 -%}
        <ul class="sat__list" role="list">
          {%- for block in section.blocks -%}
            {%- liquid
              if block.settings.product != blank and product != blank and block.settings.product.id != product.id
                continue
              endif
              assign b = block.settings
              assign src = b.audio | strip
              if src != blank
                if src contains 'shopify://shop_images/'
                  assign src = src | remove_first: 'shopify://shop_images/' | asset_url
                elsif src contains '/'
                else
                  assign src = src | asset_url
                endif
              endif
              assign title = b.title | default: 'Untitled track'
              assign has_cover = false
              if compact == false and b.cover != blank
                assign has_cover = true
              endif
            -%}
            <li class="sat__row{% unless has_cover %} sat__row--nocover{% endunless %}" data-sat-row data-seed="{{ title | escape }}" {{ block.shopify_attributes }}>
              {%- if has_cover -%}
                <div class="sat__cover">{{ b.cover | image_url: width: 160 | image_tag: loading: 'lazy', width: 52, height: 52, alt: '' }}</div>
              {%- endif -%}
              <button class="sat__play" type="button" data-sat-play aria-label="Play {{ title | escape }}"{% if src == blank %} disabled{% endif %}>
                <svg class="sat__i-play" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M4.5 2.6v10.8c0 .5.5.8.9.5l8.3-5.4c.4-.2.4-.8 0-1L5.4 2.1c-.4-.3-.9 0-.9.5Z" fill="currentColor"/></svg>
                <svg class="sat__i-pause" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><rect x="3.5" y="2.5" width="3" height="11" rx="1" fill="currentColor"/><rect x="9.5" y="2.5" width="3" height="11" rx="1" fill="currentColor"/></svg>
              </button>
              <div class="sat__meta">
                <p class="sat__title">{% if b.link != blank %}<a href="{{ b.link }}">{{ title | escape }}</a>{% else %}{{ title | escape }}{% endif %}</p>
                {%- if b.subtitle != blank -%}<p class="sat__sub">{{ b.subtitle | escape }}</p>{%- endif -%}
              </div>
              <div class="sat__wavewrap">
                <div class="sat__wave{% if src == blank %} is-empty{% endif %}" data-sat-wave{% if src != blank %} role="slider" tabindex="0" aria-label="Seek {{ title | escape }}" aria-valuemin="0" aria-valuemax="0" aria-valuenow="0" aria-valuetext="0:00"{% endif %}>
                  <div class="sat__bars" aria-hidden="true"></div>
                  <div class="sat__bars sat__bars--done" aria-hidden="true"></div>
                </div>
                <span class="sat__time" data-sat-time aria-hidden="true">{% if src == blank %}No audio{% else %}{{ b.length | default: '0:00' | escape }}{% endif %}</span>
              </div>
              {%- if compact == false and b.link_label != blank and b.link != blank -%}
                <a class="sat__link" href="{{ b.link }}" tabindex="-1" aria-hidden="true">{{ b.link_label | escape }}</a>
              {%- endif -%}
              {%- if src != blank -%}
                <audio preload="none" src="{{ src }}" data-sat-audio></audio>
              {%- elsif request.design_mode -%}
                <p class="sat__note">Add an audio file to this track to make it play.</p>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- elsif request.design_mode -%}
        <p class="sat__empty">Add a track to this section. Each track takes an audio file, a title and a line for its BPM and key.</p>
      {%- endif -%}
    </div>
  </div>
</div>
<script>
  (function () {
    if (window.__samplesAudio) { window.__samplesAudio.scan(); return; }
    var current = null;
    function fmt(t) { if (!isFinite(t) || t < 0) t = 0; var m = Math.floor(t / 60), s = Math.floor(t % 60); return m + ':' + (s < 10 ? '0' : '') + s; }
    function seeded(str) { var h = 2166136261; for (var i = 0; i < str.length; i++) { h ^= str.charCodeAt(i); h = Math.imul(h, 16777619); } return function () { h += 0x6D2B79F5; var t = h; t = Math.imul(t ^ (t >>> 15), t | 1); t ^= t + Math.imul(t ^ (t >>> 7), t | 61); return ((t ^ (t >>> 14)) >>> 0) / 4294967296; }; }
    function bars(row) {
      var wave = row.querySelector('[data-sat-wave]'); if (!wave) return;
      var n = Math.max(24, Math.min(96, Math.round(wave.clientWidth / 5))) || 64;
      var rnd = seeded(row.getAttribute('data-seed') || ''), html = '';
      var beat = 4 + Math.floor(rnd() * 3);
      for (var i = 0; i < n; i++) {
        var x = i / n, shape = 0.55 + 0.35 * Math.sin(x * Math.PI * (1.2 + rnd() * 0.2)) + (i % beat === 0 ? 0.25 : 0);
        var h = Math.max(0.12, Math.min(1, shape * (0.45 + rnd() * 0.6)));
        html += '<i style="height:' + Math.round(h * 100) + '%"></i>';
      }
      row.querySelectorAll('.sat__bars').forEach(function (b) { b.innerHTML = html; });
    }
    function setup(row) {
      if (row.__sat) return; row.__sat = true;
      bars(row);
      var audio = row.querySelector('[data-sat-audio]'), btn = row.querySelector('[data-sat-play]'), wave = row.querySelector('[data-sat-wave]'), time = row.querySelector('[data-sat-time]');
      if (!audio || !btn || !wave) return;
      var title = row.querySelector('.sat__title'), name = title ? title.textContent : '';
      var raf = 0, dragging = false;
      function paint() {
        var d = audio.duration, t = audio.currentTime, p = d > 0 ? Math.min(100, (t / d) * 100) : 0;
        wave.style.setProperty('--sat-p', p + '%');
        if (d > 0) { time.textContent = fmt(t) + ' / ' + fmt(d); wave.setAttribute('aria-valuemax', Math.round(d)); }
        wave.setAttribute('aria-valuenow', Math.round(t));
        wave.setAttribute('aria-valuetext', fmt(t) + (d > 0 ? ' of ' + fmt(d) : ''));
      }
      function loop() { paint(); if (!audio.paused) raf = requestAnimationFrame(loop); }
      function play() {
        if (current && current !== audio) current.pause();
        current = audio; row.classList.add('is-started');
        var p = audio.play(); if (p && p.catch) p.catch(function () { row.classList.remove('is-loading'); });
      }
      btn.addEventListener('click', function () { if (audio.paused) play(); else audio.pause(); });
      audio.addEventListener('play', function () { row.classList.add('is-playing', 'is-started'); btn.setAttribute('aria-label', 'Pause ' + name); cancelAnimationFrame(raf); loop(); });
      audio.addEventListener('waiting', function () { row.classList.add('is-loading'); });
      audio.addEventListener('playing', function () { row.classList.remove('is-loading'); });
      audio.addEventListener('pause', function () { row.classList.remove('is-playing', 'is-loading'); btn.setAttribute('aria-label', 'Play ' + name); cancelAnimationFrame(raf); paint(); });
      audio.addEventListener('ended', function () { audio.currentTime = 0; paint(); });
      audio.addEventListener('loadedmetadata', paint);
      audio.addEventListener('error', function () { row.classList.remove('is-playing', 'is-loading'); time.textContent = 'Could not play'; btn.disabled = true; });
      function seekTo(clientX) {
        var r = wave.getBoundingClientRect(), x = Math.max(0, Math.min(1, (clientX - r.left) / r.width));
        if (audio.readyState < 1) { audio.addEventListener('loadedmetadata', function once() { audio.removeEventListener('loadedmetadata', once); audio.currentTime = x * audio.duration; paint(); }); play(); return; }
        audio.currentTime = x * (audio.duration || 0); row.classList.add('is-started'); paint();
      }
      wave.addEventListener('pointerdown', function (e) { dragging = true; try { wave.setPointerCapture(e.pointerId); } catch (_) {} seekTo(e.clientX); });
      wave.addEventListener('pointermove', function (e) { if (dragging && audio.readyState >= 1) seekTo(e.clientX); });
      wave.addEventListener('pointerup', function () { dragging = false; });
      wave.addEventListener('pointercancel', function () { dragging = false; });
      wave.addEventListener('keydown', function (e) {
        var d = audio.duration || 0, t = audio.currentTime, step = 5;
        if (e.key === 'ArrowRight' || e.key === 'ArrowUp') t += step;
        else if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') t -= step;
        else if (e.key === 'Home') t = 0;
        else if (e.key === 'End') t = d;
        else if (e.key === ' ' || e.key === 'Enter') { e.preventDefault(); btn.click(); return; }
        else return;
        e.preventDefault();
        if (audio.readyState < 1) { play(); return; }
        audio.currentTime = Math.max(0, Math.min(d, t)); row.classList.add('is-started'); paint();
      });
    }
    function scan() { document.querySelectorAll('[data-sat] [data-sat-row]').forEach(setup); }
    window.__samplesAudio = { scan: scan };
    document.addEventListener('play', function (e) { if (e.target && e.target.hasAttribute && e.target.hasAttribute('data-sat-audio') && current && current !== e.target) current.pause(); }, true);
    document.addEventListener('shopify:section:load', scan);
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', scan); else scan();
  })();
</script>
{% schema %}
{
  "name": "Audio tracks",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "list",
      "options": [
        { "value": "list", "label": "List, with covers" },
        { "value": "compact", "label": "Compact, for a product page" }
      ],
      "info": "Compact rows leave out covers and pack links. On a product page, a track with a product chosen shows only on that product."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Hear the packs"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "List width",
      "min": 600,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 1040
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 18,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size on phones",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 30
    },
    {
      "type": "header",
      "content": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "container",
      "options": [
        { "value": "container", "label": "Default" },
        { "value": "fluid_container", "label": "Fluid container" },
        { "value": "stretch_width", "label": "Stretched" },
        { "value": "full_width", "label": "Full width" }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "track",
      "name": "Track",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Track title"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Line under the title",
          "default": "124 BPM, A minor",
          "info": "BPM and key, or what the loop is."
        },
        {
          "type": "file_picker",
          "id": "audio",
          "label": "Audio file",
          "accept": ["audio"],
          "info": "Upload an mp3, wav, m4a, ogg, aac or flac file, or paste an https link. Short previews load fastest."
        },
        {
          "type": "text",
          "id": "length",
          "label": "Length shown before play",
          "placeholder": "0:30",
          "info": "Nothing downloads until play is pressed, so the real length appears then."
        },
        {
          "type": "image_picker",
          "id": "cover",
          "label": "Cover"
        },
