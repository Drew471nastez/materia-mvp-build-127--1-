{%- comment -%}
Video sales letter: the opening. A small label, a two part heading (words
  between asterisks in italic serif), a short line, a button, and the video
  in a rounded frame with a second frame stacked behind it.

  The video is the creator's own: a file uploaded in the editor, or a YouTube
  or Vimeo link. Until the play button is pressed only the poster picture is
  loaded: no video file, no player script, nothing from YouTube or Vimeo.
  Pressing it puts the player in the frame and starts it with sound.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
-%}
{%- liquid
  assign kind = ''
  assign src = ''
  assign vid = ''
  if st.video != blank
    assign kind = 'file'
    assign src = st.video.sources[0].url
    for s in st.video.sources
      if s.mime_type == 'video/mp4'
        assign src = s.url
        break
      endif
    endfor
  elsif st.video_url != blank
    assign kind = st.video_url.type
    assign vid = st.video_url.id
  endif
  assign poster = st.poster
  if poster == blank and st.video != blank
    assign poster = st.video.preview_image
  endif
-%}
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap" data-vsl-font>
<style>
  .vsl { position: relative; color: var(--vsl-text, #a3a3a8); font-family: var(--body-font, inherit); -webkit-font-smoothing: antialiased; }
  .vsl *, .vsl *::before, .vsl *::after { box-sizing: border-box; }
  .vsl__inner { position: relative; max-width: var(--vsl-max, 1120px); margin: 0 auto; padding: 0 20px; }
  .vsl__head { text-align: center; margin: 0 auto 44px; max-width: 760px; }
  .vsl__eyebrow { display: flex; align-items: center; justify-content: center; gap: 14px; margin: 0 0 18px; font-size: 11px; font-weight: 500; letter-spacing: .24em; text-transform: uppercase; color: rgba(255,255,255,.6); }
  .vsl__eyebrow::before, .vsl__eyebrow::after { content: ""; flex: 0 0 34px; height: 1px; background: linear-gradient(90deg, rgba(255,255,255,0), rgba(255,255,255,.5)); }
  .vsl__eyebrow::after { background: linear-gradient(270deg, rgba(255,255,255,0), rgba(255,255,255,.5)); }
  .vsl__title { margin: 0; color: var(--vsl-head, #fff); font-family: var(--body-font, inherit); font-weight: 700; font-size: clamp(32px, 4.6vw, 52px); line-height: 1.06; letter-spacing: -.035em; text-wrap: balance; }
  .vsl__title em, .vsl em.vsl-serif { font-family: 'Instrument Serif', Georgia, 'Times New Roman', serif; font-style: italic; font-weight: 400; letter-spacing: -.01em; }
  .vsl__lede { margin: 16px auto 0; max-width: 580px; font-size: 15px; line-height: 1.65; }
  .vsl__lede p { margin: 0; }
  .vsl-btn {
    position: relative; isolation: isolate; overflow: hidden;
    display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 48px; padding: 0 24px;
    border-radius: 999px; border: 1px solid rgba(255,255,255,.24); background: rgba(10,10,12,.85); color: #fff;
    font-family: var(--body-font, inherit); font-size: 14px; font-weight: 600; letter-spacing: -.005em; text-decoration: none; white-space: nowrap;
    box-shadow: inset 0 1px 0 rgba(255,255,255,.22), 0 0 0 4px rgba(255,255,255,.03), 0 14px 40px -14px rgba(255,255,255,.35);
    transition: transform .35s cubic-bezier(.2,.7,.2,1), border-color .35s, box-shadow .35s;
  }
  .vsl-btn::before { content: ""; position: absolute; z-index: -1; top: -1px; left: -40%; width: 40%; height: 2px; background: linear-gradient(90deg, transparent, #fff, transparent); opacity: .9; transition: transform 1.1s cubic-bezier(.2,.7,.2,1); }
  .vsl-btn:hover { transform: translateY(-1px); border-color: rgba(255,255,255,.5); box-shadow: inset 0 1px 0 rgba(255,255,255,.3), 0 0 0 4px rgba(255,255,255,.05), 0 18px 50px -14px rgba(255,255,255,.45); }
  .vsl-btn:hover::before { transform: translateX(350%); }
  .vsl-btn:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
  .vsl-btn svg { width: 16px; height: 16px; flex: none; transition: transform .35s cubic-bezier(.2,.7,.2,1); }
  .vsl-btn:hover svg { transform: translateX(3px); }
  .vsl-btn--light { background: #fff; color: #0a0a0a; border-color: #fff; box-shadow: 0 14px 40px -14px rgba(255,255,255,.5); }
  .vsl-btn--light::before { display: none; }
  .vsl-btn--ghost { background: transparent; box-shadow: none; border-color: rgba(255,255,255,.16); }
  .vsl__actions { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 12px; margin-top: 30px; }
  .vsl-card {
    position: relative; border-radius: 18px; border: 1px solid rgba(255,255,255,.09);
    background: linear-gradient(180deg, rgba(255,255,255,.06), rgba(255,255,255,.015) 60%), rgba(12,12,14,.72);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.07), 0 30px 60px -40px rgba(0,0,0,.9);
  }
  .vsl--line { padding-top: 1px; }
  .vsl--line::before { content: ""; position: absolute; left: 50%; top: 0; width: min(1120px, calc(100% - 40px)); height: 1px; transform: translateX(-50%); background: linear-gradient(90deg, rgba(255,255,255,0), rgba(255,255,255,.26) 50%, rgba(255,255,255,0)); }
  .vsl--line::after { content: ""; position: absolute; left: 50%; top: 0; width: min(900px, 90%); height: 180px; transform: translateX(-50%); pointer-events: none; background: radial-gradient(50% 100% at 50% 0, rgba(255,255,255,.07), rgba(255,255,255,0)); }
  @media (max-width: 749px) { .vsl__eyebrow { letter-spacing: .18em; gap: 10px; } .vsl__eyebrow::before, .vsl__eyebrow::after { flex-basis: 22px; } .vsl__head { margin-bottom: 32px; } }
  html.vsl-js .vsl [data-motion] { opacity: 0; transform: translate3d(0, 22px, 0); transition: opacity .9s cubic-bezier(.2,.65,.2,1), transform .9s cubic-bezier(.2,.65,.2,1); transition-delay: var(--d, 0ms); }
  html.vsl-js .vsl [data-motion].is-in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    html.vsl-js .vsl [data-motion] { opacity: 1; transform: none; transition: none; }
    .vsl-btn, .vsl-btn::before, .vsl-btn svg { transition: none; }
  }

  #shopify-section-{{ sid }} .vsl { padding-top: {{ st.padding_top_mobile | default: 40 }}px; padding-bottom: {{ st.padding_bottom_mobile | default: 56 }}px; }
  @media (min-width: 750px) { #shopify-section-{{ sid }} .vsl { padding-top: {{ st.padding_top | default: 64 }}px; padding-bottom: {{ st.padding_bottom | default: 88 }}px; } }
  .vsl-hero .vsl__head { margin-bottom: 0; max-width: 860px; }
  .vsl-hero .vsl__title { font-size: clamp(36px, 6vw, 68px); line-height: 1.02; }
  .vsl-hero .vsl__lede { font-size: 16px; max-width: 620px; }
  .vsl-hero__badge { display: inline-flex; align-items: center; gap: 10px; margin: 0 0 22px; padding: 6px 14px 6px 8px; border-radius: 999px; border: 1px solid rgba(255,255,255,.1); background: rgba(255,255,255,.03); font-size: 11px; letter-spacing: .18em; text-transform: uppercase; color: rgba(255,255,255,.7); }
  @media (max-width: 749px) { .vsl-hero__badge { font-size: 10px; letter-spacing: .1em; } .vsl-logos__label { letter-spacing: .16em; } }
  .vsl-hero__dot { position: relative; width: 8px; height: 8px; border-radius: 50%; background: #fff; box-shadow: 0 0 10px #fff; }
  .vsl-hero__dot::after { content: ""; position: absolute; inset: -4px; border-radius: 50%; border: 1px solid rgba(255,255,255,.6); animation: vsl-ping 2.4s cubic-bezier(.2,.7,.2,1) infinite; }
  @keyframes vsl-ping { 0% { transform: scale(.6); opacity: 1; } 80%, 100% { transform: scale(1.8); opacity: 0; } }
  .vsl-hero__in > * { animation: vsl-rise 1s cubic-bezier(.2,.65,.2,1) both; }
  .vsl-hero__in > :nth-child(2) { animation-delay: .08s; }
  .vsl-hero__in > :nth-child(3) { animation-delay: .16s; }
  .vsl-hero__in > :nth-child(4) { animation-delay: .24s; }
  .vsl-hero__in > :nth-child(5) { animation-delay: .32s; }
  @keyframes vsl-rise { from { opacity: 0; transform: translate3d(0, 18px, 0); } to { opacity: 1; transform: none; } }
  #shopify-section-{{ sid }} .vsl-video { position: relative; max-width: {{ st.video_width | default: 1000 }}px; margin: 64px auto 0; padding-top: 34px; animation: vsl-frame 1.3s cubic-bezier(.2,.65,.2,1) .3s both; }
  @keyframes vsl-frame { from { opacity: 0; transform: translate3d(0, 40px, 0) scale(.96); } to { opacity: 1; transform: none; } }
  .vsl-video__back {
    position: absolute; left: 7%; right: 7%; top: 0; height: 60%; border-radius: 18px 18px 0 0; overflow: hidden;
    border: 1px solid rgba(255,255,255,.12); border-bottom: 0; background: #0b0b0c center 20% / cover no-repeat;
    opacity: .55; -webkit-mask-image: linear-gradient(180deg, #000 30%, transparent 75%); mask-image: linear-gradient(180deg, #000 30%, transparent 75%);
  }
  .vsl-video__frame {
    position: relative; aspect-ratio: 16 / 9; border-radius: 20px; overflow: hidden; background: #0b0b0c;
    border: 1px solid rgba(255,255,255,.16);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.18), 0 0 0 6px rgba(255,255,255,.025), 0 50px 120px -50px rgba(255,255,255,.22);
  }
  #shopify-section-{{ sid }} .vsl-video__poster { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 1.2s cubic-bezier(.2,.65,.2,1), opacity .5s; {% if st.poster_grey %}filter: grayscale(1);{% endif %} }
  .vsl-video__frame::after { content: ""; position: absolute; inset: 0; pointer-events: none; background: radial-gradient(120% 90% at 50% 40%, rgba(0,0,0,0) 40%, rgba(0,0,0,.55)); transition: opacity .5s; }
  .vsl-video__play {
    position: absolute; z-index: 2; left: 50%; top: 50%; width: 76px; height: 76px; margin: -38px 0 0 -38px; padding: 0; cursor: pointer;
    display: grid; place-items: center; border-radius: 50%; border: 1px solid rgba(255,255,255,.35); color: #fff;
    background: rgba(20,20,22,.45); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.35), 0 20px 50px -10px rgba(0,0,0,.6);
    transition: transform .45s cubic-bezier(.2,.7,.2,1), background-color .3s;
  }
  .vsl-video__play::before { content: ""; position: absolute; inset: -10px; border-radius: 50%; border: 1px solid rgba(255,255,255,.25); animation: vsl-ping 2.8s cubic-bezier(.2,.7,.2,1) infinite; }
  .vsl-video__play svg { width: 24px; height: 24px; margin-left: 4px; }
  .vsl-video__frame:hover .vsl-video__play { transform: scale(1.08); background: rgba(255,255,255,.16); }
  .vsl-video__frame:hover .vsl-video__poster { transform: scale(1.02); }
  .vsl-video__play:focus-visible { outline: 2px solid #fff; outline-offset: 4px; }
  .vsl-video__len { position: absolute; z-index: 2; left: 18px; bottom: 16px; padding: 5px 10px; border-radius: 999px; background: rgba(0,0,0,.55); border: 1px solid rgba(255,255,255,.14); color: #fff; font-size: 12px; font-variant-numeric: tabular-nums; letter-spacing: .04em; }
  .vsl-video__media { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; background: #000; z-index: 3; animation: vsl-fade .5s ease both; }
  @keyframes vsl-fade { from { opacity: 0; } to { opacity: 1; } }
  .vsl-video.is-playing .vsl-video__play, .vsl-video.is-playing .vsl-video__len { opacity: 0; pointer-events: none; }
  .vsl-video__empty { position: absolute; z-index: 4; left: 50%; bottom: 18px; transform: translateX(-50%); width: max-content; max-width: calc(100% - 32px); margin: 0; padding: 9px 14px; border-radius: 12px; background: rgba(0,0,0,.72); border: 1px solid rgba(255,255,255,.14); color: #fff; font-size: 13px; line-height: 1.4; text-align: center; animation: vsl-fade .4s ease both; }
  .vsl-video__empty[hidden] { display: none; }
  @media (max-width: 749px) {
    .vsl-video { margin-top: 40px; padding-top: 20px; }
    .vsl-video__frame { border-radius: 14px; }
    .vsl-video__back { border-radius: 14px 14px 0 0; left: 6%; right: 6%; }
    .vsl-video__play { width: 60px; height: 60px; margin: -30px 0 0 -30px; }
    .vsl-video__play svg { width: 20px; height: 20px; }
    .vsl-video__len { left: 12px; bottom: 10px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .vsl-hero__in > *, .vsl-video, .vsl-video__media, .vsl-video__empty { animation: none; }
    .vsl-video__play::before, .vsl-hero__dot::after { animation: none; display: none; }
    .vsl-video__poster, .vsl-video__play { transition: none; }
  }
</style>
<div data-own-font class="vsl{% if st.line_above %} vsl--line{% endif %} vsl-hero">
  <div class="vsl__inner">
    <div class="vsl__head vsl-hero__in">
      {%- if st.badge != blank -%}<p class="vsl-hero__badge"><span class="vsl-hero__dot" aria-hidden="true"></span>{{ st.badge | escape }}</p>{%- endif -%}
      {%- if st.heading != blank -%}<h1 class="vsl__title">{%- assign vsl_parts = st.heading | escape | split: '*' -%}{%- for vsl_part in vsl_parts -%}{%- assign vsl_odd = forloop.index0 | modulo: 2 -%}{%- if vsl_odd == 1 -%}<em>{{ vsl_part | replace: '|', '<br>' }}</em>{%- else -%}{{ vsl_part | replace: '|', '<br>' }}{%- endif -%}{%- endfor -%}</h1>{%- endif -%}
      {%- if st.text != blank -%}<div class="vsl__lede">{{ st.text }}</div>{%- endif -%}
      {%- if st.button_label != blank or st.button2_label != blank -%}
        <div class="vsl__actions">
          {%- if st.button_label != blank -%}<a class="vsl-btn" href="{{ st.button_link | default: '#' }}">{{ st.button_label | escape }}<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 8h10M9 4l4 4-4 4"/></svg></a>{%- endif -%}
          {%- if st.button2_label != blank -%}<a class="vsl-btn vsl-btn--ghost" href="{{ st.button2_link | default: '#' }}">{{ st.button2_label | escape }}</a>{%- endif -%}
        </div>
      {%- endif -%}
    </div>
    {%- if st.show_video -%}
      <div class="vsl-video" data-vsl-video data-kind="{{ kind }}" data-src="{{ src | escape }}" data-id="{{ vid | escape }}" data-title="{{ st.video_title | default: st.heading | remove: '*' | remove: '|' | escape }}">
        <div class="vsl-video__back" aria-hidden="true"{% if poster != blank %} style="background-image: url('{{ poster | image_url: width: 1200 }}');{% if st.poster_grey %} filter: grayscale(1);{% endif %}"{% endif %}></div>
        <div class="vsl-video__frame">
          {%- if poster != blank -%}
            {{ poster | image_url: width: 1800 | image_tag: class: 'vsl-video__poster', widths: '600, 900, 1200, 1500, 1800', sizes: '(min-width: 1080px) 1000px, 94vw', loading: 'eager', fetchpriority: 'high', alt: st.poster_alt }}
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'vsl-video__poster' }}
          {%- endif -%}
          <button class="vsl-video__play" type="button" aria-label="{{ st.play_label | default: 'Play the video' | escape }}"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 4.5v15l12.5-7.5z" fill="currentColor"/></svg></button>
          {%- if st.length_label != blank -%}<span class="vsl-video__len">{{ st.length_label | escape }}</span>{%- endif -%}
          <p class="vsl-video__empty" hidden role="status">{{ st.empty_text | default: 'The video plays here once it is added.' | escape }}</p>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;
    var still = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!('IntersectionObserver' in window) || still) return;
    document.documentElement.classList.add('vsl-js');
    if (!window.__vslSeen) {
      window.__vslSeen = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('is-in'); window.__vslSeen.unobserve(e.target); } });
      }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
    }
    root.querySelectorAll('[data-motion]:not(.is-in)').forEach(function (el) { window.__vslSeen.observe(el); });
  })();
</script>
<script>
  (function () {
    var box = document.querySelector('#shopify-section-{{ section.id }} [data-vsl-video]');
    if (!box || box.hasAttribute('data-ready')) return;
    box.setAttribute('data-ready', '');
    var frame = box.querySelector('.vsl-video__frame');
    var play = box.querySelector('.vsl-video__play');
    var note = box.querySelector('.vsl-video__empty');
    var kind = box.getAttribute('data-kind');
    var id = box.getAttribute('data-id');
    var src = box.getAttribute('data-src');
    var title = box.getAttribute('data-title') || '';
    function start() {
      if (box.classList.contains('is-playing')) return;
      var el = null;
      if (kind === 'file' && src) {
        el = document.createElement('video');
        el.src = src; el.controls = true; el.autoplay = true; el.playsInline = true;
        el.setAttribute('playsinline', ''); el.setAttribute('preload', 'auto');
        if (title) el.setAttribute('aria-label', title);
      } else if ((kind === 'youtube' || kind === 'vimeo') && id) {
        el = document.createElement('iframe');
        el.src = kind === 'youtube'
          ? 'https://www.youtube-nocookie.com/embed/' + encodeURIComponent(id) + '?autoplay=1&rel=0&playsinline=1&modestbranding=1'
          : 'https://player.vimeo.com/video/' + encodeURIComponent(id) + '?autoplay=1&dnt=1&title=0&byline=0&portrait=0';
        el.setAttribute('allow', 'autoplay; fullscreen; picture-in-picture; encrypted-media');
        el.setAttribute('allowfullscreen', '');
        el.title = title || 'Video';
      }
      if (!el) {
        if (note) { note.hidden = false; clearTimeout(box.__t); box.__t = setTimeout(function () { note.hidden = true; }, 4000); }
        return;
      }
      el.className = 'vsl-video__media';
      frame.appendChild(el);
      box.classList.add('is-playing');
      if (el.play) { var p = el.play(); if (p && p.catch) p.catch(function () {}); }
    }
    play.addEventListener('click', start);
  })();
</script>

{% schema %}
{
  "name": "Video sales letter",
  "tag": "section",
  "class": "vsl-hero-section",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Small label",
      "default": "Six week course, live calls"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Turn what you know into a *workshop people pay for*",
      "info": "Words between asterisks are set in italic serif, like *this*. A | starts a new line."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Say who it is for and what they leave with, in one or two lines.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Book a free call"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "default": "/pages/book-a-call"
    },
    {
      "type": "text",
      "id": "button2_label",
      "label": "Second button label"
    },
    {
      "type": "url",
      "id": "button2_link",
      "label": "Second button link"
    },
    {
      "type": "header",
      "content": "Video"
    },
    {
      "type": "checkbox",
      "id": "show_video",
      "label": "Show the video",
      "default": true
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video file",
      "info": "Upload a video, or paste a YouTube or Vimeo link below. Nothing is downloaded until a visitor presses play."
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "YouTube or Vimeo link",
      "accept": [
        "youtube",
        "vimeo"
      ],
      "info": "Used when no file is uploaded."
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "Poster picture",
      "info": "Shown before play. 16:9 works best."
    },
    {
      "type": "text",
      "id": "poster_alt",
      "label": "Poster description",
      "default": ""
    },
    {
      "type": "checkbox",
      "id": "poster_grey",
      "label": "Black and white poster",
      "default": true
    },
    {
      "type": "text",
      "id": "length_label",
      "label": "Length label",
      "default": "12 min"
    },
    {
      "type": "text",
      "id": "video_title",
      "label": "Video title for screen readers"
    },
    {
      "type": "text",
      "id": "play_label",
      "label": "Play button label for screen readers",
      "default": "Play the video"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Message when no video is added yet",
      "default": "The video plays here once it is added."
    },
    {
      "type": "range",
      "id": "video_width",
      "label": "Video width",
      "min": 640,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 1000
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "checkbox",
      "id": "line_above",
      "label": "Thin glowing line above",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Space above, desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Space below, desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Space above, phone",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 40
    },
