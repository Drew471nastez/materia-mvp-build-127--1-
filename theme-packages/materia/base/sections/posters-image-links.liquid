{%- comment -%}
  Poster shop: pictures that link somewhere, each with a label. Round (a
  category row), or tall tiles with the label over the picture (rooms).
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign sid = section.id
  assign shape = s.shape | default: 'circle'
  assign cols = s.columns_desktop | default: 4
  assign cols_m = s.columns_mobile | default: 2
  assign label_color = s.label_color | default: '#1f1f1f'
-%}
<style>
  .pil-{{ sid }} { padding: {{ s.padding_top | default: 48 }}px 0 {{ s.padding_bottom | default: 48 }}px; {% if s.background != blank and s.background != 'rgba(0,0,0,0)' %}background: {{ s.background }};{% endif %} }
  .pil-{{ sid }} .pil__inner { max-width: {{ s.max_width | default: 1240 }}px; margin: 0 auto; padding: 0 32px; }
  .pil-{{ sid }} .pil__heading { margin: 0 0 28px; font-size: {{ s.heading_size | default: 22 }}px; text-transform: uppercase; letter-spacing: .02em; color: {{ s.heading_color | default: '#1f1f1f' }}; text-align: {{ s.heading_alignment | default: 'left' }}; }
  .pil-{{ sid }} .pil__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat({{ cols }}, minmax(0, 1fr)); gap: {{ s.gap | default: 24 }}px; }
  .pil-{{ sid }} .pil__link { display: block; color: {{ label_color }}; text-decoration: none; position: relative; }
  .pil-{{ sid }} .pil__media { position: relative; overflow: hidden; background: {{ s.image_background | default: '#f1ece3' }}; }
  .pil-{{ sid }} .pil__media img, .pil-{{ sid }} .pil__media svg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .6s cubic-bezier(.2,.7,.2,1); }
  .pil-{{ sid }} .pil__link:hover .pil__media img { transform: scale(1.04); }
  .pil-{{ sid }}.pil--circle .pil__media { aspect-ratio: 1 / 1; border-radius: 50%; max-width: {{ s.circle_size | default: 240 }}px; margin: 0 auto; {% if s.ring_color != blank and s.ring_color != 'rgba(0,0,0,0)' %}box-shadow: 0 0 0 {{ s.ring_width | default: 0 }}px {{ s.ring_color }};{% endif %} }
  .pil-{{ sid }}.pil--circle .pil__label { display: block; margin-top: 16px; text-align: center; font-size: {{ s.label_size | default: 15 }}px; font-weight: 600; }
  .pil-{{ sid }}.pil--tall .pil__media { aspect-ratio: 4 / 5; border-radius: {{ s.radius | default: 0 }}px; }
  .pil-{{ sid }}.pil--square .pil__media { aspect-ratio: 1 / 1; border-radius: {{ s.radius | default: 0 }}px; }
  .pil-{{ sid }}.pil--tall .pil__label, .pil-{{ sid }}.pil--square .pil__label {
    position: absolute; left: 16px; bottom: 16px; z-index: 1; max-width: calc(100% - 32px);
    padding: 7px 14px; border-radius: 999px; background: {{ s.label_background | default: '#fffdf8' }};
    color: {{ s.overlay_label_color | default: '#24211f' }}; font-size: {{ s.label_size | default: 15 }}px; font-weight: 700; line-height: 1.2;
    text-transform: uppercase; letter-spacing: .04em;
  }
  @media (max-width: 989px) { .pil-{{ sid }} .pil__list { grid-template-columns: repeat({% if cols > 3 %}{{ cols | minus: 1 }}{% else %}{{ cols }}{% endif %}, minmax(0, 1fr)); } }
  @media (max-width: 749px) {
    .pil-{{ sid }} { padding: {{ s.padding_top | default: 48 | times: 0.6 | round }}px 0 {{ s.padding_bottom | default: 48 | times: 0.6 | round }}px; }
    .pil-{{ sid }} .pil__inner { padding: 0 20px; }
    .pil-{{ sid }} .pil__list { grid-template-columns: repeat({{ cols_m }}, minmax(0, 1fr)); gap: 14px; }
    .pil-{{ sid }}.pil--circle .pil__label { font-size: 13px; margin-top: 10px; }
    .pil-{{ sid }} .pil__heading { font-size: {{ s.heading_size | default: 22 | times: 0.8 | round }}px; margin-bottom: 18px; }
  }
  @media (prefers-reduced-motion: reduce) { .pil-{{ sid }} .pil__media img { transition: none; } .pil-{{ sid }} .pil__link:hover .pil__media img { transform: none; } }
</style>
<div class="pil pil-{{ sid }} pil--{{ shape }}">
  <div class="pil__inner">
    {%- if s.heading != blank -%}<h2 class="pil__heading">{{ s.heading | escape }}</h2>{%- endif -%}
    <ul class="pil__list" role="list">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>
          <a class="pil__link" href="{{ block.settings.link | default: routes.all_products_collection_url }}">
            <div class="pil__media">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 900 | image_tag: widths: '300, 450, 600, 900', sizes: '(min-width: 990px) 25vw, 50vw', loading: 'lazy', alt: block.settings.label }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag }}
              {%- endif -%}
            </div>
            {%- if block.settings.label != blank -%}<span class="pil__label">{{ block.settings.label | escape }}</span>{%- endif -%}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Picture links",
  "tag": "section",
  "class": "posters-image-links-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "select",
      "id": "shape",
      "label": "Shape",
      "default": "circle",
      "options": [
        { "value": "circle", "label": "Round, label below" },
        { "value": "tall", "label": "Tall, label on the picture" },
        { "value": "square", "label": "Square, label on the picture" }
      ]
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": ""
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" }
      ]
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 14,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on a computer",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns on a phone",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Space between",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "circle_size",
      "label": "Largest circle",
      "min": 80,
      "max": 360,
      "step": 10,
      "unit": "px",
      "default": 240
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Corner radius of tiles",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "label_size",
      "label": "Label size",
      "min": 11,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#1f1f1f"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Label below a circle",
      "default": "#1f1f1f"
    },
    {
      "type": "color",
      "id": "overlay_label_color",
      "label": "Label on a picture",
      "default": "#24211f"
    },
    {
      "type": "color",
      "id": "label_background",
      "label": "Behind a label on a picture",
      "default": "#fffdf8"
    },
    {
      "type": "color",
      "id": "image_background",
      "label": "Behind the picture",
      "default": "#f1ece3"
    },
    {
      "type": "color",
      "id": "ring_color",
      "label": "Ring around circles",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "range",
      "id": "ring_width",
      "label": "Ring width",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Content width",
      "min": 800,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1240
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Space above",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Space below",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Picture",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Picture"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Category"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Picture links",
      "category": "Poster shop",
      "blocks": [
        { "type": "link", "settings": { "label": "Flowers" } },
        { "type": "link", "settings": { "label": "Retro" } },
        { "type": "link", "settings": { "label": "Fruit" } },
        { "type": "link", "settings": { "label": "New in" } }
      ]
    }
  ]
}
{% endschema %}
