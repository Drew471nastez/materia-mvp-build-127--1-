{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default'
-%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
</style>
{%- if section.settings.reset_spacing -%}
  <style>
    #shopify-section-{{ section.id }} { margin-top: 0 !important; margin-bottom: 0 !important; padding-top: 0 !important; padding-bottom: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
  </style>
{%- endif -%}
<style>
  #shopify-section-{{ section.id }} { font-weight: var(--body-weight, inherit); isolation: isolate; position: relative; }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) { font-weight: var(--heading-weight, inherit); }
</style>

{%- liquid
  # The collection title on the image is a real theme button: its colours,
  # shape, font and hover effect all come from Theme settings > Buttons and
  # the colour scheme (Title button style picks which button).
  case section.settings.title_button_style
    when 'outline'
      assign mlc_title_button = 'btn-outline'
    when 'white'
      assign mlc_title_button = 'btn-white'
    else
      assign mlc_title_button = 'btn-primary'
  endcase
-%}
<style>
  /* A title wraps between words, never inside one ("Activewea r" on a phone):
     the button keeps whole words and hyphenates only a word wider than it. */
  #shopify-section-{{ section.id }} .collection-item__name,
  #shopify-section-{{ section.id }} .collection-item__name-inner {
    word-break: normal !important;
    overflow-wrap: normal !important;
    hyphens: auto;
  }
  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} .collection-item__name { --mb-padding-x: 12px; }
  }
</style>

{%- comment -%}
  Materia Themes. Developed By Materia Themes.
{%- endcomment -%}
{{ 'section-collection.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign section_st = section.settings
  assign section_width = section_st.section_width
  assign sort_collections = section_st.sort_collections
  assign type = section_st.type
  assign items_to_show = section_st.items_to_show
  assign items_per_row = section_st.items_per_row
  assign column_gap = section_st.column_gap
  assign pagination = section_st.pagination
  assign design = section_st.design
  assign collection_information_position = 'overlay_image'
  assign scroll_animation = settings.scroll_animation
  comment
    Picked collections that no longer exist (deleted, or never made in this
    store) draw nothing on the live page; with none left the page lists every
    collection, so it never shows empty placeholder cards.
  endcomment
  assign picked_count = 0
  for block in section.blocks
    if block.settings.collection != blank
      assign picked_count = picked_count | plus: 1
    endif
  endfor
  if type == 'selected' and picked_count == 0 and request.design_mode == false
    assign type = 'all'
  endif
-%}
{%- capture style -%}
  --section-pt: {{ section_st.padding_top }}; --section-pb: {{ section_st.padding_bottom }};
{%- endcapture -%}
{%- capture col_style -%}
--col-desktop: {{ items_per_row }};--col-number:2;{% if items_per_row > 3 %}--col-tablet: 3;--col-desktop-small: 3;{% else %}--col-tablet: {{ items_per_row }};{% endif %}
{% if column_gap < 15 %}--col-gap: {{ column_gap }}px;{% else %}--col-gap: 15px;--col-gap-desktop: {{  column_gap }}px;{% endif %};--btn-padding-x: 2rem;
{%- endcapture -%}
<div
  class="section{% if section_st.padding_top < 30 %} pt-min{% endif %}{% if section_st.padding_bottom < 30 %} pb-min{% endif %} sec__collections-list color-{{ color_scheme }} gradient"
  style="{{ style | strip | strip_newlines }}"
  data-lcp="main-list-collections"
  data-lcp-id="{{ section.id }}"{% if request.design_mode %}
  data-lcp-settings="{{ section.settings | json | escape }}"{% endif %}
>
  <div class="{{ section_width }}">
    <div
      class="collection-list grid col-{{ items_per_row }} {{ settings.hover_effect }}"
    >
      {%- if type == 'all' -%}
        {%- liquid
          case sort_collections
            when 'products_high', 'products_low'
              assign collections = collections | sort: 'all_products_count'
            when 'date', 'date_reversed'
              assign collections = collections | sort: 'published_at'
          endcase
          if sort_collections == 'products_high' or sort_collections == 'date_reversed' or sort_collections == 'alphabetical_reversed'
            assign collections = collections | reverse
          endif
        -%}
        {%- liquid
          comment
            Every product ("all") is not a collection the shop made, so it is
            not listed and not counted.
          endcomment
          assign listed_count = 0
          for c in collections
            unless c.handle == 'all'
              assign listed_count = listed_count | plus: 1
            endunless
          endfor
        -%}
        {%- if listed_count == 0 -%}
          {%- comment -%} A shop with no collections yet: said plainly, with the way to every product. {%- endcomment -%}
          <div class="collection-list-empty text-center" data-lcp-empty style="padding:24px 0 8px;max-width:46ch;margin-inline:auto;">
            <h2 class="h4" style="margin:0 0 8px;">{{ section_st.empty_heading | default: 'No collections yet' | escape }}</h2>
            <p style="margin:0 0 20px;color:var(--color-text);">{{ section_st.empty_text | default: 'Collections show here once the shop has some. Every product is on one page for now.' | escape }}</p>
            <a class="button inline-block btn-primary" data-theme-button="primary" href="{{ routes.all_products_collection_url }}">{{ section_st.empty_button_label | default: 'See all products' | escape }}</a>
          </div>
        {%- endif -%}
        {%- paginate collections by items_to_show -%}
          <grid-list
            {% if scroll_animation != 'slide_in' %}
              hold
            {% endif %}
          >
            <div
              class="collection-list-grid grid grid-cols gap{% if pagination == 'load_more_button' or pagination == 'infinit_scrolling' %} loadmore-lists{% endif %}"
              style="{{ col_style | strip | strip_newlines }}"
            >
              {% for collection in collections %}
                {%- if collection.handle == 'all' -%}{%- continue -%}{%- endif -%}
                <div class="collection-items relative align-self-start{% if pagination == 'load_more_button' or pagination == 'infinit_scrolling' %} loadmore-item{% endif %}">
                  <motion-element
                    data-motion="fade-up-lg"
                    hold
                    data-motion-delay="{{ forloop.index0 | times: 50 }}"
                    class="collection-item grid-custom-item {% if scroll_animation != 'none' and scroll_animation != null %} scroll-trigger {{ scroll_animation }} {% endif %} {{ settings.hover_effect }}"
                    {%- if scroll_animation != 'none' -%}
                      style="--animation-order: {{  forloop.index }};"
                    {%- endif -%}
                  >
                    {% render 'collection-item', index: forloop.index,
                      card_collection: collection,
                      section: section,
                      design: design,
                      title_button: mlc_title_button,
                      collection_information_position: collection_information_position
                    %}
                  </motion-element>
                </div>
              {% endfor %}
            </div>
          </grid-list>
          {% render 'pagination',
            section_st: section_st,
            pagination: pagination,
            number_page: items_to_show,
            paginate: paginate
          %}
        {%- endpaginate -%}
      {%- else -%}
        <grid-list
          {% if scroll_animation != 'slide_in' %}
            hold
          {% endif %}
        >
          <div
            class="collection-list-grid grid grid-cols gap"
            style="{{ col_style | strip | strip_newlines }}"
          >
            {%- assign load = false -%}
            {%- assign shown = 0 -%}
            {% for block in section.blocks %}
              {%- liquid
                assign block_st = block.settings
                if block_st.collection == blank and request.design_mode == false
                  continue
                endif
                assign shown = shown | plus: 1
                assign class = ' grid-custom-item'
                if shown > items_to_show
                  assign class = ' grid-custom-item hidden trigger_slidein'
                  assign load = true
                endif
              -%}
              <motion-element
                data-motion="fade-up-lg"
                hold
                data-motion-delay="{{ forloop.index0 | times: 50 }}"
                class="collection-item {{ class }} {% if scroll_animation != 'none' and scroll_animation != null %} scroll-trigger {{ scroll_animation }}  {% endif %} {{ settings.hover_effect }}"
                {%- if scroll_animation != 'none' -%}
                  style="--animation-order: {{  forloop.index }};"
                {%- endif -%}
              >
                {% render 'collection-item', index: forloop.index,
                  card_collection: block_st.collection,
                  section: section,
                  block: block,
                  design: design,
                  title_button: mlc_title_button,
                  collection_information_position: collection_information_position
                %}
              </motion-element>
            {% endfor %}
          </div>
        </grid-list>
        {%- if load -%}
          {%- if pagination == 'load_more_button' or pagination == 'infinit_scrolling' -%}
            <loadmore-button {% if scroll_animation != 'slide_in' %}hold{% endif %} class="block collection-infinite-scroll text-center mt-60">
              <a class="button inline-block btn-primary" data-theme-button="primary" data-sl-button aria-label="{{ section_st.button_show_more }}" role="link">
                <span class="hidden-on-load">{{ section_st.button_show_more }}</span>
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="spin opacity-0 icon-load">
                  <use href="#icon-load"></use>
                </svg>
              </a>
            </loadmore-button>
          {%- endif -%}
        {%- endif -%}
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Collections list page",
  "class": "section s-tt",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "default"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "stretch_width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "text",
      "id": "empty_heading",
      "label": "Heading when there are no collections",
      "default": "No collections yet"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Text when there are no collections",
      "default": "Collections show here once the shop has some. Every product is on one page for now."
    },
    {
      "type": "text",
      "id": "empty_button_label",
      "label": "Button when there are no collections",
      "default": "See all products"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "select",
      "id": "type",
      "label": "Collections to show",
      "default": "all",
      "options": [
        {
          "value": "all",
          "label": "All"
        },
        {
          "value": "selected",
          "label": "Picked"
        }
      ],
      "info": "Picked shows the collection blocks, in their order."
    },
    {
      "type": "select",
      "id": "sort_collections",
      "label": "Sort by",
      "default": "alphabetical",
      "options": [
        {
          "value": "alphabetical",
          "label": "Alphabetically, A–Z"
        },
        {
          "value": "alphabetical_reversed",
          "label": "Alphabetically, Z–A"
        },
        {
          "value": "date_reversed",
          "label": "Date, newest first"
        },
        {
          "value": "date",
          "label": "Date, oldest first"
        },
        {
          "value": "products_high",
          "label": "Most products"
        },
        {
          "value": "products_low",
          "label": "Fewest products"
        }
      ],
      "visible_if": "{{ section.settings.type == 'all' }}"
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "label": "Show product count",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "items_per_row",
      "label": "Collections per row",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "items_to_show",
      "label": "Collections per page",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Gap between collections",
      "min": 0,
      "max": 50,
      "step": 2,
      "default": 30,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Name alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "design",
      "label": "Card style",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "morden",
          "label": "Modern"
        }
      ]
    },
    {
      "type": "select",
      "id": "title_button_style",
      "label": "Title button style",
      "default": "primary",
      "info": "For the Default design. Colours, shape, font and hover come from Theme settings > Buttons and the colour scheme.",
      "options": [
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "outline",
          "label": "Outline"
        },
        {
          "value": "white",
          "label": "White"
        }
      ]
    },
    {
      "type": "select",
      "id": "pagination",
      "label": "Pagination",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Page numbers"
        },
        {
          "value": "load_more_button",
          "label": "Load-more button"
        },
        {
          "value": "infinit_scrolling",
          "label": "Infinite scroll"
        }
      ]
    },
    {
      "type": "text",
      "id": "button_show_more",
      "label": "Load more button text",
      "default": "Load more",
      "visible_if": "{{ section.settings.pagination != 'default' }}"
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Picture shape",
      "default": "adapt",
      "options": [
        {
          "value": "adapt",
          "label": "Original"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "landscape",
          "label": "Landscape"
        }
      ]
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Name size",
      "min": 12,
      "max": 24,
      "step": 1,
      "default": 16,
      "unit": "px",
      "visible_if": "{{ section.settings.design == 'morden' }}",
      "info": "The Default card style takes the theme button size."
    },
    {
      "type": "header",
      "content": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "default": 40,
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "default": 60,
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "collection_title",
          "label": "Name",
          "info": "Empty shows the collection's own name.",
          "visible_if": "{{ section.settings.type == 'selected' }}"
        },
        {
          "type": "header",
          "content": "Media"
        },
        {
          "type": "image_picker",
          "id": "collection_image",
          "label": "Picture",
          "info": "Empty uses the collection's own picture.",
          "visible_if": "{{ section.settings.type == 'selected' }}"
        }
      ]
    }
  ]
}
{% endschema %}