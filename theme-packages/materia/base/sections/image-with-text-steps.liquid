{%- if request.design_mode -%}<script src="{{ 'media-live-stats-reels.js' | asset_url }}" defer="defer"></script>{%- endif -%}
{% render 'theme-type' %}
{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme | default: 'default'
-%}
{%- assign fb_accessibility_step_title = 'accessibility.step_title' | t -%}
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' -%}
<style>
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
</style>
<script>
  (function(){
    var el = document.getElementById('shopify-section-{{ section.id }}');
    if (!el || el.classList.contains('scroll-trigger')) return;
    el.classList.add('scroll-trigger', {{ settings.scroll_animation | json }});
  })();
</script>
{%- endif -%}
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    #shopify-section-{{ section.id }} { margin-top: 0 !important; margin-bottom: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}
</style>
{%- comment -%}
  Materia Themes. Image With Text Steps.

  Image on one side, a vertical list of steps (blocks) on the other. "Marker
  style" picks the step marker: dot, outlined dot, numbered, outlined number,
  "01" prefix, or each step's own icon. Colours follow the colour scheme and
  the button follows Theme settings > Buttons until "Enable custom styling" or
  "Use theme button style" says otherwise. Every value is a CSS variable on
  the section root, so shopify/assets/media-live-stats-reels.js applies
  builder edits in place.
{%- endcomment -%}

{%- liquid
  assign s   = section.settings
  assign sid = section.id

  assign reset_spacing = ''
  if s.reset_spacing
    assign reset_spacing = ' remove_spacing'
  endif

  assign step_blocks    = section.blocks | where: 'type', 'step'
  assign button_blocks  = section.blocks | where: 'type', 'button'

  assign step_style = s.step_style | default: 'dot'
  assign custom = s.custom_colors
  capture placeholder_src
    render 'placeholder-image', type: 'collection-2', scheme: color_scheme, ratio: '4/3', format: 'url'
  endcapture
  assign placeholder_src = placeholder_src | strip

  case s.section_width
    when 'fluid_container'
      assign max_w = 'var(--fluid-container-width, 1500px)'
    when 'stretch_width'
      assign max_w = 'none'
    when 'full_width'
      assign max_w = 'none'
    else
      assign max_w = 'var(--theme-page-width, var(--page-width, 1300px))'
  endcase

  assign steps_custom_btn = true
  if s.use_theme_button
    assign steps_custom_btn = false
  endif
  assign btn_bg = ''
  assign btn_text = ''
  assign btn_hover = ''
  if custom
    assign btn_bg = s.button_bg
    assign btn_text = s.button_color
    assign btn_hover = s.button_bg_hover
  endif
-%}
{%- capture st_style -%}
--st-max: {{ max_w }}; --st-pt: {{ s.padding_top | default: 0 }}px; --st-pb: {{ s.padding_bottom | default: 0 }}px;
--st-px-m: {{ s.side_padding_mobile | default: 0 }}px; --st-px-d: {{ s.side_padding_desktop | default: 0 }}px;
--st-gap-m: {{ s.gap_mobile | default: 0 }}px; --st-gap-d: {{ s.gap_desktop | default: 0 }}px;
--st-dir: {% if s.image_position == 'right' %}row-reverse{% else %}row{% endif %}; --st-valign: {{ s.column_valign | default: 'center' }};
--st-img-w: {{ s.image_width_pct | default: 50 }}%; --st-text-gap: {{ s.text_gap | default: 0 }}px;
--st-ratio-m: {{ s.image_aspect | default: '4 / 5' }}; --st-ratio-d: {{ s.image_aspect_desktop | default: '4 / 5' }}; --st-radius: {{ s.image_radius | default: 0 }}px;
--st-mk: {{ s.marker_size | default: 32 }}px; --st-mk-font: {{ s.marker_font_size | default: 14 }}px; --st-line-style: {{ s.line_style | default: 'solid' }}; --st-line-w: {{ s.line_thickness | default: 2 }}px;
--st-gap-inline: {{ s.step_gap_inline | default: 16 }}px; --st-gap-below: {{ s.step_gap_below | default: 22 }}px; --st-steps-mt: {{ s.steps_margin_top | default: 0 }}px; --st-btn-mt: {{ s.button_margin_top | default: 0 }}px;
{%- render 'media-msr-var', name: '--st-bg', color: s.section_bg, on: custom -%}
{%- render 'media-msr-var', name: '--st-mk-color', color: s.marker_color, on: custom -%}
{%- render 'media-msr-var', name: '--st-mk-text', color: s.marker_text_color, on: custom -%}
{%- render 'media-msr-var', name: '--st-line-color', color: s.line_color, on: custom -%}
{%- render 'media-msr-var', name: '--st-title-color', color: s.step_title_color, on: custom -%}
{%- render 'media-msr-var', name: '--st-desc-color', color: s.step_desc_color, on: custom -%}
{%- render 'media-msr-var', name: '--st-img-bg', color: s.image_bg, on: custom -%}
{%- if custom -%}--st-title-size: {{ s.step_title_size | default: 18 }}px; --st-desc-size: {{ s.step_desc_size | default: 14 }}px;{%- endif -%}
{%- if s.enable_custom_fonts -%}
  {%- if s.heading_font.family != blank -%}--st-hfont: {{ s.heading_font.family }}, {{ s.heading_font.fallback_families | default: 'serif' }};{%- endif -%}
  {%- if s.body_font.family != blank -%}--st-bfont: {{ s.body_font.family }}, {{ s.body_font.fallback_families | default: 'sans-serif' }};{%- endif -%}
{%- endif -%}
{%- endcapture -%}

{{ 'section-image-with-text-steps.css' | asset_url | stylesheet_tag }}
<style>
  {%- if s.enable_custom_fonts -%}
    {%- if s.heading_font.family != blank -%}{{ s.heading_font | font_face: font_display: 'swap' }}{%- endif -%}
    {%- if s.body_font.family != blank -%}{{ s.body_font | font_face: font_display: 'swap' }}{%- endif -%}
  {%- endif -%}
</style>

<div class="section iws-steps{{ reset_spacing }} color-{{ color_scheme }} gradient" data-msr="steps"{% if s.enable_custom_fonts %} data-own-font{% endif %} data-msr-section="{{ sid }}" {% if request.design_mode %}data-msr-settings="{{ s | json | escape }}"{% endif %} {% if request.design_mode %}data-msr-defaults='{"color_scheme":"default","section_width":"container","reset_spacing":true,"image_position":"left","column_valign":"center","image_width_pct":50,"gap_desktop":64,"text_gap":18,"image_alt":"","image_aspect_desktop":"4 / 5","image_radius":16,"step_style":"dot","marker_size":32,"marker_font_size":14,"line_style":"solid","line_thickness":2,"step_gap_inline":16,"step_gap_below":22,"steps_margin_top":12,"custom_colors":false,"step_title_size":18,"step_desc_size":14,"use_theme_button":true,"button_size":15,"button_pad_x":26,"button_pad_y":14,"button_radius":100,"button_margin_top":8,"enable_custom_fonts":false,"heading_font":"assistant_n4","body_font":"assistant_n4","padding_top":60,"padding_bottom":60,"side_padding_desktop":24,"image_aspect":"4 / 5","gap_mobile":32,"side_padding_mobile":16}'{% endif %} {% if request.design_mode %}data-msr-block-defaults='{"eyebrow":{"text":"Why us","custom_style":false,"size":12},"heading":{"text":"Built for results.","tag":"h2","custom_style":false,"weight":"700","size_desktop":40,"size_mobile":28},"subheading":{"text":"&lt;p>Quality you can feel, simplicity you can trust.&lt;/p>","max_width":560,"custom_style":false,"size":15},"step":{"title":"Step title","description":"&lt;p>Add a short description that explains this step.&lt;/p>","enable_custom_style":false},"button":{"label":"Shop now"}}'{% endif %} data-msr-placeholder="{{ placeholder_src }}" style="{{ st_style | strip_newlines }}">
  <div class="iws" data-section-id="{{ sid }}" data-width="{{ s.section_width | default: 'container' }}">
    <div class="iws__inner">

      <div class="iws__media">
        {%- assign demo_iws = '' -%}
        {%- if s.image == blank -%}
          {%- capture demo_iws -%}{%- render 'demo-image', key: section.id -%}{%- endcapture -%}
          {%- assign demo_iws = demo_iws | strip -%}
        {%- endif -%}
        {%- if s.image != blank -%}
          {{ s.image | image_url: width: 1200 | image_tag: alt: s.image_alt, loading: 'lazy', decoding: 'async', sizes: '(max-width: 767px) 100vw, 50vw', widths: '480, 720, 960, 1200, 1600' }}
        {%- elsif s.placeholder_url != blank -%}
          {{ s.placeholder_url | image_url: width: 1200 | image_tag: alt: s.image_alt, loading: 'lazy', decoding: 'async', sizes: '(max-width: 767px) 100vw, 50vw' }}
        {%- elsif demo_iws != blank -%}
          {%- capture iws_demo_ss -%}{%- render 'demo-srcset', url: demo_iws, widths: '480, 720, 960, 1200' -%}{%- endcapture -%}
          <img src="{{ demo_iws }}"{% if iws_demo_ss != blank %} srcset="{{ iws_demo_ss }}" sizes="(max-width: 767px) 100vw, 50vw"{% endif %} alt="" width="1200" height="1500" loading="lazy" decoding="async">
        {%- else -%}
          <img src="{{ placeholder_src }}" alt="" width="400" height="300" loading="lazy" decoding="async">
        {%- endif -%}
      </div>

      <div class="iws__col">
        {%- for block in section.blocks -%}
          {%- assign bs = block.settings -%}
          {%- case block.type -%}
            {%- when 'eyebrow' -%}
              <p class="iws__eyebrow" data-msr-block="{{ block.id }}" data-msr-type="eyebrow" {% if request.design_mode %}data-msr-settings="{{ bs | json | escape }}"{% endif %}{% if bs.text == blank %} hidden{% endif %}
                 style="{% if bs.custom_style %}--b-size: {{ bs.size | default: 12 }}px;{% render 'media-msr-var', name: '--b-color', color: bs.color, on: true %}{% endif %}"
                 {{ block.shopify_attributes }}>{{ bs.text }}</p>
            {%- when 'heading' -%}
              <h2 class="iws__heading" data-msr-block="{{ block.id }}" data-msr-type="heading" {% if request.design_mode %}data-msr-settings="{{ bs | json | escape }}"{% endif %}{% if bs.custom_style %} data-custom data-own-weight data-own-size{% endif %}{% if bs.text == blank %} hidden{% endif %}
                 style="{% if bs.custom_style %}--b-size-m: {{ bs.size_mobile | default: 28 }}px; --b-size-d: {{ bs.size_desktop | default: 40 }}px; --b-weight: {{ bs.weight | default: 700 }};{% render 'media-msr-var', name: '--b-color', color: bs.color, on: true %}{% endif %}"
                 {{ block.shopify_attributes }}>{{ bs.text }}</h2>
            {%- when 'subheading' -%}
              <div class="iws__sub" data-msr-block="{{ block.id }}" data-msr-type="subheading" {% if request.design_mode %}data-msr-settings="{{ bs | json | escape }}"{% endif %}{% if bs.text == blank %} hidden{% endif %}
                   style="--b-max: {{ bs.max_width | default: 560 }}px;{% if bs.custom_style %} --b-size: {{ bs.size | default: 15 }}px;{% render 'media-msr-var', name: '--b-color', color: bs.color, on: true %}{% endif %}"
                   {{ block.shopify_attributes }}>{{ bs.text }}</div>
          {%- endcase -%}
        {%- endfor -%}

        {%- if step_blocks.size > 0 -%}
          <ol class="iws__steps">
            {%- for block in step_blocks -%}
              {%- assign sb = block.settings -%}
              {%- assign step_class = step_style -%}
              {%- if sb.icon != blank -%}
                {%- assign step_class = 'icon' -%}
              {%- elsif step_style == 'icon' -%}
                {%- assign step_class = 'numbered_outline' -%}
              {%- endif -%}
              <li class="iws__step iws__step--{{ step_class }}" data-msr-block="{{ block.id }}" data-msr-type="step" {% if request.design_mode %}data-msr-settings="{{ sb | json | escape }}"{% endif %} style="{% render 'media-msr-var', name: '--b-mk', color: sb.marker_color, on: sb.enable_custom_style %}{% render 'media-msr-var', name: '--b-title', color: sb.title_color, on: sb.enable_custom_style %}{% render 'media-msr-var', name: '--b-desc', color: sb.description_color, on: sb.enable_custom_style %}" {{ block.shopify_attributes }}>
                <div class="iws__step-marker" aria-hidden="true">
                  {%- if sb.icon != blank -%}
                    {{ sb.icon | image_url: width: 80 | image_tag: alt: '', loading: 'lazy', width: 40, height: 40 }}
                  {%- endif -%}
                  <span class="iws__step-num">{{ forloop.index }}</span>
                </div>
                <div class="iws__step-content">
                  <h3 class="iws__step-title"><span class="iws__step-prefix" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span><span class="iws__step-text">{{ sb.title | default: fb_accessibility_step_title }}</span></h3>
                  <div class="iws__step-desc"{% if sb.description == blank %} hidden{% endif %}>{{ sb.description }}</div>
                </div>
              </li>
            {%- endfor -%}
          </ol>
        {%- endif -%}

        {%- for block in button_blocks -%}
          {%- assign bs = block.settings -%}
          <a class="iws__btn btn-primary inline-flex no-underline" data-sl-button data-theme-button="primary" data-button-role="primary" data-button-appearance="{{ settings.btn_style | default: 'solid' }}" data-msr-block="{{ block.id }}" data-msr-type="button" {% if request.design_mode %}data-msr-settings="{{ bs | json | escape }}"{% endif %}{% if steps_custom_btn %} data-own-shape data-own-weight{% endif %} style="{%- render 'button-overrides', bg: btn_bg, text: btn_text, border: btn_bg, hover_bg: btn_hover, hover_text: btn_text, hover_border: btn_hover, custom: steps_custom_btn, radius: s.button_radius, padding_y: s.button_pad_y, padding_x: s.button_pad_x, font_size: s.button_size, weight: 600, border_width: 0 -%}" href="{{ bs.url | default: routes.all_products_collection_url }}"{% if bs.label == blank %} hidden{% endif %} {{ block.shopify_attributes }}>{{ bs.label | escape }}</a>
        {%- endfor -%}
      </div>

    </div>
  </div>
</div>
{%- comment -%} Live edits: shopify/assets/media-live-stats-reels.js (loaded on every page). {%- endcomment -%}


{% schema %}
{
  "name": "Image With Text Steps",
  "tag": "section",
  "class": "section s-image-with-text-steps s-tt",
  "settings": [
    {
      "type": "header",
      "content": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "info": "Text, headings, markers and the button follow this scheme unless you pick your own colours below.",
      "default": "default"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ],
      "default": "container",
      "info": "Default follows Theme settings › Layout › page width. Full width takes the image to the screen edge."
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove the theme's space between sections",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position (desktop)",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "column_valign",
      "label": "Vertical alignment (desktop)",
      "default": "center",
      "options": [
        {
          "value": "flex-start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "stretch",
          "label": "Stretch"
        }
      ]
    },
    {
      "type": "range",
      "id": "image_width_pct",
      "label": "Image column width (desktop)",
      "min": 30,
      "max": 70,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "label": "Column gap (desktop)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "text_gap",
      "label": "Gap between text elements",
      "min": 4,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image description (alt text)",
      "info": "Describes the picture for screen readers."
    },
    {
      "type": "image_picker",
      "id": "placeholder_url",
      "label": "Fallback image",
      "info": "Shown when no image is picked."
    },
    {
      "type": "select",
      "id": "image_aspect_desktop",
      "label": "Image shape (desktop)",
      "default": "4 / 5",
      "options": [
        {
          "value": "1 / 1",
          "label": "Square"
        },
        {
          "value": "4 / 5",
          "label": "4:5"
        },
        {
          "value": "3 / 4",
          "label": "3:4"
        },
        {
          "value": "16 / 9",
          "label": "16:9"
        }
      ]
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Steps"
    },
    {
      "type": "select",
      "id": "step_style",
      "label": "Marker style",
      "default": "dot",
      "options": [
        {
          "value": "dot",
          "label": "Filled dot"
        },
        {
          "value": "dot_outline",
          "label": "Outlined dot"
        },
        {
          "value": "numbered",
          "label": "Numbered (filled)"
        },
        {
          "value": "numbered_outline",
          "label": "Numbered (outline)"
        },
        {
          "value": "prefixed",
          "label": "Prefix in title (01.)"
        },
        {
          "value": "icon",
          "label": "Custom icon (per step)"
        }
      ]
    },
    {
      "type": "range",
      "id": "marker_size",
      "label": "Marker size",
      "visible_if": "{{ section.settings.step_style != 'prefixed' }}",
      "min": 16,
      "max": 56,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "marker_font_size",
      "label": "Marker number size",
      "visible_if": "{{ section.settings.step_style != 'dot' and section.settings.step_style != 'dot_outline' and section.settings.step_style != 'prefixed' }}",
      "min": 10,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "select",
      "id": "line_style",
      "label": "Connecting line style",
      "visible_if": "{{ section.settings.step_style != 'prefixed' }}",
      "default": "solid",
      "options": [
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "dashed",
          "label": "Dashed"
        },
        {
          "value": "dotted",
          "label": "Dotted"
        }
      ]
    },
    {
      "type": "range",
      "id": "line_thickness",
      "label": "Line and outline thickness",
      "visible_if": "{{ section.settings.step_style != 'prefixed' }}",
      "min": 1,
      "max": 6,
      "step": 1,
      "unit": "px",
      "default": 2
    },
    {
      "type": "range",
      "id": "step_gap_inline",
      "label": "Gap between marker and text",
      "visible_if": "{{ section.settings.step_style != 'prefixed' }}",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "step_gap_below",
      "label": "Gap between steps",
      "min": 8,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "steps_margin_top",
      "label": "Space above first step",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "checkbox",
      "id": "custom_colors",
      "label": "Enable custom styling",
      "default": false,
      "info": "Colours, step text sizes and button colours. Off follows the colour scheme and Theme settings."
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Background",
      "info": "Leave empty to use the colour scheme's background.",
      "visible_if": "{{ section.settings.custom_colors }}"
    },
    {
      "type": "color",
      "id": "marker_color",
      "label": "Marker",
      "visible_if": "{{ section.settings.custom_colors }}"
    },
    {
      "type": "color",
      "id": "marker_text_color",
      "label": "Marker number",
      "visible_if": "{{ section.settings.custom_colors and section.settings.step_style == 'numbered' }}"
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Connecting line",
      "visible_if": "{{ section.settings.custom_colors and section.settings.step_style != 'prefixed' }}"
    },
    {
      "type": "color",
      "id": "step_title_color",
      "label": "Step title",
      "visible_if": "{{ section.settings.custom_colors }}"
    },
    {
      "type": "color",
      "id": "step_desc_color",
      "label": "Step description",
      "visible_if": "{{ section.settings.custom_colors }}"
    },
    {
      "type": "color",
      "id": "image_bg",
      "label": "Behind the image",
      "info": "Shows while the picture loads or around a transparent image.",
      "visible_if": "{{ section.settings.custom_colors }}"
    },
    {
      "type": "range",
      "id": "step_title_size",
      "label": "Step title size",
      "visible_if": "{{ section.settings.custom_colors }}",
      "min": 14,
      "max": 26,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "step_desc_size",
      "label": "Step description size",
      "visible_if": "{{ section.settings.custom_colors }}",
      "min": 11,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button background",
      "visible_if": "{{ section.settings.custom_colors }}"
    },
    {
      "type": "color",
      "id": "button_color",
