{%- comment -%}
Video sales letter: reviews as cards, stars, the words, then who said it
  with a small round picture (or their initial when there is none).
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
-%}
{%- liquid
  assign cols = st.columns | default: 3 | plus: 0
  assign carousel = false
  if st.layout == 'carousel'
    assign carousel = true
  endif
-%}
<style>
  .vsl { position: relative; color: var(--vsl-text, #a3a3a8); font-family: var(--body-font, inherit); -webkit-font-smoothing: antialiased; }
  .vsl *, .vsl *::before, .vsl *::after { box-sizing: border-box; }
  .vsl__inner { position: relative; max-width: var(--vsl-max, 1120px); margin: 0 auto; padding: 0 20px; }
  .vsl__head { text-align: center; margin: 0 auto 44px; max-width: 760px; }
  .vsl__eyebrow { display: flex; align-items: center; justify-content: center; gap: 14px; margin: 0 0 18px; font-size: 11px; font-weight: 500; letter-spacing: .24em; text-transform: uppercase; color: rgba(255,255,255,.6); }
  .vsl__eyebrow::before, .vsl__eyebrow::after { content: ""; flex: 0 0 34px; height: 1px; background: linear-gradient(90deg, rgba(255,255,255,0), rgba(255,255,255,.5)); }
  .vsl__eyebrow::after { background: linear-gradient(270deg, rgba(255,255,255,0), rgba(255,255,255,.5)); }
  .vsl__title { margin: 0; color: var(--vsl-head, #fff); font-family: var(--heading-font, inherit); font-weight: 700; font-size: clamp(32px, 4.6vw, 52px); line-height: 1.06; letter-spacing: -.035em; text-wrap: balance; }
  .vsl__title em, .vsl em.vsl-serif { font-style: normal; color: rgba(255,255,255,.6); }
  .vsl__lede { margin: 16px auto 0; max-width: 580px; font-size: 15px; line-height: 1.65; }
  .vsl__lede p { margin: 0; }
  .vsl-btn {
    position: relative; isolation: isolate; overflow: hidden;
    display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 48px; padding: 0 24px;
    border-radius: 999px; border: 1px solid rgba(255,255,255,.24); background: rgba(10,10,12,.85); color: #fff;
    font-family: var(--body-font, inherit); font-size: 14px; font-weight: 600; letter-spacing: -.005em; text-decoration: none; white-space: nowrap;
    box-shadow: inset 0 1px 0 rgba(255,255,255,.22), 0 0 0 4px rgba(255,255,255,.03), 0 14px 40px -14px rgba(255,255,255,.35);
    transition: transform .35s cubic-bezier(.2,.7,.2,1), border-color .35s, box-shadow .35s;
  }
  .vsl-btn::before { content: ""; position: absolute; z-index: -1; top: -1px; left: -40%; width: 40%; height: 2px; background: linear-gradient(90deg, transparent, #fff, transparent); opacity: .9; transition: transform 1.1s cubic-bezier(.2,.7,.2,1); }
  .vsl-btn:hover { transform: translateY(-1px); border-color: rgba(255,255,255,.5); box-shadow: inset 0 1px 0 rgba(255,255,255,.3), 0 0 0 4px rgba(255,255,255,.05), 0 18px 50px -14px rgba(255,255,255,.45); }
  .vsl-btn:hover::before { transform: translateX(350%); }
  .vsl-btn:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
  .vsl-btn svg { width: 16px; height: 16px; flex: none; transition: transform .35s cubic-bezier(.2,.7,.2,1); }
  .vsl-btn:hover svg { transform: translateX(3px); }
  .vsl-btn--light { background: #fff; color: #0a0a0a; border-color: #fff; box-shadow: 0 14px 40px -14px rgba(255,255,255,.5); }
  .vsl-btn--light::before { display: none; }
  .vsl-btn--ghost { background: transparent; box-shadow: none; border-color: rgba(255,255,255,.16); }
  .vsl__actions { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 12px; margin-top: 30px; }
  .vsl-card {
    position: relative; border-radius: 18px; border: 1px solid rgba(255,255,255,.09);
    background: linear-gradient(180deg, rgba(255,255,255,.06), rgba(255,255,255,.015) 60%), rgba(12,12,14,.72);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.07), 0 30px 60px -40px rgba(0,0,0,.9);
  }
  .vsl--line { padding-top: 1px; }
  .vsl--line::before { content: ""; position: absolute; left: 50%; top: 0; width: min(1120px, calc(100% - 40px)); height: 1px; transform: translateX(-50%); background: linear-gradient(90deg, rgba(255,255,255,0), rgba(255,255,255,.26) 50%, rgba(255,255,255,0)); }
  .vsl--line::after { content: ""; position: absolute; left: 50%; top: 0; width: min(900px, 90%); height: 180px; transform: translateX(-50%); pointer-events: none; background: radial-gradient(50% 100% at 50% 0, rgba(255,255,255,.07), rgba(255,255,255,0)); }
  @media (max-width: 749px) { .vsl__eyebrow { letter-spacing: .18em; gap: 10px; } .vsl__eyebrow::before, .vsl__eyebrow::after { flex-basis: 22px; } .vsl__head { margin-bottom: 32px; } }
  html.vsl-js .vsl [data-motion] { opacity: 0; transform: translate3d(0, 22px, 0); transition: opacity .9s cubic-bezier(.2,.65,.2,1), transform .9s cubic-bezier(.2,.65,.2,1); transition-delay: var(--d, 0ms); }
  html.vsl-js .vsl [data-motion].is-in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    html.vsl-js .vsl [data-motion] { opacity: 1; transform: none; transition: none; }
    .vsl-btn, .vsl-btn::before, .vsl-btn svg { transition: none; }
  }

  #shopify-section-{{ sid }} .vsl { padding-top: {{ st.padding_top_mobile | default: 64 }}px; padding-bottom: {{ st.padding_bottom_mobile | default: 64 }}px; }
  @media (min-width: 750px) { #shopify-section-{{ sid }} .vsl { padding-top: {{ st.padding_top | default: 96 }}px; padding-bottom: {{ st.padding_bottom | default: 96 }}px; } }

  .vsl-reviews__grid { display: grid; gap: 16px; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 750px) { .vsl-reviews__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .vsl-reviews__grid { grid-template-columns: repeat({{ cols }}, minmax(0, 1fr)); } }
  .vsl-reviews .vsl-card { display: flex; flex-direction: column; padding: 24px 24px 22px; }
  .vsl-reviews__stars { display: flex; gap: 3px; margin-bottom: 16px; color: #fff; }
  .vsl-reviews__stars svg { width: 15px; height: 15px; }
  .vsl-reviews__stars .is-off { opacity: .22; }
  .vsl-reviews__quote { margin: 0 0 24px; color: rgba(255,255,255,.82); font-size: 15px; line-height: 1.65; }
  .vsl-reviews__quote p { margin: 0; }
  .vsl-reviews__who { display: flex; align-items: center; gap: 12px; margin-top: auto; }
  .vsl-reviews__pic { width: 38px; height: 38px; border-radius: 50%; overflow: hidden; flex: none; display: grid; place-items: center; background: linear-gradient(180deg, rgba(255,255,255,.2), rgba(255,255,255,.05)); border: 1px solid rgba(255,255,255,.16); color: #fff; font-weight: 600; font-size: 14px; }
  .vsl-reviews__pic img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .vsl-reviews__name { margin: 0; color: #fff; font-size: 14px; font-weight: 600; }
  .vsl-reviews__role { margin: 2px 0 0; font-size: 12px; color: rgba(255,255,255,.5); }
  .vsl-reviews__mark { margin-left: auto; width: 26px; height: 26px; color: rgba(255,255,255,.14); flex: none; }
  .vsl-reviews__pic { --h: 220; background: linear-gradient(150deg, hsl(var(--h) 38% 42%), hsl(calc(var(--h) + 40) 30% 18%)); letter-spacing: .02em; font-size: 13px; box-shadow: 0 0 0 3px rgba(255,255,255,.04); }
  .vsl-reviews__head { margin: 0 0 10px; color: #fff; font-size: 16px; font-weight: 600; line-height: 1.35; letter-spacing: -.01em; }
  .vsl-reviews__note { display: inline-flex; align-items: center; gap: 8px; margin: 18px auto 0; padding: 5px 12px; border-radius: 999px; border: 1px dashed rgba(255,255,255,.22); color: rgba(255,255,255,.6); font-size: 12px; }
  /* Carousel: a row that scrolls and snaps, with arrows and a bar that shows where you are. */
  .vsl-rv__wrap { position: relative; }
  .vsl-rv__track { display: grid; grid-auto-flow: column; grid-auto-columns: calc((100% - 32px) / 3); gap: 16px; overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scrollbar-width: none; -webkit-overflow-scrolling: touch; padding: 4px 2px 8px; margin: -4px -2px 0; scroll-behavior: smooth; }
  .vsl-rv__track::-webkit-scrollbar { display: none; }
  .vsl-rv__track > .vsl-card { scroll-snap-align: start; min-height: 100%; }
  @media (max-width: 989px) { .vsl-rv__track { grid-auto-columns: calc((100% - 16px) / 2); } }
  @media (max-width: 749px) { .vsl-rv__track { grid-auto-columns: 86%; gap: 12px; } }
  .vsl-rv__bar { display: flex; align-items: center; gap: 16px; margin-top: 26px; }
  .vsl-rv__bar[hidden] { display: none; }
  .vsl-rv__dots { flex: 1; display: flex; gap: 6px; }
  .vsl-rv__dot { flex: 1; max-width: 48px; height: 3px; padding: 0; border: 0; border-radius: 3px; background: rgba(255,255,255,.14); cursor: pointer; position: relative; overflow: hidden; }
  .vsl-rv__dot::after { content: ""; position: absolute; inset: 0; background: #fff; transform: scaleX(0); transform-origin: 0 50%; transition: transform .45s cubic-bezier(.2,.7,.2,1); }
  .vsl-rv__dot[aria-current="true"]::after { transform: scaleX(1); }
  .vsl-rv__arrows { display: flex; gap: 8px; }
  .vsl-rv__arrow { display: grid; place-items: center; width: 42px; height: 42px; padding: 0; border-radius: 50%; cursor: pointer; color: #fff; border: 1px solid rgba(255,255,255,.18); background: rgba(255,255,255,.04); transition: background-color .3s, border-color .3s, opacity .3s; }
  .vsl-rv__arrow:hover { background: rgba(255,255,255,.1); border-color: rgba(255,255,255,.35); }
  .vsl-rv__arrow:disabled { opacity: .35; cursor: default; }
  .vsl-rv__arrow:focus-visible, .vsl-rv__dot:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
  .vsl-rv__arrow svg { width: 16px; height: 16px; }
  @media (prefers-reduced-motion: reduce) { .vsl-rv__track { scroll-behavior: auto; } .vsl-rv__dot::after { transition: none; } }
</style>
<div data-own-font class="vsl{% if st.line_above %} vsl--line{% endif %} vsl-reviews">
  <div class="vsl__inner">
    {%- if st.eyebrow != blank or st.heading != blank or st.text != blank -%}
      <div class="vsl__head" data-motion>
        {%- if st.eyebrow != blank -%}<p class="vsl__eyebrow"><span>{{ st.eyebrow | escape }}</span></p>{%- endif -%}
        {%- if st.heading != blank -%}<h2 class="vsl__title">{%- assign vsl_parts = st.heading | escape | split: '*' -%}{%- for vsl_part in vsl_parts -%}{%- assign vsl_odd = forloop.index0 | modulo: 2 -%}{%- if vsl_odd == 1 -%}<em>{{ vsl_part | replace: '|', '<br>' }}</em>{%- else -%}{{ vsl_part | replace: '|', '<br>' }}{%- endif -%}{%- endfor -%}</h2>{%- endif -%}
        {%- if st.text != blank -%}<div class="vsl__lede">{{ st.text }}</div>{%- endif -%}
        {%- if st.sample_note != blank -%}<p class="vsl-reviews__note">{{ st.sample_note | escape }}</p>{%- endif -%}
      </div>
    {%- endif -%}
    {%- if carousel -%}<div class="vsl-rv__wrap" data-vsl-rv data-auto="{% if st.autoplay %}1{% endif %}"><div class="vsl-rv__track" data-track tabindex="0" role="region" aria-label="{{ st.heading | remove: '*' | remove: '|' | default: 'Reviews' | escape }}">{%- else -%}<div class="vsl-reviews__grid">{%- endif -%}
      {%- for block in section.blocks -%}
        {%- assign stars = block.settings.stars | default: 5 -%}
        <figure class="vsl-card" {% unless carousel %}data-motion {% endunless %}style="--d: {{ forloop.index0 | modulo: cols | times: 90 }}ms; margin: 0" {{ block.shopify_attributes }}>
          {%- if stars > 0 -%}
            <div class="vsl-reviews__stars" role="img" aria-label="{{ stars }} / 5">
              {%- for i in (1..5) -%}<svg viewBox="0 0 20 20" class="{% if i > stars %}is-off{% endif %}" aria-hidden="true" focusable="false"><path d="M10 1.8l2.5 5.2 5.7.8-4.1 4 1 5.6L10 14.7l-5.1 2.7 1-5.6-4.1-4 5.7-.8z" fill="currentColor"/></svg>{%- endfor -%}
            </div>
          {%- endif -%}
          {%- if block.settings.headline != blank -%}<p class="vsl-reviews__head">{{ block.settings.headline | escape }}</p>{%- endif -%}
          <div class="vsl-reviews__quote">{{ block.settings.quote }}</div>
          <figcaption class="vsl-reviews__who">
            {%- liquid
              assign rv_words = block.settings.name | strip | split: ' '
              assign rv_ini = rv_words.first | slice: 0 | upcase
              if rv_words.size > 1
                assign rv_last = rv_words.last | slice: 0 | upcase
                assign rv_ini = rv_ini | append: rv_last
              endif
              assign rv_hue = forloop.index0 | times: 47 | plus: 200 | modulo: 360
            -%}
            <span class="vsl-reviews__pic" aria-hidden="true" style="--h: {{ rv_hue }}">
              {%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}{%- else -%}{{ rv_ini | escape }}{%- endif -%}
            </span>
            <span>
              <p class="vsl-reviews__name">{{ block.settings.name | escape }}</p>
              {%- if block.settings.role != blank -%}<p class="vsl-reviews__role">{{ block.settings.role | escape }}</p>{%- endif -%}
            </span>
            <svg class="vsl-reviews__mark" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M10 6c-3.3 1-5.5 3.8-5.5 7.6V18H10v-5H7.2c.1-2 1.3-3.6 3.3-4.4zM19.5 6c-3.3 1-5.5 3.8-5.5 7.6V18h5.5v-5h-2.8c.1-2 1.3-3.6 3.3-4.4z" fill="currentColor"/></svg>
          </figcaption>
        </figure>
      {%- endfor -%}
    {%- if carousel -%}</div>
      <div class="vsl-rv__bar">
        <div class="vsl-rv__dots" data-dots></div>
        <div class="vsl-rv__arrows">
          <button class="vsl-rv__arrow" type="button" data-prev aria-label="{{ st.prev_label | default: 'Previous' | escape }}"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M13 8H3M7 4L3 8l4 4"/></svg></button>
          <button class="vsl-rv__arrow" type="button" data-next aria-label="{{ st.next_label | default: 'Next' | escape }}"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 8h10M9 4l4 4-4 4"/></svg></button>
        </div>
      </div>
    </div>{%- else -%}</div>{%- endif -%}
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;
    var still = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!('IntersectionObserver' in window) || still) return;
    document.documentElement.classList.add('vsl-js');
    if (!window.__vslSeen) {
      window.__vslSeen = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('is-in'); window.__vslSeen.unobserve(e.target); } });
      }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
    }
    root.querySelectorAll('[data-motion]:not(.is-in)').forEach(function (el) { window.__vslSeen.observe(el); });
  })();
</script>

<script>
  (function () {
    var box = document.querySelector('#shopify-section-{{ section.id }} [data-vsl-rv]');
    if (!box || box.hasAttribute('data-ready')) return;
    box.setAttribute('data-ready', '');
    var track = box.querySelector('[data-track]'), dots = box.querySelector('[data-dots]');
    var prev = box.querySelector('[data-prev]'), next = box.querySelector('[data-next]');
    var cards = Array.prototype.slice.call(track.children);
    var still = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    function perView() { var c = cards[0]; return c ? Math.max(1, Math.round(track.clientWidth / (c.getBoundingClientRect().width + 12))) : 1; }
    function pages() { return Math.max(1, cards.length - perView() + 1); }
    function at() { var c = cards[1] || cards[0]; if (!c) return 0; var step = cards[1] ? cards[1].offsetLeft - cards[0].offsetLeft : 1; return Math.round(track.scrollLeft / step); }
    function go(i) { var n = pages(); i = Math.max(0, Math.min(n - 1, i)); var c = cards[i]; if (c) track.scrollTo({ left: c.offsetLeft - cards[0].offsetLeft, behavior: still ? 'auto' : 'smooth' }); }
    function draw() {
      var n = pages();
      if (dots.children.length !== n) {
        dots.innerHTML = '';
        for (var i = 0; i < n; i++) { var b = document.createElement('button'); b.type = 'button'; b.className = 'vsl-rv__dot'; b.setAttribute('aria-label', (i + 1) + ' / ' + n); (function (k) { b.addEventListener('click', function () { go(k); hold(); }); })(i); dots.appendChild(b); }
      }
      var cur = Math.min(n - 1, at());
      Array.prototype.forEach.call(dots.children, function (d, i) { d.setAttribute('aria-current', i === cur ? 'true' : 'false'); });
      prev.disabled = cur <= 0; next.disabled = cur >= n - 1;
      box.querySelector('.vsl-rv__bar').hidden = n < 2;
    }
    var raf = 0;
    track.addEventListener('scroll', function () { cancelAnimationFrame(raf); raf = requestAnimationFrame(draw); }, { passive: true });
    window.addEventListener('resize', function () { cancelAnimationFrame(raf); raf = requestAnimationFrame(draw); });
    prev.addEventListener('click', function () { go(at() - 1); hold(); });
    next.addEventListener('click', function () { go(at() + 1); hold(); });
    track.addEventListener('keydown', function (e) { if (e.key === 'ArrowRight') { e.preventDefault(); go(at() + 1); hold(); } if (e.key === 'ArrowLeft') { e.preventDefault(); go(at() - 1); hold(); } });
    draw();
    /* Moves on by itself every few seconds, until the visitor touches it; never for visitors who ask for less motion. */
    var timer = 0, held = false;
    function hold() { held = true; clearInterval(timer); }
    if (box.dataset.auto && !still) {
      timer = setInterval(function () { if (document.hidden || held) return; var r = box.getBoundingClientRect(); if (r.bottom < 0 || r.top > innerHeight) return; var n = pages(); go(at() >= n - 1 ? 0 : at() + 1); }, 6500);
      ['pointerdown', 'wheel', 'touchstart', 'focusin'].forEach(function (ev) { box.addEventListener(ev, hold, { passive: true }); });
      box.addEventListener('mouseenter', function () { held = true; }); box.addEventListener('mouseleave', function () { held = false; });
    }
  })();
</script>

{% schema %}
{
  "name": "Reviews carousel",
  "tag": "section",
  "class": "vsl-reviews-section",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "carousel",
      "options": [
        { "value": "carousel", "label": "Carousel" },
        { "value": "grid", "label": "Grid" }
      ]
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Carousel moves on by itself",
      "default": true
    },
    {
      "type": "text",
      "id": "sample_note",
      "label": "Note under the heading",
      "info": "Say plainly when the reviews are samples. Clear it once they are your students' own words.",
      "default": ""
    },
    {
      "type": "text",
      "id": "prev_label",
      "label": "Previous button, for screen readers",
      "default": "Previous"
    },
    {
      "type": "text",
      "id": "next_label",
      "label": "Next button, for screen readers",
      "default": "Next"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small label",
      "default": "Students"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What students *say*",
      "info": "Words between asterisks are set a shade lighter, like *this*. A | starts a new line."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Sample reviews. Swap them for what your own students send you.</p>"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Cards in a row",
      "default": "3",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        }
      ]
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "checkbox",
      "id": "line_above",
      "label": "Thin glowing line above",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Space above, desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Space below, desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Space above, phone",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Space below, phone",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "stars",
          "label": "Stars",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "headline",
          "label": "Short headline",
          "info": "The result in a few words, in bold above the review."
        },
        {
          "type": "richtext",
          "id": "quote",
          "label": "Review",
          "default": "<p>What changed for them, in their words.</p>"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Student name"
        },
        {
          "type": "text",
          "id": "role",
          "label": "What they do",
          "default": "What they do"
        },
        {
