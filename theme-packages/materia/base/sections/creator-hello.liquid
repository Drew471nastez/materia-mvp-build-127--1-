{%- comment -%}
  Creator Landing: the first screen of a personal site. A soft rounded panel
  holds a two part heading (a plain line and a serif line with a drawn
  underline), a short introduction, a drawn arrow, one featured offer on a
  white card, and a row of press logos. No portrait: the work is the picture.
  The underline draws itself once on load; nothing moves with reduced motion.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign color_scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
  assign placeholder = 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 600 500%22%3E%3Crect width=%22600%22 height=%22500%22 fill=%22%23ece7de%22/%3E%3Cg fill=%22%23b9b0a2%22%3E%3Ccircle cx=%22250%22 cy=%22210%22 r=%2222%22/%3E%3Cpath d=%22M190 320l70-80 44 48 36-30 70 62z%22/%3E%3C/g%3E%3C/svg%3E'
-%}
<style>
  #shopify-section-{{ sid }} .chh {
    --chh-panel: {{ st.panel_color | default: '#f4f1ec' }};
    --chh-line: {{ st.underline_color | default: '#5ec3ea' }};
    --chh-arrow: {{ st.arrow_color | default: '#f6a27c' }};
    --chh-btn: {{ st.button_color | default: '#5ec3ea' }};
    --chh-btn-text: {{ st.button_text_color | default: '#1c1b2b' }};
    padding: {{ st.padding_top_mobile | default: 8 }}px 12px {{ st.padding_bottom_mobile | default: 40 }}px;
  }
  @media (min-width: 990px) {
    #shopify-section-{{ sid }} .chh { padding: {{ st.padding_top | default: 12 }}px 28px {{ st.padding_bottom | default: 72 }}px; }
  }
  #shopify-section-{{ sid }} .chh__panel {
    position: relative; overflow: hidden;
    max-width: 1280px; margin: 0 auto;
    background: var(--chh-panel);
    border-radius: 24px;
    padding: 40px 20px 36px;
  }
  @media (min-width: 990px) {
    #shopify-section-{{ sid }} .chh__panel { border-radius: 32px; padding: 72px 88px 56px; }
  }
  #shopify-section-{{ sid }} .chh__panel::before {
    content: ""; position: absolute; pointer-events: none;
    width: 1100px; height: 1100px; right: -520px; bottom: -760px;
    border-radius: 50%; border: 90px solid rgba(255,255,255,0.45);
  }
  #shopify-section-{{ sid }} .chh__top { position: relative; display: grid; grid-template-columns: minmax(0, 1fr); gap: 20px; }
  @media (min-width: 990px) {
    #shopify-section-{{ sid }} .chh__top { grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr); gap: 56px; align-items: end; }
  }
  #shopify-section-{{ sid }} .chh__heading {
    margin: 0; color: var(--color-heading);
    font-size: {{ st.heading_size_mobile | default: 44 }}px; line-height: 1.02; letter-spacing: -0.03em;
  }
  @media (min-width: 990px) {
    #shopify-section-{{ sid }} .chh__heading { font-size: {{ st.heading_size | default: 84 }}px; }
  }
  #shopify-section-{{ sid }} .chh__plain {
    display: block; font-family: var(--body-font, inherit); font-weight: 400; letter-spacing: -0.04em;
  }
  #shopify-section-{{ sid }} .chh__serif {
    position: relative; display: inline-block;
    font-family: var(--heading-font, inherit); font-weight: var(--heading-font-weight, 600);
  }
  #shopify-section-{{ sid }} .chh__swash {
    position: absolute; left: -2%; right: -2%; bottom: -0.2em; width: 104%; height: 0.3em; overflow: visible;
  }
  #shopify-section-{{ sid }} .chh__swash path {
    fill: none; stroke: var(--chh-line); stroke-width: 7; stroke-linecap: round;
    stroke-dasharray: 1000; stroke-dashoffset: 1000;
    animation: chh-draw-{{ sid }} 1.1s 0.35s cubic-bezier(0.6, 0, 0.3, 1) forwards;
  }
  @keyframes chh-draw-{{ sid }} { to { stroke-dashoffset: 0; } }
  #shopify-section-{{ sid }} .chh__intro {
    margin: 0; color: var(--color-heading); max-width: 30ch;
    font-size: {{ st.text_size_mobile | default: 18 }}px; line-height: 1.45; letter-spacing: -0.01em;
  }
  @media (min-width: 990px) {
    #shopify-section-{{ sid }} .chh__intro { font-size: {{ st.text_size | default: 21 }}px; padding-bottom: 10px; }
  }
  #shopify-section-{{ sid }} .chh__intro p { margin: 0; }
  #shopify-section-{{ sid }} .chh__intro a {
    color: inherit; font-family: var(--heading-font, inherit); font-weight: var(--heading-font-weight, 600);
    text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 4px;
  }
  #shopify-section-{{ sid }} .chh__arrow {
    display: none; position: absolute; right: 8%; top: 100%; width: 70px; height: 96px; color: var(--chh-arrow);
  }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .chh__arrow { display: block; } }
  #shopify-section-{{ sid }} .chh__card {
    position: relative; margin-top: 36px;
    display: grid; grid-template-columns: minmax(0, 1fr); gap: 24px;
    background: #fff; border-radius: 20px; padding: 24px;
    box-shadow: 0 1px 2px rgba(28,27,43,0.04), 0 24px 60px -24px rgba(60,44,20,0.22);
  }
  @media (min-width: 990px) {
    #shopify-section-{{ sid }} .chh__card { margin: 112px 0 0; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: 56px; padding: 56px 56px 56px 64px; align-items: center; }
  }
  #shopify-section-{{ sid }} .chh__eyebrow {
    display: inline-flex; align-items: center; gap: 10px; margin: 0 0 14px;
    font-size: 13px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-text);
  }
  #shopify-section-{{ sid }} .chh__eyebrow::before { content: ""; width: 10px; height: 10px; border-radius: 3px; background: var(--chh-arrow); }
  #shopify-section-{{ sid }} .chh__title {
    margin: 0 0 14px; color: var(--color-heading);
    font-family: var(--heading-font, inherit); font-weight: var(--heading-font-weight, 600);
    font-size: 32px; line-height: 1.08; letter-spacing: -0.02em;
  }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .chh__title { font-size: 42px; } }
  #shopify-section-{{ sid }} .chh__text { color: var(--color-heading); font-size: 17px; line-height: 1.55; max-width: 40ch; }
  #shopify-section-{{ sid }} .chh__text p { margin: 0 0 12px; }
  #shopify-section-{{ sid }} .chh__btn {
    display: inline-flex; align-items: center; min-height: 48px; margin-top: 12px; padding: 0 24px;
    border-radius: 999px; background: var(--chh-btn); color: var(--chh-btn-text);
    font-size: 15px; font-weight: 600; text-decoration: none;
    transition: transform 0.2s ease, filter 0.2s ease;
  }
  #shopify-section-{{ sid }} .chh__btn:hover { transform: translateY(-1px); filter: brightness(0.96); }
  #shopify-section-{{ sid }} .chh__media { order: -1; margin: 0; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .chh__media { order: 0; } }
  #shopify-section-{{ sid }} .chh__media img {
    display: block; width: 100%; height: auto; aspect-ratio: {{ st.image_ratio | default: '4 / 3' }}; object-fit: cover;
    border-radius: 14px; margin: 0;
  }
  #shopify-section-{{ sid }} .chh__press { position: relative; margin-top: 44px; text-align: center; }
  #shopify-section-{{ sid }} .chh__press-label { margin: 0 0 18px; font-size: 14px; color: var(--color-text); }
  #shopify-section-{{ sid }} .chh__logos {
    display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 14px 24px;
  }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .chh__logos { justify-content: space-between; gap: 24px; } }
  #shopify-section-{{ sid }} .chh__logos img { display: block; height: 19px; width: auto; margin: 0; opacity: 0.8; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .chh__logos img { height: 30px; } }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .chh__swash path { animation: none; stroke-dashoffset: 0; }
    #shopify-section-{{ sid }} .chh__btn { transition: none; }
  }
</style>

<div class="chh color-{{ color_scheme }}" data-section-id="{{ sid }}">
  <div class="chh__panel">
    <div class="chh__top">
      <h1 class="chh__heading">
        {%- if st.heading_plain != blank -%}<span class="chh__plain">{{ st.heading_plain | escape }}</span>{%- endif -%}
        {%- if st.heading_serif != blank -%}
          <span class="chh__serif">{{ st.heading_serif | escape }}<svg class="chh__swash" viewBox="0 0 400 30" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M4 20 C 90 6, 200 4, 396 14 M 60 26 C 150 18, 260 17, 340 22"/></svg></span>
        {%- endif -%}
      </h1>
      {%- if st.intro != blank -%}<div class="chh__intro">{{ st.intro }}</div>{%- endif -%}
      {%- if st.show_arrow -%}
        <svg class="chh__arrow" viewBox="0 0 70 96" fill="none" aria-hidden="true" focusable="false"><path d="M20 4c26 4 40 22 30 36-8 11-26 6-22-6 4-12 26-6 28 14 2 18-8 34-24 44" stroke="currentColor" stroke-width="3" stroke-linecap="round"/><path d="M20 82l12 10 4-15" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
      {%- endif -%}
    </div>

    {%- if st.card_title != blank or st.card_image != blank -%}
      <div class="chh__card">
        <div class="chh__body">
          {%- if st.card_eyebrow != blank -%}<p class="chh__eyebrow">{{ st.card_eyebrow | escape }}</p>{%- endif -%}
          {%- if st.card_title != blank -%}<h2 class="chh__title">{{ st.card_title | escape }}</h2>{%- endif -%}
          {%- if st.card_text != blank -%}<div class="chh__text">{{ st.card_text }}</div>{%- endif -%}
          {%- if st.card_button_label != blank -%}<a class="chh__btn" href="{{ st.card_button_link | default: '/collections/all' }}">{{ st.card_button_label | escape }}</a>{%- endif -%}
        </div>
        <figure class="chh__media">
          {%- if st.card_image != blank -%}
            <img src="{{ st.card_image | image_url: width: 1200 }}" srcset="{{ st.card_image | image_url: width: 600 }} 600w, {{ st.card_image | image_url: width: 900 }} 900w, {{ st.card_image | image_url: width: 1200 }} 1200w" sizes="(min-width: 990px) 560px, 92vw" width="{{ st.card_image.width | default: 1200 }}" height="{{ st.card_image.height | default: 900 }}" alt="{{ st.card_image_alt | default: st.card_image.alt | escape }}" loading="eager" decoding="async">
          {%- else -%}
            <img src="{{ placeholder }}" width="600" height="500" alt="">
          {%- endif -%}
        </figure>
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="chh__press">
        {%- if st.press_label != blank -%}<p class="chh__press-label">{{ st.press_label | escape }}</p>{%- endif -%}
        <div class="chh__logos">
          {%- for block in section.blocks -%}
            {%- assign b = block.settings -%}
            {%- if b.link != blank -%}<a href="{{ b.link }}" {{ block.shopify_attributes }}>{%- else -%}<span {{ block.shopify_attributes }}>{%- endif -%}
            {%- if b.image != blank -%}
              <img src="{{ b.image | image_url: width: 400 }}" width="{{ b.image.width | default: 400 }}" height="{{ b.image.height | default: 80 }}" alt="{{ b.alt | default: b.image.alt | escape }}" loading="lazy" decoding="async">
            {%- else -%}
              <img src="data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 160 30%22%3E%3Crect width=%22160%22 height=%2230%22 rx=%226%22 fill=%22%23ddd6ca%22/%3E%3C/svg%3E" width="160" height="30" alt="">
            {%- endif -%}
            {%- if b.link != blank -%}</a>{%- else -%}</span>{%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Creator hello",
  "tag": "section",
  "class": "section sec__creator-hello",
  "max_blocks": 8,
  "settings": [
    { "type": "header", "content": "General" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default-color-scheme" },
    { "type": "color", "id": "panel_color", "label": "Panel colour", "default": "#f4f1ec" },
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "heading_plain", "label": "First line, plain", "default": "Draw a little" },
    { "type": "text", "id": "heading_serif", "label": "Second line, underlined", "default": "every morning." },
    { "type": "color", "id": "underline_color", "label": "Underline colour", "default": "#5ec3ea" },
    { "type": "richtext", "id": "intro", "label": "Introduction", "default": "<p>Say who you are and what you make in one or two lines.</p>" },
    { "type": "checkbox", "id": "show_arrow", "label": "Show the drawn arrow", "default": true },
    { "type": "color", "id": "arrow_color", "label": "Arrow colour", "default": "#f6a27c" },
    { "type": "header", "content": "Featured card" },
    { "type": "text", "id": "card_eyebrow", "label": "Small label", "default": "Start here" },
    { "type": "text", "id": "card_title", "label": "Title", "default": "Your main offer" },
    { "type": "richtext", "id": "card_text", "label": "Text", "default": "<p>Two or three lines on what it is and who it is for.</p>" },
    { "type": "text", "id": "card_button_label", "label": "Button label", "default": "Take a look" },
    { "type": "url", "id": "card_button_link", "label": "Button link" },
    { "type": "color", "id": "button_color", "label": "Button colour", "default": "#5ec3ea" },
    { "type": "color", "id": "button_text_color", "label": "Button text colour", "default": "#1c1b2b" },
    { "type": "image_picker", "id": "card_image", "label": "Picture" },
    { "type": "text", "id": "card_image_alt", "label": "Alt text" },
    { "type": "select", "id": "image_ratio", "label": "Picture shape", "options": [ { "value": "4 / 3", "label": "Landscape" }, { "value": "1 / 1", "label": "Square" }, { "value": "16 / 10", "label": "Wide" } ], "default": "4 / 3" },
    { "type": "header", "content": "Press" },
    { "type": "text", "id": "press_label", "label": "Label above the logos", "default": "As featured in" },
    { "type": "header", "content": "Size and space" },
    { "type": "range", "id": "heading_size", "label": "Heading size, desktop", "min": 40, "max": 120, "step": 2, "unit": "px", "default": 84 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size, phone", "min": 28, "max": 64, "step": 2, "unit": "px", "default": 44 },
    { "type": "range", "id": "text_size", "label": "Introduction size, desktop", "min": 15, "max": 28, "step": 1, "unit": "px", "default": 21 },
    { "type": "range", "id": "text_size_mobile", "label": "Introduction size, phone", "min": 14, "max": 22, "step": 1, "unit": "px", "default": 18 },
    { "type": "range", "id": "padding_top", "label": "Space above, desktop", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 12 },
    { "type": "range", "id": "padding_bottom", "label": "Space below, desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_top_mobile", "label": "Space above, phone", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 8 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Space below, phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Press logo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Logo" },
        { "type": "text", "id": "alt", "label": "Name of the publication" },
        { "type": "url", "id": "link", "label": "Link to the piece" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Creator hello",
      "blocks": [ { "type": "logo" }, { "type": "logo" }, { "type": "logo" }, { "type": "logo" } ]
    }
  ]
}
{% endschema %}
