{%- comment -%}
  Digital Renaissance: student results as a carousel. Each result (a block)
  is a dark card: the result in a short bold line, the student's words,
  their face, name and business, and a "Sample" tag while it is only there
  to show the layout. Swipes on a phone; arrows and a progress line on a
  computer. A small line under it says results vary.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
-%}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap">
<style>
  #shopify-section-{{ sid }} .rnr { --gold: {{ st.gold | default: '#f2bd4f' }}; --lapis: {{ st.accent | default: '#3d5afe' }}; position: relative; overflow: hidden; background: {{ st.background | default: '#07080d' }}; color: {{ st.text_color | default: '#a7adbf' }}; padding: {{ st.padding_top_mobile | default: 56 }}px 0 {{ st.padding_bottom_mobile | default: 56 }}px; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .rnr { padding: {{ st.padding_top | default: 112 }}px 0 {{ st.padding_bottom | default: 112 }}px; } }
  #shopify-section-{{ sid }} .rnr::before { content: ""; position: absolute; left: 50%; bottom: -380px; width: 1200px; height: 700px; transform: translateX(-50%); background: radial-gradient(closest-side, color-mix(in srgb, var(--lapis) 26%, transparent), transparent); pointer-events: none; }
  #shopify-section-{{ sid }} .rnr__in { position: relative; max-width: 1220px; margin: 0 auto; padding: 0 20px; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .rnr__in { padding: 0 40px; } }
  #shopify-section-{{ sid }} .rnr__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 20px; margin-bottom: 32px; }
  #shopify-section-{{ sid }} .rnr__eyebrow { margin: 0 0 12px; color: var(--gold); font-size: 12px; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; }
  #shopify-section-{{ sid }} .rnr__title { margin: 0; max-width: 15em; color: #fff; font-family: var(--heading-font, sans-serif); font-weight: 600; font-size: 32px; line-height: 1.08; letter-spacing: -.03em; text-wrap: balance; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .rnr__title { font-size: 48px; } }
  #shopify-section-{{ sid }} .rnr__title em { font-family: 'Instrument Serif', Georgia, serif; font-weight: 400; color: var(--gold); }
  #shopify-section-{{ sid }} .rnr__arrows { display: flex; gap: 10px; }
  #shopify-section-{{ sid }} .rnr__arrow { display: grid; place-items: center; width: 50px; height: 50px; border-radius: 12px; border: 1px solid rgba(255,255,255,.14); background: rgba(255,255,255,.03); color: #fff; cursor: pointer; transition: background-color .2s ease, opacity .2s ease; }
  #shopify-section-{{ sid }} .rnr__arrow:hover:not([disabled]) { background: var(--lapis); border-color: var(--lapis); }
  #shopify-section-{{ sid }} .rnr__arrow[disabled] { opacity: .3; cursor: default; }
  #shopify-section-{{ sid }} .rnr__arrow svg { width: 18px; height: 18px; }
  #shopify-section-{{ sid }} .rnr__track { display: flex; gap: 14px; margin: 0 -20px; padding: 4px 20px 6px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding: 0 20px; scrollbar-width: none; overscroll-behavior-x: contain; }
  #shopify-section-{{ sid }} .rnr__track::-webkit-scrollbar { display: none; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .rnr__track { gap: 20px; margin: 0; padding: 4px 0 6px; scroll-padding: 0; } }
  #shopify-section-{{ sid }} .rnr__card { flex: 0 0 86%; scroll-snap-align: start; display: flex; flex-direction: column; margin: 0; padding: 26px 24px 24px; border-radius: 18px; border: 1px solid rgba(255,255,255,.09); background: linear-gradient(180deg, #12141d, #0c0d14); }
  @media (min-width: 750px) { #shopify-section-{{ sid }} .rnr__card { flex-basis: calc((100% - 14px) / 2); } }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .rnr__card { flex-basis: calc((100% - 40px) / 3); padding: 30px 28px 26px; } }
  #shopify-section-{{ sid }} .rnr__top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; }
  #shopify-section-{{ sid }} .rnr__stars { display: flex; gap: 2px; color: var(--gold); }
  #shopify-section-{{ sid }} .rnr__stars svg { width: 15px; height: 15px; }
  #shopify-section-{{ sid }} .rnr__sample { padding: 4px 9px; border-radius: 999px; border: 1px solid rgba(255,255,255,.14); color: #9aa0b2; font-size: 11.5px; font-weight: 500; }
  #shopify-section-{{ sid }} .rnr__result { margin: 0 0 12px; color: #fff; font-family: var(--heading-font, sans-serif); font-size: 21px; font-weight: 600; line-height: 1.2; letter-spacing: -.02em; }
  #shopify-section-{{ sid }} .rnr__quote { flex: 1 1 auto; margin: 0; padding: 0; border: 0; background: none; color: #c3c7d4; font-size: 15.5px; line-height: 1.6; quotes: none; }
  #shopify-section-{{ sid }} .rnr__who { display: flex; align-items: center; gap: 12px; margin-top: 22px; padding-top: 18px; border-top: 1px solid rgba(255,255,255,.08); }
  #shopify-section-{{ sid }} .rnr__av { flex: 0 0 auto; display: grid; place-items: center; width: 46px; height: 46px; border-radius: 50%; overflow: hidden; background: #1c2040; color: #fff; font-weight: 600; box-shadow: 0 0 0 2px #0c0d14, 0 0 0 3px color-mix(in srgb, var(--lapis) 70%, transparent); }
  #shopify-section-{{ sid }} .rnr__av img { width: 100%; height: 100%; object-fit: cover; }
  #shopify-section-{{ sid }} .rnr__name { display: block; color: #fff; font-size: 15px; font-weight: 600; }
  #shopify-section-{{ sid }} .rnr__role { display: block; font-size: 13px; color: #8a90a3; }
  #shopify-section-{{ sid }} .rnr__bar { position: relative; height: 2px; margin-top: 26px; border-radius: 2px; background: rgba(255,255,255,.1); overflow: hidden; }
  #shopify-section-{{ sid }} .rnr__fill { position: absolute; top: 0; bottom: 0; left: 0; width: 34%; background: var(--gold); transition: left .35s ease, width .35s ease; }
  #shopify-section-{{ sid }} .rnr__foot { margin: 20px auto 0; max-width: 60em; text-align: center; font-size: 12.5px; line-height: 1.5; color: #7a8094; }
</style>
<section data-own-size class="rnr"{% if st.anchor != blank %} id="{{ st.anchor | handleize }}"{% endif %}>
  <div class="rnr__in">
    <div class="rnr__head">
      <div>
        {%- if st.eyebrow != blank -%}<p class="rnr__eyebrow">{{ st.eyebrow | escape }}</p>{%- endif -%}
        {%- if st.heading != blank -%}<h2 class="rnr__title">{{ st.heading }}</h2>{%- endif -%}
      </div>
      <div class="rnr__arrows">
        <button type="button" class="rnr__arrow" data-rnr-prev aria-label="{{ st.prev_label | default: 'Previous' | escape }}"><svg viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.5 9h-11M8 4.5 3.5 9 8 13.5"/></svg></button>
        <button type="button" class="rnr__arrow" data-rnr-next aria-label="{{ st.next_label | default: 'Next' | escape }}"><svg viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.5 9h11M10 4.5 14.5 9 10 13.5"/></svg></button>
      </div>
    </div>
    <div class="rnr__track" data-rnr-track tabindex="0" role="region" aria-label="{{ st.heading | strip_html | escape }}">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <figure class="rnr__card" {{ block.shopify_attributes }}>
          <div class="rnr__top">
            <span class="rnr__stars" aria-hidden="true">{%- for i in (1..5) -%}<svg viewBox="0 0 16 16" fill="currentColor"><path d="M8 1.2l2 4.3 4.7.5-3.5 3.2 1 4.6L8 11.5l-4.2 2.3 1-4.6L1.3 6l4.7-.5z"/></svg>{%- endfor -%}</span>
            {%- if b.sample -%}<span class="rnr__sample">{{ st.sample_label | default: 'Sample' | escape }}</span>{%- endif -%}
          </div>
          {%- if b.result != blank -%}<p class="rnr__result">{{ b.result | escape }}</p>{%- endif -%}
          <blockquote class="rnr__quote">{{ b.quote | escape }}</blockquote>
          <figcaption class="rnr__who">
            <span class="rnr__av">{%- if b.avatar != blank -%}<img src="{{ b.avatar | image_url: width: 120 }}" width="46" height="46" alt="" loading="lazy" decoding="async">{%- else -%}{{ b.name | slice: 0 }}{%- endif -%}</span>
            <span><span class="rnr__name">{{ b.name | escape }}</span>{%- if b.role != blank -%}<span class="rnr__role">{{ b.role | escape }}</span>{%- endif -%}</span>
          </figcaption>
        </figure>
      {%- endfor -%}
    </div>
    <div class="rnr__bar" aria-hidden="true"><span class="rnr__fill" data-rnr-fill></span></div>
    {%- if st.footnote != blank -%}<p class="rnr__foot">{{ st.footnote | escape }}</p>{%- endif -%}
  </div>
</section>
<script>(function(){var r=document.getElementById('shopify-section-{{ sid }}');if(!r)return;var t=r.querySelector('[data-rnr-track]'),p=r.querySelector('[data-rnr-prev]'),n=r.querySelector('[data-rnr-next]'),f=r.querySelector('[data-rnr-fill]');if(!t)return;var raf=0;function step(){var c=t.querySelector('.rnr__card');return c?c.getBoundingClientRect().width+parseFloat(getComputedStyle(t).columnGap||0):t.clientWidth}function upd(){raf=0;var m=t.scrollWidth-t.clientWidth,x=t.scrollLeft;p.disabled=x<=2;n.disabled=x>=m-2;var w=m>0?t.clientWidth/t.scrollWidth:1;f.style.width=(w*100)+'%';f.style.left=(m>0?(x/m)*(1-w)*100:0)+'%'}t.addEventListener('scroll',function(){if(!raf)raf=requestAnimationFrame(upd)},{passive:true});addEventListener('resize',function(){if(!raf)raf=requestAnimationFrame(upd)});var sm=matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth';p.addEventListener('click',function(){t.scrollBy({left:-step(),behavior:sm})});n.addEventListener('click',function(){t.scrollBy({left:step(),behavior:sm})});upd()})();</script>

{% schema %}
{
  "name": "Renaissance student results",
  "tag": "section",
  "class": "renaissance-results-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "anchor", "label": "Name for links to this place", "default": "results" },
    { "type": "text", "id": "eyebrow", "label": "Small line above", "default": "Results" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "What students <em>did next</em>" },
    { "type": "text", "id": "sample_label", "label": "Word on sample results", "default": "Sample" },
    { "type": "text", "id": "footnote", "label": "Small line under the results", "default": "Sample results to show the layout. Replace them with your students' own words, with their permission. Results vary with effort and circumstances." },
    { "type": "text", "id": "prev_label", "label": "Previous button, for screen readers", "default": "Previous result" },
    { "type": "text", "id": "next_label", "label": "Next button, for screen readers", "default": "Next result" },
    { "type": "color", "id": "background", "label": "Background", "default": "#07080d" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#3d5afe" },
    { "type": "color", "id": "gold", "label": "Highlight", "default": "#f2bd4f" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#a7adbf" },
    { "type": "range", "id": "padding_top", "label": "Space above on a computer", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 112 },
    { "type": "range", "id": "padding_bottom", "label": "Space below on a computer", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 112 },
    { "type": "range", "id": "padding_top_mobile", "label": "Space above on a phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Space below on a phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    { "type": "result", "name": "Result", "limit": 12, "settings": [
      { "type": "text", "id": "result", "label": "The result, short", "default": "What changed" },
      { "type": "textarea", "id": "quote", "label": "Their words", "default": "What the student says, in their own words." },
      { "type": "image_picker", "id": "avatar", "label": "Their photo" },
      { "type": "text", "id": "name", "label": "Name", "default": "Student name" },
      { "type": "text", "id": "role", "label": "Line under the name", "default": "Their business" },
      { "type": "checkbox", "id": "sample", "label": "Mark as a sample", "default": true }
    ] }
  ],
  "presets": [ { "name": "Renaissance student results", "category": "Digital Renaissance", "blocks": [ { "type": "result" }, { "type": "result" }, { "type": "result" }, { "type": "result" } ] } ]
}
{% endschema %}
