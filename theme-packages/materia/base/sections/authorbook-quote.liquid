{%- comment -%}
  Author: a passage from the book on a deep band. A large quotation in the
  heading typeface, where it comes from, and a small picture of the cover
  beside it on a computer (above it on a phone). Nothing moves.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign color_scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
-%}
<style>
  #shopify-section-{{ sid }} .abq { background: {{ st.background | default: '#1d2b4f' }}; color: {{ st.text_color | default: '#c9d0e0' }}; padding: {{ st.padding_top_mobile | default: 64 }}px 20px {{ st.padding_bottom_mobile | default: 64 }}px; overflow: hidden; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .abq { padding: {{ st.padding_top | default: 112 }}px 40px {{ st.padding_bottom | default: 112 }}px; } }
  #shopify-section-{{ sid }} .abq__inner { max-width: 1080px; margin: 0 auto; display: grid; grid-template-columns: minmax(0, 1fr); gap: 32px; align-items: center; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .abq__inner { grid-template-columns: 220px minmax(0, 1fr); gap: 80px; } }
  #shopify-section-{{ sid }} .abq__cover { margin: 0; width: 132px; transform: rotate(-3deg); }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .abq__cover { width: 100%; } }
  #shopify-section-{{ sid }} .abq__cover img { display: block; width: 100%; height: auto; margin: 0; border-radius: 2px 5px 5px 2px; box-shadow: 0 24px 50px -18px rgba(0,0,0,0.6); }
  #shopify-section-{{ sid }} .abq__mark { display: block; height: 0.5em; margin-bottom: 4px; color: {{ st.accent_color | default: '#f0643a' }}; font-family: var(--heading-font, inherit); font-size: 96px; line-height: 1; }
  #shopify-section-{{ sid }} .abq__quote { margin: 0; color: {{ st.quote_color | default: '#ffffff' }}; font-family: var(--heading-font, inherit); font-weight: var(--heading-weight, 400); font-size: {{ st.quote_size_mobile | default: 28 }}px; line-height: 1.22; letter-spacing: -0.005em; text-wrap: pretty; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .abq__quote { font-size: {{ st.quote_size | default: 42 }}px; } }
  #shopify-section-{{ sid }} .abq__quote em { font-style: italic; color: {{ st.accent_color | default: '#f0643a' }}; }
  #shopify-section-{{ sid }} .abq__source { margin: 26px 0 0; font-size: 14px; letter-spacing: 0.08em; text-transform: uppercase; }
  #shopify-section-{{ sid }} .abq__source::before { content: ""; display: inline-block; width: 28px; height: 1px; margin: 0 12px 4px 0; background: currentColor; vertical-align: middle; }
</style>
<div class="abq color-{{ color_scheme }}" data-section-id="{{ sid }}">
  <div class="abq__inner">
    {%- if st.image != blank -%}
      <figure class="abq__cover"><img src="{{ st.image | image_url: width: 500 }}" width="500" height="750" alt="{{ st.image_alt | default: st.image.alt | escape }}" loading="lazy" decoding="async"></figure>
    {%- endif -%}
    <figure class="abq__body" style="margin:0">
      <span class="abq__mark" aria-hidden="true">&ldquo;</span>
      {%- if st.quote != blank -%}<p class="abq__quote">{{ st.quote }}</p>{%- endif -%}
      {%- if st.source != blank -%}<p class="abq__source">{{ st.source | escape }}</p>{%- endif -%}
    </figure>
  </div>
</div>
{% schema %}
{
  "name": "Author quote",
  "tag": "section",
  "class": "section sec__authorbook-quote",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default-color-scheme" },
    { "type": "color", "id": "background", "label": "Background", "default": "#1d2b4f" },
    { "type": "color", "id": "quote_color", "label": "Quotation colour", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Source colour", "default": "#c9d0e0" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#f0643a" },
    { "type": "image_picker", "id": "image", "label": "Cover" },
    { "type": "text", "id": "image_alt", "label": "Alt text" },
    { "type": "inline_richtext", "id": "quote", "label": "Quotation", "default": "A line from the book that a reader would <em>underline</em>." },
    { "type": "text", "id": "source", "label": "Where it is from", "default": "From chapter three" },
    { "type": "range", "id": "quote_size", "label": "Quotation size, desktop", "min": 24, "max": 64, "step": 2, "unit": "px", "default": 42 },
    { "type": "range", "id": "quote_size_mobile", "label": "Quotation size, phone", "min": 20, "max": 40, "step": 2, "unit": "px", "default": 28 },
    { "type": "range", "id": "padding_top", "label": "Space above, desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 112 },
    { "type": "range", "id": "padding_bottom", "label": "Space below, desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 112 },
    { "type": "range", "id": "padding_top_mobile", "label": "Space above, phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Space below, phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "presets": [ { "name": "Author quote" } ]
}
{% endschema %}
