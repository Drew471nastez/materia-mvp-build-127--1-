{%- comment -%}
  Creator Landing: "where do you want to start". A two part heading sits at
  the top left, and the cards run in two columns beside and under it, the
  right column starting higher, so the page reads as a staggered wall. Each
  card can carry a small drawn doodle. Hover lifts a card a little; nothing
  moves with reduced motion.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign color_scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
-%}
<style>
  #shopify-section-{{ sid }} .chp {
    --chp-card: {{ st.card_color | default: '#f4f1ec' }};
    --chp-line: {{ st.underline_color | default: '#5ec3ea' }};
    padding: {{ st.padding_top_mobile | default: 56 }}px 16px {{ st.padding_bottom_mobile | default: 56 }}px;
  }
  @media (min-width: 990px) {
    #shopify-section-{{ sid }} .chp { padding: {{ st.padding_top | default: 96 }}px 28px {{ st.padding_bottom | default: 96 }}px; }
  }
  #shopify-section-{{ sid }} .chp__wrap { max-width: 1160px; margin: 0 auto; display: grid; gap: 16px; }
  @media (min-width: 750px) {
    #shopify-section-{{ sid }} .chp__wrap { grid-template-columns: 1fr 1fr; gap: 40px; align-items: start; }
    #shopify-section-{{ sid }} .chp__col { display: grid; gap: 40px; }
  }
  @media (max-width: 749px) { #shopify-section-{{ sid }} .chp__col { display: contents; } }
  #shopify-section-{{ sid }} .chp__col--right { padding-top: 0; }
  @media (min-width: 750px) { #shopify-section-{{ sid }} .chp__col--right { padding-top: 48px; } }
  #shopify-section-{{ sid }} .chp__heading {
    margin: 0 0 24px; color: var(--color-heading);
    font-size: {{ st.heading_size_mobile | default: 40 }}px; line-height: 1.04; letter-spacing: -0.03em;
  }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .chp__heading { font-size: {{ st.heading_size | default: 64 }}px; margin: 0 0 8px; } }
  #shopify-section-{{ sid }} .chp__plain { display: block; font-family: var(--body-font, inherit); font-weight: 400; letter-spacing: -0.04em; }
  #shopify-section-{{ sid }} .chp__serif { position: relative; display: inline-block; font-family: var(--heading-font, inherit); font-weight: var(--heading-font-weight, 600); }
  #shopify-section-{{ sid }} .chp__swash { position: absolute; left: -2%; bottom: -0.18em; width: 104%; height: 0.28em; overflow: visible; }
  #shopify-section-{{ sid }} .chp__swash path { fill: none; stroke: var(--chp-line); stroke-width: 7; stroke-linecap: round; }
  #shopify-section-{{ sid }} .chp__sub { margin: 18px 0 0; color: var(--color-text); font-size: 17px; line-height: 1.5; max-width: 34ch; }
  #shopify-section-{{ sid }} .chp__card {
    display: block; position: relative; background: var(--chp-card); border-radius: 20px;
    padding: 28px 24px; color: inherit; text-decoration: none;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .chp__card { padding: 44px 40px 40px; } }
  #shopify-section-{{ sid }} a.chp__card:hover { transform: translateY(-3px); box-shadow: 0 18px 40px -24px rgba(60,44,20,0.35); }
  #shopify-section-{{ sid }} .chp__doodle { display: block; width: 64px; height: 64px; margin: 0 0 22px; }
  #shopify-section-{{ sid }} .chp__title {
    margin: 0 0 12px; color: var(--color-heading);
    font-family: var(--heading-font, inherit); font-weight: var(--heading-font-weight, 600);
    font-size: 26px; line-height: 1.12; letter-spacing: -0.02em;
  }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .chp__title { font-size: 30px; } }
  #shopify-section-{{ sid }} .chp__text { margin: 0 0 18px; color: var(--color-heading); font-size: 16px; line-height: 1.55; opacity: 0.86; }
  #shopify-section-{{ sid }} .chp__more {
    display: inline-flex; align-items: center; gap: 10px; font-size: 14px; font-weight: 600; color: var(--color-heading);
    text-decoration: underline; text-underline-offset: 4px;
  }
  #shopify-section-{{ sid }} .chp__more svg { width: 14px; height: 14px; transition: transform 0.2s ease; }
  #shopify-section-{{ sid }} a.chp__card:hover .chp__more svg { transform: translateX(3px); }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .chp__card, #shopify-section-{{ sid }} .chp__more svg { transition: none; }
    #shopify-section-{{ sid }} a.chp__card:hover { transform: none; }
  }
</style>

{%- capture arrow -%}<svg viewBox="0 0 14 14" fill="none" aria-hidden="true" focusable="false"><path d="M1 7h11M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>{%- endcapture -%}

{%- capture heading -%}
  <div class="chp__head">
    <h2 class="chp__heading">
      {%- if st.heading_plain != blank -%}<span class="chp__plain">{{ st.heading_plain | escape }}</span>{%- endif -%}
      {%- if st.heading_serif != blank -%}<span class="chp__serif">{{ st.heading_serif | escape }}<svg class="chp__swash" viewBox="0 0 400 30" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M4 18 C 120 6, 260 6, 396 16"/></svg></span>{%- endif -%}
    </h2>
    {%- if st.text != blank -%}<p class="chp__sub">{{ st.text | escape }}</p>{%- endif -%}
  </div>
{%- endcapture -%}

<div class="chp color-{{ color_scheme }}" data-section-id="{{ sid }}">
  <div class="chp__wrap">
    {%- for side in (1..2) -%}
      <div class="chp__col chp__col--{% if side == 1 %}left{% else %}right{% endif %}">
        {%- if side == 1 -%}{{ heading }}{%- endif -%}
        {%- for block in section.blocks -%}
          {%- assign m = forloop.index0 | modulo: 2 -%}
          {%- assign show = true -%}
          {%- if side == 1 and m == 0 -%}{%- assign show = false -%}{%- endif -%}
          {%- if side == 2 and m == 1 -%}{%- assign show = false -%}{%- endif -%}
          {%- if show -%}
          {%- assign b = block.settings -%}
          {%- if b.link != blank -%}<a class="chp__card" href="{{ b.link }}" style="order: {{ forloop.index }}" {{ block.shopify_attributes }}>{%- else -%}<div class="chp__card" style="order: {{ forloop.index }}" {{ block.shopify_attributes }}>{%- endif -%}
            {%- assign dc = b.doodle_color | default: '#f6a27c' -%}
            {%- case b.doodle -%}
              {%- when 'pencil' -%}<svg class="chp__doodle" viewBox="0 0 64 64" fill="none" aria-hidden="true" focusable="false"><path d="M12 52l6-16 26-26 10 10-26 26-16 6z" fill="{{ dc }}" stroke="#1c1b2b" stroke-width="2.4" stroke-linejoin="round"/><path d="M38 16l10 10M18 36l10 10" stroke="#1c1b2b" stroke-width="2.4"/><path d="M12 52l3-8 5 5z" fill="#1c1b2b"/><path d="M50 50c3-2 6-2 8 0" stroke="#1c1b2b" stroke-width="2.4" stroke-linecap="round"/></svg>
              {%- when 'cup' -%}<svg class="chp__doodle" viewBox="0 0 64 64" fill="none" aria-hidden="true" focusable="false"><path d="M12 28h34v8c0 10-7 18-17 18S12 46 12 36z" fill="{{ dc }}" stroke="#1c1b2b" stroke-width="2.4" stroke-linejoin="round"/><path d="M46 31c6 0 8 3 8 6s-3 7-9 7" stroke="#1c1b2b" stroke-width="2.4" stroke-linecap="round"/><path d="M22 20c-2-3 2-5 0-9M30 20c-2-3 2-5 0-9M38 20c-2-3 2-5 0-9" stroke="#1c1b2b" stroke-width="2.4" stroke-linecap="round"/></svg>
              {%- when 'pin' -%}<svg class="chp__doodle" viewBox="0 0 64 64" fill="none" aria-hidden="true" focusable="false"><path d="M32 58S14 38 14 26a18 18 0 0136 0c0 12-18 32-18 32z" fill="{{ dc }}" stroke="#1c1b2b" stroke-width="2.4" stroke-linejoin="round"/><circle cx="32" cy="26" r="7" fill="#fff" stroke="#1c1b2b" stroke-width="2.4"/><path d="M6 58h52" stroke="#1c1b2b" stroke-width="2.4" stroke-linecap="round" stroke-dasharray="4 6"/></svg>
              {%- when 'brush' -%}<svg class="chp__doodle" viewBox="0 0 64 64" fill="none" aria-hidden="true" focusable="false"><circle cx="20" cy="44" r="12" fill="{{ dc }}" opacity="0.9"/><circle cx="40" cy="48" r="9" fill="#5ec3ea" opacity="0.75"/><path d="M52 8L30 34" stroke="#1c1b2b" stroke-width="5" stroke-linecap="round"/><path d="M30 34c-5 0-9 4-9 9 5 0 10-3 11-7z" fill="#1c1b2b"/></svg>
              {%- when 'book' -%}<svg class="chp__doodle" viewBox="0 0 64 64" fill="none" aria-hidden="true" focusable="false"><path d="M8 14c9-3 17-2 24 3v36c-7-5-15-6-24-3z" fill="{{ dc }}" stroke="#1c1b2b" stroke-width="2.4" stroke-linejoin="round"/><path d="M56 14c-9-3-17-2-24 3v36c7-5 15-6 24-3z" fill="#fff" stroke="#1c1b2b" stroke-width="2.4" stroke-linejoin="round"/><path d="M38 26c4-1 8-1 12 0M38 33c4-1 8-1 12 0" stroke="#1c1b2b" stroke-width="2" stroke-linecap="round"/></svg>
              {%- when 'sun' -%}<svg class="chp__doodle" viewBox="0 0 64 64" fill="none" aria-hidden="true" focusable="false"><circle cx="32" cy="32" r="12" fill="{{ dc }}" stroke="#1c1b2b" stroke-width="2.4"/><path d="M32 6v8M32 50v8M6 32h8M50 32h8M13 13l6 6M45 45l6 6M13 51l6-6M45 19l6-6" stroke="#1c1b2b" stroke-width="2.4" stroke-linecap="round"/></svg>
            {%- endcase -%}
            {%- if b.title != blank -%}<h3 class="chp__title">{{ b.title | escape }}</h3>{%- endif -%}
            {%- if b.text != blank -%}<p class="chp__text">{{ b.text | escape }}</p>{%- endif -%}
            {%- if b.link_label != blank -%}<span class="chp__more">{{ b.link_label | escape }}{{ arrow }}</span>{%- endif -%}
          {%- if b.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Creator help",
  "tag": "section",
  "class": "section sec__creator-help",
  "max_blocks": 8,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default-color-scheme" },
    { "type": "text", "id": "heading_plain", "label": "Heading, plain line", "default": "Where should" },
    { "type": "text", "id": "heading_serif", "label": "Heading, underlined line", "default": "you start?" },
    { "type": "color", "id": "underline_color", "label": "Underline colour", "default": "#5ec3ea" },
    { "type": "text", "id": "text", "label": "Line under the heading" },
    { "type": "color", "id": "card_color", "label": "Card colour", "default": "#f4f1ec" },
    { "type": "range", "id": "heading_size", "label": "Heading size, desktop", "min": 32, "max": 96, "step": 2, "unit": "px", "default": 64 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size, phone", "min": 24, "max": 56, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_top", "label": "Space above, desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Space below, desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_top_mobile", "label": "Space above, phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Space below, phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "select", "id": "doodle", "label": "Doodle", "options": [ { "value": "none", "label": "None" }, { "value": "pencil", "label": "Pencil" }, { "value": "cup", "label": "Cup" }, { "value": "pin", "label": "Map pin" }, { "value": "brush", "label": "Brush and paint" }, { "value": "book", "label": "Open book" }, { "value": "sun", "label": "Sun" } ], "default": "pencil" },
        { "type": "color", "id": "doodle_color", "label": "Doodle colour", "default": "#f6a27c" },
        { "type": "text", "id": "title", "label": "Title", "default": "A way in" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "One or two lines on who this is for." },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Get started" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Creator help",
      "blocks": [ { "type": "card" }, { "type": "card" }, { "type": "card" } ]
    }
  ]
}
{% endschema %}
