{%- comment -%}
  Merch template: a tall picture with a pale text panel laid over its edge,
  holding a small line, an uppercase heading, a paragraph and an outline
  button. On a phone the panel sits under the picture. Nothing moves.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign placeholder = 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 400 500%22%3E%3Crect width=%22400%22 height=%22500%22 fill=%22%23ececec%22/%3E%3C/svg%3E'
-%}
<style>
  #shopify-section-{{ sid }} .mit { background: {{ st.background | default: '#ffffff' }}; padding: {{ st.padding_mobile | default: 40 }}px 16px; }
  #shopify-section-{{ sid }} .mit__inner { max-width: 1120px; margin: 0 auto; display: grid; grid-template-columns: 1fr; }
  #shopify-section-{{ sid }} .mit__media { position: relative; aspect-ratio: 4 / 5; overflow: hidden; background: #ececec; }
  #shopify-section-{{ sid }} .mit__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; margin: 0; }
  #shopify-section-{{ sid }} .mit__panel { background: {{ st.panel_color | default: '#f6f6f6' }}; padding: 32px 22px; display: flex; flex-direction: column; gap: 14px; color: {{ st.text_color | default: '#3d3d3d' }}; }
  #shopify-section-{{ sid }} .mit__eyebrow { margin: 0; font-size: 13px; color: inherit; }
  #shopify-section-{{ sid }} .mit__heading { margin: 0; font-family: var(--heading-font, inherit); font-weight: {{ st.heading_weight | default: 800 }}; text-transform: {{ st.heading_case | default: 'uppercase' }}; letter-spacing: -0.01em; line-height: 1.02; color: {{ st.heading_color | default: '#111111' }}; font-size: {{ st.heading_size_mobile | default: 30 }}px; }
  #shopify-section-{{ sid }} .mit__text { font-size: 15px; line-height: 1.65; color: inherit; }
  #shopify-section-{{ sid }} .mit__text p { margin: 0; }
  #shopify-section-{{ sid }} .mit__button { margin-top: 6px; }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .mit { padding: {{ st.padding | default: 56 }}px 32px; }
    #shopify-section-{{ sid }} .mit__inner { grid-template-columns: 45% 55%; align-items: center; }
    #shopify-section-{{ sid }} .mit__panel { margin-left: -40px; position: relative; z-index: 1; padding: 64px 56px; }
    #shopify-section-{{ sid }} .mit__heading { font-size: {{ st.heading_size | default: 44 }}px; }
    #shopify-section-{{ sid }} .mit__inner[data-image="right"] .mit__media { order: 2; }
    #shopify-section-{{ sid }} .mit__inner[data-image="right"] { grid-template-columns: 55% 45%; }
    #shopify-section-{{ sid }} .mit__inner[data-image="right"] .mit__panel { margin-left: 0; margin-right: -40px; }
  }
</style>

<div class="mit">
  <div class="mit__inner" data-image="{{ st.image_position | default: 'left' }}">
    <div class="mit__media">
      {%- if st.image != blank -%}
        <img
          src="{{ st.image | image_url: width: 1200 }}"
          srcset="{{ st.image | image_url: width: 600 }} 600w, {{ st.image | image_url: width: 1000 }} 1000w, {{ st.image | image_url: width: 1400 }} 1400w"
          sizes="(min-width: 768px) 45vw, 100vw"
          width="{{ st.image.width | default: 1200 }}" height="{{ st.image.height | default: 1500 }}"
          alt="{{ st.image_alt | default: st.image.alt | escape }}"
          style="object-position: {{ st.focal_x | default: 50 }}% {{ st.focal_y | default: 40 }}%;"
          loading="lazy" decoding="async">
      {%- else -%}
        <img src="{{ placeholder }}" alt="" width="400" height="500">
      {%- endif -%}
    </div>
    <div class="mit__panel">
      {%- if st.eyebrow != blank -%}<p class="mit__eyebrow">{{ st.eyebrow | escape }}</p>{%- endif -%}
      {%- if st.heading != blank -%}<h2 class="mit__heading">{{ st.heading | escape }}</h2>{%- endif -%}
      {%- if st.text != blank -%}<div class="mit__text">{{ st.text }}</div>{%- endif -%}
      {%- if st.button_label != blank -%}<div class="mit__button"><a class="button inline-block btn-secondary" href="{{ st.button_link | default: '/collections/all' }}">{{ st.button_label | escape }}</a></div>{%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Picture with text panel",
  "tag": "section",
  "class": "section sec__merch-image-text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Picture" },
    { "type": "text", "id": "image_alt", "label": "Alt text" },
    { "type": "range", "id": "focal_x", "label": "Focal point, across", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
    { "type": "range", "id": "focal_y", "label": "Focal point, down", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 40 },
    { "type": "select", "id": "image_position", "label": "Picture", "options": [ { "value": "left", "label": "On the left" }, { "value": "right", "label": "On the right" } ], "default": "left" },
    { "type": "text", "id": "eyebrow", "label": "Small line above" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Wear your attitude" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Two or three lines about how the clothes are cut and who they are for.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore the collection" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "select", "id": "heading_case", "label": "Heading letters", "options": [ { "value": "uppercase", "label": "Capitals" }, { "value": "none", "label": "As typed" } ], "default": "uppercase" },
    { "type": "select", "id": "heading_weight", "label": "Heading weight", "options": [ { "value": "400", "label": "Regular" }, { "value": "600", "label": "Semi bold" }, { "value": "800", "label": "Extra bold" } ], "default": "800" },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "panel_color", "label": "Panel", "default": "#f6f6f6" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#111111" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#3d3d3d" },
    { "type": "range", "id": "heading_size", "label": "Heading size, desktop", "min": 24, "max": 72, "step": 2, "unit": "px", "default": 44 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size, phone", "min": 20, "max": 44, "step": 2, "unit": "px", "default": 30 },
    { "type": "range", "id": "padding", "label": "Space above and below, desktop", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_mobile", "label": "Space above and below, phone", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 }
  ],
  "presets": [ { "name": "Picture with text panel" } ]
}
{% endschema %}
