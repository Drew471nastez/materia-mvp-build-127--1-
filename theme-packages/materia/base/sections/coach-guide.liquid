{%- comment -%}
  Coach: a free guide in exchange for an email. A picture beside a small
  label, a heading with italic words, a line or two, a short list of what
  is inside, and an email field with its button on one line (stacked on a
  phone). Sign-ups reach the store's subscribers with the tag set below.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign color_scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
  assign placeholder = 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 800 600%22%3E%3Crect width=%22800%22 height=%22600%22 fill=%22%23eadfd1%22/%3E%3C/svg%3E'
  assign points = st.points | newline_to_br | split: '<br />'
-%}
{%- assign coach_hf = settings.font_heading_google_family -%}
{%- if coach_hf != blank and coach_hf != 'none' -%}<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ coach_hf | replace: ' ', '+' }}:ital@1&display=swap">{%- endif -%}
<style>
  #shopify-section-{{ sid }} .cgd {
    --cgd-accent: {{ st.accent_color | default: '#a5582a' }};
    --cgd-btn: {{ st.button_color | default: '#a5582a' }};
    background: {{ st.background | default: '#f2e8dc' }};
    padding: {{ st.padding_top_mobile | default: 56 }}px 20px {{ st.padding_bottom_mobile | default: 56 }}px;
  }
  @media (min-width: 990px) {
    #shopify-section-{{ sid }} .cgd { padding: {{ st.padding_top | default: 88 }}px 40px {{ st.padding_bottom | default: 88 }}px; }
  }
  #shopify-section-{{ sid }} .cgd__inner {
    max-width: 1120px; margin: 0 auto;
    display: grid; grid-template-columns: minmax(0, 1fr); gap: 32px; align-items: center;
  }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .cgd__inner { grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: 80px; } }
  #shopify-section-{{ sid }} .cgd__media { margin: 0; position: relative; aspect-ratio: 9 / 8; overflow: hidden; border-radius: 4px; background: #eadfd1; }
  #shopify-section-{{ sid }} .cgd__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; margin: 0; }
  #shopify-section-{{ sid }} .cgd__eyebrow { margin: 0 0 14px; color: var(--cgd-accent); font-size: 12px; font-weight: 500; letter-spacing: 0.2em; text-transform: uppercase; }
  #shopify-section-{{ sid }} .cgd__heading {
    margin: 0 0 16px; color: var(--color-heading);
    font-family: var(--heading-font, inherit); font-weight: var(--heading-weight, 500);
    font-size: {{ st.heading_size_mobile | default: 34 }}px; line-height: 1.12;
  }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .cgd__heading { font-size: {{ st.heading_size | default: 44 }}px; } }
  #shopify-section-{{ sid }} .cgd__heading em { font-style: italic; color: var(--cgd-accent); }
  #shopify-section-{{ sid }} .cgd__text { color: var(--color-text); font-size: 16px; line-height: 1.7; max-width: 50ch; }
  #shopify-section-{{ sid }} .cgd__text p { margin: 0 0 12px; }
  #shopify-section-{{ sid }} .cgd__points { list-style: none; margin: 14px 0 26px; padding: 0; display: grid; gap: 10px; }
  #shopify-section-{{ sid }} .cgd__points li { position: relative; padding-left: 28px; color: var(--color-heading); font-size: 15.5px; line-height: 1.5; }
  #shopify-section-{{ sid }} .cgd__points li::before {
    content: ""; position: absolute; left: 2px; top: 6px; width: 12px; height: 7px;
    border-left: 1.5px solid var(--cgd-accent); border-bottom: 1.5px solid var(--cgd-accent); transform: rotate(-45deg);
  }
  #shopify-section-{{ sid }} .cgd__form { max-width: 520px; }
  #shopify-section-{{ sid }} .cgd__row { display: flex; flex-direction: column; gap: 10px; }
  @media (min-width: 600px) { #shopify-section-{{ sid }} .cgd__row { flex-direction: row; gap: 0; } }
  #shopify-section-{{ sid }} .cgd__input {
    flex: 1 1 auto; min-width: 0; height: 52px; margin: 0; padding: 0 18px;
    border: 1px solid {{ st.field_border | default: '#d6c3ad' }}; border-radius: 2px; background: #fffdf9; color: var(--color-heading);
    font: inherit; font-size: 15px;
  }
  @media (min-width: 600px) { #shopify-section-{{ sid }} .cgd__input { border-right: 0; border-radius: 2px 0 0 2px; } }
  #shopify-section-{{ sid }} .cgd__input:focus-visible { outline: 2px solid var(--color-heading); outline-offset: 1px; }
  #shopify-section-{{ sid }} .cgd__submit {
    flex: 0 0 auto; height: 52px; margin: 0; padding: 0 24px; border: 1px solid var(--cgd-btn); border-radius: 2px;
    background: var(--cgd-btn); color: {{ st.button_text_color | default: '#ffffff' }}; cursor: pointer;
    font: inherit; font-size: 12.5px; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; white-space: nowrap;
    transition: background-color 0.25s ease, border-color 0.25s ease;
  }
  @media (min-width: 600px) { #shopify-section-{{ sid }} .cgd__submit { border-radius: 0 2px 2px 0; } }
  #shopify-section-{{ sid }} .cgd__submit:hover { background: var(--color-heading); border-color: var(--color-heading); }
  #shopify-section-{{ sid }} .cgd__note { margin: 12px 0 0; color: var(--color-text); font-size: 13px; opacity: 0.85; }
  #shopify-section-{{ sid }} .cgd__msg { margin: 12px 0 0; color: var(--color-heading); font-size: 14px; }
  #shopify-section-{{ sid }} .cgd__hp, #shopify-section-{{ sid }} .cgd__vh { position: absolute !important; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
</style>

<div class="cgd color-{{ color_scheme }}" data-section-id="{{ sid }}">
  <div class="cgd__inner">
    <figure class="cgd__media">
      {%- if st.image != blank -%}
        <img src="{{ st.image | image_url: width: 900 }}" srcset="{{ st.image | image_url: width: 500 }} 500w, {{ st.image | image_url: width: 900 }} 900w" sizes="(min-width: 990px) 520px, 92vw" width="{{ st.image.width | default: 900 }}" height="{{ st.image.height | default: 800 }}" alt="{{ st.image_alt | default: st.image.alt | escape }}" loading="lazy" decoding="async">
      {%- else -%}
        <img src="{{ placeholder }}" width="800" height="600" alt="">
      {%- endif -%}
    </figure>
    <div class="cgd__body">
      {%- if st.eyebrow != blank -%}<p class="cgd__eyebrow">{{ st.eyebrow | escape }}</p>{%- endif -%}
      {%- if st.heading != blank -%}<h2 class="cgd__heading">{{ st.heading }}</h2>{%- endif -%}
      {%- if st.text != blank -%}<div class="cgd__text">{{ st.text }}</div>{%- endif -%}
      {%- if st.points != blank -%}
        <ul class="cgd__points">
          {%- for p in points -%}{%- assign line = p | strip -%}{%- if line != blank -%}<li>{{ line | escape }}</li>{%- endif -%}{%- endfor -%}
        </ul>
      {%- endif -%}
      {%- form 'customer', id: 'CoachGuideForm-' | append: sid, class: 'cgd__form', data-storelib-form: 'subscribe' -%}
        <input type="hidden" name="contact[tags]" value="{{ st.tag | default: 'newsletter' | escape }}">
        <span hidden data-mt-words data-success-message="{{ st.success_text | default: 'Thank you. The guide is on its way to your inbox.' | escape }}" data-invalid-message="{{ st.invalid_text | default: 'Enter a valid email address.' | escape }}"></span>
        <div class="cgd__hp" aria-hidden="true" data-mt-trap>
          <label for="CoachGuideHp-{{ sid }}">Leave this field empty</label>
          <input id="CoachGuideHp-{{ sid }}" type="text" name="company" tabindex="-1" autocomplete="off" pattern="^$" maxlength="0" value="">
        </div>
        <div class="cgd__row">
          <label class="cgd__vh" for="CoachGuideEmail-{{ sid }}">{{ st.email_placeholder | default: 'Your email' | escape }}</label>
          <input class="cgd__input" id="CoachGuideEmail-{{ sid }}" type="email" name="contact[email]" required inputmode="email" autocomplete="email" autocapitalize="off" spellcheck="false" maxlength="254" placeholder="{{ st.email_placeholder | default: 'Your email' | escape }}">
          <button type="submit" class="cgd__submit">{{ st.button_label | default: 'Send me the guide' | escape }}</button>
        </div>
        {%- if form.posted_successfully? -%}<p class="cgd__msg form-status--success">{{ st.success_text | default: 'Thank you. The guide is on its way to your inbox.' | escape }}</p>{%- endif -%}
        {%- if form.errors -%}<p class="cgd__msg" role="alert">{{ st.invalid_text | default: 'Enter a valid email address.' | escape }}</p>{%- endif -%}
      {%- endform -%}
      {%- if st.note != blank -%}<p class="cgd__note">{{ st.note | escape }}</p>{%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Coach free guide",
  "tag": "section",
  "class": "section sec__coach-guide",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default-color-scheme" },
    { "type": "color", "id": "background", "label": "Background", "default": "#f2e8dc" },
    { "type": "color", "id": "accent_color", "label": "Accent colour", "default": "#a5582a" },
    { "type": "image_picker", "id": "image", "label": "Picture" },
    { "type": "text", "id": "image_alt", "label": "Alt text" },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Free guide" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "The seven day <em>clarity reset</em>" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Say what the guide is and what someone will know after it.</p>" },
    { "type": "textarea", "id": "points", "label": "What is inside, one per line", "default": "Ten minutes a day\nPrintable pages\nA simple plan for the month ahead" },
    { "type": "text", "id": "email_placeholder", "label": "Email field", "default": "Your email" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Send me the guide" },
    { "type": "color", "id": "button_color", "label": "Button colour", "default": "#a5582a" },
    { "type": "color", "id": "button_text_color", "label": "Button text colour", "default": "#ffffff" },
    { "type": "color", "id": "field_border", "label": "Field border", "default": "#d6c3ad" },
    { "type": "text", "id": "tag", "label": "Tag for the people who sign up", "default": "free-guide" },
    { "type": "text", "id": "note", "label": "Small note", "default": "One email a week after the guide. Leave whenever you like." },
    { "type": "text", "id": "success_text", "label": "Message after signing up", "default": "Thank you. The guide is on its way to your inbox." },
    { "type": "text", "id": "invalid_text", "label": "Message for an address that will not work", "default": "Enter a valid email address." },
    { "type": "range", "id": "heading_size", "label": "Heading size, desktop", "min": 28, "max": 64, "step": 2, "unit": "px", "default": 44 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size, phone", "min": 24, "max": 44, "step": 2, "unit": "px", "default": 34 },
    { "type": "range", "id": "padding_top", "label": "Space above, desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 88 },
    { "type": "range", "id": "padding_bottom", "label": "Space below, desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 88 },
    { "type": "range", "id": "padding_top_mobile", "label": "Space above, phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Space below, phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "presets": [ { "name": "Coach free guide" } ]
}
{% endschema %}
