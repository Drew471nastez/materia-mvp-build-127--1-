{%- comment -%}
XP shop: the products in a folder window, the way a file browser showed
  them. A blue side panel with links (blocks) and a few details, an address
  line, then the products: picture, name, price, Quick view and Add.

  Quick view opens the product in a window of its own (picture, price, each
  option as buttons, quantity, Add to cart). Add puts a product with one
  choice straight in the cart, then a small window says so and offers the
  cart. Both are <dialog> windows: the keyboard stays inside them and Escape
  closes them. On a phone the side panel's links become a row above the
  products and the dialogs rise from the bottom.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign bar_title = st.title | default: 'Shop'
  assign bar_icon = st.icon | default: 'folder'
  assign coll = st.collection
  assign count = st.products_to_show | default: 8
  assign cols = st.columns | default: 4 | plus: 0
  assign list = collections.all.products
  if coll != blank and coll.products_count > 0
    assign list = coll.products
  endif
  assign view_all = routes.all_products_collection_url | default: '/collections/all'
  if coll != blank and coll.url != blank
    assign view_all = coll.url
  endif
  if st.view_all_link != blank
    assign view_all = st.view_all_link
  endif
  assign shown = 0
  assign current_id = ''
  if request.page_type == 'product' and st.skip_current
    assign current_id = product.id
  endif
  assign pane = false
  if st.show_pane and section.blocks.size > 0
    assign pane = true
  endif
-%}
<style>
