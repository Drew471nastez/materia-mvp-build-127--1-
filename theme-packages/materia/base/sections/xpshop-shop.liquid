<div data-own-font class="xp xp-sec" data-xp-shop data-money="{{ shop.money_format | escape }}">
  <div class="xp-place">
    <section class="xp-win" data-xp-window data-motion aria-labelledby="XpsH-{{ sid }}">
      <div class="xp-bar">
  <svg class="xp-ico" width="20" height="20" aria-hidden="true" focusable="false"><use href="#xpi-{{ bar_icon | default: 'folder' }}-{{ sid }}"/></svg>
  <p class="xp-bar__title">{{ bar_title | escape }}</p>
  <span class="xp-ctls">
    <button class="xp-ctl xp-ctl--opt" type="button" data-xp-min aria-label="Minimise" aria-expanded="true"><svg viewBox="0 0 12 12" aria-hidden="true" focusable="false"><rect x="1" y="8.5" width="7" height="2.5" fill="currentColor"/></svg></button>
    <button class="xp-ctl xp-ctl--opt" type="button" data-xp-max aria-label="Maximise"><svg viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M1 1h10v10H1z" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M1 1h10v2.6H1z" fill="currentColor"/></svg></button>
    <button class="xp-ctl xp-ctl--close" type="button" data-xp-close aria-label="Close"><svg viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="m2 2 8 8M10 2 2 10" stroke="currentColor" stroke-width="2.1" stroke-linecap="round"/></svg></button>
  </span>
</div>

      <div class="xp-body">
        {%- if st.address != blank -%}
          <div class="xps__addr"><b aria-hidden="true">{{ st.address_label | default: 'Address' | escape }}</b><span><svg class="xp-ico" width="24" height="24" aria-hidden="true" focusable="false"><use href="#xpi-folder-{{ sid }}"/></svg>{{ st.address | escape }}</span><a class="xp-btn" href="{{ view_all }}">{{ st.view_all_label | default: 'Go' | escape }}</a></div>
        {%- endif -%}
        <div class="xps__main{% if pane %} xps__main--pane{% endif %}">
          {%- if pane -%}
            <aside class="xps__pane" aria-label="{{ st.pane_title | default: 'Shop tasks' | escape }}">
              <div class="xps__panel">
                <h3>{{ st.pane_title | default: 'Shop tasks' | escape }}<svg viewBox="0 0 18 18" aria-hidden="true" focusable="false"><circle cx="9" cy="9" r="8" fill="#fff" stroke="#9db2e8"/><path d="m5.5 10.5 3.5-3.5 3.5 3.5" fill="none" stroke="#215dc6" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></h3>
                <div class="xps__links">
                  {%- for block in section.blocks -%}
                    <a href="{{ block.settings.link | default: '/collections/all' }}" {{ block.shopify_attributes }}><svg class="xp-ico" aria-hidden="true" focusable="false"><use href="#xpi-{{ block.settings.icon | default: 'folder' }}-{{ sid }}"/></svg><span>{{ block.settings.label | escape }}</span></a>
                  {%- endfor -%}
                </div>
              </div>
              {%- if st.pane_note != blank -%}
                <div class="xps__panel">
                  <h3>{{ st.pane_note_title | default: 'Details' | escape }}<svg viewBox="0 0 18 18" aria-hidden="true" focusable="false"><circle cx="9" cy="9" r="8" fill="#fff" stroke="#9db2e8"/><path d="m5.5 10.5 3.5-3.5 3.5 3.5" fill="none" stroke="#215dc6" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></h3>
                  <p class="xps__note">{%- if st.pane_note_bold != blank -%}<b>{{ st.pane_note_bold | escape }}</b>{%- endif -%}{{ st.pane_note | escape }}</p>
                </div>
              {%- endif -%}
            </aside>
          {%- endif -%}
          <div>
            {%- if st.heading != blank -%}
              <div class="xps__head"><div><h2 class="xp-h xps__h" id="XpsH-{{ sid }}">{{ st.heading | escape }}</h2>{%- if st.subheading != blank -%}<p class="xps__sub">{{ st.subheading | escape }}</p>{%- endif -%}</div></div>
            {%- endif -%}
            <ul class="xps__grid" role="list">
              {%- for product in list limit: count -%}
                {%- if current_id != '' and product.id == current_id -%}{%- continue -%}{%- endif -%}
                {%- assign shown = shown | plus: 1 -%}
                {%- assign img = product.featured_media.preview_image | default: product.featured_image -%}
                {%- assign one = false -%}
                {%- if product.has_only_default_variant or product.variants.size == 1 -%}{%- assign one = true -%}{%- endif -%}
                <li class="xps__card" data-motion style="--d: {{ forloop.index0 | modulo: cols | times: 70 }}ms">
                  <a class="xps__pic" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
                    {%- unless product.available -%}<span class="xps__tag">{{ st.sold_out_label | default: 'Sold out' | escape }}</span>{%- else -%}{%- if product.compare_at_price > product.price -%}<span class="xps__tag xps__tag--sale">{{ st.sale_label | default: 'Sale' | escape }}</span>{%- endif -%}{%- endunless -%}
                    {%- if img != blank -%}{{ img | image_url: width: 900 | image_tag: widths: '300, 450, 600, 900', sizes: '(min-width: 1200px) 260px, (min-width: 750px) 30vw, 46vw', alt: product.title, loading: 'lazy' }}{%- else -%}{{ 'product-1' | placeholder_svg_tag }}{%- endif -%}
                  </a>
                  <a class="xps__name" href="{{ product.url }}">{{ product.title | escape }}</a>
                  <p class="xps__price">{{ product.price | money }}{%- if product.compare_at_price > product.price -%}<s>{{ product.compare_at_price | money }}</s>{%- endif -%}</p>
                  <div class="xps__acts">
                    <button class="xp-btn" type="button" data-xp-quick>{{ st.quick_label | default: 'Quick view' | escape }}</button>
                    <button class="xp-btn xp-btn--go" type="button" data-xp-add{% if one %} data-one{% endif %}{% unless product.available %} disabled{% endunless %}>{{ st.add_label | default: 'Add' | escape }}</button>
                  </div>
                  <script type="application/json" data-xp-product>{"title":{{ product.title | json }},"url":{{ product.url | json }},"image":{% if img != blank %}{{ img | image_url: width: 900 | json }}{% else %}""{% endif %},"options":{{ product.options | json }},"variants":[{%- for v in product.variants -%}{"id":{{ v.id | json }},"title":{{ v.title | json }},"available":{{ v.available | json }},"price":{{ v.price | json }},"compare":{{ v.compare_at_price | default: 0 | json }},"image":{% if v.featured_image != blank %}{{ v.featured_image | image_url: width: 900 | json }}{% else %}""{% endif %},"options":{{ v.options | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]}</script>
                </li>
              {%- endfor -%}
              {%- if shown == 0 -%}
                {%- for i in (1..cols) -%}
                  {%- assign ph = i | modulo: 6 | plus: 1 -%}
                  <li class="xps__card">
                    <span class="xps__pic">{{ 'product-' | append: ph | placeholder_svg_tag }}</span>
                    <span class="xps__name">{{ st.empty_name | default: 'Your product' | escape }}</span>
                    <p class="xps__price">{{ 0 | money }}</p>
                  </li>
                {%- endfor -%}
              {%- endif -%}
            </ul>
            {%- if st.more_label != blank -%}<div class="xps__more"><a class="xp-btn xp-btn--blue" href="{{ view_all }}">{{ st.more_label | escape }}</a></div>{%- endif -%}
          </div>
        </div>
        <div class="xp-status"><span>{%- if shown == 1 -%}1 {{ st.object_label | default: 'item' | escape }}{%- else -%}{{ shown }} {{ st.objects_label | default: 'items' | escape }}{%- endif -%}</span><span>{{ st.status_right | escape }}</span></div>
      </div>
    </section>
  </div>
  {%- assign bar_title = st.quick_label | default: 'Quick view' -%}
  {%- assign bar_icon = 'tee' -%}
  <dialog class="xpd xpd--qv" data-xp-qv aria-labelledby="XpQvT-{{ sid }}">
    <div class="xp-win">
      <div class="xp-bar"><svg class="xp-ico" width="20" height="20" aria-hidden="true" focusable="false"><use href="#xpi-tee-{{ sid }}"/></svg><p class="xp-bar__title" data-xp-qv-bar>{{ bar_title | escape }}</p><span class="xp-ctls"><button class="xp-ctl xp-ctl--close" type="button" data-xp-dismiss aria-label="{{ st.close_label | default: 'Close' | escape }}"><svg viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="m2 2 8 8M10 2 2 10" stroke="currentColor" stroke-width="2.1" stroke-linecap="round"/></svg></button></span></div>
      <div class="xp-body">
        <div class="xpd__qv">
          <div class="xpd__pic"><img alt="" data-xp-qv-img width="900" height="900"></div>
          <div class="xpd__info">
            <h2 class="xp-h xpd__title" id="XpQvT-{{ sid }}" data-xp-qv-title></h2>
            <p class="xpd__price" data-xp-qv-price></p>
            <div class="xpd__opts" data-xp-qv-opts></div>
            <div class="xpd__row">
              <div class="xpd__qty"><label for="XpQty-{{ sid }}">{{ st.qty_label | default: 'Quantity' | escape }}</label><input class="xp-field" id="XpQty-{{ sid }}" type="number" min="1" max="99" value="1" inputmode="numeric" data-xp-qv-qty></div>
              <button class="xp-btn xp-btn--go" type="button" data-xp-qv-add>{{ st.add_cart_label | default: 'Add to cart' | escape }}</button>
            </div>
            <p class="xpd__msg" role="status" data-xp-qv-msg></p>
            <a class="xpd__more" href="#" data-xp-qv-link>{{ st.details_label | default: 'See every detail' | escape }}</a>
          </div>
        </div>
      </div>
    </div>
  </dialog>
  <dialog class="xpd xpd--ok" data-xp-ok aria-labelledby="XpOkT-{{ sid }}">
    <div class="xp-win">
      <div class="xp-bar"><svg class="xp-ico" width="20" height="20" aria-hidden="true" focusable="false"><use href="#xpi-cart-{{ sid }}"/></svg><p class="xp-bar__title" data-xp-ok-bar>{{ st.added_title | default: 'Added to cart' | escape }}</p><span class="xp-ctls"><button class="xp-ctl xp-ctl--close" type="button" data-xp-dismiss aria-label="{{ st.close_label | default: 'Close' | escape }}"><svg viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="m2 2 8 8M10 2 2 10" stroke="currentColor" stroke-width="2.1" stroke-linecap="round"/></svg></button></span></div>
      <div class="xp-body">
        <div class="xpd__ok">
          <span class="xpd__ok-pic"><img alt="" data-xp-ok-img width="128" height="128"></span>
          <div><p class="xpd__ok-h" id="XpOkT-{{ sid }}" data-xp-ok-title>{{ st.added_title | default: 'Added to cart' | escape }}</p><p class="xpd__ok-t" data-xp-ok-text></p></div>
        </div>
        <div class="xpd__acts">
          <button class="xp-btn" type="button" data-xp-dismiss>{{ st.keep_label | default: 'Keep shopping' | escape }}</button>
          <a class="xp-btn xp-btn--go" href="{{ routes.cart_url }}" data-xp-ok-cart>{{ st.view_cart_label | default: 'View cart' | escape }}</a>
        </div>
      </div>
    </div>
  </dialog>
</div>
<script>
  (function () {
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;
    var still = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
    if ('IntersectionObserver' in window && !still && !(window.Shopify && window.Shopify.designMode)) {
      document.documentElement.classList.add('xp-js');
      if (!window.__xpSeen) window.__xpSeen = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('is-in'); window.__xpSeen.unobserve(e.target); } }); }, { rootMargin: '0px 0px -5% 0px', threshold: 0.04 });
      root.querySelectorAll('[data-motion]:not(.is-in)').forEach(function (el) {
        var r = el.getBoundingClientRect();
        if (r.top < innerHeight && r.bottom > 0) { el.classList.add('is-in'); return; }
        window.__xpSeen.observe(el);
      });
    }
    root.querySelectorAll('[data-xp-window]').forEach(function (win) {
      if (win.__xp) return; win.__xp = true;
      var narrow = function () { return window.matchMedia('(max-width: 749px)').matches; };
      var min = win.querySelector('[data-xp-min]'), max = win.querySelector('[data-xp-max]'), close = win.querySelector('[data-xp-close]');
      if (min) min.addEventListener('click', function () { var on = !win.classList.contains('is-min'); win.classList.toggle('is-min', on); min.setAttribute('aria-expanded', on ? 'false' : 'true'); });
      if (max) max.addEventListener('click', function () { win.classList.toggle('is-max'); win.classList.remove('is-min'); });
      if (close) close.addEventListener('click', function () {
        if (narrow() || !window.__xpPark) { win.classList.add('is-min'); return; }
        win.classList.add('is-closing');
        setTimeout(function () { win.classList.remove('is-closing'); win.hidden = true; window.__xpPark(win); }, still ? 0 : 200);
      });
    });
  })();
</script>

<script>
  (function () {
    var root = document.querySelector('#shopify-section-{{ section.id }} [data-xp-shop]');
    if (!root || root.__shop) return; root.__shop = true;
    var qv = root.querySelector('[data-xp-qv]'), ok = root.querySelector('[data-xp-ok]');
    var fmt = root.getAttribute('data-money') || ('$' + '{' + '{amount}' + '}');
    var words = { added: {{ st.added_text | default: '[product] is in your cart.' | json }}, sold: {{ st.unavailable_label | default: 'That one is sold out.' | json }}, err: {{ st.error_label | default: 'That did not work. Try again.' | json }}, addedTitle: {{ st.added_title | default: 'Added to cart' | json }}, errTitle: {{ st.error_title | default: 'Not added' | json }} };
    function money(c) { var a = (Number(c) || 0) / 100; return fmt.replace(/\{\{\s*(\w+)\s*\}\}/, function (_, k) { return /no_decimals/.test(k) ? String(Math.round(a)) : /comma/.test(k) ? a.toFixed(2).replace('.', ',') : a.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ','); }); }
    var opener = null;
    function show(d) { opener = document.activeElement; if (d.showModal) { if (!d.open) d.showModal(); } else d.setAttribute('open', ''); }
    function hide(d) { if (d.close && d.open) d.close(); else d.removeAttribute('open'); }
    [qv, ok].forEach(function (d) {
      d.addEventListener('click', function (e) { if (e.target === d) hide(d); });
      d.addEventListener('close', function () { if (opener && opener.focus && !qv.open && !ok.open) opener.focus({ preventScroll: true }); });
    });
    root.querySelectorAll('[data-xp-dismiss]').forEach(function (b) { b.addEventListener('click', function () { hide(b.closest('dialog')); }); });
    var current = null;
    function chosen() { return [].map.call(qv.querySelectorAll('[data-xp-qv-opts] fieldset'), function (f) { var c = f.querySelector('input:checked'); return c ? c.value : undefined; }); }
    function pick() {
      if (!current) return null;
      var sel = chosen();
      return current.variants.find(function (v) { return !v.options || !v.options.length || v.options.every(function (o, i) { return sel[i] === undefined || o === sel[i]; }); }) || current.variants[0];
    }
    function paint() {
      var v = pick(); if (!v) return;
      var p = qv.querySelector('[data-xp-qv-price]'); p.textContent = money(v.price);
      if (v.compare > v.price) { var s = document.createElement('s'); s.textContent = money(v.compare); p.appendChild(s); }
      var img = qv.querySelector('[data-xp-qv-img]'); var src = v.image || current.image; if (src && img.getAttribute('src') !== src) img.src = src;
      qv.querySelector('[data-xp-qv-add]').disabled = !v.available;
      qv.querySelector('[data-xp-qv-msg]').textContent = v.available ? '' : words.sold;
    }
    function open(data) {
      current = data;
      qv.querySelector('[data-xp-qv-bar]').textContent = data.title;
      qv.querySelector('[data-xp-qv-title]').textContent = data.title;
      var img = qv.querySelector('[data-xp-qv-img]'); if (data.image) { img.src = data.image; img.alt = data.title; img.hidden = false; } else img.hidden = true;
      qv.querySelector('[data-xp-qv-link]').href = data.url;
      qv.querySelector('[data-xp-qv-qty]').value = 1;
      var box = qv.querySelector('[data-xp-qv-opts]'); box.innerHTML = '';
      var names = (data.options || []).filter(function (o) { return o && o !== 'Title'; });
      var first = data.variants.find(function (v) { return v.available; }) || data.variants[0];
      names.forEach(function (name, i) {
        var vals = []; data.variants.forEach(function (v) { var x = v.options && v.options[i]; if (x && vals.indexOf(x) < 0) vals.push(x); });
        if (vals.length < 2 && data.variants.length < 2) return;
        var fs = document.createElement('fieldset'); fs.className = 'xpd__opts xpd__opt';
        var lg = document.createElement('legend'); lg.textContent = name; fs.appendChild(lg);
        var wrap = document.createElement('div'); wrap.className = 'xpd__vals';
        vals.forEach(function (x, j) {
          var lab = document.createElement('label'), inp = document.createElement('input'), sp = document.createElement('span');
          inp.type = 'radio'; inp.name = 'XpOpt-{{ section.id }}-' + i; inp.value = x; inp.checked = first && first.options ? first.options[i] === x : j === 0;
          var any = data.variants.some(function (v) { return v.available && v.options && v.options[i] === x; }); if (!any) inp.classList.add('is-out');
          sp.textContent = x; inp.addEventListener('change', paint); lab.appendChild(inp); lab.appendChild(sp); wrap.appendChild(lab);
        });
        fs.appendChild(wrap); box.appendChild(fs);
      });
      box.hidden = !box.children.length;
      paint(); show(qv);
    }
    function add(v, qty, data, btn) {
      if (btn) btn.disabled = true;
      return fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify({ items: [{ id: v.id, quantity: qty }] }) })
        .then(function (r) { return r.json().catch(function () { return {}; }).then(function (j) { if (!r.ok) { var e = new Error(r.status); e.say = j && (j.description || j.message); throw e; } return j; }); })
        .then(function () {
          hide(qv);
          var name = data.title + (v.title && v.title !== 'Default Title' ? ' (' + v.title + ')' : '');
          ok.classList.remove('is-error');
          ok.querySelector('[data-xp-ok-title]').textContent = words.addedTitle;
          ok.querySelector('[data-xp-ok-bar]').textContent = words.addedTitle;
          ok.querySelector('[data-xp-ok-text]').textContent = words.added.replace('[product]', name);
          var oi = ok.querySelector('[data-xp-ok-img]'); var src = v.image || data.image; if (src) { oi.src = src; oi.parentNode.hidden = false; } else oi.parentNode.hidden = true;
          show(ok); var c = ok.querySelector('[data-xp-ok-cart]'); if (c) c.focus();
          document.dispatchEvent(new CustomEvent('xp:cart')); document.dispatchEvent(new CustomEvent('cart:refresh', { detail: { source: 'xpshop-shop' } }));
        })
        .catch(function (e) {
          var say = (e && e.say) || words.err;
          if (qv.open) { qv.querySelector('[data-xp-qv-msg]').textContent = say; return; }
          ok.classList.add('is-error');
          ok.querySelector('[data-xp-ok-title]').textContent = words.errTitle;
          ok.querySelector('[data-xp-ok-bar]').textContent = words.errTitle;
          ok.querySelector('[data-xp-ok-text]').textContent = say;
          show(ok);
        })
        .then(function () { if (btn) btn.disabled = false; });
    }
    root.querySelectorAll('.xps__card').forEach(function (li) {
      var json = li.querySelector('[data-xp-product]'); if (!json) return;
      var data; try { data = JSON.parse(json.textContent); } catch (e) { return; }
      var q = li.querySelector('[data-xp-quick]'), a = li.querySelector('[data-xp-add]');
      if (q) q.addEventListener('click', function () { open(data); });
      if (a) a.addEventListener('click', function () {
        if (a.hasAttribute('data-one')) { var v = data.variants[0]; if (v && v.available) add(v, 1, data, a); }
        else open(data);
      });
    });
    qv.querySelector('[data-xp-qv-add]').addEventListener('click', function (e) {
      var v = pick(); if (!v || !v.available) return;
      var n = Math.max(1, Math.min(99, parseInt(qv.querySelector('[data-xp-qv-qty]').value, 10) || 1));
      add(v, n, current, e.currentTarget);
    });
  })();
</script>

