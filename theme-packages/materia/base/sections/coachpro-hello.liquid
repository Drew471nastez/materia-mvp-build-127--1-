{%- comment -%}
  Coach creator: hello. A very large two line name ("I'm Camila."), a
  paragraph in the person's own voice, a button, and the places to follow
  them as small icon links (blocks). The portrait stands on the bottom edge
  of the band, as if the person were standing in it.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
-%}
<style>
  #shopify-section-{{ sid }} .cpo { --cpo-accent: {{ st.accent_color | default: '#ff6a3d' }}; background: {{ st.background | default: '#efe6da' }}; color: {{ st.text_color | default: '#4a4038' }}; overflow: hidden; }
  #shopify-section-{{ sid }} .cpo__in { max-width: 1240px; margin: 0 auto; padding: {{ st.padding_top_mobile | default: 64 }}px 20px 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 40px; align-items: end; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .cpo__in { grid-template-columns: minmax(0, 1fr) minmax(0, .9fr); gap: 72px; padding: {{ st.padding_top | default: 96 }}px 40px 0; } }
  #shopify-section-{{ sid }} .cpo__body { padding-bottom: 8px; align-self: center; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .cpo__body { padding-bottom: 96px; } }
  #shopify-section-{{ sid }} .cpo__eyebrow { margin: 0 0 14px; color: var(--cpo-accent); font-size: 12px; font-weight: 700; letter-spacing: .2em; text-transform: uppercase; }
  #shopify-section-{{ sid }} .cpo__name { margin: 0 0 26px; color: {{ st.heading_color | default: '#16120f' }}; font-family: var(--heading-font, serif); font-weight: 400; font-size: {{ st.name_size_mobile | default: 76 }}px; line-height: .86; letter-spacing: -.02em; text-transform: uppercase; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .cpo__name { font-size: {{ st.name_size | default: 136 }}px; } }
  #shopify-section-{{ sid }} .cpo__line { display: block; }
  #shopify-section-{{ sid }} .cpo__name em { font-style: italic; text-transform: none; color: var(--cpo-accent); }
  #shopify-section-{{ sid }} .cpo__text { max-width: 33em; font-size: 17px; line-height: 1.7; }
  #shopify-section-{{ sid }} .cpo__text p { margin: 0 0 14px; }
  #shopify-section-{{ sid }} .cpo__row { display: flex; flex-wrap: wrap; align-items: center; gap: 18px 26px; margin-top: 26px; }
  #shopify-section-{{ sid }} .cpo__btn { display: inline-flex; align-items: center; min-height: 52px; padding: 0 28px; border-radius: 999px; background: {{ st.heading_color | default: '#16120f' }}; color: {{ st.background | default: '#efe6da' }}; font-size: 15.5px; font-weight: 600; text-decoration: none; transition: transform .25s ease; }
  #shopify-section-{{ sid }} .cpo__btn:hover { transform: translateY(-2px); }
  #shopify-section-{{ sid }} .cpo__social { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; padding: 0; list-style: none; }
  #shopify-section-{{ sid }} .cpo__social a { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; border: 1px solid color-mix(in srgb, {{ st.heading_color | default: '#16120f' }} 22%, transparent); color: {{ st.heading_color | default: '#16120f' }}; transition: background-color .25s ease, color .25s ease; }
  #shopify-section-{{ sid }} .cpo__social a:hover { background: {{ st.heading_color | default: '#16120f' }}; color: {{ st.background | default: '#efe6da' }}; }
  #shopify-section-{{ sid }} .cpo__social svg { width: 18px; height: 18px; }
  #shopify-section-{{ sid }} .cpo__handle { font-size: 14px; color: {{ st.heading_color | default: '#16120f' }}; }
  #shopify-section-{{ sid }} .cpo__media { position: relative; margin: 0 auto; width: 100%; max-width: 520px; aspect-ratio: 4 / 5; border-radius: 26px 26px 0 0; overflow: hidden; background: #d9cbb9; }
  #shopify-section-{{ sid }} .cpo__media img, #shopify-section-{{ sid }} .cpo__media svg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  #shopify-section-{{ sid }} .cpo__tag { position: absolute; left: 18px; bottom: 18px; display: inline-flex; align-items: center; gap: 8px; padding: 9px 14px; border-radius: 999px; background: rgba(255,255,255,.92); color: #16120f; font-size: 13px; font-weight: 600; backdrop-filter: blur(6px); }
  #shopify-section-{{ sid }} .cpo__tag::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--cpo-accent); }
  .cpo__vh { position: absolute !important; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
</style>
<section data-own-size class="cpo">
  <div class="cpo__in">
    <div class="cpo__body">
      {%- if st.eyebrow != blank -%}<p class="cpo__eyebrow">{{ st.eyebrow | escape }}</p>{%- endif -%}
      <h2 class="cpo__name"><span class="cpo__line">{{ st.name }}</span>{%- if st.name_second != blank -%}<span class="cpo__line">{{ st.name_second }}</span>{%- endif -%}</h2>
      {%- if st.text != blank -%}<div class="cpo__text">{{ st.text }}</div>{%- endif -%}
      <div class="cpo__row">
        {%- if st.button_label != blank -%}<a class="cpo__btn" href="{{ st.button_link | default: '#' }}">{{ st.button_label | escape }}</a>{%- endif -%}
        {%- if section.blocks.size > 0 -%}
          <ul class="cpo__social">
            {%- for block in section.blocks -%}
              <li {{ block.shopify_attributes }}><a href="{{ block.settings.url | default: '#' }}" target="_blank" rel="noopener"><span class="cpo__vh">{{ block.settings.platform | capitalize }}</span>
                {%- case block.settings.platform -%}
                  {%- when 'instagram' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r="1" fill="currentColor" stroke="none"/></svg>
                  {%- when 'youtube' -%}<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.6 7.2a2.6 2.6 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4A2.6 2.6 0 0 0 2.4 7.2 27 27 0 0 0 2 12a27 27 0 0 0 .4 4.8 2.6 2.6 0 0 0 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4a2.6 2.6 0 0 0 1.8-1.8A27 27 0 0 0 22 12a27 27 0 0 0-.4-4.8zM10 15V9l5.2 3z"/></svg>
                  {%- when 'tiktok' -%}<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.6 3c.3 2.2 1.6 3.6 3.9 3.8v3a7 7 0 0 1-3.8-1.2v6.1A5.8 5.8 0 1 1 10.9 9v3.1a2.8 2.8 0 1 0 2 2.7V3z"/></svg>
                  {%- when 'linkedin' -%}<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.5 9h3v11h-3zM6 3.8a1.8 1.8 0 1 1 0 3.6 1.8 1.8 0 0 1 0-3.6zM10 9h2.9v1.5c.4-.8 1.4-1.7 3-1.7 3.2 0 3.8 2.1 3.8 4.8V20h-3v-5.6c0-1.3 0-3-1.8-3s-2 1.4-2 2.9V20h-3z"/></svg>
                  {%- when 'podcast' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5.5 11a6.5 6.5 0 0 0 13 0M12 17.5V21"/></svg>
                  {%- else -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3.5 6.5 12 13l8.5-6.5"/></svg>
                {%- endcase -%}
              </a></li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
        {%- if st.handle != blank -%}<span class="cpo__handle">{{ st.handle | escape }}</span>{%- endif -%}
      </div>
    </div>
    <figure class="cpo__media">
      {%- if st.image != blank -%}
        <img src="{{ st.image | image_url: width: 900 }}" srcset="{{ st.image | image_url: width: 520 }} 520w, {{ st.image | image_url: width: 900 }} 900w" sizes="(min-width: 990px) 520px, 92vw" width="{{ st.image.width | default: 900 }}" height="{{ st.image.height | default: 1125 }}" alt="{{ st.image_alt | default: st.image.alt | escape }}" loading="lazy" decoding="async">
      {%- else -%}
        {{ 'image' | placeholder_svg_tag }}
      {%- endif -%}
      {%- if st.tag != blank -%}<figcaption class="cpo__tag">{{ st.tag | escape }}</figcaption>{%- endif -%}
    </figure>
  </div>
</section>

{% schema %}
{
  "name": "Coach creator hello",
  "tag": "section",
  "class": "coachpro-hello-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small line above", "default": "Hello" },
    { "type": "inline_richtext", "id": "name", "label": "First line", "default": "I'm" },
    { "type": "inline_richtext", "id": "name_second", "label": "Second line", "default": "Alex." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>A few lines in your own voice: how people usually find you, and what they will find here.</p>" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "My story" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "handle", "label": "Handle beside the icons", "default": "@yourname" },
    { "type": "image_picker", "id": "image", "label": "Portrait" },
    { "type": "text", "id": "image_alt", "label": "Alt text" },
    { "type": "text", "id": "tag", "label": "Label on the picture", "default": "Based in Lisbon, working everywhere" },
    { "type": "header", "content": "Look" },
    { "type": "color", "id": "background", "label": "Background", "default": "#efe6da" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#ff6a3d" },
    { "type": "color", "id": "heading_color", "label": "Name and button", "default": "#16120f" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#4a4038" },
    { "type": "range", "id": "name_size", "label": "Name size on a computer", "min": 72, "max": 180, "step": 4, "unit": "px", "default": 136 },
    { "type": "range", "id": "name_size_mobile", "label": "Name size on a phone", "min": 48, "max": 100, "step": 2, "unit": "px", "default": 76 },
    { "type": "range", "id": "padding_top", "label": "Space above on a computer", "min": 24, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_top_mobile", "label": "Space above on a phone", "min": 16, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    { "type": "social", "name": "Social link", "limit": 6, "settings": [
      { "type": "select", "id": "platform", "label": "Where", "default": "instagram", "options": [ { "value": "instagram", "label": "Instagram" }, { "value": "youtube", "label": "YouTube" }, { "value": "tiktok", "label": "TikTok" }, { "value": "linkedin", "label": "LinkedIn" }, { "value": "podcast", "label": "Podcast" }, { "value": "email", "label": "Email" } ] },
      { "type": "url", "id": "url", "label": "Link" }
    ] }
  ],
  "presets": [ { "name": "Coach creator hello", "category": "Coach creator", "blocks": [ { "type": "social", "settings": { "platform": "instagram" } }, { "type": "social", "settings": { "platform": "youtube" } }, { "type": "social", "settings": { "platform": "linkedin" } } ] } ]
}
{% endschema %}
