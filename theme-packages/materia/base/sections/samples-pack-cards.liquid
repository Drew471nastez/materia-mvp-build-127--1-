    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop everything" },
    { "type": "url", "id": "link_url", "label": "Link", "info": "Left empty, the collection." },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Cards with no product picked take this collection's products, in order. Left empty, every product." },
    { "type": "header", "content": "Cards" },
    { "type": "checkbox", "id": "show_filters", "label": "Show filter pills", "default": true },
    { "type": "text", "id": "all_label", "label": "First pill", "default": "All" },
    { "type": "checkbox", "id": "show_add_to_cart", "label": "Show add to cart", "default": true },
    { "type": "text", "id": "free_label", "label": "Price shown for a free pack", "default": "Free" },
    { "type": "text", "id": "free_button", "label": "Button for a free pack", "default": "Get it free" },
    { "type": "text", "id": "view_label", "label": "Button when a card has no price", "default": "See the pack" },
    { "type": "range", "id": "columns", "label": "Cards in a row", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "range", "id": "columns_mobile", "label": "Cards in a row on phones", "min": 1, "max": 2, "step": 1, "default": 2 },
    { "type": "text", "id": "button_label", "label": "Button below the cards" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 20, "max": 72, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size on phones", "min": 16, "max": 48, "step": 2, "unit": "px", "default": 30 },
    { "type": "header", "content": "General" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default" },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "container",
      "options": [
        { "value": "container", "label": "Default" },
        { "value": "fluid_container", "label": "Fluid container" },
        { "value": "stretch_width", "label": "Stretched" },
        { "value": "full_width", "label": "Full width" }
