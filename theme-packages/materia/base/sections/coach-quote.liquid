{%- comment -%}
  Coach: one client's words, large and in italics, centred on a soft band,
  with who said it underneath. A small note can say that the quote is a
  sample until a real client's words, given with permission, replace it.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign color_scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
-%}
{%- assign coach_hf = settings.font_heading_google_family -%}
{%- if coach_hf != blank and coach_hf != 'none' -%}<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ coach_hf | replace: ' ', '+' }}:ital@1&display=swap">{%- endif -%}
<style>
  #shopify-section-{{ sid }} .coq {
    --coq-accent: {{ st.accent_color | default: '#a5582a' }};
    background: {{ st.background | default: '#f2e8dc' }};
    padding: {{ st.padding_top_mobile | default: 56 }}px 24px {{ st.padding_bottom_mobile | default: 56 }}px;
    text-align: center;
  }
  @media (min-width: 990px) {
    #shopify-section-{{ sid }} .coq { padding: {{ st.padding_top | default: 88 }}px 40px {{ st.padding_bottom | default: 88 }}px; }
  }
  #shopify-section-{{ sid }} .coq__inner { max-width: 860px; margin: 0 auto; }
  #shopify-section-{{ sid }} .coq__eyebrow { margin: 0 0 22px; color: var(--coq-accent); font-size: 12px; font-weight: 500; letter-spacing: 0.2em; text-transform: uppercase; }
  #shopify-section-{{ sid }} .coq__quote { margin: 0; }
  #shopify-section-{{ sid }} .coq__text {
    margin: 0; padding: 0; border: 0; border-radius: 0; background: none; box-shadow: none; quotes: none; color: var(--color-heading);
    font-family: var(--heading-font, inherit); font-style: italic; font-weight: var(--heading-weight, 500);
    font-size: {{ st.text_size_mobile | default: 26 }}px; line-height: 1.32;
  }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .coq__text { font-size: {{ st.text_size | default: 36 }}px; } }
  #shopify-section-{{ sid }} .coq__who { display: block; margin-top: 24px; color: var(--color-text); font-style: normal; font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase; }
  #shopify-section-{{ sid }} .coq__note { margin: 14px 0 0; color: var(--color-text); font-size: 13px; opacity: 0.75; }
</style>

<div class="coq color-{{ color_scheme }}" data-section-id="{{ sid }}">
  <div class="coq__inner">
    {%- if st.eyebrow != blank -%}<p class="coq__eyebrow">{{ st.eyebrow | escape }}</p>{%- endif -%}
    <figure class="coq__quote">
      <blockquote class="coq__text">{{ st.quote | escape }}</blockquote>
      {%- if st.author != blank -%}<figcaption><cite class="coq__who">{{ st.author | escape }}</cite></figcaption>{%- endif -%}
    </figure>
    {%- if st.note != blank -%}<p class="coq__note">{{ st.note | escape }}</p>{%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Coach client quote",
  "tag": "section",
  "class": "section sec__coach-quote",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default-color-scheme" },
    { "type": "color", "id": "background", "label": "Background", "default": "#f2e8dc" },
    { "type": "color", "id": "accent_color", "label": "Accent colour", "default": "#a5582a" },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Client words" },
    { "type": "textarea", "id": "quote", "label": "Quote", "default": "A client's words about what changed, in their own voice." },
    { "type": "text", "id": "author", "label": "Who said it", "default": "First name, what they do" },
    { "type": "text", "id": "note", "label": "Small note", "default": "Sample quote. Replace it with a client's words, with their permission." },
    { "type": "range", "id": "text_size", "label": "Quote size, desktop", "min": 22, "max": 52, "step": 2, "unit": "px", "default": 36 },
    { "type": "range", "id": "text_size_mobile", "label": "Quote size, phone", "min": 18, "max": 36, "step": 2, "unit": "px", "default": 26 },
    { "type": "range", "id": "padding_top", "label": "Space above, desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 88 },
    { "type": "range", "id": "padding_bottom", "label": "Space below, desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 88 },
    { "type": "range", "id": "padding_top_mobile", "label": "Space above, phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Space below, phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "presets": [ { "name": "Coach client quote" } ]
}
{% endschema %}
