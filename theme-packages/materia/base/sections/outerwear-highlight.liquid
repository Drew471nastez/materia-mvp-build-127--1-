{%- comment -%}
  Outerwear label (templates round 23): a row of the theme's own product
  cards beside one large picture, after the owner's streetwear reference.
  A thin label row sits on top (a name on the left, a link on the right).
  The picture can carry a heading and a button over it, or the heading and
  text can sit in their own panel above the cards. On a computer each card's
  name and price sit in a white box on the picture; on a phone they sit
  under it. With no picture the cards fill the row, which makes a plain
  grid. A shop with no products yet shows the theme's sample cards.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign color_scheme = st.color_scheme.id | default: st.color_scheme | default: 'default'
  assign collection_obj = st.collection | default: collections.all
  assign count = st.products_to_show | default: 4
  assign cols = st.columns_desktop | default: 2
  assign cols_m = st.columns_mobile | default: 2
  assign has_image = false
  if st.image != blank and st.image_position != 'none'
    assign has_image = true
  endif
  assign scroll_animation = settings.scroll_animation
  if st.reveal == false
    assign scroll_animation = 'none'
  endif
  assign card_bg = st.card_background | default: '#d8d8d6'
  assign show_copy = false
  if st.text_position == 'image'
    if st.heading != blank or st.button_label != blank
      assign show_copy = true
    endif
  endif
-%}
<style>
  #shopify-section-{{ sid }} .owh { padding: {{ st.padding_top_mobile | default: 0 }}px 0 {{ st.padding_bottom_mobile | default: 0 }}px; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .owh { padding: {{ st.padding_top | default: 0 }}px 0 {{ st.padding_bottom | default: 0 }}px; } }
  #shopify-section-{{ sid }} .owh__label { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 18px 16px; border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .owh__label { padding: 20px 20px; } }
  #shopify-section-{{ sid }} .owh__label-text { margin: 0; font-family: var(--body-font); font-size: 16px; font-weight: 500; letter-spacing: 0; text-transform: none; color: var(--color-heading); }
  #shopify-section-{{ sid }} .owh__label-link { font-size: 13px; font-weight: 500; text-transform: uppercase; letter-spacing: .03em; color: var(--color-heading); text-decoration: underline; text-underline-offset: 5px; text-decoration-thickness: 1px; }
  #shopify-section-{{ sid }} .owh__row { display: grid; grid-template-columns: 1fr; }
  @media (min-width: 990px) {
    #shopify-section-{{ sid }} .owh__row--image { grid-template-columns: {% if st.image_position == 'right' %}minmax(0, 1fr) {{ st.image_width | default: 50 }}%{% else %}{{ st.image_width | default: 50 }}% minmax(0, 1fr){% endif %}; }
    #shopify-section-{{ sid }} .owh__row--image.is-right .owh__media { order: 2; }
  }
  #shopify-section-{{ sid }} .owh__media { position: relative; overflow: hidden; min-height: 100%; aspect-ratio: {{ st.image_ratio_mobile | default: '4 / 5' }}; background: var(--color-border); }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .owh__media { aspect-ratio: auto; } }
  #shopify-section-{{ sid }} .owh__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: {{ st.image_focus_x | default: 50 }}% {{ st.image_focus_y | default: 40 }}%; }
  #shopify-section-{{ sid }} .owh__media::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,{{ st.overlay_opacity | default: 25 | divided_by: 100.0 }}) 0%, rgba(0,0,0,0) 55%); pointer-events: none; }
  #shopify-section-{{ sid }} .owh__media-copy { position: absolute; z-index: 1; left: 16px; right: 16px; top: 20px; display: flex; flex-direction: column; align-items: flex-start; gap: 18px; color: #fff; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .owh__media-copy { left: 20px; right: 20px; top: 28px; } }
  #shopify-section-{{ sid }} .owh__media-copy .owh__heading { color: #fff; }
  #shopify-section-{{ sid }} .owh__heading { margin: 0; font-size: {{ st.heading_size_mobile | default: 44 }}px; line-height: .98; max-width: 12ch; overflow-wrap: anywhere; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .owh__heading { font-size: {{ st.heading_size | default: 72 }}px; } }
  #shopify-section-{{ sid }} .owh__btn { display: inline-flex; align-items: center; justify-content: center; min-width: 190px; padding: 14px 30px; border-radius: var(--btn-radius, 4px); background: #fff; color: #111; font-size: 13px; font-weight: 500; letter-spacing: .03em; text-transform: uppercase; text-decoration: none; transition: background-color .2s; }
  #shopify-section-{{ sid }} .owh__btn:hover { background: #e9e9e9; color: #111; }
  #shopify-section-{{ sid }} .owh__side { min-width: 0; display: flex; flex-direction: column; }
  #shopify-section-{{ sid }} .owh__panel { display: flex; flex-direction: column; align-items: flex-start; gap: 14px; padding: 24px 16px 28px; border-bottom: 1px solid var(--color-border); }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .owh__panel { padding: 28px 20px 40px; } #shopify-section-{{ sid }} .owh__row--image.is-right .owh__side { border-right: 1px solid var(--color-border); } }
  #shopify-section-{{ sid }} .owh__panel .owh__heading { max-width: 16ch; }
  #shopify-section-{{ sid }} .owh__text { margin: 0; max-width: 46ch; font-size: 15px; line-height: 1.55; }
  #shopify-section-{{ sid }} .owh__text > * { margin: 0; }
  #shopify-section-{{ sid }} .owh__link { font-size: 13px; font-weight: 500; text-transform: uppercase; letter-spacing: .03em; color: var(--color-heading); text-decoration: underline; text-underline-offset: 5px; }
  #shopify-section-{{ sid }} .owh__grid { display: grid; grid-template-columns: repeat({{ cols_m }}, minmax(0, 1fr)); gap: 1px; background: var(--color-border); flex: 1; align-content: start; }
  @media (min-width: 750px) { #shopify-section-{{ sid }} .owh__grid { grid-template-columns: repeat({{ cols | at_most: 3 }}, minmax(0, 1fr)); } }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .owh__grid { grid-template-columns: repeat({{ cols }}, minmax(0, 1fr)); } }
  #shopify-section-{{ sid }} .owh__grid > * { min-width: 0; width: 100% !important; max-width: none !important; margin: 0 !important; padding: 0 !important; background: var(--color-background); }
  #shopify-section-{{ sid }} .owh__grid .product-item__inner { border-radius: 0; background: {{ card_bg }}; }
  #shopify-section-{{ sid }} .owh__grid .product__media { border-radius: 0; }
  #shopify-section-{{ sid }} .owh__grid .product-item__information { padding: 12px 12px 18px; margin-top: 0 !important; }
  #shopify-section-{{ sid }} .owh__grid .product-item__name { font-family: var(--body-font); font-weight: 500; text-transform: none; letter-spacing: 0; font-size: 15px; }
  #shopify-section-{{ sid }} .owh__grid .price { font-family: var(--body-font); font-weight: 400; }
  #shopify-section-{{ sid }} .owh__grid .product__color-swatches { margin-top: 8px; }
  {%- if st.card_box -%}
  @media (min-width: 990px) {
    #shopify-section-{{ sid }} .owh__grid .product-item__wrapper { position: relative; display: block; background: {{ card_bg }}; height: 100%; }
    #shopify-section-{{ sid }} .owh__grid .product-item__information { position: absolute; left: 16px; right: 16px; bottom: 16px; z-index: 2; display: grid !important; grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: "name sw" "price sw"; column-gap: 12px; row-gap: 4px; align-items: center; padding: 14px 16px; background: #fff; color: #111; }
    #shopify-section-{{ sid }} .owh__grid .product-item__information > .product-item__name { grid-area: name; color: #111; }
    #shopify-section-{{ sid }} .owh__grid .product-item__information > .product-item__price { grid-area: price; }
    #shopify-section-{{ sid }} .owh__grid .product-item__information > .product__color-swatches { grid-area: sw; margin: 0 !important; align-self: end; }
    #shopify-section-{{ sid }} .owh__grid .product-item__information > :not(.product-item__name):not(.product-item__price):not(.product__color-swatches) { grid-column: 1 / -1; }
  }
  {%- endif -%}
  #shopify-section-{{ sid }} .owh__foot { display: flex; justify-content: center; padding: 24px 16px 8px; }
</style>
<div class="owh section color-{{ color_scheme }} gradient" data-section-type="outerwear-highlight" data-section-id="{{ sid }}">
  {%- if st.label != blank or st.label_link_text != blank -%}
    <div class="owh__label">
      <p class="owh__label-text">{{ st.label | escape }}</p>
      {%- if st.label_link_text != blank -%}<a class="owh__label-link" href="{{ st.label_link | default: collection_obj.url | default: routes.all_products_collection_url }}">{{ st.label_link_text | escape }}</a>{%- endif -%}
    </div>
  {%- endif -%}
  <div class="owh__row{% if has_image %} owh__row--image{% if st.image_position == 'right' %} is-right{% endif %}{% endif %}">
    {%- if has_image -%}
      <div class="owh__media">
        {{ st.image | image_url: width: 1600 | image_tag: loading: 'lazy', alt: st.heading, widths: '600, 900, 1200, 1600', sizes: '(min-width: 990px) 50vw, 100vw' }}
        {%- if show_copy -%}
          <div class="owh__media-copy">
            {%- if st.heading != blank -%}<h3 class="owh__heading h1">{{ st.heading | escape }}</h3>{%- endif -%}
            {%- if st.button_label != blank -%}<a class="owh__btn" href="{{ st.button_link | default: collection_obj.url | default: routes.all_products_collection_url }}">{{ st.button_label | escape }}</a>{%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
    <div class="owh__side">
      {%- if st.text_position == 'column' or has_image == false -%}
        {%- if st.heading != blank or st.text != blank -%}
          <div class="owh__panel">
            {%- if st.heading != blank -%}<h3 class="owh__heading h1">{{ st.heading | escape }}</h3>{%- endif -%}
            {%- if st.text != blank -%}<div class="owh__text rte">{{ st.text }}</div>{%- endif -%}
            {%- if st.button_label != blank -%}<a class="owh__link" href="{{ st.button_link | default: collection_obj.url | default: routes.all_products_collection_url }}">{{ st.button_label | escape }}</a>{%- endif -%}
          </div>
        {%- endif -%}
      {%- endif -%}
      <div class="owh__grid">
        {%- if collection_obj != blank and collection_obj.products_count > 0 -%}
          {%- for product in collection_obj.products offset: st.offset limit: count -%}
            {% render 'product-item',
              card_product: product,
              section_id: sid,
              container: 'full_width',
              colunm: cols,
              colunm_mobile: cols_m,
              padding: 0,
              class: '',
              template_enable_action: true,
              template_enable_price: true,
              template_enable_add_cart: false,
              scroll_animation: scroll_animation,
              indexFor: forloop.index,
              template_enable_product_badges: true
            %}
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..count) -%}
            {% render 'product-item',
              card_product: blank,
              section_id: sid,
              container: 'full_width',
              colunm: cols,
              colunm_mobile: cols_m,
              padding: 0,
              class: '',
              template_enable_price: true,
              scroll_animation: scroll_animation,
              indexFor: i
            %}
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Products beside a picture",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "header", "content": "Label row" },
    { "type": "text", "id": "label", "label": "Label", "default": "Highlights" },
    { "type": "text", "id": "label_link_text", "label": "Link text" },
    { "type": "url", "id": "label_link", "label": "Link" },
    { "type": "header", "content": "Picture" },
    { "type": "image_picker", "id": "image", "label": "Picture" },
    { "type": "select", "id": "image_position", "label": "Picture position", "default": "left", "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }, { "value": "none", "label": "No picture" } ] },
    { "type": "range", "id": "image_width", "label": "Picture width", "min": 30, "max": 70, "step": 5, "unit": "%", "default": 50 },
    { "type": "range", "id": "image_focus_x", "label": "Picture focus, across", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 50 },
    { "type": "range", "id": "image_focus_y", "label": "Picture focus, down", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 40 },
    { "type": "range", "id": "overlay_opacity", "label": "Shade at the top of the picture", "min": 0, "max": 70, "step": 5, "unit": "%", "default": 25 },
    { "type": "select", "id": "image_ratio_mobile", "label": "Picture shape on phones", "default": "4 / 5", "options": [ { "value": "4 / 5", "label": "Portrait" }, { "value": "1 / 1", "label": "Square" }, { "value": "3 / 2", "label": "Landscape" } ] },
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Night layers" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "select", "id": "text_position", "label": "Where the text sits", "default": "image", "options": [ { "value": "image", "label": "On the picture" }, { "value": "column", "label": "Above the products" } ] },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 28, "max": 120, "step": 2, "unit": "px", "default": 72 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size on phones", "min": 24, "max": 72, "step": 2, "unit": "px", "default": 44 },
    { "type": "header", "content": "Products" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Left empty, every product in the shop is shown." },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 1, "max": 12, "step": 1, "default": 4 },
    { "type": "range", "id": "offset", "label": "Skip the first products", "min": 0, "max": 8, "step": 1, "default": 0 },
    { "type": "range", "id": "columns_desktop", "label": "Products per row", "min": 1, "max": 4, "step": 1, "default": 2 },
    { "type": "range", "id": "columns_mobile", "label": "Products per row on phones", "min": 1, "max": 2, "step": 1, "default": 2 },
    { "type": "checkbox", "id": "card_box", "label": "Name and price in a box on the picture", "default": true },
    { "type": "color", "id": "card_background", "label": "Behind product pictures", "default": "#d8d8d6" },
    { "type": "header", "content": "Section" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "default" },
    { "type": "checkbox", "id": "reveal", "label": "Fade in on scroll", "default": true },
    { "type": "range", "id": "padding_top", "label": "Space above", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Space below", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_top_mobile", "label": "Space above on phones", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Space below on phones", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 }
  ],
  "presets": [
    { "name": "Products beside a picture" }
  ]
}
{% endschema %}
