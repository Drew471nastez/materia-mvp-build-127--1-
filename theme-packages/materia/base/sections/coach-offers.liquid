{%- comment -%}
  Coach: ways to work together. A centred label and heading over a row of
  cards, each a picture, a name, a short line, a price and a link to the
  session or programme. Three to a row on desktop, one under another on a
  phone.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign color_scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
  assign placeholder = 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 600 450%22%3E%3Crect width=%22600%22 height=%22450%22 fill=%22%23eadfd1%22/%3E%3C/svg%3E'
-%}
{%- assign coach_hf = settings.font_heading_google_family -%}
{%- if coach_hf != blank and coach_hf != 'none' -%}<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ coach_hf | replace: ' ', '+' }}:ital@1&display=swap">{%- endif -%}
<style>
  #shopify-section-{{ sid }} .coo {
    --coo-bg: {{ st.background | default: '#faf6f0' }};
    --coo-card: {{ st.card_color | default: '#ffffff' }};
    --coo-accent: {{ st.accent_color | default: '#a5582a' }};
    background: var(--coo-bg);
    padding: {{ st.padding_top_mobile | default: 56 }}px 20px {{ st.padding_bottom_mobile | default: 56 }}px;
  }
  @media (min-width: 990px) {
    #shopify-section-{{ sid }} .coo { padding: {{ st.padding_top | default: 96 }}px 40px {{ st.padding_bottom | default: 96 }}px; }
  }
  #shopify-section-{{ sid }} .coo__inner { max-width: 1200px; margin: 0 auto; }
  #shopify-section-{{ sid }} .coo__head { text-align: center; max-width: 680px; margin: 0 auto 44px; }
  #shopify-section-{{ sid }} .coo__eyebrow { margin: 0 0 14px; color: var(--coo-accent); font-size: 12px; font-weight: 500; letter-spacing: 0.2em; text-transform: uppercase; }
  #shopify-section-{{ sid }} .coo__heading {
    margin: 0; color: var(--color-heading);
    font-family: var(--heading-font, inherit); font-weight: var(--heading-weight, 500);
    font-size: {{ st.heading_size_mobile | default: 34 }}px; line-height: 1.12;
  }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .coo__heading { font-size: {{ st.heading_size | default: 44 }}px; } }
  #shopify-section-{{ sid }} .coo__heading em { font-style: italic; color: var(--coo-accent); }
  #shopify-section-{{ sid }} .coo__intro { margin: 14px auto 0; color: var(--color-text); font-size: 16px; line-height: 1.65; max-width: 52ch; }
  #shopify-section-{{ sid }} .coo__intro p { margin: 0; }
  #shopify-section-{{ sid }} .coo__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 20px; }
  @media (min-width: 750px) { #shopify-section-{{ sid }} .coo__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .coo__grid { grid-template-columns: repeat({{ st.columns | default: 3 }}, minmax(0, 1fr)); gap: 28px; } }
  #shopify-section-{{ sid }} .coo__card {
    display: flex; flex-direction: column; background: var(--coo-card); color: inherit; text-decoration: none;
    border: 1px solid var(--color-border, #e6dacb); border-radius: {{ st.card_radius | default: 4 }}px; overflow: hidden;
    transition: box-shadow 0.3s ease, transform 0.3s ease;
  }
  #shopify-section-{{ sid }} .coo__card:hover { box-shadow: 0 18px 40px -24px rgba(58, 42, 33, 0.35); transform: translateY(-2px); }
  #shopify-section-{{ sid }} .coo__pic { position: relative; aspect-ratio: {{ st.image_ratio | default: '4 / 3' }}; overflow: hidden; background: #eadfd1; margin: 0; }
  #shopify-section-{{ sid }} .coo__pic img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; margin: 0; transition: transform 0.6s ease; }
  #shopify-section-{{ sid }} .coo__card:hover .coo__pic img { transform: scale(1.03); }
  #shopify-section-{{ sid }} .coo__body { display: flex; flex-direction: column; flex: 1; padding: 24px 24px 26px; }
  #shopify-section-{{ sid }} .coo__label { margin: 0 0 8px; color: var(--color-text); font-size: 11.5px; letter-spacing: 0.18em; text-transform: uppercase; }
  #shopify-section-{{ sid }} .coo__title {
    margin: 0 0 10px; color: var(--color-heading);
    font-family: var(--heading-font, inherit); font-weight: var(--heading-weight, 500); font-size: 27px; line-height: 1.15;
  }
  #shopify-section-{{ sid }} .coo__text { margin: 0 0 18px; color: var(--color-text); font-size: 15px; line-height: 1.6; }
  #shopify-section-{{ sid }} .coo__foot { margin-top: auto; display: flex; align-items: baseline; justify-content: space-between; gap: 12px; padding-top: 16px; border-top: 1px solid var(--color-border, #e6dacb); }
  #shopify-section-{{ sid }} .coo__price { color: var(--coo-accent); font-family: var(--heading-font, inherit); font-size: 22px; font-weight: 600; font-variant-numeric: lining-nums; }
  #shopify-section-{{ sid }} .coo__link { color: var(--color-heading); font-size: 12px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; white-space: nowrap; }
  #shopify-section-{{ sid }} .coo__link::after { content: " \2192"; transition: margin 0.25s ease; }
  #shopify-section-{{ sid }} .coo__card:hover .coo__link::after { margin-left: 4px; }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .coo__card, #shopify-section-{{ sid }} .coo__pic img { transition: none; }
    #shopify-section-{{ sid }} .coo__card:hover { transform: none; }
    #shopify-section-{{ sid }} .coo__card:hover .coo__pic img { transform: none; }
  }
</style>

<div class="coo color-{{ color_scheme }}" data-section-id="{{ sid }}">
  <div class="coo__inner">
    {%- if st.eyebrow != blank or st.heading != blank or st.intro != blank -%}
      <div class="coo__head">
        {%- if st.eyebrow != blank -%}<p class="coo__eyebrow">{{ st.eyebrow | escape }}</p>{%- endif -%}
        {%- if st.heading != blank -%}<h2 class="coo__heading">{{ st.heading }}</h2>{%- endif -%}
        {%- if st.intro != blank -%}<div class="coo__intro">{{ st.intro }}</div>{%- endif -%}
      </div>
    {%- endif -%}
    <div class="coo__grid">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <a class="coo__card" href="{{ b.link | default: '/collections/all' }}" {{ block.shopify_attributes }}>
          <figure class="coo__pic">
            {%- if b.image != blank -%}
              <img src="{{ b.image | image_url: width: 800 }}" srcset="{{ b.image | image_url: width: 500 }} 500w, {{ b.image | image_url: width: 800 }} 800w" sizes="(min-width: 990px) 380px, (min-width: 750px) 46vw, 92vw" width="{{ b.image.width | default: 800 }}" height="{{ b.image.height | default: 600 }}" alt="{{ b.alt | default: b.image.alt | escape }}" loading="lazy" decoding="async">
            {%- else -%}
              <img src="{{ placeholder }}" width="600" height="450" alt="">
            {%- endif -%}
          </figure>
          <div class="coo__body">
            {%- if b.label != blank -%}<p class="coo__label">{{ b.label | escape }}</p>{%- endif -%}
            {%- if b.title != blank -%}<h3 class="coo__title">{{ b.title | escape }}</h3>{%- endif -%}
            {%- if b.text != blank -%}<p class="coo__text">{{ b.text | escape }}</p>{%- endif -%}
            <div class="coo__foot">
              <span class="coo__price">{{ b.price | escape }}</span>
              {%- if b.link_label != blank -%}<span class="coo__link">{{ b.link_label | escape }}</span>{%- endif -%}
            </div>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Coach ways to work",
  "tag": "section",
  "class": "section sec__coach-offers",
  "max_blocks": 6,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default-color-scheme" },
    { "type": "color", "id": "background", "label": "Background", "default": "#faf6f0" },
    { "type": "color", "id": "card_color", "label": "Card colour", "default": "#ffffff" },
    { "type": "color", "id": "accent_color", "label": "Accent colour", "default": "#a5582a" },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Ways to work together" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Coaching that fits <em>your week</em>" },
    { "type": "richtext", "id": "intro", "label": "Text under the heading" },
    { "type": "select", "id": "columns", "label": "Cards in a row, desktop", "options": [ { "value": "2", "label": "2" }, { "value": "3", "label": "3" } ], "default": "3" },
    { "type": "select", "id": "image_ratio", "label": "Picture proportions", "options": [ { "value": "4 / 3", "label": "Landscape" }, { "value": "1 / 1", "label": "Square" }, { "value": "4 / 5", "label": "Portrait" } ], "default": "4 / 3" },
    { "type": "range", "id": "card_radius", "label": "Card corners", "min": 0, "max": 24, "step": 1, "unit": "px", "default": 4 },
    { "type": "range", "id": "heading_size", "label": "Heading size, desktop", "min": 28, "max": 64, "step": 2, "unit": "px", "default": 44 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size, phone", "min": 24, "max": 44, "step": 2, "unit": "px", "default": 34 },
    { "type": "range", "id": "padding_top", "label": "Space above, desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Space below, desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_top_mobile", "label": "Space above, phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Space below, phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    {
      "type": "offer",
      "name": "Way to work",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Picture" },
        { "type": "text", "id": "alt", "label": "Alt text" },
        { "type": "text", "id": "label", "label": "Small label", "default": "Six weeks" },
        { "type": "text", "id": "title", "label": "Name", "default": "One to one coaching" },
        { "type": "textarea", "id": "text", "label": "Short line", "default": "Say who it is for and what happens in it." },
        { "type": "text", "id": "price", "label": "Price", "default": "From $150" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "See the details" },
        { "type": "url", "id": "link", "label": "Link", "info": "The session's product page, or your booking page." }
      ]
    }
  ],
  "presets": [
    { "name": "Coach ways to work", "blocks": [ { "type": "offer" }, { "type": "offer" }, { "type": "offer" } ] }
  ]
}
{% endschema %}
