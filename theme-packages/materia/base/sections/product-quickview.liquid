{%- comment -%}
  Quick view. Loaded by the product cards' quick view button (theme.js:
  button-quickview) with /products/<handle>?section_id=product-quickview and
  shown in the theme's popup: a wide two-column dialog on desktop, a
  draggable bottom sheet on phones (theme.js QuickView.initSheet). Styles:
  product-card.css (QUICK VIEW DIALOG). What shows is set in
  Theme settings > Quick view. Add to cart goes through the theme's
  product-form, so the cart drawer, quantity rules and errors work as on the
  product page.
{%- endcomment -%}
{%- liquid
  assign st = settings
  assign qv_variant = product.selected_or_first_available_variant
  assign qv_form_id = 'quickview-form-' | append: product.id
  assign qv_media = product.media | where: 'media_type', 'image'
  if qv_media.size == 0 and product.featured_image != blank
    assign qv_media = product.images
  endif
  assign qv_on_sale = false
  if qv_variant.compare_at_price > qv_variant.price
    assign qv_on_sale = true
  endif

  comment
    Rating: the standard product rating metafields (on Storelib, its own reviews), written by
    a reviews app, Judge.me, Loox, Yotpo, Okendo...:
    reviews.rating (type rating: value.rating, value.scale_max) and
    reviews.rating_count (integer). A json copy of the rating keeps its
    numbers under "value" / "scale_max". Hidden without a rating and a count.
  endcomment
  assign qv_rating = 0
  assign qv_rating_count = 0
  assign qv_rating_max = 5
  if st.qv_show_rating != false
    assign qv_rating_mf = product.metafields.reviews.rating.value
    if qv_rating_mf != blank
      assign qv_rating = qv_rating_mf.rating | default: qv_rating_mf.value | default: 0 | plus: 0
      assign qv_rating_max = qv_rating_mf.scale_max | default: 5 | plus: 0
    endif
    assign qv_rating_count = product.metafields.reviews.rating_count.value | default: 0 | plus: 0
    if qv_rating <= 0
      assign qv_rating = product.metafields.storelib.reviews.value.average | default: 0 | plus: 0
      assign qv_rating_count = product.metafields.storelib.reviews.value.count | default: 0 | plus: 0
      assign qv_rating_max = 5
    endif
    if qv_rating_max <= 0
      assign qv_rating_max = 5
    endif
  endif

  assign qv_color_names = st.color_swatch_trigger | default: 'Color' | downcase | split: ','
  assign qv_scheme = st.qv_color_scheme.id | default: 'scheme-1'
  assign qv_fit = st.qv_image_fit | default: 'cover'
  assign qv_show_qty = true
  if st.qv_show_quantity == false
    assign qv_show_qty = false
  endif
-%}
<div class="product-quickview__content hidden" data-qv-root>
  <div class="qv qv--fit-{{ qv_fit }} color-{{ qv_scheme }}" data-qv data-scheme="color-{{ qv_scheme }}" data-product-url="{{ product.url }}">
    {%- liquid
      assign qv_ratio = qv_media.first.preview_image.aspect_ratio | default: qv_media.first.aspect_ratio | default: 1
      if qv_ratio < 0.6
        assign qv_ratio = 0.6
      elsif qv_ratio > 1.8
        assign qv_ratio = 1.8
      endif
    -%}
    <div class="qv__media" style="--qv-ratio: {{ qv_ratio }};">
      <div class="qv__track" data-qv-track data-mt-instant>
        {%- for media in qv_media limit: 10 -%}
          <div class="qv__slide" data-media-id="{{ media.id }}">
            {%- if forloop.first -%}
              {%- assign mt_img_alt_1 = media.alt | default: product.title -%}{{ media | image_url: width: 1100 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 768px) 550px, 100vw', widths: '400, 550, 800, 1100', alt: mt_img_alt_1}}
            {%- else -%}
              {%- assign mt_img_alt_2 = media.alt | default: product.title -%}{{ media | image_url: width: 1100 | image_tag: loading: 'lazy', sizes: '(min-width: 768px) 550px, 100vw', widths: '400, 550, 800, 1100', alt: mt_img_alt_2}}
            {%- endif -%}
          </div>
        {%- else -%}
          <div class="qv__slide">{%- render 'placeholder-image', type: 'product-1', class: 'qv__placeholder' -%}</div>
        {%- endfor -%}
      </div>
      {%- if qv_media.size > 1 -%}
        <button type="button" class="qv__nav qv__nav--prev" data-qv-prev aria-label="{{ 'accessibility.previous' | t }}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg></button>
        <button type="button" class="qv__nav qv__nav--next" data-qv-next aria-label="{{ 'accessibility.next' | t }}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></button>
        {%- comment -%} One dot per picture, as on the product page's gallery: the current one is longer. {%- endcomment -%}
        <div class="qv__dots" data-qv-dots aria-hidden="true">
          {%- for media in qv_media limit: 10 -%}
            <button type="button" class="qv__dot" tabindex="-1" data-qv-dot="{{ forloop.index0 }}"{% if forloop.first %} aria-current="true"{% endif %}></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="qv__info">
      <h2 class="qv__title">{{ product.title | escape }}</h2>

      {%- render 'quickview-rating', rating: qv_rating, scale_max: qv_rating_max, count: qv_rating_count, url: product.url -%}

      <div class="qv__price" data-qv-price>
        <span class="qv__price-now{% if qv_on_sale %} is-sale{% endif %}" data-qv-now>{{ qv_variant.price | money }}</span>
        <s class="qv__price-was" data-qv-was{% unless qv_on_sale %} hidden{% endunless %}>{{ qv_variant.compare_at_price | money }}</s>
      </div>

      {%- if st.qv_show_description != false and product.description != blank -%}
        {%- assign qv_words = st.qv_description_words | default: 30 -%}
        <p class="qv__desc">{{ product.description | strip_html | truncatewords: qv_words }}</p>
      {%- endif -%}

      {%- unless product.has_only_default_variant -%}
        {%- for option in product.options_with_values -%}
          {%- liquid
            assign qv_is_color = false
            if st.enable_color_swatches != false
              assign qv_first = option.values | first
              if qv_first.swatch != blank
                assign qv_is_color = true
              endif
              assign qv_opt_name = option.name | strip | downcase
              for cn in qv_color_names
                assign qv_cn = cn | strip
                if qv_cn == qv_opt_name
                  assign qv_is_color = true
                endif
              endfor
            endif
            assign qv_opt_key = 'option' | append: option.position
          -%}
          <fieldset class="qv__option{% if qv_is_color %} qv__option--color{% endif %}" data-qv-option="{{ forloop.index0 }}">
            <legend>{{ option.name | escape }}: <span data-qv-selected>{{ option.selected_value | escape }}</span></legend>
            <div class="qv__values">
              {%- for value in option.values -%}
                {%- if qv_is_color -%}
                  {%- liquid
                    assign qv_img = ''
                    assign qv_vs = product.variants | where: qv_opt_key, value
                    for qv_v in qv_vs
                      if qv_v.featured_image
                        assign qv_img = qv_v.featured_image | image_url: width: 120
                        break
                      endif
                    endfor
                    if value.swatch.image
                      assign qv_sw = value.swatch.image | image_url: width: 120
                      assign qv_sw = 'url(' | append: qv_sw | append: ')'
                    elsif value.swatch.color
                      assign qv_sw = 'rgb(' | append: value.swatch.color.rgb | append: ')'
                    else
                      assign qv_sw = ''
                    endif
                  -%}
                  <button type="button" class="qv__value qv__swatch product__color-swatches--js {{ st.swatch_item_type }}" data-value="{{ value | escape }}" aria-pressed="{% if value == option.selected_value %}true{% else %}false{% endif %}" aria-label="{{ value | escape }}" title="{{ value | escape }}"
                    data-color="{{ value | downcase | replace: ' ', '-' | replace: '"', "'" }}"
                    data-custom-value="custom__color-swatches--{{ value | downcase | replace: ' ', '-' | replace: '"', "'" }}"
                    data-swatch-type="{{ st.swatch_item_type }}"
                    {% if qv_img != blank %}data-image="{{ qv_img }}"{% endif %}
                    data-option-swatch-value="{{ qv_sw }}"></button>
                {%- else -%}
                  <button type="button" class="qv__value" data-value="{{ value | escape }}" aria-pressed="{% if value == option.selected_value %}true{% else %}false{% endif %}">{{ value | escape }}</button>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </fieldset>
        {%- endfor -%}
      {%- endunless -%}

      <p class="qv__stock" data-qv-stock{% if qv_variant.available %} hidden{% endif %}>{{ 'products.product.sold_out' | t }}</p>

      <product-form class="qv__form" data-hide-errors="false">
        <div class="product-form__error-message-wrapper" role="alert" hidden>
          <div class="form__message error inline-flex align-center"><span class="product-form__error-message ml-5"></span></div>
        </div>
        {%- form 'product', product, id: qv_form_id, novalidate: 'novalidate', data-type: 'add-to-cart-form', class: 'qv__form-inner' -%}
          <input type="hidden" name="id" value="{{ qv_variant.id }}" disabled data-qv-id>
          <div class="qv__buy{% unless qv_show_qty %} qv__buy--no-qty{% endunless %}">
            {%- if qv_show_qty -%}
              <div class="qv__qty">
                <button type="button" data-qv-qty="-1" aria-label="{{ 'products.product.quantity.decrease' | t: product: product.title | escape }}"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M5 12h14"/></svg></button>
                <input type="number" name="quantity" value="1" min="1" inputmode="numeric" aria-label="{{ 'products.product.quantity.label' | t | escape }}">
                <button type="button" data-qv-qty="1" aria-label="{{ 'products.product.quantity.increase' | t: product: product.title | escape }}"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></button>
              </div>
            {%- endif -%}
            <button type="submit" name="add" class="btn btn-primary qv__atc product-form__submit" data-theme-button="primary" data-sl-button{% unless qv_variant.available %} disabled{% endunless %}>
              <span data-qv-atc-label>{%- if qv_variant.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}</span>
            </button>
            {%- if st.qv_show_wishlist != false -%}
              <button-wishlist
                tabindex="0"
                role="button"
                aria-pressed="false"
                aria-label="{{ 'products.product.actions.wishlist.add' | t }}: {{ product.title | escape }}"
                class="qv__wish"
                data-product-id="{{ product.id }}"
                data-product-handle="{{ product.handle }}"
                data-action="remove"
                data-tooltip-remove="{{ 'products.product.actions.wishlist.remove' | t }}"
                data-tooltip-add="{{ 'products.product.actions.wishlist.add' | t }}"
                data-tooltip-redirect="{{ 'products.product.actions.wishlist.redirect' | t }}"
              ><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M12 20.3s-7.6-4.6-9.2-9.3C1.7 7.6 3.9 4.2 7.4 4.2c2 0 3.4 1.1 4.6 2.7 1.2-1.6 2.6-2.7 4.6-2.7 3.5 0 5.7 3.4 4.6 6.8-1.6 4.7-9.2 9.3-9.2 9.3z"/></svg></button-wishlist>
            {%- endif -%}
          </div>
          {%- if st.qv_show_buy_now != false -%}
            <div class="qv__express" data-qv-express{% unless qv_variant.available %} hidden{% endunless %}>
              {%- if st.qv_show_terms -%}
                {%- liquid
                  comment
                    The cart drawer's agreement (snippets/minicart-form-body):
                    same markup and classes (minicart.css .cart-terms), same
                    texts from Theme settings > Cart drawer, unless the quick
                    view has its own text.
                  endcomment
                  if st.qv_terms_text != blank
                    assign qv_terms_html = st.qv_terms_text
                  else
                    assign qv_terms_url = st.cart_terms_link_url
                    if qv_terms_url == blank and shop.terms_of_service.url != blank
                      assign qv_terms_url = shop.terms_of_service.url
                    endif
                    assign qv_terms_link = st.cart_terms_link_label | default: 'terms & conditions'
                    assign qv_terms_label = st.cart_terms_label | default: 'I agree with the LINK'
                    assign qv_terms_html = qv_terms_label | escape
                    if qv_terms_url != blank
                      assign qv_terms_link = '<a href="' | append: qv_terms_url | append: '" class="underline" target="_blank" rel="noopener">' | append: qv_terms_link | append: '</a>'
                    endif
                    assign qv_terms_html = qv_terms_html | replace: 'LINK', qv_terms_link
                  endif
                  assign qv_terms_id = 'cart-terms-agree-qv-' | append: product.id
                -%}
                <cart-terms class="cart-terms cart-terms--qv block">
                  <label class="cart-terms__field flex align-start gap-10 pointer" for="{{ qv_terms_id }}">
                    <span class="cart-terms__box relative inline-block">
                      <input type="checkbox" class="cart-terms__input" id="{{ qv_terms_id }}" data-qv-terms aria-controls="{{ qv_terms_id }}-buy">
                      <span class="cart-terms__check" aria-hidden="true"></span>
                    </span>
                    <span class="cart-terms__text fs-small">{{ qv_terms_html }}</span>
                  </label>
                </cart-terms>
              {%- endif -%}
              {%- comment -%}
                Buy it now is the theme's secondary button, as on the product
                page (snippets/buy-buttons, Buy now style: Theme button): its
                colours, hover, font, size and corners are Theme settings >
                Buttons. The website sends it to checkout (data-storelib-buy-now).
              {%- endcomment -%}
              <div class="qv__dynamic"{% if st.qv_show_terms %} id="{{ qv_terms_id }}-buy" data-requires-terms="quickview" aria-disabled="true"{% endif %} data-qv-dynamic>
                <div class="shopify-payment-button" data-shopify="payment-button">
                  <button type="submit" name="checkout" value="1" formnovalidate class="shopify-payment-button__button shopify-payment-button__button--unbranded qv__buy-now" data-storelib-buy-now data-sl-button data-button-role="secondary" data-theme-button="secondary"{% unless qv_variant.available %} disabled{% endunless %}><span class="btn-label">{{ 'products.product.buy_it_now' | t }}</span></button>
                </div>
              </div>
            </div>
          {%- endif -%}
        {%- endform -%}
      </product-form>

      {%- if st.qv_show_benefits -%}
        {%- capture qv_benefits -%}
          {%- for i in (1..4) -%}
            {%- liquid
              assign qv_b_text_key = 'qv_benefit_' | append: i | append: '_text'
              assign qv_b_icon_key = 'qv_benefit_' | append: i | append: '_icon'
              assign qv_b_text = st[qv_b_text_key] | strip
              assign qv_b_icon = st[qv_b_icon_key] | default: 'check'
              if qv_b_icon == 'return'
                assign qv_b_icon = 'refresh'
              endif
            -%}
            {%- if qv_b_text != blank -%}
              <li class="qv__benefit">{%- render 'benefits-icon', icon: qv_b_icon, size: 16, stroke_width: 1.8, class: 'qv__benefit-icon' -%}<span>{{ qv_b_text | escape }}</span></li>
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- if qv_benefits != blank -%}
          <ul class="qv__benefits" role="list">{{ qv_benefits }}</ul>
        {%- endif -%}
      {%- endif -%}

      {%- if st.qv_show_details_link != false -%}
        <a class="qv__more mt-more-link" href="{{ product.url }}"><span class="mt-more-link__label">{{ 'products.product.general.view_full_details' | t }}</span><svg class="mt-more-link__arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 12h15"/><path d="m13 6 6 6-6 6"/></svg></a>
      {%- endif -%}
      <script type="application/json" data-qv-variants>{{ product.variants | json }}</script>
    </div>
    {%- comment -%} A thin scrollbar for the details column (desktop): the native one is hidden, this one is drawn from the column's own scroll. {%- endcomment -%}
    <div class="qv__bar" data-qv-bar aria-hidden="true"><span class="qv__thumb" data-qv-thumb></span></div>
  </div>
  <script>
    (function boot(tries) {
      {%- comment -%} The popup runs this script just before it shows the content: wait for it. {%- endcomment %}
      var root = document.querySelector('[data-qv-root]:not([data-qv-ready])');
      if (!root || !root.isConnected) { if ((tries || 0) < 60) setTimeout(function () { boot((tries || 0) + 1); }, 50); return; }
      root.setAttribute('data-qv-ready', '');
      var money = function (c) { try { return window.Shopify && Shopify.formatMoney ? Shopify.formatMoney(c, window.cartStrings && cartStrings.money_format) : (c / 100).toFixed(2); } catch (e) { return (c / 100).toFixed(2); } };
      var variants = []; try { variants = JSON.parse(root.querySelector('[data-qv-variants]').textContent); } catch (e) {}
      var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      var T = { add: {{ 'products.product.add_to_cart' | t | json }}, sold: {{ 'products.product.sold_out' | t | json }}, na: {{ 'products.product.unavailable' | t | default: 'Unavailable' | json }} };

      {%- comment -%} Swatches: the theme's own fill (colour, option swatch or variant image). {%- endcomment %}
      if (typeof SwatchInit !== 'undefined') {
        var sw = Object.create(SwatchInit.prototype);
        root.querySelectorAll('.qv__swatch').forEach(function (b) { try { sw.checkSwatches(b); } catch (e) {} });
      }

      var track = root.querySelector('[data-qv-track]'), counter = root.querySelector('[data-qv-index]');
      var prev = root.querySelector('[data-qv-prev]'), next = root.querySelector('[data-qv-next]');
      var dots = [].slice.call(root.querySelectorAll('[data-qv-dot]'));
      {%- comment -%} The slide's width is read once and again only when the box changes size: a scroll frame reads scrollLeft only. {%- endcomment %}
      var slideW = 0;
      function width() { return slideW || (slideW = track ? Math.max(1, track.clientWidth) : 1); }
      if (track && window.ResizeObserver) new ResizeObserver(function (e) { slideW = Math.max(1, Math.round(e[0].contentRect.width)) || 0; }).observe(track);
      function index() { return track ? Math.round(track.scrollLeft / width()) : 0; }
      function go(i, instant) { if (!track) return; var n = track.children.length; i = Math.max(0, Math.min(n - 1, i)); track.scrollTo({ left: i * width(), behavior: reduce || instant ? 'auto' : 'smooth' }); }
      var painted = 0, queued = 0;
      function paintNav() {
        queued = 0;
        var i = index(), n = track ? track.children.length : 0; if (i === painted) return; painted = i;
        if (counter) counter.textContent = i + 1;
        if (prev) prev.disabled = i <= 0; if (next) next.disabled = i >= n - 1;
        dots.forEach(function (d, k) { if (k === i) d.setAttribute('aria-current', 'true'); else d.removeAttribute('aria-current'); });
      }
      {%- comment -%} First picture: the arrows' state is written without reading the layout (no forced style pass while the dialog opens). {%- endcomment %}
      if (prev) prev.disabled = true;
      if (next) next.disabled = !track || track.children.length < 2;
      if (track) track.addEventListener('scroll', function () { if (!queued) queued = requestAnimationFrame(paintNav); }, { passive: true });
      if (prev) prev.addEventListener('click', function () { go(index() - 1); });
      if (next) next.addEventListener('click', function () { go(index() + 1); });
      dots.forEach(function (d) { d.addEventListener('click', function () { go(Number(d.dataset.qvDot)); }); });
      if (track) track.addEventListener('keydown', function (e) { if (e.key === 'ArrowLeft') go(index() - 1); if (e.key === 'ArrowRight') go(index() + 1); });

      {%- comment -%}
        The details column's thin scrollbar (desktop). Its length is set when
        the column or its content changes size (ResizeObserver, after layout:
        nothing is read in the open frame); a scroll moves it with transform.
        It shows while the column scrolls and while the pointer is over it.
      {%- endcomment %}
      var info = root.querySelector('.qv__info'), bar = root.querySelector('[data-qv-bar]'), thumb = root.querySelector('[data-qv-thumb]');
      if (info && bar && thumb && window.ResizeObserver) {
        var view = 0, full = 0, len = 0, room = 0, hideT = 0, frame = 0;
        var place = function (top) { frame = 0; if (!room) return; var st = typeof top === 'number' ? top : info.scrollTop; var y = full > view ? (st / (full - view)) * room : 0; thumb.style.transform = 'translate3d(0,' + Math.round(y * 10) / 10 + 'px,0)'; };
        var size = function () {
          {%- comment -%} Every read first, then the writes: nothing is measured again after a change. {%- endcomment %}
          view = info.clientHeight; full = info.scrollHeight; var top = info.scrollTop;
          var rail = Math.max(0, view - 72); {%- comment -%} .qv__bar: top 56px, bottom 16px (product-card.css) {%- endcomment -%}
          var on = full > view + 1;
          if (bar.classList.contains('is-on') !== on) bar.classList.toggle('is-on', on);
          if (!on) { room = 0; return; }
          len = Math.max(32, Math.round(rail * view / full)); room = rail - len;
          thumb.style.height = len + 'px';
          place(top);
        };
        var ro = new ResizeObserver(function () { size(); });
        ro.observe(info); if (info.firstElementChild) [].forEach.call(info.children, function (c) { ro.observe(c); });
        info.addEventListener('scroll', function () {
          if (!frame) frame = requestAnimationFrame(function () { place(); });
          bar.classList.add('is-moving'); clearTimeout(hideT); hideT = setTimeout(function () { bar.classList.remove('is-moving'); }, 700);
        }, { passive: true });
        {%- comment -%} Pressing and dragging the thumb scrolls the column. {%- endcomment %}
        thumb.addEventListener('pointerdown', function (e) {
          if (e.button !== 0 || !room) return;
          e.preventDefault();
          var y0 = e.clientY, s0 = info.scrollTop, k = (full - view) / room;
          try { thumb.setPointerCapture(e.pointerId); } catch (err) {}
          bar.classList.add('is-dragging');
          var mv = function (ev) { info.scrollTop = s0 + (ev.clientY - y0) * k; };
          var up = function () { thumb.removeEventListener('pointermove', mv); thumb.removeEventListener('pointerup', up); thumb.removeEventListener('pointercancel', up); bar.classList.remove('is-dragging'); };
          thumb.addEventListener('pointermove', mv); thumb.addEventListener('pointerup', up); thumb.addEventListener('pointercancel', up);
        });
      }

      var qty = root.querySelector('input[name="quantity"]');
      root.querySelectorAll('[data-qv-qty]').forEach(function (b) { b.addEventListener('click', function () { qty.value = Math.max(1, (parseInt(qty.value, 10) || 1) + Number(b.dataset.qvQty)); }); });

      {%- comment -%} Terms: Buy it now stays locked until the box is ticked. {%- endcomment %}
      var terms = root.querySelector('[data-qv-terms]'), dyn = root.querySelector('[data-qv-dynamic]');
      if (terms && dyn) {
        {%- comment -%} The drawer checkout's states (minicart.css .btn-checkout[data-requires-terms]). the platform's button manages its own disabled attribute, so while locked its wrapper is inert: no click, no focus. A click on the faded button points at the box. {%- endcomment %}
        var pay = dyn.querySelector('.shopify-payment-button') || dyn;
        var lock = function () {
          var off = !terms.checked;
          dyn.setAttribute('aria-disabled', String(off));
