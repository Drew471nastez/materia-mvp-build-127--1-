{%- comment -%}
  Merch template: a centred heading over a row of square pictures, four
  across on a desktop and two on a phone, each one a link. The pictures
  lift a little on hover; nothing moves with reduced motion.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign placeholder = 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 400 400%22%3E%3Crect width=%22400%22 height=%22400%22 fill=%22%23ececec%22/%3E%3C/svg%3E'
-%}
<style>
  #shopify-section-{{ sid }} .mgal { background: {{ st.background | default: '#ffffff' }}; padding: {{ st.padding_mobile | default: 48 }}px 0; text-align: center; }
  #shopify-section-{{ sid }} .mgal__head { max-width: 640px; margin: 0 auto 28px; padding: 0 16px; }
  #shopify-section-{{ sid }} .mgal__heading { margin: 0; font-family: var(--heading-font, inherit); font-weight: {{ st.heading_weight | default: 800 }}; text-transform: {{ st.heading_case | default: 'uppercase' }}; letter-spacing: -0.01em; line-height: 1.05; font-size: {{ st.heading_size_mobile | default: 24 }}px; color: {{ st.heading_color | default: '#111111' }}; }
  #shopify-section-{{ sid }} .mgal__sub { margin: 10px 0 0; font-size: 14px; color: {{ st.muted_color | default: '#5c5c5c' }}; }
  #shopify-section-{{ sid }} .mgal__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 4px; }
  #shopify-section-{{ sid }} .mgal__tile { position: relative; display: block; aspect-ratio: 1 / 1; overflow: hidden; background: #ececec; }
  #shopify-section-{{ sid }} .mgal__tile img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; margin: 0; transition: transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1), opacity 0.3s ease; }
  #shopify-section-{{ sid }} .mgal__tile:hover img { transform: scale(1.04); opacity: 0.92; }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .mgal { padding: {{ st.padding | default: 72 }}px 0; }
    #shopify-section-{{ sid }} .mgal__head { margin-bottom: 40px; }
    #shopify-section-{{ sid }} .mgal__heading { font-size: {{ st.heading_size | default: 32 }}px; }
    #shopify-section-{{ sid }} .mgal__grid { grid-template-columns: repeat({{ section.blocks.size | at_least: 1 | at_most: 6 }}, minmax(0, 1fr)); }
  }
  @media (prefers-reduced-motion: reduce) { #shopify-section-{{ sid }} .mgal__tile img { transition: none; } }
</style>

<div class="mgal">
  <div class="mgal__head">
    {%- if st.heading != blank -%}<h2 class="mgal__heading">{{ st.heading | escape }}</h2>{%- endif -%}
    {%- if st.subheading != blank -%}<p class="mgal__sub">{{ st.subheading | escape }}</p>{%- endif -%}
  </div>
  <div class="mgal__grid">
    {%- for block in section.blocks -%}
      {%- assign b = block.settings -%}
      <a class="mgal__tile" href="{{ b.link | default: '/collections/all' }}" {{ block.shopify_attributes }} aria-label="{{ b.alt | default: st.heading | escape }}">
        {%- if b.image != blank -%}
          <img
            src="{{ b.image | image_url: width: 800 }}"
            srcset="{{ b.image | image_url: width: 400 }} 400w, {{ b.image | image_url: width: 800 }} 800w"
            sizes="(min-width: 768px) 25vw, 50vw"
            width="{{ b.image.width | default: 800 }}" height="{{ b.image.height | default: 800 }}"
            alt="{{ b.alt | escape }}" loading="lazy" decoding="async">
        {%- else -%}
          <img src="{{ placeholder }}" alt="" width="400" height="400">
        {%- endif -%}
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Picture row",
  "tag": "section",
  "class": "section sec__merch-gallery",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Worn by you" },
    { "type": "text", "id": "subheading", "label": "Line under the heading", "default": "Say where people can see more." },
    { "type": "select", "id": "heading_case", "label": "Heading letters", "options": [ { "value": "uppercase", "label": "Capitals" }, { "value": "none", "label": "As typed" } ], "default": "uppercase" },
    { "type": "select", "id": "heading_weight", "label": "Heading weight", "options": [ { "value": "400", "label": "Regular" }, { "value": "600", "label": "Semi bold" }, { "value": "800", "label": "Extra bold" } ], "default": "800" },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#111111" },
    { "type": "color", "id": "muted_color", "label": "Line under the heading", "default": "#5c5c5c" },
    { "type": "range", "id": "heading_size", "label": "Heading size, desktop", "min": 20, "max": 64, "step": 2, "unit": "px", "default": 32 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size, phone", "min": 18, "max": 40, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding", "label": "Space above and below, desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_mobile", "label": "Space above and below, phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "picture",
      "name": "Picture",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Picture" },
        { "type": "text", "id": "alt", "label": "Alt text" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    { "name": "Picture row", "blocks": [ { "type": "picture" }, { "type": "picture" }, { "type": "picture" }, { "type": "picture" } ] }
  ]
}
{% endschema %}
