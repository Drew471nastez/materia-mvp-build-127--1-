{% render 'theme-type' %}
{%- comment -%}
  Materia Themes. Products grid: a plain grid of the theme's own product
  cards (snippets/product-item) from one collection, with a heading above
  and a link to the whole collection below. Theme settings > Product cards
  draw every card. A shop with no products yet shows the theme's sample
  cards, so the section is never empty.

  This file used to be a copy of the product card with notes written inside
  its tags (`<a class="…" <!-- Added transition classes -->`): markup no
  browser reads as written. It drew one sample card and left the page
  around it broken. It is a section now.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign sid = section.id
  assign color_scheme = s.color_scheme.id | default: s.color_scheme | default: 'default-color-scheme'
  assign section_width = s.section_width | default: 'fluid_container'
  assign collection_obj = s.collection | default: collections.all
  assign items_to_show = s.items_to_show | default: 8
  assign items_per_row = s.items_per_row | default: 4
  assign items_per_row_mobile = s.items_per_row_mobile | default: 2
  assign column_gap = s.column_gap | default: 24
  assign scroll_animation = settings.scroll_animation
  if s.reveal == false
    assign scroll_animation = 'none'
  endif
  assign button_link = s.button_link
  if button_link == blank
    assign button_link = collection_obj.url | default: routes.all_products_collection_url
  endif
-%}
<style>
  /* The View all button's label sits in the middle of its height whatever the
     theme's button padding and minimum height (a block with a minimum height
     kept the words at the top). */
  #shopify-section-{{ section.id }} .pg__foot > .button { display: inline-flex; align-items: center; justify-content: center; }
  #shopify-section-{{ sid }} { isolation: isolate; position: relative; }
  {%- if s.reset_spacing -%}
    #shopify-section-{{ sid }}, #shopify-section-{{ sid }} > .section { margin-top: 0 !important; margin-bottom: 0 !important; }
    #shopify-section-{{ sid }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}
  #shopify-section-{{ sid }} .pg { padding-block: {{ s.padding_top | default: 48 | times: 0.6 | round }}px {{ s.padding_bottom | default: 48 | times: 0.6 | round }}px; }
  #shopify-section-{{ sid }} .pg__head { display: flex; flex-direction: column; gap: 8px; margin-bottom: 28px; text-align: {{ s.header_alignment | default: 'left' }}; align-items: {% if s.header_alignment == 'center' %}center{% else %}flex-start{% endif %}; }
  #shopify-section-{{ sid }} .pg__heading { margin: 0; overflow-wrap: anywhere; }
  #shopify-section-{{ sid }} .pg__text { margin: 0; max-width: 60ch; color: var(--color-text); }
  #shopify-section-{{ sid }} .pg__text > :first-child { margin-top: 0; }
  #shopify-section-{{ sid }} .pg__text > :last-child { margin-bottom: 0; }
  #shopify-section-{{ sid }} .pg__grid { display: grid; grid-template-columns: repeat({{ items_per_row_mobile }}, minmax(0, 1fr)); gap: {{ column_gap | times: 0.6 | round }}px; }
  #shopify-section-{{ sid }} .pg__grid > * { min-width: 0; }
  #shopify-section-{{ sid }} .pg__foot { display: flex; justify-content: center; margin-top: 32px; }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .pg { padding-block: {{ s.padding_top | default: 48 }}px {{ s.padding_bottom | default: 48 }}px; }
    #shopify-section-{{ sid }} .pg__grid { grid-template-columns: repeat({{ items_per_row | at_most: 3 }}, minmax(0, 1fr)); gap: {{ column_gap }}px; }
  }
  @media (min-width: 1025px) {
    #shopify-section-{{ sid }} .pg__grid { grid-template-columns: repeat({{ items_per_row }}, minmax(0, 1fr)); }
  }
</style>
<div class="pg section color-{{ color_scheme }} gradient" data-section-type="products-grid" data-section-id="{{ sid }}">
  <div class="{{ section_width }}">
    {%- if s.heading != blank or s.text != blank -%}
      <div class="pg__head">
        {%- if s.heading != blank -%}<h2 class="pg__heading h2">{{ s.heading }}</h2>{%- endif -%}
        {%- if s.text != blank -%}<div class="pg__text rte">{{ s.text }}</div>{%- endif -%}
      </div>
    {%- endif -%}
    <div class="pg__grid">
      {%- if collection_obj != blank and collection_obj.products_count > 0 -%}
        {%- for product in collection_obj.products limit: items_to_show -%}
          {% render 'product-item',
            card_product: product,
            section_id: sid,
            container: section_width,
            colunm: items_per_row,
            colunm_mobile: items_per_row_mobile,
            padding: column_gap,
            class: '',
            template_enable_action: true,
            template_enable_price: true,
            template_enable_add_cart: s.show_add_to_cart,
            scroll_animation: scroll_animation,
            indexFor: forloop.index,
            template_enable_product_badges: true
          %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..items_to_show) -%}
          {% render 'product-item',
            card_product: blank,
            section_id: sid,
            container: section_width,
            colunm: items_per_row,
            colunm_mobile: items_per_row_mobile,
            padding: column_gap,
            class: '',
            template_enable_price: true,
            scroll_animation: scroll_animation,
            indexFor: i
          %}
        {%- endfor -%}
      {%- endif -%}
    </div>
    {%- if s.button_label != blank -%}
      <div class="pg__foot">
        <a class="button inline-block btn-primary" data-theme-button="primary" href="{{ button_link }}">{{ s.button_label | escape }}</a>
      </div>
    {%- endif -%}
  </div>
</div>
{% schema %}
{
  "name": "Products grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Products"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Left empty, every product in the shop is shown."
    },
    {
      "type": "range",
      "id": "items_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_add_to_cart",
      "label": "Show add to cart",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "See all"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Left empty, the button opens the collection."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "items_per_row",
      "label": "Products per row",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "items_per_row_mobile",
      "label": "Products per row on phones",
      "min": 1,
      "max": 2,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Gap",
      "min": 8,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Heading alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "header",
      "content": "General"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default-color-scheme"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "fluid_container",
      "options": [
        {
          "value": "container",
          "label": "Default"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretched"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove space between sections",
      "default": false
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on scroll",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Products grid"
    }
  ]
}
{% endschema %}
