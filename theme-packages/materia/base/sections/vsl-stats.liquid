{%- comment -%}
Video sales letter: small cards with a figure, what it is and a note, each
  with a line icon in a glass tile. For facts about the offer (how long, how
  many lessons, the refund window), not invented results.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
-%}
{%- liquid
  assign count = section.blocks.size
  if count < 1
    assign count = 1
  endif
-%}
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap" data-vsl-font>
<style>
  .vsl { position: relative; color: var(--vsl-text, #a3a3a8); font-family: var(--body-font, inherit); -webkit-font-smoothing: antialiased; }
  .vsl *, .vsl *::before, .vsl *::after { box-sizing: border-box; }
  .vsl__inner { position: relative; max-width: var(--vsl-max, 1120px); margin: 0 auto; padding: 0 20px; }
  .vsl__head { text-align: center; margin: 0 auto 44px; max-width: 760px; }
  .vsl__eyebrow { display: flex; align-items: center; justify-content: center; gap: 14px; margin: 0 0 18px; font-size: 11px; font-weight: 500; letter-spacing: .24em; text-transform: uppercase; color: rgba(255,255,255,.6); }
  .vsl__eyebrow::before, .vsl__eyebrow::after { content: ""; flex: 0 0 34px; height: 1px; background: linear-gradient(90deg, rgba(255,255,255,0), rgba(255,255,255,.5)); }
  .vsl__eyebrow::after { background: linear-gradient(270deg, rgba(255,255,255,0), rgba(255,255,255,.5)); }
  .vsl__title { margin: 0; color: var(--vsl-head, #fff); font-family: var(--body-font, inherit); font-weight: 700; font-size: clamp(32px, 4.6vw, 52px); line-height: 1.06; letter-spacing: -.035em; text-wrap: balance; }
  .vsl__title em, .vsl em.vsl-serif { font-family: 'Instrument Serif', Georgia, 'Times New Roman', serif; font-style: italic; font-weight: 400; letter-spacing: -.01em; }
  .vsl__lede { margin: 16px auto 0; max-width: 580px; font-size: 15px; line-height: 1.65; }
  .vsl__lede p { margin: 0; }
  .vsl-btn {
    position: relative; isolation: isolate; overflow: hidden;
    display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 48px; padding: 0 24px;
    border-radius: 999px; border: 1px solid rgba(255,255,255,.24); background: rgba(10,10,12,.85); color: #fff;
    font-family: var(--body-font, inherit); font-size: 14px; font-weight: 600; letter-spacing: -.005em; text-decoration: none; white-space: nowrap;
    box-shadow: inset 0 1px 0 rgba(255,255,255,.22), 0 0 0 4px rgba(255,255,255,.03), 0 14px 40px -14px rgba(255,255,255,.35);
    transition: transform .35s cubic-bezier(.2,.7,.2,1), border-color .35s, box-shadow .35s;
  }
  .vsl-btn::before { content: ""; position: absolute; z-index: -1; top: -1px; left: -40%; width: 40%; height: 2px; background: linear-gradient(90deg, transparent, #fff, transparent); opacity: .9; transition: transform 1.1s cubic-bezier(.2,.7,.2,1); }
  .vsl-btn:hover { transform: translateY(-1px); border-color: rgba(255,255,255,.5); box-shadow: inset 0 1px 0 rgba(255,255,255,.3), 0 0 0 4px rgba(255,255,255,.05), 0 18px 50px -14px rgba(255,255,255,.45); }
  .vsl-btn:hover::before { transform: translateX(350%); }
  .vsl-btn:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
  .vsl-btn svg { width: 16px; height: 16px; flex: none; transition: transform .35s cubic-bezier(.2,.7,.2,1); }
  .vsl-btn:hover svg { transform: translateX(3px); }
  .vsl-btn--light { background: #fff; color: #0a0a0a; border-color: #fff; box-shadow: 0 14px 40px -14px rgba(255,255,255,.5); }
  .vsl-btn--light::before { display: none; }
  .vsl-btn--ghost { background: transparent; box-shadow: none; border-color: rgba(255,255,255,.16); }
  .vsl__actions { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 12px; margin-top: 30px; }
  .vsl-card {
    position: relative; border-radius: 18px; border: 1px solid rgba(255,255,255,.09);
    background: linear-gradient(180deg, rgba(255,255,255,.06), rgba(255,255,255,.015) 60%), rgba(12,12,14,.72);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.07), 0 30px 60px -40px rgba(0,0,0,.9);
  }
  .vsl--line { padding-top: 1px; }
  .vsl--line::before { content: ""; position: absolute; left: 50%; top: 0; width: min(1120px, calc(100% - 40px)); height: 1px; transform: translateX(-50%); background: linear-gradient(90deg, rgba(255,255,255,0), rgba(255,255,255,.26) 50%, rgba(255,255,255,0)); }
  .vsl--line::after { content: ""; position: absolute; left: 50%; top: 0; width: min(900px, 90%); height: 180px; transform: translateX(-50%); pointer-events: none; background: radial-gradient(50% 100% at 50% 0, rgba(255,255,255,.07), rgba(255,255,255,0)); }
  @media (max-width: 749px) { .vsl__eyebrow { letter-spacing: .18em; gap: 10px; } .vsl__eyebrow::before, .vsl__eyebrow::after { flex-basis: 22px; } .vsl__head { margin-bottom: 32px; } }
  html.vsl-js .vsl [data-motion] { opacity: 0; transform: translate3d(0, 22px, 0); transition: opacity .9s cubic-bezier(.2,.65,.2,1), transform .9s cubic-bezier(.2,.65,.2,1); transition-delay: var(--d, 0ms); }
  html.vsl-js .vsl [data-motion].is-in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    html.vsl-js .vsl [data-motion] { opacity: 1; transform: none; transition: none; }
    .vsl-btn, .vsl-btn::before, .vsl-btn svg { transition: none; }
  }

  #shopify-section-{{ sid }} .vsl { padding-top: {{ st.padding_top_mobile | default: 64 }}px; padding-bottom: {{ st.padding_bottom_mobile | default: 64 }}px; }
  @media (min-width: 750px) { #shopify-section-{{ sid }} .vsl { padding-top: {{ st.padding_top | default: 96 }}px; padding-bottom: {{ st.padding_bottom | default: 96 }}px; } }

  .vsl-stats__grid { display: grid; gap: 16px; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 750px) { #shopify-section-{{ sid }} .vsl-stats__grid { grid-template-columns: repeat({% if count > 3 %}2{% else %}{{ count }}{% endif %}, minmax(0, 1fr)); } }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .vsl-stats__grid { grid-template-columns: repeat({{ count }}, minmax(0, 1fr)); } }
  .vsl-stats .vsl-card { display: flex; flex-direction: column; padding: 24px 24px 22px; min-height: 150px; }
  .vsl-stats__top { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
  .vsl-stats__value { color: #fff; font-size: 28px; font-weight: 600; letter-spacing: -.03em; line-height: 1; font-variant-numeric: tabular-nums; }
  .vsl-stats__icon { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 11px; color: #fff; flex: none;
    background: linear-gradient(180deg, rgba(255,255,255,.16), rgba(255,255,255,.04)); border: 1px solid rgba(255,255,255,.14); box-shadow: inset 0 1px 0 rgba(255,255,255,.25); }
  .vsl-stats__icon svg { width: 18px; height: 18px; }
  .vsl-stats__label { margin: auto 0 0; padding-top: 26px; color: rgba(255,255,255,.88); font-size: 14px; font-weight: 500; }
  .vsl-stats__note { margin: 4px 0 0; font-size: 13px; color: rgba(255,255,255,.5); }
  @media (max-width: 749px) { .vsl-stats .vsl-card { min-height: 0; padding: 18px 18px 16px; } .vsl-stats__label { padding-top: 12px; } .vsl-stats__value { font-size: 24px; } .vsl-stats__grid { gap: 10px; } }
</style>
<div data-own-font class="vsl{% if st.line_above %} vsl--line{% endif %} vsl-stats">
  <div class="vsl__inner">
    {%- if st.eyebrow != blank or st.heading != blank or st.text != blank -%}
      <div class="vsl__head" data-motion>
        {%- if st.eyebrow != blank -%}<p class="vsl__eyebrow"><span>{{ st.eyebrow | escape }}</span></p>{%- endif -%}
        {%- if st.heading != blank -%}<h2 class="vsl__title">{%- assign vsl_parts = st.heading | escape | split: '*' -%}{%- for vsl_part in vsl_parts -%}{%- assign vsl_odd = forloop.index0 | modulo: 2 -%}{%- if vsl_odd == 1 -%}<em>{{ vsl_part | replace: '|', '<br>' }}</em>{%- else -%}{{ vsl_part | replace: '|', '<br>' }}{%- endif -%}{%- endfor -%}</h2>{%- endif -%}
        {%- if st.text != blank -%}<div class="vsl__lede">{{ st.text }}</div>{%- endif -%}
      </div>
    {%- endif -%}
    <div class="vsl-stats__grid">
      {%- for block in section.blocks -%}
        <div class="vsl-card" data-motion style="--d: {{ forloop.index0 | times: 90 }}ms" {{ block.shopify_attributes }}>
          <div class="vsl-stats__top">
            <span class="vsl-stats__value">{{ block.settings.value | escape }}</span>
            <span class="vsl-stats__icon" aria-hidden="true"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" focusable="false">{%- case block.settings.icon -%}
  {%- when 'calendar' -%}<rect x="3" y="4.5" width="14" height="12.5" rx="2"/><path d="M3 8.5h14M7 2.5v4M13 2.5v4"/>
  {%- when 'play' -%}<rect x="2.5" y="4" width="15" height="12" rx="2.5"/><path d="M8.5 7.5v5l4-2.5z" fill="currentColor"/>
  {%- when 'shield' -%}<path d="M10 2.5l6 2.2v5c0 4-2.7 6.4-6 7.8-3.3-1.4-6-3.8-6-7.8v-5z"/><path d="M7.3 10l1.9 1.9 3.6-3.8"/>
  {%- when 'chat' -%}<path d="M3.5 5.5a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H9l-3.5 3v-3h0a2 2 0 0 1-2-2z"/>
  {%- when 'people' -%}<circle cx="7.5" cy="7" r="2.6"/><path d="M2.8 16.5c.6-2.7 2.4-4.2 4.7-4.2s4.1 1.5 4.7 4.2"/><circle cx="14" cy="7.8" r="2"/><path d="M13.5 12.4c1.8.2 3.1 1.5 3.6 4.1"/>
  {%- else -%}<circle cx="10" cy="10" r="7"/><path d="M10 6v4.3l2.8 1.7"/>
{%- endcase -%}</svg></span>
          </div>
          {%- if block.settings.label != blank -%}<p class="vsl-stats__label">{{ block.settings.label | escape }}</p>{%- endif -%}
          {%- if block.settings.note != blank -%}<p class="vsl-stats__note">{{ block.settings.note | escape }}</p>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;
    var still = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!('IntersectionObserver' in window) || still) return;
    document.documentElement.classList.add('vsl-js');
    if (!window.__vslSeen) {
      window.__vslSeen = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('is-in'); window.__vslSeen.unobserve(e.target); } });
      }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
    }
    root.querySelectorAll('[data-motion]:not(.is-in)').forEach(function (el) { window.__vslSeen.observe(el); });
  })();
</script>

{% schema %}
{
  "name": "Small figures",
  "tag": "section",
  "class": "vsl-stats-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small label",
      "default": ""
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "",
      "info": "Words between asterisks are set in italic serif, like *this*. A | starts a new line."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": ""
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "checkbox",
      "id": "line_above",
      "label": "Thin glowing line above",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Space above, desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Space below, desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Space above, phone",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Space below, phone",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "figure",
      "name": "Figure",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Figure",
          "default": "6 weeks"
        },
        {
          "type": "text",
          "id": "label",
          "label": "What it is",
          "default": "Course length"
        },
        {
          "type": "text",
          "id": "note",
          "label": "Note",
          "default": "Two hours a week"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "clock",
          "options": [
            {
              "value": "clock",
              "label": "Clock"
            },
            {
              "value": "calendar",
              "label": "Calendar"
            },
            {
              "value": "play",
              "label": "Video"
            },
            {
              "value": "shield",
              "label": "Shield"
            },
            {
              "value": "chat",
              "label": "Speech bubble"
            },
            {
              "value": "people",
              "label": "People"
            }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Small figures",
      "category": "Video sales letter",
      "blocks": [
        {
          "type": "figure"
        },
        {
          "type": "figure",
          "settings": {
            "value": "12 lessons",
            "label": "Short videos",
            "note": "Under 20 minutes each",
            "icon": "play"
          }
        },
        {
          "type": "figure",
          "settings": {
            "value": "30 days",
            "label": "Refund window",
            "note": "From the day you join",
            "icon": "shield"
          }
        }
      ]
    }
  ]
}
{% endschema %}
