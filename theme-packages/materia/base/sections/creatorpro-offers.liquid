{%- comment -%}
  Content creator: the courses and products. A heading and a line, then a
  large card per offer: its picture, a small label, the name, a line, a
  few facts in a row (lessons, hours, level), the price (and old price)
  read from the product when one is picked, and a solid button. The first
  card can be wide (picture beside the text) with the rest two across.
  Stacked on a phone. The picture zooms a little on hover.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign color_scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
-%}
<style>
  #shopify-section-{{ sid }} .cpo { background: {{ st.background | default: '#ffffff' }}; padding: {{ st.padding_top_mobile | default: 56 }}px 20px {{ st.padding_bottom_mobile | default: 56 }}px; scroll-margin-top: 80px; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .cpo { padding: {{ st.padding_top | default: 96 }}px 40px {{ st.padding_bottom | default: 96 }}px; } }
  #shopify-section-{{ sid }} .cpo__inner { max-width: 1200px; margin: 0 auto; }
  #shopify-section-{{ sid }} .cpo__eyebrow { margin: 0 0 12px; color: {{ st.accent_color | default: '#ff5a36' }}; font-size: 14px; font-weight: 700; }
  #shopify-section-{{ sid }} .cpo__heading { margin: 0; max-width: 18ch; color: var(--color-heading); font-family: var(--heading-font, inherit); font-weight: var(--heading-weight, 700); font-size: {{ st.heading_size_mobile | default: 34 }}px; line-height: 1.05; letter-spacing: -0.03em; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .cpo__heading { font-size: {{ st.heading_size | default: 52 }}px; } }
  #shopify-section-{{ sid }} .cpo__heading em { font-style: normal; color: {{ st.accent_color | default: '#ff5a36' }}; }
  #shopify-section-{{ sid }} .cpo__text { margin: 14px 0 0; max-width: 52ch; color: var(--color-text); font-size: 17px; line-height: 1.55; }
  #shopify-section-{{ sid }} .cpo__grid { list-style: none; margin: 40px 0 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 20px; }
  @media (min-width: 750px) { #shopify-section-{{ sid }} .cpo__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; margin-top: 52px; } }
  #shopify-section-{{ sid }} .cpo__card { display: flex; flex-direction: column; overflow: hidden; border-radius: {{ st.radius | default: 24 }}px; background: {{ st.card_color | default: '#f5f4f0' }}; }
  @media (min-width: 750px) { #shopify-section-{{ sid }} .cpo__card--wide { grid-column: 1 / -1; display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); } }
  #shopify-section-{{ sid }} .cpo__media { position: relative; overflow: hidden; aspect-ratio: 16 / 10; background: #e4e2dc; }
  #shopify-section-{{ sid }} .cpo__card--wide .cpo__media { aspect-ratio: auto; min-height: 320px; }
  #shopify-section-{{ sid }} .cpo__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; margin: 0; transition: transform 0.6s ease; }
  #shopify-section-{{ sid }} .cpo__card:hover .cpo__media img { transform: scale(1.03); }
  #shopify-section-{{ sid }} .cpo__body { display: flex; flex-direction: column; flex: 1 1 auto; padding: 24px 22px 24px; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .cpo__body { padding: 32px 34px; } #shopify-section-{{ sid }} .cpo__card--wide .cpo__body { padding: 48px 52px; justify-content: center; } }
  #shopify-section-{{ sid }} .cpo__label { align-self: flex-start; margin: 0 0 14px; padding: 5px 11px; border-radius: 999px; background: #fff; color: var(--color-heading); font-size: 12.5px; font-weight: 700; }
  #shopify-section-{{ sid }} .cpo__card--wide .cpo__label { background: {{ st.accent_color | default: '#ff5a36' }}; color: #fff; }
  #shopify-section-{{ sid }} .cpo__name { margin: 0; color: var(--color-heading); font-size: 26px; font-weight: 700; line-height: 1.15; letter-spacing: -0.02em; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .cpo__card--wide .cpo__name { font-size: 36px; } }
  #shopify-section-{{ sid }} .cpo__line { margin: 10px 0 0; color: var(--color-text); font-size: 16px; line-height: 1.55; }
  #shopify-section-{{ sid }} .cpo__facts { display: flex; flex-wrap: wrap; gap: 8px 18px; margin: 18px 0 0; padding: 0; list-style: none; color: var(--color-heading); font-size: 14px; font-weight: 600; }
  #shopify-section-{{ sid }} .cpo__facts li { display: inline-flex; align-items: center; gap: 7px; }
  #shopify-section-{{ sid }} .cpo__facts li::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: {{ st.accent_color | default: '#ff5a36' }}; }
  #shopify-section-{{ sid }} .cpo__foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 14px; margin-top: auto; padding-top: 24px; }
  #shopify-section-{{ sid }} .cpo__price { margin: 0; color: var(--color-heading); font-size: 26px; font-weight: 700; letter-spacing: -0.02em; }
  #shopify-section-{{ sid }} .cpo__was { margin-left: 8px; font-size: 16px; font-weight: 500; color: var(--color-text); text-decoration: line-through; }
  #shopify-section-{{ sid }} .cpo__btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 50px; padding: 0 22px; border-radius: {{ st.button_radius | default: 12 }}px; background: {{ st.button_color | default: '#101114' }}; color: {{ st.button_text_color | default: '#ffffff' }}; font-size: 15px; font-weight: 700; text-decoration: none; transition: background-color 0.2s ease; }
  #shopify-section-{{ sid }} .cpo__btn:hover { background: {{ st.accent_color | default: '#ff5a36' }}; }
  @media (prefers-reduced-motion: reduce) { #shopify-section-{{ sid }} .cpo__media img { transition: none; } }
</style>
<div class="cpo color-{{ color_scheme }}" id="{{ st.anchor | default: 'courses' | handleize }}" data-section-id="{{ sid }}">
  <div class="cpo__inner">
    {%- if st.eyebrow != blank -%}<p class="cpo__eyebrow">{{ st.eyebrow | escape }}</p>{%- endif -%}
    {%- if st.heading != blank -%}<h2 class="cpo__heading">{{ st.heading }}</h2>{%- endif -%}
    {%- if st.text != blank -%}<p class="cpo__text">{{ st.text | escape }}</p>{%- endif -%}
    <ul class="cpo__grid" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign p = b.product
          assign amount = b.price
          assign was = b.compare_price
          assign href = b.button_link | default: '/collections/all'
          assign pic = b.image
          if p != blank and p.title != blank
            assign amount = p.price | money_without_trailing_zeros
            assign was = ''
            if p.compare_at_price > p.price
              assign was = p.compare_at_price | money_without_trailing_zeros
            endif
            assign href = p.url
            if pic == blank
              assign pic = p.featured_image
            endif
          endif
          assign facts = b.facts | newline_to_br | split: '<br />'
        -%}
        <li class="cpo__card{% if forloop.first and st.first_wide %} cpo__card--wide{% endif %}" {{ block.shopify_attributes }}>
          <div class="cpo__media">{%- if pic != blank -%}<img src="{{ pic | image_url: width: 1100 }}" srcset="{{ pic | image_url: width: 600 }} 600w, {{ pic | image_url: width: 1100 }} 1100w" sizes="(min-width: 750px) 50vw, 92vw" width="1100" height="688" alt="{{ b.name | escape }}" loading="lazy" decoding="async">{%- endif -%}</div>
          <div class="cpo__body">
            {%- if b.label != blank -%}<span class="cpo__label">{{ b.label | escape }}</span>{%- endif -%}
            <h3 class="cpo__name">{{ b.name | escape }}</h3>
            {%- if b.line != blank -%}<p class="cpo__line">{{ b.line | escape }}</p>{%- endif -%}
            {%- if b.facts != blank -%}<ul class="cpo__facts" role="list">{%- for f in facts -%}{%- assign t = f | strip -%}{%- if t != blank -%}<li>{{ t | escape }}</li>{%- endif -%}{%- endfor -%}</ul>{%- endif -%}
            <div class="cpo__foot">
              {%- if amount != blank -%}<p class="cpo__price">{{ amount }}{%- if was != blank -%}<span class="cpo__was">{{ was }}</span>{%- endif -%}</p>{%- endif -%}
              {%- if b.button_label != blank -%}<a class="cpo__btn" href="{{ href }}">{{ b.button_label | escape }}<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg></a>{%- endif -%}
            </div>
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>
{% schema %}
{
  "name": "Creator offers",
  "tag": "section",
  "class": "section sec__creatorpro-offers",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default-color-scheme" },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "card_color", "label": "Cards", "default": "#f5f4f0" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#ff5a36" },
    { "type": "range", "id": "radius", "label": "Card corners", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 24 },
    { "type": "checkbox", "id": "first_wide", "label": "First card across the whole width", "default": true },
    { "type": "color", "id": "button_color", "label": "Button colour", "default": "#101114" },
    { "type": "color", "id": "button_text_color", "label": "Button text colour", "default": "#ffffff" },
    { "type": "range", "id": "button_radius", "label": "Button corners", "min": 0, "max": 30, "step": 1, "unit": "px", "default": 12 },
    { "type": "text", "id": "anchor", "label": "Name for links to this section", "default": "courses" },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Courses" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Learn it <em>properly</em>" },
    { "type": "text", "id": "text", "label": "Line", "default": "Say what your courses and products help people do." },
    { "type": "range", "id": "heading_size", "label": "Heading size, desktop", "min": 28, "max": 80, "step": 2, "unit": "px", "default": 52 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size, phone", "min": 24, "max": 52, "step": 2, "unit": "px", "default": 34 },
    { "type": "range", "id": "padding_top", "label": "Space above, desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Space below, desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_top_mobile", "label": "Space above, phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Space below, phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    { "type": "offer", "name": "Offer", "settings": [
      { "type": "product", "id": "product", "label": "Product", "info": "Takes the price, picture and link from the product. Leave empty to type them." },
      { "type": "image_picker", "id": "image", "label": "Picture" },
      { "type": "text", "id": "label", "label": "Small label", "default": "Course" },
      { "type": "text", "id": "name", "label": "Name", "default": "Course name" },
      { "type": "text", "id": "line", "label": "Line", "default": "One line on what it helps people do." },
      { "type": "textarea", "id": "facts", "label": "Facts, one per line", "default": "24 lessons\n6 hours\nBeginner" },
      { "type": "text", "id": "price", "label": "Price", "default": "$99" },
      { "type": "text", "id": "compare_price", "label": "Old price" },
      { "type": "text", "id": "button_label", "label": "Button", "default": "See the course" },
      { "type": "url", "id": "button_link", "label": "Button link", "info": "Used when no product is picked." }
    ] }
  ],
  "max_blocks": 7,
  "presets": [ { "name": "Creator offers", "blocks": [ { "type": "offer" }, { "type": "offer" }, { "type": "offer" } ] } ]
}
{% endschema %}
