{%- comment -%}
  Online course: a picture beside a label, a heading with accent words, a
  paragraph and rows that open. Each row has a filled icon square, a title
  and a square button with a plus that turns into a cross when the row is
  open (details and summary: no script, keyboard and screen readers work as
  everywhere). Used for why the course works and for the teacher.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign sid = section.id
-%}
<style>
  #shopify-section-{{ sid }} .c2s {
    --c2-accent: {{ s.accent | default: '#12704f' }};
    --c2-ink: {{ s.heading_color | default: '#15171a' }};
    --c2-text: {{ s.text_color | default: '#3f444c' }};
    --c2-line: {{ s.line_color | default: '#e3e5e8' }};
    background: {{ s.background | default: '#ffffff' }};
    color: var(--c2-text);
    padding: {{ s.padding_top_mobile | default: 48 }}px 0 {{ s.padding_bottom_mobile | default: 48 }}px;
  }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .c2s { padding: {{ s.padding_top | default: 96 }}px 0 {{ s.padding_bottom | default: 96 }}px; } }
  #shopify-section-{{ sid }} .c2s__in { max-width: 1200px; margin: 0 auto; padding: 0 20px; display: grid; gap: 36px; align-items: center; }
  @media (min-width: 990px) {
    #shopify-section-{{ sid }} .c2s__in { padding: 0 40px; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 56px; }
    #shopify-section-{{ sid }} .c2s[data-side='left'] .c2s__media { order: -1; }
  }
  #shopify-section-{{ sid }} .c2s__media { margin: 0; border-radius: 18px; overflow: hidden; background: #eef0ee; aspect-ratio: {{ s.image_ratio | default: '9 / 10' }}; }
  @media (max-width: 989px) { #shopify-section-{{ sid }} .c2s__media { order: -1; aspect-ratio: 4 / 3; } }
  #shopify-section-{{ sid }} .c2s__media img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: {{ s.image_focus | default: 'center' }}; margin: 0; }
  #shopify-section-{{ sid }} .c2-tag { display: inline-block; margin: 0 0 22px; padding: 8px 12px; border: 1px solid #d9dce1; border-radius: 6px; font-size: 13px; line-height: 1; letter-spacing: .05em; text-transform: uppercase; color: var(--c2-ink); }
  #shopify-section-{{ sid }} .c2s__title { margin: 0 0 20px; color: var(--c2-ink); font-family: var(--heading-font, inherit); font-weight: 700; font-size: 34px; line-height: 1.06; letter-spacing: -.035em; text-wrap: balance; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .c2s__title { font-size: {{ s.heading_size | default: 48 }}px; } }
  #shopify-section-{{ sid }} .c2s__title em { font-style: normal; color: var(--c2-accent); }
  #shopify-section-{{ sid }} .c2s__text { max-width: 33em; font-size: 17px; line-height: 1.6; }
  #shopify-section-{{ sid }} .c2s__text p { margin: 0 0 12px; }
  #shopify-section-{{ sid }} .c2s__rows { margin-top: 34px; border-top: 1px solid var(--c2-line); }
  #shopify-section-{{ sid }} .c2s__row { border-bottom: 1px solid var(--c2-line); }
  #shopify-section-{{ sid }} .c2s__row summary { list-style: none; display: flex; align-items: center; gap: 16px; padding: 18px 0; cursor: pointer; }
  #shopify-section-{{ sid }} .c2s__row summary::-webkit-details-marker { display: none; }
  #shopify-section-{{ sid }} .c2s__ico { flex: none; display: grid; place-items: center; width: 48px; height: 48px; border-radius: 10px; background: var(--c2-accent); color: #fff; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .c2s__ico { width: 56px; height: 56px; } }
  #shopify-section-{{ sid }} .c2s__ico svg { width: 24px; height: 24px; }
  #shopify-section-{{ sid }} .c2s__rt { flex: 1 1 auto; color: var(--c2-ink); font-family: var(--heading-font, inherit); font-weight: 700; font-size: 18px; letter-spacing: -.02em; line-height: 1.25; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .c2s__rt { font-size: 21px; } }
  #shopify-section-{{ sid }} .c2s__plus { flex: none; position: relative; width: 38px; height: 38px; border-radius: 6px; background: var(--c2-accent); }
  #shopify-section-{{ sid }} .c2s__plus::before, #shopify-section-{{ sid }} .c2s__plus::after { content: ""; position: absolute; left: 50%; top: 50%; width: 16px; height: 1.5px; margin: -.75px 0 0 -8px; background: #fff; transition: transform .35s cubic-bezier(.2,.65,.25,1); }
  #shopify-section-{{ sid }} .c2s__plus::after { transform: rotate(90deg); }
  #shopify-section-{{ sid }} details[open] .c2s__plus::before { transform: rotate(45deg); }
  #shopify-section-{{ sid }} details[open] .c2s__plus::after { transform: rotate(135deg); }
  #shopify-section-{{ sid }} .c2s__ra { padding: 0 54px 20px 64px; font-size: 16px; line-height: 1.6; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .c2s__ra { padding-left: 72px; } }
  #shopify-section-{{ sid }} .c2s__ra p { margin: 0 0 8px; }
  #shopify-section-{{ sid }} details[open] .c2s__ra { animation: c2s-open-{{ sid }} .45s cubic-bezier(.2,.65,.25,1); }
  @keyframes c2s-open-{{ sid }} { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: none; } }
  #shopify-section-{{ sid }} .c2s__btn { display: inline-flex; align-items: center; min-height: 52px; margin-top: 28px; padding: 0 26px; border-radius: 10px; background: var(--c2-accent); color: #fff; font-size: 16px; font-weight: 600; text-decoration: none; transition: filter .25s ease; }
  #shopify-section-{{ sid }} .c2s__btn:hover { filter: brightness(.92); }
  #shopify-section-{{ sid }} [data-c2r].c2r-wait { opacity: 0; transform: translate3d(0, 22px, 0); }
  #shopify-section-{{ sid }} [data-c2r].c2r-in { opacity: 1; transform: none; transition: opacity .8s cubic-bezier(.2,.65,.25,1) var(--d, 0ms), transform .8s cubic-bezier(.2,.65,.25,1) var(--d, 0ms); }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} details[open] .c2s__ra { animation: none; }
    #shopify-section-{{ sid }} .c2s__plus::before, #shopify-section-{{ sid }} .c2s__plus::after { transition: none; }
  }
</style>
<section class="c2s" data-side="{{ s.image_side | default: 'right' }}"{% if s.anchor != blank %} id="{{ s.anchor | handleize }}"{% endif %}>
  <div class="c2s__in">
    <div class="c2s__body">
      {%- if s.tag != blank -%}<p class="c2-tag" data-c2r>{{ s.tag | escape }}</p>{%- endif -%}
      {%- if s.heading != blank or s.heading_accent != blank -%}<h2 class="c2s__title" data-c2r style="--d: 60ms">{{ s.heading | escape }}{% if s.heading_accent != blank %} <em>{{ s.heading_accent | escape }}</em>{% endif %}</h2>{%- endif -%}
      {%- if s.text != blank -%}<div class="c2s__text" data-c2r style="--d: 120ms">{{ s.text }}</div>{%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <div class="c2s__rows" data-c2r style="--d: 180ms">
          {%- for block in section.blocks -%}
            {%- assign b = block.settings -%}
            <details class="c2s__row" {{ block.shopify_attributes }}{% if forloop.first and s.first_open %} open{% endif %}>
              <summary>
                <span class="c2s__ico" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" focusable="false">
                    {%- case b.icon -%}
                      {%- when 'target' -%}<circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="4.5"/><circle cx="12" cy="12" r=".8" fill="currentColor"/>
                      {%- when 'drop' -%}<path d="M12 3.5c3.5 4.5 6 7.6 6 10.6a6 6 0 0 1-12 0c0-3 2.5-6.1 6-10.6z"/>
                      {%- when 'scale' -%}<rect x="3.5" y="13" width="17" height="6.5" rx="2"/><path d="M8 13a4 4 0 0 1 8 0"/><path d="M12 9V6.5"/>
                      {%- when 'cup' -%}<path d="M4 9h13v4a6 6 0 0 1-6 6h-1a6 6 0 0 1-6-6z"/><path d="M17 10.5h1.5a2.5 2.5 0 0 1 0 5H16.5"/>
                      {%- when 'clock' -%}<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>
                      {%- when 'pin' -%}<path d="M12 21s-6.5-6-6.5-11a6.5 6.5 0 0 1 13 0c0 5-6.5 11-6.5 11z"/><circle cx="12" cy="10" r="2.3"/>
                      {%- when 'chat' -%}<path d="M4 5h16v11H9l-5 4z"/>
                      {%- when 'book' -%}<path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H6.5A2.5 2.5 0 0 0 4 20.5z"/><path d="M4 20.5A2.5 2.5 0 0 1 6.5 18H20v3H6.5"/>
                      {%- when 'home' -%}<path d="M4 11l8-6.5 8 6.5V20h-5.5v-5h-5v5H4z"/>
                      {%- else -%}<path d="M12 3l2.6 5.6 6 .7-4.5 4.1 1.2 6L12 16.4 6.7 19.4l1.2-6L3.4 9.3l6-.7z"/>
                    {%- endcase -%}
                  </svg>
                </span>
                <span class="c2s__rt">{{ b.title | escape }}</span>
                <span class="c2s__plus" aria-hidden="true"></span>
              </summary>
              <div class="c2s__ra">{{ b.text }}</div>
            </details>
          {%- endfor -%}
        </div>
      {%- endif -%}
      {%- if s.button_label != blank -%}<a class="c2s__btn" href="{{ s.button_link | default: '/collections/all' }}" data-c2r>{{ s.button_label | escape }}</a>{%- endif -%}
    </div>
    <figure class="c2s__media" data-c2r style="--d: 120ms">
      {%- if s.image != blank -%}
        <img src="{{ s.image | image_url: width: 1400 }}" srcset="{{ s.image | image_url: width: 700 }} 700w, {{ s.image | image_url: width: 1000 }} 1000w, {{ s.image | image_url: width: 1400 }} 1400w" sizes="(min-width: 990px) 560px, 92vw" width="{{ s.image.width | default: 1400 }}" height="{{ s.image.height | default: 1500 }}" alt="{{ s.image_alt | default: s.image.alt | escape }}" loading="lazy" decoding="async">
      {%- endif -%}
    </figure>
  </div>
</section>
{%- unless request.design_mode -%}
<script>(function(){var r=document.getElementById('shopify-section-{{ sid }}');if(!r||!('IntersectionObserver' in window)||matchMedia('(prefers-reduced-motion: reduce)').matches)return;var h=innerHeight,io=new IntersectionObserver(function(es){es.forEach(function(e){if(!e.isIntersecting)return;var t=e.target;io.unobserve(t);requestAnimationFrame(function(){t.classList.add('c2r-in')})})},{rootMargin:'0px 0px -6% 0px'});r.querySelectorAll('[data-c2r]').forEach(function(el){if(el.getBoundingClientRect().top<h*.92)return;el.classList.add('c2r-wait');io.observe(el)})})();</script>
{%- endunless -%}

{% schema %}
{
  "name": "Picture with rows",
  "tag": "section",
  "class": "course2-split-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "tag", "label": "Label above", "default": "Why this course" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Short lessons you" },
    { "type": "text", "id": "heading_accent", "label": "Heading words in the accent colour", "default": "follow along with" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Say in two sentences why this course works where others did not.</p>" },
    { "type": "checkbox", "id": "first_open", "label": "First row open", "default": false },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "anchor", "label": "Address on the page", "info": "A word a menu link can jump to, as /#word." },
    { "type": "header", "content": "Picture" },
    { "type": "image_picker", "id": "image", "label": "Picture" },
    { "type": "text", "id": "image_alt", "label": "Picture description" },
    { "type": "select", "id": "image_side", "label": "Picture side", "default": "right", "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ] },
    { "type": "select", "id": "image_ratio", "label": "Picture shape on desktop", "default": "9 / 10", "options": [ { "value": "1 / 1", "label": "Square" }, { "value": "9 / 10", "label": "Nearly square" }, { "value": "4 / 5", "label": "Portrait" } ] },
    { "type": "select", "id": "image_focus", "label": "Picture focus", "default": "center", "options": [ { "value": "center", "label": "Middle" }, { "value": "top", "label": "Top" }, { "value": "bottom", "label": "Bottom" }, { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ] },
    { "type": "range", "id": "heading_size", "label": "Heading size on desktop", "min": 28, "max": 72, "step": 2, "unit": "px", "default": 48 },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#12704f" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#15171a" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#3f444c" },
    { "type": "color", "id": "line_color", "label": "Lines", "default": "#e3e5e8" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Space above on desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Space below on desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_top_mobile", "label": "Space above on phones", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Space below on phones", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "star", "options": [ { "value": "star", "label": "Star" }, { "value": "target", "label": "Target" }, { "value": "drop", "label": "Drop" }, { "value": "scale", "label": "Scale" }, { "value": "cup", "label": "Cup" }, { "value": "clock", "label": "Clock" }, { "value": "pin", "label": "Place" }, { "value": "chat", "label": "Message" }, { "value": "book", "label": "Book" }, { "value": "home", "label": "Home" } ] },
        { "type": "text", "id": "title", "label": "Title", "default": "One idea per lesson" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Say what this means for the student, in one or two sentences.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Picture with rows",
      "category": "Online course",
      "blocks": [
        { "type": "row", "settings": { "icon": "target" } },
        { "type": "row", "settings": { "icon": "clock", "title": "Ten minutes a day", "text": "<p>Say how long a lesson takes and when people fit it in.</p>" } },
        { "type": "row", "settings": { "icon": "chat", "title": "Questions answered", "text": "<p>Say where students ask and how fast they hear back.</p>" } }
      ]
    }
  ]
}
{% endschema %}
