{%- comment -%}
XP shop: the wallpaper behind every window, one photograph that covers the
  screen at every width and stays put while the page scrolls.

  It is a layer pinned to the top of the page with position: sticky rather
  than a fixed background. A fixed background is painted again for every
  screen when a long page is photographed a screen at a time (the template's
  cover and phone picture), which showed the photograph cut and repeated down
  the page; a sticky layer is drawn once. On a visit the two look the same.

  Place it in the header group after "XP desktop and taskbar" and leave that
  section's own wallpaper empty.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign focal = st.focal | default: '50% 70%'
  assign shade = st.wall_shade | default: 0 | divided_by: 100.0
-%}
{%- if st.wallpaper != blank -%}
<style>
  html { background: {{ st.page_color | default: '#6fa3e3' }} !important; }
  body > .xp-wall { display: none !important; }
  .xpw-wall { position: sticky; top: 0; z-index: -1; display: block; width: 100%; height: 100vh; height: 100lvh; margin-bottom: -100vh; margin-bottom: -100lvh; overflow: hidden; pointer-events: none; background: {{ st.page_color | default: '#6fa3e3' }}; }
  .xpw-wall img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: {{ focal }}; }
  .xpw-wall::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(255,255,255,0) 60%, rgba(10,40,10,{{ shade }}) 100%); }
</style>
<div class="xpw-wall" aria-hidden="true" data-xpw-wall>
  <img src="{{ st.wallpaper | image_url: width: 1600 }}" srcset="{{ st.wallpaper | image_url: width: 900 }} 900w, {{ st.wallpaper | image_url: width: 1400 }} 1400w, {{ st.wallpaper | image_url: width: 2000 }} 2000w" sizes="100vw" alt="" width="{{ st.wallpaper.width | default: 2000 }}" height="{{ st.wallpaper.height | default: 1330 }}" fetchpriority="high" decoding="async">
</div>
<script>
  (function () {
    var wall = document.querySelector('#shopify-section-{{ section.id }} [data-xpw-wall]');
    if (!wall || wall.parentNode === document.body) return;
    /* The page's own first layer, so it stays pinned from the top of the page to the bottom. */
    document.querySelectorAll('body > .xpw-wall').forEach(function (old) { if (old !== wall) old.remove(); });
    document.body.prepend(wall);
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "XP wallpaper",
  "tag": "div",
  "class": "xpshop-wallpaper-section",
  "limit": 1,
  "settings": [
    { "type": "paragraph", "content": "One photograph behind every window. It covers the screen at every width and stays in place while the page scrolls." },
    { "type": "image_picker", "id": "wallpaper", "label": "Wallpaper", "info": "A wide landscape photograph, at least 2000px wide." },
    { "type": "text", "id": "focal", "label": "Wallpaper focus", "default": "50% 70%", "info": "Which part stays in view on a narrow screen, as left and top percentages." },
    { "type": "range", "id": "wall_shade", "label": "Darken the bottom of the wallpaper", "min": 0, "max": 60, "step": 5, "unit": "%", "default": 0 },
    { "type": "color", "id": "page_color", "label": "Colour behind the wallpaper", "default": "#6fa3e3", "info": "Shows while the photograph loads." }
  ],
  "presets": [
    { "name": "XP wallpaper" }
  ]
}
{% endschema %}
