<div
  class="hr color-{{ scheme }}{% if fit %} hr--fit{% endif %}{% if st.caption_layout == 'split' %} hr--split{% endif %}{% unless st.show_tags %} hr--no-tags{% endunless %}{% unless st.rail_brackets %} hr--no-brackets{% endunless %}{% if picture and st.text_glass %} hr--glass{% endif %}{% if picture and st.image_blur > 0 %} hr--blur{% endif %}"
  style="--hr-gh-d: {{ gh }}px; --hr-gh-m: {{ gh_m }}px; --hr-ratio: {{ ratio | divided_by: 100.0 }}; --hr-gap: {{ st.gap | default: 0 }}px; --hr-n: {{ count | at_least: 1 }}; --hr-rail-y: {{ st.rail_top | default: 0 }}px; --hr-rail-t: {{ st.rail_thickness | default: 6 }}px; --hr-rod: {% case st.rail_finish %}{% when 'black' %}linear-gradient(180deg, #5a5a5a 0%, #1d1d1d 45%, #0c0c0c 60%, #3a3a3a 100%){% when 'brass' %}linear-gradient(180deg, #f3dfa6 0%, #c9a24e 45%, #8f6c25 60%, #d9b867 100%){% else %}linear-gradient(180deg, #f4f4f4 0%, #c6c6c6 40%, #8b8b8b 58%, #d5d5d5 100%){% endcase %}; --hr-bg-solid: {% render 'scheme-color', color: st.background_colour, fallback: 'var(--color-background)' %}; --hr-bg: {% if picture %}var(--hr-bg-solid){% else %}var(--hr-bg-solid){% endif %}; --hr-fg: {% render 'scheme-color', color: st.text_colour, fallback: 'var(--color-text)' %}; --hr-heading: {% render 'scheme-color', color: st.text_colour, fallback: 'var(--color-heading)' %}; --hr-tag-bg: {% render 'scheme-color', color: st.tag_colour, fallback: '#fbfaf6' %}; --hr-tag-fg: {% render 'scheme-color', color: st.tag_text_colour, fallback: '#111111' %}; --hr-shade: {% render 'scheme-color', color: st.overlay_colour, fallback: 'var(--hr-bg-solid)' %}; --hr-shade-o: {{ st.overlay_opacity | default: 0 | divided_by: 100.0 }}; --hr-blur: {{ st.image_blur | default: 0 }}px; --hr-glass-o: {{ st.glass_opacity | default: 60 }}%; --hr-focus-x: {{ st.image_focus_x | default: 50 }}%; --hr-focus-y: {{ st.image_focus_y | default: 50 }}%; --hr-pt: {{ st.padding_top }}px; --hr-pb: {{ st.padding_bottom }}px; --hr-pt-m: {{ st.padding_top_mobile }}px; --hr-pb-m: {{ st.padding_bottom_mobile }}px; --hr-h: {{ st.heading_size | default: 56 }}px; --hr-h-m: {{ st.heading_size_mobile | default: 34 }}px; --hr-head-gap: {{ st.head_gap | default: 24 }}px; --hr-rest: {{ st.rest_turn | default: 24 }}deg;"
  data-hr-section="{{ sid }}"
>
  {%- if picture and st.background_image != blank -%}
    <div class="hr__bg" aria-hidden="true">
      {%- if section.index > 2 -%}{{ st.background_image | image_url: width: 1920 | image_tag: widths: '750, 1100, 1500, 1920, 2560', sizes: '100vw', alt: '', loading: 'lazy' }}{%- else -%}{{ st.background_image | image_url: width: 1920 | image_tag: widths: '750, 1100, 1500, 1920, 2560', sizes: '100vw', alt: '', loading: 'eager', fetchpriority: 'high' }}{%- endif -%}
    </div>
  {%- endif -%}

  {%- if st.eyebrow != blank or st.eyebrow_2 != blank or st.heading != blank -%}
    <div class="hr__head">
      <div class="hr__pane">
        <p class="hr__eyebrow">{%- if st.eyebrow != blank -%}<span>{{ st.eyebrow | escape }}</span>{%- endif -%}{%- if st.eyebrow_2 != blank -%}<span>{{ st.eyebrow_2 | escape }}</span>{%- endif -%}</p>
        {%- if st.heading != blank -%}<h2 class="hr__heading">{{ st.heading | escape }}</h2>{%- endif -%}
      </div>
    </div>
  {%- endif -%}

  {%- if count > 0 -%}
