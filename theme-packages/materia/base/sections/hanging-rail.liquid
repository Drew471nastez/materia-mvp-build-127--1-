                      { "title": {{ q.title | json }}, "url": {{ q.url | json }}, "price": {{ q.price | money | json }}, "image": {% if q.featured_image != blank %}{{ q.featured_image | image_url: width: 160 | json }}{% else %}""{% endif %}, "variant": {{ qv.id | json }}, "option": {% if q.has_only_default_variant %}""{% else %}{{ qv.title | json }}{% endif %}, "available": {% if qv.available %}true{% else %}false{% endif %} }{% unless forloop.last %},{% endunless %}
                    {%- endfor -%}
                  ]
                }
              </script>
            </li>
          {%- endfor -%}
        </ul>
      </div>
      <button type="button" class="hr__arrow hr__arrow--prev" aria-label="Scroll the rail left" data-hr-step="-1" disabled><svg viewBox="0 0 32 32" fill="none" aria-hidden="true"><path d="M27 16H6m7-8l-8 8 8 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
      <button type="button" class="hr__arrow hr__arrow--next" aria-label="Scroll the rail right" data-hr-step="1"><svg viewBox="0 0 32 32" fill="none" aria-hidden="true"><path d="M5 16h21m-7-8l8 8-8 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
    </hanging-rail>
  {%- elsif request.design_mode -%}
    <p class="hr__empty">Add a Garment block for each piece on the rail and choose its product.</p>
  {%- endif -%}

  <div class="hr__caption">
    <div class="hr__pane">
      <div class="hr__lines">
        <p class="hr__name" aria-live="polite"></p>
        {%- if st.text_below != blank -%}<div class="hr__text">{{ st.text_below }}</div>{%- endif -%}
      </div>
      {%- if st.button_label != blank -%}
        {%- if button_style == 'link' -%}
          <a class="hr__button hr__button--link" href="{{ shop_link }}">{{ st.button_label | escape }}<svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M1 7h11m-4-4l4 4-4 4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        {%- else -%}
          <a class="hr__button btn btn-{{ button_style }}" href="{{ shop_link }}" data-sl-button data-button-role="{{ button_style }}" data-theme-button="{{ button_style }}"><span>{{ st.button_label | escape }}</span></a>
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>
</div>
