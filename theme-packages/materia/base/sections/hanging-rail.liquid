                  {%- endif -%}
                  {%- if front != blank and side != blank -%}
                    <img class="hr__front" data-src="{{ front | image_url: width: front_2x }}" data-srcset="{{ front | image_url: width: front_1x }} {{ front_1x }}w, {{ front | image_url: width: front_2x }} {{ front_2x }}w" data-sizes="{{ front_1x }}px" alt="" decoding="async" draggable="false">
                  {%- endif -%}
                  {%- if tag != blank -%}<span class="hr__tag"><span>{{ tag | escape }}</span></span>{%- endif -%}
                </span>
              </a>
              <script type="application/json" data-hr-data>
                {
                  "title": {{ title | json }},
                  "url": {{ url | json }},
                  "price": {{ price | json }},
                  "compare": {% if has_product and p.compare_at_price > p.price %}{{ p.compare_at_price | money | json }}{% else %}""{% endif %},
                  "note": {{ bs.note | json }},
                  "front": {% if front != blank %}{{ front | image_url: width: 1300 | json }}{% else %}""{% endif %},
                  "frontSet": {{ front_set | json }},
                  "back": {% if bs.back_image != blank %}{{ bs.back_image | image_url: width: 1300 | json }}{% else %}""{% endif %},
                  "selected": {% if has_product %}{{ p.selected_or_first_available_variant.id | json }}{% else %}null{% endif %},
                  "options": [
                    {%- if has_product -%}{%- for option in p.options_with_values -%}
                      { "name": {{ option.name | json }}, "values": [{%- for value in option.values -%}{{ value | append: '' | json }}{% unless forloop.last %},{% endunless %}{%- endfor -%}] }{% unless forloop.last %},{% endunless %}
                    {%- endfor -%}{%- endif -%}
                  ],
                  "variants": [
                    {%- if has_product -%}{%- for variant in p.variants -%}
                      { "id": {{ variant.id | json }}, "options": [{%- for value in variant.options -%}{{ value | append: '' | json }}{% unless forloop.last %},{% endunless %}{%- endfor -%}], "price": {{ variant.price | money | json }}, "compare": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | json }}{% else %}""{% endif %}, "available": {% if variant.available %}true{% else %}false{% endif %} }{% unless forloop.last %},{% endunless %}
                    {%- endfor -%}{%- endif -%}
                  ],
                  "with": [
                    {%- for q in bs.wear_with limit: 3 -%}
