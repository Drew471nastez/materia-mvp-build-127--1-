      { transform: 'translate(0,0) scale(1)', opacity: 0.2 }
    ] : [
      { transform: 'translate(' + tx + 'px,' + ty + 'px) scale(' + sx + ',' + sy + ')', transformOrigin: '0 0' },
      { transform: 'translate(0,0) scale(1,1)', transformOrigin: '0 0' }
    ];
