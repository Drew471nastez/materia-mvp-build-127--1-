      data-turn="{{ st.turn_speed | default: 420 }}"
      data-rest="{{ st.rest_turn | default: 24 }}"
      data-swing="{{ st.swing | default: 50 }}"
      data-hover-gap="{{ st.hover_gap | default: 24 }}"
      data-click="{{ st.click_action | default: 'focus' }}"
      data-scheme="{{ scheme | escape }}"
      data-backdrop="{{ st.focus_backdrop | default: 'glass' }}"
      data-after-add="{{ st.after_add | default: 'stay' }}"
      data-strings='{"add": {{ add_label | json | escape }}, "soldOut": {{ sold_label | json | escape }}, "unavailable": "Unavailable", "added": "Added to cart", "viewCart": "View cart", "viewShop": "View in the shop", "close": "Close", "prev": "Previous garment", "next": "Next garment", "front": "Front", "back": "Back", "with": {{ st.with_heading | default: 'Wear it with' | json | escape }}, "addPair": "Add to cart", "error": "Could not add it. Try again.", "cartUrl": {{ routes.cart_url | json | escape }}, "addUrl": {{ routes.cart_add_url | json | escape }}}'
