{%- comment -%}
  Hanging rail (templates round 24). A boutique clothing rail: a metal rail
  across the section and the shop's garments on hangers hanging from it,
  each with a small price tag. Each garment is a block linked to a product,
  with two cut-out pictures of it on its hanger: a side view, shown on the
  rail, and a front view, shown when the visitor points at it. A back view
  can be added; it is only downloaded when someone asks to see it.

  On a computer the garment under the pointer turns to face the visitor
  while its neighbours move aside, and the hangers swing a little as the
  pointer brushes past or the rail moves. Its name shows under the rail.
  Clicking it lifts it into a focus view (a window on a computer, a sheet
  from the bottom on a phone): the garment large on the left, its title,
  price and options, the theme's own Add to cart (<product-form>, so the
  cart drawer and the count update as from a product page), a link to the
  product page and arrows to step along the rail. A row wider than the
  screen scrolls: dragged with the mouse, swiped, or with the arrows. On a
  phone the garment nearest the middle turns to the front as the row is
  swiped, and a tap opens the sheet. With reduced motion asked for, nothing
  swings or flies: views change in place.

  Geometry comes from settings alone (the height and width of a garment,
  the gap), never from a picture's size, so nothing moves while pictures
  load. Pictures are asked for at the size they are drawn (srcset); the
  front views wait until the page has loaded or the pointer arrives, and
  back views until the Back tab is pressed. One script, inline, the same
  text for every rail: it defines <hanging-rail> once, and each rail, also
  one the editor adds or redraws, starts itself when it is put on the page.
  Its animation loop runs only while something is still moving.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign count = section.blocks.size
  assign gh = st.garment_height | default: 300
  assign gh_m = st.garment_height_mobile | default: 210
  assign ratio = st.garment_width | default: 36
  assign slot = gh | times: ratio | divided_by: 100
  assign slot_m = gh_m | times: ratio | divided_by: 100
  assign side_1x = slot | at_least: 60
  assign side_2x = slot | times: 2
  assign front_1x = gh | times: 8 | divided_by: 10
  assign front_2x = front_1x | times: 2
  assign fit = false
  if st.overflow == 'fit'
    assign fit = true
  endif
  assign picture = false
  if st.background_style == 'picture'
    assign picture = true
  endif
  assign shop_link = st.button_link | default: routes.all_products_collection_url
  assign add_label = 'products.product.actions.add_to_cart.default.label' | t
  assign sold_label = 'products.product.actions.add_to_cart.sold_out.label' | t
-%}
<style>
  .hr { --hr-gh: var(--hr-gh-m); --hr-slot-base: calc(var(--hr-gh) * var(--hr-ratio)); --hr-slot: var(--hr-slot-base); --hr-edge: 16px; position: relative; overflow: hidden; background: var(--hr-bg); color: var(--hr-fg); padding: var(--hr-pt-m) 0 var(--hr-pb-m); }
  @media (min-width: 750px) { .hr { --hr-gh: var(--hr-gh-d); --hr-edge: 32px; padding: var(--hr-pt) 0 var(--hr-pb); } }
  .hr__bg { position: absolute; inset: 0; z-index: 0; }
  .hr__bg img { width: 100%; height: 100%; object-fit: cover; object-position: var(--hr-focus-x, 50%) var(--hr-focus-y, 50%); display: block; }
  .hr__bg::after { content: ""; position: absolute; inset: 0; background: var(--hr-shade); opacity: var(--hr-shade-o); }
  .hr > :not(.hr__bg) { position: relative; z-index: 1; }
  .hr__head { text-align: center; padding: 0 var(--hr-edge); margin: 0 auto var(--hr-head-gap, 0); max-width: 1100px; }
  .hr__eyebrow { margin: 0; display: inline-flex; align-items: center; gap: 12px; font-size: 11px; line-height: 1.4; letter-spacing: .18em; text-transform: uppercase; font-weight: 600; }
  .hr__eyebrow span + span { padding-left: 12px; border-left: 1px solid currentColor; opacity: .55; font-weight: 500; }
  .hr__eyebrow span + span:only-child { padding: 0; border: 0; }
  .hr__heading { margin: 14px 0 0; color: inherit; font-size: var(--hr-h-m); line-height: 1.05; letter-spacing: -.01em; }
  @media (min-width: 750px) { .hr__heading { font-size: var(--hr-h); } }
  .hr__eyebrow:empty, .hr__heading:empty { display: none; }

  /* The stage: the rail, the row that scrolls, its arrows. Every size is a setting, so nothing moves while pictures arrive. */
  hanging-rail.hr__stage { display: block; position: relative; container-type: inline-size; padding-top: var(--hr-rail-y); }
  .hr--fit hanging-rail.hr__stage { --hr-fit-slot: calc((100cqw - 2 * var(--hr-edge) - (var(--hr-n) - 1) * var(--hr-gap)) / var(--hr-n)); }
  @media (min-width: 750px) { .hr--fit hanging-rail.hr__stage { --hr-slot: min(var(--hr-slot-base), var(--hr-fit-slot)); } }
  .hr__stage { --hr-ghx: calc(var(--hr-slot) / var(--hr-ratio)); }
  .hr__rod { position: absolute; left: 0; right: 0; top: calc(var(--hr-rail-y) + var(--hr-ghx) * .018); height: var(--hr-rail-t); border-radius: 99px; background: var(--hr-rod); box-shadow: 0 1px 2px rgba(0,0,0,.18); pointer-events: none; }
  .hr__rod::before, .hr__rod::after { content: ""; position: absolute; top: 50%; width: 18px; height: calc(var(--hr-rail-t) + 12px); transform: translateY(-50%); background: var(--hr-rod); border-radius: 2px; box-shadow: 0 1px 2px rgba(0,0,0,.2); }
  .hr__rod::before { left: 6px; } .hr__rod::after { right: 6px; }
  .hr--no-brackets .hr__rod::before, .hr--no-brackets .hr__rod::after { display: none; }
  .hr__scroller { position: relative; overflow-x: auto; overflow-y: hidden; scrollbar-width: none; overscroll-behavior-x: contain; -webkit-overflow-scrolling: touch; padding-bottom: calc(var(--hr-ghx) * .08); }
  .hr__scroller::-webkit-scrollbar { display: none; }
  .hr__scroller.is-dragging { cursor: grabbing; user-select: none; }
  .hr__track { list-style: none; margin: 0 auto; padding: 0 var(--hr-edge); display: flex; gap: var(--hr-gap); width: max-content; min-width: 0; }
  .hr__item { position: relative; flex: 0 0 var(--hr-slot); width: var(--hr-slot); height: calc(var(--hr-ghx) * 1.06); margin: 0; will-change: transform; }
  .hr__g { position: absolute; inset: 0; display: block; color: inherit; text-decoration: none; outline: none; -webkit-tap-highlight-color: transparent; cursor: pointer; }
  .hr__g:focus-visible .hr__swing { outline: 2px solid currentColor; outline-offset: 4px; border-radius: 4px; }
  .hr__swing { position: absolute; left: 0; right: 0; top: 0; height: calc(var(--hr-ghx) * var(--hr-k, 1)); transform-origin: 50% 2%; }
  .hr__side, .hr__front, .hr__blank { position: absolute; top: 0; left: 50%; height: 100%; max-width: none; transform: translateX(-50%); transform-origin: 50% 0; pointer-events: none; -webkit-user-drag: none; user-select: none; object-fit: contain; object-position: 50% 0; }
  .hr__side { width: var(--hr-slot); }
  .hr__front { width: calc(var(--hr-ghx) * var(--hr-k, 1)); }
  /* No side view: the front view hangs turned a little away, as clothes on a rail do, and turns to face the visitor. */
  .hr__front--rest { opacity: 1; transform: translateX(-50%) perspective(1100px) rotateY(var(--hr-rest)); }
  .hr__front { opacity: 0; transform: translateX(-50%) perspective(900px) rotateY(-74deg); }
  /* Each picture keeps its own layer while the pointer is over the rail, so turning one repaints nothing around it. */
  hanging-rail.is-live .hr__side, hanging-rail.is-live .hr__front { will-change: transform, opacity; }
  .hr__blank { width: calc(var(--hr-ghx) * .5); color: currentColor; opacity: .5; }
  .hr__tag { position: absolute; top: calc(var(--hr-ghx) * .02 + var(--hr-rail-t)); left: calc(50% + 4px); display: block; transform-origin: 2px 0; transform: rotate(-4deg); pointer-events: none; }
  .hr__tag::before { content: ""; position: absolute; left: 2px; top: -10px; height: 12px; border-left: 1px solid rgba(0,0,0,.45); }
  .hr__tag span { display: block; margin-top: 2px; padding: 3px 6px 3px 9px; background: #fbfaf6; color: #111; font-size: 10px; line-height: 1.2; font-weight: 700; letter-spacing: .01em; white-space: nowrap; border-radius: 2px; box-shadow: 0 1px 2px rgba(0,0,0,.22); position: relative; }
  .hr__tag span::before { content: ""; position: absolute; left: 3px; top: 50%; width: 3px; height: 3px; margin-top: -1.5px; border-radius: 50%; background: rgba(0,0,0,.35); }
  .hr--no-tags .hr__tag { display: none; }
  @media (max-width: 749px) { .hr__tag span { font-size: 9px; padding: 2px 5px 2px 8px; } }
  .hr__arrow { position: absolute; top: calc(var(--hr-rail-y) + var(--hr-ghx) * .45); z-index: 3; width: 48px; height: 48px; margin-top: -24px; border: 0; border-radius: 50%; background: transparent; color: var(--hr-fg); display: none; align-items: center; justify-content: center; cursor: pointer; opacity: 0; transition: opacity .25s, transform .25s; }
  .hr__arrow svg { width: 30px; height: 30px; filter: drop-shadow(0 1px 2px rgba(0,0,0,.18)); }
  .hr__arrow--prev { left: 8px; } .hr__arrow--next { right: 8px; }
  .hr__arrow[disabled] { opacity: 0 !important; pointer-events: none; }
  hanging-rail.is-scrollable .hr__arrow { display: inline-flex; }
  hanging-rail.is-scrollable:hover .hr__arrow, hanging-rail.is-scrollable:focus-within .hr__arrow { opacity: .85; }
  .hr__arrow:hover { opacity: 1 !important; transform: scale(1.06); }
  @media (hover: none) { .hr__arrow { display: none !important; } }

  /* Under the rail: the name of the garment in front, or the section's own line, and the button. */
  .hr__caption { display: flex; flex-direction: column; align-items: center; gap: 14px; padding: 18px var(--hr-edge) 0; text-align: center; }
  .hr__lines { position: relative; display: grid; min-height: 1.5em; width: 100%; max-width: 640px; }
  .hr__lines > * { grid-area: 1 / 1; margin: 0; transition: opacity .25s ease, transform .25s ease; }
  .hr__name { font-size: 14px; font-weight: 600; opacity: 0; transform: translateY(4px); }
  .hr__name small { font-weight: 400; opacity: .7; margin-left: 8px; font-size: inherit; }
  .hr__text { font-size: 14px; line-height: 1.5; }
  .hr__text > * { margin: 0; }
  .hr.is-showing .hr__name { opacity: 1; transform: none; }
  .hr.is-showing .hr__text { opacity: 0; transform: translateY(-4px); }
  .hr__button { display: inline-flex; align-items: center; gap: 10px; padding: 9px 20px; border: 1px solid currentColor; border-radius: 99px; color: inherit; font-size: 13px; font-weight: 500; text-decoration: none; transition: background-color .2s, color .2s; }
  .hr__button:hover { background: var(--hr-fg); color: var(--hr-bg-solid); }
  .hr--split .hr__caption { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: 12px 32px; text-align: left; }
  .hr--split .hr__lines { display: contents; }
  .hr--split .hr__name { grid-column: 1; grid-row: 1 / span 2; align-self: end; }
  .hr--split .hr__name small { display: block; margin: 4px 0 0; }
  .hr--split .hr__name:not(:empty) { opacity: 1; transform: none; }
  .hr--split .hr__text { grid-column: 2; grid-row: 1; text-align: right; justify-self: end; max-width: 34ch; }
  .hr--split.is-showing .hr__text { opacity: 1; transform: none; }
  .hr--split .hr__button { grid-column: 2; grid-row: 2; justify-self: end; border: 0; padding: 4px 0; border-bottom: 1px solid currentColor; border-radius: 0; }
  .hr--split .hr__button:hover { background: none; color: inherit; opacity: .75; }
  @media (max-width: 749px) {
    .hr--split .hr__caption { grid-template-columns: minmax(0, 1fr); }
    .hr--split .hr__name { grid-row: 1; }
    .hr--split .hr__text { grid-column: 1; grid-row: 2; text-align: left; justify-self: start; }
    .hr--split .hr__button { grid-column: 1; grid-row: 3; justify-self: start; }
  }
  .hr__empty { margin: 0 auto; padding: 40px var(--hr-edge); text-align: center; font-size: 14px; opacity: .7; }

  /* The focus view: one per page, in <body>, a window on a computer and a sheet on a phone. */
  .hr-focus { position: fixed; inset: 0; z-index: 90; color: var(--hrf-fg, #111); }
  .hr-focus[hidden] { display: none; }
  .hr-focus__backdrop { position: absolute; inset: 0; background: var(--hrf-bg, #fff); opacity: 0; transition: opacity .35s ease; }
  .hr-focus.is-open .hr-focus__backdrop { opacity: .94; }
  .hr-focus__panel { position: absolute; inset: 0; display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(300px, 400px); align-items: center; gap: clamp(24px, 5vw, 80px); padding: 64px clamp(56px, 8vw, 140px) 48px; outline: none; }
  .hr-focus__media { position: relative; height: min(76vh, 760px); display: flex; align-items: center; justify-content: center; }
  .hr-focus__img { max-height: 100%; max-width: 100%; width: auto; height: 100%; object-fit: contain; transition: opacity .3s ease; }
  .hr-focus__img.is-hidden { opacity: 0; }
  .hr-focus__info { opacity: 0; transform: translateY(8px); transition: opacity .35s ease .08s, transform .35s ease .08s; max-height: 100%; overflow: auto; padding: 4px; }
  .hr-focus.is-open .hr-focus__info { opacity: 1; transform: none; }
  .hr-focus__count { margin: 0 0 10px; font-size: 11px; letter-spacing: .12em; opacity: .55; font-variant-numeric: tabular-nums; }
  .hr-focus__title { margin: 0; font-size: clamp(22px, 2.2vw, 30px); line-height: 1.15; color: inherit; }
  .hr-focus__price { margin: 8px 0 0; display: flex; gap: 10px; align-items: baseline; font-size: 16px; font-weight: 600; }
  .hr-focus__price s { font-weight: 400; opacity: .55; font-size: 14px; }
  .hr-focus__note { margin: 10px 0 0; font-size: 14px; line-height: 1.5; opacity: .75; }
  .hr-focus__views { display: flex; gap: 18px; margin: 18px 0 0; }
  .hr-focus__views button { border: 0; background: none; padding: 4px 0; color: inherit; font: inherit; font-size: 13px; opacity: .5; border-bottom: 1px solid transparent; cursor: pointer; }
  .hr-focus__views button[aria-selected="true"] { opacity: 1; border-bottom-color: currentColor; }
  .hr-focus__option { border: 0; padding: 0; margin: 20px 0 0; min-width: 0; }
  .hr-focus__option legend { padding: 0; margin: 0 0 10px; font-size: 11px; letter-spacing: .12em; text-transform: uppercase; opacity: .6; }
  .hr-focus__values { display: flex; flex-wrap: wrap; gap: 8px; }
  .hr-focus__value { min-width: 42px; height: 42px; padding: 0 12px; border: 1px solid rgba(0,0,0,.18); border-color: color-mix(in srgb, currentColor 22%, transparent); border-radius: 99px; background: none; color: inherit; font: inherit; font-size: 13px; cursor: pointer; transition: background-color .2s, color .2s, border-color .2s; }
  .hr-focus__value:hover { border-color: currentColor; }
  .hr-focus__value[aria-pressed="true"] { background: var(--hrf-fg, #111); border-color: var(--hrf-fg, #111); color: var(--hrf-bg, #fff); }
  .hr-focus__value.is-out { text-decoration: line-through; opacity: .45; }
  .hr-focus__form { display: block; margin-top: 22px; }
  .hr-focus__add { width: 100%; min-height: 50px; }
  .hr-focus__add.is-added { pointer-events: none; }
  .hr-focus__cart[hidden] { display: none; }
  .hr-focus__cart { display: inline-block; margin-top: 12px; font-size: 13px; font-weight: 600; color: inherit; text-underline-offset: 4px; }
  .hr-focus__foot { display: flex; justify-content: space-between; gap: 16px; margin-top: 26px; padding-top: 16px; border-top: 1px solid color-mix(in srgb, currentColor 14%, transparent); font-size: 13px; }
  .hr-focus__foot a { color: inherit; font-weight: 600; text-decoration: none; }
  .hr-focus__foot a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .hr-focus__close { position: absolute; top: 18px; right: 22px; z-index: 2; display: inline-flex; align-items: center; gap: 8px; border: 0; background: none; color: inherit; font: inherit; font-size: 13px; cursor: pointer; padding: 8px; }
  .hr-focus__nav { position: absolute; top: 50%; z-index: 2; width: 56px; height: 56px; margin-top: -28px; border: 0; background: none; color: inherit; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; opacity: .7; transition: opacity .2s, transform .2s; }
  .hr-focus__nav:hover { opacity: 1; }
  .hr-focus__nav--prev { left: 12px; } .hr-focus__nav--next { right: 12px; }
  .hr-focus__nav--prev:hover { transform: translateX(-3px); } .hr-focus__nav--next:hover { transform: translateX(3px); }
  .hr-focus__nav svg { width: 32px; height: 32px; }
  .hr-focus__nav[hidden] { display: none; }
  .hr-focus__fly { position: fixed; z-index: 95; pointer-events: none; margin: 0; object-fit: contain; }
  .hr-focus__error[hidden] { display: none; }
  .hr-focus__error { margin-top: 10px; font-size: 13px; color: #b42318; }
  html.hr-locked { overflow: hidden; }
  html.hr-locked body { padding-right: var(--hr-bar, 0); }
  @media (max-width: 749px) {
    .hr-focus__backdrop { background: rgba(0,0,0,1); }
    .hr-focus.is-open .hr-focus__backdrop { opacity: .4; }
    .hr-focus__panel { inset: auto 0 0 0; max-height: 92dvh; display: flex; flex-direction: column; align-items: stretch; gap: 0; padding: 0 0 calc(16px + env(safe-area-inset-bottom)); background: var(--hrf-bg, #fff); border-radius: 16px 16px 0 0; transform: translateY(100%); transition: transform .38s cubic-bezier(.2,.8,.2,1); overflow: auto; overscroll-behavior: contain; }
    .hr-focus.is-open .hr-focus__panel { transform: none; }
    .hr-focus__media { height: 44dvh; min-height: 260px; padding: 28px 52px 8px; flex: none; }
    .hr-focus__info { padding: 8px 20px 0; max-height: none; overflow: visible; }
    .hr-focus__close { top: 8px; right: 8px; }
    .hr-focus__close span { display: none; }
    .hr-focus__nav { top: calc(22dvh + 14px); width: 44px; height: 44px; margin-top: -22px; }
    .hr-focus__nav--prev { left: 4px; } .hr-focus__nav--next { right: 4px; }
    .hr-focus__nav svg { width: 24px; height: 24px; }
    .hr-focus__form { position: sticky; bottom: 0; background: var(--hrf-bg, #fff); padding-bottom: 4px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hr-focus__backdrop, .hr-focus__info, .hr-focus__panel, .hr__lines > *, .hr__arrow { transition: none !important; }
  }
</style>
<div
  class="hr{% if fit %} hr--fit{% endif %}{% if st.caption_layout == 'split' %} hr--split{% endif %}{% unless st.show_tags %} hr--no-tags{% endunless %}{% unless st.rail_brackets %} hr--no-brackets{% endunless %}"
  style="--hr-gh-d: {{ gh }}px; --hr-gh-m: {{ gh_m }}px; --hr-ratio: {{ ratio | divided_by: 100.0 }}; --hr-gap: {{ st.gap | default: 0 }}px; --hr-n: {{ count | at_least: 1 }}; --hr-rail-y: {{ st.rail_top | default: 0 }}px; --hr-rail-t: {{ st.rail_thickness | default: 6 }}px; --hr-rod: {% case st.rail_finish %}{% when 'black' %}linear-gradient(180deg, #5a5a5a 0%, #1d1d1d 45%, #0c0c0c 60%, #3a3a3a 100%){% when 'brass' %}linear-gradient(180deg, #f3dfa6 0%, #c9a24e 45%, #8f6c25 60%, #d9b867 100%){% else %}linear-gradient(180deg, #f4f4f4 0%, #c6c6c6 40%, #8b8b8b 58%, #d5d5d5 100%){% endcase %}; --hr-bg: {% if picture %}#1b1b1b{% else %}{{ st.background_colour | default: '#f7f7f5' }}{% endif %}; --hr-bg-solid: {{ st.background_colour | default: '#f7f7f5' }}; --hr-fg: {{ st.text_colour | default: '#111111' }}; --hr-shade: {{ st.overlay_colour | default: '#000000' }}; --hr-shade-o: {{ st.overlay_opacity | default: 0 | divided_by: 100.0 }}; --hr-focus-x: {{ st.image_focus_x | default: 50 }}%; --hr-focus-y: {{ st.image_focus_y | default: 50 }}%; --hr-pt: {{ st.padding_top }}px; --hr-pb: {{ st.padding_bottom }}px; --hr-pt-m: {{ st.padding_top_mobile }}px; --hr-pb-m: {{ st.padding_bottom_mobile }}px; --hr-h: {{ st.heading_size | default: 56 }}px; --hr-h-m: {{ st.heading_size_mobile | default: 34 }}px; --hr-head-gap: {{ st.head_gap | default: 24 }}px; --hr-rest: {{ st.rest_turn | default: 24 }}deg;"
  data-hr-section="{{ sid }}"
>
  {%- if picture and st.background_image != blank -%}
    <div class="hr__bg" aria-hidden="true">
      {%- if section.index > 2 -%}{{ st.background_image | image_url: width: 1920 | image_tag: widths: '750, 1100, 1500, 1920, 2560', sizes: '100vw', alt: '', loading: 'lazy' }}{%- else -%}{{ st.background_image | image_url: width: 1920 | image_tag: widths: '750, 1100, 1500, 1920, 2560', sizes: '100vw', alt: '', loading: 'eager', fetchpriority: 'high' }}{%- endif -%}
    </div>
  {%- endif -%}

  {%- if st.eyebrow != blank or st.eyebrow_2 != blank or st.heading != blank -%}
    <div class="hr__head">
      <p class="hr__eyebrow">{%- if st.eyebrow != blank -%}<span>{{ st.eyebrow | escape }}</span>{%- endif -%}{%- if st.eyebrow_2 != blank -%}<span>{{ st.eyebrow_2 | escape }}</span>{%- endif -%}</p>
      {%- if st.heading != blank -%}<h2 class="hr__heading h1">{{ st.heading | escape }}</h2>{%- endif -%}
    </div>
  {%- endif -%}

  {%- if count > 0 -%}
    <hanging-rail
      class="hr__stage"
      data-turn="{{ st.turn_speed | default: 420 }}"
      data-rest="{{ st.rest_turn | default: 24 }}"
      data-swing="{{ st.swing | default: 50 }}"
      data-hover-gap="{{ st.hover_gap | default: 24 }}"
      data-click="{{ st.click_action | default: 'focus' }}"
      data-strings='{"add": {{ add_label | json | escape }}, "soldOut": {{ sold_label | json | escape }}, "unavailable": "Unavailable", "added": "Added to cart", "viewCart": "View cart", "viewShop": "View in the shop", "close": "Close", "prev": "Previous garment", "next": "Next garment", "front": "Front", "back": "Back", "cartUrl": {{ routes.cart_url | json | escape }}, "addUrl": {{ routes.cart_add_url | json | escape }}}'
    >
      <div class="hr__rod" aria-hidden="true"></div>
      <div class="hr__scroller" tabindex="-1">
        <ul class="hr__track" role="list">
          {%- for block in section.blocks -%}
            {%- liquid
              assign bs = block.settings
              assign p = bs.product
              assign has_product = false
              if p != blank and p.id != blank
                assign has_product = true
              endif
              assign side = bs.side_image
              assign front = bs.front_image | default: p.featured_image
              assign k = bs.size | default: 100
              assign title = p.title | default: bs.name | default: 'Garment'
              if bs.name != blank
                assign title = bs.name
              endif
              assign tag = bs.tag_text
              if tag == blank and has_product
                assign tag = p.price | money_without_trailing_zeros
              endif
              assign price = ''
              if has_product
                assign price = p.price | money
              endif
              assign url = p.url | default: shop_link
              assign front_set = ''
              if front != blank
                assign f640 = front | image_url: width: 640
                assign f960 = front | image_url: width: 960
                assign f1300 = front | image_url: width: 1300
                assign front_set = f640 | append: ' 640w, ' | append: f960 | append: ' 960w, ' | append: f1300 | append: ' 1300w'
              endif
            -%}
            <li class="hr__item" style="--hr-k: {{ k | divided_by: 100.0 }};" {{ block.shopify_attributes }}>
              <a class="hr__g" href="{{ url }}" aria-label="{{ title | escape }}{% if price != blank %}, {{ price | escape }}{% endif %}" {% if st.click_action != 'page' %}aria-haspopup="dialog" {% endif %}draggable="false">
                <span class="hr__swing">
                  {%- if side != blank -%}
                    <img class="hr__side" src="{{ side | image_url: width: side_2x }}" srcset="{{ side | image_url: width: side_1x }} {{ side_1x }}w, {{ side | image_url: width: side_2x }} {{ side_2x }}w" sizes="(max-width: 749px) {{ slot_m | at_least: 40 }}px, {{ side_1x }}px" alt="" width="{{ slot }}" height="{{ gh }}" decoding="async"{% if forloop.index > 12 %} loading="lazy"{% endif %} draggable="false">
                  {%- elsif front != blank -%}
                    <img class="hr__front hr__front--rest" src="{{ front | image_url: width: front_2x }}" srcset="{{ front | image_url: width: front_1x }} {{ front_1x }}w, {{ front | image_url: width: front_2x }} {{ front_2x }}w" sizes="(max-width: 749px) {{ gh_m | times: 8 | divided_by: 10 }}px, {{ front_1x }}px" alt="" width="{{ gh }}" height="{{ gh }}" decoding="async"{% if forloop.index > 12 %} loading="lazy"{% endif %} draggable="false">
                  {%- else -%}
                    <svg class="hr__blank" viewBox="0 0 100 60" fill="none" aria-hidden="true"><path d="M50 2c5 0 8 3 8 7s-3 6-8 8v4M50 21L4 52c-3 2-2 6 2 6h88c4 0 5-4 2-6L50 21" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {%- endif -%}
                  {%- if front != blank and side != blank -%}
                    <img class="hr__front" data-src="{{ front | image_url: width: front_2x }}" data-srcset="{{ front | image_url: width: front_1x }} {{ front_1x }}w, {{ front | image_url: width: front_2x }} {{ front_2x }}w" data-sizes="{{ front_1x }}px" alt="" decoding="async" draggable="false">
                  {%- endif -%}
                  {%- if tag != blank -%}<span class="hr__tag"><span>{{ tag | escape }}</span></span>{%- endif -%}
                </span>
              </a>
              <script type="application/json" data-hr-data>
                {
                  "title": {{ title | json }},
                  "url": {{ url | json }},
                  "price": {{ price | json }},
                  "compare": {% if has_product and p.compare_at_price > p.price %}{{ p.compare_at_price | money | json }}{% else %}""{% endif %},
                  "note": {{ bs.note | json }},
                  "front": {% if front != blank %}{{ front | image_url: width: 1300 | json }}{% else %}""{% endif %},
                  "frontSet": {{ front_set | json }},
                  "back": {% if bs.back_image != blank %}{{ bs.back_image | image_url: width: 1300 | json }}{% else %}""{% endif %},
                  "selected": {% if has_product %}{{ p.selected_or_first_available_variant.id | json }}{% else %}null{% endif %},
                  "options": [
                    {%- if has_product -%}{%- for option in p.options_with_values -%}
                      { "name": {{ option.name | json }}, "values": [{%- for value in option.values -%}{{ value | append: '' | json }}{% unless forloop.last %},{% endunless %}{%- endfor -%}] }{% unless forloop.last %},{% endunless %}
                    {%- endfor -%}{%- endif -%}
                  ],
                  "variants": [
                    {%- if has_product -%}{%- for variant in p.variants -%}
                      { "id": {{ variant.id | json }}, "options": [{%- for value in variant.options -%}{{ value | append: '' | json }}{% unless forloop.last %},{% endunless %}{%- endfor -%}], "price": {{ variant.price | money | json }}, "compare": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | json }}{% else %}""{% endif %}, "available": {% if variant.available %}true{% else %}false{% endif %} }{% unless forloop.last %},{% endunless %}
                    {%- endfor -%}{%- endif -%}
                  ]
                }
              </script>
            </li>
          {%- endfor -%}
        </ul>
      </div>
      <button type="button" class="hr__arrow hr__arrow--prev" aria-label="Scroll the rail left" data-hr-step="-1" disabled><svg viewBox="0 0 32 32" fill="none" aria-hidden="true"><path d="M27 16H6m7-8l-8 8 8 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
      <button type="button" class="hr__arrow hr__arrow--next" aria-label="Scroll the rail right" data-hr-step="1"><svg viewBox="0 0 32 32" fill="none" aria-hidden="true"><path d="M5 16h21m-7-8l8 8-8 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
    </hanging-rail>
  {%- elsif request.design_mode -%}
    <p class="hr__empty">Add a Garment block for each piece on the rail and choose its product.</p>
  {%- endif -%}

  <div class="hr__caption">
    <div class="hr__lines">
      <p class="hr__name" aria-live="polite"></p>
      {%- if st.text_below != blank -%}<div class="hr__text">{{ st.text_below }}</div>{%- endif -%}
    </div>
    {%- if st.button_label != blank -%}
      <a class="hr__button" href="{{ shop_link }}">{{ st.button_label | escape }}{% if st.caption_layout == 'split' %}<svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M1 7h11m-4-4l4 4-4 4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>{% endif %}</a>
    {%- endif -%}
  </div>
</div>
<script>
(function () {
  if (!window.customElements || customElements.get('hanging-rail')) return;
  var RM = window.matchMedia ? matchMedia('(prefers-reduced-motion: reduce)') : { matches: false };
