{%- comment -%}
  Ebook: formats and prices. A centred heading over cards side by side,
  one per edition (the ebook alone, with a workbook, the complete bundle):
  a name, a price with an optional earlier price, a line, what it includes
  and a button to its product page. One card can be marked as the one most
  people choose. A short line under the cards on payment and delivery.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign color_scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
-%}
{%- assign ebook_hf = settings.font_heading_google_family -%}
{%- if ebook_hf != blank and ebook_hf != 'none' -%}<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ ebook_hf | replace: ' ', '+' }}:ital@1&display=swap">{%- endif -%}
<style>
  #shopify-section-{{ sid }} .ebe {
    --ebe-accent: {{ st.accent_color | default: '#9a6a32' }};
    --ebe-card: {{ st.card_color | default: '#ffffff' }};
    --ebe-feature: {{ st.feature_color | default: '#1f3b33' }};
    --ebe-feature-text: {{ st.feature_text_color | default: '#f7f4ee' }};
    background: {{ st.background | default: '#f7f4ee' }};
    padding: {{ st.padding_top_mobile | default: 56 }}px 20px {{ st.padding_bottom_mobile | default: 56 }}px;
  }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .ebe { padding: {{ st.padding_top | default: 96 }}px 40px {{ st.padding_bottom | default: 96 }}px; } }
  #shopify-section-{{ sid }} .ebe__inner { max-width: 1120px; margin: 0 auto; }
  #shopify-section-{{ sid }} .ebe__head { text-align: center; max-width: 640px; margin: 0 auto 44px; }
  #shopify-section-{{ sid }} .ebe__eyebrow { margin: 0 0 14px; color: var(--ebe-accent); font-size: 13px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; }
  #shopify-section-{{ sid }} .ebe__heading { margin: 0; color: var(--color-heading); font-family: var(--heading-font, inherit); font-weight: var(--heading-weight, 500); font-size: {{ st.heading_size_mobile | default: 36 }}px; line-height: 1.08; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .ebe__heading { font-size: {{ st.heading_size | default: 52 }}px; } }
  #shopify-section-{{ sid }} .ebe__heading em { font-style: italic; color: var(--ebe-accent); }
  #shopify-section-{{ sid }} .ebe__intro { margin: 14px auto 0; color: var(--color-text); font-size: 16.5px; line-height: 1.65; }
  #shopify-section-{{ sid }} .ebe__intro p { margin: 0; }
  #shopify-section-{{ sid }} .ebe__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 18px; align-items: stretch; }
  @media (min-width: 900px) { #shopify-section-{{ sid }} .ebe__grid { grid-template-columns: repeat({{ section.blocks.size | at_least: 1 | at_most: 3 }}, minmax(0, 1fr)); gap: 24px; } }
  #shopify-section-{{ sid }} .ebe__card {
    position: relative; display: flex; flex-direction: column; padding: 30px 26px 26px;
    background: var(--ebe-card); color: var(--color-text); border: 1px solid var(--color-border, #e2ddd2); border-radius: 10px;
  }
  #shopify-section-{{ sid }} .ebe__card--feature { background: var(--ebe-feature); color: color-mix(in srgb, var(--ebe-feature-text) 78%, transparent); border-color: var(--ebe-feature); }
  #shopify-section-{{ sid }} .ebe__badge { position: absolute; top: -12px; left: 26px; padding: 5px 12px; border-radius: 999px; background: var(--ebe-accent); color: #fff; font-size: 12px; font-weight: 600; letter-spacing: 0.04em; }
  #shopify-section-{{ sid }} .ebe__pic { display: block; width: 100%; max-width: 220px; height: auto; margin: 0 auto 18px; }
  #shopify-section-{{ sid }} .ebe__name { margin: 0 0 6px; color: var(--color-heading); font-family: var(--heading-font, inherit); font-weight: var(--heading-weight, 500); font-size: 27px; line-height: 1.15; }
  #shopify-section-{{ sid }} .ebe__card--feature .ebe__name { color: var(--ebe-feature-text); }
  #shopify-section-{{ sid }} .ebe__line { margin: 0 0 18px; font-size: 15px; line-height: 1.55; }
  #shopify-section-{{ sid }} .ebe__price { display: flex; align-items: baseline; gap: 10px; margin: 0 0 18px; }
  #shopify-section-{{ sid }} .ebe__now { color: var(--color-heading); font-family: var(--heading-font, inherit); font-size: 40px; line-height: 1; font-variant-numeric: lining-nums; }
  #shopify-section-{{ sid }} .ebe__card--feature .ebe__now { color: var(--ebe-feature-text); }
  #shopify-section-{{ sid }} .ebe__was { font-size: 16px; text-decoration: line-through; opacity: 0.7; }
  #shopify-section-{{ sid }} .ebe__list { list-style: none; margin: 0 0 24px; padding: 18px 0 0; border-top: 1px solid color-mix(in srgb, currentColor 18%, transparent); display: grid; gap: 10px; }
  #shopify-section-{{ sid }} .ebe__list li { position: relative; padding-left: 26px; font-size: 15px; line-height: 1.5; }
  #shopify-section-{{ sid }} .ebe__list li::before { content: ""; position: absolute; left: 2px; top: 6px; width: 11px; height: 6px; border-left: 1.5px solid var(--ebe-accent); border-bottom: 1.5px solid var(--ebe-accent); transform: rotate(-45deg); }
  #shopify-section-{{ sid }} .ebe__card--feature .ebe__list li::before { border-color: {{ st.feature_check_color | default: '#d9b27a' }}; }
  #shopify-section-{{ sid }} .ebe__btn {
    margin-top: auto; display: inline-flex; align-items: center; justify-content: center; min-height: 50px; padding: 0 20px; border-radius: 6px;
    border: 1px solid var(--color-heading); color: var(--color-heading); font-size: 15px; font-weight: 600; text-decoration: none;
    transition: background-color 0.25s ease, color 0.25s ease;
  }
  #shopify-section-{{ sid }} .ebe__btn:hover { background: var(--color-heading); color: var(--ebe-card); }
  #shopify-section-{{ sid }} .ebe__card--feature .ebe__btn { background: var(--ebe-feature-text); color: var(--ebe-feature); border-color: var(--ebe-feature-text); }
  #shopify-section-{{ sid }} .ebe__card--feature .ebe__btn:hover { background: transparent; color: var(--ebe-feature-text); }
  #shopify-section-{{ sid }} .ebe__foot { margin: 28px 0 0; text-align: center; color: var(--color-text); font-size: 14px; }
</style>

<div class="ebe color-{{ color_scheme }}" data-section-id="{{ sid }}">
  <div class="ebe__inner">
    {%- if st.eyebrow != blank or st.heading != blank -%}
      <div class="ebe__head">
        {%- if st.eyebrow != blank -%}<p class="ebe__eyebrow">{{ st.eyebrow | escape }}</p>{%- endif -%}
        {%- if st.heading != blank -%}<h2 class="ebe__heading">{{ st.heading }}</h2>{%- endif -%}
        {%- if st.intro != blank -%}<div class="ebe__intro">{{ st.intro }}</div>{%- endif -%}
      </div>
    {%- endif -%}
    <div class="ebe__grid">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        {%- assign items = b.includes | newline_to_br | split: '<br />' -%}
        <div class="ebe__card{% if b.featured %} ebe__card--feature{% endif %}" {{ block.shopify_attributes }}>
          {%- if b.badge != blank -%}<span class="ebe__badge">{{ b.badge | escape }}</span>{%- endif -%}
          {%- if b.image != blank -%}<img class="ebe__pic" src="{{ b.image | image_url: width: 500 }}" width="{{ b.image.width | default: 500 }}" height="{{ b.image.height | default: 400 }}" alt="{{ b.alt | default: b.image.alt | escape }}" loading="lazy" decoding="async">{%- endif -%}
          <h3 class="ebe__name">{{ b.title | escape }}</h3>
          {%- if b.text != blank -%}<p class="ebe__line">{{ b.text | escape }}</p>{%- endif -%}
          <p class="ebe__price"><span class="ebe__now">{{ b.price | escape }}</span>{%- if b.compare_price != blank -%}<span class="ebe__was">{{ b.compare_price | escape }}</span>{%- endif -%}</p>
          {%- if b.includes != blank -%}
            <ul class="ebe__list">{%- for i in items -%}{%- assign line = i | strip -%}{%- if line != blank -%}<li>{{ line | escape }}</li>{%- endif -%}{%- endfor -%}</ul>
          {%- endif -%}
          {%- if b.button_label != blank -%}<a class="ebe__btn" href="{{ b.link | default: '/collections/all' }}">{{ b.button_label | escape }}</a>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
    {%- if st.footnote != blank -%}<p class="ebe__foot">{{ st.footnote | escape }}</p>{%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Ebook editions and prices",
  "tag": "section",
  "class": "section sec__ebook-editions",
  "max_blocks": 3,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default-color-scheme" },
    { "type": "color", "id": "background", "label": "Background", "default": "#f7f4ee" },
    { "type": "color", "id": "card_color", "label": "Card colour", "default": "#ffffff" },
    { "type": "color", "id": "feature_color", "label": "Marked card colour", "default": "#1f3b33" },
    { "type": "color", "id": "feature_text_color", "label": "Marked card text", "default": "#f7f4ee" },
    { "type": "color", "id": "feature_check_color", "label": "Marked card ticks", "default": "#d9b27a" },
    { "type": "color", "id": "accent_color", "label": "Accent colour", "default": "#9a6a32" },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Formats and price" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Choose your <em>edition</em>" },
    { "type": "richtext", "id": "intro", "label": "Text under the heading" },
    { "type": "text", "id": "footnote", "label": "Line under the cards", "default": "Secure checkout. Files arrive by email the minute you pay." },
    { "type": "range", "id": "heading_size", "label": "Heading size, desktop", "min": 28, "max": 72, "step": 2, "unit": "px", "default": 52 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size, phone", "min": 24, "max": 48, "step": 2, "unit": "px", "default": 36 },
    { "type": "range", "id": "padding_top", "label": "Space above, desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Space below, desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_top_mobile", "label": "Space above, phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Space below, phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    {
      "type": "edition",
      "name": "Edition",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Picture (optional)" },
        { "type": "text", "id": "alt", "label": "Alt text" },
        { "type": "text", "id": "title", "label": "Name", "default": "The ebook" },
        { "type": "text", "id": "text", "label": "Line", "default": "Who this edition is for." },
        { "type": "text", "id": "price", "label": "Price", "default": "$24" },
        { "type": "text", "id": "compare_price", "label": "Earlier price" },
        { "type": "textarea", "id": "includes", "label": "What it includes, one per line", "default": "PDF and EPUB\nFree updates" },
        { "type": "text", "id": "button_label", "label": "Button", "default": "Buy this edition" },
        { "type": "url", "id": "link", "label": "Button link", "info": "The edition's product page." },
        { "type": "checkbox", "id": "featured", "label": "Mark this card", "default": false },
        { "type": "text", "id": "badge", "label": "Badge on the card", "info": "For example: Most chosen." }
      ]
    }
  ],
  "presets": [
    { "name": "Ebook editions and prices", "blocks": [ { "type": "edition" }, { "type": "edition" }, { "type": "edition" } ] }
  ]
}
{% endschema %}
