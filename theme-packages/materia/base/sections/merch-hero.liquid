{%- comment -%}
  Merch template: one wide studio picture with a short uppercase heading,
  a line and a square button, set over the plain part of the picture. The
  picture settles with a slow scale on load and the words rise in after it;
  nothing moves with reduced motion.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign overlay = st.overlay_opacity | default: 0 | divided_by: 100.0
  assign placeholder = 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 1600 900%22%3E%3Crect width=%221600%22 height=%22900%22 fill=%22%23ececec%22/%3E%3C/svg%3E'
-%}
<style>
  #shopify-section-{{ sid }} .mhero {
    position: relative; overflow: hidden; isolation: isolate;
    min-height: {{ st.height_mobile | default: 620 }}px;
    background: {{ st.background | default: '#ececec' }};
    color: {{ st.text_color | default: '#111111' }};
    display: flex;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .mhero { min-height: {{ st.height_desktop | default: 760 }}px; }
  }
  #shopify-section-{{ sid }} .mhero__media { position: absolute; inset: 0; z-index: -1; }
  #shopify-section-{{ sid }} .mhero__media picture,
  #shopify-section-{{ sid }} .mhero__media img {
    position: absolute; inset: 0; width: 100%; height: 100%; display: block; margin: 0; object-fit: cover;
  }
  #shopify-section-{{ sid }} .mhero__media img {
    transform: scale(1.05);
    animation: mhero-settle-{{ sid }} 2s cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
  }
  #shopify-section-{{ sid }} .mhero__media img[data-placeholder] { animation: none; transform: none; }
  #shopify-section-{{ sid }} .mhero__media::after {
    content: ""; position: absolute; inset: 0; background: {{ st.overlay_color | default: '#ffffff' }}; opacity: {{ overlay }};
  }
  @keyframes mhero-settle-{{ sid }} { to { transform: scale(1); } }
  #shopify-section-{{ sid }} .mhero__content {
    width: 100%;
    display: flex; flex-direction: column; align-items: center; text-align: center;
    gap: 14px;
    padding: 56px 20px;
  }
  #shopify-section-{{ sid }} .mhero__content[data-v="top"] { justify-content: flex-start; padding-top: {{ st.offset_mobile | default: 48 }}px; }
  #shopify-section-{{ sid }} .mhero__content[data-v="center"] { justify-content: center; }
  #shopify-section-{{ sid }} .mhero__content[data-v="bottom"] { justify-content: flex-end; padding-bottom: {{ st.offset_mobile | default: 48 }}px; }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .mhero__content[data-v="top"] { padding-top: {{ st.offset_desktop | default: 72 }}px; }
    #shopify-section-{{ sid }} .mhero__content[data-v="bottom"] { padding-bottom: {{ st.offset_desktop | default: 72 }}px; }
  }
  #shopify-section-{{ sid }} .mhero__eyebrow {
    margin: 0; font-family: var(--body-font, inherit); font-size: 12px; font-weight: 600;
    letter-spacing: 0.14em; text-transform: uppercase; color: inherit; opacity: 0.8;
  }
  #shopify-section-{{ sid }} .mhero__heading {
    margin: 0; color: inherit;
    font-family: var(--heading-font, inherit);
    font-weight: {{ st.heading_weight | default: 800 }};
    font-size: {{ st.heading_size_mobile | default: 40 }}px;
    line-height: 0.98; letter-spacing: -0.02em; text-transform: uppercase;
    max-width: 14ch;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .mhero__heading { font-size: {{ st.heading_size_desktop | default: 72 }}px; max-width: 18ch; }
  }
  #shopify-section-{{ sid }} .mhero__text { margin: 0; max-width: 40ch; font-size: 15px; line-height: 1.5; color: inherit; }
  #shopify-section-{{ sid }} .mhero__text p { margin: 0; }
  #shopify-section-{{ sid }} .mhero__button { margin-top: 8px; }
  #shopify-section-{{ sid }} .mhero__outline { background: transparent; color: inherit; border: 1px solid currentColor; }
  #shopify-section-{{ sid }} .mhero__outline:hover { background: {{ st.text_color | default: '#111111' }}; color: {{ st.background | default: '#ececec' }}; }
  #shopify-section-{{ sid }} .mhero__eyebrow,
  #shopify-section-{{ sid }} .mhero__heading,
  #shopify-section-{{ sid }} .mhero__text,
  #shopify-section-{{ sid }} .mhero__button {
    opacity: 0; transform: translateY(12px);
    animation: mhero-rise-{{ sid }} 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) 0.15s forwards;
  }
  #shopify-section-{{ sid }} .mhero__heading { animation-delay: 0.25s; }
  #shopify-section-{{ sid }} .mhero__text { animation-delay: 0.35s; }
  #shopify-section-{{ sid }} .mhero__button { animation-delay: 0.45s; }
  @keyframes mhero-rise-{{ sid }} { to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .mhero__media img,
    #shopify-section-{{ sid }} .mhero__eyebrow,
    #shopify-section-{{ sid }} .mhero__heading,
    #shopify-section-{{ sid }} .mhero__text,
    #shopify-section-{{ sid }} .mhero__button { animation: none; transform: none; opacity: 1; }
  }
</style>

<div class="mhero" data-section-id="{{ sid }}">
  <div class="mhero__media">
    {%- if st.image != blank -%}
      <picture>
        {%- if st.image_mobile != blank -%}
          <source media="(max-width: 767px)" srcset="{{ st.image_mobile | image_url: width: 800 }} 800w, {{ st.image_mobile | image_url: width: 1200 }} 1200w" sizes="100vw">
        {%- endif -%}
        <img
          src="{{ st.image | image_url: width: 1800 }}"
          srcset="{{ st.image | image_url: width: 900 }} 900w, {{ st.image | image_url: width: 1400 }} 1400w, {{ st.image | image_url: width: 2200 }} 2200w"
          sizes="100vw"
          width="{{ st.image.width | default: 2200 }}"
          height="{{ st.image.height | default: 1300 }}"
          alt="{{ st.image_alt | default: st.image.alt | escape }}"
          style="object-position: {{ st.focal_x | default: 50 }}% {{ st.focal_y | default: 50 }}%;"
          fetchpriority="high"
          decoding="async">
      </picture>
    {%- else -%}
      <img src="{{ placeholder }}" data-placeholder width="1600" height="900" alt="">
    {%- endif -%}
  </div>
  <div class="mhero__content" data-v="{{ st.content_position | default: 'bottom' }}">
    {%- if st.eyebrow != blank -%}<p class="mhero__eyebrow">{{ st.eyebrow | escape }}</p>{%- endif -%}
    {%- assign htag = st.heading_tag | default: 'h1' -%}
    {%- if st.heading != blank -%}<{{ htag }} class="mhero__heading">{{ st.heading | escape }}</{{ htag }}>{%- endif -%}
    {%- if st.text != blank -%}<div class="mhero__text">{{ st.text }}</div>{%- endif -%}
    {%- if st.button_label != blank -%}
      <div class="mhero__button"><a class="button inline-block {% if st.button_style == 'outline' %}mhero__outline{% else %}btn-primary{% endif %}" href="{{ st.button_link | default: '/collections/all' }}">{{ st.button_label | escape }}</a></div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Studio hero",
  "tag": "section",
  "class": "section sec__merch-hero",
  "settings": [
    { "type": "header", "content": "Picture" },
    { "type": "image_picker", "id": "image", "label": "Picture" },
    { "type": "image_picker", "id": "image_mobile", "label": "Picture on a phone", "info": "Optional. A taller crop for narrow screens." },
    { "type": "text", "id": "image_alt", "label": "Alt text" },
    { "type": "range", "id": "focal_x", "label": "Focal point, across", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
    { "type": "range", "id": "focal_y", "label": "Focal point, down", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
    { "type": "color", "id": "background", "label": "Colour behind the picture", "default": "#ececec" },
    { "type": "color", "id": "overlay_color", "label": "Wash colour", "default": "#ffffff" },
    { "type": "range", "id": "overlay_opacity", "label": "Wash strength", "min": 0, "max": 70, "step": 1, "unit": "%", "default": 0 },
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "eyebrow", "label": "Small line above" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made for every day" },
    { "type": "select", "id": "heading_tag", "label": "Heading level", "info": "Use the main heading once per page, on its first picture.", "options": [ { "value": "h1", "label": "Main heading" }, { "value": "h2", "label": "Section heading" } ], "default": "h1" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Say in one line what you make.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the edit" },
    { "type": "select", "id": "button_style", "label": "Button", "options": [ { "value": "primary", "label": "Filled" }, { "value": "outline", "label": "Outline in the text colour" } ], "default": "primary" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "select", "id": "content_position", "label": "Text position", "options": [ { "value": "top", "label": "Top" }, { "value": "center", "label": "Middle" }, { "value": "bottom", "label": "Bottom" } ], "default": "bottom" },
    { "type": "color", "id": "text_color", "label": "Text colour", "default": "#111111" },
    { "type": "header", "content": "Size" },
    { "type": "range", "id": "heading_size_desktop", "label": "Heading size, desktop", "min": 32, "max": 140, "step": 2, "unit": "px", "default": 72 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size, phone", "min": 24, "max": 72, "step": 2, "unit": "px", "default": 40 },
    { "type": "select", "id": "heading_weight", "label": "Heading weight", "options": [ { "value": "500", "label": "Medium" }, { "value": "700", "label": "Bold" }, { "value": "800", "label": "Extra bold" }, { "value": "900", "label": "Black" } ], "default": "800" },
    { "type": "range", "id": "height_desktop", "label": "Height, desktop", "min": 420, "max": 1000, "step": 20, "unit": "px", "default": 760 },
    { "type": "range", "id": "height_mobile", "label": "Height, phone", "min": 360, "max": 900, "step": 20, "unit": "px", "default": 620 },
    { "type": "range", "id": "offset_desktop", "label": "Space from the edge, desktop", "min": 16, "max": 200, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "offset_mobile", "label": "Space from the edge, phone", "min": 12, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "presets": [ { "name": "Studio hero" } ]
}
{% endschema %}
