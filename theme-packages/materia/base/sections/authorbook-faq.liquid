{%- comment -%}
  Author: questions before buying. The heading and a line with a contact
  link on the left (above on a phone), the questions on the right, each a
  native details element that opens to its answer with a plus that turns.
  The answer fades in; nothing moves with reduced motion.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign color_scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
-%}
<style>
  #shopify-section-{{ sid }} .abq2 { background: {{ st.background | default: '#ffffff' }}; padding: {{ st.padding_top_mobile | default: 56 }}px 20px {{ st.padding_bottom_mobile | default: 56 }}px; scroll-margin-top: 80px; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .abq2 { padding: {{ st.padding_top | default: 104 }}px 40px {{ st.padding_bottom | default: 104 }}px; } }
  #shopify-section-{{ sid }} .abq2__inner { max-width: 1140px; margin: 0 auto; display: grid; grid-template-columns: minmax(0, 1fr); gap: 28px; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .abq2__inner { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 88px; align-items: start; } }
  #shopify-section-{{ sid }} .abq2__eyebrow { margin: 0 0 12px; font-size: 13px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: {{ st.accent_color | default: '#c4471f' }}; }
  #shopify-section-{{ sid }} .abq2__heading { margin: 0; color: var(--color-heading); font-family: var(--heading-font, inherit); font-weight: var(--heading-weight, 400); font-size: {{ st.heading_size_mobile | default: 36 }}px; line-height: 1.08; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .abq2__heading { font-size: {{ st.heading_size | default: 48 }}px; } }
  #shopify-section-{{ sid }} .abq2__heading em { font-style: italic; color: {{ st.accent_color | default: '#c4471f' }}; }
  #shopify-section-{{ sid }} .abq2__text { margin-top: 14px; color: var(--color-text); font-size: 16px; line-height: 1.6; }
  #shopify-section-{{ sid }} .abq2__text p { margin: 0; }
  #shopify-section-{{ sid }} .abq2__text a { color: var(--color-heading); text-underline-offset: 3px; }
  #shopify-section-{{ sid }} .abq2__item { border-top: 1px solid {{ st.line_color | default: '#e1dbcf' }}; }
  #shopify-section-{{ sid }} .abq2__item:last-child { border-bottom: 1px solid {{ st.line_color | default: '#e1dbcf' }}; }
  #shopify-section-{{ sid }} .abq2__q { display: flex; justify-content: space-between; align-items: center; gap: 20px; padding: 22px 0; cursor: pointer; list-style: none; color: var(--color-heading); font-size: 18px; font-weight: 600; line-height: 1.4; }
  #shopify-section-{{ sid }} .abq2__q::-webkit-details-marker { display: none; }
  #shopify-section-{{ sid }} .abq2__icon { position: relative; flex: 0 0 30px; width: 30px; height: 30px; border-radius: 50%; background: {{ st.icon_bg | default: '#f5f2ec' }}; transition: transform 0.3s ease, background-color 0.3s ease; }
  #shopify-section-{{ sid }} .abq2__icon::before, #shopify-section-{{ sid }} .abq2__icon::after { content: ""; position: absolute; left: 50%; top: 50%; width: 12px; height: 2px; margin: -1px 0 0 -6px; background: var(--color-heading); border-radius: 1px; }
  #shopify-section-{{ sid }} .abq2__icon::after { transform: rotate(90deg); transition: transform 0.3s ease; }
  #shopify-section-{{ sid }} details[open] .abq2__icon { background: {{ st.accent_color | default: '#c4471f' }}; }
  #shopify-section-{{ sid }} details[open] .abq2__icon::before, #shopify-section-{{ sid }} details[open] .abq2__icon::after { background: #fff; }
  #shopify-section-{{ sid }} details[open] .abq2__icon::after { transform: rotate(0deg); }
  #shopify-section-{{ sid }} .abq2__a { padding: 0 48px 22px 0; color: var(--color-text); font-size: 16px; line-height: 1.65; animation: abq2-in-{{ sid }} 0.35s ease both; }
  #shopify-section-{{ sid }} .abq2__a p { margin: 0 0 10px; }
  #shopify-section-{{ sid }} .abq2__a p:last-child { margin: 0; }
  @keyframes abq2-in-{{ sid }} { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { #shopify-section-{{ sid }} .abq2__a { animation: none; } #shopify-section-{{ sid }} .abq2__icon, #shopify-section-{{ sid }} .abq2__icon::after { transition: none; } }
</style>
<div class="abq2 color-{{ color_scheme }}" id="{{ st.anchor | default: 'questions' | handleize }}" data-section-id="{{ sid }}">
  <div class="abq2__inner">
    <div>
      {%- if st.eyebrow != blank -%}<p class="abq2__eyebrow">{{ st.eyebrow | escape }}</p>{%- endif -%}
      {%- if st.heading != blank -%}<h2 class="abq2__heading">{{ st.heading }}</h2>{%- endif -%}
      {%- if st.text != blank -%}<div class="abq2__text">{{ st.text }}</div>{%- endif -%}
    </div>
    <div>
      {%- for block in section.blocks -%}
        <details class="abq2__item"{% if forloop.first and st.first_open %} open{% endif %} {{ block.shopify_attributes }}>
          <summary class="abq2__q"><span>{{ block.settings.question | escape }}</span><span class="abq2__icon" aria-hidden="true"></span></summary>
          <div class="abq2__a">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Author questions",
  "tag": "section",
  "class": "section sec__authorbook-faq",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default-color-scheme" },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#c4471f" },
    { "type": "color", "id": "icon_bg", "label": "Plus circle", "default": "#f5f2ec" },
    { "type": "color", "id": "line_color", "label": "Lines", "default": "#e1dbcf" },
    { "type": "text", "id": "anchor", "label": "Name for links to this section", "default": "questions" },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Questions" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Before you <em>buy</em>" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Anything else? <a href=\"/pages/contact\">Write to me</a>.</p>" },
    { "type": "checkbox", "id": "first_open", "label": "First question open", "default": true },
    { "type": "range", "id": "heading_size", "label": "Heading size, desktop", "min": 28, "max": 72, "step": 2, "unit": "px", "default": 48 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size, phone", "min": 24, "max": 48, "step": 2, "unit": "px", "default": 36 },
    { "type": "range", "id": "padding_top", "label": "Space above, desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 104 },
    { "type": "range", "id": "padding_bottom", "label": "Space below, desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 104 },
    { "type": "range", "id": "padding_top_mobile", "label": "Space above, phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Space below, phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    { "type": "question", "name": "Question", "settings": [
      { "type": "text", "id": "question", "label": "Question", "default": "A question readers ask" },
      { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>A short, plain answer.</p>" }
    ] }
  ],
  "max_blocks": 16,
  "presets": [ { "name": "Author questions", "blocks": [ { "type": "question" }, { "type": "question" }, { "type": "question" } ] } ]
}
{% endschema %}
