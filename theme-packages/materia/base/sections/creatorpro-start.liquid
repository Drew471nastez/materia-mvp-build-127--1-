{%- comment -%}
  Content creator: "New here? Start with these." A heading on the left and
  up to four steps on the right, joined by a thin line: each a big number,
  a title, a line and a link with an arrow (a link to #open-form-<name>
  opens a form popup). Stacked on a phone. The arrow nudges on hover.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign color_scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
-%}
<style>
  #shopify-section-{{ sid }} .cps { background: {{ st.background | default: '#f5f4f0' }}; padding: {{ st.padding_top_mobile | default: 56 }}px 20px {{ st.padding_bottom_mobile | default: 56 }}px; scroll-margin-top: 80px; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .cps { padding: {{ st.padding_top | default: 96 }}px 40px {{ st.padding_bottom | default: 96 }}px; } }
  #shopify-section-{{ sid }} .cps__inner { max-width: 1200px; margin: 0 auto; }
  #shopify-section-{{ sid }} .cps__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 12px 40px; }
  #shopify-section-{{ sid }} .cps__eyebrow { margin: 0 0 12px; color: {{ st.accent_color | default: '#ff5a36' }}; font-size: 14px; font-weight: 700; }
  #shopify-section-{{ sid }} .cps__heading { margin: 0; color: var(--color-heading); font-family: var(--heading-font, inherit); font-weight: var(--heading-weight, 700); font-size: {{ st.heading_size_mobile | default: 34 }}px; line-height: 1.05; letter-spacing: -0.03em; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .cps__heading { font-size: {{ st.heading_size | default: 52 }}px; } }
  #shopify-section-{{ sid }} .cps__heading em { font-style: normal; color: {{ st.accent_color | default: '#ff5a36' }}; }
  #shopify-section-{{ sid }} .cps__text { margin: 0; max-width: 40ch; color: var(--color-text); font-size: 17px; line-height: 1.55; }
  #shopify-section-{{ sid }} .cps__list { list-style: none; margin: 40px 0 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 14px; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .cps__list { grid-template-columns: repeat({{ section.blocks.size | at_least: 1 | at_most: 4 }}, minmax(0, 1fr)); gap: 20px; margin-top: 52px; } }
  #shopify-section-{{ sid }} .cps__step { position: relative; display: flex; flex-direction: column; padding: 26px 24px 24px; border-radius: {{ st.radius | default: 20 }}px; background: #fff; color: var(--color-heading); text-decoration: none; transition: transform 0.25s ease, box-shadow 0.25s ease; }
  #shopify-section-{{ sid }} .cps__step:hover { transform: translateY(-3px); box-shadow: 0 20px 40px -24px rgba(16,17,20,0.3); }
  #shopify-section-{{ sid }} .cps__num { display: inline-grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--color-heading); color: #fff; font-size: 15px; font-weight: 700; }
  #shopify-section-{{ sid }} .cps__step:first-child .cps__num { background: {{ st.accent_color | default: '#ff5a36' }}; }
  #shopify-section-{{ sid }} .cps__kind { margin: 22px 0 0; color: var(--color-text); font-size: 13px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; }
  #shopify-section-{{ sid }} .cps__title { margin: 6px 0 0; font-size: 21px; font-weight: 700; line-height: 1.25; letter-spacing: -0.01em; }
  #shopify-section-{{ sid }} .cps__line { margin: 8px 0 0; color: var(--color-text); font-size: 15.5px; line-height: 1.55; }
  #shopify-section-{{ sid }} .cps__go { display: inline-flex; align-items: center; gap: 8px; margin-top: auto; padding-top: 22px; font-size: 15px; font-weight: 700; }
  #shopify-section-{{ sid }} .cps__go svg { width: 16px; height: 16px; transition: transform 0.25s ease; }
  #shopify-section-{{ sid }} .cps__step:hover .cps__go svg { transform: translateX(4px); }
  @media (prefers-reduced-motion: reduce) { #shopify-section-{{ sid }} .cps__step, #shopify-section-{{ sid }} .cps__go svg { transition: none; } }
</style>
<div class="cps color-{{ color_scheme }}" id="{{ st.anchor | default: 'start' | handleize }}" data-section-id="{{ sid }}">
  <div class="cps__inner">
    <div class="cps__head">
      <div>
        {%- if st.eyebrow != blank -%}<p class="cps__eyebrow">{{ st.eyebrow | escape }}</p>{%- endif -%}
        {%- if st.heading != blank -%}<h2 class="cps__heading">{{ st.heading }}</h2>{%- endif -%}
      </div>
      {%- if st.text != blank -%}<p class="cps__text">{{ st.text | escape }}</p>{%- endif -%}
    </div>
    <ol class="cps__list" role="list">
      {%- for block in section.blocks -%}
        <li style="display:flex" {{ block.shopify_attributes }}>
          <a class="cps__step" style="flex:1" href="{{ block.settings.link | default: '/' }}">
            <span class="cps__num">{{ forloop.index }}</span>
            {%- if block.settings.kind != blank -%}<span class="cps__kind">{{ block.settings.kind | escape }}</span>{%- endif -%}
            <span class="cps__title">{{ block.settings.title | escape }}</span>
            <span class="cps__line">{{ block.settings.line | escape }}</span>
            <span class="cps__go">{{ block.settings.link_label | escape }}<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg></span>
          </a>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</div>
{% schema %}
{
  "name": "Creator start here",
  "tag": "section",
  "class": "section sec__creatorpro-start",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default-color-scheme" },
    { "type": "color", "id": "background", "label": "Background", "default": "#f5f4f0" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#ff5a36" },
    { "type": "range", "id": "radius", "label": "Card corners", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 20 },
    { "type": "text", "id": "anchor", "label": "Name for links to this section", "default": "start" },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "New here?" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Start with <em>these</em>" },
    { "type": "text", "id": "text", "label": "Line", "default": "The three things most people find useful first." },
    { "type": "range", "id": "heading_size", "label": "Heading size, desktop", "min": 28, "max": 80, "step": 2, "unit": "px", "default": 52 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size, phone", "min": 24, "max": 52, "step": 2, "unit": "px", "default": 34 },
    { "type": "range", "id": "padding_top", "label": "Space above, desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Space below, desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_top_mobile", "label": "Space above, phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Space below, phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    { "type": "step", "name": "Step", "settings": [
      { "type": "text", "id": "kind", "label": "Small label", "default": "Free guide" },
      { "type": "text", "id": "title", "label": "Title", "default": "A first thing to read or watch" },
      { "type": "text", "id": "line", "label": "Line", "default": "One line on what it helps with." },
      { "type": "text", "id": "link_label", "label": "Link text", "default": "Get it free" },
      { "type": "text", "id": "link", "label": "Link", "info": "A page, or #open-form-name to open a form popup." }
    ] }
  ],
  "max_blocks": 4,
  "presets": [ { "name": "Creator start here", "blocks": [ { "type": "step" }, { "type": "step" }, { "type": "step" } ] } ]
}
{% endschema %}
