{%- comment -%}
  Content creator: the topics, sliding past in a band. Each topic is a
  large word with a small star between them; the row is written twice and
  moved by half its width in a loop, so it never jumps. With reduced motion
  it stands still and wraps.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign color_scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
  assign words = st.topics | newline_to_br | split: '<br />'
-%}
<style>
  #shopify-section-{{ sid }} .cpm { background: {{ st.background | default: '#101114' }}; color: {{ st.text_color | default: '#ffffff' }}; padding: {{ st.padding | default: 22 }}px 0; overflow: hidden; }
  #shopify-section-{{ sid }} .cpm__track { display: flex; width: max-content; animation: cpm-move-{{ sid }} {{ st.speed | default: 40 }}s linear infinite; }
  #shopify-section-{{ sid }} .cpm__row { display: flex; align-items: center; flex: 0 0 auto; }
  #shopify-section-{{ sid }} .cpm__word { padding: 0 22px; font-family: var(--heading-font, inherit); font-weight: var(--heading-weight, 700); font-size: {{ st.size_mobile | default: 26 }}px; letter-spacing: -0.02em; white-space: nowrap; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .cpm__word { font-size: {{ st.size | default: 40 }}px; padding: 0 30px; } }
  #shopify-section-{{ sid }} .cpm__star { flex: 0 0 auto; width: 18px; height: 18px; color: {{ st.accent_color | default: '#ff5a36' }}; }
  @keyframes cpm-move-{{ sid }} { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .cpm__track { animation: none; width: auto; justify-content: center; }
    #shopify-section-{{ sid }} .cpm__row { flex-wrap: wrap; justify-content: center; }
    #shopify-section-{{ sid }} .cpm__row + .cpm__row { display: none; }
  }
</style>
<div class="cpm color-{{ color_scheme }}" data-section-id="{{ sid }}">
  <div class="cpm__track">
    {%- for n in (1..2) -%}
      <div class="cpm__row"{% if n == 2 %} aria-hidden="true"{% endif %}>
        {%- for w in words -%}{%- assign t = w | strip -%}{%- if t != blank -%}
          <span class="cpm__word">{{ t | escape }}</span><svg class="cpm__star" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 0l2.4 7.6L20 10l-7.6 2.4L10 20l-2.4-7.6L0 10l7.6-2.4z"/></svg>
        {%- endif -%}{%- endfor -%}
        {%- for w in words -%}{%- assign t = w | strip -%}{%- if t != blank -%}
          <span class="cpm__word" aria-hidden="true">{{ t | escape }}</span><svg class="cpm__star" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 0l2.4 7.6L20 10l-7.6 2.4L10 20l-2.4-7.6L0 10l7.6-2.4z"/></svg>
        {%- endif -%}{%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "Creator topics band",
  "tag": "section",
  "class": "section sec__creatorpro-marquee",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default-color-scheme" },
    { "type": "color", "id": "background", "label": "Background", "default": "#101114" },
    { "type": "color", "id": "text_color", "label": "Words", "default": "#ffffff" },
    { "type": "color", "id": "accent_color", "label": "Stars", "default": "#ff5a36" },
    { "type": "textarea", "id": "topics", "label": "Topics, one per line", "default": "Audience\nOffers\nVideo\nEmail\nPricing" },
    { "type": "range", "id": "speed", "label": "Seconds for one loop", "min": 10, "max": 120, "step": 5, "default": 40 },
    { "type": "range", "id": "size", "label": "Word size, desktop", "min": 20, "max": 80, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "size_mobile", "label": "Word size, phone", "min": 16, "max": 48, "step": 2, "unit": "px", "default": 26 },
    { "type": "range", "id": "padding", "label": "Space above and below", "min": 8, "max": 60, "step": 2, "unit": "px", "default": 22 }
  ],
  "presets": [ { "name": "Creator topics band" } ]
}
{% endschema %}
