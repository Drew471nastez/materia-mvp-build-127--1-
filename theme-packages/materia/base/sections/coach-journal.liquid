{%- comment -%}
  Coach: from the journal. A centred label and heading over three cards,
  each a picture, a topic, a title, a line and a Read more link, then one
  button to the whole journal. The cards are written here, so they can
  point at posts, guides or anything else.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign color_scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
  assign placeholder = 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 600 400%22%3E%3Crect width=%22600%22 height=%22400%22 fill=%22%23eadfd1%22/%3E%3C/svg%3E'
-%}
{%- assign coach_hf = settings.font_heading_google_family -%}
{%- if coach_hf != blank and coach_hf != 'none' -%}<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ coach_hf | replace: ' ', '+' }}:ital@1&display=swap">{%- endif -%}
<style>
  #shopify-section-{{ sid }} .coj {
    --coj-accent: {{ st.accent_color | default: '#a5582a' }};
    background: {{ st.background | default: '#faf6f0' }};
    padding: {{ st.padding_top_mobile | default: 56 }}px 20px {{ st.padding_bottom_mobile | default: 56 }}px;
  }
  @media (min-width: 990px) {
    #shopify-section-{{ sid }} .coj { padding: {{ st.padding_top | default: 96 }}px 40px {{ st.padding_bottom | default: 88 }}px; }
  }
  #shopify-section-{{ sid }} .coj__inner { max-width: 1200px; margin: 0 auto; }
  #shopify-section-{{ sid }} .coj__head { text-align: center; margin: 0 auto 40px; max-width: 640px; }
  #shopify-section-{{ sid }} .coj__eyebrow { margin: 0 0 14px; color: var(--coj-accent); font-size: 12px; font-weight: 500; letter-spacing: 0.2em; text-transform: uppercase; }
  #shopify-section-{{ sid }} .coj__heading {
    margin: 0; color: var(--color-heading);
    font-family: var(--heading-font, inherit); font-weight: var(--heading-weight, 500);
    font-size: {{ st.heading_size_mobile | default: 34 }}px; line-height: 1.12;
  }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .coj__heading { font-size: {{ st.heading_size | default: 44 }}px; } }
  #shopify-section-{{ sid }} .coj__heading em { font-style: italic; color: var(--coj-accent); }
  #shopify-section-{{ sid }} .coj__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 36px; }
  @media (min-width: 750px) { #shopify-section-{{ sid }} .coj__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px; } }
  #shopify-section-{{ sid }} .coj__card { display: block; color: inherit; text-decoration: none; }
  #shopify-section-{{ sid }} .coj__pic { position: relative; aspect-ratio: 3 / 2; overflow: hidden; margin: 0 0 18px; border-radius: 3px; background: #eadfd1; }
  #shopify-section-{{ sid }} .coj__pic img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; margin: 0; transition: transform 0.6s ease; }
  #shopify-section-{{ sid }} .coj__card:hover .coj__pic img { transform: scale(1.03); }
  #shopify-section-{{ sid }} .coj__topic { margin: 0 0 8px; color: var(--coj-accent); font-size: 11.5px; letter-spacing: 0.18em; text-transform: uppercase; }
  #shopify-section-{{ sid }} .coj__title { margin: 0 0 8px; color: var(--color-heading); font-family: var(--heading-font, inherit); font-weight: var(--heading-weight, 500); font-size: 25px; line-height: 1.2; font-variant-numeric: lining-nums; }
  #shopify-section-{{ sid }} .coj__text { margin: 0 0 14px; color: var(--color-text); font-size: 15px; line-height: 1.6; }
  #shopify-section-{{ sid }} .coj__more { color: var(--color-heading); font-size: 12px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; text-decoration: underline; text-underline-offset: 5px; text-decoration-thickness: 1px; }
  #shopify-section-{{ sid }} .coj__foot { text-align: center; margin-top: 44px; }
  #shopify-section-{{ sid }} .coj__btn {
    display: inline-flex; align-items: center; min-height: 46px; padding: 0 22px;
    border: 1px solid var(--color-heading); border-radius: 2px; color: var(--color-heading);
    font-size: 12px; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; text-decoration: none;
    transition: background-color 0.25s ease, color 0.25s ease;
  }
  #shopify-section-{{ sid }} .coj__btn:hover { background: var(--color-heading); color: {{ st.background | default: '#faf6f0' }}; }
  @media (prefers-reduced-motion: reduce) { #shopify-section-{{ sid }} .coj__pic img { transition: none; } #shopify-section-{{ sid }} .coj__card:hover .coj__pic img { transform: none; } }
</style>

<div class="coj color-{{ color_scheme }}" data-section-id="{{ sid }}">
  <div class="coj__inner">
    {%- if st.eyebrow != blank or st.heading != blank -%}
      <div class="coj__head">
        {%- if st.eyebrow != blank -%}<p class="coj__eyebrow">{{ st.eyebrow | escape }}</p>{%- endif -%}
        {%- if st.heading != blank -%}<h2 class="coj__heading">{{ st.heading }}</h2>{%- endif -%}
      </div>
    {%- endif -%}
    <div class="coj__grid">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <a class="coj__card" href="{{ b.link | default: '/blogs/news' }}" {{ block.shopify_attributes }}>
          <figure class="coj__pic">
            {%- if b.image != blank -%}
              <img src="{{ b.image | image_url: width: 800 }}" srcset="{{ b.image | image_url: width: 500 }} 500w, {{ b.image | image_url: width: 800 }} 800w" sizes="(min-width: 750px) 33vw, 92vw" width="{{ b.image.width | default: 800 }}" height="{{ b.image.height | default: 533 }}" alt="{{ b.alt | default: b.image.alt | escape }}" loading="lazy" decoding="async">
            {%- else -%}
              <img src="{{ placeholder }}" width="600" height="400" alt="">
            {%- endif -%}
          </figure>
          {%- if b.topic != blank -%}<p class="coj__topic">{{ b.topic | escape }}</p>{%- endif -%}
          {%- if b.title != blank -%}<h3 class="coj__title">{{ b.title | escape }}</h3>{%- endif -%}
          {%- if b.text != blank -%}<p class="coj__text">{{ b.text | escape }}</p>{%- endif -%}
          <span class="coj__more">{{ st.more_label | default: 'Read more' | escape }}</span>
        </a>
      {%- endfor -%}
    </div>
    {%- if st.button_label != blank -%}
      <div class="coj__foot"><a class="coj__btn" href="{{ st.button_link | default: '/blogs/news' }}">{{ st.button_label | escape }}</a></div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Coach journal",
  "tag": "section",
  "class": "section sec__coach-journal",
  "max_blocks": 6,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default-color-scheme" },
    { "type": "color", "id": "background", "label": "Background", "default": "#faf6f0" },
    { "type": "color", "id": "accent_color", "label": "Accent colour", "default": "#a5582a" },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "From the journal" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Notes for <em>busy minds</em>" },
    { "type": "text", "id": "more_label", "label": "Link on each card", "default": "Read more" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Read the journal" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "range", "id": "heading_size", "label": "Heading size, desktop", "min": 28, "max": 64, "step": 2, "unit": "px", "default": 44 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size, phone", "min": 24, "max": 44, "step": 2, "unit": "px", "default": 34 },
    { "type": "range", "id": "padding_top", "label": "Space above, desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Space below, desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 88 },
    { "type": "range", "id": "padding_top_mobile", "label": "Space above, phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Space below, phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Picture" },
        { "type": "text", "id": "alt", "label": "Alt text" },
        { "type": "text", "id": "topic", "label": "Topic", "default": "Mindset" },
        { "type": "text", "id": "title", "label": "Title", "default": "A post title" },
        { "type": "textarea", "id": "text", "label": "Line", "default": "One line that makes someone want to read it." },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    { "name": "Coach journal", "blocks": [ { "type": "post" }, { "type": "post" }, { "type": "post" } ] }
  ]
}
{% endschema %}
