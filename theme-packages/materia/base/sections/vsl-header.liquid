{%- comment -%}
Video sales letter: the header of a one offer page, and the background
  behind every page (stars, a plain colour, a soft gradient, the creator's
  picture or video, with an optional glow and grain; see Page background). The name or logo on
  the left, a few quiet links, one button on the right. It stays at the top
  and gains a dark glass background once the page is scrolled. No cart,
  account or search: a page that sells one thing does not need them. On a
  phone the links fold away and the name and the button stay.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
-%}
{%- liquid
  assign menu = st.menu
  assign logo_w = st.logo_width | default: 120
-%}
{%- if section.settings.bg_on != false -%}
{%- liquid
  assign s = section.settings
  assign kind = s.bg_style | default: 'stars'
  assign base = s.bg_base_color | default: '#050506'
  assign star = s.bg_star_color | default: '#ffffff'
  assign g1 = s.bg_gradient_from | default: '#1b1f3b'
  assign g2 = s.bg_gradient_to | default: '#3a1d2e'
  assign glow = s.bg_glow_color | default: '#ffffff'
  assign glow_a = s.bg_glow_strength | default: 14 | divided_by: 100.0
  assign grain_a = s.bg_grain_amount | default: 8 | divided_by: 100.0
  assign wash = s.bg_overlay | default: 62 | divided_by: 100.0
  assign wash2 = wash | plus: 0.2 | at_most: 1
  assign see = s.bg_see_through_scheme.id | default: s.bg_see_through_scheme | default: 'default'
  assign vsrc = ''
  if kind == 'video' and s.bg_video != blank
    assign vsrc = s.bg_video.sources[0].url
    for src in s.bg_video.sources
      if src.mime_type == 'video/mp4'
        assign vsrc = src.url
        break
      endif
    endfor
  endif
  assign still = s.bg_image
  if still == blank and s.bg_video != blank
    assign still = s.bg_video.preview_image
  endif
-%}
<style>
  html { background-color: {{ base }} !important; }
  body { background-color: transparent !important; }
    .vsl-bg-{{ sid }} { position: fixed; inset: 0; z-index: -1; overflow: hidden; pointer-events: none; background-color: {{ base }}; contain: strict; }
  .vsl-bg-{{ sid }} > * { position: absolute; inset: 0; }
  {%- if s.bg_see_through %}
  /* Sections in this colour scheme let the background show through. Drawers and pop ups keep their own colour. */
  main .color-{{ see }}, main .color-{{ see }}.gradient,
  .shopify-section-group-footer-group .color-{{ see }},
  .shopify-section-group-header-group .header.color-{{ see }},
  .shopify-section-group-header-group > .shopify-section > .section.color-{{ see }} { background: transparent !important; }
  {%- endif %}

  /* Stars: a still sprinkle until the script has drawn its tile. */
  .vsl-bg-{{ sid }} .vsl-bg__stars { background-image:
      radial-gradient(1px 1px at 12% 18%, {{ star }} 50%, transparent 51%), radial-gradient(1px 1px at 68% 32%, {{ star }} 50%, transparent 51%),
      radial-gradient(1.5px 1.5px at 38% 74%, {{ star }} 50%, transparent 51%), radial-gradient(1px 1px at 86% 82%, {{ star }} 50%, transparent 51%),
      radial-gradient(1px 1px at 52% 48%, {{ star }} 50%, transparent 51%), radial-gradient(1px 1px at 22% 58%, {{ star }} 50%, transparent 51%); opacity: .8; }
  .vsl-bg-{{ sid }} .vsl-bg__stars[data-ready] { inset: 0 0 -620px 0; background-repeat: repeat; background-size: 620px 620px; }
  .vsl-bg-{{ sid }} .vsl-bg__stars.is-moving { animation: vsl-bg-drift-{{ sid }} {{ s.bg_drift_seconds | default: 160 }}s linear infinite; will-change: transform; }
  @keyframes vsl-bg-drift-{{ sid }} { from { transform: translate3d(0, 0, 0); } to { transform: translate3d(0, -620px, 0); } }
  .vsl-bg-{{ sid }} .vsl-bg__tw { position: absolute; inset: auto; width: 2px; height: 2px; border-radius: 50%; background: {{ star }}; box-shadow: 0 0 6px 1px {{ star | color_modify: 'alpha', 0.6 }}; opacity: .15; animation: vsl-bg-tw-{{ sid }} var(--tw, 5s) ease-in-out var(--td, 0s) infinite; }
  @keyframes vsl-bg-tw-{{ sid }} { 0%, 100% { opacity: .12; } 50% { opacity: .95; } }

  /* Gradient: two soft lights that drift past each other. */
  .vsl-bg-{{ sid }} .vsl-bg__mesh { inset: -20%; background:
      radial-gradient(40% 45% at 25% 30%, {{ g1 }}, transparent 70%),
      radial-gradient(45% 50% at 78% 65%, {{ g2 }}, transparent 72%);
    animation: vsl-bg-mesh-{{ sid }} 38s ease-in-out infinite alternate; will-change: transform; }
  @keyframes vsl-bg-mesh-{{ sid }} { from { transform: translate3d(-3%, -2%, 0) rotate(0deg); } to { transform: translate3d(3%, 3%, 0) rotate(8deg); } }

  /* The creator's picture or video, under a dark wash so the words stay readable. */
  .vsl-bg-{{ sid }} .vsl-bg__media img, .vsl-bg-{{ sid }} .vsl-bg__media video { width: 100%; height: 100%; object-fit: cover; display: block; }
  .vsl-bg-{{ sid }} .vsl-bg__media video { opacity: 0; transition: opacity 1.2s ease; }
  .vsl-bg-{{ sid }} .vsl-bg__media video.is-on { opacity: 1; }
  .vsl-bg-{{ sid }} .vsl-bg__wash { background: linear-gradient(180deg, {{ base | color_modify: 'alpha', wash }}, {{ base | color_modify: 'alpha', wash2 }}); }
  {%- if s.bg_media_grey %}.vsl-bg-{{ sid }} .vsl-bg__media { filter: grayscale(1); }{% endif %}

  /* Glow from the top of the screen, and grain over everything. */
  .vsl-bg-{{ sid }} .vsl-bg__glow { background: radial-gradient(70% 55% at 50% -8%, {{ glow | color_modify: 'alpha', glow_a }}, transparent 70%); }
  .vsl-bg-{{ sid }} .vsl-bg__grain { opacity: {{ grain_a }}; mix-blend-mode: overlay; background-size: 160px 160px; }
  .vsl-bg-{{ sid }}[data-paused] * { animation-play-state: paused !important; }
  @media (prefers-reduced-motion: reduce) {
    .vsl-bg-{{ sid }} .vsl-bg__stars.is-moving, .vsl-bg-{{ sid }} .vsl-bg__mesh, .vsl-bg-{{ sid }} .vsl-bg__tw { animation: none; }
  }
</style>
<div class="vsl-bg vsl-bg-{{ sid }}" aria-hidden="true" data-vsl-bg data-kind="{{ kind }}" data-density="{{ s.bg_star_density | default: 40 }}" data-star="{{ star }}" data-drift="{% if s.bg_drift %}1{% endif %}" data-twinkles="{{ s.bg_twinkles | default: 12 }}">
  {%- case kind -%}
    {%- when 'stars' -%}<div class="vsl-bg__stars"></div>
    {%- when 'gradient' -%}<div class="vsl-bg__mesh"></div>
    {%- when 'image' -%}
      {%- if still != blank -%}<div class="vsl-bg__media">{{ still | image_url: width: 2400 | image_tag: widths: '800, 1200, 1600, 2000, 2400', sizes: '100vw', loading: 'eager', alt: '' }}</div><div class="vsl-bg__wash"></div>{%- endif -%}
    {%- when 'video' -%}
      <div class="vsl-bg__media">
        {%- if still != blank -%}{{ still | image_url: width: 2000 | image_tag: widths: '800, 1200, 1600, 2000', sizes: '100vw', loading: 'eager', alt: '' }}{%- endif -%}
        {%- if vsrc != blank -%}<video muted loop playsinline preload="none" data-src="{{ vsrc | escape }}" style="position:absolute;inset:0"></video>{%- endif -%}
      </div>
      {%- if still != blank or vsrc != blank -%}<div class="vsl-bg__wash"></div>{%- endif -%}
  {%- endcase -%}
  {%- if s.bg_glow -%}<div class="vsl-bg__glow"></div>{%- endif -%}
  {%- if s.bg_grain -%}<div class="vsl-bg__grain"></div>{%- endif -%}
</div>
<script>
  (function () {
    var fresh = document.querySelector('#shopify-section-{{ sid }} .vsl-bg-{{ sid }}');
    /* The background sits at the very back of the page, outside the header's own layer. A redraw in the editor replaces the one already there. */
    document.querySelectorAll('body > .vsl-bg').forEach(function (old) { if (old !== fresh) old.remove(); });
    var root = fresh || document.querySelector('.vsl-bg-{{ sid }}');
    if (!root) return;
    if (root.parentNode !== document.body) document.body.insertBefore(root, document.body.firstChild);
    var still = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var stars = root.querySelector('.vsl-bg__stars');
    if (stars && !stars.hasAttribute('data-ready')) {
      var T = 620, dpr = Math.min(2, window.devicePixelRatio || 1), seed = 11;
      var rnd = function () { seed = (seed * 16807) % 2147483647; return (seed - 1) / 2147483646; };
      var c = document.createElement('canvas'); c.width = c.height = T * dpr;
      var x = c.getContext('2d');
      if (x) {
        x.scale(dpr, dpr); x.fillStyle = root.dataset.star || '#fff';
        var n = Math.round(Math.max(0, Number(root.dataset.density) || 0) * 2.4);
        for (var i = 0; i < n; i++) {
          var r = rnd() < .9 ? .45 + rnd() * .5 : 1 + rnd() * .5, px = rnd() * T, py = rnd() * T;
          x.globalAlpha = .25 + rnd() * .65;
          [[0, 0], [T, 0], [-T, 0], [0, T], [0, -T]].forEach(function (o) { x.beginPath(); x.arc(px + o[0], py + o[1], r, 0, Math.PI * 2); x.fill(); });
        }
        stars.style.backgroundImage = 'url(' + c.toDataURL('image/png') + ')';
        stars.setAttribute('data-ready', '');
        if (root.dataset.drift && !still) stars.classList.add('is-moving');
        var tw = Math.min(40, Number(root.dataset.twinkles) || 0);
        for (var k = 0; k < tw; k++) {
          var d = document.createElement('i'); d.className = 'vsl-bg__tw';
          d.style.left = (rnd() * 100).toFixed(2) + '%'; d.style.top = (rnd() * 100).toFixed(2) + '%';
          d.style.setProperty('--tw', (3 + rnd() * 5).toFixed(2) + 's'); d.style.setProperty('--td', (-rnd() * 6).toFixed(2) + 's');
          root.appendChild(d);
        }
      }
    }
    var grain = root.querySelector('.vsl-bg__grain');
    if (grain && !grain.style.backgroundImage) {
      var g = document.createElement('canvas'); g.width = g.height = 160;
      var gx = g.getContext('2d');
      if (gx) {
        var img = gx.createImageData(160, 160), d = img.data;
        for (var q = 0; q < d.length; q += 4) { var n = Math.random() * 255 | 0; d[q] = d[q + 1] = d[q + 2] = n; d[q + 3] = 255; }
        gx.putImageData(img, 0, 0);
        grain.style.backgroundImage = 'url(' + g.toDataURL('image/png') + ')';
      }
    }
    var v = root.querySelector('video[data-src]');
    if (v && !still) {
      var go = function () { if (!v.src) v.src = v.getAttribute('data-src'); var p = v.play(); if (p && p.catch) p.catch(function () {}); };
      v.addEventListener('playing', function () { v.classList.add('is-on'); });
      if (document.readyState === 'complete') setTimeout(go, 300); else window.addEventListener('load', function () { setTimeout(go, 300); }, { once: true });
    }
    document.addEventListener('visibilitychange', function () {
      if (document.hidden) { root.setAttribute('data-paused', ''); if (v && v.src) v.pause(); }
      else { root.removeAttribute('data-paused'); if (v && v.src && !still) { var p = v.play(); if (p && p.catch) p.catch(function () {}); } }
    });
  })();
</script>
{%- endif -%}
<style>
  .vsl { position: relative; color: var(--vsl-text, #a3a3a8); font-family: var(--body-font, inherit); -webkit-font-smoothing: antialiased; }
  .vsl *, .vsl *::before, .vsl *::after { box-sizing: border-box; }
  .vsl__inner { position: relative; max-width: var(--vsl-max, 1120px); margin: 0 auto; padding: 0 20px; }
  .vsl__head { text-align: center; margin: 0 auto 44px; max-width: 760px; }
  .vsl__eyebrow { display: flex; align-items: center; justify-content: center; gap: 14px; margin: 0 0 18px; font-size: 11px; font-weight: 500; letter-spacing: .24em; text-transform: uppercase; color: rgba(255,255,255,.6); }
  .vsl__eyebrow::before, .vsl__eyebrow::after { content: ""; flex: 0 0 34px; height: 1px; background: linear-gradient(90deg, rgba(255,255,255,0), rgba(255,255,255,.5)); }
  .vsl__eyebrow::after { background: linear-gradient(270deg, rgba(255,255,255,0), rgba(255,255,255,.5)); }
  .vsl__title { margin: 0; color: var(--vsl-head, #fff); font-family: var(--heading-font, inherit); font-weight: 700; font-size: clamp(32px, 4.6vw, 52px); line-height: 1.06; letter-spacing: -.035em; text-wrap: balance; }
  .vsl__title em, .vsl em.vsl-serif { font-style: normal; color: rgba(255,255,255,.6); }
  .vsl__lede { margin: 16px auto 0; max-width: 580px; font-size: 15px; line-height: 1.65; }
  .vsl__lede p { margin: 0; }
  .vsl-btn {
    position: relative; isolation: isolate; overflow: hidden;
    display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 48px; padding: 0 24px;
    border-radius: 999px; border: 1px solid rgba(255,255,255,.24); background: rgba(10,10,12,.85); color: #fff;
    font-family: var(--body-font, inherit); font-size: 14px; font-weight: 600; letter-spacing: -.005em; text-decoration: none; white-space: nowrap;
    box-shadow: inset 0 1px 0 rgba(255,255,255,.22), 0 0 0 4px rgba(255,255,255,.03), 0 14px 40px -14px rgba(255,255,255,.35);
    transition: transform .35s cubic-bezier(.2,.7,.2,1), border-color .35s, box-shadow .35s;
  }
  .vsl-btn::before { content: ""; position: absolute; z-index: -1; top: -1px; left: -40%; width: 40%; height: 2px; background: linear-gradient(90deg, transparent, #fff, transparent); opacity: .9; transition: transform 1.1s cubic-bezier(.2,.7,.2,1); }
  .vsl-btn:hover { transform: translateY(-1px); border-color: rgba(255,255,255,.5); box-shadow: inset 0 1px 0 rgba(255,255,255,.3), 0 0 0 4px rgba(255,255,255,.05), 0 18px 50px -14px rgba(255,255,255,.45); }
  .vsl-btn:hover::before { transform: translateX(350%); }
  .vsl-btn:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
  .vsl-btn svg { width: 16px; height: 16px; flex: none; transition: transform .35s cubic-bezier(.2,.7,.2,1); }
  .vsl-btn:hover svg { transform: translateX(3px); }
  .vsl-btn--light { background: #fff; color: #0a0a0a; border-color: #fff; box-shadow: 0 14px 40px -14px rgba(255,255,255,.5); }
  .vsl-btn--light::before { display: none; }
  .vsl-btn--ghost { background: transparent; box-shadow: none; border-color: rgba(255,255,255,.16); }
  .vsl__actions { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 12px; margin-top: 30px; }
  .vsl-card {
    position: relative; border-radius: 18px; border: 1px solid rgba(255,255,255,.09);
    background: linear-gradient(180deg, rgba(255,255,255,.06), rgba(255,255,255,.015) 60%), rgba(12,12,14,.72);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.07), 0 30px 60px -40px rgba(0,0,0,.9);
  }
  .vsl--line { padding-top: 1px; }
  .vsl--line::before { content: ""; position: absolute; left: 50%; top: 0; width: min(1120px, calc(100% - 40px)); height: 1px; transform: translateX(-50%); background: linear-gradient(90deg, rgba(255,255,255,0), rgba(255,255,255,.26) 50%, rgba(255,255,255,0)); }
  .vsl--line::after { content: ""; position: absolute; left: 50%; top: 0; width: min(900px, 90%); height: 180px; transform: translateX(-50%); pointer-events: none; background: radial-gradient(50% 100% at 50% 0, rgba(255,255,255,.07), rgba(255,255,255,0)); }
  @media (max-width: 749px) { .vsl__eyebrow { letter-spacing: .18em; gap: 10px; } .vsl__eyebrow::before, .vsl__eyebrow::after { flex-basis: 22px; } .vsl__head { margin-bottom: 32px; } }
  html.vsl-js .vsl [data-motion] { opacity: 0; transform: translate3d(0, 22px, 0); transition: opacity .9s cubic-bezier(.2,.65,.2,1), transform .9s cubic-bezier(.2,.65,.2,1); transition-delay: var(--d, 0ms); }
  html.vsl-js .vsl [data-motion].is-in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    html.vsl-js .vsl [data-motion] { opacity: 1; transform: none; transition: none; }
    .vsl-btn, .vsl-btn::before, .vsl-btn svg { transition: none; }
  }

  #shopify-section-{{ sid }} { position: sticky; top: 0; z-index: 40; }
  .vsl-head { transition: background-color .4s, border-color .4s, backdrop-filter .4s; border-bottom: 1px solid transparent; }
  .vsl-head.is-scrolled { background: rgba(5,5,6,.72); -webkit-backdrop-filter: blur(12px) saturate(140%); backdrop-filter: blur(12px) saturate(140%); border-bottom-color: rgba(255,255,255,.07); }
  .vsl-head .vsl__inner { display: flex; align-items: center; gap: 24px; min-height: 76px; max-width: 1200px; }
  .vsl-head__brand { display: inline-flex; align-items: center; gap: 10px; color: #fff; text-decoration: none; font-weight: 700; font-size: 17px; letter-spacing: .14em; text-transform: uppercase; }
  #shopify-section-{{ sid }} .vsl-head__brand img { display: block; height: auto; width: {{ logo_w }}px; }
  .vsl-head__mark { width: 22px; height: 22px; flex: none; }
  .vsl-head__nav { display: none; margin-left: auto; gap: 28px; }
  .vsl-head__nav a { color: rgba(255,255,255,.66); font-size: 14px; text-decoration: none; transition: color .25s; }
  .vsl-head__nav a:hover, .vsl-head__nav a[aria-current] { color: #fff; }
  .vsl-head__cta { margin-left: auto; }
  .vsl-head .vsl-btn { min-height: 40px; padding: 0 18px; font-size: 13px; }
  @media (min-width: 900px) {
    .vsl-head__nav { display: flex; }
    .vsl-head__cta { margin-left: 8px; }
  }
  @media (max-width: 420px) { .vsl-head__brand { font-size: 15px; letter-spacing: .1em; } .vsl-head .vsl-btn { padding: 0 14px; } .vsl-head .vsl-btn svg { display: none; } }
</style>
<header data-own-font class="vsl vsl-head" data-vsl-head>
  <div class="vsl__inner">
    <a class="vsl-head__brand" href="{{ routes.root_url }}">
      {%- if st.logo != blank -%}
        {{ st.logo | image_url: width: 480 | image_tag: alt: shop.name, loading: 'eager', widths: '160, 240, 320, 480' }}
      {%- else -%}
        {%- if st.show_mark -%}{%- case st.mark -%}{%- when 'frame' -%}<svg class="vsl-head__mark" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 8V5a2 2 0 0 1 2-2h3M16 3h3a2 2 0 0 1 2 2v3M21 16v3a2 2 0 0 1-2 2h-3M8 21H5a2 2 0 0 1-2-2v-3"/><path d="M10 8.5v7l6-3.5z" fill="#fff" stroke="none"/></svg>{%- when 'wave' -%}<svg class="vsl-head__mark" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M3 10v4M7.5 6.5v11M12 3.5v17M16.5 7.5v9M21 10.5v3"/></svg>{%- when 'dot' -%}<svg class="vsl-head__mark" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" fill="none" stroke="#fff" stroke-width="1.6" opacity=".5"/><circle cx="12" cy="12" r="4.5" fill="#fff"/></svg>{%- else -%}<svg class="vsl-head__mark" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M19.5 14.2A8 8 0 1 1 9.8 4.5a6.4 6.4 0 0 0 9.7 9.7z" fill="#fff"/><circle cx="18.3" cy="5.6" r="1.1" fill="#fff"/></svg>{%- endcase -%}{%- endif -%}
        <span>{{ st.brand_text | default: shop.name | escape }}</span>
      {%- endif -%}
    </a>
    {%- if menu != blank and menu.links.size > 0 -%}
      <nav class="vsl-head__nav" aria-label="{{ st.menu_label | default: 'Main' | escape }}">
        {%- for link in menu.links -%}<a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>{%- endfor -%}
      </nav>
    {%- endif -%}
    {%- if st.button_label != blank -%}
      <div class="vsl-head__cta"><a class="vsl-btn" href="{{ st.button_link | default: '#' }}">{{ st.button_label | escape }}<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 8h10M9 4l4 4-4 4"/></svg></a></div>
    {%- endif -%}
  </div>
</header>

<script>
  (function () {
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;
    var still = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!('IntersectionObserver' in window) || still) return;
    document.documentElement.classList.add('vsl-js');
    if (!window.__vslSeen) {
      window.__vslSeen = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('is-in'); window.__vslSeen.unobserve(e.target); } });
      }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
    }
    root.querySelectorAll('[data-motion]:not(.is-in)').forEach(function (el) { window.__vslSeen.observe(el); });
  })();
</script>
<script>
  (function () {
    var head = document.querySelector('#shopify-section-{{ section.id }} [data-vsl-head]');
    if (!head) return;
    var ticking = false;
    function update() { ticking = false; head.classList.toggle('is-scrolled', window.scrollY > 8); }
    window.addEventListener('scroll', function () { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
    update();
  })();
</script>

{% schema %}
{
  "name": "Offer header",
  "tag": "section",
  "class": "vsl-header-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "A header for a page that sells one thing: no cart, account or search."
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 60,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 120
    },
    {
      "type": "text",
      "id": "brand_text",
      "label": "Name, when there is no logo",
      "info": "Empty: the store's name."
    },
    {
      "type": "checkbox",
      "id": "show_mark",
      "label": "Small mark before the name",
      "default": true
    },
    {
      "type": "select",
      "id": "mark",
      "label": "Mark",
      "default": "moon",
      "options": [
        {
          "value": "moon",
          "label": "Moon"
        },
        {
          "value": "frame",
          "label": "Viewfinder"
        },
