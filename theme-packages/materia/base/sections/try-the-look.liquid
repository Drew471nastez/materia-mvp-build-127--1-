    if (!res.ok || data.status || data.errors) throw new Error(data.description || data.message || data.errors || res.statusText);
    fetch('/cart.json').then(r => r.json()).then(c => document.querySelectorAll('.cart-count').forEach(el => { el.textContent = el.classList.contains('cart-count-drawer') ? '(' + c.item_count + ')' : (c.item_count > 100 ? '~' : c.item_count); })).catch(() => {});
    if (typeof window.publish === 'function' && window.PUB_SUB_EVENTS) { try { window.publish(window.PUB_SUB_EVENTS.cartUpdate, { source: 'materia-add-items', cartData: data }); } catch (_) {} }
    if (cart) {
      if (data.sections) cart.getSectionsToRender().forEach(s => {
        const el = document.getElementById(s.id); if (!el || !data.sections[s.id]) return;
        const incoming = new DOMParser().parseFromString(data.sections[s.id], 'text/html').querySelector('#minicart-form');
        if (incoming && !(window.materiaPatchDrawerCart && window.materiaPatchDrawerCart(el, incoming))) el.innerHTML = incoming.innerHTML;
      });
      if (opts.open !== false) {
        if (typeof cart.cartAction === 'function') cart.cartAction();
        if (typeof cart.open === 'function') cart.open();
      }
    } else if (opts.open !== false) { location.href = (window.routes && window.routes.cart_url) || '/cart'; }
    return data;
  };

  if (!customElements.get('try-the-look')) {
