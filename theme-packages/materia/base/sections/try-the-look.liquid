        this.initCursor(); this.initDrag(); this.initSheetDrag();
        // Autoplay: only while on screen, never in the editor or with reduced motion
        this.sec = +this.dataset.autoplay || 0;
        this.playBtn = this.querySelector('[data-play]');
        this.playBtn?.addEventListener('click', () => this.setPlaying(!this.hasAttribute('data-playing'), true));
        const calm = (window.Shopify && Shopify.designMode) || matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (this.sec > 0 && !calm && 'IntersectionObserver' in window && this.models.length > 1) {
