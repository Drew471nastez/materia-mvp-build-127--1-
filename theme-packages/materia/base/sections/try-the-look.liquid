        }
        const all = t.closest('[data-all]');
        if (all) {
          // The variant chosen on each piece (r68); a piece with one variant adds its own.
          const look = all.closest('[data-look]'), ids = [];
          look.querySelectorAll('.ttl__item:not(.is-sample)').forEach(it => {
            const g = this.vdata(it), v = g && this.chosen(it, g), b = it.querySelector('[data-add]');
            if (v) { if (v.available) ids.push(v.id); } else if (b && !b.disabled) ids.push(b.dataset.add);
          });
          const items = (ids.length ? ids : all.dataset.all.split(',').filter(Boolean)).map(id => ({ id: ttlId(id), quantity: 1 }));
