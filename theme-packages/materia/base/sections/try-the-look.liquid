        const same = sum === +box.dataset.total;
        box.querySelectorAll('[data-sum], [data-full]').forEach((x, k) => { x.textContent = same ? orig[k] : fmt(x.hasAttribute('data-full') ? sum : Math.floor(sum * keep / 100)); });
      }
      async add(btn, items, done) {
        const m = btn.closest('[data-look]')?.querySelector('[data-msg]'); if (m) m.textContent = '';
        btn.setAttribute('aria-busy', 'true');
        try { await window.MateriaAddItems(items); if (done) done(); if (this.lb?.open) this.closeView(); }
        catch (err) { if (m) m.textContent = err.message; }
