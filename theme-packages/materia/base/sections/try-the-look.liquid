        this.paintPrice(it, v);
        it.querySelectorAll('.ttl__og').forEach((row, k) => { const b = row.querySelector('[data-og-v]'); if (b) b.textContent = v.options[k]; });
        it.querySelectorAll('.ttl__opt').forEach(b => {
          const k = +b.dataset.k, want = v.options.slice(); want[k] = b.dataset.val;
