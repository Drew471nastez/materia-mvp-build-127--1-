        const twin = inCard ? this.looks[this.i]?.querySelector('[data-item="' + k + '"]') : (this.lb?.open ? this.lb.querySelector('[data-lb-panel] [data-item="' + k + '"]') : null);
        [it, twin].forEach(x => { if (!x) return; x.dataset.vid = v.id; x.dataset.cents = v.cents; if (x.querySelector('[data-ogs]')?.childElementCount) this.paintItem(x, v); else this.paintPrice(x, v); });
        [look, twin && twin.closest('[data-look]')].forEach(l => l && this.total(l));
