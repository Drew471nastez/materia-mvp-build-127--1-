      }
      // The pieces list that belongs to a pin: the card's copy when the look is open, the panel's otherwise.
      listFor(pin) { return pin.closest('[data-lb]') ? this.lb.querySelector('[data-lb-panel]') : this.looks[this.i]; }
      pinHover(e, on) {
        const pin = e.target.closest && e.target.closest('[data-pin]'); if (!pin || (e.relatedTarget && pin.contains(e.relatedTarget))) return;
        pin.classList.toggle('is-hot', on); this.listFor(pin)?.querySelector('[data-item="' + pin.dataset.pin + '"]')?.classList.toggle('is-hot', on);
      }
