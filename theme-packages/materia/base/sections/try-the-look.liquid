      // The option rows, drawn once from the data: one per option, its values as pills (a colour gets its swatch).
      picker(it) {
        const g = this.vdata(it), box = it.querySelector('[data-ogs]'); if (!g || !box) return;
        if (!box.childElementCount) {
          const id = 'ttl' + Math.random().toString(36).slice(2, 8);
          g.options.forEach((name, k) => {
            const row = document.createElement('div'); row.className = 'ttl__og'; row.setAttribute('role', 'group'); row.setAttribute('aria-labelledby', id + k);
            row.innerHTML = '<span class="ttl__og-n"><span></span><b data-og-v></b></span><div class="ttl__og-v"></div>';
            row.querySelector('.ttl__og-n').id = id + k; row.querySelector('.ttl__og-n span').textContent = name;
            const colour = /colou?r|farbe|couleur|kleur/i.test(name);
            [...new Set(g.variants.map(v => v.options[k]))].forEach(val => {
              const b = document.createElement('button'); b.type = 'button'; b.className = 'ttl__opt'; b.dataset.k = k; b.dataset.val = val;
              if (colour && window.CSS && CSS.supports('color', val.toLowerCase().replace(/\s+/g, ''))) { const i = document.createElement('i'); i.style.setProperty('--sw', val.toLowerCase().replace(/\s+/g, '')); b.append(i); }
              b.append(val); row.querySelector('.ttl__og-v').append(b);
