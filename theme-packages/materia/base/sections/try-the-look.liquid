    const sections = cart && cart.getSectionsToRender ? cart.getSectionsToRender().map(s => s.id) : [];
    const base = ((window.routes && window.routes.cart_add_url) || '/cart/add').replace(/\.js$/, '');
    const res = await fetch(base + '.js', {
      method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
      body: JSON.stringify({ items, sections, sections_url: location.pathname })
