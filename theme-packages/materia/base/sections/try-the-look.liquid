        this.addEventListener('click', e => this.onClick(e));
        this.addEventListener('pointerover', e => this.pinHover(e, true));
        this.addEventListener('pointerout', e => this.pinHover(e, false));
        this.stage.addEventListener('keydown', e => {
          const m = e.target.closest && e.target.closest('[data-model]');
          if (m && m.classList.contains('is-on') && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); this.openView(m); }
          if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') { e.preventDefault(); this.go(this.i + (e.key === 'ArrowRight' ? 1 : -1), true); this.models[this.i].focus({ preventScroll: true }); }
        });
