        } else if (this.playBtn) { this.playBtn.querySelector('[data-i-pause]').hidden = true; this.playBtn.querySelector('[data-i-play]').hidden = false; }
        this.addEventListener('shopify:block:select', e => { const k = this.models.findIndex(m => m.contains(e.target) || m === e.target); if (k > -1) this.go(k, true); });
