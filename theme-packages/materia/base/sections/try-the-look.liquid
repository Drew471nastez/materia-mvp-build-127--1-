        else if (list.scrollHeight > list.clientHeight + 2) list.scrollTo({ top: it.offsetTop - list.offsetTop, behavior: 'smooth' });
        else if (card && card.scrollHeight > card.clientHeight + 2) card.scrollTo({ top: Math.max(0, it.offsetTop - card.clientHeight * 0.35), behavior: 'smooth' });
