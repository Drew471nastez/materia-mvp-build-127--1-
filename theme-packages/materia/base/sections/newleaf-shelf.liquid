{%- comment -%}
  New Leaf (templates round 29): a shelf of templates under a heading, the
  way a template maker files them: a serif heading on the left, one line
  on the right, a rule, then cards in three or four columns. Each card is
  the product's picture, its name with the price on the right (Free when
  it costs nothing, Coming soon when it cannot be bought yet) and a short
  line from its description.

  The products come from a collection, narrowed to one category if one is
  given (with no collection, the whole store's), or, on a product page, from the
  same category as the product shown ("[category]" in the heading becomes
  that category). Cards rise in one after another as the shelf scrolls
  into view, except in the editor and for visitors who prefer less motion.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign sid = section.id
  assign color_scheme = s.color_scheme.id | default: s.color_scheme | default: 'default'
  assign cols = s.columns | default: 3 | plus: 0
  assign limit = s.limit | default: 8 | plus: 0
  assign heading = s.heading
  assign source = s.source | default: 'collection'
  assign here = nil
  if source == 'category' and product != blank
    assign here = product
  endif
  assign cat = ''
  if here
    assign cat = here.type
    if cat == 'digital' or cat == 'physical'
      assign cat = ''
    endif
  endif
  assign cat_word = cat | downcase
  if heading contains '[category]'
    if cat != blank
      assign heading = heading | replace: '[category]', cat_word
    else
      assign heading = s.heading_fallback
    endif
  endif
  assign list = nil
  if source == 'collection' and s.collection != blank and s.collection.products.size > 0
    assign list = s.collection.products
  endif
  if here == nil and s.category != blank
    assign cat = s.category
  endif
  if list == nil
    assign list = collections.all.products
  endif
  assign shown = 0
-%}
<style>
  #shopify-section-{{ sid }} .nls { --nls-accent: {% if s.accent != blank %}{{ s.accent }}{% else %}var(--btn-primary-bg-color){% endif %}; padding-block: {{ s.padding_top_mobile }}px {{ s.padding_bottom_mobile }}px; scroll-margin-top: 60px; }
  #shopify-section-{{ sid }} .nls__head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px 32px; padding-bottom: 16px; margin-bottom: 22px; border-bottom: 1px solid rgba(var(--color-heading-rgb), .12); }
  #shopify-section-{{ sid }} .nls__head h2 { margin: 0; font-size: {{ s.heading_size_mobile }}px; line-height: 1.1; letter-spacing: -.01em; }
  #shopify-section-{{ sid }} .nls__head p { margin: 0; font-size: 14.5px; color: var(--color-text); }
  #shopify-section-{{ sid }} .nls__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 30px 16px; }
  #shopify-section-{{ sid }} .nls__card a { display: block; color: inherit; text-decoration: none; }
  #shopify-section-{{ sid }} .nls__pic { display: block; aspect-ratio: {{ s.ratio | default: '3 / 2' }}; border-radius: {{ s.radius }}px; overflow: hidden; background: rgba(var(--color-heading-rgb), .06); box-shadow: 0 0 0 1px rgba(var(--color-heading-rgb), .08); transition: transform .45s cubic-bezier(.2, .8, .2, 1), box-shadow .45s ease; }
  #shopify-section-{{ sid }} .nls__pic img { width: 100%; height: 100%; object-fit: cover; object-position: top center; display: block; }
  #shopify-section-{{ sid }} .nls__row { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; margin-top: 14px; }
  #shopify-section-{{ sid }} .nls__name { margin: 0; font-family: var(--font-body-family); font-size: 15.5px; font-weight: 700; line-height: 1.3; color: var(--color-heading); }
  #shopify-section-{{ sid }} .nls__price { flex: none; font-family: var(--font-heading-family); font-size: 18px; line-height: 1.2; color: var(--nls-accent); white-space: nowrap; }
  #shopify-section-{{ sid }} .nls__price--soon { font-family: var(--font-body-family); font-style: italic; font-size: 14px; color: var(--color-text); }
  #shopify-section-{{ sid }} .nls__price s { margin-right: 6px; font-size: .78em; color: var(--color-text); opacity: .7; }
  #shopify-section-{{ sid }} .nls__desc { margin: 6px 0 0; font-size: 14px; line-height: 1.6; color: var(--color-text); }
  #shopify-section-{{ sid }} .nls__card a:hover .nls__pic { transform: translateY(-5px); box-shadow: 0 0 0 1px rgba(var(--color-heading-rgb), .08), 0 18px 30px -18px rgba(0, 0, 0, .35); }
  #shopify-section-{{ sid }} .nls__card a:focus-visible { outline: none; }
  #shopify-section-{{ sid }} .nls__card a:focus-visible .nls__pic { box-shadow: 0 0 0 2px var(--color-background), 0 0 0 4px var(--nls-accent); }
  #shopify-section-{{ sid }} .nls__note { margin: 30px 0 0; font-size: 13.5px; color: var(--color-text); }
  #shopify-section-{{ sid }} .nls__empty { margin: 0; font-size: 14px; color: var(--color-text); }
  @media (min-width: 750px) {
    #shopify-section-{{ sid }} .nls__grid { grid-template-columns: repeat({{ cols | at_most: 3 }}, minmax(0, 1fr)); gap: 34px 22px; }
  }
  @media (min-width: 990px) {
    #shopify-section-{{ sid }} .nls { padding-block: {{ s.padding_top }}px {{ s.padding_bottom }}px; }
    #shopify-section-{{ sid }} .nls__head h2 { font-size: {{ s.heading_size }}px; }
    #shopify-section-{{ sid }} .nls__grid { grid-template-columns: repeat({{ cols }}, minmax(0, 1fr)); gap: 38px {% if cols > 3 %}22{% else %}26{% endif %}px; }
  }
  @media (max-width: 749px) {
    #shopify-section-{{ sid }} .nls__desc { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; font-size: 13.5px; }
    #shopify-section-{{ sid }} .nls__row { flex-direction: column; gap: 2px; }
    {%- if s.one_column_mobile -%}#shopify-section-{{ sid }} .nls__grid { grid-template-columns: minmax(0, 1fr); }{%- endif -%}
  }
  #shopify-section-{{ sid }} .nls--go .nls__card { opacity: 0; transform: translateY(22px); }
  #shopify-section-{{ sid }} .nls--go .nls__card.is-in { opacity: 1; transform: none; transition: opacity .6s ease calc(var(--i) * 70ms), transform .7s cubic-bezier(.2, .8, .2, 1) calc(var(--i) * 70ms); }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .nls__pic { transition: none; }
  }
</style>
<div class="nls color-{{ color_scheme }} gradient"{% if s.anchor != blank %} id="{{ s.anchor | handleize }}"{% endif %} data-nls>
  <div class="{{ s.section_width | default: 'container' }}">
    {%- if heading != blank or s.text != blank -%}
      <div class="nls__head">
        {%- if heading != blank -%}<h2 class="h2">{{ heading | escape }}</h2>{%- endif -%}
        {%- if s.text != blank -%}<p>{{ s.text | escape }}</p>{%- endif -%}
      </div>
    {%- endif -%}
    <ul class="nls__grid" role="list">
      {%- for p in list -%}
        {%- if shown >= limit -%}{%- break -%}{%- endif -%}
        {%- if here and p.id == here.id -%}{%- continue -%}{%- endif -%}
        {%- if cat != blank and p.type != cat -%}{%- continue -%}{%- endif -%}
        {%- liquid
          assign shown = shown | plus: 1
          assign desc = p.metafields.custom.short_description.value | default: p.metafields.custom.short_description
          if desc == blank
            assign parts = p.description | split: '</p>'
            for part in parts
              unless part contains '<strong'
                assign desc = part | strip_html | strip
                if desc != blank
                  assign first = desc | split: '. ' | first
                  if first.size < desc.size
                    assign desc = first | append: '.'
                  endif
                  break
                endif
              endunless
            endfor
          endif
          assign desc = desc | strip_html | truncatewords: s.words
        -%}
        <li class="nls__card" style="--i: {{ shown | minus: 1 | modulo: cols }}">
          <a href="{{ p.url }}">
            <span class="nls__pic">
              {%- if p.featured_image != blank -%}
                {{ p.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', sizes: '(min-width: 990px) 30vw, (min-width: 750px) 33vw, 50vw', alt: p.title }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </span>
            <span class="nls__row">
              <p class="nls__name">{{ p.title | escape }}</p>
              {%- if p.available == false -%}
                <span class="nls__price nls__price--soon">{{ s.soon_label | escape }}</span>
              {%- elsif p.price == 0 -%}
                <span class="nls__price">{{ s.free_label | escape }}</span>
              {%- else -%}
                <span class="nls__price">{%- if p.compare_at_price > p.price -%}<s>{{ p.compare_at_price | money }}</s>{%- endif -%}{{ p.price | money }}</span>
              {%- endif -%}
            </span>
            {%- if s.show_description and desc != blank -%}<p class="nls__desc">{{ desc }}</p>{%- endif -%}
          </a>
        </li>
      {%- endfor -%}
    </ul>
    {%- if shown == 0 -%}
      <p class="nls__empty">{{ s.empty_text | escape }}</p>
    {%- endif -%}
    {%- if s.note != blank -%}<p class="nls__note">{{ s.note | escape }}</p>{%- endif -%}
  </div>
</div>
{%- if s.reveal and request.design_mode != true and shown > 0 -%}
<script>
  (function () {
    var root = document.querySelector('#shopify-section-{{ sid }} [data-nls]');
    if (!root || root.dataset.nlsInit || !('IntersectionObserver' in window)) return;
    root.dataset.nlsInit = '1';
    if (window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var cards = root.querySelectorAll('.nls__card');
    {%- comment -%} Cards already on screen when the page opens stay put; only the ones below rise in. {%- endcomment -%}
    var below = [].filter.call(cards, function (c) { return c.getBoundingClientRect().top > innerHeight; });
    if (!below.length) return;
    root.classList.add('nls--go');
    [].forEach.call(cards, function (c) { if (below.indexOf(c) < 0) c.classList.add('is-in'); });
    var io = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }); }, { rootMargin: '0px 0px -8% 0px' });
    below.forEach(function (c) { io.observe(c); });
  })();
</script>
{%- endif -%}
{% schema %}
{
  "name": "Template shelf",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Study", "info": "On a product page, [category] becomes the product's category." },
    { "type": "text", "id": "heading_fallback", "label": "Heading when the product has no category", "default": "More templates" },
    { "type": "text", "id": "text", "label": "Line on the right", "default": "Ways of studying that help things stick." },
    { "type": "select", "id": "source", "label": "Products", "default": "collection", "options": [{ "value": "collection", "label": "From a collection" }, { "value": "category", "label": "Same category as the product on this page" }] },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "category", "label": "Only this category", "info": "Shows only the products filed under this category, from the collection or, with none chosen, from the whole store. Left empty, every product." },
    { "type": "range", "id": "limit", "label": "Most products", "min": 1, "max": 16, "step": 1, "default": 8 },
    { "type": "text", "id": "note", "label": "Small note under the shelf" },
    { "type": "text", "id": "anchor", "label": "Section id", "info": "Optional. Links to # and this id scroll here." },
    { "type": "text", "id": "empty_text", "label": "When there are none yet", "default": "New templates are on the way." },
    { "type": "header", "content": "Cards" },
    { "type": "select", "id": "columns", "label": "Columns on a computer", "default": "3", "options": [{ "value": "3", "label": "3" }, { "value": "4", "label": "4" }] },
    { "type": "checkbox", "id": "one_column_mobile", "label": "One column on phones", "default": false },
    { "type": "select", "id": "ratio", "label": "Picture shape", "default": "3 / 2", "options": [{ "value": "3 / 2", "label": "3:2" }, { "value": "4 / 3", "label": "4:3" }, { "value": "1 / 1", "label": "Square" }] },
    { "type": "checkbox", "id": "show_description", "label": "Show a line from the description", "default": true },
    { "type": "range", "id": "words", "label": "Words in that line", "min": 6, "max": 40, "step": 1, "default": 22 },
    { "type": "text", "id": "free_label", "label": "Price of a free product", "default": "Free" },
    { "type": "text", "id": "soon_label", "label": "Price of one that cannot be bought yet", "default": "Coming soon" },
    { "type": "range", "id": "radius", "label": "Picture corners", "min": 0, "max": 24, "step": 1, "unit": "px", "default": 8 },
    { "type": "checkbox", "id": "reveal", "label": "Cards rise in as they scroll into view", "default": true },
    { "type": "header", "content": "Look" },
    { "type": "color", "id": "accent", "label": "Price colour", "info": "Left empty, the scheme's button colour." },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 24, "max": 64, "step": 2, "unit": "px", "default": 36 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size on phones", "min": 22, "max": 44, "step": 2, "unit": "px", "default": 28 },
    { "type": "header", "content": "General" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default" },
    { "type": "select", "id": "section_width", "label": "Section width", "default": "container", "options": [{ "value": "container", "label": "Default" }, { "value": "fluid_container", "label": "Fluid container" }, { "value": "stretch_width", "label": "Stretched" }] },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top padding on phones", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom padding on phones", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 40 }
  ],
  "presets": [{ "name": "Template shelf" }]
}
{% endschema %}
