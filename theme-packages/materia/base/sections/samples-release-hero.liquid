          });
        });
        sec.addEventListener('shopify:block:select', function (e) { slides.forEach(function (sl, k) { if (sl === e.target || sl.contains(e.target)) show(k); }); });
      });
    }
    wire(document);
    document.addEventListener('shopify:section:load', function (e) { wire(e.target); });
  })();
</script>
{% schema %}
{
  "name": "Release hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "hero",
      "options": [
        { "value": "hero", "label": "Headline beside a release card" },
        { "value": "feature", "label": "One release, large" }
      ]
    },
    { "type": "header", "content": "Headline", "info": "Hero layout only." },
    { "type": "text", "id": "pill", "label": "Label above the headline" },
    { "type": "inline_richtext", "id": "heading", "label": "Headline", "default": "<em>New</em> sounds every month", "info": "Italic words take the accent colour." },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "First button", "default": "Shop packs" },
    { "type": "url", "id": "button_link", "label": "First button link" },
    { "type": "text", "id": "button_2_label", "label": "Second button" },
    { "type": "url", "id": "button_2_link", "label": "Second button link" },
    { "type": "text", "id": "note", "label": "Line under the buttons" },
    { "type": "header", "content": "Look" },
    { "type": "image_picker", "id": "background", "label": "Background picture" },
    { "type": "range", "id": "image_opacity", "label": "Background picture strength", "min": 5, "max": 100, "step": 5, "unit": "%", "default": 30 },
    { "type": "color", "id": "accent", "label": "Accent colour", "info": "Left empty, the button colour." },
    { "type": "text", "id": "free_label", "label": "Price shown for a free pack", "default": "Free" },
    { "type": "range", "id": "heading_size", "label": "Headline size", "min": 28, "max": 96, "step": 2, "unit": "px", "default": 60 },
    { "type": "range", "id": "heading_size_mobile", "label": "Headline size on phones", "min": 22, "max": 56, "step": 2, "unit": "px", "default": 40 },
    { "type": "header", "content": "General" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default" },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "container",
      "options": [
        { "value": "container", "label": "Default" },
        { "value": "fluid_container", "label": "Fluid container" },
        { "value": "stretch_width", "label": "Stretched" }
      ]
    },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 }
  ],
  "blocks": [
    {
      "type": "release",
      "name": "Release",
      "limit": 6,
      "settings": [
        { "type": "product", "id": "pack_product", "label": "Product", "info": "Its price and link fill the card. Left empty, the product with the name below." },
        { "type": "text", "id": "eyebrow", "label": "Label", "default": "New release" },
        { "type": "text", "id": "heading", "label": "Name", "info": "Left empty, the product's name." },
        { "type": "text", "id": "title", "label": "Product name", "default": "Pack name" },
        { "type": "image_picker", "id": "image", "label": "Picture", "info": "Left empty, the product's picture." },
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "richtext", "id": "list", "label": "What is inside", "info": "One release, large: a bulleted list under the text." },
        { "type": "text", "id": "button_label", "label": "Button", "default": "Get the pack" },
        { "type": "url", "id": "link", "label": "Button link", "info": "Left empty, the product's page." },
        { "type": "text", "id": "note", "label": "Line under the button" },
        { "type": "header", "content": "Preview" },
        { "type": "file_picker", "id": "audio", "label": "Audio file", "accept": ["audio"], "info": "An mp3, wav, m4a, ogg, aac or flac file, or an https link." },
        { "type": "text", "id": "track_title", "label": "Preview name", "info": "Read out to screen readers. Left empty, the pack's name." },
        { "type": "number", "id": "seconds", "label": "Length in seconds", "info": "Shown before play. Nothing downloads until play is pressed." },
        { "type": "textarea", "id": "peaks", "label": "Waveform peaks", "info": "Optional: 120 numbers from 0 to 100. Left empty, the waveform is read from the file the first time it plays." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Release hero",
      "settings": { "pill": "New", "text": "<p>Loops, one shots and presets, ready to drag into your next track.</p>" },
      "blocks": [ { "type": "release" }, { "type": "release" } ]
    },
    {
      "name": "Release, large",
      "settings": { "layout": "feature" },
      "blocks": [ { "type": "release", "settings": { "eyebrow": "The bundle" } } ]
    }
  ]
}
{% endschema %}
