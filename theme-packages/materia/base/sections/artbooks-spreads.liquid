{%- comment -%}
  Art books template: a look inside. One open spread at a time, large, with
  a caption, a link to the book and arrows to turn to the next spread. The
  spreads cross fade; with reduced motion they swap at once. Works with
  the keyboard (arrow keys when focused) and a swipe on a phone.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign color_scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
  assign count = section.blocks.size
  assign placeholder = 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 1600 1000%22%3E%3Crect width=%221600%22 height=%221000%22 fill=%22%23e9e6e0%22/%3E%3Crect x=%22200%22 y=%22120%22 width=%22600%22 height=%22760%22 fill=%22%23f6f4ef%22/%3E%3Crect x=%22800%22 y=%22120%22 width=%22600%22 height=%22760%22 fill=%22%23fbfaf7%22/%3E%3C/svg%3E'
-%}
<style>
  #shopify-section-{{ sid }} .abs {
    padding: {{ st.padding_top_mobile | default: 56 }}px 16px {{ st.padding_bottom_mobile | default: 56 }}px;
    background: var(--color-background); color: var(--color-text);
  }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .abs { padding: {{ st.padding_top | default: 96 }}px 32px {{ st.padding_bottom | default: 96 }}px; }
  }
  #shopify-section-{{ sid }} .abs__inner { max-width: {{ st.max_width | default: 1120 }}px; margin: 0 auto; }
  #shopify-section-{{ sid }} .abs__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; margin-bottom: 24px; }
  #shopify-section-{{ sid }} .abs__heading { margin: 0; color: var(--color-heading); font-weight: 400; font-size: {{ st.heading_size_mobile | default: 26 }}px; line-height: 1.15; }
  #shopify-section-{{ sid }} .abs__sub { margin: 8px 0 0; max-width: 56ch; font-size: 15px; line-height: 1.55; }
  #shopify-section-{{ sid }} .abs__sub p { margin: 0; }
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .abs__heading { font-size: {{ st.heading_size | default: 32 }}px; }
    #shopify-section-{{ sid }} .abs__head { margin-bottom: 28px; }
  }
  #shopify-section-{{ sid }} .abs__stage {
    position: relative; overflow: hidden; outline: none;
    aspect-ratio: {{ st.ratio | default: '16 / 10' }};
    background: {{ st.stage_color | default: '#ebe8e2' }};
    border-radius: {{ st.radius | default: 0 }}px;
    touch-action: pan-y;
  }
  #shopify-section-{{ sid }} .abs__stage:focus-visible { outline: 2px solid var(--color-heading); outline-offset: 4px; }
  #shopify-section-{{ sid }} .abs__slide {
    position: absolute; inset: 0; margin: 0;
    opacity: 0; visibility: hidden;
    transition: opacity 0.7s cubic-bezier(0.2, 0.7, 0.2, 1), visibility 0s linear 0.7s;
  }
  #shopify-section-{{ sid }} .abs__slide.is-active { opacity: 1; visibility: visible; transition: opacity 0.7s cubic-bezier(0.2, 0.7, 0.2, 1), visibility 0s; }
  #shopify-section-{{ sid }} .abs__slide img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; margin: 0; }
  #shopify-section-{{ sid }} .abs__bar { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 16px; margin-top: 18px; }
  #shopify-section-{{ sid }} .abs__captions { position: relative; min-height: 44px; }
  #shopify-section-{{ sid }} .abs__caption { display: none; }
  #shopify-section-{{ sid }} .abs__caption.is-active { display: block; }
  #shopify-section-{{ sid }} .abs__title { margin: 0; color: var(--color-heading); font-size: 16px; line-height: 1.4; }
  #shopify-section-{{ sid }} .abs__meta { margin: 2px 0 0; font-size: 14px; line-height: 1.5; }
  #shopify-section-{{ sid }} .abs__meta a { color: var(--color-heading); text-decoration: underline; text-underline-offset: 3px; }
  #shopify-section-{{ sid }} .abs__nav { display: flex; align-items: center; gap: 10px; }
  @media (max-width: 599.98px) {
    #shopify-section-{{ sid }} .abs__bar { grid-template-columns: 1fr; gap: 14px; }
    #shopify-section-{{ sid }} .abs__captions { min-height: 0; }
  }
  #shopify-section-{{ sid }} .abs__count { font-size: 14px; min-width: 3.5em; text-align: center; font-variant-numeric: tabular-nums; }
  #shopify-section-{{ sid }} .abs__btn {
    width: 44px; height: 44px; border-radius: 50%; display: inline-grid; place-items: center; cursor: pointer;
    border: 1px solid color-mix(in srgb, var(--color-heading) 22%, transparent); background: transparent; color: var(--color-heading);
    transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease;
  }
  #shopify-section-{{ sid }} .abs__btn svg { width: 16px; height: 16px; }
  @media (hover: hover) {
    #shopify-section-{{ sid }} .abs__btn:hover { background: var(--color-heading); color: var(--color-background); border-color: var(--color-heading); }
  }
  #shopify-section-{{ sid }} .abs__btn:focus-visible { outline: 2px solid var(--color-heading); outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .abs__slide, #shopify-section-{{ sid }} .abs__slide.is-active { transition: none; }
  }
</style>

<div class="abs color-{{ color_scheme }}" data-section-id="{{ sid }}">
  <div class="abs__inner">
    {%- if st.heading != blank or st.text != blank -%}
      <div class="abs__head">
        <div>
          {%- if st.heading != blank -%}<h2 class="abs__heading">{{ st.heading | escape }}</h2>{%- endif -%}
          {%- if st.text != blank -%}<div class="abs__sub">{{ st.text }}</div>{%- endif -%}
        </div>
      </div>
    {%- endif -%}
    <div class="abs__stage" id="AbsStage-{{ sid }}" tabindex="0" role="group" aria-roledescription="carousel" aria-label="{{ st.heading | default: 'Pages from the books' | escape }}">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <figure class="abs__slide{% if forloop.first %} is-active{% endif %}" data-index="{{ forloop.index0 }}" aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}" {{ block.shopify_attributes }}>
          {%- if b.image != blank -%}
            <img
              src="{{ b.image | image_url: width: 1800 }}"
              srcset="{{ b.image | image_url: width: 800 }} 800w, {{ b.image | image_url: width: 1200 }} 1200w, {{ b.image | image_url: width: 1800 }} 1800w"
              sizes="(min-width: 1200px) 1120px, 100vw"
              width="{{ b.image.width | default: 1800 }}"
              height="{{ b.image.height | default: 1125 }}"
              alt="{{ b.alt | default: b.image.alt | escape }}"
              loading="lazy" decoding="async">
          {%- else -%}
            <img src="{{ placeholder }}" width="1600" height="1000" alt="" loading="lazy">
          {%- endif -%}
        </figure>
      {%- endfor -%}
    </div>
    <div class="abs__bar">
      <div class="abs__captions" aria-live="polite">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          <div class="abs__caption{% if forloop.first %} is-active{% endif %}">
            {%- if b.title != blank -%}<p class="abs__title">{{ b.title | escape }}</p>{%- endif -%}
            {%- if b.caption != blank or b.link != blank -%}
              <p class="abs__meta">{{ b.caption | escape }}{% if b.link != blank and b.link_label != blank %}{% if b.caption != blank %} · {% endif %}<a href="{{ b.link }}">{{ b.link_label | escape }}</a>{% endif %}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
      {%- if count > 1 -%}
        <div class="abs__nav">
          <button type="button" class="abs__btn" data-dir="-1" aria-label="{{ st.previous_label | default: 'Previous spread' | escape }}" aria-controls="AbsStage-{{ sid }}"><svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M14 8H3M7 4L3 8l4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
          <span class="abs__count"><span data-current>1</span> / {{ count }}</span>
          <button type="button" class="abs__btn" data-dir="1" aria-label="{{ st.next_label | default: 'Next spread' | escape }}" aria-controls="AbsStage-{{ sid }}"><svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.querySelector('#shopify-section-{{ sid }} .abs');
    if (!root || root.__abs) return;
    root.__abs = true;
    var slides = root.querySelectorAll('.abs__slide');
    var caps = root.querySelectorAll('.abs__caption');
    var current = root.querySelector('[data-current]');
    var stage = root.querySelector('.abs__stage');
    var n = slides.length, at = 0;
    if (n < 2) return;
    function go(i) {
      at = (i + n) % n;
      for (var k = 0; k < n; k++) {
        slides[k].classList.toggle('is-active', k === at);
        slides[k].setAttribute('aria-hidden', k === at ? 'false' : 'true');
        if (caps[k]) caps[k].classList.toggle('is-active', k === at);
      }
      if (current) current.textContent = String(at + 1);
      var next = slides[(at + 1) % n].querySelector('img');
      if (next && next.loading === 'lazy') next.loading = 'eager';
    }
    root.querySelectorAll('.abs__btn').forEach(function (b) {
      b.addEventListener('click', function () { go(at + Number(b.getAttribute('data-dir'))); });
    });
    stage.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowRight') { e.preventDefault(); go(at + 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); go(at - 1); }
    });
    var x0 = null;
    stage.addEventListener('touchstart', function (e) { x0 = e.touches[0].clientX; }, { passive: true });
    stage.addEventListener('touchend', function (e) {
      if (x0 === null) return;
      var dx = e.changedTouches[0].clientX - x0; x0 = null;
      if (Math.abs(dx) > 40) go(at + (dx < 0 ? 1 : -1));
    }, { passive: true });
  })();
</script>

{% schema %}
{
  "name": "Look inside",
  "tag": "section",
  "class": "section sec__artbooks-spreads",
  "max_blocks": 8,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default-color-scheme" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A look inside" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "select", "id": "ratio", "label": "Picture shape", "options": [ { "value": "16 / 10", "label": "Wide" }, { "value": "16 / 9", "label": "Wider" }, { "value": "4 / 3", "label": "Standard" } ], "default": "16 / 10" },
    { "type": "color", "id": "stage_color", "label": "Background behind the pictures", "default": "#ebe8e2" },
    { "type": "range", "id": "radius", "label": "Corner radius", "min": 0, "max": 24, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "max_width", "label": "Maximum width", "min": 800, "max": 1600, "step": 20, "unit": "px", "default": 1120 },
    { "type": "range", "id": "heading_size", "label": "Heading size, desktop", "min": 18, "max": 56, "step": 1, "unit": "px", "default": 32 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size, phone", "min": 18, "max": 40, "step": 1, "unit": "px", "default": 26 },
    { "type": "text", "id": "previous_label", "label": "Previous button label", "default": "Previous spread" },
    { "type": "text", "id": "next_label", "label": "Next button label", "default": "Next spread" },
    { "type": "range", "id": "padding_top", "label": "Space above, desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Space below, desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_top_mobile", "label": "Space above, phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Space below, phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    {
      "type": "spread",
      "name": "Spread",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Picture of the open pages" },
        { "type": "text", "id": "alt", "label": "Alt text" },
        { "type": "text", "id": "title", "label": "Title", "default": "Book title" },
        { "type": "text", "id": "caption", "label": "Caption", "default": "Pages 12 and 13" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "See the book" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Look inside",
      "blocks": [ { "type": "spread" }, { "type": "spread" } ]
    }
  ]
}
{% endschema %}
