</defs></svg>
<div class="xp-wall" aria-hidden="true">
  {%- if st.wallpaper != blank -%}
    <img src="{{ st.wallpaper | image_url: width: 1600 }}" srcset="{{ st.wallpaper | image_url: width: 900 }} 900w, {{ st.wallpaper | image_url: width: 1400 }} 1400w, {{ st.wallpaper | image_url: width: 2000 }} 2000w" sizes="100vw" alt="" width="2000" height="1330" fetchpriority="high" decoding="async">
  {%- endif -%}
</div>
<div class="xp-top-space" aria-hidden="true"></div>
<header data-own-font class="xp xp-top" data-xp-top>
  <div class="xp-top__glass" aria-hidden="true"></div>
  <div class="xp-top__in">
    <a class="xp-brand" href="{{ routes.root_url }}">
      {%- if st.logo != blank -%}{{ st.logo | image_url: width: 300 | image_tag: alt: shop.name, height: 34, loading: 'eager' }}{%- else -%}{{ mark }}<span>{{ shop.name | escape }}</span>{%- endif -%}
    </a>
    {%- if menu != blank -%}
      <nav aria-label="{{ st.top_label | default: 'Main menu' | escape }}"><ul class="xp-nav" role="list">{%- for link in menu.links -%}<li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a></li>{%- endfor -%}</ul></nav>
    {%- endif -%}
    <div class="xp-top__right">
      <form class="xp-search" action="{{ routes.search_url }}" method="get" role="search">
        <label class="visually-hidden" for="XpSearch-{{ sid }}">{{ st.search_label | default: 'Search' | escape }}</label>
        <input id="XpSearch-{{ sid }}" type="search" name="q" placeholder="{{ st.search_placeholder | default: 'Search the shop' | escape }}" autocomplete="off">
        <button type="submit" aria-label="{{ st.search_label | default: 'Search' | escape }}"><svg class="xp-ico" width="24" height="24" aria-hidden="true" focusable="false"><use href="#xpi-search-{{ sid }}"/></svg></button>
      </form>
      <a class="xp-iconlink xp-top__phone" href="{{ routes.search_url }}" aria-label="{{ st.search_label | default: 'Search' | escape }}"><svg class="xp-ico" width="24" height="24" aria-hidden="true" focusable="false"><use href="#xpi-search-{{ sid }}"/></svg></a>
      {%- if shop.customer_accounts_enabled -%}<a class="xp-iconlink xp-acc" href="{{ routes.account_url }}" aria-label="{{ st.account_label | default: 'Account' | escape }}"><svg class="xp-ico" width="24" height="24" aria-hidden="true" focusable="false"><use href="#xpi-user-{{ sid }}"/></svg></a>{%- endif -%}
      <a class="xp-btn xp-btn--blue" href="{{ routes.cart_url }}"><svg class="xp-ico" width="24" height="24" aria-hidden="true" focusable="false"><use href="#xpi-cart-{{ sid }}"/></svg><span>{{ st.cart_label | default: 'Cart' | escape }}</span><span class="xp-count" data-xp-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span></a>
      <a class="xp-iconlink xp-top__phone" href="{{ routes.cart_url }}" aria-label="{{ st.cart_label | default: 'Cart' | escape }}"><svg class="xp-ico" width="24" height="24" aria-hidden="true" focusable="false"><use href="#xpi-cart-{{ sid }}"/></svg><span class="xp-count" data-xp-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span></a>
    </div>
  </div>
</header>
{%- if section.blocks.size > 0 -%}
  <ul data-own-font class="xp xp-icons{% unless show_icons %} xp-icons--off{% endunless %}" role="list">
    {%- for block in section.blocks -%}
      <li {{ block.shopify_attributes }}><a class="xp-icon" href="{{ block.settings.link | default: '/' }}"><svg class="xp-ico" aria-hidden="true" focusable="false"><use href="#xpi-{{ block.settings.icon | default: 'folder' }}-{{ sid }}"/></svg><span>{{ block.settings.label | escape }}</span></a></li>
    {%- endfor -%}
  </ul>
{%- endif -%}
<nav data-own-font class="xp xp-task" aria-label="{{ st.taskbar_label | default: 'Taskbar' | escape }}" data-xp-task>
  <div class="xp-menu" id="XpMenu-{{ sid }}" hidden data-xp-menu>
    <div class="xp-menu__head"><span class="xp-menu__tile">{%- if st.menu_picture != blank -%}{{ st.menu_picture | image_url: width: 120 | image_tag: alt: '', loading: 'lazy' }}{%- else -%}{{ mark }}{%- endif -%}</span><span>{{ st.menu_title | default: shop.name | escape }}</span></div>
    <div class="xp-menu__cols">
      <ul class="xp-menu__col xp-menu__col--l" role="list">
        <li><a href="{{ routes.root_url }}"><svg class="xp-ico" width="30" height="30" aria-hidden="true" focusable="false"><use href="#xpi-home-{{ sid }}"/></svg><span>{{ st.home_label | default: 'Home' | escape }}</span></a></li>
        {%- if menu != blank -%}{%- for link in menu.links -%}
          {%- assign u = link.url | downcase -%}
          {%- assign ic = 'folder' -%}
          {%- if u contains 'about' -%}{%- assign ic = 'note' -%}{%- elsif u contains 'faq' or u contains 'help' -%}{%- assign ic = 'help' -%}{%- elsif u contains 'blog' -%}{%- assign ic = 'note' -%}{%- elsif u contains 'contact' -%}{%- assign ic = 'mail' -%}{%- elsif u contains 'tee' or u contains 'shirt' -%}{%- assign ic = 'tee' -%}{%- elsif u contains 'cap' or u contains 'hat' -%}{%- assign ic = 'cap' -%}{%- endif -%}
          <li><a href="{{ link.url }}"><svg class="xp-ico" width="30" height="30" aria-hidden="true" focusable="false"><use href="#xpi-{{ ic }}-{{ sid }}"/></svg><span>{{ link.title | escape }}</span></a></li>
        {%- endfor -%}{%- endif -%}
      </ul>
      <ul class="xp-menu__col xp-menu__col--r" role="list">
        {%- if menu2 != blank -%}{%- for link in menu2.links -%}
          {%- assign u = link.url | downcase -%}
          {%- assign ic = 'note' -%}
          {%- if u contains 'faq' or u contains 'help' -%}{%- assign ic = 'help' -%}{%- elsif u contains 'contact' -%}{%- assign ic = 'mail' -%}{%- elsif u contains 'ship' or u contains 'deliver' -%}{%- assign ic = 'truck' -%}{%- elsif u contains 'refund' or u contains 'return' -%}{%- assign ic = 'refresh' -%}{%- elsif u contains 'privacy' or u contains 'terms' -%}{%- assign ic = 'shield' -%}{%- endif -%}
          <li><a href="{{ link.url }}"><svg class="xp-ico" width="24" height="24" aria-hidden="true" focusable="false"><use href="#xpi-{{ ic }}-{{ sid }}"/></svg><span>{{ link.title | escape }}</span></a></li>
        {%- endfor -%}<li class="xp-menu__rule" aria-hidden="true"></li>{%- endif -%}
        <li><a href="{{ routes.search_url }}"><svg class="xp-ico" width="24" height="24" aria-hidden="true" focusable="false"><use href="#xpi-search-{{ sid }}"/></svg><span>{{ st.search_label | default: 'Search' | escape }}</span></a></li>
        {%- if shop.customer_accounts_enabled -%}<li><a href="{{ routes.account_url }}"><svg class="xp-ico" width="24" height="24" aria-hidden="true" focusable="false"><use href="#xpi-user-{{ sid }}"/></svg><span>{{ st.account_label | default: 'Account' | escape }}</span></a></li>{%- endif -%}
      </ul>
    </div>
    <div class="xp-menu__foot">
      <a href="{{ routes.cart_url }}"><svg class="xp-ico" width="24" height="24" aria-hidden="true" focusable="false"><use href="#xpi-cart-{{ sid }}"/></svg><span>{{ st.cart_label | default: 'Cart' | escape }}</span></a>
    </div>
  </div>
  <div class="xp-task__in">
    <button class="xp-start" type="button" aria-expanded="false" aria-controls="XpMenu-{{ sid }}" data-xp-start>{{ mark }}<span>{{ start | escape }}</span></button>
    <div class="xp-task__wins" data-xp-wins>
      <span class="xp-tw is-current" aria-current="page"><svg class="xp-ico" width="24" height="24" aria-hidden="true" focusable="false"><use href="#xpi-folder-{{ sid }}"/></svg><span>{{ xp_title }}</span></span>
    </div>
    <div class="xp-tray">
      <a class="xp-tray__search" href="{{ routes.search_url }}" aria-label="{{ st.search_label | default: 'Search' | escape }}"><svg class="xp-ico" width="24" height="24" aria-hidden="true" focusable="false"><use href="#xpi-search-{{ sid }}"/></svg></a>
      {%- if shop.customer_accounts_enabled -%}<a class="xp-acc" href="{{ routes.account_url }}" aria-label="{{ st.account_label | default: 'Account' | escape }}"><svg class="xp-ico" width="24" height="24" aria-hidden="true" focusable="false"><use href="#xpi-user-{{ sid }}"/></svg></a>{%- endif -%}
      <a href="{{ routes.cart_url }}" aria-label="{{ st.cart_label | default: 'Cart' | escape }}"><svg class="xp-ico" width="24" height="24" aria-hidden="true" focusable="false"><use href="#xpi-cart-{{ sid }}"/></svg><span class="xp-count" data-xp-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span></a>
      <span class="xp-clock" data-xp-clock aria-hidden="true"></span>
    </div>
  </div>
</nav>
{%- if st.balloon_title != blank and request.page_type == 'index' and request.design_mode != true -%}
  <div data-own-font class="xp xp-balloon" role="status" hidden data-xp-balloon>
    <button class="xp-balloon__x" type="button" aria-label="{{ st.close_label | default: 'Close' | escape }}" data-xp-balloon-x><svg viewBox="0 0 10 10" aria-hidden="true" focusable="false"><path d="m1 1 8 8M9 1 1 9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></button>
    <p class="xp-balloon__head"><svg class="xp-ico" width="24" height="24" aria-hidden="true" focusable="false"><use href="#xpi-info-{{ sid }}"/></svg><span>{{ st.balloon_title | escape }}</span></p>
    {%- if st.balloon_text != blank -%}<p>{{ st.balloon_text | escape }}{% if st.balloon_link_label != blank %} <a href="{{ st.balloon_link | default: '/collections/all' }}">{{ st.balloon_link_label | escape }}</a>{% endif %}</p>{%- endif -%}
  </div>
{%- endif -%}

<script>
  (function () {
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;
    var task = root.querySelector('[data-xp-task]'), wall = root.querySelector('.xp-wall'), balloon = root.querySelector('[data-xp-balloon]');
    /* The taskbar and the wallpaper live at the page's own level, outside the header's layer. */
    [[task, 'append'], [wall, 'prepend'], [balloon, 'append']].forEach(function (p) {
      var el = p[0]; if (!el || el.parentNode === document.body) return;
      document.querySelectorAll('body > .' + el.classList[el.classList.length - 1]).forEach(function (old) { if (old !== el) old.remove(); });
      document.body[p[1]](el);
    });
    if (!task) return;
    var start = task.querySelector('[data-xp-start]'), menu = task.querySelector('[data-xp-menu]');
    var still = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
    function open(on) {
      start.setAttribute('aria-expanded', on ? 'true' : 'false');
      if (on) { menu.hidden = false; if (!still) { menu.classList.add('is-opening'); requestAnimationFrame(function () { requestAnimationFrame(function () { menu.classList.remove('is-opening'); }); }); } var f = menu.querySelector('a'); if (f) f.focus({ preventScroll: true }); }
      else menu.hidden = true;
    }
    start.addEventListener('click', function (e) { e.stopPropagation(); open(menu.hidden); });
    document.addEventListener('click', function (e) { if (!menu.hidden && !menu.contains(e.target)) open(false); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !menu.hidden) { open(false); start.focus(); } });
    var clock = task.querySelector('[data-xp-clock]');
    function tick() { if (clock) clock.textContent = new Date().toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' }); }
    tick(); clearInterval(window.__xpClock); window.__xpClock = setInterval(tick, 15000);
    function recount() { fetch('/cart.js', { headers: { Accept: 'application/json' } }).then(function (r) { return r.json(); }).then(function (c) { document.querySelectorAll('[data-xp-count]').forEach(function (n) { n.textContent = c.item_count; n.hidden = !c.item_count; }); }).catch(function () {}); }
    document.addEventListener('xp:cart', recount); document.addEventListener('cart:refresh', recount);
    /* A window minimised or closed waits on the taskbar, as a button that brings it back. */
    var wins = task.querySelector('[data-xp-wins]');
    window.__xpPark = function (win) {
      var title = (win.querySelector('.xp-bar__title') || {}).textContent || 'Window';
      var b = document.createElement('button'); b.type = 'button'; b.className = 'xp-tw';
      b.innerHTML = '<span></span>'; b.firstChild.textContent = title.trim();
      b.addEventListener('click', function () { win.hidden = false; win.classList.remove('is-min'); b.remove(); win.scrollIntoView({ block: 'nearest', behavior: still ? 'auto' : 'smooth' }); });
      wins.appendChild(b);
    };
    if (balloon) {
      var seen = false; try { seen = sessionStorage.getItem('xp-balloon') === '1'; } catch (e) {}
      if (!seen) {
        var hide = function () { balloon.classList.add('is-hiding'); setTimeout(function () { balloon.hidden = true; }, still ? 0 : 300); try { sessionStorage.setItem('xp-balloon', '1'); } catch (e) {} };
        setTimeout(function () { balloon.hidden = false; if (!still) { balloon.classList.add('is-hiding'); requestAnimationFrame(function () { requestAnimationFrame(function () { balloon.classList.remove('is-hiding'); }); }); } }, 1800);
        balloon.querySelector('[data-xp-balloon-x]').addEventListener('click', hide);
        var a = balloon.querySelector('a'); if (a) a.addEventListener('click', function () { try { sessionStorage.setItem('xp-balloon', '1'); } catch (e) {} });
        setTimeout(function () { if (!balloon.hidden) hide(); }, 14000);
      }
    }
  })();
</script>

{% schema %}
{
  "name": "XP desktop and taskbar",
  "tag": "section",
  "class": "xpshop-desktop-section",
