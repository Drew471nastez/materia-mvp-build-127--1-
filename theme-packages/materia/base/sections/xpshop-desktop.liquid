{%- comment -%}
XP shop: the desktop the whole website sits on. Placed in the header group,
  so every page has it:

  the wallpaper, a photograph fixed behind the page;

  a light bar along the top with the shop's name, the main menu, search,
  account and the cart, so the way round is always plain;

  the taskbar along the bottom: the shop's own green button (it opens a
  menu with both menus, search, account and the cart), the page you are on,
  and a tray with the cart, its count and a clock;

  desktop icons (blocks) down the left of a wide screen on the home page;

  a notification balloon from the tray, once a visit, when it has words;

  and, with "Draw the theme's sections as windows", the theme's own
  sections (product, cart, search, collection, blog, pages) in a window
  with a blue title bar that names the page.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign menu = st.menu
  assign menu2 = st.menu_2
  assign show_icons = true
  if st.icons_home_only and request.page_type != 'index'
    assign show_icons = false
  endif
  assign start = st.start_label | default: shop.name
-%}
{%- capture xp_title -%}
  {%- case request.page_type -%}
    {%- when 'index' -%}{{ st.home_title | default: shop.name }}
    {%- when 'product' -%}{{ product.title }}
    {%- when 'collection' -%}{{ collection.title | default: 'Shop' }}
    {%- when 'list-collections' -%}{{ st.collections_title | default: 'Collections' }}
    {%- when 'cart' -%}{{ st.cart_label | default: 'Cart' }}
    {%- when 'search' -%}{{ st.search_label | default: 'Search' }}
    {%- when 'page' -%}{{ page.title }}
    {%- when 'blog' -%}{{ blog.title | default: 'Journal' }}
    {%- when 'article' -%}{{ article.title }}
    {%- when '404' -%}{{ st.missing_title | default: 'Not found' }}
    {%- else -%}{{ page_title | default: shop.name }}
  {%- endcase -%}
{%- endcapture -%}
{%- assign xp_title = xp_title | strip | strip_newlines | replace: '\', '' | replace: '"', "'" | replace: '<', '' | replace: '>', '' -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,800;1,900&display=swap" data-xp-font>
<style>
  .xp { --xp-ink: #14213d; --xp-muted: #4a5568; --xp-navy: #0f2f75; --xp-blue: #1f5fd8; --xp-link: #1a55c9; --xp-face: #f4f2ea; --xp-line: #c9c3b0; --xp-pane: #d9e4f8;
    --xp-font: 'Nunito', Tahoma, 'Trebuchet MS', system-ui, sans-serif;
    color: var(--xp-ink); font-family: var(--xp-font); font-size: 15px; line-height: 1.55; -webkit-font-smoothing: antialiased; }
  .xp *, .xp *::before, .xp *::after { box-sizing: border-box; }
  .xp :where(h1, h2, h3, h4, p, ul, ol, figure) { margin: 0; }
  .xp .xp-ico { width: 24px; height: 24px; flex: none; display: block; }
  /* A window: a blue frame, a glossy title bar with rounded top corners, and a white inside. */
  .xp-win { position: relative; display: flex; flex-direction: column; min-width: 0; background: var(--xp-blue); padding: 0 3px 3px; border-radius: 10px 10px 6px 6px;
    box-shadow: 0 1px 0 rgba(255,255,255,.35) inset, 0 22px 48px -12px rgba(8, 28, 80, .45), 0 3px 10px rgba(8, 28, 80, .18); }
  .xp-bar { display: flex; align-items: center; gap: 8px; min-height: 34px; margin: 0 -3px; padding: 4px 6px 4px 10px; border-radius: 9px 9px 0 0; color: #fff;
    background: linear-gradient(180deg, #5da0fa 0%, #2f74ea 10%, #2263df 30%, #1d5ad6 60%, #1c57d0 86%, #1748b4 100%);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.5), inset 0 -1px 0 rgba(0,20,90,.35); user-select: none; -webkit-user-select: none; }
  .xp-bar .xp-ico { width: 20px; height: 20px; filter: drop-shadow(0 1px 0 rgba(0,0,40,.3)); }
  .xp-bar__title { flex: 1; min-width: 0; margin: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font: 700 15px/1.2 var(--xp-font); letter-spacing: .01em; color: #fff; text-shadow: 1px 1px 0 rgba(0, 18, 80, .45); }
  .xp-ctls { display: flex; gap: 3px; flex: none; }
  .xp-ctl { display: grid; place-items: center; width: 24px; height: 24px; margin: 0; padding: 0; border: 1px solid #fff; border-radius: 4px; color: #fff; cursor: pointer;
    background: linear-gradient(180deg, #78aef8 0%, #3c7ff0 45%, #2563da 55%, #3a7bea 100%); box-shadow: inset 0 0 0 1px rgba(0,30,120,.18), 0 1px 1px rgba(0,0,40,.25); }
  .xp-ctl svg { width: 11px; height: 11px; }
  .xp-ctl--close { background: linear-gradient(180deg, #f3a184 0%, #e5683f 40%, #d24a1f 60%, #e0653b 100%); }
  .xp-ctl:hover { filter: brightness(1.1); }
  .xp-ctl:active { filter: brightness(.92); }
  .xp-ctl:focus-visible, .xp-btn:focus-visible, .xp a:focus-visible { outline: 2px solid #f5a623; outline-offset: 2px; }
  .xp-body { position: relative; flex: 1; min-width: 0; background: #fff; border-radius: 0 0 4px 4px; overflow: hidden; }
  .xp-menubar { display: flex; gap: 2px; padding: 3px 8px; background: var(--xp-face); border-bottom: 1px solid #e2ddcb; font-size: 13.5px; color: #222; }
  .xp-menubar span { padding: 2px 8px; border-radius: 3px; }
  .xp-status { display: flex; gap: 4px; padding: 4px 6px; background: var(--xp-face); border-top: 1px solid #e2ddcb; font-size: 12.5px; color: #333; }
  .xp-status span { flex: 1; min-width: 0; padding: 2px 8px; border-left: 1px solid #fff; box-shadow: -1px 0 0 #d6d0bd; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .xp-status span:first-child { border: 0; box-shadow: none; }
  /* Buttons: the soft grey XP button, a green one like the brand's start button, and a blue one. */
  .xp-btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 42px; margin: 0; padding: 0 20px; border: 1px solid #1f3f7a; border-radius: 5px; cursor: pointer;
    background: linear-gradient(180deg, #ffffff 0%, #f6f5f0 45%, #ebe8dd 90%, #dcd7c7 100%); color: #14213d; font: 700 15px/1 var(--xp-font); text-decoration: none; white-space: nowrap;
    box-shadow: 0 1px 2px rgba(10,30,80,.12); transition: box-shadow .15s, filter .15s, transform .15s; }
  .xp-btn:hover { box-shadow: inset 0 2px 0 #ffe3a3, inset 0 -2px 0 #f5a623, inset 2px 0 0 #fbd27f, inset -2px 0 0 #fbd27f, 0 1px 2px rgba(10,30,80,.12); color: #14213d; }
  .xp-btn:active { transform: translateY(1px); filter: brightness(.97); }
  .xp-btn[disabled] { opacity: .55; cursor: default; box-shadow: none; }
  .xp-btn--go { border-color: #1d6a1d; color: #fff; text-shadow: 0 1px 0 rgba(0,50,0,.45);
    background: linear-gradient(180deg, #7ad36c 0%, #45b041 42%, #2f962f 58%, #3aa73a 100%); box-shadow: inset 0 1px 0 rgba(255,255,255,.45), 0 2px 6px rgba(20,90,20,.25); }
  .xp-btn--go:hover { color: #fff; filter: brightness(1.06); box-shadow: inset 0 1px 0 rgba(255,255,255,.5), 0 3px 10px rgba(20,90,20,.3); }
  .xp-btn--blue { border-color: #143f9a; color: #fff; text-shadow: 0 1px 0 rgba(0,20,80,.45);
    background: linear-gradient(180deg, #7fb2fa 0%, #3f80ee 42%, #2563da 58%, #3474e6 100%); box-shadow: inset 0 1px 0 rgba(255,255,255,.45), 0 2px 6px rgba(20,50,140,.25); }
  .xp-btn--blue:hover { color: #fff; filter: brightness(1.06); box-shadow: inset 0 1px 0 rgba(255,255,255,.5), 0 3px 10px rgba(20,50,140,.3); }
  .xp-btn .xp-ico { width: 20px; height: 20px; }
  .xp input.xp-field, .xp-field { --input-bg: #fff; --input-border-color: #7f9db9; --input-border-radius: 3px; --input-padding: 0 12px; --field-text: #14213d; --input-height: 44px; width: 100%; height: 42px; padding: 0 12px; border: 1px solid #7f9db9 !important; border-radius: 3px !important; background: #fff !important; color: #14213d !important; font: 500 15px var(--xp-font); }
  .xp input.xp-field:focus, .xp-field:focus { outline: none; border-color: #316ac5; box-shadow: 0 0 0 3px rgba(49,106,197,.2); }
  .xp-h { margin: 0; color: var(--xp-navy); font-family: var(--xp-font); font-weight: 800; line-height: 1.12; letter-spacing: -.01em; }
  .xp-eyebrow { display: inline-flex; align-items: center; gap: 8px; margin: 0 0 12px; color: #2c7a22; font-size: 13px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; }
  .xp-rte { color: #2d3748; font-size: 16px; line-height: 1.65; }
  .xp-rte p + p { margin-top: .8em; }
  .xp-rte a { color: var(--xp-link); }
  .xp-place { width: 100%; max-width: var(--xp-col, 1180px); margin: 0 auto; }
  .xp-sec { padding: var(--xp-pt-m, 0) 10px var(--xp-pb-m, 16px); }
  @media (min-width: 750px) { .xp-sec { padding: var(--xp-pt, 0) 24px var(--xp-pb, 28px); } }
  html.xp-js .xp [data-motion] { opacity: 0; transform: translate3d(0, 18px, 0) scale(.985); transition: opacity .6s cubic-bezier(.2,.7,.2,1), transform .6s cubic-bezier(.2,.7,.2,1); transition-delay: var(--d, 0ms); }
  html.xp-js .xp [data-motion].is-in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { html.xp-js .xp [data-motion] { opacity: 1; transform: none; transition: none; } .xp-btn { transition: none; } }
  @media (max-width: 749px) {
    .xp-win { border-radius: 9px 9px 5px 5px; padding: 0 2px 2px; }
    .xp-bar { margin: 0 -2px; min-height: 32px; }
    .xp-bar__title { font-size: 14px; }
    .xp-ctls .xp-ctl--opt { display: none; }
  }
  .xp-win.is-min > .xp-body, .xp-win.is-min > .xp-hide-min { display: none; }
  .xp-win.is-min { padding-bottom: 0; border-radius: 10px 10px 9px 9px; }
  .xp-win.is-min .xp-bar { border-radius: 9px; }
  .xp-win[data-xp-window] { transition: opacity .2s, transform .2s; }
  .xp-win.is-closing { opacity: 0; transform: scale(.97); }
  .xp-place.is-max, .xp-win.is-max { max-width: none; }
  @media (min-width: 750px) { .xp-win.is-max { margin-left: calc(-1 * max(0px, (100vw - var(--xp-col, 1180px)) / 2 - 24px)); margin-right: calc(-1 * max(0px, (100vw - var(--xp-col, 1180px)) / 2 - 24px)); } }

  html { background: #6fa3e3{% if st.wallpaper != blank %} url("{{ st.wallpaper | image_url: width: 2000 }}") {{ st.focal | default: '50% 70%' }} / cover no-repeat fixed{% endif %} !important; scroll-behavior: auto; }
  body { background: transparent !important; padding-bottom: calc(52px + env(safe-area-inset-bottom, 0px)); }
  #shopify-section-{{ sid }} { position: static !important; margin: 0 !important; padding: 0 !important; }
  .xp-wall { position: fixed; inset: 0; z-index: -1; pointer-events: none; overflow: hidden; background: linear-gradient(180deg, #4d8ee0 0%, #8fbdf0 58%, #6aa646 58.2%, #4b8a2c 100%); }
  .xp-wall img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: {{ st.focal | default: '50% 70%' }}; }
  .xp-wall::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(255,255,255,0) 60%, rgba(10,40,10,{{ st.wall_shade | default: 0 | divided_by: 100.0 }}) 100%); }

  /* The bar along the top. */
  .xp-top { position: fixed; left: 0; right: 0; top: 0; z-index: 59; font-family: var(--xp-font); }
  .xp-top-space { height: 58px; }
  @media (max-width: 749px) { .xp-top-space { height: 54px; } }
  .xp-top__in { display: flex; align-items: center; gap: 18px; height: 58px; padding: 0 24px; max-width: calc(var(--xp-col, 1180px) + 48px); margin: 0 auto; }
  .xp-top__glass { position: absolute; inset: 0; z-index: -1; background: rgba(255,255,255,.82); -webkit-backdrop-filter: blur(14px) saturate(1.3); backdrop-filter: blur(14px) saturate(1.3); box-shadow: 0 1px 0 rgba(255,255,255,.7) inset, 0 6px 20px -10px rgba(8,28,80,.35); border-bottom: 1px solid rgba(31,95,216,.18); }
  .xp-brand { display: inline-flex; align-items: center; gap: 10px; color: var(--xp-navy); font-weight: 900; font-size: 19px; letter-spacing: -.01em; text-decoration: none; white-space: nowrap; }
  .xp-brand img { display: block; height: 34px; width: auto; }
  .xp-mark { width: 30px; height: 30px; flex: none; border-radius: 50%; box-shadow: 0 1px 2px rgba(0,30,80,.3); }
  .xp-nav { display: flex; align-items: center; gap: 2px; min-width: 0; margin: 0; padding: 0; list-style: none; }
  .xp-nav a { display: inline-flex; align-items: center; height: 36px; padding: 0 12px; border-radius: 6px; color: #1d2b4f; font-size: 15px; font-weight: 700; text-decoration: none; white-space: nowrap; transition: background-color .15s, color .15s; }
  .xp-nav a:hover { background: rgba(31,95,216,.1); color: var(--xp-blue); }
  .xp-nav a[aria-current] { background: rgba(31,95,216,.12); color: var(--xp-blue); }
  .xp-top__right { display: flex; align-items: center; gap: 8px; margin-left: auto; }
  .xp-search { position: relative; display: flex; align-items: center; width: 230px; }
  .xp-search input { --input-bg: #fff; --input-border-color: #7f9db9; --input-border-radius: 22px; --input-padding: 0 42px 0 16px; --field-text: #14213d; --input-height: 42px; --mt-field-font-size: 14px; width: 100%; height: 42px; padding: 0 40px 0 14px; border: 1px solid #7f9db9; border-radius: 19px; background: #fff; color: #14213d; font: 500 14px var(--xp-font); }
  .xp-search input:focus { outline: none; border-color: #316ac5; box-shadow: 0 0 0 3px rgba(49,106,197,.22); }
  .xp-search button { min-height: 0 !important; position: absolute; right: 6px; top: 50%; margin-top: -16px; display: grid; place-items: center; width: 30px; height: 30px; padding: 0; border: 0; border-radius: 50%; background: transparent; cursor: pointer; }
  .xp-search .xp-ico { width: 20px; height: 20px; }
  .xp-iconlink { position: relative; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 8px; color: #14213d; }
  .xp-iconlink:hover { background: rgba(31,95,216,.1); }
  .xp-iconlink .xp-ico { width: 24px; height: 24px; }
  .xp-top .xp-btn { min-height: 40px; padding: 0 16px; }
  .xp-count { display: inline-grid; place-items: center; min-width: 20px; height: 20px; padding: 0 6px; border-radius: 10px; background: #e5532a; color: #fff; font: 800 12px/1 var(--xp-font); box-shadow: 0 0 0 2px #fff; }
  .xp-count[hidden] { display: none !important; }
  .xp-iconlink .xp-count { position: absolute; top: 0; right: -2px; }
  .xp-top__phone { display: none; }
  @media (max-width: 989px) { .xp-nav a { padding: 0 9px; font-size: 14px; } .xp-search { width: 170px; } }
  @media (max-width: 749px) {
    .xp-top__in { height: 54px; padding: 0 8px 0 14px; gap: 6px; }
    .xp-nav, .xp-search, .xp-top .xp-btn, .xp-top .xp-acc { display: none; }
    .xp-top__phone { display: grid; }
    .xp-brand { font-size: 18px; }
  }

  /* Desktop icons, on the home page of a wide screen. */
  .xp-icons { display: none; }
  .xp-icons.xp-icons--off { display: none !important; }
  @media (min-width: 1480px) {
    .xp-icons { position: absolute; left: 18px; top: 84px; z-index: 2; display: flex; flex-direction: column; gap: 12px; margin: 0; padding: 0; list-style: none; }
    .xp-icon { display: flex; flex-direction: column; align-items: center; gap: 6px; width: 92px; padding: 6px 4px; border-radius: 4px; color: #fff; text-decoration: none; text-align: center; }
    .xp-icon .xp-ico { width: 44px; height: 44px; filter: drop-shadow(0 2px 3px rgba(0,0,0,.35)); transition: transform .2s; }
    .xp-icon span { padding: 1px 4px; border-radius: 2px; font-size: 13.5px; font-weight: 700; line-height: 1.25; text-shadow: 0 1px 2px rgba(0,0,0,.75), 0 0 8px rgba(0,0,0,.35); }
    .xp-icon:hover .xp-ico, .xp-icon:focus-visible .xp-ico { transform: translateY(-2px); }
    .xp-icon:hover span, .xp-icon:focus-visible span { background: #316ac5; text-shadow: none; }
  }

  /* The taskbar. */
  .xp-task { position: fixed; left: 0; right: 0; bottom: 0; z-index: 60; padding-bottom: env(safe-area-inset-bottom, 0px); font-family: var(--xp-font);
    background: linear-gradient(180deg, #3b7cf0 0%, #2a63dc 8%, #245ad6 40%, #2156d3 75%, #1c4bbf 100%); box-shadow: inset 0 1px 0 #6fa1f7, inset 0 2px 0 #3a73e6, 0 -2px 10px rgba(0,20,70,.2); }
  .xp-task__in { display: flex; align-items: stretch; height: 46px; }
  .xp-start { position: relative; display: inline-flex; align-items: center; gap: 8px; height: 46px; margin: 0; padding: 0 26px 0 12px; border: 0; border-radius: 0 16px 16px 0; cursor: pointer; color: #fff;
    background: linear-gradient(180deg, #6ccf5f 0%, #3fae3c 18%, #339f33 50%, #2c8f2c 80%, #2d8a2d 100%); box-shadow: inset 0 1px 0 rgba(255,255,255,.5), inset -2px 0 3px rgba(0,60,0,.35), 2px 0 6px rgba(0,30,0,.3); }
  .xp-start span { font: italic 900 21px/1 var(--xp-font); letter-spacing: .01em; text-shadow: 1px 1px 2px rgba(0,40,0,.55); }
  .xp-start .xp-mark { width: 26px; height: 26px; }
  .xp-start:hover, .xp-start[aria-expanded="true"] { filter: brightness(1.08); }
  .xp-start[aria-expanded="true"] { box-shadow: inset 0 2px 6px rgba(0,50,0,.5); }
  .xp-task__wins { flex: 1; min-width: 0; display: flex; align-items: center; gap: 4px; padding: 0 10px; overflow: hidden; }
  .xp-tw { display: inline-flex; align-items: center; gap: 8px; flex: 0 1 220px; min-width: 0; height: 34px; margin: 0; padding: 0 12px; border: 0; border-radius: 4px; color: #fff; font: 600 14px var(--xp-font); text-decoration: none;
    background: linear-gradient(180deg, #5b98f4 0%, #3c7ff0 50%, #3373e4 100%); box-shadow: inset 0 1px 0 rgba(255,255,255,.35), inset 0 0 0 1px rgba(0,30,120,.35); }
  .xp-tw.is-current { background: linear-gradient(180deg, #1c4bbf 0%, #1e50c6 100%); box-shadow: inset 1px 1px 3px rgba(0,10,60,.55), inset 0 0 0 1px rgba(0,20,90,.5); }
  button.xp-tw { cursor: pointer; }
  .xp-tw span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .xp-tw .xp-ico { width: 18px; height: 18px; }
  .xp-tray { display: flex; align-items: center; gap: 4px; padding: 0 14px 0 12px; color: #fff;
    background: linear-gradient(180deg, #1690f0 0%, #0f84e8 12%, #0b77df 50%, #0d70d8 100%); box-shadow: inset 1px 0 0 #0b4fb5, inset 2px 0 0 #3aa2ff; }
  .xp-tray a { position: relative; display: grid; place-items: center; width: 32px; height: 32px; border-radius: 4px; color: #fff; }
  .xp-tray a:hover { background: rgba(255,255,255,.15); }
  .xp-tray .xp-ico { width: 20px; height: 20px; }
  .xp-tray .xp-count { position: absolute; top: -2px; right: -4px; min-width: 18px; height: 18px; font-size: 11px; box-shadow: 0 0 0 1.5px #0d70d8; }
  .xp-clock { min-width: 64px; padding-left: 8px; text-align: right; font: 600 14px var(--xp-font); font-variant-numeric: tabular-nums; white-space: nowrap; text-shadow: 0 1px 0 rgba(0,20,80,.4); }
  @media (max-width: 749px) {
    .xp-task__wins .xp-tw:not(.is-current) { display: none; }
    .xp-tw { flex-basis: auto; }
    .xp-tray .xp-acc, .xp-tray .xp-tray__search { display: none; }
    .xp-start { padding: 0 20px 0 10px; }
    .xp-start span { font-size: 19px; }
    .xp-clock { min-width: 0; }
  }

  /* The menu the green button opens. */
  .xp-menu { position: fixed; left: 0; bottom: calc(46px + env(safe-area-inset-bottom, 0px)); z-index: 61; width: min(460px, 100vw); max-height: calc(100dvh - 120px); display: flex; flex-direction: column;
    border-radius: 10px 10px 0 0; overflow: hidden; background: #1f5fd8; padding: 0 3px; box-shadow: 4px -4px 24px rgba(0,20,70,.4); transform-origin: 0 100%; transition: transform .22s cubic-bezier(.2,.8,.2,1), opacity .18s; }
  .xp-menu[hidden] { display: none; }
  .xp-menu.is-opening { transform: translateY(14px) scale(.98); opacity: 0; }
  .xp-menu__head { display: flex; align-items: center; gap: 12px; margin: 0 -3px; padding: 12px 14px; color: #fff; font-weight: 800; font-size: 17px; text-shadow: 1px 1px 1px rgba(0,20,80,.5);
    background: linear-gradient(180deg, #4f95f6 0%, #2a6be3 15%, #1e5bd6 70%, #1a50c4 100%); }
  .xp-menu__tile { width: 46px; height: 46px; flex: none; border: 2px solid rgba(255,255,255,.85); border-radius: 6px; overflow: hidden; background: #fff; box-shadow: 0 2px 4px rgba(0,0,40,.3); }
  .xp-menu__tile img, .xp-menu__tile svg { display: block; width: 100%; height: 100%; object-fit: cover; }
  .xp-menu__cols { display: grid; grid-template-columns: 1fr 1fr; min-height: 0; overflow: auto; border-top: 2px solid #f39c35; }
  .xp-menu__col { margin: 0; padding: 6px; list-style: none; }
  .xp-menu__col--l { background: #fff; }
  .xp-menu__col--r { background: #d3e5fa; border-left: 1px solid #a9c3ea; }
  .xp-menu__col a { display: flex; align-items: center; gap: 10px; min-height: 44px; padding: 4px 8px; border-radius: 3px; color: #14213d; font-size: 15px; font-weight: 700; text-decoration: none; }
  .xp-menu__col--r a { color: #0f2f75; font-weight: 600; }
  .xp-menu__col a:hover, .xp-menu__col a:focus-visible { background: #316ac5; color: #fff; outline: none; }
