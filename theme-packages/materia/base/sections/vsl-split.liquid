{%- comment -%}
Video sales letter: a picture in the same rounded frame as the video,
  beside a label, a two part heading, text and a button. For the person
  behind the offer, or one part of it told at more length.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
-%}
<style>
  .vsl { position: relative; color: var(--vsl-text, #a3a3a8); font-family: var(--body-font, inherit); -webkit-font-smoothing: antialiased; }
  .vsl *, .vsl *::before, .vsl *::after { box-sizing: border-box; }
  .vsl__inner { position: relative; max-width: var(--vsl-max, 1120px); margin: 0 auto; padding: 0 20px; }
  .vsl__head { text-align: center; margin: 0 auto 44px; max-width: 760px; }
  .vsl__eyebrow { display: flex; align-items: center; justify-content: center; gap: 14px; margin: 0 0 18px; font-size: 11px; font-weight: 500; letter-spacing: .24em; text-transform: uppercase; color: rgba(var(--vsl-ink-rgb, 255,255,255),.6); }
  .vsl__eyebrow::before, .vsl__eyebrow::after { content: ""; flex: 0 0 34px; height: 1px; background: linear-gradient(90deg, rgba(var(--vsl-ink-rgb, 255,255,255),0), rgba(var(--vsl-ink-rgb, 255,255,255),.5)); }
  .vsl__eyebrow::after { background: linear-gradient(270deg, rgba(var(--vsl-ink-rgb, 255,255,255),0), rgba(var(--vsl-ink-rgb, 255,255,255),.5)); }
  .vsl__title { margin: 0; color: var(--vsl-head, rgb(var(--vsl-ink-rgb, 255,255,255))); font-family: var(--heading-font, inherit); font-weight: 700; font-size: clamp(32px, 4.6vw, 52px); line-height: 1.06; letter-spacing: -.035em; text-wrap: balance; }
  .vsl__title em, .vsl em.vsl-serif { font-style: normal; color: rgba(var(--vsl-ink-rgb, 255,255,255),.6); }
  .vsl__lede { margin: 16px auto 0; max-width: 580px; font-size: 15px; line-height: 1.65; }
  .vsl__lede p { margin: 0; }
  .vsl-btn {
    position: relative; isolation: isolate; overflow: hidden;
    display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 48px; padding: 0 24px;
    border-radius: 999px; border: 1px solid rgba(var(--vsl-ink-rgb, 255,255,255),.24); background: rgba(var(--vsl-surface-rgb, 10,10,12),.85); color: rgb(var(--vsl-ink-rgb, 255,255,255));
    font-family: var(--body-font, inherit); font-size: 14px; font-weight: 600; letter-spacing: -.005em; text-decoration: none; white-space: nowrap;
    box-shadow: inset 0 1px 0 rgba(var(--vsl-ink-rgb, 255,255,255),.22), 0 0 0 4px rgba(var(--vsl-ink-rgb, 255,255,255),.03), 0 14px 40px -14px rgba(var(--vsl-ink-rgb, 255,255,255),.35);
    transition: transform .35s cubic-bezier(.2,.7,.2,1), border-color .35s, box-shadow .35s;
  }
  .vsl-btn::before { content: ""; position: absolute; z-index: -1; top: -1px; left: -40%; width: 40%; height: 2px; background: linear-gradient(90deg, transparent, rgb(var(--vsl-ink-rgb, 255,255,255)), transparent); opacity: .9; transition: transform 1.1s cubic-bezier(.2,.7,.2,1); }
  .vsl-btn:hover { transform: translateY(-1px); border-color: rgba(var(--vsl-ink-rgb, 255,255,255),.5); box-shadow: inset 0 1px 0 rgba(var(--vsl-ink-rgb, 255,255,255),.3), 0 0 0 4px rgba(var(--vsl-ink-rgb, 255,255,255),.05), 0 18px 50px -14px rgba(var(--vsl-ink-rgb, 255,255,255),.45); }
  .vsl-btn:hover::before { transform: translateX(350%); }
  .vsl-btn:focus-visible { outline: 2px solid rgb(var(--vsl-ink-rgb, 255,255,255)); outline-offset: 3px; }
  .vsl-btn svg { width: 16px; height: 16px; flex: none; transition: transform .35s cubic-bezier(.2,.7,.2,1); }
  .vsl-btn:hover svg { transform: translateX(3px); }
  .vsl-btn--light { background: rgb(var(--vsl-ink-rgb, 255,255,255)); color: rgb(var(--vsl-surface-rgb, 10,10,10)); border-color: rgb(var(--vsl-ink-rgb, 255,255,255)); box-shadow: 0 14px 40px -14px rgba(var(--vsl-ink-rgb, 255,255,255),.5); }
  .vsl-btn--light::before { display: none; }
  .vsl-btn--ghost { background: transparent; box-shadow: none; border-color: rgba(var(--vsl-ink-rgb, 255,255,255),.16); }
  .vsl__actions { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 12px; margin-top: 30px; }
  .vsl-card {
    position: relative; border-radius: 18px; border: 1px solid rgba(var(--vsl-ink-rgb, 255,255,255),.09);
    background: linear-gradient(180deg, rgba(var(--vsl-ink-rgb, 255,255,255),.06), rgba(var(--vsl-ink-rgb, 255,255,255),.015) 60%), rgba(var(--vsl-surface-rgb, 12,12,14),.72);
    box-shadow: inset 0 1px 0 rgba(var(--vsl-ink-rgb, 255,255,255),.07), 0 30px 60px -40px rgba(0,0,0,.9);
  }
  .vsl--line { padding-top: 1px; }
  .vsl--line::before { content: ""; position: absolute; left: 50%; top: 0; width: min(1120px, calc(100% - 40px)); height: 1px; transform: translateX(-50%); background: linear-gradient(90deg, rgba(var(--vsl-ink-rgb, 255,255,255),0), rgba(var(--vsl-ink-rgb, 255,255,255),.26) 50%, rgba(var(--vsl-ink-rgb, 255,255,255),0)); }
  .vsl--line::after { content: ""; position: absolute; left: 50%; top: 0; width: min(900px, 90%); height: 180px; transform: translateX(-50%); pointer-events: none; background: radial-gradient(50% 100% at 50% 0, rgba(var(--vsl-ink-rgb, 255,255,255),.07), rgba(var(--vsl-ink-rgb, 255,255,255),0)); }
  @media (max-width: 749px) { .vsl__eyebrow { letter-spacing: .18em; gap: 10px; } .vsl__eyebrow::before, .vsl__eyebrow::after { flex-basis: 22px; } .vsl__head { margin-bottom: 32px; } }
  html.vsl-js .vsl [data-motion] { opacity: 0; transform: translate3d(0, 22px, 0); transition: opacity .9s cubic-bezier(.2,.65,.2,1), transform .9s cubic-bezier(.2,.65,.2,1); transition-delay: var(--d, 0ms); }
  html.vsl-js .vsl [data-motion].is-in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    html.vsl-js .vsl [data-motion] { opacity: 1; transform: none; transition: none; }
    .vsl-btn, .vsl-btn::before, .vsl-btn svg { transition: none; }
  }

  #shopify-section-{{ sid }} .vsl { padding-top: {{ st.padding_top_mobile | default: 64 }}px; padding-bottom: {{ st.padding_bottom_mobile | default: 64 }}px; }
  @media (min-width: 750px) { #shopify-section-{{ sid }} .vsl { padding-top: {{ st.padding_top | default: 96 }}px; padding-bottom: {{ st.padding_bottom | default: 96 }}px; } }

  .vsl-split__grid { display: grid; gap: 36px; align-items: center; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 900px) { .vsl-split__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 72px; } .vsl-split--right .vsl-split__media { order: 2; } }
  #shopify-section-{{ sid }} .vsl-split__media { position: relative; margin: 0; border-radius: 20px; overflow: hidden; aspect-ratio: {{ st.ratio | default: '4 / 5' }}; background: rgb(var(--vsl-surface-rgb, 11,11,12));
    border: 1px solid rgba(var(--vsl-ink-rgb, 255,255,255),.14); box-shadow: inset 0 1px 0 rgba(var(--vsl-ink-rgb, 255,255,255),.16), 0 0 0 6px rgba(var(--vsl-ink-rgb, 255,255,255),.025), 0 40px 100px -50px rgba(var(--vsl-ink-rgb, 255,255,255),.2); }
  .vsl-split__media img, .vsl-split__media svg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .vsl-split__media svg { fill: rgba(var(--vsl-ink-rgb, 255,255,255),.15); }
  .vsl-split .vsl__head { text-align: left; margin: 0; }
  .vsl-split .vsl__eyebrow { justify-content: flex-start; }
  .vsl-split .vsl__eyebrow::before { display: none; }
  .vsl-split .vsl__lede { margin-left: 0; }
  .vsl-split .vsl__lede p + p { margin-top: .9em; }
  .vsl-split .vsl__actions { justify-content: flex-start; }
  .vsl-split__points { list-style: none; margin: 22px 0 0; padding: 0; display: grid; gap: 10px; }
  .vsl-split__points li { display: flex; gap: 12px; align-items: flex-start; color: rgba(var(--vsl-ink-rgb, 255,255,255),.82); font-size: 14px; line-height: 1.5; }
  .vsl-split__points svg { width: 18px; height: 18px; flex: none; margin-top: 1px; color: rgb(var(--vsl-ink-rgb, 255,255,255)); }
  .vsl-split__social { display: flex; flex-wrap: wrap; gap: 8px; margin: 26px 0 0; padding: 0; list-style: none; }
  .vsl-split__social a { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; color: rgb(var(--vsl-ink-rgb, 255,255,255)); border: 1px solid rgba(var(--vsl-ink-rgb, 255,255,255),.16); background: rgba(var(--vsl-ink-rgb, 255,255,255),.04); transition: background-color .3s, border-color .3s, transform .3s; }
  .vsl-split__social a:hover { background: rgba(var(--vsl-ink-rgb, 255,255,255),.12); border-color: rgba(var(--vsl-ink-rgb, 255,255,255),.34); transform: translateY(-1px); }
  .vsl-split__social a:focus-visible { outline: 2px solid rgb(var(--vsl-ink-rgb, 255,255,255)); outline-offset: 3px; }
  .vsl-split__social svg { width: 17px; height: 17px; }
  @media (prefers-reduced-motion: reduce) { .vsl-split__social a { transition: none; } }
  .vsl-split__sign { margin: 22px 0 0; font-family: var(--heading-font, inherit); font-weight: 600; font-size: 20px; color: rgb(var(--vsl-ink-rgb, 255,255,255)); }
</style>
<div data-own-font class="vsl{% render 'vsl-frame', section: section, part: 'class' %}{% if st.line_above %} vsl--line{% endif %} vsl-split{% if st.image_side == 'right' %} vsl-split--right{% endif %}" style="{% render 'vsl-frame', section: section, part: 'style' %}">{% render 'vsl-frame', section: section, part: 'bg' %}
  <div class="vsl__inner">
    <div class="vsl-split__grid">
      <figure class="vsl-split__media" data-motion>
        {%- if st.image != blank -%}
          {{ st.image | image_url: width: 1200 | image_tag: widths: '400, 600, 800, 1000, 1200', sizes: '(min-width: 900px) 50vw, 94vw', loading: 'lazy', alt: st.image_alt }}
        {%- else -%}
          {{ 'image' | placeholder_svg_tag }}
        {%- endif -%}
      </figure>
      <div class="vsl__head" data-motion style="--d: 120ms">
        {%- if st.eyebrow != blank -%}<p class="vsl__eyebrow"><span>{{ st.eyebrow | escape }}</span></p>{%- endif -%}
        {%- if st.heading != blank -%}<{{ st.heading_tag | default: 'h2' }} class="vsl__title">{%- assign vsl_parts = st.heading | escape | split: '*' -%}{%- for vsl_part in vsl_parts -%}{%- assign vsl_odd = forloop.index0 | modulo: 2 -%}{%- if vsl_odd == 1 -%}<em>{{ vsl_part | replace: '|', '<br>' }}</em>{%- else -%}{{ vsl_part | replace: '|', '<br>' }}{%- endif -%}{%- endfor -%}</{{ st.heading_tag | default: 'h2' }}>{%- endif -%}
        {%- if st.text != blank -%}<div class="vsl__lede">{{ st.text }}</div>{%- endif -%}
        {%- if st.points != blank -%}
          <ul class="vsl-split__points" role="list">
            {%- assign sp_lines = st.points | newline_to_br | split: '<br />' -%}
            {%- for sp in sp_lines -%}{%- assign sp_t = sp | strip -%}{%- if sp_t != blank -%}<li><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="10" cy="10" r="8.2" opacity=".35"/><path d="M6.4 10.2l2.4 2.4 4.8-5"/></svg><span>{{ sp_t | escape }}</span></li>{%- endif -%}{%- endfor -%}
          </ul>
        {%- endif -%}
        {%- if st.signature != blank -%}<p class="vsl-split__sign">{{ st.signature | escape }}</p>{%- endif -%}
        {%- if st.social_instagram != blank or st.social_youtube != blank or st.social_tiktok != blank or st.social_x != blank or st.social_linkedin != blank or st.social_spotify != blank or st.social_website != blank -%}<ul class="vsl-split__social" role="list">{%- if st.social_instagram != blank -%}<li><a href="{{ st.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r=".6" fill="currentColor"/></svg></a></li>{%- endif -%}{%- if st.social_youtube != blank -%}<li><a href="{{ st.social_youtube }}" target="_blank" rel="noopener" aria-label="YouTube"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="2.5" y="5.5" width="19" height="13" rx="4"/><path d="M10 9.2v5.6l4.8-2.8z" fill="currentColor"/></svg></a></li>{%- endif -%}{%- if st.social_tiktok != blank -%}<li><a href="{{ st.social_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M14 3.5v11a3.5 3.5 0 1 1-3.5-3.5"/><path d="M14 3.5c.4 2.6 2.2 4.3 5 4.5"/></svg></a></li>{%- endif -%}{%- if st.social_x != blank -%}<li><a href="{{ st.social_x }}" target="_blank" rel="noopener" aria-label="X"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4.5 4.5l15 15M19.5 4.5l-15 15"/></svg></a></li>{%- endif -%}{%- if st.social_linkedin != blank -%}<li><a href="{{ st.social_linkedin }}" target="_blank" rel="noopener" aria-label="LinkedIn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3.5" y="3.5" width="17" height="17" rx="3"/><path d="M8 10.5V16M8 7.6v.1M11.5 16v-5.5M11.5 13c0-1.8 1-2.6 2.2-2.6s2.3.7 2.3 2.6V16"/></svg></a></li>{%- endif -%}{%- if st.social_spotify != blank -%}<li><a href="{{ st.social_spotify }}" target="_blank" rel="noopener" aria-label="Spotify"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"/><path d="M7.5 9.5c3-1 6.4-.8 9 .7M8 12.6c2.5-.7 5.2-.5 7.3.7M8.6 15.4c2-.5 3.9-.3 5.6.5"/></svg></a></li>{%- endif -%}{%- if st.social_website != blank -%}<li><a href="{{ st.social_website }}" target="_blank" rel="noopener" aria-label="Website"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.6 2.7 2.6 15.3 0 18M12 3c-2.6 2.7-2.6 15.3 0 18"/></svg></a></li>{%- endif -%}</ul>{%- endif -%}
        {%- if st.button_label != blank -%}<div class="vsl__actions"><a class="vsl-btn" href="{{ st.button_link | default: '#' }}">{{ st.button_label | escape }}<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 8h10M9 4l4 4-4 4"/></svg></a></div>{%- endif -%}
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;
    var still = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!('IntersectionObserver' in window) || still) return;
    document.documentElement.classList.add('vsl-js');
    if (!window.__vslSeen) {
      window.__vslSeen = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('is-in'); window.__vslSeen.unobserve(e.target); } });
      }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
    }
    root.querySelectorAll('[data-motion]:not(.is-in)').forEach(function (el) { window.__vslSeen.observe(el); });
  })();
</script>

{% schema %}
{
  "name": "Picture and words",
  "tag": "section",
  "class": "vsl-split-section",
  "settings": [
    { "type": "header", "content": "Colours and background" },
    { "type": "select", "id": "vsl_colors", "label": "Colours", "default": "designed", "options": [{ "value": "designed", "label": "As designed (light on dark)" }, { "value": "scheme", "label": "Colour scheme" }] },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default", "visible_if": "{{ section.settings.vsl_colors == 'scheme' }}" },
    { "type": "color", "id": "background_color", "label": "Background colour", "info": "Empty keeps the page's background." },
    { "type": "image_picker", "id": "background_image", "label": "Background picture" },
    { "type": "color", "id": "overlay_color", "label": "Overlay on the picture", "default": "#000000", "visible_if": "{{ section.settings.background_image != blank }}" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay strength", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 55, "visible_if": "{{ section.settings.background_image != blank }}" },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Picture"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Picture description"
    },
    {
      "type": "select",
      "id": "image_side",
      "label": "Picture side",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Picture shape",
      "default": "4 / 5",
      "options": [
        {
          "value": "4 / 5",
          "label": "Portrait"
        },
        {
          "value": "1 / 1",
          "label": "Square"
        },
        {
          "value": "16 / 10",
          "label": "Landscape"
        }
      ]
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small label",
      "default": "About"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The person behind it",
      "info": "Words between asterisks are set a shade lighter, like *this*. A | starts a new line."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Who you are, what you have done for clients, and why you teach it.</p>"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading level",
      "default": "h2",
      "options": [
        {
          "value": "h1",
          "label": "Page title (h1)"
        },
        {
          "value": "h2",
          "label": "Section heading (h2)"
        }
      ]
    },
    {
      "type": "text",
      "id": "signature",
      "label": "Signature line"
    },
    {
      "type": "textarea",
      "id": "points",
      "label": "Ticked points",
      "info": "One per line. Leave empty for none."
    },
    {
      "type": "header",
      "content": "Social links"
    },
    {
      "type": "paragraph",
      "content": "Each one shows as a round icon. Leave empty to hide it."
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "Instagram"
    },
    {
      "type": "url",
      "id": "social_youtube",
      "label": "YouTube"
    },
    {
      "type": "url",
      "id": "social_tiktok",
      "label": "TikTok"
    },
    {
      "type": "url",
      "id": "social_x",
      "label": "X"
    },
    {
      "type": "url",
      "id": "social_linkedin",
      "label": "LinkedIn"
    },
    {
      "type": "url",
      "id": "social_spotify",
      "label": "Spotify"
    },
    {
      "type": "url",
      "id": "social_website",
      "label": "Website"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "checkbox",
      "id": "line_above",
      "label": "Thin glowing line above",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Space above, desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Space below, desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Space above, phone",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Space below, phone",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Picture and words",
      "category": "Video sales letter"
    }
  ]
}
{% endschema %}
