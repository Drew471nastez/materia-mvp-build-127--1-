{%- comment -%}
Video sales letter: the offer. On one side everything the buyer gets, as
  ticked rows; on the other a price card that reads the price, the compare
  at price and the link from the course product, with a short payment line,
  a button, a few reassurances and the refund promise. With no product
  picked the store's first product is used.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign p = st.product
  if p == blank or p.title == blank
    assign p = collections.all.products.first
  endif
  assign title = st.title_override
  assign amount = ''
  assign was = ''
  assign buy = st.button_link | default: '/collections/all'
  if p != blank and p.title != blank
    if title == blank
      assign title = p.title
    endif
    assign amount = p.price | money_without_trailing_zeros
    if p.compare_at_price > p.price
      assign was = p.compare_at_price | money_without_trailing_zeros
    endif
    assign buy = p.url
    assign v = p.selected_or_first_available_variant
    if st.to_checkout and v.id != blank
      assign buy = '/cart/' | append: v.id | append: ':1'
    endif
  endif
  if title == blank
    assign title = 'Your course'
  endif
-%}
<style>
  .vsl { position: relative; color: var(--vsl-text, #a3a3a8); font-family: var(--body-font, inherit); -webkit-font-smoothing: antialiased; }
  .vsl *, .vsl *::before, .vsl *::after { box-sizing: border-box; }
  .vsl__inner { position: relative; max-width: var(--vsl-max, 1120px); margin: 0 auto; padding: 0 20px; }
  .vsl__head { text-align: center; margin: 0 auto 44px; max-width: 760px; }
  .vsl__eyebrow { display: flex; align-items: center; justify-content: center; gap: 14px; margin: 0 0 18px; font-size: 11px; font-weight: 500; letter-spacing: .24em; text-transform: uppercase; color: rgba(255,255,255,.6); }
  .vsl__eyebrow::before, .vsl__eyebrow::after { content: ""; flex: 0 0 34px; height: 1px; background: linear-gradient(90deg, rgba(255,255,255,0), rgba(255,255,255,.5)); }
  .vsl__eyebrow::after { background: linear-gradient(270deg, rgba(255,255,255,0), rgba(255,255,255,.5)); }
  .vsl__title { margin: 0; color: var(--vsl-head, #fff); font-family: var(--heading-font, inherit); font-weight: 700; font-size: clamp(32px, 4.6vw, 52px); line-height: 1.06; letter-spacing: -.035em; text-wrap: balance; }
  .vsl__title em, .vsl em.vsl-serif { font-style: normal; color: rgba(255,255,255,.6); }
  .vsl__lede { margin: 16px auto 0; max-width: 580px; font-size: 15px; line-height: 1.65; }
  .vsl__lede p { margin: 0; }
  .vsl-btn {
    position: relative; isolation: isolate; overflow: hidden;
    display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 48px; padding: 0 24px;
    border-radius: 999px; border: 1px solid rgba(255,255,255,.24); background: rgba(10,10,12,.85); color: #fff;
    font-family: var(--body-font, inherit); font-size: 14px; font-weight: 600; letter-spacing: -.005em; text-decoration: none; white-space: nowrap;
    box-shadow: inset 0 1px 0 rgba(255,255,255,.22), 0 0 0 4px rgba(255,255,255,.03), 0 14px 40px -14px rgba(255,255,255,.35);
    transition: transform .35s cubic-bezier(.2,.7,.2,1), border-color .35s, box-shadow .35s;
  }
  .vsl-btn::before { content: ""; position: absolute; z-index: -1; top: -1px; left: -40%; width: 40%; height: 2px; background: linear-gradient(90deg, transparent, #fff, transparent); opacity: .9; transition: transform 1.1s cubic-bezier(.2,.7,.2,1); }
  .vsl-btn:hover { transform: translateY(-1px); border-color: rgba(255,255,255,.5); box-shadow: inset 0 1px 0 rgba(255,255,255,.3), 0 0 0 4px rgba(255,255,255,.05), 0 18px 50px -14px rgba(255,255,255,.45); }
  .vsl-btn:hover::before { transform: translateX(350%); }
  .vsl-btn:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
  .vsl-btn svg { width: 16px; height: 16px; flex: none; transition: transform .35s cubic-bezier(.2,.7,.2,1); }
  .vsl-btn:hover svg { transform: translateX(3px); }
  .vsl-btn--light { background: #fff; color: #0a0a0a; border-color: #fff; box-shadow: 0 14px 40px -14px rgba(255,255,255,.5); }
  .vsl-btn--light::before { display: none; }
  .vsl-btn--ghost { background: transparent; box-shadow: none; border-color: rgba(255,255,255,.16); }
  .vsl__actions { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 12px; margin-top: 30px; }
  .vsl-card {
    position: relative; border-radius: 18px; border: 1px solid rgba(255,255,255,.09);
    background: linear-gradient(180deg, rgba(255,255,255,.06), rgba(255,255,255,.015) 60%), rgba(12,12,14,.72);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.07), 0 30px 60px -40px rgba(0,0,0,.9);
  }
  .vsl--line { padding-top: 1px; }
  .vsl--line::before { content: ""; position: absolute; left: 50%; top: 0; width: min(1120px, calc(100% - 40px)); height: 1px; transform: translateX(-50%); background: linear-gradient(90deg, rgba(255,255,255,0), rgba(255,255,255,.26) 50%, rgba(255,255,255,0)); }
  .vsl--line::after { content: ""; position: absolute; left: 50%; top: 0; width: min(900px, 90%); height: 180px; transform: translateX(-50%); pointer-events: none; background: radial-gradient(50% 100% at 50% 0, rgba(255,255,255,.07), rgba(255,255,255,0)); }
  @media (max-width: 749px) { .vsl__eyebrow { letter-spacing: .18em; gap: 10px; } .vsl__eyebrow::before, .vsl__eyebrow::after { flex-basis: 22px; } .vsl__head { margin-bottom: 32px; } }
  html.vsl-js .vsl [data-motion] { opacity: 0; transform: translate3d(0, 22px, 0); transition: opacity .9s cubic-bezier(.2,.65,.2,1), transform .9s cubic-bezier(.2,.65,.2,1); transition-delay: var(--d, 0ms); }
  html.vsl-js .vsl [data-motion].is-in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    html.vsl-js .vsl [data-motion] { opacity: 1; transform: none; transition: none; }
    .vsl-btn, .vsl-btn::before, .vsl-btn svg { transition: none; }
  }

  #shopify-section-{{ sid }} .vsl { padding-top: {{ st.padding_top_mobile | default: 64 }}px; padding-bottom: {{ st.padding_bottom_mobile | default: 64 }}px; scroll-margin-top: 72px; }
  @media (min-width: 750px) { #shopify-section-{{ sid }} .vsl { padding-top: {{ st.padding_top | default: 96 }}px; padding-bottom: {{ st.padding_bottom | default: 96 }}px; } }
  .vsl-offer__grid { display: grid; gap: 20px; grid-template-columns: minmax(0, 1fr); align-items: start; }
  @media (min-width: 990px) { .vsl-offer__grid { grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 24px; } }
  .vsl-offer__list { padding: 10px 28px; }
  .vsl-offer__item { display: grid; grid-template-columns: 36px minmax(0, 1fr); gap: 16px; padding: 20px 0; border-top: 1px solid rgba(255,255,255,.07); }
  .vsl-offer__item:first-child { border-top: 0; }
  .vsl-offer__tick { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 10px; color: #fff; background: linear-gradient(180deg, rgba(255,255,255,.18), rgba(255,255,255,.05)); border: 1px solid rgba(255,255,255,.16); box-shadow: inset 0 1px 0 rgba(255,255,255,.3); }
  .vsl-offer__tick svg { width: 16px; height: 16px; }
  .vsl-offer__name { margin: 6px 0 4px; color: #fff; font-size: 16px; font-weight: 600; letter-spacing: -.01em; line-height: 1.35; }
  .vsl-offer__text { font-size: 14px; line-height: 1.6; }
  .vsl-offer__text p { margin: 0; }
  .vsl-offer__card { padding: 30px 28px 26px; overflow: hidden; }
  @media (min-width: 990px) { .vsl-offer__card { position: sticky; top: 96px; } }
  .vsl-offer__card::before { content: ""; position: absolute; left: 10%; right: 10%; top: -1px; height: 1px; background: linear-gradient(90deg, transparent, rgba(255,255,255,.7), transparent); }
  .vsl-offer__card::after { content: ""; position: absolute; left: 50%; top: -120px; width: 380px; height: 240px; transform: translateX(-50%); background: radial-gradient(closest-side, rgba(255,255,255,.1), transparent); pointer-events: none; }
  .vsl-offer__label { display: inline-flex; margin: 0 0 18px; padding: 5px 11px; border-radius: 999px; background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.14); color: #fff; font-size: 11px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; }
  .vsl-offer__title { margin: 0; color: #fff; font-size: 20px; font-weight: 600; letter-spacing: -.015em; }
  .vsl-offer__price { display: flex; align-items: baseline; flex-wrap: wrap; gap: 4px 12px; margin: 14px 0 4px; }
  .vsl-offer__now { color: #fff; font-size: 52px; font-weight: 700; letter-spacing: -.04em; line-height: 1; font-variant-numeric: tabular-nums; }
  .vsl-offer__was { color: rgba(255,255,255,.45); font-size: 18px; text-decoration: line-through; }
  .vsl-offer__note { margin: 6px 0 0; font-size: 13px; }
  .vsl-offer__card .vsl-btn { width: 100%; margin-top: 24px; min-height: 52px; font-size: 15px; }
  .vsl-offer__trust { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 16px; margin: 14px 0 0; padding: 0; list-style: none; font-size: 12px; color: rgba(255,255,255,.55); }
  .vsl-offer__trust li { display: inline-flex; align-items: center; gap: 6px; }
  .vsl-offer__trust svg { width: 13px; height: 13px; }
  .vsl-offer__promise { display: grid; grid-template-columns: 40px minmax(0, 1fr); gap: 14px; margin-top: 24px; padding: 18px; border-radius: 14px; background: rgba(255,255,255,.035); border: 1px solid rgba(255,255,255,.08); }
  .vsl-offer__promise svg { width: 40px; height: 40px; color: #fff; }
  .vsl-offer__promise strong { display: block; margin-bottom: 3px; color: #fff; font-size: 14px; font-weight: 600; }
  .vsl-offer__promise p { margin: 0; font-size: 13px; line-height: 1.55; }
  @media (max-width: 749px) { .vsl-offer__list { padding: 4px 20px; } .vsl-offer__card { padding: 26px 20px 22px; } .vsl-offer__now { font-size: 44px; } }
</style>
<div data-own-font class="vsl{% if st.line_above %} vsl--line{% endif %} vsl-offer" id="{{ st.anchor | default: 'join' | handleize }}">
  <div class="vsl__inner">
    {%- if st.eyebrow != blank or st.heading != blank or st.text != blank -%}
      <div class="vsl__head" data-motion>
        {%- if st.eyebrow != blank -%}<p class="vsl__eyebrow"><span>{{ st.eyebrow | escape }}</span></p>{%- endif -%}
        {%- if st.heading != blank -%}<h2 class="vsl__title">{%- assign vsl_parts = st.heading | escape | split: '*' -%}{%- for vsl_part in vsl_parts -%}{%- assign vsl_odd = forloop.index0 | modulo: 2 -%}{%- if vsl_odd == 1 -%}<em>{{ vsl_part | replace: '|', '<br>' }}</em>{%- else -%}{{ vsl_part | replace: '|', '<br>' }}{%- endif -%}{%- endfor -%}</h2>{%- endif -%}
        {%- if st.text != blank -%}<div class="vsl__lede">{{ st.text }}</div>{%- endif -%}
      </div>
    {%- endif -%}
    <div class="vsl-offer__grid">
      {%- if section.blocks.size > 0 -%}
        <div class="vsl-card vsl-offer__list" data-motion>
          {%- for block in section.blocks -%}
            <div class="vsl-offer__item" {{ block.shopify_attributes }}>
              <span class="vsl-offer__tick" aria-hidden="true"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 8.4l3 3 6-6.4"/></svg></span>
              <div>
                <h3 class="vsl-offer__name">{{ block.settings.title | escape }}</h3>
                {%- if block.settings.text != blank -%}<div class="vsl-offer__text">{{ block.settings.text }}</div>{%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
      <div class="vsl-card vsl-offer__card" data-motion style="--d: 120ms">
        {%- if st.card_label != blank -%}<p class="vsl-offer__label">{{ st.card_label | escape }}</p>{%- endif -%}
        <p class="vsl-offer__title">{{ title | escape }}</p>
        {%- if amount != blank -%}
          <p class="vsl-offer__price"><span class="vsl-offer__now">{{ amount }}</span>{%- if was != blank -%}<span class="vsl-offer__was"><span class="visually-hidden">Was </span>{{ was }}</span>{%- endif -%}</p>
        {%- endif -%}
        {%- if st.price_note != blank -%}<p class="vsl-offer__note">{{ st.price_note | escape }}</p>{%- endif -%}
        {%- if st.button_label != blank -%}<a class="vsl-btn vsl-btn--light" href="{{ buy }}">{{ st.button_label | escape }}<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 8h10M9 4l4 4-4 4"/></svg></a>{%- endif -%}
        {%- assign trust = st.trust | split: ',' -%}
        {%- if st.trust != blank -%}<ul class="vsl-offer__trust" role="list">{%- for t in trust -%}<li><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3.5 8.4l3 3 6-6.4"/></svg>{{ t | strip | escape }}</li>{%- endfor -%}</ul>{%- endif -%}
        {%- if st.promise_title != blank or st.promise_text != blank -%}
          <div class="vsl-offer__promise">
            <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20 4l13 5v9.5c0 8.4-5.6 14.6-13 17.5C12.6 33.1 7 26.9 7 18.5V9z" opacity=".5"/><path d="M14 20.2l4.2 4.2 8-8.6"/></svg>
            <div>{%- if st.promise_title != blank -%}<strong>{{ st.promise_title | escape }}</strong>{%- endif -%}{%- if st.promise_text != blank -%}<p>{{ st.promise_text | escape }}</p>{%- endif -%}</div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;
    var still = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!('IntersectionObserver' in window) || still) return;
    document.documentElement.classList.add('vsl-js');
    if (!window.__vslSeen) {
      window.__vslSeen = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('is-in'); window.__vslSeen.unobserve(e.target); } });
      }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
    }
    root.querySelectorAll('[data-motion]:not(.is-in)').forEach(function (el) { window.__vslSeen.observe(el); });
  })();
</script>

{% schema %}
{
  "name": "Offer and price",
  "tag": "section",
  "class": "vsl-offer-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small label",
      "default": "Join the course"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Words between asterisks are set a shade lighter, like *this*. A | starts a new line.",
      "default": "Everything you *get*"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "header",
      "content": "Price card"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Course",
      "info": "Name, price and link come from this product. Your first product when none is picked."
    },
    {
      "type": "text",
      "id": "title_override",
      "label": "Name on the card",
      "info": "Leave empty to use the product's name."
    },
    {
      "type": "text",
      "id": "card_label",
      "label": "Small label on the card",
      "default": "Next round"
    },
    {
      "type": "text",
      "id": "price_note",
      "label": "Line under the price",
      "default": "Or three monthly payments."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button",
      "default": "Join the course"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link with no product"
    },
    {
      "type": "checkbox",
      "id": "to_checkout",
      "label": "Button goes straight to checkout",
      "default": false
    },
    {
      "type": "text",
      "id": "trust",
      "label": "Reassurances",
      "info": "Separate them with commas.",
      "default": "Secure checkout, Instant access"
    },
    {
      "type": "text",
      "id": "promise_title",
      "label": "Promise title",
      "default": "30 day refund"
    },
    {
      "type": "text",
      "id": "promise_text",
      "label": "Promise text",
      "default": "Watch the first lessons. If it is not for you, write within 30 days and get your money back."
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Link name",
      "info": "Buttons that link to #join scroll here.",
      "default": "join"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "checkbox",
      "id": "line_above",
      "label": "Thin glowing line above",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Space above, desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Space below, desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Space above, phone",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Space below, phone",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "What they get",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "What they get"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>One line on what it is and why it helps.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Offer and price",
      "category": "Video sales letter",
      "blocks": [
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        }
      ]
    }
  ]
}
{% endschema %}
