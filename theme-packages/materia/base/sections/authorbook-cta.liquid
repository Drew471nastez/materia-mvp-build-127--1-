{%- comment -%}
  Author: the last ask. A rounded band holding the book cover (tilted, with
  a shadow) on one side and on the other a heading, a line and two solid
  buttons: one can open a form popup (link it to #open-form-<name>), the
  other goes to the shop. Stacks on a phone, the cover first. Nothing moves.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign color_scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
-%}
<style>
  #shopify-section-{{ sid }} .abx { background: {{ st.background | default: '#ffffff' }}; padding: {{ st.padding_top_mobile | default: 24 }}px 16px {{ st.padding_bottom_mobile | default: 56 }}px; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .abx { padding: {{ st.padding_top | default: 24 }}px 40px {{ st.padding_bottom | default: 104 }}px; } }
  #shopify-section-{{ sid }} .abx__band {
    position: relative; overflow: hidden; max-width: 1140px; margin: 0 auto; border-radius: {{ st.radius | default: 16 }}px;
    background: {{ st.band_color | default: '#f0643a' }}; color: {{ st.text_color | default: '#fff4ee' }};
    display: grid; grid-template-columns: minmax(0, 1fr); gap: 28px; align-items: center; padding: 40px 24px;
  }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .abx__band { grid-template-columns: 300px minmax(0, 1fr); gap: 72px; padding: 64px 80px; } }
  #shopify-section-{{ sid }} .abx__band::before {
    content: ""; position: absolute; right: -120px; top: -140px; width: 420px; height: 420px; border-radius: 50%;
    background-image: radial-gradient(rgba(255,255,255,0.28) 1.4px, transparent 1.6px); background-size: 14px 14px; pointer-events: none;
  }
  #shopify-section-{{ sid }} .abx__cover { position: relative; margin: 0 auto; width: 150px; transform: rotate(-4deg); }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .abx__cover { width: 220px; } }
  #shopify-section-{{ sid }} .abx__cover img { display: block; width: 100%; height: auto; margin: 0; border-radius: 2px 5px 5px 2px; box-shadow: 0 30px 50px -20px rgba(40,14,0,0.55); }
  #shopify-section-{{ sid }} .abx__body { position: relative; text-align: center; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .abx__body { text-align: left; } }
  #shopify-section-{{ sid }} .abx__heading { margin: 0; color: {{ st.heading_color | default: '#ffffff' }}; font-family: var(--heading-font, inherit); font-weight: var(--heading-weight, 400); font-size: {{ st.heading_size_mobile | default: 34 }}px; line-height: 1.08; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .abx__heading { font-size: {{ st.heading_size | default: 50 }}px; max-width: 16ch; } }
  #shopify-section-{{ sid }} .abx__text { margin-top: 14px; font-size: 17px; line-height: 1.6; max-width: 46ch; }
  @media (max-width: 989px) { #shopify-section-{{ sid }} .abx__text { margin-left: auto; margin-right: auto; } }
  #shopify-section-{{ sid }} .abx__text p { margin: 0; }
  #shopify-section-{{ sid }} .abx__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 26px; justify-content: center; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .abx__actions { justify-content: flex-start; } }
  #shopify-section-{{ sid }} .abx__btn { display: inline-flex; align-items: center; justify-content: center; min-height: 54px; padding: 0 26px; border-radius: {{ st.button_radius | default: 6 }}px; font-size: 15.5px; font-weight: 700; text-decoration: none; transition: filter 0.2s ease, background-color 0.2s ease; }
  @media (max-width: 480px) { #shopify-section-{{ sid }} .abx__btn { flex: 1 1 100%; } }
  #shopify-section-{{ sid }} .abx__btn--one { background: {{ st.button_color | default: '#1d2b4f' }}; color: {{ st.button_text_color | default: '#ffffff' }}; }
  #shopify-section-{{ sid }} .abx__btn--two { background: {{ st.button2_color | default: '#ffffff' }}; color: {{ st.button2_text_color | default: '#1d2b4f' }}; }
  #shopify-section-{{ sid }} .abx__btn:hover { filter: brightness(1.1); }
  #shopify-section-{{ sid }} .abx__note { margin: 14px 0 0; font-size: 13.5px; opacity: 0.9; }
</style>
<div class="abx color-{{ color_scheme }}" data-section-id="{{ sid }}">
  <div class="abx__band">
    {%- if st.image != blank -%}<figure class="abx__cover"><img src="{{ st.image | image_url: width: 500 }}" width="500" height="750" alt="{{ st.image_alt | default: st.image.alt | escape }}" loading="lazy" decoding="async"></figure>{%- endif -%}
    <div class="abx__body">
      {%- if st.heading != blank -%}<h2 class="abx__heading">{{ st.heading }}</h2>{%- endif -%}
      {%- if st.text != blank -%}<div class="abx__text">{{ st.text }}</div>{%- endif -%}
      <div class="abx__actions">
        {%- if st.button_label != blank -%}<a class="abx__btn abx__btn--one" href="{{ st.button_link | default: '#open-form-chapter' }}">{{ st.button_label | escape }}</a>{%- endif -%}
        {%- if st.button2_label != blank -%}<a class="abx__btn abx__btn--two" href="{{ st.button2_link | default: '/collections/all' }}">{{ st.button2_label | escape }}</a>{%- endif -%}
      </div>
      {%- if st.note != blank -%}<p class="abx__note">{{ st.note | escape }}</p>{%- endif -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Author call to action",
  "tag": "section",
  "class": "section sec__authorbook-cta",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default-color-scheme" },
    { "type": "color", "id": "background", "label": "Page behind the band", "default": "#ffffff" },
    { "type": "color", "id": "band_color", "label": "Band", "default": "#f0643a" },
    { "type": "color", "id": "heading_color", "label": "Heading colour", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text colour", "default": "#fff4ee" },
    { "type": "range", "id": "radius", "label": "Band corners", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 16 },
    { "type": "image_picker", "id": "image", "label": "Cover" },
    { "type": "text", "id": "image_alt", "label": "Alt text" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Start with chapter one, free" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>One line on what they get today.</p>" },
    { "type": "text", "id": "button_label", "label": "First button", "default": "Send me chapter one" },
    { "type": "text", "id": "button_link", "label": "First button link", "info": "#open-form-chapter opens the form popup named chapter.", "default": "#open-form-chapter" },
    { "type": "color", "id": "button_color", "label": "First button colour", "default": "#1d2b4f" },
    { "type": "color", "id": "button_text_color", "label": "First button text", "default": "#ffffff" },
    { "type": "text", "id": "button2_label", "label": "Second button", "default": "Buy the book" },
    { "type": "url", "id": "button2_link", "label": "Second button link" },
    { "type": "color", "id": "button2_color", "label": "Second button colour", "default": "#ffffff" },
    { "type": "color", "id": "button2_text_color", "label": "Second button text", "default": "#1d2b4f" },
    { "type": "range", "id": "button_radius", "label": "Button corners", "min": 0, "max": 30, "step": 1, "unit": "px", "default": 6 },
    { "type": "text", "id": "note", "label": "Small note" },
    { "type": "range", "id": "heading_size", "label": "Heading size, desktop", "min": 28, "max": 72, "step": 2, "unit": "px", "default": 50 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size, phone", "min": 24, "max": 48, "step": 2, "unit": "px", "default": 34 },
    { "type": "range", "id": "padding_top", "label": "Space above, desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Space below, desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 104 },
    { "type": "range", "id": "padding_top_mobile", "label": "Space above, phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Space below, phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "presets": [ { "name": "Author call to action" } ]
}
{% endschema %}
