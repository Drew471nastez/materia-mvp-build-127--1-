{%- comment -%}
  Online course: who it is for. A label, a heading with accent words and a
  line under it, then one wide soft panel per kind of student: a small
  numbered square and a name on the left, a bold sentence and ticked points
  on the right. Panels rise in one after another.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign sid = section.id
-%}
<style>
  #shopify-section-{{ sid }} .c2a {
    --c2-accent: {{ s.accent | default: '#12704f' }};
    --c2-ink: {{ s.heading_color | default: '#15171a' }};
    --c2-text: {{ s.text_color | default: '#4a4f57' }};
    --c2-panel: {{ s.panel_color | default: '#f1f7f4' }};
    background: {{ s.background | default: '#ffffff' }};
    color: var(--c2-text);
    padding: {{ s.padding_top_mobile | default: 48 }}px 0 {{ s.padding_bottom_mobile | default: 48 }}px;
  }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .c2a { padding: {{ s.padding_top | default: 96 }}px 0 {{ s.padding_bottom | default: 96 }}px; } }
  #shopify-section-{{ sid }} .c2a__in { max-width: 1200px; margin: 0 auto; padding: 0 20px; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .c2a__in { padding: 0 40px; } }
  #shopify-section-{{ sid }} .c2-tag { display: inline-block; margin: 0 0 22px; padding: 8px 12px; border: 1px solid #d9dce1; border-radius: 6px; font-size: 13px; line-height: 1; letter-spacing: .05em; text-transform: uppercase; color: var(--c2-ink); }
  #shopify-section-{{ sid }} .c2a__title { margin: 0 0 16px; color: var(--c2-ink); font-family: var(--heading-font, inherit); font-weight: 700; font-size: 34px; line-height: 1.06; letter-spacing: -.035em; text-wrap: balance; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .c2a__title { font-size: {{ s.heading_size | default: 48 }}px; } }
  #shopify-section-{{ sid }} .c2a__title em { font-style: normal; color: var(--c2-accent); }
  #shopify-section-{{ sid }} .c2a__text { max-width: 46em; font-size: 17px; line-height: 1.6; }
  #shopify-section-{{ sid }} .c2a__text p { margin: 0; }
  #shopify-section-{{ sid }} .c2a__list { margin: 40px 0 0; padding: 0; list-style: none; display: grid; gap: 16px; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .c2a__list { margin-top: 52px; gap: 24px; } }
  #shopify-section-{{ sid }} .c2a__card { display: grid; gap: 18px; padding: 26px 22px; border-radius: 18px; background: linear-gradient(120deg, color-mix(in srgb, var(--c2-panel) 70%, #ffffff), var(--c2-panel)); }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .c2a__card { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 56px; padding: 40px; } }
  #shopify-section-{{ sid }} .c2a__num { display: inline-grid; place-items: center; min-width: 40px; height: 32px; padding: 0 8px; border-radius: 6px; background: var(--c2-accent); color: #fff; font-size: 14px; font-variant-numeric: tabular-nums; }
  #shopify-section-{{ sid }} .c2a__name { margin: 18px 0 0; color: var(--c2-ink); font-family: var(--heading-font, inherit); font-weight: 700; font-size: 26px; line-height: 1.12; letter-spacing: -.03em; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .c2a__name { margin-top: 22px; font-size: 32px; } }
  #shopify-section-{{ sid }} .c2a__lead { margin: 0 0 16px; color: var(--c2-ink); font-weight: 650; font-size: 17px; line-height: 1.45; letter-spacing: -.01em; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .c2a__lead { font-size: 19px; } }
  #shopify-section-{{ sid }} .c2a__points { margin: 0; padding: 0; list-style: none; display: grid; gap: 12px; font-size: 16px; line-height: 1.45; }
  #shopify-section-{{ sid }} .c2a__points li { display: grid; grid-template-columns: 18px 1fr; gap: 12px; align-items: start; }
  #shopify-section-{{ sid }} .c2a__points svg { width: 18px; height: 18px; margin-top: 2px; color: var(--c2-accent); }
  #shopify-section-{{ sid }} [data-c2r].c2r-wait { opacity: 0; transform: translate3d(0, 22px, 0); }
  #shopify-section-{{ sid }} [data-c2r].c2r-in { opacity: 1; transform: none; transition: opacity .8s cubic-bezier(.2,.65,.25,1) var(--d, 0ms), transform .8s cubic-bezier(.2,.65,.25,1) var(--d, 0ms); }
</style>
<section class="c2a"{% if s.anchor != blank %} id="{{ s.anchor | handleize }}"{% endif %}>
  <div class="c2a__in">
    {%- if s.tag != blank -%}<p class="c2-tag" data-c2r>{{ s.tag | escape }}</p>{%- endif -%}
    <h2 class="c2a__title" data-c2r style="--d: 60ms">{{ s.heading | escape }}{% if s.heading_accent != blank %} <em>{{ s.heading_accent | escape }}</em>{% endif %}</h2>
    {%- if s.text != blank -%}<div class="c2a__text" data-c2r style="--d: 120ms">{{ s.text }}</div>{%- endif -%}
    <ol class="c2a__list" role="list">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        {%- assign points = b.points | newline_to_br | split: '<br />' -%}
        <li class="c2a__card" data-c2r {{ block.shopify_attributes }}>
          <div>
            <span class="c2a__num">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
            <h3 class="c2a__name">{{ b.name | escape }}</h3>
          </div>
          <div>
            {%- if b.lead != blank -%}<p class="c2a__lead">{{ b.lead | escape }}</p>{%- endif -%}
            <ul class="c2a__points" role="list">
              {%- for line in points -%}
                {%- assign t = line | strip -%}
                {%- if t != blank -%}<li><svg viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3.5 9.5l3.6 3.5L14.5 5"/></svg><span>{{ t | escape }}</span></li>{%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>
{%- unless request.design_mode -%}
<script>(function(){var r=document.getElementById('shopify-section-{{ sid }}');if(!r||!('IntersectionObserver' in window)||matchMedia('(prefers-reduced-motion: reduce)').matches)return;var h=innerHeight,io=new IntersectionObserver(function(es){es.forEach(function(e){if(!e.isIntersecting)return;var t=e.target;io.unobserve(t);requestAnimationFrame(function(){t.classList.add('c2r-in')})})},{rootMargin:'0px 0px -6% 0px'});r.querySelectorAll('[data-c2r]').forEach(function(el){if(el.getBoundingClientRect().top<h*.92)return;el.classList.add('c2r-wait');io.observe(el)})})();</script>
{%- endunless -%}

{% schema %}
{
  "name": "Who it is for",
  "tag": "section",
  "class": "course2-audience-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "tag", "label": "Label above", "default": "Who it is for" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "For anyone who wants" },
    { "type": "text", "id": "heading_accent", "label": "Heading words in the accent colour", "default": "to get it right" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Name the people this course helps, in one line.</p>" },
    { "type": "text", "id": "anchor", "label": "Address on the page", "info": "A word a menu link can jump to, as /#word." },
    { "type": "range", "id": "heading_size", "label": "Heading size on desktop", "min": 28, "max": 72, "step": 2, "unit": "px", "default": 48 },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "panel_color", "label": "Panels", "default": "#f1f7f4" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#12704f" },
    { "type": "color", "id": "heading_color", "label": "Headings", "default": "#15171a" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#4a4f57" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Space above on desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Space below on desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_top_mobile", "label": "Space above on phones", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Space below on phones", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "group",
      "name": "Kind of student",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Beginners" },
        { "type": "text", "id": "lead", "label": "Bold sentence", "default": "Say what they want and what stops them now." },
        { "type": "textarea", "id": "points", "label": "Points", "info": "One per line.", "default": "What they will be able to do\nWhat they will stop worrying about" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Who it is for",
      "category": "Online course",
      "blocks": [
        { "type": "group" },
        { "type": "group", "settings": { "name": "Returning learners" } },
        { "type": "group", "settings": { "name": "Teams" } }
      ]
    }
  ]
}
{% endschema %}
