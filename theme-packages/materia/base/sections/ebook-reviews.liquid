{%- comment -%}
  Ebook: what readers say. A heading and a small note, then cards of short
  quotes with five drawn stars, a name and a detail. Ships with sample
  quotes and a note saying so, to be replaced with real readers' words.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign color_scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
-%}
{%- assign ebook_hf = settings.font_heading_google_family -%}
{%- if ebook_hf != blank and ebook_hf != 'none' -%}<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ ebook_hf | replace: ' ', '+' }}:ital@1&display=swap">{%- endif -%}
<style>
  #shopify-section-{{ sid }} .ebr {
    --ebr-accent: {{ st.accent_color | default: '#9a6a32' }};
    background: {{ st.background | default: '#ffffff' }};
    padding: {{ st.padding_top_mobile | default: 56 }}px 20px {{ st.padding_bottom_mobile | default: 56 }}px;
  }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .ebr { padding: {{ st.padding_top | default: 96 }}px 40px {{ st.padding_bottom | default: 96 }}px; } }
  #shopify-section-{{ sid }} .ebr__inner { max-width: 1120px; margin: 0 auto; }
  #shopify-section-{{ sid }} .ebr__head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 12px 40px; margin-bottom: 36px; }
  #shopify-section-{{ sid }} .ebr__eyebrow { margin: 0 0 12px; color: var(--ebr-accent); font-size: 13px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; }
  #shopify-section-{{ sid }} .ebr__heading { margin: 0; color: var(--color-heading); font-family: var(--heading-font, inherit); font-weight: var(--heading-weight, 500); font-size: {{ st.heading_size_mobile | default: 36 }}px; line-height: 1.08; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .ebr__heading { font-size: {{ st.heading_size | default: 52 }}px; } }
  #shopify-section-{{ sid }} .ebr__heading em { font-style: italic; color: var(--ebr-accent); }
  #shopify-section-{{ sid }} .ebr__note { margin: 0; max-width: 34ch; color: var(--color-text); font-size: 14px; line-height: 1.55; }
  #shopify-section-{{ sid }} .ebr__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 18px; }
  @media (min-width: 750px) { #shopify-section-{{ sid }} .ebr__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .ebr__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; } }
  #shopify-section-{{ sid }} .ebr__card { margin: 0; display: flex; flex-direction: column; padding: 26px; border-radius: 10px; background: {{ st.card_color | default: '#f7f4ee' }}; }
  #shopify-section-{{ sid }} .ebr__stars { display: flex; gap: 3px; margin-bottom: 16px; color: {{ st.star_color | default: '#b8863f' }}; }
  #shopify-section-{{ sid }} .ebr__stars svg { width: 15px; height: 15px; }
  #shopify-section-{{ sid }} .ebr__quote { margin: 0 0 20px; padding: 0; border: 0; background: none; color: var(--color-heading); font-family: var(--heading-font, inherit); font-size: 21px; line-height: 1.45; }
  #shopify-section-{{ sid }} .ebr__who { margin-top: auto; font-size: 14px; color: var(--color-text); }
  #shopify-section-{{ sid }} .ebr__who strong { display: block; color: var(--color-heading); font-weight: 600; }
</style>

<div class="ebr color-{{ color_scheme }}" data-section-id="{{ sid }}">
  <div class="ebr__inner">
    <div class="ebr__head">
      <div>
        {%- if st.eyebrow != blank -%}<p class="ebr__eyebrow">{{ st.eyebrow | escape }}</p>{%- endif -%}
        {%- if st.heading != blank -%}<h2 class="ebr__heading">{{ st.heading }}</h2>{%- endif -%}
      </div>
      {%- if st.note != blank -%}<p class="ebr__note">{{ st.note | escape }}</p>{%- endif -%}
    </div>
    <div class="ebr__grid">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <figure class="ebr__card" {{ block.shopify_attributes }}>
          {%- if st.show_stars -%}
            <div class="ebr__stars" aria-hidden="true">{%- for i in (1..5) -%}<svg viewBox="0 0 20 20" fill="currentColor" focusable="false"><path d="M10 1.6l2.5 5.4 5.9.6-4.4 4 1.3 5.8L10 14.5l-5.3 2.9L6 11.6 1.6 7.6l5.9-.6z"/></svg>{%- endfor -%}</div>
          {%- endif -%}
          <blockquote class="ebr__quote">{{ b.quote | escape }}</blockquote>
          <figcaption class="ebr__who"><strong>{{ b.name | escape }}</strong>{{ b.detail | escape }}</figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Ebook reader reviews",
  "tag": "section",
  "class": "section sec__ebook-reviews",
  "max_blocks": 9,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default-color-scheme" },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "card_color", "label": "Card colour", "default": "#f7f4ee" },
    { "type": "color", "id": "accent_color", "label": "Accent colour", "default": "#9a6a32" },
    { "type": "color", "id": "star_color", "label": "Star colour", "default": "#b8863f" },
    { "type": "checkbox", "id": "show_stars", "label": "Show stars", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Readers" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "What readers <em>say</em>" },
    { "type": "text", "id": "note", "label": "Small note", "default": "Sample reviews. Replace them with what your readers write." },
    { "type": "range", "id": "heading_size", "label": "Heading size, desktop", "min": 28, "max": 72, "step": 2, "unit": "px", "default": 52 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size, phone", "min": 24, "max": 48, "step": 2, "unit": "px", "default": 36 },
    { "type": "range", "id": "padding_top", "label": "Space above, desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Space below, desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_top_mobile", "label": "Space above, phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Space below, phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "A reader's words about the book." },
        { "type": "text", "id": "name", "label": "Name", "default": "Reader's name" },
        { "type": "text", "id": "detail", "label": "Detail", "default": "What they do" }
      ]
    }
  ],
  "presets": [
    { "name": "Ebook reader reviews", "blocks": [ { "type": "review" }, { "type": "review" }, { "type": "review" } ] }
  ]
}
{% endschema %}
