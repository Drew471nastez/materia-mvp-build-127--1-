{%- comment -%}
  Content creator: the first screen. On the left a small greeting with a
  round portrait, a large heading whose marked words take the accent, a
  line, the email field and its button on one line (stacked on a phone), a
  note and the creator's social links. On the right a tall rounded photo
  with two small cards floating on it: a latest video and a podcast. The
  cards drift slowly; nothing moves with reduced motion.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
  assign color_scheme = st.color_scheme.id | default: st.color_scheme | default: 'default-color-scheme'
  assign placeholder = 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 800 1000%22%3E%3Crect width=%22800%22 height=%221000%22 fill=%22%23e9e7e1%22/%3E%3Ccircle cx=%22400%22 cy=%22380%22 r=%2290%22 fill=%22%23d6d3cb%22/%3E%3Cpath d=%22M220 760c20-130 90-200 180-200s160 70 180 200z%22 fill=%22%23d6d3cb%22/%3E%3C/svg%3E'
-%}
<style>
  #shopify-section-{{ sid }} .cph { --cph-accent: {{ st.accent_color | default: '#ff5a36' }}; --cph-btn: {{ st.button_color | default: '#101114' }}; --cph-btn-text: {{ st.button_text_color | default: '#ffffff' }}; background: {{ st.background | default: '#ffffff' }}; padding: {{ st.padding_top_mobile | default: 28 }}px 20px {{ st.padding_bottom_mobile | default: 56 }}px; overflow: hidden; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .cph { padding: {{ st.padding_top | default: 48 }}px 40px {{ st.padding_bottom | default: 96 }}px; } }
  #shopify-section-{{ sid }} .cph__inner { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: minmax(0, 1fr); gap: 40px; align-items: center; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .cph__inner { grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: 72px; } }
  #shopify-section-{{ sid }} .cph__hi { display: inline-flex; align-items: center; gap: 10px; margin: 0 0 22px; padding: 5px 16px 5px 5px; border-radius: 999px; background: {{ st.soft_color | default: '#f5f4f0' }}; color: var(--color-heading); font-size: 15px; font-weight: 600; }
  #shopify-section-{{ sid }} .cph__hi img { width: 34px; height: 34px; border-radius: 50%; object-fit: cover; margin: 0; }
  #shopify-section-{{ sid }} .cph__hi i { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #22c55e; box-shadow: 0 0 0 4px rgba(34,197,94,0.18); font-style: normal; }
  #shopify-section-{{ sid }} .cph__heading { margin: 0; color: var(--color-heading); font-family: var(--heading-font, inherit); font-weight: var(--heading-weight, 700); font-size: {{ st.heading_size_mobile | default: 42 }}px; line-height: 1.02; letter-spacing: -0.035em; text-wrap: balance; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .cph__heading { font-size: {{ st.heading_size | default: 72 }}px; } }
  #shopify-section-{{ sid }} .cph__heading em { font-style: normal; color: var(--cph-accent); }
  #shopify-section-{{ sid }} .cph__text { margin-top: 20px; max-width: 46ch; color: var(--color-text); font-size: 18px; line-height: 1.6; }
  #shopify-section-{{ sid }} .cph__text p { margin: 0; }
  #shopify-section-{{ sid }} .cph__form { margin-top: 28px; max-width: 500px; }
  #shopify-section-{{ sid }} .cph__row { display: flex; flex-direction: column; align-items: stretch; gap: 10px; }
  @media (min-width: 600px) { #shopify-section-{{ sid }} .cph__row { flex-direction: row; gap: 8px; } }
  #shopify-section-{{ sid }} .cph__input { flex: 1 1 auto; min-width: 0; box-sizing: border-box; height: 56px !important; margin: 0; padding: 0 20px; border: 1.5px solid {{ st.field_border | default: '#dedcd5' }}; border-radius: {{ st.radius | default: 12 }}px; background: #fff; font: inherit; font-size: 16px; color: var(--color-heading); }
  #shopify-section-{{ sid }} .cph__input:focus-visible { outline: 2px solid var(--cph-accent); outline-offset: 1px; }
  #shopify-section-{{ sid }} .cph__submit { flex: 0 0 auto; height: 56px; margin: 0; padding: 0 24px; border: 0; border-radius: {{ st.radius | default: 12 }}px; cursor: pointer; white-space: nowrap; background: var(--cph-btn); color: var(--cph-btn-text); font: inherit; font-size: 15.5px; font-weight: 700; transition: transform 0.2s ease, background-color 0.2s ease; }
  #shopify-section-{{ sid }} .cph__submit:hover { background: var(--cph-accent); }
  #shopify-section-{{ sid }} .cph__note { margin: 12px 0 0; color: var(--color-text); font-size: 14px; }
  #shopify-section-{{ sid }} .cph__msg { margin: 10px 0 0; font-size: 14px; color: var(--color-heading); }
  #shopify-section-{{ sid }} .cph__hp, #shopify-section-{{ sid }} .cph__vh { position: absolute !important; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  #shopify-section-{{ sid }} .cph__social { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 18px; margin: 30px 0 0; padding: 0; list-style: none; }
  #shopify-section-{{ sid }} .cph__social a { display: inline-flex; align-items: center; gap: 8px; color: var(--color-heading); font-size: 14.5px; font-weight: 600; text-decoration: none; }
  #shopify-section-{{ sid }} .cph__social a:hover { color: var(--cph-accent); }
  #shopify-section-{{ sid }} .cph__social svg { width: 18px; height: 18px; }
  #shopify-section-{{ sid }} .cph__media { position: relative; margin: 0; }
  #shopify-section-{{ sid }} .cph__frame { position: relative; overflow: hidden; border-radius: {{ st.image_radius | default: 28 }}px; aspect-ratio: 4 / 5; background: #e9e7e1; }
  #shopify-section-{{ sid }} .cph__frame img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: {{ st.image_focus | default: '50% 30%' }}; margin: 0; }
  #shopify-section-{{ sid }} .cph__card { position: absolute; z-index: 2; display: flex; align-items: center; gap: 12px; max-width: 250px; padding: 10px 16px 10px 10px; border-radius: 16px; background: #fff; color: var(--color-heading); text-decoration: none; box-shadow: 0 1px 2px rgba(16,17,20,0.06), 0 18px 40px -16px rgba(16,17,20,0.35); animation: cph-float-{{ sid }} 6s ease-in-out infinite; }
  #shopify-section-{{ sid }} .cph__card--a { left: -14px; bottom: 34px; }
  #shopify-section-{{ sid }} .cph__card--b { right: -10px; top: 30px; animation-delay: -3s; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .cph__card--a { left: -44px; } #shopify-section-{{ sid }} .cph__card--b { right: -28px; } }
  #shopify-section-{{ sid }} .cph__card-icon { flex: 0 0 44px; width: 44px; height: 44px; border-radius: 12px; display: grid; place-items: center; background: var(--cph-accent); color: #fff; }
  #shopify-section-{{ sid }} .cph__card--b .cph__card-icon { background: var(--color-heading); }
  #shopify-section-{{ sid }} .cph__card-icon svg { width: 20px; height: 20px; }
  #shopify-section-{{ sid }} .cph__card small { display: block; color: var(--color-text); font-size: 12px; font-weight: 500; }
  #shopify-section-{{ sid }} .cph__card strong { display: block; font-size: 14px; line-height: 1.3; }
  @keyframes cph-float-{{ sid }} { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }
  @media (prefers-reduced-motion: reduce) { #shopify-section-{{ sid }} .cph__card { animation: none; } }
</style>
<div class="cph color-{{ color_scheme }}" data-section-id="{{ sid }}">
  <div class="cph__inner">
    <div>
      {%- if st.greeting != blank -%}<p class="cph__hi">{%- if st.avatar != blank -%}<img src="{{ st.avatar | image_url: width: 120 }}" width="120" height="120" alt="">{%- else -%}<i aria-hidden="true"></i>{%- endif -%}{{ st.greeting | escape }}</p>{%- endif -%}
      {%- if st.heading != blank -%}<h1 class="cph__heading">{{ st.heading }}</h1>{%- endif -%}
      {%- if st.text != blank -%}<div class="cph__text">{{ st.text }}</div>{%- endif -%}
      {%- if st.show_form -%}
        {%- form 'customer', id: 'CreatorHeroForm-' | append: sid, class: 'cph__form', data-storelib-form: 'subscribe' -%}
          <input type="hidden" name="contact[tags]" value="{{ st.tag | default: 'newsletter' | escape }}">
          <span hidden data-mt-words data-success-message="{{ st.success_text | default: 'You are in. Check your inbox.' | escape }}" data-invalid-message="{{ st.invalid_text | default: 'Enter a valid email address.' | escape }}"></span>
          <div class="cph__hp" aria-hidden="true" data-mt-trap><label for="CreatorHeroHp-{{ sid }}">Leave this field empty</label><input id="CreatorHeroHp-{{ sid }}" type="text" name="company" tabindex="-1" autocomplete="off" pattern="^$" maxlength="0" value=""></div>
          <div class="cph__row">
            <label class="cph__vh" for="CreatorHeroEmail-{{ sid }}">{{ st.email_placeholder | default: 'Your email' | escape }}</label>
            <input class="cph__input" id="CreatorHeroEmail-{{ sid }}" type="email" name="contact[email]" required inputmode="email" autocomplete="email" autocapitalize="off" spellcheck="false" maxlength="254" placeholder="{{ st.email_placeholder | default: 'Your email' | escape }}">
            <button type="submit" class="cph__submit">{{ st.button_label | default: 'Join the letter' | escape }}</button>
          </div>
          {%- if form.posted_successfully? -%}<p class="cph__msg form-status--success">{{ st.success_text | default: 'You are in. Check your inbox.' | escape }}</p>{%- endif -%}
          {%- if form.errors -%}<p class="cph__msg" role="alert">{{ st.invalid_text | default: 'Enter a valid email address.' | escape }}</p>{%- endif -%}
        {%- endform -%}
        {%- if st.note != blank -%}<p class="cph__note">{{ st.note | escape }}</p>{%- endif -%}
      {%- endif -%}
      <ul class="cph__social" role="list">
        {%- if st.youtube != blank -%}<li><a href="{{ st.youtube }}" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23 7.2a3 3 0 0 0-2.1-2.1C19 4.6 12 4.6 12 4.6s-7 0-8.9.5A3 3 0 0 0 1 7.2 31 31 0 0 0 .5 12a31 31 0 0 0 .5 4.8 3 3 0 0 0 2.1 2.1c1.9.5 8.9.5 8.9.5s7 0 8.9-.5a3 3 0 0 0 2.1-2.1 31 31 0 0 0 .5-4.8 31 31 0 0 0-.5-4.8zM9.7 15.1V8.9L15.5 12z"/></svg>YouTube</a></li>{%- endif -%}
        {%- if st.instagram != blank -%}<li><a href="{{ st.instagram }}" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>Instagram</a></li>{%- endif -%}
        {%- if st.tiktok != blank -%}<li><a href="{{ st.tiktok }}" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.6 3c.3 2.3 1.7 3.9 4 4.1v3.1a7 7 0 0 1-4-1.3v6.2c0 3.5-2.6 5.9-5.8 5.9A5.8 5.8 0 0 1 5 15.2c0-3.4 2.9-6 6.4-5.6v3.2c-1.6-.4-3.2.7-3.2 2.4 0 1.5 1.2 2.6 2.6 2.6 1.6 0 2.7-1.1 2.7-3V3z"/></svg>TikTok</a></li>{%- endif -%}
        {%- if st.linkedin != blank -%}<li><a href="{{ st.linkedin }}" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9.5h4V21H3zM9.5 9.5h3.8v1.6h.1c.5-1 1.8-2 3.8-2 4 0 4.8 2.6 4.8 6V21h-4v-5.2c0-1.3 0-2.9-1.8-2.9s-2 1.4-2 2.8V21h-4z"/></svg>LinkedIn</a></li>{%- endif -%}
        {%- if st.podcast_link != blank -%}<li><a href="{{ st.podcast_link }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="9" y="2.5" width="6" height="11" rx="3"/><path d="M5.5 11a6.5 6.5 0 0 0 13 0M12 17.5V21"/></svg>Podcast</a></li>{%- endif -%}
      </ul>
    </div>
    <figure class="cph__media">
      <div class="cph__frame">
        {%- if st.image != blank -%}
          <img src="{{ st.image | image_url: width: 1000 }}" srcset="{{ st.image | image_url: width: 600 }} 600w, {{ st.image | image_url: width: 1000 }} 1000w" sizes="(min-width: 990px) 500px, 92vw" width="1000" height="1250" alt="{{ st.image_alt | default: st.image.alt | escape }}" loading="eager" fetchpriority="high" decoding="async">
        {%- else -%}<img src="{{ placeholder }}" width="800" height="1000" alt="">{%- endif -%}
      </div>
      {%- if st.card_a_title != blank -%}
        <a class="cph__card cph__card--a" href="{{ st.card_a_link | default: '/#videos' }}"><span class="cph__card-icon" aria-hidden="true"><svg viewBox="0 0 20 20" fill="currentColor"><path d="M6 4.5v11l9-5.5z"/></svg></span><span><small>{{ st.card_a_label | escape }}</small><strong>{{ st.card_a_title | escape }}</strong></span></a>
      {%- endif -%}
      {%- if st.card_b_title != blank -%}
        <a class="cph__card cph__card--b" href="{{ st.card_b_link | default: '/#podcast' }}"><span class="cph__card-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="9" y="2.5" width="6" height="11" rx="3"/><path d="M5.5 11a6.5 6.5 0 0 0 13 0M12 17.5V21"/></svg></span><span><small>{{ st.card_b_label | escape }}</small><strong>{{ st.card_b_title | escape }}</strong></span></a>
      {%- endif -%}
    </figure>
  </div>
</div>
{% schema %}
{
  "name": "Creator hero",
  "tag": "section",
  "class": "section sec__creatorpro-hero",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default-color-scheme" },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "soft_color", "label": "Greeting background", "default": "#f5f4f0" },
    { "type": "color", "id": "accent_color", "label": "Accent (marked words, button hover)", "default": "#ff5a36" },
    { "type": "header", "content": "Text" },
    { "type": "image_picker", "id": "avatar", "label": "Small round portrait in the greeting" },
    { "type": "text", "id": "greeting", "label": "Greeting", "default": "Hi, I'm your name" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "info": "Words in italics take the accent colour.", "default": "Say what you help people <em>do</em>" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>One or two lines on what you make and who it is for.</p>" },
    { "type": "header", "content": "Email" },
    { "type": "checkbox", "id": "show_form", "label": "Show the email field", "default": true },
    { "type": "text", "id": "email_placeholder", "label": "Email field", "default": "Your email" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Join the letter" },
    { "type": "color", "id": "button_color", "label": "Button colour", "default": "#101114" },
    { "type": "color", "id": "button_text_color", "label": "Button text colour", "default": "#ffffff" },
    { "type": "color", "id": "field_border", "label": "Field border", "default": "#dedcd5" },
    { "type": "range", "id": "radius", "label": "Field and button corners", "min": 0, "max": 28, "step": 1, "unit": "px", "default": 12 },
    { "type": "text", "id": "tag", "label": "Tag for the people who sign up", "default": "newsletter" },
    { "type": "text", "id": "note", "label": "Small note", "default": "Free, every week. Leave whenever you like." },
    { "type": "text", "id": "success_text", "label": "Message after signing up", "default": "You are in. Check your inbox." },
    { "type": "text", "id": "invalid_text", "label": "Message for an address that will not work", "default": "Enter a valid email address." },
    { "type": "header", "content": "Social links" },
    { "type": "url", "id": "youtube", "label": "YouTube" },
    { "type": "url", "id": "instagram", "label": "Instagram" },
    { "type": "url", "id": "tiktok", "label": "TikTok" },
    { "type": "url", "id": "linkedin", "label": "LinkedIn" },
    { "type": "url", "id": "podcast_link", "label": "Podcast" },
    { "type": "header", "content": "Photo" },
    { "type": "image_picker", "id": "image", "label": "Picture" },
    { "type": "text", "id": "image_alt", "label": "Alt text" },
    { "type": "text", "id": "image_focus", "label": "Focus point (x% y%)", "default": "50% 30%" },
    { "type": "range", "id": "image_radius", "label": "Corners", "min": 0, "max": 48, "step": 2, "unit": "px", "default": 28 },
    { "type": "text", "id": "card_a_label", "label": "First card, small line", "default": "Latest video" },
    { "type": "text", "id": "card_a_title", "label": "First card, title", "default": "A video title" },
    { "type": "url", "id": "card_a_link", "label": "First card link" },
    { "type": "text", "id": "card_b_label", "label": "Second card, small line", "default": "New episode" },
    { "type": "text", "id": "card_b_title", "label": "Second card, title", "default": "A podcast episode" },
    { "type": "url", "id": "card_b_link", "label": "Second card link" },
    { "type": "header", "content": "Size and space" },
    { "type": "range", "id": "heading_size", "label": "Heading size, desktop", "min": 40, "max": 110, "step": 2, "unit": "px", "default": 72 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size, phone", "min": 30, "max": 64, "step": 2, "unit": "px", "default": 42 },
    { "type": "range", "id": "padding_top", "label": "Space above, desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Space below, desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_top_mobile", "label": "Space above, phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 28 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Space below, phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "presets": [ { "name": "Creator hero" } ]
}
{% endschema %}
