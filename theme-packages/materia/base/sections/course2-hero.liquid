{%- comment -%}
  Online course: the first screen. A rounded picture on a coloured ground on
  one side; on the other a small outlined label, a heading whose last words
  take the accent colour, a short paragraph, one button and a few short
  promises with ticks. The button goes straight to checkout with the course
  picked in "Course" (the shop's first product when none is picked); with no
  product it follows its own link. Things below the first screen rise in as
  they are scrolled to; nothing moves with reduced motion or in the editor.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign sid = section.id
  assign p = s.product
  assign buy = s.button_link | default: '/collections/all'
  if s.to_checkout and p != blank and p.title != blank
    assign v = p.selected_or_first_available_variant
    if v.id != blank
      assign buy = '/cart/' | append: v.id | append: ':1'
    endif
  endif
  assign notes = s.notes | newline_to_br | split: '<br />'
-%}
<style>
  #shopify-section-{{ sid }} .c2h {
    --c2-accent: {{ s.accent | default: '#12704f' }};
    --c2-ink: {{ s.heading_color | default: '#15171a' }};
    --c2-text: {{ s.text_color | default: '#3f444c' }};
    --c2-line: {{ s.line_color | default: '#d9dce1' }};
    position: relative; overflow: hidden;
    background: {{ s.background | default: '#ffffff' }};
    color: var(--c2-text);
    padding: {{ s.padding_top_mobile | default: 24 }}px 0 {{ s.padding_bottom_mobile | default: 56 }}px;
  }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .c2h { padding: {{ s.padding_top | default: 56 }}px 0 {{ s.padding_bottom | default: 96 }}px; } }
  #shopify-section-{{ sid }} .c2h__in { position: relative; max-width: 1200px; margin: 0 auto; padding: 0 20px; display: grid; gap: 32px; align-items: center; }
  @media (min-width: 990px) {
    #shopify-section-{{ sid }} .c2h__in { padding: 0 40px; grid-template-columns: minmax(0, 1fr) minmax(0, 1.02fr); gap: 72px; }
    #shopify-section-{{ sid }} .c2h[data-side='right'] .c2h__media { order: 2; }
  }
  #shopify-section-{{ sid }} .c2h__glow { position: absolute; pointer-events: none; width: 760px; height: 760px; right: -220px; top: 50%; transform: translateY(-50%); border-radius: 50%; background: radial-gradient(closest-side, color-mix(in srgb, var(--c2-accent) 11%, transparent), transparent); }
  #shopify-section-{{ sid }} .c2h__media { position: relative; margin: 0; border-radius: 18px; overflow: hidden; background: {{ s.image_ground | default: '#12704f' }}; aspect-ratio: {{ s.image_ratio | default: '15 / 16' }}; }
  #shopify-section-{{ sid }} .c2h__media img { display: block; width: 100%; height: 100%; object-fit: cover; margin: 0; }
  #shopify-section-{{ sid }} .c2-tag { display: inline-block; margin: 0 0 22px; padding: 8px 12px; border: 1px solid var(--c2-line); border-radius: 6px; background: rgba(255,255,255,.6); font-size: 13px; line-height: 1; letter-spacing: .05em; text-transform: uppercase; color: var(--c2-ink); }
  #shopify-section-{{ sid }} .c2h__title { margin: 0 0 20px; color: var(--c2-ink); font-family: var(--heading-font, inherit); font-weight: 700; font-size: {{ s.heading_size_mobile | default: 40 }}px; line-height: 1.04; letter-spacing: -.035em; text-wrap: balance; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .c2h__title { font-size: {{ s.heading_size | default: 64 }}px; } }
  #shopify-section-{{ sid }} .c2h__title em { font-style: normal; color: var(--c2-accent); }
  #shopify-section-{{ sid }} .c2h__text { max-width: 34em; font-size: 17px; line-height: 1.6; }
  #shopify-section-{{ sid }} .c2h__text p { margin: 0 0 12px; }
  #shopify-section-{{ sid }} .c2h__actions { margin-top: 30px; display: flex; flex-wrap: wrap; align-items: center; gap: 14px 22px; }
  #shopify-section-{{ sid }} .c2-btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 56px; padding: 0 30px; border-radius: 10px; background: var(--c2-accent); color: #fff; font-size: 16px; font-weight: 600; text-decoration: none; transition: transform .25s ease, filter .25s ease; }
  #shopify-section-{{ sid }} .c2-btn:hover { transform: translateY(-1px); filter: brightness(.92); }
  #shopify-section-{{ sid }} .c2h__price { font-size: 15px; color: var(--c2-text); }
  #shopify-section-{{ sid }} .c2h__price strong { color: var(--c2-ink); font-size: 18px; }
  #shopify-section-{{ sid }} .c2h__price s { margin-left: 6px; opacity: .7; }
  #shopify-section-{{ sid }} .c2h__notes { margin: 28px 0 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 10px 22px; font-size: 14px; color: var(--c2-ink); }
  #shopify-section-{{ sid }} .c2h__notes li { display: inline-flex; align-items: center; gap: 8px; }
  #shopify-section-{{ sid }} .c2h__notes svg { width: 16px; height: 16px; color: var(--c2-accent); flex: none; }
  @media (max-width: 989px) { #shopify-section-{{ sid }} .c2-btn { width: 100%; } }
  #shopify-section-{{ sid }} [data-c2r].c2r-wait { opacity: 0; transform: translate3d(0, 22px, 0); }
  #shopify-section-{{ sid }} [data-c2r].c2r-in { opacity: 1; transform: none; transition: opacity .8s cubic-bezier(.2,.65,.25,1) var(--d, 0ms), transform .8s cubic-bezier(.2,.65,.25,1) var(--d, 0ms); }
  @media (prefers-reduced-motion: reduce) { #shopify-section-{{ sid }} .c2-btn { transition: none; } }
</style>
<section class="c2h" data-side="{{ s.image_side | default: 'left' }}">
  <div class="c2h__glow" aria-hidden="true"></div>
  <div class="c2h__in">
    <figure class="c2h__media" data-c2r>
      {%- if s.image != blank -%}
        <img src="{{ s.image | image_url: width: 1400 }}" srcset="{{ s.image | image_url: width: 700 }} 700w, {{ s.image | image_url: width: 1000 }} 1000w, {{ s.image | image_url: width: 1400 }} 1400w" sizes="(min-width: 990px) 560px, 92vw" width="{{ s.image.width | default: 1400 }}" height="{{ s.image.height | default: 1500 }}" alt="{{ s.image_alt | default: s.image.alt | escape }}" loading="eager" fetchpriority="high" decoding="async">
      {%- endif -%}
    </figure>
    <div class="c2h__body">
      {%- if s.tag != blank -%}<p class="c2-tag" data-c2r>{{ s.tag | escape }}</p>{%- endif -%}
      <h1 class="c2h__title" data-c2r style="--d: 60ms">{{ s.heading | escape }}{% if s.heading_accent != blank %} <em>{{ s.heading_accent | escape }}</em>{% endif %}</h1>
      {%- if s.text != blank -%}<div class="c2h__text" data-c2r style="--d: 120ms">{{ s.text }}</div>{%- endif -%}
      <div class="c2h__actions" data-c2r style="--d: 180ms">
        {%- if s.button_label != blank -%}<a class="c2-btn" href="{{ buy }}">{{ s.button_label | escape }}</a>{%- endif -%}
        {%- if s.show_price and p != blank and p.title != blank -%}
          <span class="c2h__price"><strong>{{ p.price | money_without_trailing_zeros }}</strong>{% if p.compare_at_price > p.price %}<s><span class="visually-hidden">Was </span>{{ p.compare_at_price | money_without_trailing_zeros }}</s>{% endif %}{% if s.price_note != blank %} {{ s.price_note | escape }}{% endif %}</span>
        {%- endif -%}
      </div>
      {%- if s.notes != blank -%}
        <ul class="c2h__notes" role="list" data-c2r style="--d: 240ms">
          {%- for line in notes -%}
            {%- assign t = line | strip -%}
            {%- if t != blank -%}<li><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 8.5l3.2 3L13 4.5"/></svg>{{ t | escape }}</li>{%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</section>
{%- unless request.design_mode -%}
<script>(function(){var r=document.getElementById('shopify-section-{{ sid }}');if(!r||!('IntersectionObserver' in window)||matchMedia('(prefers-reduced-motion: reduce)').matches)return;var h=innerHeight,io=new IntersectionObserver(function(es){es.forEach(function(e){if(!e.isIntersecting)return;var t=e.target;io.unobserve(t);requestAnimationFrame(function(){t.classList.add('c2r-in')})})},{rootMargin:'0px 0px -6% 0px'});r.querySelectorAll('[data-c2r]').forEach(function(el){if(el.getBoundingClientRect().top<h*.92)return;el.classList.add('c2r-wait');io.observe(el)})})();</script>
{%- endunless -%}

{% schema %}
{
  "name": "Course hero",
  "tag": "section",
  "class": "course2-hero-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "tag", "label": "Label above", "default": "Online course" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Learn the thing you keep putting off," },
    { "type": "text", "id": "heading_accent", "label": "Heading words in the accent colour", "default": "one lesson a day" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Say who the course is for and what they can do at the end, in two sentences.</p>" },
    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_label", "label": "Label", "default": "Buy the course" },
    { "type": "product", "id": "product", "label": "Course", "info": "The button goes straight to checkout with this product. Your first product when none is picked." },
    { "type": "checkbox", "id": "to_checkout", "label": "Button goes straight to checkout", "default": true },
    { "type": "url", "id": "button_link", "label": "Link when there is no product" },
    { "type": "checkbox", "id": "show_price", "label": "Show the price beside the button", "default": true },
    { "type": "text", "id": "price_note", "label": "Words after the price", "default": "one payment" },
    { "type": "textarea", "id": "notes", "label": "Short promises", "info": "One per line, each shown with a tick.", "default": "Lifetime access\nWatch on any device\n30 day refund" },
    { "type": "header", "content": "Picture" },
    { "type": "image_picker", "id": "image", "label": "Picture" },
    { "type": "text", "id": "image_alt", "label": "Picture description" },
    { "type": "select", "id": "image_side", "label": "Picture side", "default": "left", "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ] },
    { "type": "select", "id": "image_ratio", "label": "Picture shape", "default": "15 / 16", "options": [ { "value": "1 / 1", "label": "Square" }, { "value": "15 / 16", "label": "Nearly square" }, { "value": "4 / 5", "label": "Portrait" }, { "value": "4 / 3", "label": "Landscape" } ] },
    { "type": "color", "id": "image_ground", "label": "Ground behind the picture", "default": "#12704f" },
    { "type": "header", "content": "Type" },
    { "type": "range", "id": "heading_size", "label": "Heading size on desktop", "min": 36, "max": 88, "step": 2, "unit": "px", "default": 64 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size on phones", "min": 28, "max": 56, "step": 2, "unit": "px", "default": 40 },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#12704f" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#15171a" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#3f444c" },
    { "type": "color", "id": "line_color", "label": "Label outline", "default": "#d9dce1" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Space above on desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Space below on desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_top_mobile", "label": "Space above on phones", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Space below on phones", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "presets": [ { "name": "Course hero", "category": "Online course" } ]
}
{% endschema %}
