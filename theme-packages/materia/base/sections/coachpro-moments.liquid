{%- comment -%}
  Coach creator: moments. A loose wall of photographs in three rows of
  different rhythms (a wide one, then tall ones), each with an optional
  short caption that appears on hover on a computer and stays visible on a
  phone. Pictures are blocks; six fill the wall, any number works.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sid = section.id
-%}
<style>
  #shopify-section-{{ sid }} .cpm { background: {{ st.background | default: '#fbf8f4' }}; padding: {{ st.padding_top_mobile | default: 48 }}px 12px {{ st.padding_bottom_mobile | default: 48 }}px; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .cpm { padding: {{ st.padding_top | default: 88 }}px 32px {{ st.padding_bottom | default: 88 }}px; } }
  #shopify-section-{{ sid }} .cpm__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 12px 24px; max-width: 1240px; margin: 0 auto 26px; padding: 0 8px; }
  #shopify-section-{{ sid }} .cpm__title { margin: 0; color: {{ st.heading_color | default: '#16120f' }}; font-family: var(--heading-font, serif); font-weight: 400; font-size: 36px; line-height: 1.05; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .cpm__title { font-size: 52px; } }
  #shopify-section-{{ sid }} .cpm__link { color: {{ st.heading_color | default: '#16120f' }}; font-size: 15px; font-weight: 600; text-underline-offset: 5px; }
  #shopify-section-{{ sid }} .cpm__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; max-width: 1240px; margin: 0 auto; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .cpm__grid { grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 14px; } }
  #shopify-section-{{ sid }} .cpm__item { position: relative; margin: 0; overflow: hidden; border-radius: 14px; background: #e8ddd0; aspect-ratio: 4 / 5; }
  #shopify-section-{{ sid }} .cpm__item:nth-child(6n+1), #shopify-section-{{ sid }} .cpm__item:nth-child(6n) { grid-column: span 2; aspect-ratio: 3 / 2; }
  @media (min-width: 990px) {
    #shopify-section-{{ sid }} .cpm__item { border-radius: 18px; }
    #shopify-section-{{ sid }} .cpm__item:nth-child(6n+1) { grid-column: span 5; aspect-ratio: auto; }
    #shopify-section-{{ sid }} .cpm__item:nth-child(6n+2), #shopify-section-{{ sid }} .cpm__item:nth-child(6n+3) { grid-column: span 3 / span 3; aspect-ratio: 4 / 5; }
    #shopify-section-{{ sid }} .cpm__item:nth-child(6n+3) { grid-column: span 4; aspect-ratio: auto; }
    #shopify-section-{{ sid }} .cpm__item:nth-child(6n+4) { grid-column: span 4; aspect-ratio: 4 / 5; }
    #shopify-section-{{ sid }} .cpm__item:nth-child(6n+5) { grid-column: span 3; aspect-ratio: auto; }
    #shopify-section-{{ sid }} .cpm__item:nth-child(6n) { grid-column: span 5; aspect-ratio: auto; }
  }
  #shopify-section-{{ sid }} .cpm__item img, #shopify-section-{{ sid }} .cpm__item svg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s cubic-bezier(.2,.65,.25,1); }
  #shopify-section-{{ sid }} .cpm__item:hover img { transform: scale(1.035); }
  #shopify-section-{{ sid }} .cpm__cap { position: absolute; left: 10px; bottom: 10px; max-width: calc(100% - 20px); padding: 7px 11px; border-radius: 999px; background: rgba(255,255,255,.92); color: #16120f; font-size: 12.5px; font-weight: 600; line-height: 1.3; }
  @media (hover: hover) and (min-width: 990px) { #shopify-section-{{ sid }} .cpm__cap { opacity: 0; transform: translateY(6px); transition: opacity .3s ease, transform .3s ease; } #shopify-section-{{ sid }} .cpm__item:hover .cpm__cap { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { #shopify-section-{{ sid }} .cpm__item img, #shopify-section-{{ sid }} .cpm__cap { transition: none; } }
</style>
<section data-own-size class="cpm">
  {%- if st.heading != blank or st.link_label != blank -%}
    <div class="cpm__head">
      {%- if st.heading != blank -%}<h2 class="cpm__title">{{ st.heading | escape }}</h2>{%- endif -%}
      {%- if st.link_label != blank -%}<a class="cpm__link" href="{{ st.link_url | default: '#' }}">{{ st.link_label | escape }}</a>{%- endif -%}
    </div>
  {%- endif -%}
  <div class="cpm__grid">
    {%- for block in section.blocks -%}
      <figure class="cpm__item" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <img src="{{ block.settings.image | image_url: width: 900 }}" srcset="{{ block.settings.image | image_url: width: 480 }} 480w, {{ block.settings.image | image_url: width: 900 }} 900w" sizes="(min-width: 990px) 40vw, 50vw" width="{{ block.settings.image.width | default: 900 }}" height="{{ block.settings.image.height | default: 1100 }}" alt="{{ block.settings.alt | default: block.settings.image.alt | escape }}" loading="lazy" decoding="async">
        {%- else -%}
          {{ 'image' | placeholder_svg_tag }}
        {%- endif -%}
        {%- if block.settings.caption != blank -%}<figcaption class="cpm__cap">{{ block.settings.caption | escape }}</figcaption>{%- endif -%}
      </figure>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Coach creator moments",
  "tag": "section",
  "class": "coachpro-moments-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Behind the scenes" },
    { "type": "text", "id": "link_label", "label": "Link", "default": "Follow along" },
    { "type": "url", "id": "link_url", "label": "Link goes to" },
    { "type": "color", "id": "background", "label": "Background", "default": "#fbf8f4" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#16120f" },
    { "type": "range", "id": "padding_top", "label": "Space above on a computer", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 88 },
    { "type": "range", "id": "padding_bottom", "label": "Space below on a computer", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 88 },
    { "type": "range", "id": "padding_top_mobile", "label": "Space above on a phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Space below on a phone", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    { "type": "photo", "name": "Photo", "limit": 12, "settings": [
      { "type": "image_picker", "id": "image", "label": "Picture" },
      { "type": "text", "id": "alt", "label": "Alt text" },
      { "type": "text", "id": "caption", "label": "Caption" }
    ] }
  ],
  "presets": [ { "name": "Coach creator moments", "category": "Coach creator", "blocks": [ { "type": "photo" }, { "type": "photo" }, { "type": "photo" }, { "type": "photo" }, { "type": "photo" }, { "type": "photo" } ] } ]
}
{% endschema %}
