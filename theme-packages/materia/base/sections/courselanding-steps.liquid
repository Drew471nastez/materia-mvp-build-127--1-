{%- comment -%}
  Course landing: how it works. A centred heading, then steps down a thin
  centre line: a numbered circle on the line, the words on one side and a
  screen in a dark frame on the other, sides swapping each step. The line
  fills with the accent colour as the page is scrolled (one transform, no
  layout work); each step rises in once. Under the steps, the button
  straight to checkout and a short line. On a phone the line runs down the
  left and every step reads words first, then its screen.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign sid = section.id
  assign p = s.product
  assign buy = s.button_link | default: '/collections/all'
  if s.to_checkout and p != blank and p.title != blank
    assign v = p.selected_or_first_available_variant
    if v.id != blank
      assign buy = '/cart/' | append: v.id | append: ':1'
    endif
  endif
-%}
<style>
  #shopify-section-{{ sid }} .cls {
    --cl-accent: {{ s.accent | default: '#2f5bea' }};
    --cl-ink: {{ s.heading_color | default: '#141416' }};
    --cl-text: {{ s.text_color | default: '#5a5a62' }};
    background: {{ s.background | default: '#f6f6f4' }};
    color: var(--cl-text);
    padding: {{ s.padding_top_mobile | default: 48 }}px 0 {{ s.padding_bottom_mobile | default: 48 }}px;
    scroll-margin-top: 100px;
  }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .cls { padding: {{ s.padding_top | default: 88 }}px 0 {{ s.padding_bottom | default: 88 }}px; } }
  #shopify-section-{{ sid }} .cls__in { max-width: 1104px; margin: 0 auto; padding: 0 20px; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .cls__in { padding: 0 32px; } }
  #shopify-section-{{ sid }} .cls__title { margin: 0 0 36px; text-align: center; color: var(--cl-ink); font-family: var(--heading-font, inherit); font-weight: 600; font-size: 32px; line-height: 1.1; letter-spacing: -.03em; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .cls__title { margin-bottom: 64px; font-size: 44px; } }
  #shopify-section-{{ sid }} .cls__title span { color: var(--cl-accent); }
  #shopify-section-{{ sid }} .cls__list { position: relative; }
  #shopify-section-{{ sid }} .cls__ol { position: relative; margin: 0; padding: 0; list-style: none; }
  #shopify-section-{{ sid }} .cls__line { position: absolute; top: 0; bottom: 0; left: 19px; width: 2px; background: color-mix(in srgb, var(--cl-accent) 14%, transparent); border-radius: 2px; overflow: hidden; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .cls__line { left: 50%; margin-left: -1px; } }
  #shopify-section-{{ sid }} .cls__fill { position: absolute; inset: 0; background: var(--cl-accent); transform-origin: top; transform: scaleY(var(--fill, 1)); }
  #shopify-section-{{ sid }} .cls__step { position: relative; display: grid; gap: 18px; padding: 0 0 44px 60px; }
  #shopify-section-{{ sid }} .cls__step:last-child { padding-bottom: 0; }
  @media (min-width: 990px) {
    #shopify-section-{{ sid }} .cls__step { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 120px; align-items: center; padding: 0 0 96px; }
    #shopify-section-{{ sid }} .cls__step:nth-child(odd) .cls__media { order: -1; }
  }
  #shopify-section-{{ sid }} .cls__num { position: absolute; left: 0; top: 0; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--cl-accent); color: #fff; font-size: 14px; font-weight: 700; font-variant-numeric: tabular-nums; box-shadow: 0 0 0 6px {{ s.background | default: '#f6f6f4' }}; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .cls__num { left: 50%; top: 50%; margin: -20px 0 0 -20px; } }
  #shopify-section-{{ sid }} .cls__label { margin: 0 0 8px; color: var(--cl-accent); font-size: 14px; font-weight: 600; }
  #shopify-section-{{ sid }} .cls__name { margin: 0 0 10px; color: var(--cl-ink); font-family: var(--heading-font, inherit); font-weight: 600; font-size: 24px; line-height: 1.2; letter-spacing: -.025em; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .cls__name { font-size: 30px; } }
  #shopify-section-{{ sid }} .cls__text { margin: 0; font-size: 16px; line-height: 1.6; max-width: 28em; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .cls__text { font-size: 17px; } }
  #shopify-section-{{ sid }} .cls__media { margin: 0; padding: 12px; border-radius: 22px; background: #151517; box-shadow: 0 30px 50px -30px rgba(20,20,30,.45); }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .cls__media { padding: 22px; border-radius: 26px; } }
  #shopify-section-{{ sid }} .cls__media img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; border-radius: 12px; margin: 0; }
  #shopify-section-{{ sid }} .cls__cta { margin-top: 48px; text-align: center; }
  @media (min-width: 990px) { #shopify-section-{{ sid }} .cls__cta { margin-top: 24px; } }
  #shopify-section-{{ sid }} .cl-btn { display: inline-flex; align-items: center; justify-content: center; gap: 12px; min-height: 60px; padding: 0 34px; border-radius: 14px; background: var(--cl-accent); color: #fff; font-size: 18px; font-weight: 600; text-decoration: none; box-shadow: 0 1px 0 rgba(255,255,255,.25) inset, 0 14px 34px -12px color-mix(in srgb, var(--cl-accent) 70%, transparent); transition: transform .25s ease, box-shadow .25s ease; }
  #shopify-section-{{ sid }} .cl-btn:hover { transform: translateY(-2px); }
  #shopify-section-{{ sid }} .cl-btn svg { width: 18px; height: 18px; }
  @media (max-width: 749px) { #shopify-section-{{ sid }} .cl-btn { width: 100%; } }
  #shopify-section-{{ sid }} .cls__note { margin: 14px 0 0; font-size: 14px; color: #6d6d74; }
  #shopify-section-{{ sid }} [data-clr].clr-wait { opacity: 0; transform: translate3d(0, 24px, 0); }
  #shopify-section-{{ sid }} [data-clr].clr-in { opacity: 1; transform: none; transition: opacity .85s cubic-bezier(.2,.65,.25,1) var(--d, 0ms), transform .85s cubic-bezier(.2,.65,.25,1) var(--d, 0ms); }
  @media (prefers-reduced-motion: reduce) { #shopify-section-{{ sid }} .cl-btn { transition: none; } }
</style>
<section class="cls"{% if s.anchor != blank %} id="{{ s.anchor | handleize }}"{% endif %}>
  <div class="cls__in">
    <h2 class="cls__title" data-clr>{{ s.heading | escape }}{% if s.heading_accent != blank %} <span>{{ s.heading_accent | escape }}</span>{% endif %}</h2>
    <div class="cls__list">
      <span class="cls__line" aria-hidden="true"><span class="cls__fill"></span></span>
      <ol class="cls__ol" role="list">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <li class="cls__step" {{ block.shopify_attributes }}>
          <span class="cls__num" aria-hidden="true">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
          <div data-clr>
            {%- if b.label != blank -%}<p class="cls__label">{{ b.label | escape }}</p>{%- endif -%}
            <h3 class="cls__name">{{ b.title | escape }}</h3>
            {%- if b.text != blank -%}<p class="cls__text">{{ b.text | escape }}</p>{%- endif -%}
          </div>
          <figure class="cls__media" data-clr style="--d: 100ms">
            {%- if b.image != blank -%}<img src="{{ b.image | image_url: width: 1200 }}" srcset="{{ b.image | image_url: width: 700 }} 700w, {{ b.image | image_url: width: 1200 }} 1200w, {{ b.image | image_url: width: 1600 }} 1600w" sizes="(min-width: 990px) 460px, 86vw" width="{{ b.image.width | default: 1600 }}" height="{{ b.image.height | default: 1000 }}" alt="{{ b.image_alt | default: b.image.alt | escape }}" loading="lazy" decoding="async">{%- endif -%}
          </figure>
        </li>
      {%- endfor -%}
      </ol>
    </div>
    {%- if s.button_label != blank -%}
      <div class="cls__cta" data-clr>
        <a class="cl-btn" href="{{ buy }}">{{ s.button_label | escape }}<svg viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3.5 9h11M10 4.5L14.5 9 10 13.5"/></svg></a>
        {%- if s.note != blank -%}<p class="cls__note">{{ s.note | escape }}</p>{%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>
{%- unless request.design_mode -%}
<script>(function(){var r=document.getElementById('shopify-section-{{ sid }}');if(!r||matchMedia('(prefers-reduced-motion: reduce)').matches)return;var list=r.querySelector('.cls__list'),fill=r.querySelector('.cls__fill');if(list&&fill){var tick=false,set=function(){tick=false;var b=list.getBoundingClientRect(),f=Math.min(1,Math.max(0,(innerHeight*.6-b.top)/b.height));fill.style.setProperty('--fill',f.toFixed(3))};set();addEventListener('scroll',function(){if(!tick){tick=true;requestAnimationFrame(set)}},{passive:true});addEventListener('resize',set)}if(!('IntersectionObserver' in window))return;var h=innerHeight,io=new IntersectionObserver(function(es){es.forEach(function(e){if(!e.isIntersecting)return;var t=e.target;io.unobserve(t);requestAnimationFrame(function(){t.classList.add('clr-in')})})},{rootMargin:'0px 0px -6% 0px'});r.querySelectorAll('[data-clr]').forEach(function(el){if(el.getBoundingClientRect().top<h*.92)return;el.classList.add('clr-wait');io.observe(el)})})();</script>
{%- endunless -%}

{% schema %}
{
  "name": "Steps with screens",
  "tag": "section",
  "class": "courselanding-steps-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "How it works" },
    { "type": "text", "id": "heading_accent", "label": "Heading words in the accent colour" },
    { "type": "text", "id": "anchor", "label": "Address on the page", "default": "how-it-works", "info": "A word a menu link can jump to, as /#word." },
    { "type": "header", "content": "Button under the steps" },
    { "type": "text", "id": "button_label", "label": "Label", "default": "Join the course" },
    { "type": "product", "id": "product", "label": "Course", "info": "The button goes straight to checkout with this product. Your first product when none is picked." },
    { "type": "checkbox", "id": "to_checkout", "label": "Button goes straight to checkout", "default": true },
    { "type": "url", "id": "button_link", "label": "Link when there is no product" },
    { "type": "text", "id": "note", "label": "Line under the button", "default": "One payment. 30 day refund." },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "background", "label": "Background", "default": "#f6f6f4" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#2f5bea" },
    { "type": "color", "id": "heading_color", "label": "Headings", "default": "#141416" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#5a5a62" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Space above on desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 88 },
    { "type": "range", "id": "padding_bottom", "label": "Space below on desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 88 },
    { "type": "range", "id": "padding_top_mobile", "label": "Space above on phones", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Space below on phones", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "label", "label": "Small label", "default": "Step 1" },
        { "type": "text", "id": "title", "label": "Title", "default": "Watch a short lesson" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Say what happens in this step, in one or two sentences." },
        { "type": "image_picker", "id": "image", "label": "Screen", "info": "A wide screenshot, 16 by 10." },
        { "type": "text", "id": "image_alt", "label": "Screen description" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Steps with screens",
      "category": "Course landing",
      "blocks": [
        { "type": "step" },
        { "type": "step", "settings": { "label": "Step 2", "title": "Try it yourself" } },
        { "type": "step", "settings": { "label": "Step 3", "title": "Get feedback" } }
      ]
    }
  ]
}
{% endschema %}
