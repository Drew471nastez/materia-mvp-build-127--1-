  @media (max-width: 600px) {
    #shopify-section-{{ section.id }} .ma-v2 .ma-pn { grid-template-columns: 1fr 1fr; }
    #shopify-section-{{ section.id }} .ma-v2 .ma-pn__back { display: none; }
