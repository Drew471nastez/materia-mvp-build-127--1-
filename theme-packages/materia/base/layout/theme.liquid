{%- comment -%}
  Materia Themes. Developed By Materia Themes.
{%- endcomment -%}
{% liquid
  assign enable_rtl = false
  if settings.rtl
    assign enable_rtl = true
  endif
  assign iso_code = request.locale.iso_code
  assign lis_language_rtl = settings.language_rtl
  if lis_language_rtl != blank and iso_code != blank and lis_language_rtl contains iso_code
    assign enable_rtl = true
  endif
%}

<!doctype html>
<html class="no-js{% if enable_rtl %} rtl{% endif %}{% if request.design_mode %} shopify-design-mode{% endif %}{% if request.visual_preview_mode %} mt-preview{% endif %}" lang="{{ request.locale.iso_code }}" dir="{% if enable_rtl %}rtl{% else %}ltr{% endif %}"{% if settings.theme_button_priority == false %} data-button-priority="off"{% endif %}>
  <head>
    {%- comment -%}
      The page's own background on <html>, first thing in the page, before any
      stylesheet: the colour the browser shows between two pages and before
      the body is drawn. It was the browser's white, so a dark shop (Night
      shop) flashed white on every page change where no view transition held
      the old page. The first colour scheme is the body's (below).
    {%- endcomment -%}
    {%- for scheme in settings.color_schemes -%}
      {%- if forloop.index == 1 and scheme.settings.background != blank -%}<style data-page-background>html{background-color:{{ scheme.settings.background }}}</style>{%- endif -%}
      {%- break -%}
    {%- endfor -%}
    {%- comment -%}
      Product pictures inside a .bls-image-js area start at opacity 0.01 (critical.css) while they
      load, over their skeleton. Each one is shown the moment it arrives (or fails), with no fade:
      a picture that is there is simply there, so landing on a page never shimmers or flickers.
    {%- endcomment -%}
    <script>
      (function () {
        function show(img) {
          if (!img || img.tagName !== 'IMG' || !img.classList.contains('bls-loading-image')) return;
          img.classList.remove('bls-loading-image');
          var wrap = img.closest && img.closest('motion-element.bls-loading-image');
          if (wrap) wrap.classList.remove('bls-loading-image');
        }
        document.addEventListener('load', function (e) { show(e.target); }, true);
        document.addEventListener('error', function (e) { show(e.target); }, true);
        document.addEventListener('DOMContentLoaded', function () {
          var list = document.querySelectorAll('img.bls-loading-image');
          for (var k = 0; k < list.length; k++) if (list[k].complete) show(list[k]);
        }, { once: true });
      })();
    </script>
    <script>
      {%- comment -%} Theme editor: a section the editor draws again after an edit is marked, so
         it shows at once instead of replaying its entrance; everything else animates
         exactly as on the storefront. {%- endcomment -%}
      window.mtIsRedraw = function (el) { return !!(el && el.closest && el.closest('[data-mt-redrawn]')); };
      {%- comment -%} What the visitor really sees. The browser's own visibility report, not the
         page's height: in the theme editor the page sits in a frame that can be as tall as
         the page, so "above the window's bottom edge" would be true of every section. {%- endcomment %}
      (function () {
        var seen = window.mtSeen = new WeakMap();
        var secVis = window.mtSectionVisible = {};
        if (!('IntersectionObserver' in window)) { window.mtInView = function () { return true; }; return; }
        var io = new IntersectionObserver(function (es) {
          for (var i = 0; i < es.length; i++) {
            var t = es[i].target; seen.set(t, es[i].isIntersecting);
            if (t.id && t.classList.contains('shopify-section')) secVis[t.id] = es[i].isIntersecting;
          }
        });
        window.mtWatch = function (el) { if (el && !seen.has(el) && el.nodeType === 1) { seen.set(el, undefined); io.observe(el); } };
        window.mtInView = function (el) { window.mtWatch(el); return seen.get(el) === true; };
        function watchSections(root) { var l = (root || document).querySelectorAll('.shopify-section'); for (var i = 0; i < l.length; i++) window.mtWatch(l[i]); }
        {%- comment -%} Only sections that arrive later (the editor drawing one again) are looked at,
           not the whole page on every change. {%- endcomment %}
        document.addEventListener('DOMContentLoaded', function () {
          watchSections(document);
          new MutationObserver(function (records) {
            for (var r = 0; r < records.length; r++) {
              var added = records[r].addedNodes;
              for (var n = 0; n < added.length; n++) {
                var node = added[n];
                if (node.nodeType !== 1) continue;
                if (node.classList && node.classList.contains('shopify-section')) window.mtWatch(node);
                else if (node.firstElementChild && node.querySelector('.shopify-section')) watchSections(node);
              }
            }
          }).observe(document.body, { childList: true, subtree: true });
        }, { once: true });
      })();
      {%- if request.design_mode %}
      document.addEventListener('shopify:section:load', function (e) {
        var t = e.target; if (!t || !t.id) return;
        {%- comment -%} Only a section that was on screen when the editor drew it again shows at once;
           one further down (a theme setting redraws every section) keeps its reveal. {%- endcomment %}
        if (window.mtSectionVisible && window.mtSectionVisible[t.id]) t.setAttribute('data-mt-redrawn', '');
      }, true);
      {%- endif %}
    </script>
    {%- comment -%} Moving between pages is handled in one place: snippets/speed-optimization (Theme settings > Performance > Page change). {%- endcomment -%}
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="">
    {%- liquid
      comment
        The wishlist (snippets/wishlist-url): the theme's own Wishlist template
        on the search route (/search?view=wishlist) when the store has no
        "wishlist" page. It is a page of its own: its own title and canonical,
        and kept out of search engines, as every visitor's list is different.
      endcomment
      assign mt_wishlist_view = false
      if request.page_type == 'search' and template.suffix == 'wishlist'
        assign mt_wishlist_view = true
      endif
    -%}
    {%- if mt_wishlist_view -%}
      <link rel="canonical" href="{{ request.origin }}{% render 'wishlist-url' %}">
      <meta name="robots" content="noindex">
    {%- else -%}
      <link rel="canonical" href="{{ canonical_url }}">
    {%- endif -%}
    {%- if request.page_type == '404' -%}
      {%- comment -%}
        Old links and bookmarks to /pages/wishlist on a store without that page
        (Liquid only sees /404 here, so the browser's address is checked) go
        straight to the wishlist, before anything is drawn.
      {%- endcomment -%}
      <script>
        (function () {
          var path = location.pathname.replace(/\/+$/, '');
          var old = {{ routes.root_url | append: '/pages/wishlist' | replace: '//', '/' | json }};
          if (path === old || path === '/pages/wishlist') location.replace({% capture mt_wl_url %}{% render 'wishlist-url' %}{% endcapture %}{{ mt_wl_url | strip | json }});
        })();
      </script>
    {%- endif -%}
    {%- render 'section-link-capture' -%}
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}
    <title>
      {% if mt_wishlist_view %}{{ 'templates.wishlist.wishlist' | t }}{% else %}{{ page_title }}{% endif %}
      {%- if current_tags %} &ndash; {{ 'accessibility.ui.tagged' | t: tags: current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.pagination.page' | t: number: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>
    {%- liquid
      comment
        Every page gets a description: its SEO description, else the start of
        its own text (collection, page, article), else the store's. Later pages
        of a list say which page they are, so they are not duplicates.
      endcomment
      assign seo_description = page_description | strip_html | strip_newlines | strip
      if seo_description == blank
        case request.page_type
          when 'collection'
            assign seo_description = collection.description
          when 'page'
            assign seo_description = page.content
          when 'article'
            assign seo_description = article.excerpt_or_content
        endcase
        assign seo_description = seo_description | strip_html | strip_newlines | strip | truncate: 160
      endif
      if seo_description == blank
        assign seo_description = shop.description | strip_html | strip_newlines | strip
      endif
      if seo_description != blank and current_page != 1
        assign seo_page = 'general.pagination.page' | t: number: current_page
        assign seo_description = seo_description | append: ' – ' | append: seo_page
      endif
    -%}
    {% if seo_description != blank %}
      <meta name="description" content="{{ seo_description | escape }}">
    {% endif %}
    {% render 'meta-tags', description: seo_description %}
    {%- comment -%} Performance settings: preconnects, page-to-page fade, speculation rules (prerender and prefetch), motion and third-party handling. {%- endcomment -%}
    {%- render 'speed-optimization' -%}
    {%- comment -%}
      theme.js imports cart-components.js, which the browser would only find
      after theme.js has downloaded and parsed. Start it now, resolved from
      theme.js's own address exactly as the import is, at low priority so it
      never competes with the stylesheets or the first image.
    {%- endcomment -%}
    <script>
      (function () {
        try {
          var l = document.createElement('link');
          l.rel = 'modulepreload';
          l.href = new URL('./cart-components.js', new URL({{ 'theme.js' | asset_url | json }}, location.href)).href;
          l.fetchPriority = 'low';
          document.head.appendChild(l);
        } catch (e) {}
      })();
    </script>
    {%- comment -%}
      One render-blocking stylesheet: base.css is critical, section-isolation,
      animation, product-card, swiper-bundle.min, theme, theme-button-contract,
      localization-controls, product-block-runtime and layout-guard, in that
      cascade order (built by scripts/build-materia-base-css.mjs; edit the
      sources, then rebuild), then late-css-guard and section-type. The theme
      editor (no section isolation there) and right-to-left stores (rtl.css
      sits in the middle of that order) link the source files one by one.
    {%- endcomment -%}
    {%- comment -%}
      Without scroll animation the same bundle less animation.css,
      base-static.css (it never linked animation.css): one request instead of
      the eleven files it linked one by one before.
    {%- endcomment -%}
    {%- liquid
      assign use_base_css = true
      assign base_css_file = 'base.css'
      if settings.scroll_animation == 'none'
        assign base_css_file = 'base-static.css'
      endif
      if request.design_mode or enable_rtl
        assign use_base_css = false
      endif
    -%}
    {%- if use_base_css -%}
      {{ base_css_file | asset_url | stylesheet_tag }}
    {%- else -%}
    {{ 'critical.css' | asset_url | stylesheet_tag }}

    {%- comment -%}
      Section isolation (`contain: style; isolation: isolate;`) is great
      on the live storefront but can break the platform's section-picker
      preview iframes (preview generators don't always cooperate with
      `contain`). Skip it in design_mode so previews render cleanly.
    {%- endcomment -%}
    {%- unless request.design_mode -%}
      {{ 'section-isolation.css' | asset_url | stylesheet_tag }}
    {%- endunless -%}
    {% if settings.scroll_animation != 'none' %}
      {{ 'animation.css' | asset_url | stylesheet_tag }}
    {%- endif %}
    {% if enable_rtl %}{{ 'rtl.css' | asset_url | stylesheet_tag: preload: true }}{% endif %}
    {{ 'product-card.css' | asset_url | stylesheet_tag }}
    {%- endif -%}
    {%- render 'product-card-custom-actions' -%}
    {%- render 'cart-recommend-custom-button' -%}
    {%- unless use_base_css -%}{{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}{%- endunless -%}
    {%- comment -%}
      Styles nothing on the first screen needs (popups and the modal
      library) are asked for once the page has finished loading, at the
      first tap, click, scroll or key press, when a popup opens, or 4 seconds
      after the page is readable if a slow file holds its load: the page then
      counts as loaded sooner and the browser's loading line ends sooner.
    {%- endcomment -%}
    <script>(function(u){var done=false;function go(){if(done)return;done=true;for(var i=0;u.length>i;i++){if(document.querySelector('link[href="'+u[i]+'"]'))continue;var l=document.createElement('link');l.rel='stylesheet';l.href=u[i];document.head.appendChild(l)}}
    window.MateriaLateCss={now:go};if(document.readyState==='complete')setTimeout(go,0);else{addEventListener('load',function(){setTimeout(go,0)},{once:true});
    document.addEventListener('DOMContentLoaded',function(){setTimeout(go,4000)},{once:true})}
    ['pointerdown','click','keydown','scroll','touchstart'].forEach(function(n){addEventListener(n,go,{once:true,passive:true,capture:true})})})([{{ 'popup.css' | asset_url | json }},{{ 'tingle.min.css' | asset_url | json }}]);</script>
    {%- comment -%} Review star styles reach the product cards on the first screen, so they load at once, without holding the page. {%- endcomment -%}
    <link rel="stylesheet" href="{{ 'judgeme-reviews.css' | asset_url }}" media="print" onload="this.media='all'">
    <noscript>{{ 'judgeme-reviews.css' | asset_url | stylesheet_tag }}</noscript>
    {% render 'font-variables' %}
    {% if request.design_mode %}
      {{ 'design-mode.css' | asset_url | stylesheet_tag: preload: true }}
      {%- comment -%}
        Calm reloads in the builder. A setting that cannot be shown live (show
        currency code, a font file, a product card option) makes the builder
        draw the page again; that redraw must not look like a fresh visit.
        Until the page has loaded, every CSS animation sits in its end state
        (a marquee or loop in its first) and nothing eases; then entrance
        animations are finished and loops start from their first frame, so
        nothing jumps. Design mode is marked on <html> and <body> from the
        server, before any script, so sections that skip their reveal in the
        editor (they look at <body>) never hide their content first.
      {%- endcomment -%}
      <style>
        html.sl-calm *, html.sl-calm *::before, html.sl-calm *::after { animation-duration: 0s !important; animation-delay: 0s !important; transition: none !important; }
        html.shopify-design-mode .preload-page { display: none !important; }
      </style>
      <script>
        (function () {
          var html = document.documentElement;
          var done = false;
          function settle() {
            if (done) return;
            done = true;
            html.classList.remove('sl-calm');
            window.__mtEditorSettled = true;
            // Animations play in the editor exactly as on the storefront.
            return;
            if (!document.getAnimations) return;
            try {
              var list = document.getAnimations();
              for (var i = 0; i < list.length; i++) {
                var a = list[i];
                if (!a.animationName || /^reveal/.test(a.animationName)) continue;
                try {
                  if (a.effect && a.effect.getComputedTiming().iterations === Infinity) a.currentTime = 0;
                  else a.finish();
                } catch (e) {}
              }
            } catch (e) {}
          }
          function soon() { requestAnimationFrame(function () { requestAnimationFrame(settle); }); }
          if (document.readyState === 'complete') soon(); else addEventListener('load', soon, { once: true });
          setTimeout(settle, 3500);
        })();
      </script>
    {% endif %}
    {% style %}
      {% for scheme in settings.color_schemes -%}
        {% # theme-check-disable UndefinedObject %}
        {% assign scheme_classes = scheme_classes | append: ', .color-' | append: scheme.id %}
        {% # theme-check-disable UndefinedObject %}
        {% if forloop.index == 1 -%}
          :root,
        {%- endif %}
        .color-{{ scheme.id }} {
          --color-background: {{ scheme.settings.background }};
          --gradient-background: {{ scheme.settings.background }};
          --color-primary: {{ scheme.settings.primary_color }};
          --color-primary-rgb: {{ scheme.settings.primary_color.red }}, {{ scheme.settings.primary_color.green }}, {{ scheme.settings.primary_color.blue }};
          --color-text: {{ scheme.settings.text_color }};
          --color-text-rgb: {{ scheme.settings.text_color.red }}, {{ scheme.settings.text_color.green }}, {{ scheme.settings.text_color.blue }};
          --color-heading: {{ scheme.settings.heading_color }};
          --color-heading-rgb:{{ scheme.settings.heading_color.red }}, {{ scheme.settings.heading_color.green }}, {{ scheme.settings.heading_color.blue }};
          --color-link: {{ scheme.settings.heading_color }};
          --color-link-hover: {{ scheme.settings.primary_color }};
          --color-border: {{ scheme.settings.border_color }};
          --badge-background: {% render 'scheme-color', color: scheme.settings.badge_background, fallback: 'var(--btn-primary-bg-color)' %};
          --badge-text: {% render 'scheme-color', color: scheme.settings.badge_text, fallback: 'var(--btn-primary-color)' %};
          --btn-primary-color: {{ scheme.settings.btn_primary_color | default: scheme.settings.background }};
          --btn-primary-hover-color: {{ scheme.settings.btn_primary_hover_color | default: scheme.settings.background }};
          --btn-primary-bg-color: {{ scheme.settings.btn_primary_background | default: scheme.settings.primary_color }};
          --btn-primary-bg-graident-color: {{ scheme.settings.btn_primary_background | default: scheme.settings.primary_color }};
          --btn-primary-hover-bg-color: {{ scheme.settings.btn_primary_hover_background | default: scheme.settings.heading_color }};
          {%- assign sc_fb = scheme.settings.btn_primary_background | default: scheme.settings.primary_color -%}
          --btn-primary-border-color: {% render 'scheme-color', color: scheme.settings.btn_primary_border_color, fallback: sc_fb %};
          {%- assign sc_fb = scheme.settings.btn_primary_hover_background | default: scheme.settings.heading_color -%}
          --btn-primary-hover-border-color: {% render 'scheme-color', color: scheme.settings.btn_primary_hover_border_color, fallback: sc_fb %};
          --btn-primary-hover-bg-color-graident: {{ scheme.settings.btn_primary_hover_background | default: scheme.settings.heading_color }};
          --btn-secondary-color: {{ scheme.settings.btn_secondary_color | default: scheme.settings.heading_color }};
          --btn-secondary-bg-color: {{ scheme.settings.btn_secondary_background | default: scheme.settings.background }};
          --btn-secondary-border-color: {{ scheme.settings.btn_secondary_border | default: scheme.settings.heading_color }};
          --btn-secondary-hover-color: {{ scheme.settings.btn_secondary_hover_color | default: scheme.settings.background }};
          --btn-secondary-hover-bg-color: {{ scheme.settings.btn_secondary_hover_background | default: scheme.settings.heading_color }};
          {%- assign sc_fb = scheme.settings.btn_secondary_hover_background | default: scheme.settings.heading_color -%}
          --btn-secondary-hover-border-color: {% render 'scheme-color', color: scheme.settings.btn_secondary_hover_border_color, fallback: sc_fb %};
          --btn-secondary-bg: var(--btn-secondary-bg-color);
          --btn-secondary-bg-hover: var(--btn-secondary-hover-bg-color);
          --btn-secondary-color-hover: var(--btn-secondary-hover-color);
          --btn-outline-color: {{ scheme.settings.heading_color }};
          --btn-outline-border-color: {{ scheme.settings.border_color }};
          --btn-link-color: {{ scheme.settings.heading_color }};
          --btn-link-hover-color: {{ scheme.settings.primary_color }};
          --input-color: var(--color-text);
          --input-placeholder-color: rgba(var(--color-heading-rgb), 0.55);
          --input-bg: rgba({{ scheme.settings.background.red }}, {{ scheme.settings.background.green }}, {{ scheme.settings.background.blue }}, 0.6);
        }
      {% endfor %}
      {{ scheme_classes | prepend: 'body' }} {
        color: var(--color-text);
        background-color: var(--color-background);
      }
      {%- if settings.storelib_link_hover != blank -%}
        a:hover { color: {{ settings.storelib_link_hover }}; }
      {%- endif -%}
      {%- comment -%} Forms and fields: these follow the colour scheme unless picked. {%- endcomment -%}
      {%- if settings.storelib_input_border != blank -%}
        :root { --input-border-color: {{ settings.storelib_input_border }}; }
      {%- endif -%}
      {%- if settings.field_background != blank and settings.field_background.alpha != 0 and settings.field_background != 'transparent' and settings.field_background != 'rgba(0,0,0,0)' -%}
        :root, body, [class*="color-"] { --input-bg: {{ settings.field_background }}; }
      {%- endif -%}
      {%- comment -%}
        Field text is never written over every scheme as it is: a light Text
        colour on a light scheme was white on white. field-colors gives each
        scheme its readable field text, placeholder and Field style.
      {%- endcomment -%}
      {%- render 'field-colors' -%}
      {%- render 'quantity-style' -%}
      {%- if settings.storelib_input_focus != blank -%}
        :root, body, [class*="color-"] { --input-focus-color: {{ settings.storelib_input_focus }}; }
        input:focus-visible, textarea:focus-visible, select:focus-visible {
          outline: 2px solid color-mix(in srgb, {{ settings.storelib_input_focus }} 70%, transparent);
          outline-offset: 1px;
        }
      {%- endif -%}
      {%- if settings.storelib_input_radius != blank and settings.storelib_input_radius >= 0 -%}
        html:root { --input-border-radius: {{ settings.storelib_input_radius }}px; }
      {%- endif -%}
      {%- comment -%} Buttons on hover: one colour for every button when picked, written over each scheme's own hover colours. {%- endcomment -%}
      {%- if settings.storelib_button_hover_bg != blank and settings.storelib_button_hover_bg.alpha != 0 and settings.storelib_button_hover_bg != 'transparent' and settings.storelib_button_hover_bg != 'rgba(0,0,0,0)' -%}
        :root, body, [class*="color-"] { --btn-primary-hover-bg-color: {{ settings.storelib_button_hover_bg }}; --btn-primary-hover-bg-color-graident: {{ settings.storelib_button_hover_bg }}; --btn-secondary-hover-bg-color: {{ settings.storelib_button_hover_bg }}; }
      {%- endif -%}
      {%- if settings.storelib_button_hover_text != blank and settings.storelib_button_hover_text.alpha != 0 and settings.storelib_button_hover_text != 'transparent' and settings.storelib_button_hover_text != 'rgba(0,0,0,0)' -%}
        :root, body, [class*="color-"] { --btn-primary-hover-color: {{ settings.storelib_button_hover_text }}; --btn-secondary-hover-color: {{ settings.storelib_button_hover_text }}; --btn-link-hover-color: {{ settings.storelib_button_hover_text }}; }
      {%- endif -%}
      {%- if settings.storelib_button_hover_border != blank and settings.storelib_button_hover_border.alpha != 0 and settings.storelib_button_hover_border != 'transparent' and settings.storelib_button_hover_border != 'rgba(0,0,0,0)' -%}
        :root, body, [class*="color-"] { --btn-primary-hover-border-color: {{ settings.storelib_button_hover_border }}; --btn-secondary-hover-border-color: {{ settings.storelib_button_hover_border }}; }
      {%- endif -%}
      /* GLOBAL BUTTON TEXT GUARANTEE
         The scheme's "Text color" customiser MUST NOT control button
         label colour anywhere in the theme. Button labels are owned
         by the per-button colour customisers:
           - .btn-primary      → --btn-primary-color
           - .btn-outline      → --btn-outline-color
           - .btn-white        → --btn-outline-color
           - .btn-secondary    → --btn-secondary-color
         Without this rule, sections that pin `color` on a parent
         (e.g. cart sidebar, faq, info box) cascade into buttons via
         their inner `<span>` and override the button's own colour.
         These rules win because they have a class selector AND
         `!important`, and they walk into `*` so inner spans inherit. */
      .btn-primary,
      .btn-primary *,
      :is(.shopify-payment-button__more-options, .shopify-payment-button__button--unbranded, .shopify-challenge__button, .dmp_discount-form button),
      :is(.shopify-payment-button__more-options, .shopify-payment-button__button--unbranded, .shopify-challenge__button, .dmp_discount-form button) * {
        color: var(--btn-color, var(--btn-primary-color, #ffffff)) !important;
      }
      .btn-outline,
      .btn-outline *,
      .btn-white,
      .btn-white * {
        color: var(--btn-color, var(--btn-outline-color, var(--color-text, #111111))) !important;
      }
      .btn-secondary,
      .btn-secondary * {
        color: var(--btn-secondary-color, var(--btn-outline-color, var(--color-text, #111111))) !important;
      }
      /* The cart drawer "View Cart" button uses .viewcart on a .btn-outline.
         Pin its label to scheme secondary so the text colour follows the
         Button-secondary customiser, not the global Text colour. */
      .btn-outline.viewcart,
      .btn-outline.viewcart * {
        color: var(--btn-secondary-color, var(--btn-outline-color, var(--color-text, #111111))) !important;
      }
      /* The cart "Checkout" button always uses primary. */
      .btn-checkout,
      .btn-checkout * {
        color: var(--btn-primary-color, #ffffff) !important;
      }
