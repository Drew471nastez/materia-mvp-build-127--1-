{%- doc -%}
  Materia Themes. Editor only: one line for a size chart block with nothing
  to show yet. Visitors never get this markup.
  Inputs: block, label

  @param {block} block - The block being rendered
  @param {string} label - Text

  @example
  {% render 'size-chart-preview', block: block, label: title %}
{%- enddoc -%}
{%- if request.design_mode -%}
  {%- liquid
    case block.settings.chart_source
      when 'table'
        assign scp_hint = 'add rows to Custom table'
      when 'metafield'
        assign scp_hint = 'this product has no custom.size_chart metafield'
      else
        assign scp_hint = 'choose a page'
        if block.settings.size_guide_page != blank
          assign scp_hint = 'the chosen page has no text'
        endif
    endcase
  -%}
  <p class="materia-chart-preview" data-editor-preview data-size-chart-preview="{{ block.id }}" data-block-preview-root="{{ block.id }}" {{ block.shopify_attributes }}><strong>{{ label | default: 'Size chart' | escape }}</strong>: no chart yet, {{ scp_hint }}.</p>
{%- endif -%}
