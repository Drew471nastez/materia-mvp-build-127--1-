{%- comment -%}
  Materia Themes. One line icon for the product information extras
  (snippets/product-info-extras), drawn in currentColor.
  {% render 'product-info-extras-icon', name: 'truck' %}
{%- endcomment -%}
{%- case name -%}
  {%- when 'truck' -%}<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="2.5" y="6.5" width="11.5" height="9.5" rx="1.5" stroke="currentColor" stroke-width="1.6"/><path d="M14 9.5h4.2c.4 0 .7.2.9.5l2.2 3c.2.2.2.5.2.8v1.7a.5.5 0 0 1-.5.5H19.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><circle cx="7.5" cy="17.5" r="1.8" stroke="currentColor" stroke-width="1.6"/><circle cx="17.5" cy="17.5" r="1.8" stroke="currentColor" stroke-width="1.6"/></svg>
  {%- when 'return' -%}<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 9h11a5 5 0 0 1 0 10H8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M8 5L4 9l4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'shield' -%}<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3l7.5 2.8v5.6c0 4.6-3.2 8-7.5 9.6-4.3-1.6-7.5-5-7.5-9.6V5.8L12 3z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M8.8 12l2.3 2.3 4.2-4.4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'lock' -%}<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="5" y="10.5" width="14" height="10" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M8 10.5V7.8a4 4 0 0 1 8 0v2.7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
  {%- when 'leaf' -%}<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 4c0 7-3 13-12 16 0-7 3-13 12-16z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M8 20c4-4 7-7 12-12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
  {%- when 'clock' -%}<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.6"/><path d="M12 7.5V12l3 2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
  {%- when 'gift' -%}<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3.5" y="9" width="17" height="11.5" rx="1.5" stroke="currentColor" stroke-width="1.6"/><path d="M3.5 13h17M12 9v11.5M12 9c-2.8 0-4.6-1.3-4.6-3S9.3 3.6 12 6.5C14.7 3.6 16.6 4.3 16.6 6S14.8 9 12 9z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
  {%- when 'star' -%}<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3.5l2.6 5.3 5.8.8-4.2 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8-4.2-4.1 5.8-.8L12 3.5z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
  {%- when 'support' -%}<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4.5 13v-1a7.5 7.5 0 0 1 15 0v1" stroke="currentColor" stroke-width="1.6"/><rect x="3.5" y="12.5" width="4" height="6" rx="1.5" stroke="currentColor" stroke-width="1.6"/><rect x="16.5" y="12.5" width="4" height="6" rx="1.5" stroke="currentColor" stroke-width="1.6"/><path d="M18.5 18.5c0 1.5-1.8 2.5-5 2.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
  {%- when 'chat' -%}<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 5.5h16v10.5H9l-5 4V5.5z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
  {%- when 'question' -%}<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.6"/><path d="M9.6 9.6a2.5 2.5 0 1 1 3.6 2.3c-.7.4-1.2.9-1.2 1.8M12 16.6h.01" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
  {%- when 'ruler' -%}<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="2.5" y="8" width="19" height="8" rx="1.5" stroke="currentColor" stroke-width="1.6"/><path d="M6.5 8v3M10 8v4M13.5 8v3M17 8v4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
  {%- when 'globe' -%}<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.6"/><path d="M3.5 12h17M12 3.5c2.3 2.4 3.5 5.2 3.5 8.5s-1.2 6.1-3.5 8.5c-2.3-2.4-3.5-5.2-3.5-8.5s1.2-6.1 3.5-8.5z" stroke="currentColor" stroke-width="1.6"/></svg>
  {%- when 'box' -%}<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3.5 7.5L12 3.5l8.5 4v9L12 20.5l-8.5-4v-9z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M3.5 7.5L12 11.5l8.5-4M12 11.5v9" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
  {%- when 'card' -%}<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="5.5" width="18" height="13" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M3 10h18M7 15h3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
  {%- when 'heart' -%}<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 20s-7-4.4-9-8.6A4.7 4.7 0 0 1 12 6.6a4.7 4.7 0 0 1 9 4.8C19 15.6 12 20 12 20z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
  {%- when 'download' -%}<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 4v11m-4.5-4.5L12 15l4.5-4.5M4.5 19.5h15" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'mail' -%}<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="5.5" width="18" height="13" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M3.8 7l8.2 6 8.2-6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- else -%}<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
{%- endcase -%}
