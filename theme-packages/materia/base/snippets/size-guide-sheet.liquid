{%- doc -%}
  Materia Themes. Size chart block (size_guide): a link or button that opens
  the chart in a <dialog> (a bottom sheet on phones, a centred panel on
  larger screens; product-page-ui.js: Escape, backdrop and close button
  close it, focus stays inside and returns to the link). The chart comes
  from snippets/size-chart-body. Nothing for visitors when there is no
  chart; the editor shows a one-line note instead.
  Inputs: block, product, section

  @param {block} block - The block being rendered
  @param {product} product - The product to render
  @param {section} section - The section being rendered

  @example
  {% render 'size-guide-sheet', block: block, product: product, section: section %}
{%- enddoc -%}
{%- capture sg_body -%}{%- render 'size-chart-body', block: block, product: product -%}{%- endcapture -%}
{%- liquid
  assign sg = block.settings
  assign sg_has = false
  assign sg_t = sg_body | strip_html | strip
  if sg_t != blank or sg_body contains '<img' or sg_body contains '<table'
    assign sg_has = true
  endif
  assign sg_remote = false
  if sg_body contains 'data-size-chart-remote'
    assign sg_remote = true
  endif
  assign sg_label = sg.size_guide_label | default: 'Size chart'
  assign sg_id = 'SizeChart-' | append: section.id | append: '-' | append: block.id
-%}
{%- if sg_has or sg_remote -%}
  {%- comment -%} While the editor note stands in for it, the note carries the block's attributes. {%- endcomment -%}
  <div class="mt-size-guide-root mt-size-guide-root--block" data-size-chart-root="{{ block.id }}"{% if sg.spacing_top > 0 or sg.spacing_bottom > 0 %} style="margin-block: {{ sg.spacing_top | default: 0 }}px {{ sg.spacing_bottom | default: 0 }}px;"{% endif %}
    {%- if sg_has or request.design_mode != true %} data-block-preview-root="{{ block.id }}" {{ block.shopify_attributes }}{% endif -%}
    {%- unless sg_has %} hidden data-size-chart-await{% endunless %}>
  <button
    type="button"
    class="mt-size-guide{% if sg.size_guide_appearance == 'button' %} btn btn-secondary{% endif %}"
    {% if sg.size_guide_appearance == 'button' %}data-theme-button="secondary" data-sl-button{% endif %}
    data-mt-sheet-open
    aria-controls="{{ sg_id }}"
    aria-haspopup="dialog"
    aria-expanded="false"
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8.5 8.5 3l12.5 12.5-5.5 5.5z"/><path d="m7 7 1.5 1.5M10 5.5 11.5 7M13 8.5 14.5 10M11 11l1.5 1.5M16 11.5l1.5 1.5"/></svg>
    <span>{{ sg_label | escape }}</span>
  </button>
  <dialog id="{{ sg_id }}" class="mt-sheet" aria-labelledby="{{ sg_id }}-title">
    <div class="mt-sheet__panel">
      <div class="mt-sheet__head">
        <h2 id="{{ sg_id }}-title" class="mt-sheet__title">{{ sg_label | escape }}</h2>
        <button type="button" class="mt-sheet__close" data-mt-sheet-close aria-label="{{ 'accessibility.close' | t }}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
        </button>
      </div>
      <div class="mt-sheet__body rte">
        <div class="mt-sheet__table-wrap">{{ sg_body }}</div>
      </div>
    </div>
  </dialog>
  </div>
{%- endif -%}
{%- unless sg_has -%}
  {%- render 'size-chart-preview', block: block, label: sg_label -%}
{%- endunless -%}
