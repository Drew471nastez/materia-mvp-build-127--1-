{%- doc -%}
  A background picture behind a section, with a colour laid over it at the
  strength chosen. The section's own content stays above it. Nothing is
  drawn without a picture.

  @param {image} image - The picture
  @param {color} [overlay] - The colour over it
  @param {number} [opacity] - Overlay strength, 0 to 100

  @example
  {% render 'bg-picture', image: s.background_image, overlay: s.overlay_color, opacity: s.overlay_opacity %}
{%- enddoc -%}
{%- if image != blank -%}
  <div class="sl-bgpic" aria-hidden="true">
    {{ image | image_url: width: 2400 | image_tag: loading: 'lazy', sizes: '100vw', widths: '800, 1200, 1600, 2400', alt: '', class: 'sl-bgpic__img' }}
    <span class="sl-bgpic__veil" style="background: {{ overlay | default: '#000000' }}; opacity: {{ opacity | default: 50 | divided_by: 100.0 }};"></span>
  </div>
  <style>
    :has(> .sl-bgpic) { position: relative; isolation: isolate; }
    :has(> .sl-bgpic) > :not(.sl-bgpic, style, script) { position: relative; z-index: 1; }
    .sl-bgpic { position: absolute; inset: 0; z-index: 0; overflow: hidden; pointer-events: none; }
    .sl-bgpic__img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .sl-bgpic__veil { position: absolute; inset: 0; }
  </style>
{%- endif -%}
