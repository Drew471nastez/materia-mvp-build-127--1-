{%- doc -%}
  Image side tiles: up to 4 tiles beside the main product image (Product page
  and Featured product, block "Image side tiles"). Each tile shows its image,
  else its custom SVG, else a built-in icon, with a short label and an
  optional link. Pass `block`. Tiles share the main picture's height.

  @param {block} block - The block being rendered

  @example
  {% render 'media-side-tiles', block: mst_block %}
{%- enddoc -%}
{%- liquid
  assign st = block.settings
  assign tile_count = 0
  for i in (1..4)
    assign k_text = 'tile_' | append: i | append: '_text'
    assign k_icon = 'tile_' | append: i | append: '_icon'
    assign k_img = 'tile_' | append: i | append: '_image'
    assign k_svg = 'tile_' | append: i | append: '_svg'
    if st[k_text] != blank or st[k_img] != blank or st[k_svg] != blank or st[k_icon] != 'none'
      assign tile_count = tile_count | plus: 1
    endif
  endfor
-%}
{%- if tile_count > 0 -%}
<style>
  .mst-row { display: flex; gap: var(--mst-row-gap, 8px); align-items: stretch; }
  .mst-row > :not(.mst) { flex: 1 1 auto; min-width: 0; }
  .thumbnail_left .mst-row { width: calc(100% - 6rem); }
  .thumbnail_left .mst-row > .media-main-swiper { width: auto; }
  .mst { display: flex; flex-direction: column; gap: var(--mst-gap); width: var(--mst-w); flex: 0 0 var(--mst-w); min-height: 0; }
  .mst--left { order: -1; }
  /* Each tile is a size container: its icon and text scale to the room the
     tile really has, so nothing is cut off however short the picture is. */
  .mst__tile { position: relative; flex: 1 1 0; min-height: 0; container-type: size; background: var(--mst-bg); color: var(--mst-ink); border-radius: var(--mst-radius); text-decoration: none; overflow: hidden; transition: filter .25s ease; }
  a.mst__tile:hover { filter: brightness(1.12); }
  .mst__inner { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: min(10px, 6cqh); padding: min(12px, 7cqh) min(8px, 7cqw); text-align: center; }
  .mst__media { --s: min(var(--mst-icon), 34cqh, 42cqw); width: var(--s); height: var(--s); display: grid; place-items: center; flex: none; }
  .mst__media svg { width: 100%; height: 100%; display: block; overflow: visible; }
  .mst__media--svg svg { fill: currentColor; }
  .mst__media--image img { width: 100%; height: 100%; object-fit: contain; display: block; }
  .mst__text { font-size: min(var(--mst-font), 13cqh, 13cqw); line-height: 1.2; font-weight: 500; max-width: 100%; overflow-wrap: break-word; hyphens: auto; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; overflow: hidden; }
  @media (max-width: 767.98px) {
    .mst { width: var(--mst-w-m); flex-basis: var(--mst-w-m); }
    .mst-row:has(.mst--m-below) { flex-wrap: wrap; }
    .mst.mst--m-below { order: 2; flex: 0 0 100%; width: 100%; flex-direction: row; }
    .mst.mst--m-below .mst__tile { flex: 1 1 0; height: 96px; }
    .mst.mst--m-hidden { display: none; }
    .mst-row:has(.mst--m-hidden) { display: block; }
  }
</style>
<style>
  #mst-{{ block.id }} {
    --mst-bg: {{ st.tile_bg | default: '#0f1d6b' }};
    --mst-ink: {{ st.tile_text | default: '#ffffff' }};
    --mst-w: {{ st.tile_width | default: 130 }}px;
    --mst-w-m: {{ st.tile_width_mobile | default: 96 }}px;
    --mst-gap: {{ st.gap | default: 8 }}px;
    --mst-radius: {{ st.radius | default: 14 }}px;
    --mst-icon: {{ st.icon_size | default: 34 }}px;
    --mst-font: {{ st.text_size | default: 15 }}px;
  }
</style>
<div
  id="mst-{{ block.id }}"
  class="mst mst--{{ st.position | default: 'right' }} mst--m-{{ st.mobile | default: 'beside' }}"
  {{ block.shopify_attributes }}
>
  {%- for i in (1..4) -%}
    {%- liquid
      assign k_text = 'tile_' | append: i | append: '_text'
      assign k_icon = 'tile_' | append: i | append: '_icon'
      assign k_img = 'tile_' | append: i | append: '_image'
      assign k_svg = 'tile_' | append: i | append: '_svg'
      assign k_link = 'tile_' | append: i | append: '_link'
      assign t_text = st[k_text]
      assign t_icon = st[k_icon] | default: 'none'
      assign t_img = st[k_img]
      assign t_svg = st[k_svg]
      assign t_link = st[k_link]
      if t_text == blank and t_img == blank and t_svg == blank and t_icon == 'none'
        continue
      endif
      assign tag = 'div'
      if t_link != blank
        assign tag = 'a'
      endif
    -%}
    <{{ tag }} class="mst__tile"{% if t_link != blank %} href="{{ t_link }}"{% endif %}><span class="mst__inner">
      {%- if t_img != blank -%}
        <span class="mst__media mst__media--image">
          {{ t_img | image_url: width: 160 | image_tag: loading: 'lazy', alt: t_text, width: 80, height: 80, sizes: '80px' }}
        </span>
      {%- elsif t_svg != blank -%}
        <span class="mst__media mst__media--svg" aria-hidden="true">{{ t_svg }}</span>
      {%- elsif t_icon != 'none' -%}
        <span class="mst__media" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            {%- case t_icon -%}
              {%- when 'heart' -%}<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
              {%- when 'shield_plus' -%}<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="M9 12h6"/><path d="M12 9v6"/>
              {%- when 'stethoscope' -%}<path d="M11 2v2"/><path d="M5 2v2"/><path d="M5 3H4a2 2 0 0 0-2 2v4a6 6 0 0 0 12 0V5a2 2 0 0 0-2-2h-1"/><path d="M8 15a6 6 0 0 0 12 0v-3"/><circle cx="20" cy="10" r="2"/>
              {%- when 'leaf' -%}<path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>
              {%- when 'star' -%}<path d="M11.5 2.8a.6.6 0 0 1 1 0l2.6 5.3 5.8.85a.6.6 0 0 1 .33 1.02l-4.2 4.1 1 5.78a.6.6 0 0 1-.87.63L12 17.77l-5.18 2.72a.6.6 0 0 1-.87-.63l1-5.78-4.2-4.1a.6.6 0 0 1 .33-1.02l5.8-.85Z"/>
              {%- when 'check' -%}<circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/>
              {%- when 'truck' -%}<path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.62l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/>
              {%- when 'sparkles' -%}<path d="M9.94 14.06 8.5 19l-1.44-4.94L2 12.5l5.06-1.56L8.5 6l1.44 4.94L15 12.5Z"/><path d="M20 3v4"/><path d="M22 5h-4"/><path d="M18 15v3"/><path d="M19.5 16.5h-3"/>
              {%- when 'lock' -%}<rect width="18" height="11" x="3" y="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
              {%- when 'award' -%}<circle cx="12" cy="8" r="6"/><path d="M15.48 12.89 17 22l-5-3-5 3 1.52-9.11"/>
              {%- when 'recycle' -%}<path d="M7 19H4.82a1.83 1.83 0 0 1-1.57-.88 1.79 1.79 0 0 1 0-1.77L7.2 9.5"/><path d="M11 19h8.2a1.83 1.83 0 0 0 1.56-.89 1.78 1.78 0 0 0 0-1.78l-1.23-2.12"/><path d="m14 16-3 3 3 3"/><path d="M8.29 13.6 7.2 9.5 3.1 10.6"/><path d="m9.34 5.8 1.09-1.88A1.84 1.84 0 0 1 12 3a1.83 1.83 0 0 1 1.57.91l4.03 6.96"/><path d="m13.38 9.8 4.22.08.04-4.2"/>
              {%- when 'drop' -%}<path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z"/>
              {%- when 'bolt' -%}<path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"/>
            {%- endcase -%}
          </svg>
        </span>
      {%- endif -%}
      {%- if t_text != blank -%}
        <span class="mst__text">{{ t_text }}</span>
      {%- endif -%}
    </span></{{ tag }}>
  {%- endfor -%}
</div>
{%- endif -%}
