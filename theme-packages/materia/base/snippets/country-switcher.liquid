{% doc %}
  Country selector (localization form) when the shop sells to more than one country.

  @param {boolean} [compact] - Compact
  @param {string} [id_suffix] - Id suffix
  @param {boolean} [static_single] - Static single
  @param {string} [type] - Type

  @example
  {% render 'country-switcher', compact: true, static_single: true %}
{% enddoc -%}
{% if localization.available_countries.size > 1 %}
  <localization-form>
    {% render 'localization-controls' %}
    {%- assign form_id = 'localization-country-' | append: section.id | append: id_suffix -%}
    {% form 'localization', id: form_id %}
      <input type="hidden" name="country_code" value="{{ localization.country.iso_code }}">
      <div class="disclosure relative flex align-center">
        <button type="button" aria-expanded="false" aria-controls="{{ form_id }}-options" aria-label="{{ localization.country.name | escape }} ({{ localization.country.currency.iso_code }})" class="button-localization pointer disclosure__button show-overlay flex align-center gap-10 {% if type == 'mobile-navigation' %}mobile-navigation__button{% endif %}">
          <span class="flex align-center {% if type == 'mobile-navigation' %}flex-column gap-4{% else %}gap-10{% endif %}">
            <span class="rounded-50 border localization-flags {% if type == 'mobile-navigation' %}mobile-navigation__flag{% endif %}">
              {{-
                localization.country
                | image_url: width: localization.country.width
                | image_tag:
                  width: localization.country.width,
                  height: localization.country.height,
                  alt: localization.country.name
              -}}
            </span>
            {% if type == 'mobile-navigation' %}
              <span class="block fs-small heading-style">
                {{ localization.country.currency.iso_code }}
                {{ localization.country.currency.symbol }}
              </span>
            {% else %}
              <span>
                {% if compact %}
                  {{ localization.country.currency.iso_code }} {{ localization.country.currency.symbol }}
                {% else %}
                  {{ localization.country.name }}
                  ({{ localization.country.currency.iso_code }} {{ localization.country.currency.symbol }})
                {% endif %}
              </span>
            {% endif %}
          </span>
          {% if type != 'mobile-navigation' %}
            <svg class="icon-down flex-10" width="10" height="6">
              <use href="#icon-arrow-down" />
            </svg>
          {% endif %}
        </button>
        <div id="{{ form_id }}-options" data-search-label="{{ 'general.search.search' | t | escape }}" data-empty-label="{{ 'general.search.no_matches' | t | escape }}" class="disclosure__list custom-scrollbar shadow transition invisible z-10 absolute left-0 right-0 color-default overflow-y-auto">
          {%- comment -%}
            The countries are written once per page (template#materia-country-options,
            from the layout) and copied in when this list first opens: the header,
            the phone menu and the footer each drew all of them before.
          {%- endcomment -%}
          <ul class="h-full list-unstyled" data-country-options></ul>
        </div>
      </div>
    {% endform %}
  </localization-form>
{%- elsif static_single and localization.country -%}
  {%- comment -%} One market only (the header passes static_single): the current country and currency as a quiet label, so "Show country / currency" visibly works. Markets in Storelib turn it into the selector above. {%- endcomment -%}
  <div class="hs-loc-static flex align-center gap-8{% if type == 'mobile-navigation' %} hs-loc-static--nav{% endif %}" data-loc-static="country" title="{{ localization.country.name | escape }} ({{ localization.country.currency.iso_code }} {{ localization.country.currency.symbol | escape }})">
    <span class="rounded-50 border localization-flags" aria-hidden="true">
      {{- localization.country | image_url: width: localization.country.width | image_tag: width: localization.country.width, height: localization.country.height, alt: '' -}}
    </span>
    <span>
      {%- if compact -%}
        <span class="visually-hidden">{{ localization.country.name }}</span> {{ localization.country.currency.iso_code }} {{ localization.country.currency.symbol }}
      {%- else -%}
        {{ localization.country.name }} ({{ localization.country.currency.iso_code }} {{ localization.country.currency.symbol }})
      {%- endif -%}
    </span>
  </div>
{% endif %}
