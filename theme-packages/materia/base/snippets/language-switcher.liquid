{% doc %}
  Language selector (localization form) when the shop has more than one language.

  @param {string} [id_suffix] - Id suffix
  @param {boolean} [static_single] - Static single
  @param {string} [type] - Type

  @example
  {% render 'language-switcher', id_suffix: '-drawer', static_single: true %}
{% enddoc -%}
{% if localization.available_languages.size > 1 %}
  <localization-form>
    {% render 'localization-controls' %}
    {%- assign form_id = 'localization-language-' | append: section.id | append: id_suffix -%}
    {% form 'localization', id: form_id %}
      <input type="hidden" name="language_code" value="{{ localization.language.iso_code }}">
      <div class="disclosure relative flex align-center">
        <button type="button" aria-expanded="false" aria-controls="{{ form_id }}-options" aria-label="{{ localization.language.endonym_name | escape }}" class="{% if type == 'mobile-navigation' %}mobile-navigation__button {% endif %}button-localization pointer disclosure__button show-overlay flex align-center gap-10">
          <span class="{% if type == 'mobile-navigation' %}flex flex-column gap-4 align-center{% endif %}">
            <span {% if type == 'mobile-navigation' %}style="font-size:14px;"{% endif %}>{{ localization.language.endonym_name | capitalize }}</span>
            {% if type == 'mobile-navigation' %}
              <span class="block fs-small heading-style">{{ 'main_menu.language.title' | t }}</span>
            {% endif %}
          </span>
          {% if type != 'mobile-navigation' %}
            <svg class="icon-down flex-10" width="10" height="6">
              <use href="#icon-arrow-down" />
            </svg>
          {% endif %}
        </button>
        <div id="{{ form_id }}-options" data-search-label="{{ 'general.search.search' | t | escape }}" data-empty-label="{{ 'general.search.no_matches' | t | escape }}" class="disclosure__list custom-scrollbar transition shadow invisible z-10 absolute left-0 right-0 color-default">
          <ul class="h-full list-unstyled">
            {% for language in localization.available_languages %}
              <li class="disclosure__item py-4" tabindex="-1">
                <a
                  href="#"
                  class="loc-option no-underline text-color hover-heading-color"
                  {% if language.iso_code == localization.language.iso_code %}
                    aria-current="true"
                  {% endif %}
                  hreflang="{{ language.iso_code }}"
                  lang="{{ language.iso_code }}"
                  data-value="{{ language.iso_code }}"
                  aria-label="{{ language.endonym_name | capitalize | escape }}"
                >
                  <span class="loc-option__label">{{ language.endonym_name | capitalize }}</span>
                  <svg class="loc-option__check" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M3.5 8.5l3 3 6-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
              </li>
            {% endfor %}
          </ul>
        </div>
      </div>
    {% endform %}
  </localization-form>
{%- elsif static_single and localization.language -%}
  {%- comment -%} One language only (the header passes static_single): the current language as a quiet label. Languages in Storelib turn it into the selector above. {%- endcomment -%}
  <div class="hs-loc-static flex align-center{% if type == 'mobile-navigation' %} hs-loc-static--nav{% endif %}" data-loc-static="language">
    <span>{{ localization.language.endonym_name | capitalize }}</span>
  </div>
{% endif %}
