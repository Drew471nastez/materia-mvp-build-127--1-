{%- doc -%}
  Materia Themes. Share buttons on the product page (Theme settings > Social media >
  Share on product pages). Facebook, X, Pinterest, Email and Copy link.
  Params: product, section.

  @param {product} [product] - The product to share (or pass url, title and image)
  @param {section} section - The section being rendered
  @param {string} [url] - A blog post's url to share instead of the product's
  @param {string} [title] - Its title
  @param {image} [image] - Its image

  @example
  {% render 'materia-product-sharing', product: product, section: section %}
{%- enddoc -%}
{%- liquid
  comment
    Also shares a blog post: pass url, title and image (an article's), else the product's.
  endcomment
  assign share_path = url | default: product.url
  assign share_name = title | default: product.title
  assign share_img = image | default: product.featured_image
  assign share_url = request.origin | append: share_path
  assign share_title = share_name | url_encode
  assign share_link = share_url | url_encode
  assign share_image = ''
  if share_img != blank
    assign share_image = share_img | image_url: width: 1200 | prepend: 'https:' | url_encode
  endif
  assign share_uid = 'mt-share-' | append: section.id
-%}
<div class="mt-share" id="{{ share_uid }}" data-mt-share>
  <span class="mt-share__label">{{ 'accessibility.share' | t }}</span>
  <ul class="mt-share__list" role="list">
    <li>
      <a class="mt-share__btn" href="https://www.facebook.com/sharer/sharer.php?u={{ share_link }}" target="_blank" rel="noopener" aria-label="Facebook">
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M13.5 21v-7.5H16l.4-3h-2.9V8.6c0-.9.3-1.5 1.5-1.5h1.5V4.4c-.3 0-1.2-.1-2.2-.1-2.2 0-3.8 1.4-3.8 3.9v2.3H8v3h2.5V21h3z"/></svg>
      </a>
    </li>
    <li>
      <a class="mt-share__btn" href="https://twitter.com/intent/tweet?text={{ share_title }}&url={{ share_link }}" target="_blank" rel="noopener" aria-label="X">
        <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M17.8 3h3.1l-6.8 7.7L22 21h-6.2l-4.9-6.4L5.3 21H2.2l7.3-8.3L2 3h6.4l4.4 5.8L17.8 3zm-1.1 16.2h1.7L7.4 4.7H5.6l11.1 14.5z"/></svg>
      </a>
    </li>
    <li>
      <a class="mt-share__btn" href="https://pinterest.com/pin/create/button/?url={{ share_link }}&media={{ share_image }}&description={{ share_title }}" target="_blank" rel="noopener" aria-label="Pinterest">
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 2a10 10 0 0 0-3.6 19.3c-.1-.8-.2-2 0-2.9l1.2-5s-.3-.6-.3-1.5c0-1.4.8-2.4 1.8-2.4.9 0 1.3.6 1.3 1.4 0 .9-.6 2.2-.8 3.4-.2 1 .5 1.9 1.6 1.9 1.9 0 3.3-2 3.3-4.9 0-2.6-1.8-4.4-4.5-4.4-3 0-4.8 2.3-4.8 4.6 0 .9.4 1.9.8 2.4l.1.4-.3 1.2c0 .2-.2.3-.4.2-1.3-.6-2.2-2.6-2.2-4.2 0-3.4 2.5-6.6 7.2-6.6 3.8 0 6.7 2.7 6.7 6.3 0 3.8-2.4 6.8-5.7 6.8-1.1 0-2.2-.6-2.5-1.3l-.7 2.6c-.3 1-.9 2.2-1.4 2.9A10 10 0 1 0 12 2z"/></svg>
      </a>
    </li>
    <li>
      <a class="mt-share__btn" href="mailto:?subject={{ share_title }}&body={{ share_link }}" aria-label="{{ 'accessibility.ui.share_email' | t }}">
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="1.8" d="M3 5.5h18v13H3z"/><path fill="none" stroke="currentColor" stroke-width="1.8" d="m3.5 6 8.5 7 8.5-7"/></svg>
      </a>
    </li>
    <li>
      <button type="button" class="mt-share__btn" data-mt-share-copy="{{ share_url | escape }}" aria-label="{{ 'accessibility.share_link' | t }}">
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" d="M10 14a4.5 4.5 0 0 0 6.4 0l3-3a4.5 4.5 0 0 0-6.4-6.4l-1.2 1.2M14 10a4.5 4.5 0 0 0-6.4 0l-3 3a4.5 4.5 0 0 0 6.4 6.4l1.2-1.2"/></svg>
      </button>
    </li>
  </ul>
  <span class="mt-share__copied" role="status" aria-live="polite" hidden>{{ 'accessibility.copied' | t }}</span>
</div>
<style>
  .mt-share { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; margin: 14px 0; }
  .mt-share__label { font-size: 14px; color: var(--color-heading); font-weight: 500; }
  .mt-share__list { display: flex; gap: 8px; margin: 0; padding: 0; list-style: none; }
  .mt-share__btn { display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 50%; border: 1px solid var(--color-border); color: var(--color-heading); background: transparent; cursor: pointer; padding: 0; transition: background-color .2s, color .2s, border-color .2s; }
  .mt-share__btn:hover { background: var(--color-heading); color: var(--color-background); border-color: var(--color-heading); }
  .mt-share__copied { font-size: 13px; color: var(--color-text); }
</style>
<script>
  (function () {
    var root = document.getElementById({{ share_uid | json }});
    if (!root || root.__mtShare) return;
    root.__mtShare = true;
    root.addEventListener('click', function (event) {
      var button = event.target.closest('[data-mt-share-copy]');
      if (!button) return;
      var url = button.getAttribute('data-mt-share-copy');
      var note = root.querySelector('.mt-share__copied');
      function done() { if (!note) return; note.hidden = false; setTimeout(function () { note.hidden = true; }, 2500); }
      if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(url).then(done, done);
      else { try { var t = document.createElement('textarea'); t.value = url; document.body.appendChild(t); t.select(); document.execCommand('copy'); t.remove(); } catch (e) {} done(); }
    });
  })();
</script>
