{%- comment -%}
  Keeps the desktop menu on one line. Runs right after the header is drawn (sections/header), so
  the first paint already has the links that fit and More holding the rest:
  nothing wraps under the header, nothing runs under the icons and nothing
  moves once the page shows. It measures again when the menu's room changes
  (window width, the logo or a selector loading), when the fonts arrive and
  when the editor redraws the header. Below 1025px the drawer takes over and
  every link is back in place. The rules are in header-layout.css.
{%- endcomment -%}
<script>
  (function () {
    var api = window.__hsMenuFit;
    if (!api) {
      var wide = window.matchMedia('(min-width: 1025px)');
      var seen = [];
      var span = function (ul, nav) {
        var lo = Infinity, hi = -Infinity, kids = ul.children;
        for (var i = 0; i < kids.length; i++) {
          var r = kids[i].getBoundingClientRect();
          if (!r.width) continue;
          if (r.left < lo) lo = r.left;
          if (r.right > hi) hi = r.right;
        }
        return hi > lo ? hi - lo : 0;
      };
      var fit = function (nav) {
        var ul = nav.querySelector('.horizontal-list');
        if (!ul) return;
        var more = ul.querySelector(':scope > [data-hs-more]');
        if (!more) { ul.removeAttribute('data-hs-wait'); return; }
        /* Never held unseen (round 67): waiting for the menu's font hid the links on every page load and change, then they popped in. Measured in the size-matched stand-in font now, and again when the font arrives (loadingdone, below). An older header's markup may still carry the wait: it goes. */
        ul.removeAttribute('data-hs-wait');
        var items = ul.querySelectorAll(':scope > li[data-hs-i]');
        var rows = more.querySelectorAll('[data-hs-more-i]');
        var i;
        for (i = 0; i < items.length; i++) items[i].removeAttribute('data-hs-folded');
        for (i = 0; i < rows.length; i++) rows[i].hidden = true;
        ul.removeAttribute('data-hs-fold');
        if (!wide.matches) return;
        var room = nav.getBoundingClientRect().width;
        if (!room || span(ul) <= room + 0.5) return;
        ul.setAttribute('data-hs-fold', '');
        for (i = items.length - 1; i >= 0 && span(ul) > room + 0.5; i--) {
          items[i].setAttribute('data-hs-folded', '');
          var row = more.querySelector('[data-hs-more-i="' + items[i].getAttribute('data-hs-i') + '"]');
          if (row) row.hidden = false;
        }
      };
      var ro = window.ResizeObserver ? new ResizeObserver(function (list) {
        for (var i = 0; i < list.length; i++) fit(list[i].target);
      }) : null;
      var all = function () {
        seen = seen.filter(function (n) { return n.isConnected; });
        document.querySelectorAll('.header__menu nav.navigation:not(.mobile)').forEach(function (n) {
          if (seen.indexOf(n) < 0) { seen.push(n); if (ro) ro.observe(n); }
        });
        seen.forEach(fit);
      };
      api = window.__hsMenuFit = { fit: fit, all: all };
      if (document.fonts && document.fonts.ready) document.fonts.ready.then(all);
      if (wide.addEventListener) wide.addEventListener('change', all);
      if (document.fonts) {
        document.fonts.addEventListener && document.fonts.addEventListener('loadingdone', all);
      }
      window.addEventListener('load', all);
      document.addEventListener('shopify:section:load', all);
      document.addEventListener('storelib:section-load', all);
      if (!ro) window.addEventListener('resize', all, { passive: true });
      document.addEventListener('click', function (e) {
        var open = document.querySelectorAll('[data-hs-more].visible');
        var t = e.target.closest && e.target.closest('[data-hs-more-toggle]');
        for (var i = 0; i < open.length; i++) {
          if (!t || !open[i].contains(t)) { if (!open[i].contains(e.target)) { open[i].classList.remove('visible'); open[i].querySelector('[data-hs-more-toggle]').setAttribute('aria-expanded', 'false'); } }
        }
        if (!t) return;
        e.preventDefault();
        var li = t.closest('[data-hs-more]');
        var on = !li.classList.contains('visible');
        li.classList.toggle('visible', on);
        t.setAttribute('aria-expanded', String(on));
      });
    }
    api.all();
  })();
</script>
