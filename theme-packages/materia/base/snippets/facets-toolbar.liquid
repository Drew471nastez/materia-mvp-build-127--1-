{%- doc -%}
  Materia Themes. The toolbar above a product grid on the search and
  collection pages: the Filter button, the result count, Sort by and the
  filters that are on as pills.

  - section_st, section_id
    the results so that they arrive with them and never push the grid down)

  Everything that changes with a filter or a sort is inside an element with
  data-facets-part, which collection.js swaps in place from the section's
  own fresh markup.

  @param {string} [base_url] - where sort links go (routes.search_url or collection.url)
  @param {string} clear_url - the address with every filter off
  @param {string} [count_text] - the result count, already worded
  @param {boolean} [enable_filtering] - draws the Filter button
  @param {string} [filter_layout] - vertical, horizontal or drawer (desktop)
  @param {string} kind - 'search' or 'collection' ('collection', 'search')
  @param {string} part - 'toolbar' (the row) or 'active' (the pills, drawn at the top of ('active', 'toolbar')
  @param {collection} results - search or collection (its filters, sort_options, sort_by)
  @param {string} section_id - Section id
  @param {object} section_st - Section settings object
  @param {string} [terms_url] - the search words, url encoded (search only)
  @param {string} [view] - View

  @example
  {% render 'facets-toolbar', results: collection, kind: 'collection', section_st: section_st, section_id: section.id, enable_filtering: enable_filtering, filter_layout: filter_layout, count_text: count_text, base_url: collection_url, terms_url: '', clear_url: clear_url, view: view, part: 'toolbar' %}
{%- enddoc -%}
{%- liquid
  assign show_count = section_st.number_products_per_page
  assign sorting = section_st.sorting
  assign sort_by = results.sort_by | default: results.default_sort_by
  assign sort_options = results.sort_options
  assign use_fallback_sort = false
  if sort_options.size == 0 and kind == 'search'
    assign use_fallback_sort = true
    assign sort_by = results.sort_by | default: 'relevance'
  endif
  comment
    Toolbar button style: theme (Theme settings > Buttons for Filter, a
    field for Sort by), outline, minimal (text with its icon) or pill.
  endcomment
  assign tb_style = section_st.toolbar_button_style | default: 'theme'
  assign fallback_sorts = 'relevance,price-ascending,price-descending,title-ascending,title-descending,created-descending' | split: ','
  comment
    filter_query: the filters that are on, so a Sort by link keeps them
    without the script too (with it, collection.js reads the address).
  endcomment
  assign active_count = 0
  assign filter_query = ''
  for filter in results.filters
    assign active_count = active_count | plus: filter.active_values.size
    if filter.type == 'price_range'
      if filter.min_value.value != null or filter.max_value.value != null
        assign active_count = active_count | plus: 1
      endif
      if filter.min_value.value != null
        assign fq_amount = filter.min_value.value | divided_by: 100.0
        assign filter_query = filter_query | append: '&' | append: filter.min_value.param_name | append: '=' | append: fq_amount
      endif
      if filter.max_value.value != null
        assign fq_amount = filter.max_value.value | divided_by: 100.0
        assign filter_query = filter_query | append: '&' | append: filter.max_value.param_name | append: '=' | append: fq_amount
      endif
    else
      for value in filter.active_values
        assign fq_param = value.param_name | default: filter.param_name
        assign fq_value = value.value | url_encode
        assign filter_query = filter_query | append: '&' | append: fq_param | append: '=' | append: fq_value
      endfor
    endif
  endfor
  assign sort_label = 'products.facets.sort_by_label' | t
  assign sort_title = sort_label | remove: ':' | strip
  assign current_label = ''
  if use_fallback_sort
    for value in fallback_sorts
      if value == sort_by
        assign key = 'sort_' | append: value | replace: '-', '_'
        assign current_label = section_st[key]
      endif
    endfor
    if current_label == blank
      assign current_label = section_st.sort_relevance
    endif
  else
    for option in sort_options
      if option.value == sort_by
        assign current_label = option.name
      endif
    endfor
    if current_label == blank
      assign current_label = sort_options.first.name
    endif
  endif
-%}
{%- if part != 'active' -%}
<div class="facets-toolbar facets-toolbar--{{ filter_layout }}" data-toolbar-style="{{ tb_style }}">
  {%- if enable_filtering -%}
    <button
      type="button"
      {% if tb_style == 'theme' %}class="facets-toolbar__filter btn btn-secondary"
      data-theme-button="secondary"
      data-button-role="secondary"{% else %}class="facets-toolbar__filter facets-tbtn facets-tbtn--{{ tb_style }}"{% endif %}
      popovertarget="FacetPanel-{{ section_id }}"
      aria-controls="FacetPanel-{{ section_id }}"
      aria-expanded="false"
      data-facets-open
    >
      <svg class="facets-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true" focusable="false">
        <path d="M4 7h9M17 7h3M4 17h3M11 17h9"/>
        <circle cx="15" cy="7" r="2"/>
        <circle cx="9" cy="17" r="2"/>
      </svg>
      <span>{{ 'collections.toolbar.filter' | t }}</span>
      <span class="facets-toolbar__badge" data-facets-part="badge">{% if active_count > 0 %}{{ active_count }}{% endif %}</span>
    </button>
  {%- endif -%}
  {%- if show_count -%}
    <p class="facets-toolbar__count" role="status" aria-live="polite" data-facets-part="count">{{ count_text }}</p>
  {%- endif -%}
  {%- if section_st.show_view_switcher -%}
    {%- comment -%}
      Columns (and the list view on a collection): the grid's columns change
      in place and are remembered for the visitor (collection.js); the list
      is drawn by the section (?view=list). Phones offer 1 or 2 columns,
      larger screens 2 to 4.
    {%- endcomment -%}
    {%- liquid
      assign vs_view = view | default: 'grid'
      assign vs_desktop = section_st.items_per_row | at_most: 4
      assign vs_mobile = section_st.items_per_row_mobile | plus: 0
      assign vs_grid_label = 'collections.toolbar.progress_bar.grid' | t
    -%}
    <div class="facets-view" role="group" aria-label="{{ vs_grid_label | escape }}" data-facets-part="view" data-facets-view="{{ vs_view }}">
      {%- for n in (1..4) -%}
        {%- liquid
          assign vs_kind = 'desktop'
          assign vs_default = vs_desktop
          if n == 1
            assign vs_kind = 'mobile'
            assign vs_default = vs_mobile
          endif
          assign vs_label = 'collections.toolbar.progress_bar.columns' | t: amount: n
        -%}
        {%- if n == 2 -%}
          <button type="button" class="facets-view__btn facets-view__btn--mobile" data-facets-cols="mobile" data-cols="2" aria-pressed="{% if vs_view != 'list' and vs_mobile == 2 %}true{% else %}false{% endif %}" aria-label="{{ vs_label | escape }}" title="{{ vs_label | escape }}">
            {{- '' -}}<svg class="facets-view__icon" width="20" height="20" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false"><rect x="3" y="3" width="6" height="14" rx="2"/><rect x="11" y="3" width="6" height="14" rx="2"/></svg>
          </button>
        {%- endif -%}
        <button type="button" class="facets-view__btn facets-view__btn--{{ vs_kind }}" data-facets-cols="{{ vs_kind }}" data-cols="{{ n }}" aria-pressed="{% if vs_view != 'list' and vs_default == n %}true{% else %}false{% endif %}" aria-label="{{ vs_label | escape }}" title="{{ vs_label | escape }}">
          {{- '' -}}<svg class="facets-view__icon" width="20" height="20" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false">{%- case n -%}
              {%- when 1 -%}<rect x="5.5" y="3" width="9" height="14" rx="2"/>
              {%- when 2 -%}<rect x="3" y="3" width="6" height="14" rx="2"/><rect x="11" y="3" width="6" height="14" rx="2"/>
              {%- when 3 -%}<rect x="2" y="3" width="4.4" height="14" rx="1.6"/><rect x="7.8" y="3" width="4.4" height="14" rx="1.6"/><rect x="13.6" y="3" width="4.4" height="14" rx="1.6"/>
              {%- else -%}<rect x="1.5" y="3" width="3.2" height="14" rx="1.2"/><rect x="5.93" y="3" width="3.2" height="14" rx="1.2"/><rect x="10.36" y="3" width="3.2" height="14" rx="1.2"/><rect x="14.8" y="3" width="3.2" height="14" rx="1.2"/>
            {%- endcase -%}
          </svg>
        </button>
      {%- endfor -%}
      {%- if kind == 'collection' -%}
        {%- assign vs_list_label = 'collections.toolbar.progress_bar.list' | t -%}
        <button type="button" class="facets-view__btn" data-facets-list aria-pressed="{% if vs_view == 'list' %}true{% else %}false{% endif %}" aria-label="{{ vs_list_label | escape }}" title="{{ vs_list_label | escape }}">
          {{- '' -}}<svg class="facets-view__icon" width="20" height="20" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false"><rect x="2.5" y="3" width="6" height="6" rx="1.6"/><rect x="2.5" y="11" width="6" height="6" rx="1.6"/><rect x="10.5" y="4" width="7" height="1.8" rx=".9"/><rect x="10.5" y="7" width="4.5" height="1.8" rx=".9"/><rect x="10.5" y="12" width="7" height="1.8" rx=".9"/><rect x="10.5" y="15" width="4.5" height="1.8" rx=".9"/></svg>
        </button>
      {%- endif -%}
    </div>
    {%- comment -%}
      The visitor's remembered columns, set before the grid is drawn so it
      never shows the default first (collection-page.css reads these).
    {%- endcomment -%}
    <script>
      (function () {
        try {
          var d = document.documentElement, s = document.currentScript, v = s && s.previousElementSibling;
          var c = { desktop: +localStorage.getItem('facets:cols-desktop') || 0, mobile: +localStorage.getItem('facets:cols-mobile') || 0 };
          if (c.desktop >= 2 && c.desktop <= 4) d.setAttribute('data-facets-cols-desktop', c.desktop);
          if (c.mobile === 1 || c.mobile === 2) d.setAttribute('data-facets-cols-mobile', c.mobile);
          if (!v || v.getAttribute('data-facets-view') === 'list') return;
          v.querySelectorAll('[data-facets-cols]').forEach(function (b) {
            var want = c[b.getAttribute('data-facets-cols')];
            if (want) b.setAttribute('aria-pressed', String(+b.getAttribute('data-cols') === want));
          });
        } catch (e) {}
      })();
    </script>
  {%- endif -%}
  {%- if sorting -%}
    {%- if sort_options.size > 0 or use_fallback_sort -%}
      <div class="facets-sort">
        <button
          type="button"
          class="facets-sort__trigger{% if tb_style == 'theme' %} input-style{% else %} facets-tbtn facets-tbtn--{{ tb_style }}{% endif %}"
          popovertarget="FacetSort-{{ section_id }}"
          aria-controls="FacetSort-{{ section_id }}"
          aria-expanded="false"
          data-facets-sort-trigger
        >
          <span class="facets-sort__label">{{ sort_label }}</span>
          <span class="facets-sort__current" data-facets-part="sort-current">{{ current_label | escape }}</span>
          <svg class="facets-sort__chevron" width="12" height="8" viewBox="0 0 12 8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m1 1.5 5 5 5-5"/></svg>
        </button>
        <div
          id="FacetSort-{{ section_id }}"
          class="facets-sort__panel"
          popover
          role="dialog"
          aria-labelledby="FacetSortTitle-{{ section_id }}"
          data-facets-sort-panel
        >
          <div class="facets-sheet__head">
            <p class="facets-sheet__title" id="FacetSortTitle-{{ section_id }}">{{ sort_title }}</p>
            <button
              type="button"
              class="facets-sheet__close"
              popovertarget="FacetSort-{{ section_id }}"
              popovertargetaction="hide"
              aria-label="{{ 'accessibility.close' | t }}"
            >
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="m1 1 12 12M13 1 1 13"/></svg>
            </button>
          </div>
          <ul class="facets-sort__options" role="list" data-facets-part="sort-options">
            {%- if use_fallback_sort -%}
              {%- for value in fallback_sorts -%}
                {%- assign key = 'sort_' | append: value | replace: '-', '_' -%}
                {%- assign label = section_st[key] -%}
                {%- if label != blank -%}
                  <li>
                    <a
                      class="facets-sort__option"
                      href="{{ base_url }}?{% if terms_url != blank %}q={{ terms_url }}&{% endif %}sort_by={{ value }}{{ filter_query | escape }}"
                      data-facets-sort="{{ value }}"
                      data-facets-key="sort-{{ value }}"
                      {% if value == sort_by %}aria-current="true"{% endif %}
                    >{{ label | escape }}</a>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            {%- else -%}
              {%- for option in sort_options -%}
                <li>
                  <a
                    class="facets-sort__option"
                    href="{{ base_url }}?{% if terms_url != blank %}q={{ terms_url }}&{% endif %}sort_by={{ option.value | escape }}{{ filter_query | escape }}"
                    data-facets-sort="{{ option.value | escape }}"
                    data-facets-key="sort-{{ option.value | escape }}"
                    {% if option.value == sort_by %}aria-current="true"{% endif %}
                  >{{ option.name | escape }}</a>
                </li>
              {%- endfor -%}
            {%- endif -%}
          </ul>
        </div>
      </div>
    {%- endif -%}
  {%- endif -%}
</div>
{%- endif -%}
{%- if part != 'toolbar' -%}
<div class="facets-active">
  {%- if active_count > 0 -%}
    <ul class="facets-active__list" role="list">
      {%- for filter in results.filters -%}
        {%- if filter.type == 'price_range' -%}
          {%- if filter.min_value.value != null or filter.max_value.value != null -%}
            {%- assign min_value = filter.min_value.value | default: 0 -%}
            {%- assign max_value = filter.max_value.value | default: filter.range_max -%}
            <li>
              <a class="facets-pill" href="{{ filter.url_to_remove }}" data-facets-link data-facets-key="pill-{{ filter.label | handleize }}">
                {%- comment -%} One end chosen: "From $70.00" or "To $50.00"; both: the range. {%- endcomment -%}
                {%- if filter.max_value.value == null -%}
                  <span>{{ section_st.price_min_label | default: 'From' | escape }} {{ min_value | money }}</span>
                {%- elsif filter.min_value.value == null -%}
                  <span>{{ section_st.price_max_label | default: 'To' | escape }} {{ max_value | money }}</span>
                {%- else -%}
                  <span>{{ min_value | money }} – {{ max_value | money }}</span>
                {%- endif -%}
                <svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="m1 1 8 8M9 1 1 9"/></svg>
                <span class="visually-hidden">{{ 'collections.sidebar.clear' | t }}</span>
              </a>
            </li>
          {%- endif -%}
        {%- else -%}
          {%- for value in filter.active_values -%}
            <li>
              <a class="facets-pill" href="{{ value.url_to_remove }}" data-facets-link data-facets-key="pill-{{ filter.label | handleize }}-{{ value.value | handleize }}">
                <span>{{ value.label | escape }}</span>
                <svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="m1 1 8 8M9 1 1 9"/></svg>
                <span class="visually-hidden">{{ 'collections.sidebar.clear' | t }}</span>
              </a>
            </li>
          {%- endfor -%}
        {%- endif -%}
      {%- endfor -%}
      <li>
        <a class="facets-pill facets-pill--clear" href="{{ clear_url }}" data-facets-link data-facets-key="pill-clear">{{ 'collections.sidebar.clear_all' | t }}</a>
      </li>
    </ul>
  {%- endif -%}
</div>
{%- endif -%}