{%- comment -%}
  Materia Themes. Developed By Materia Themes.
{%- endcomment -%}
{%- doc -%}
  Open Graph and Twitter card tags of the page. With no sharing image of its
  own, a page shares its collection's (or first product's), its blog's latest
  article image, or the store logo before it shares none.

  @param {string} [description] - The page's meta description, worked out in layout/theme.liquid

  @example
  {% render 'meta-tags', description: seo_description %}
{%- enddoc -%}
{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = description | default: page_description | default: shop.description | default: shop.name

  assign og_image = page_image
  if og_image == blank
    case request.page_type
      when 'collection'
        assign og_image = collection.image | default: collection.products.first.featured_image
      when 'blog'
        assign og_image = blog.articles.first.image
    endcase
  endif
  if og_image == blank
    assign og_image = settings.logo
  endif

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">

{%- if og_image != blank -%}
  <meta property="og:image" content="http:{{ og_image | image_url }}">
  <meta property="og:image:secure_url" content="https:{{ og_image | image_url }}">
  <meta property="og:image:width" content="{{ og_image.width }}">
  <meta property="og:image:height" content="{{ og_image.height }}">
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}

{%- liquid
  # The X / Twitter handle from Theme settings > Social media (a full x.com or twitter.com link, or a bare handle).
  assign mt_x = settings.social_x | default: settings.twitter | strip
  assign mt_x_handle = mt_x | split: '?' | first | split: '/' | last | remove: '@' | strip
-%}
{%- if mt_x_handle != blank -%}
  <meta name="twitter:site" content="@{{ mt_x_handle | escape }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
