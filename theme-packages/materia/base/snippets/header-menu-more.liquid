{%- comment -%}
  The desktop menu's More: the top-level links that do not fit on the header's
  one line, folded into the theme's own dropdown (dropdown-menu, so it opens,
  animates and colours exactly like the other dropdowns). Every link is drawn
  with its own links under it and starts hidden; snippets/header-menu-fit
  shows the folded ones and hides their places in the line.
  menu: the header's menu. uppercase_first: Header > uppercase menu.
{%- endcomment -%}
<li class="level0 menu-parent menu-parent__horizontal dropdown-menu hs-more" data-hs-more>
  <menu-item class="relative static-1025 flex justify-between align-center header-color px-15">
    <a
      class="no-underline py-10 relative lh-normal inline-flex min-h-55 min-h-1025-50 z-1 align-center{% if settings.menu_font == 'heading_font' %} heading-style{% endif %}{% if uppercase_first %} uppercase{% endif %}"
      href="#"
      role="button"
      aria-haspopup="true"
      aria-expanded="false"
      data-hs-more-toggle
    >
      <span>{{ 'main_menu.horizontal.more' | t }}</span>
      <open-children-toggle class="inline-flex flex-end align-center ms-5">
        <svg class="icon-down" width="10" height="6" aria-hidden="true">
          <use href="#icon-arrow-down" />
        </svg>
      </open-children-toggle>
    </a>
  </menu-item>
  <div class="submenu submenu-horizontal invisible-1025 absolute gradient color-default">
    <ul class="subchildmenu hs-more__list list-unstyled px-1025-0">
      {%- for link in menu.links -%}
        <li class="menu-link level-1" data-hs-more-i="{{ forloop.index0 }}" hidden>
          <a
            class="menu_item-link no-underline py-1025-5 inline-flex align-center"
            href="{{ link.url | remove: '#_blank' }}"
            {% render 'link-target', link: link %}
          >
            {%- render 'menu-link-title', title: link.title, span_class: 'menu-link-text' -%}
          </a>
          {%- if link.links.size > 0 -%}
            <ul class="hs-more__sub list-unstyled">
              {%- for child_link in link.links -%}
                <li class="menu-link level-2">
                  <a
                    class="menu_item-link no-underline py-1025-5 inline-flex align-center"
                    href="{{ child_link.url | remove: '#_blank' }}"
                    {% render 'link-target', link: child_link %}
                  >
                    {%- render 'menu-link-title', title: child_link.title, span_class: 'menu-link-text' -%}
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</li>
