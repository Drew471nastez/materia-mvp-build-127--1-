{%- comment -%}
  One sticky engine. Its rules (native position: sticky under any sticky bar
  above it, the scroll-up slide, the phone menu's top layer) are the cached
  header-sticky.css. The script stays inline: the bar's offsets and the page's
  --height-bar are written before the first paint, so nothing below moves.
{%- endcomment -%}
{{ 'header-sticky.css' | asset_url | stylesheet_tag }}
{%- if pgs.header_pill_mobile %}
<style>
  #shopify-section-{{ section.id }}:is([data-storelib-sticky="always"], [data-storelib-sticky="on-scroll-up"]):has(header.is-pill) { position: sticky !important; }
</style>
{%- endif %}
<script>
(() => {
  if (!window.StorelibStickyStack) {
    {%- comment %}Heights come from the ResizeObserver, which reports them after the
       browser's own layout, so this never lays out a page still arriving.
       Reads first, then only the values that changed are written.{% endcomment %}
    let frame, top = 0;
    const html = document.documentElement;
    const sectionOf = el => el.closest('.shopify-section, [id^="shopify-section-"]');
    const observed = new Set();
    const heights = new WeakMap();
    const written = new WeakMap();
    const observer = new ResizeObserver(entries => {
      for (const entry of entries) {
        const box = entry.borderBoxSize && entry.borderBoxSize[0];
        heights.set(entry.target, box ? box.blockSize : entry.target.getBoundingClientRect().height);
      }
      update();
    });
    const attributes = new MutationObserver(schedule);
    function update() {
      if (frame != null) { cancelAnimationFrame(frame); frame = null; }
      const header = document.querySelector('header.header[data-sticky]');
      const bars = [...document.querySelectorAll('[data-sticky-announcement]')];
      const current = new Set(bars.flatMap(bar => [bar, sectionOf(bar)]).filter(Boolean));
      let changed = false;
      for (const el of observed) if (!current.has(el)) { observer.unobserve(el); observed.delete(el); changed = true; }
      for (const el of current) if (!observed.has(el)) { observed.add(el); observer.observe(el); changed = true; }
      if (changed) {
        attributes.disconnect();
        attributes.observe(html, {attributes: true, attributeFilter: ['class']});
        for (const el of observed) attributes.observe(el, {attributes: true, attributeFilter: ['data-sticky-announcement', 'hidden', 'class']});
      }
      let offset = 0;
      const tops = new Map();
      for (const bar of bars) {
        const root = sectionOf(bar);
        if (!root) continue;
        tops.set(root, offset);
        if (bar.dataset.stickyAnnouncement !== 'true') continue;
        if (header && !(bar.compareDocumentPosition(header) & Node.DOCUMENT_POSITION_FOLLOWING)) continue;
        const height = heights.get(root) || 0;
        {%- comment %}Not laid out yet, or display: none (the observer reports 0).{% endcomment %}
        if (!height) continue;
        if (!heights.get(bar) && !bar.getClientRects().length) continue;
        const style = getComputedStyle(bar);
        if (style.display === 'none' || style.visibility === 'hidden') continue;
        offset += height;
      }
      for (const [root, value] of tops) {
        if (written.get(root) === value) continue;
        written.set(root, value);
        root.style.setProperty('--storelib-announcement-top', value + 'px');
      }
      const px = Math.max(0, offset) + 'px';
      if (written.get(html) !== px) {
        written.set(html, px);
        top = Math.max(0, offset);
        {%- comment %}--storelib-header-top is the live bottom of every bar still on
           screen, written by the header pass. A sticky-only value here put
           the header underneath bars that are not marked sticky.{% endcomment %}
        window.StorelibHeaderSticky?.refresh();
      }
    }
    function schedule() { if (frame == null) frame = requestAnimationFrame(update); }
    {%- comment %}Sections added later (a builder redraw). Watched once the page has
       arrived: during parsing every inserted node would be a record.{% endcomment %}
    const watch = () => new MutationObserver(records => {
      if (records.some(record => [...record.addedNodes, ...record.removedNodes].some(node => node.nodeType === 1 &&
          (node.matches?.('[data-sticky-announcement], header.header') || node.querySelector?.('[data-sticky-announcement], header.header'))))) schedule();
    }).observe(html, {subtree: true, childList: true});
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', () => { watch(); schedule(); }, {once: true});
    else watch();
    addEventListener('resize', schedule, {passive:true});
    document.addEventListener('shopify:section:load', schedule);
    document.addEventListener('shopify:section:unload', schedule);
    window.StorelibStickyStack = {refresh: schedule, get top() { return top; }};
  }
  window.StorelibStickyStack.refresh();
})();
(() => {
  if (!window.StorelibHeaderSticky) {
    {%- comment %}Per frame at most one read pass, then only changed values written.{% endcomment %}
    let state, frame, maxScroll = Infinity;
    {%- comment %}The scroll position is not read before the page is scrolled or loaded.{% endcomment %}
    let measured = document.readyState === 'complete';
    const html = document.documentElement;
    const wide = matchMedia('(min-width: 1025px)');
    const legacy = ['animate', 'scr-pass-header', 'sl-hdr-hidden', 'sl-header-snap'];
    const findHeader = () => document.querySelector('header.header[data-sticky]');
    {%- comment %}The show slide's length, the same as header-sticky.css.{% endcomment %}
    const SHOW_MS = 380;
    const still = matchMedia('(prefers-reduced-motion: reduce)');
    const currentY = el => { const t = getComputedStyle(el).transform; return t && t !== 'none' ? new DOMMatrixReadOnly(t).m42 : 0; };
    const setVar = (el, name, value) => { if (el.style.getPropertyValue(name) !== value) el.style.setProperty(name, value); };
    const teardown = () => {
      state?.resize?.disconnect();
      state?.attributes?.disconnect();
      state?.marker?.remove();
    };
    const setup = header => {
      teardown();
      const section = header.closest('.section-header, .shopify-section, [id^="shopify-section-"]');
      if (!section) return null;
      const own = {header, section, mode: null, hidden: false, height: 0, lastY: 0, turnY: 0, dir: 0};
      own.resize = new ResizeObserver(entries => {
        if (state !== own) return;
        const box = entries[entries.length - 1].borderBoxSize?.[0];
        const height = Math.round(box ? box.blockSize : header.offsetHeight);
        {%- comment %}An open menu drawn inside the bar is not the bar's height.{% endcomment %}
        if (height && height !== own.height && height < innerHeight * 0.7) { own.height = height; schedule(); }
      });
      own.resize.observe(header);
      own.attributes = new MutationObserver(schedule);
      own.attributes.observe(header, {attributes: true, attributeFilter: ['data-sticky', 'data-sticky-mobile', 'class']});
      {%- comment %}A wrapper around the whole header group would end sticky when it
         scrolls away: it is laid out as if it were not there.{% endcomment %}
      releaseGroup(section);
      own.marker = document.createElement('span');
      own.marker.dataset.headerAnchor = '';
      own.marker.setAttribute('aria-hidden', 'true');
      section.before(own.marker);
      return own;
    };
    {%- comment %}The header group is only as tall as the bar. Sticky inside it dies as
       soon as that box scrolls away. The builder redraws the group and drops
       this, which is why sticky randomly stops in the editor.{% endcomment %}
    const releaseGroup = section => {
      const group = section.parentElement;
      if (!group || group === document.body || group.tagName === 'MAIN' || group.querySelector('main')) return;
      const holdsBars = [...group.children].some(el => el !== section && el.nodeType === 1 && (el.matches('.shopify-section, [id^="shopify-section-"]') || el.dataset.headerAnchor != null));
      if (!holdsBars) return;
      if (group.style.getPropertyValue('display') !== 'contents') {
        group.style.setProperty('display', 'contents', 'important');
        if (state) state.markerDoc = null;
      }
    };
    const update = () => {
      frame = null;
      const header = findHeader();
      if (!header) { teardown(); state = null; return; }
      if (!state || state.header !== header || !state.section.isConnected) {
        state = setup(header);
        if (!state) return;
      }
      if (!state.marker.isConnected) state.section.before(state.marker);
      releaseGroup(state.section);
      const s = state, {section} = s;
      let mode = header.dataset.sticky;
      if (!['always', 'on-scroll-up'].includes(mode) || (!wide.matches && header.dataset.stickyMobile === 'false')) mode = 'none';
      const pill = header.classList.contains('is-pill');
      const stickyHeight=Math.max(0,window.StorelibStickyStack?.top||0);
      let top=stickyHeight;
      {%- comment %}A fixed pill is out of document flow; clear non-sticky bars while
         they remain visible. Normal sticky headers already follow their flow.{% endcomment %}
      if(pill&&getComputedStyle(section).position==='fixed'){
        document.querySelectorAll('[data-sticky-announcement]').forEach(bar=>{
          if(!(bar.compareDocumentPosition(header)&Node.DOCUMENT_POSITION_FOLLOWING))return;
          const r=bar.getBoundingClientRect();if(r.height&&getComputedStyle(bar).visibility!=='hidden')top=Math.max(top,r.bottom);
        });
      }
      {%- comment %}Never feed the scroll-dependent pill offset into page/hero heights.{% endcomment %}
      setVar(html,'--height-bar',stickyHeight+'px');
      {%- comment %}Reads. The marker's place is cached, so a scroll does not lay the page out.{% endcomment %}
      if (scrollY > maxScroll) maxScroll = Math.max(0, html.scrollHeight - innerHeight);
      const y = measured ? Math.min(Math.max(0, scrollY), maxScroll) : 0;
      {%- comment %}At the top of the page nothing needs the layout: it is not read.{% endcomment %}
      if (!s.height && y > 0) s.height = Math.round(header.getBoundingClientRect().height);
      const height = s.height;
      if (s.stackTop !== top || s.markerDoc == null) {
        s.stackTop = top;
        if (s.marker.isConnected) s.markerDoc = s.marker.getBoundingClientRect().top + scrollY;
      }
      const slot = y > 0 && s.markerDoc != null ? s.markerDoc - y : Infinity;
      {%- comment %}Decide, from the scroll alone. No drawer, search or menu class is
         read: a drawer locks the page, so it does not scroll and nothing
         changes, and a class left behind by any script can never freeze the
         bar. Crossing the desktop / phone width starts afresh.{% endcomment %}
      if (s.fresh) { s.fresh = false; s.lastY = s.turnY = y; s.dir = 0; s.hidden = false; }
      {
        if (mode === 'on-scroll-up') {
          {%- comment %}Hides once its place has scrolled away, on a real change of
             direction (12px down hides, 8px up shows). The pill floats over the
             page below its own zero tall place, so its own offset counts.{% endcomment %}
          const delta = y - s.lastY;
          const dir = delta > 0 ? 1 : delta < 0 ? -1 : s.dir;
          if (dir !== s.dir) { s.dir = dir; s.turnY = s.lastY; }
          if (pill && s.pillTop == null) s.pillTop = parseFloat(getComputedStyle(header).top) || 0;
          const away = slot + (pill ? s.pillTop || 0 : 0) + height <= top + 1;
          {%- comment %}Over an open dropdown it stays. Focus never holds it: closing the
             phone menu focuses the hamburger, which froze the bar.{% endcomment %}
          const held = header.matches(':hover') && !!header.querySelector('.menu-parent.visible');
          if (s.reveal) { s.reveal = false; s.hidden = false; s.turnY = y; }
          if (!away || held || y <= 0) s.hidden = false;
          else if (dir > 0 && y - s.turnY > 12) s.hidden = true;
          else if (dir < 0 && s.turnY - y > 8) s.hidden = false;
        } else {
          s.hidden = false;
        }
        s.lastY = y;
      }
      const overlay = (header.classList.contains('transparent') && wide.matches) ||
        (header.classList.contains('transparent-mobile') && !wide.matches);
      {%- comment %}The bar coming back never leaves its own place empty. It slides
         back in with a transform (CSS, on the compositor), and while its place
         in the page is partly on screen it is never drawn above that place:
         a fast scroll up used to catch it mid slide, the page background
         showed as a white band under the announcement bar, and the bar then
         snapped. Only then, and only until the slide ends, it is held there
         here, frame by frame, from where the slide actually is.{% endcomment %}
      if (mode !== s.mode) {
        s.mode = mode;
        section.classList.remove(...legacy);
        s.hidden = false;
        s.slide = null;
      }
      const now = performance.now();
      if (s.wasHidden && !s.hidden && !still.matches) s.slide = {t0: now, dur: SHOW_MS};
      else if (s.hidden) s.slide = null;
      s.wasHidden = s.hidden;
      let hold = '';
      if (s.slide) {
        const floor = Math.min(0, slot - top);
        if (!s.slide.held && now - s.slide.t0 < s.slide.dur) {
          const at = currentY(section);
          if (floor > at + 0.5) s.slide = {held: true, t0: now, dur: Math.max(120, s.slide.dur - (now - s.slide.t0)), from: at};
        }
        const p = Math.min(1, (now - s.slide.t0) / s.slide.dur);
        if (s.slide.held && p < 1) hold = 'translate3d(0,' + Math.max(s.slide.from * Math.pow(1 - p, 3), floor).toFixed(2) + 'px,0)';
        if (p >= 1) s.slide = null;
        else schedule();
      }
      if (s.hold !== hold) {
        s.hold = hold;
        if (hold) { section.style.setProperty('transform', hold, 'important'); section.style.setProperty('transition', 'none', 'important'); }
        else { section.style.removeProperty('transform'); section.style.removeProperty('transition'); }
      }
      {%- comment %}Writes.{% endcomment %}
      if (section.dataset.storelibSticky !== mode) section.dataset.storelibSticky = mode;
      section.toggleAttribute('data-sticky-always', mode === 'always');
      section.classList.toggle('scroll-up', mode === 'on-scroll-up');
      {%- comment %}Solid once the page has left the top (the transparent header fades to it).{% endcomment %}
      const scrolled = mode !== 'none' && y > 8;
      section.classList.toggle('shopify-section-header-sticky', scrolled);
      section.classList.toggle('header-sticky', scrolled && slot <= top + 1);
      section.classList.toggle('shopify-section-header-hidden', s.hidden);
      {%- comment %}The same state on <html>, for rules elsewhere that follow the header (theme.css .sticky.top-30); a body:has() there re-styled the whole page on every class change.{% endcomment %}
      const root = document.documentElement;
      if (root.hasAttribute('data-header-stuck') !== scrolled) root.toggleAttribute('data-header-stuck', scrolled);
      if (root.hasAttribute('data-header-hidden') !== !!s.hidden) root.toggleAttribute('data-header-hidden', !!s.hidden);
      const layout2 = section.classList.contains('layout-2');
      if (root.hasAttribute('data-header-layout-2') !== layout2) root.toggleAttribute('data-header-layout-2', layout2);
      {%- comment %}A transparent header lies over what follows it.{% endcomment %}
      const margin = overlay && height ? -height + 'px' : '';
      if (s.margin !== margin) {
        s.margin = margin;
        if (margin) section.style.setProperty('margin-bottom', margin, 'important');
        else section.style.removeProperty('margin-bottom');
      }
      const px = top + 'px';
      setVar(html, '--storelib-header-top', px);
      setVar(html, '--sl-header-offset', px);
      {%- comment %}--sticky-top: bottom edge of what is pinned now; sticky columns sit under it.{% endcomment %}
      const pinned = mode !== 'none' && !s.hidden ? height : 0;
      const stickyTop = Math.round(top + pinned) + 'px';
      {%- comment %}Every element on the page inherits these, so changing them restyles the
         whole page (40ms and more on a long one, measured). Written in the same
         frame as the slide, that work delayed the slide's first frames and it
         lurched; so a change that comes with a slide waits until the slide is
         over. The first value is written at once.{% endcomment %}
      if (s.stickyTop !== stickyTop) {
        s.stickyTop = stickyTop;
        clearTimeout(s.stickyTimer);
        const write = () => { setVar(html, '--sticky-top', s.stickyTop); setVar(html, '--product-sticky-top', s.stickyTop); };
        if (s.stickyWritten) s.stickyTimer = setTimeout(write, SHOW_MS + 60);
        else { s.stickyWritten = true; write(); }
      }
    };
    function schedule() { if (frame == null) frame = requestAnimationFrame(update); }
    {%- comment %}A header drawn again (a builder redraw) or added later.{% endcomment %}
    const watch = () => new MutationObserver(records => {
      for (const r of records) for (const n of [...r.addedNodes, ...r.removedNodes]) {
        if (n.nodeType === 1 && (n.matches('header.header[data-sticky], .shopify-section-group-header-group') || n.querySelector?.('header.header[data-sticky]'))) {
          if (state) state.markerDoc = null;
          return schedule();
        }
      }
    }).observe(html, {subtree: true, childList: true});
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', () => { watch(); schedule(); }, {once: true});
    else watch();
    {%- comment %}A drawer's, a popup's or the menu's scroll lock on <html> changes nothing the
       header measures until the panel has slid: read then, not in the frame the
       panel starts to move (its layout read made that frame long). Any other
       class change is read in the next frame, as before.{% endcomment %}
    const LOCKS = /^(?:open-drawer|open-minicart|open-search|nav-open|nav-verticalmenu|open-popup|open-sidebar|open-byl|facets-locked|overlay-closing|no-scroll|tingle-enabled|mt-lock)$/;
    let lockTimer = 0;
    new MutationObserver(records => {
      const lists = records.map(r => new Set((r.oldValue || '').split(/\s+/).filter(Boolean)));
      lists.push(new Set(html.classList));
      const all = new Set(lists.flatMap(l => [...l]));
      const changed = [...all].filter(c => !lists.every(l => l.has(c)));
      if (!changed.length) return;
      if (changed.some(c => !LOCKS.test(c))) return schedule();
      clearTimeout(lockTimer);
      lockTimer = setTimeout(schedule, SHOW_MS + 60);
    }).observe(html, {attributes: true, attributeFilter: ['class'], attributeOldValue: true});
    const seen = () => { measured = true; };
    addEventListener('scroll', seen, {passive: true, once: true});
    addEventListener('scroll', schedule, {passive: true});
    addEventListener('resize', () => {
      maxScroll = Math.max(0, html.scrollHeight - innerHeight);
      if (state) state.markerDoc = null;
      schedule();
    }, {passive: true});
    addEventListener('pageshow', () => { seen(); schedule(); });
    addEventListener('load', () => { seen(); schedule(); }, {once: true});
    wide.addEventListener?.('change', () => {
      if (state) { state.fresh = true; state.height = 0; }
      schedule();
    });
    const editorRedraw = () => {
      measured = true;
      maxScroll = Infinity;
      if (state) { state.markerDoc = null; state.stackTop = null; }
      schedule();
    };
    document.addEventListener('storelib:settings-change', editorRedraw);
    {%- comment %}Tabbing into the hidden bar brings it into view once; scrolling still hides it.{% endcomment %}
    let tabbing = false;
    document.addEventListener('keydown', e => { tabbing = e.key === 'Tab'; }, true);
    document.addEventListener('pointerdown', () => { tabbing = false; }, true);
    document.addEventListener('focusin', e => {
      if (tabbing && state?.header.contains(e.target)) { state.reveal = true; schedule(); }
    });
    ['storelib:section-load', 'shopify:section:load', 'shopify:section:unload'].forEach(n => document.addEventListener(n, editorRedraw));
    window.StorelibHeaderSticky = {register: schedule, refresh: schedule};
  }
  window.StorelibHeaderSticky.refresh();
})();
</script>
{%- comment -%} The overlay fade, the Back button clean-up and the phone menu's top layer only answer the shopper, after the theme's deferred scripts: a cached file. {%- endcomment -%}
<script src="{{ 'header-sticky-extras.js' | asset_url }}" defer="defer"></script>