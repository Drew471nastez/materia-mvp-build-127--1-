{%- doc -%}
  Prints a colour setting. An empty colour, or the stored default
  rgba(0,0,0,0), prints the fallback, which is a theme colour-scheme
  variable. A colour chosen to be clear ("transparent") prints transparent. Storelib writes the
  transparent default as "rgba(0, 0, 0, 0)" (with spaces), so both spellings
  count as transparent.

  @param {string} color - Background
  @param {string} fallback - Fallback ('var(--badge-text)', 'var(--btn-primary-bg-color)', 'var(--btn-primary-color)')

  @example
  {% render 'scheme-color', color: section.settings.bg_color, fallback: 'var(--color-background)' %}
{%- enddoc -%}
{%- liquid
  comment
    Round 28: a colour the creator chose to be clear ("Don't apply any
    color", stored as the word transparent) stays clear: a section can set a
    transparent border or background. Empty, and the stored default
    rgba(0,0,0,0), still print the fallback, as before.
  endcomment
  assign scheme_color_out = fallback | default: 'var(--color-primary)'
  if color == 'transparent'
    assign scheme_color_out = 'transparent'
  elsif color != blank and color.alpha != 0 and color != 'rgba(0,0,0,0)' and color != 'rgba(0, 0, 0, 0)' and color != '#00000000'
    assign scheme_color_out = color
  endif
-%}{{ scheme_color_out -}}