{%- doc -%}
  Materia Themes. A product's own size chart, read from its metafields:
   1. storelib.size_chart (JSON from Storelib: name, unit, columns, rows,
      rows_cm, rows_in, notes, image), drawn as a table with a cm / in switch
      when both are given; custom.size_chart of type JSON in the same shape;
   2. custom.size_chart as a page reference, rich text, HTML, a page handle,
      or multi-line text (rows split by | or commas, first line = header).
   Prints nothing when the product has none.
   Inputs: product, chart_id (optional, keeps the unit switch unique),
   storelib_only (optional: only the Storelib chart, for the background copy).

  @param {string} chart_id - Chart id
  @param {product} product - The product to render
  @param {boolean} [storelib_only] - Storelib only

  @example
  {% render 'product-size-chart-content', product: chart_product, chart_id: 'background', storelib_only: true %}
{%- enddoc -%}
{%- liquid
  assign slc = product.metafields.storelib.size_chart.value | default: product.metafields.storelib.size_chart
  if slc == blank and page.product.id == product.id
    assign slc = page.product.metafields.storelib.size_chart.value | default: page.product.metafields.storelib.size_chart
  endif
  assign mf = product.metafields.custom.size_chart
  assign mf_on = true
  if storelib_only or mf == blank
    assign mf_on = false
  endif
  if mf_on and slc == blank and mf.type == 'json'
    assign slc = mf.value
    assign mf_on = false
  endif
  assign slc_cols = slc.columns
  assign slc_rows = slc.rows
  assign slc_cm = slc.rows_cm | default: slc.tables.cm.rows
  assign slc_in = slc.rows_in | default: slc.tables.in.rows
  if slc_rows == blank
    assign slc_rows = slc_cm | default: slc_in
  endif
  assign slc_both = false
  if slc_cm != blank and slc_in != blank
    assign slc_both = true
  endif
-%}
{%- if slc != blank -%}
<div data-assigned-chart-host data-chart-product="{{ product.id }}">
<script type="application/json" data-assigned-chart-source data-chart-json="{{ slc | json | escape }}"></script>
  <div class="mt-size-chart{% if slc_both %} mt-size-chart--units{% endif %}" data-mt-size-chart data-size-triggers="{{ settings.size_trigger | default: 'Size' | escape }}">
    {%- if slc.name != blank -%}<p class="mt-size-chart__name"><strong>{{ slc.name | escape }}</strong></p>{%- endif -%}
    {%- if slc_both -%}
      {%- assign slc_uid = chart_id | default: product.id | append: '-' | append: slc_cols.size -%}
      <div class="mt-size-chart__units" role="radiogroup" aria-label="{{ 'accessibility.ui.units' | t }}">
        <label><input type="radio" name="mt-size-unit-{{ slc_uid }}" value="cm"{% unless slc.unit == 'in' %} checked{% endunless %}> cm</label>
        <label><input type="radio" name="mt-size-unit-{{ slc_uid }}" value="in"{% if slc.unit == 'in' %} checked{% endif %}> in</label>
      </div>
      {%- assign slc_sets = 'cm,in' | split: ',' -%}
    {%- else -%}
      {%- assign slc_sets = 'one' | split: ',' -%}
    {%- endif -%}
    {%- for slc_set in slc_sets -%}
      {%- case slc_set -%}
        {%- when 'cm' -%}{%- assign slc_list = slc_cm -%}
        {%- when 'in' -%}{%- assign slc_list = slc_in -%}
        {%- else -%}{%- assign slc_list = slc_rows -%}
      {%- endcase -%}
      {%- if slc_list != blank -%}
      {%- if slc_set == 'one' -%}{%- assign slc_unit = slc.unit -%}{%- else -%}{%- assign slc_unit = slc_set -%}{%- endif -%}
      <div class="mt-size-chart__scroll" data-unit="{{ slc_set }}" tabindex="0" role="region" aria-label="{{ slc.name | default: 'Size chart' | escape }}{% if slc_set != 'one' %} ({{ slc_set }}){% endif %}">
      <table class="mt-size-chart__table" data-unit="{{ slc_set }}">
        {%- if slc_cols != blank -%}
          {%- comment -%} A measurement column names its unit: a column { name, measure: true },
            or any column after the first when the columns are plain names. {%- endcomment -%}
          <thead><tr>{%- for col in slc_cols -%}
            {%- assign col_name = col.label | default: col.name -%}
            {%- assign col_measure = false -%}
            {%- if col_name != blank -%}
              {%- if col.measure == true or col.measurement == true -%}{%- assign col_measure = true -%}{%- endif -%}
              {%- if col.measure == nil and col.measurement == nil and forloop.first == false -%}{%- assign col_measure = true -%}{%- endif -%}
            {%- else -%}
              {%- assign col_name = col -%}
              {%- unless forloop.first -%}{%- assign col_measure = true -%}{%- endunless -%}
            {%- endif -%}
            <th scope="col">{{ col_name | escape }}{% if col_measure and slc_unit != blank %} ({{ slc_unit | escape }}){% endif %}</th>
          {%- endfor -%}</tr></thead>
        {%- endif -%}
        <tbody>
          {%- for row in slc_list -%}
            {%- assign cells = row | join: '|' | split: '|' -%}
            <tr>{%- for cell in cells -%}{%- if forloop.first -%}<th scope="row">{{ cell | strip | escape }}</th>{%- else -%}<td>{{ cell | strip | escape }}</td>{%- endif -%}{%- endfor -%}</tr>
          {%- endfor -%}
        </tbody>
      </table>
      </div>
      {%- endif -%}
    {%- endfor -%}
    {%- if slc.notes != blank -%}<p class="mt-size-chart__notes">{{ slc.notes | escape | newline_to_br }}</p>{%- endif -%}
    {%- if slc.image != blank -%}
      <img class="mt-size-chart__image" src="{{ slc.image | image_url: width: 1200 }}" alt="{{ slc.name | default: 'Size chart' | escape }}" loading="lazy" decoding="async" width="{{ slc.image.width | default: 1200 }}" height="{{ slc.image.height | default: 1200 }}">
    {%- endif -%}
  </div>
  </div>
{%- elsif mf_on -%}
  {%- liquid
    assign mf_html = ''
    assign mf_rows = ''
    if mf.type == 'page_reference'
      assign mf_html = mf.value.content
    elsif mf.type == 'rich_text_field'
      assign mf_html = mf | metafield_tag
    else
      assign mf_val = mf.value | default: mf
      if mf_val.content != blank
        assign mf_html = mf_val.content
      elsif mf_val contains '<'
        assign mf_html = mf_val
      elsif pages[mf_val].content != blank
        assign mf_html = pages[mf_val].content
      elsif mf_val contains '|' or mf_val contains ','
        assign mf_rows = mf_val
      else
        assign mf_html = mf_val | escape | newline_to_br | prepend: '<p>' | append: '</p>'
      endif
    endif
  -%}
  {%- if mf_rows != blank -%}
    {%- capture mf_table -%}{%- render 'size-rows-table', data: mf_rows, unit: '', uid: chart_id -%}{%- endcapture -%}
    {%- if mf_table != blank -%}{{ mf_table }}{%- else -%}<div class="mt-size-chart__html rte"><p>{{ mf_rows | escape | newline_to_br }}</p></div>{%- endif -%}
  {%- elsif mf_html != blank -%}
    <div class="mt-size-chart__html rte">{{ mf_html }}</div>
  {%- endif -%}
{%- endif -%}
