{%- comment -%}
  Materia Themes. What a product card's quick view draws, as JSON beside the
  card (snippets/product-item): pictures, options, and each variant's id,
  values, prices as the shop writes money, stock and picture. The window
  itself is built once on the page by assets/product-quick-view.js, which a
  module script loads once however many cards ask for it.
{%- endcomment -%}
{%- liquid
  assign qv_desc = product.description | default: product.content | newline_to_br | replace: '<', ' <' | strip_html | replace: '&nbsp;', ' ' | strip_newlines | split: ' ' | join: ' ' | strip | truncatewords: 32
  assign qv_selected = product.selected_or_first_available_variant
-%}
<script type="application/json" data-quick-view-data>
{
  "title": {{ product.title | json }},
  "url": {{ product.url | json }},
  "description": {{ qv_desc | json }},
  "selected": {{ qv_selected.id | json }},
  "images": [
    {%- for image in product.images limit: 8 -%}
      {{ image | image_url: width: 1100 | json }}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ],
  "alts": [
    {%- for image in product.images limit: 8 -%}
      {{ image.alt | default: product.title | json }}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ],
  "options": [
    {%- for option in product.options_with_values -%}
      { "name": {{ option.name | json }}, "values": [{%- for value in option.values -%}{{ value | append: '' | json }}{% unless forloop.last %},{% endunless %}{%- endfor -%}] }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ],
  "variants": [
    {%- for variant in product.variants -%}
      {
        "id": {{ variant.id | json }},
        "options": [{%- for value in variant.options -%}{{ value | append: '' | json }}{% unless forloop.last %},{% endunless %}{%- endfor -%}],
        "price": {{ variant.price | money | json }},
        "compare": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | json }}{% else %}""{% endif %},
        "available": {% if variant.available %}true{% else %}false{% endif %},
        "image": {% if variant.featured_image %}{{ variant.featured_image | image_url: width: 1100 | json }}{% else %}""{% endif %}
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ],
  "strings": {
    "add": {{ 'products.product.actions.add_to_cart.default.label' | t | json }},
    "soldOut": {{ 'products.product.actions.add_to_cart.sold_out.label' | t | json }}
  }
}
</script>
<script type="module" src="{{ 'product-quick-view.js' | asset_url }}"></script>
