{%- doc -%}
  Materia Themes. Developed By Materia Themes.
  Renders a placeholder image. Accepts optional `class`, `type`, `index`,
  `ratio`, `radius` (see snippets/placeholder-image.liquid).
  The picture is inline, so an empty image setting asks nothing of a
  third-party server.

  @param {string} [class] - Extra CSS classes ('absolute inset-0 w-full h-full object-fit-cover', 'rounded', 'rounded-5')
  @param {number} [index] - Index
  @param {number} [radius] - Radius; no current caller passes it
  @param {string} [ratio] - Ratio; no current caller passes it
  @param {string} type - Type ('lifestyle', 'lifestyle-1', 'lifestyle-2', 'product')

  @example
  {% render 'placeholder-render', class: 'rounded', type: 'product', index: forloop.index %}
{%- enddoc -%}
{%- assign pr_ratio = ratio | default: '4/3' -%}
{%- render 'placeholder-image', type: type, index: index, class: class, ratio: pr_ratio, radius: radius -%}
