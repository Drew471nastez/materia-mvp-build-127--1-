{%- doc -%}
  Materia Themes. One address form for the account's Addresses page on
  the platform: rendered inside {% form 'customer_address', ... %} by
  sections/main-addresses, for a new address and for each saved one.
  Params: form (the form object), uid (unique suffix), sid (section id).

  @param {object} form - The current form object
  @param {string} uid - Uid

  @example
  {% render 'customer-address-form', form: form, uid: address.id, sid: sid %}
{%- enddoc -%}
<div class="ap-addr__grid">
  <div class="ap__field">
    <label for="AddressFirstName-{{ uid }}">{{ 'customer.addresses.first_name' | t }}</label>
    <input type="text" id="AddressFirstName-{{ uid }}" name="address[first_name]" value="{{ form.first_name }}" autocomplete="given-name">
  </div>
  <div class="ap__field">
    <label for="AddressLastName-{{ uid }}">{{ 'customer.addresses.last_name' | t }}</label>
    <input type="text" id="AddressLastName-{{ uid }}" name="address[last_name]" value="{{ form.last_name }}" autocomplete="family-name">
  </div>
  <div class="ap__field ap-addr__wide">
    <label for="AddressCompany-{{ uid }}">{{ 'customer.addresses.company' | t }}</label>
    <input type="text" id="AddressCompany-{{ uid }}" name="address[company]" value="{{ form.company }}" autocomplete="organization">
  </div>
  <div class="ap__field ap-addr__wide">
    <label for="AddressAddress1-{{ uid }}">{{ 'customer.addresses.address1' | t }}</label>
    <input type="text" id="AddressAddress1-{{ uid }}" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1" required>
  </div>
  <div class="ap__field ap-addr__wide">
    <label for="AddressAddress2-{{ uid }}">{{ 'customer.addresses.address2' | t }}</label>
    <input type="text" id="AddressAddress2-{{ uid }}" name="address[address2]" value="{{ form.address2 }}" autocomplete="address-line2">
  </div>
  <div class="ap__field">
    <label for="AddressCity-{{ uid }}">{{ 'customer.addresses.city' | t }}</label>
    <input type="text" id="AddressCity-{{ uid }}" name="address[city]" value="{{ form.city }}" autocomplete="address-level2" required>
  </div>
  <div class="ap__field">
    <label for="AddressZip-{{ uid }}">{{ 'customer.addresses.zip' | t }}</label>
    <input type="text" id="AddressZip-{{ uid }}" name="address[zip]" value="{{ form.zip }}" autocapitalize="characters" autocomplete="postal-code">
  </div>
  <div class="ap__field">
    <label for="AddressCountry-{{ uid }}">{{ 'customer.addresses.country' | t }}</label>
    <select id="AddressCountry-{{ uid }}" name="address[country]" data-address-country data-default="{{ form.country }}" data-province-target="AddressProvince-{{ uid }}" autocomplete="country">
      {{ all_country_option_tags }}
    </select>
  </div>
  <div class="ap__field" data-province-wrap="AddressProvince-{{ uid }}" hidden>
    <label for="AddressProvince-{{ uid }}">{{ 'customer.addresses.province' | t }}</label>
    <select id="AddressProvince-{{ uid }}" name="address[province]" data-default="{{ form.province }}" autocomplete="address-level1"></select>
  </div>
  <div class="ap__field ap-addr__wide">
    <label for="AddressPhone-{{ uid }}">{{ 'customer.addresses.phone' | t }}</label>
    <input type="tel" id="AddressPhone-{{ uid }}" name="address[phone]" value="{{ form.phone }}" autocomplete="tel">
  </div>
  <label class="ap-addr__check ap-addr__wide">
    {{ form.set_as_default_checkbox }}
    <span>{{ 'customer.addresses.set_default' | t }}</span>
  </label>
</div>
