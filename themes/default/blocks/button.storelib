{# ===========================================================================
   Button: a theme block

   A link drawn as one of the scheme's two buttons. The colours are the
   section's: --s-btn and --s-btn2 and their hover pairs, set by the section
   from its colour scheme.
   =========================================================================== #}
<template>
<a class="sl-button sl-button--{{ block.settings.style }}" href="{{ block.settings.link | default: '#' | url }}"{% if block.settings.new_tab %} target="_blank" rel="noopener"{% endif %}>{{ block.settings.label }}</a>
</template>

<style>
& { display: flex; }
.sl-button {
  display: inline-flex; align-items: center; justify-content: center;
  padding: 13px 24px; font-size: 15px; font-weight: 600; text-decoration: none;
  border-radius: var(--s-radius, 8px); border: 1px solid transparent;
  transition: background-color 150ms ease, color 150ms ease, border-color 150ms ease;
}
.sl-button--primary { background: var(--s-btn, #111); color: var(--s-btn-text, #fff); border-color: var(--s-btn, #111); }
.sl-button--secondary { background: var(--s-btn2, transparent); color: var(--s-btn2-text, inherit); border-color: var(--s-btn2-border, currentColor); }
.sl-button--primary:hover { background: var(--s-btn-hover, var(--s-btn, #111)); color: var(--s-btn-hover-text, var(--s-btn-text, #fff)); border-color: var(--s-btn-hover, var(--s-btn, #111)); }
.sl-button--secondary:hover { background: var(--s-btn2-hover, var(--s-btn2, transparent)); color: var(--s-btn2-hover-text, var(--s-btn2-text, inherit)); }
</style>

<schema>
{
  "name": "Button",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Shop now" },
    { "type": "url", "id": "link", "label": "Link", "default": "/products" },
    { "type": "toggle", "id": "new_tab", "label": "Open in a new tab", "default": false },
    {
      "type": "radio", "id": "style", "label": "Style", "default": "primary",
      "options": [
        { "label": "Primary", "value": "primary" },
        { "label": "Secondary", "value": "secondary" }
      ]
    }
  ],
  "presets": [
    { "name": "Button" }
  ]
}
</schema>
