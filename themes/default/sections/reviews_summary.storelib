{# ===========================================================================
   Rating summary (Storelib Reviews)

   The average, the stars, how many reviews and a bar for each rating, with
   a button to every review: the product's on its page, the shop's
   anywhere else. From `reviews` through review_scope
   (lib/reviews/widgets.ts). With Storelib Reviews off it draws nothing on a
   live page.
   =========================================================================== #}
<template>
{% if reviews.enabled %}
{% for s in reviews | review_scope: settings.scope %}
{% if s.summary.count > 0 or page.in_editor %}
<div class="rw rw--{{ settings.show_on }} rw--{{ settings.star_style }}">
<section class="s rs" data-scheme="{{ settings.color_scheme }}" style="--s-bg: {{ settings.background | default: scheme.bg }}; --s-text: {{ settings.text_color | default: scheme.text }}; --s-heading: {{ settings.text_color | default: scheme.heading }}; --s-para: {{ settings.text_color | default: scheme.paragraph }}; --s-border: {{ settings.border_color | default: scheme.border }}; --s-accent: {{ scheme.accent }}; --s-btn: {{ scheme.primary_btn_bg }}; --s-btn-text: {{ scheme.primary_btn_text }}; --s-btn-hover: {{ scheme.primary_btn_hover_bg }}; --s-btn-hover-text: {{ scheme.primary_btn_hover_text }}; --s-pt: {{ settings.padding_top }}px; --s-pb: {{ settings.padding_bottom }}px; --rv-star: {{ settings.star_color | default: reviews.star_color }}; --rv-size: {{ settings.star_size }}px; --rw-scale: {{ settings.text_scale }}; --rw-hscale: {{ settings.heading_scale }}; --rw-card: {{ settings.card_background | default: 'transparent' }}; --rw-bw: {{ settings.border_width }}px; --rw-radius: {{ settings.radius }}px;">
  <div class="s__in s__in--{{ settings.max_width }}">
    {% if settings.heading or settings.subheading %}<div class="rw__head rw__head--{{ settings.align }}">{% if settings.heading %}<h2 class="s__h">{{ settings.heading }}</h2>{% endif %}{% if settings.subheading %}<p class="rw__sub">{{ settings.subheading }}</p>{% endif %}</div>{% endif %}
    {% if page.in_editor and reviews.sample %}<p class="rv__sample">Sample reviews. Your real reviews show here once you have some.</p>{% endif %}
    <div class="rs__box rs__box--{{ settings.layout }}">
      {% if s.summary.count > 0 %}
        <div class="rs__score">
          <p class="rs__avg">{{ s.summary.average_label }}</p>
          <div class="rs__meta"><span class="rv-stars rs__stars" style="--rv: {{ s.summary.percent }}%;" role="img" aria-label="{{ s.summary.average_label }} {{ words.out_of_five_stars }}"></span><p class="rs__count">{{ words.based_on }} {{ s.summary.count }} {% if s.summary.count == 1 %}{{ words.review }}{% else %}{{ words.reviews }}{% endif %}</p></div>
        </div>
        {% if settings.show_bars %}<ul class="rs__bars" aria-label="{{ words.reviews_by_rating }}">{% for b in s.summary.bars %}<li><span class="rs__n">{{ b.stars }}<span aria-hidden="true"> &#9733;</span></span><span class="rs__bar"><span style="width: {{ b.percent }}%;"></span></span><span class="rs__c">{% if settings.bar_numbers == 'percent' %}{{ b.percent }}%{% else %}{{ b.count }}{% endif %}</span></li>{% endfor %}</ul>{% endif %}
        {% if settings.link_label %}<a class="rs__btn" href="{{ settings.link | default: reviews.page_url | url }}">{{ settings.link_label }}</a>{% endif %}
      {% else %}
        <p class="rs__none">{{ words.no_reviews_yet }}</p>
      {% endif %}
    </div>
  </div>
</section>
{% if page.in_editor %}<p class="rw__off rw__off--desktop">Shown on computers only. Switch the preview to a computer to see it.</p><p class="rw__off rw__off--mobile">Shown on phones only. Switch the preview to a phone to see it.</p>{% endif %}
</div>
{% endif %}
{% endfor %}
{% endif %}
</template>

<style scoped>
.rw { container-type: inline-size; }
@container (max-width: 749px) { .rw--desktop > .s { display: none; } }
@container (min-width: 750px) { .rw--mobile > .s { display: none; } }
.rw__off { display: none; margin: 0; padding: 14px 16px; border: 1px dashed currentColor; opacity: 0.55; font: 13px/1.4 system-ui, sans-serif; text-align: center; }
@container (max-width: 749px) { .rw--desktop > .rw__off--desktop { display: block; } }
@container (min-width: 750px) { .rw--mobile > .rw__off--mobile { display: block; } }
.s { container-type: inline-size; background: var(--s-bg); color: var(--s-text); font-size: calc(15px * var(--rw-scale, 100) / 100); }
.s__in { margin: 0 auto; padding: calc(var(--s-pt) * var(--theme-spacing-scale, 1)) var(--theme-padding-x, 24px) calc(var(--s-pb) * var(--theme-spacing-scale, 1)); }
.s__in--narrow { max-width: 720px; }
.s__in--medium { max-width: 960px; }
.s__in--wide { max-width: var(--theme-page-width, 1280px); }
.s__in--full { max-width: none; }
.s__h {
  margin: 0;
  font-size: calc(var(--section-heading-size, 32px) * var(--rw-hscale, 100) / 100);
  line-height: var(--section-heading-line-height, 1.15);
  font-weight: var(--section-heading-weight, 700);
  color: var(--s-heading);
  letter-spacing: var(--section-heading-tracking, -0.01em);
  text-transform: var(--section-heading-transform, none);
  font-family: var(--section-heading-font, var(--theme-font-heading, {{ theme.typography.heading }}), ui-sans-serif, system-ui, sans-serif);
}
.rw__head { margin-bottom: 28px; }
.rw__head--center { text-align: center; }
.rw__sub { margin: 10px 0 0; font-size: calc(var(--section-text-size, 17px) * var(--rw-scale, 100) / 100); line-height: 1.6; color: var(--s-para); max-width: 44rem; }
.rw__head--center .rw__sub { margin-left: auto; margin-right: auto; }
.rv__sample { margin: -12px 0 20px; font-size: 13px; color: var(--s-para); opacity: 0.7; }
.rv-stars { --rv-g: "\2605\2605\2605\2605\2605"; position: relative; display: inline-block; flex: none; font-size: var(--rv-size, 16px); line-height: 1; letter-spacing: 0.12em; white-space: nowrap; color: color-mix(in srgb, var(--s-para) 22%, transparent); }
.rv-stars::before { content: var(--rv-g); }
.rv-stars::after { content: var(--rv-g); position: absolute; inset: 0 auto 0 0; width: var(--rv, 0%); overflow: hidden; white-space: nowrap; color: var(--rv-star, var(--s-accent)); }
.rw--outline .rv-stars { color: transparent; -webkit-text-stroke: 1px var(--rv-star, var(--s-accent)); }
.rw--outline .rv-stars::after { -webkit-text-stroke: 0; }
.rw--heart .rv-stars { --rv-g: "\2665\2665\2665\2665\2665"; }
.rs__box { display: grid; gap: 24px 48px; align-items: center; box-sizing: border-box; padding: clamp(20px, 4cqi, 32px); background: var(--rw-card); border: var(--rw-bw) solid var(--s-border); border-radius: var(--rw-radius); }
@container (min-width: 700px) { .rs__box--row { grid-template-columns: auto minmax(0, 1fr) auto; } }
.rs__box--stacked { justify-items: center; text-align: center; max-width: 520px; margin: 0 auto; }
.rs__score { display: flex; align-items: center; gap: 16px; }
.rs__box--stacked .rs__score { flex-direction: column; gap: 8px; }
.rs__avg { margin: 0; font-size: 3.2em; font-weight: 700; line-height: 1; color: var(--s-heading); font-variant-numeric: tabular-nums; }
.rs__meta { display: flex; flex-direction: column; gap: 6px; }
.rs__box--stacked .rs__meta { align-items: center; }
.rs__count { margin: 0; font-size: 0.93em; color: var(--s-para); }
.rs__none { margin: 0; color: var(--s-para); }
.rs__bars { list-style: none; margin: 0; padding: 0; display: grid; gap: 7px; width: 100%; min-width: 0; max-width: 420px; }
.rs__bars li { display: grid; grid-template-columns: 34px minmax(0, 1fr) 40px; align-items: center; gap: 10px; font-size: 0.87em; color: var(--s-para); font-variant-numeric: tabular-nums; }
.rs__bar { height: 8px; border-radius: 999px; background: color-mix(in srgb, var(--s-para) 14%, transparent); overflow: hidden; }
.rs__bar span { display: block; height: 100%; border-radius: inherit; background: var(--rv-star, var(--s-accent)); }
.rs__c { text-align: right; }
.rs__btn { display: inline-flex; align-items: center; justify-content: center; padding: var(--sl-button-padding, 12px 22px); font-size: var(--sl-button-size, 15px); font-weight: var(--theme-button-weight, 600); border-radius: calc(var(--rw-radius) * 0.6); border: 1px solid var(--s-btn); background: var(--s-btn); color: var(--s-btn-text); text-decoration: none; white-space: nowrap; transition: background-color 150ms ease, color 150ms ease; }
.rs__btn:hover { background: var(--s-btn-hover); color: var(--s-btn-hover-text); border-color: var(--s-btn-hover); }
</style>

<schema>
{
  "schema_version": 1,
  "type": "reviews_summary",
  "name": "Rating summary",
  "category": "reviews",
  "description": "Storelib Reviews: the average and a bar for each rating.",
  "version": "1.0.0",
  "icon": "star",
  "settings": [
    {
      "type": "header",
      "id": "hdr_content",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Customer reviews"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Supporting line",
      "default": ""
    },
    {
      "type": "radio",
      "id": "align",
      "label": "Heading sits",
      "default": "left",
      "options": [
        {
          "label": "Left",
          "value": "left"
        },
        {
          "label": "Centre",
          "value": "center"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_reviews",
      "label": "Rating"
    },
    {
      "type": "select",
      "id": "scope",
      "label": "Whose rating",
      "default": "here",
      "options": [
        {
          "label": "This page: the product's on a product page",
          "value": "here"
        },
        {
          "label": "The whole shop",
          "value": "all"
        }
      ]
    },
    {
      "type": "toggle",
      "id": "show_bars",
      "label": "A bar for each rating",
      "default": true
    },
    {
      "type": "radio",
      "id": "bar_numbers",
      "label": "Beside each bar",
      "default": "count",
      "options": [
        {
          "label": "How many",
          "value": "count"
        },
        {
          "label": "Share",
          "value": "percent"
        }
      ]
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Button label",
      "default": "Read all reviews"
    },
    {
      "type": "text",
      "id": "link",
      "label": "Button link",
      "default": "",
      "info": "Empty goes to the shop's reviews page. #reviews jumps to the reviews on the same page."
    },
    {
      "type": "header",
      "id": "hdr_layout",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "row",
      "options": [
        {
          "label": "In a row",
          "value": "row"
        },
        {
          "label": "Stacked, centred",
          "value": "stacked"
        }
      ]
    },
    {
      "type": "select",
      "id": "max_width",
      "label": "Content width",
      "default": "wide",
      "options": [
        {
          "label": "Narrow",
          "value": "narrow"
        },
        {
          "label": "Medium",
          "value": "medium"
        },
        {
          "label": "Wide",
          "value": "wide"
        },
        {
          "label": "Full",
          "value": "full"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_style",
      "label": "Style"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "white"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "",
      "info": "Empty uses the colour scheme."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "",
      "info": "Empty uses the colour scheme."
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": ""
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "",
      "info": "Empty uses the colour scheme."
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "default": 1,
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Corner radius",
      "default": 16,
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "star_style",
      "label": "Stars",
      "default": "solid",
      "options": [
        {
          "label": "Solid",
          "value": "solid"
        },
        {
          "label": "Outline",
          "value": "outline"
        },
        {
          "label": "Hearts",
          "value": "heart"
        }
      ]
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star colour",
      "default": "",
      "info": "Empty uses the colour set in Storelib Reviews."
    },
    {
      "type": "range",
      "id": "star_size",
      "label": "Star size",
      "default": 20,
      "min": 10,
      "max": 40,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "id": "hdr_type",
      "label": "Typography"
    },
    {
      "type": "range",
      "id": "text_scale",
      "label": "Text size",
      "default": 100,
      "min": 80,
      "max": 140,
      "step": 5,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "heading_scale",
      "label": "Heading size",
      "default": 100,
      "min": 60,
      "max": 160,
      "step": 5,
      "unit": "%"
    },
    {
      "type": "header",
      "id": "hdr_visibility",
      "label": "Visibility"
    },
    {
      "type": "select",
      "id": "show_on",
      "label": "Show on",
      "default": "all",
      "options": [
        {
          "label": "Phones and computers",
          "value": "all"
        },
        {
          "label": "Computers only",
          "value": "desktop"
        },
        {
          "label": "Phones only",
          "value": "mobile"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_spacing",
      "label": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "default": 64,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "default": 64,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Rating summary",
      "settings": {}
    }
  ]
}
</schema>
