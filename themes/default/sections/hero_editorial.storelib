{# ===========================================================================
   Editorial hero: oversized type set like a magazine cover, an asymmetric
   split under it, an optional photograph. The heading takes the theme's
   Heading 1 font, weight and spacing at a size of its own (Heading size),
   fluid with the width the section has.
   =========================================================================== #}
<template>
<section class="s he he--{{ settings.layout }} he--img-{{ settings.image_side }}{% if settings.image %} he--has-img{% elsif page.in_editor %} he--has-img{% endif %}" data-scheme="{{ settings.color_scheme }}" style="--s-bg: {{ scheme.bg }}; --s-text: {{ scheme.text }}; --s-heading: {{ scheme.heading }}; --s-para: {{ scheme.paragraph }}; --s-border: {{ scheme.border }}; --s-accent: {{ scheme.accent }}; --s-btn: {{ scheme.primary_btn_bg }}; --s-btn-text: {{ scheme.primary_btn_text }}; --s-btn2: {{ scheme.secondary_btn_bg }}; --s-btn2-text: {{ scheme.secondary_btn_text }}; --s-btn2-border: {{ scheme.secondary_btn_border }}; --s-btn-hover: {{ scheme.primary_btn_hover_bg }}; --s-btn-hover-text: {{ scheme.primary_btn_hover_text }}; --s-btn2-hover: {{ scheme.secondary_btn_hover_bg }}; --s-btn2-hover-text: {{ scheme.secondary_btn_hover_text }}; --s-radius: {{ theme.radius.medium }}px; --s-pt: {{ settings.padding_top }}px; --s-pb: {{ settings.padding_bottom }}px; --he-size: {{ settings.heading_size }};">
  <div class="s__in s__in--{{ settings.max_width }}">
    <div class="he__grid">
      <div class="he__top">
        {% if settings.eyebrow %}<p class="s__eyebrow">{{ settings.eyebrow }}</p>{% endif %}
        {% if settings.heading %}<h1 class="he__h">{{ settings.heading }}</h1>{% endif %}
      </div>
      <div class="he__body">
        {% if settings.subheading %}<p class="he__sub">{{ settings.subheading }}</p>{% endif %}
        {% if settings.button_text or settings.button2_text %}
          <div class="s__btns">
            {% if settings.button_text %}<a class="s__btn s__btn--primary" href="{{ settings.button_url | default: '#' | url }}">{{ settings.button_text }}</a>{% endif %}
            {% if settings.button2_text %}<a class="s__btn s__btn--secondary" href="{{ settings.button2_url | default: '#' | url }}">{{ settings.button2_text }}</a>{% endif %}
          </div>
        {% endif %}
        {% if settings.detail_1 or settings.detail_2 %}
          <dl class="he__meta">
            {% if settings.detail_1 %}<div><dt>{{ settings.detail_1_label }}</dt><dd>{{ settings.detail_1 }}</dd></div>{% endif %}
            {% if settings.detail_2 %}<div><dt>{{ settings.detail_2_label }}</dt><dd>{{ settings.detail_2 }}</dd></div>{% endif %}
          </dl>
        {% endif %}
      </div>
      {% if settings.image %}
        <figure class="he__media">
          <img src="{{ settings.image | asset }}" alt="{{ settings.image_alt }}" loading="eager" fetchpriority="high" decoding="async" data-media>
          {% if settings.caption %}<figcaption>{{ settings.caption }}</figcaption>{% endif %}
        </figure>
      {% elsif page.in_editor %}
        <figure class="he__media"><div class="ph"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="2"/><path d="M21 17l-5-5-9 8"/></svg><span>Add a photograph, or leave it empty for type only</span></div></figure>
      {% endif %}
    </div>
  </div>
</section>
</template>

<style scoped>
.s { container-type: inline-size; background: var(--s-bg); color: var(--s-text); }
.s__in {
  margin: 0 auto;
  padding: calc(var(--s-pt) * var(--theme-spacing-scale, 1)) var(--theme-padding-x, 24px) calc(var(--s-pb) * var(--theme-spacing-scale, 1));
}
.s__in--narrow { max-width: 720px; }
.s__in--medium { max-width: 960px; }
.s__in--wide { max-width: var(--theme-page-width, 1280px); }
.s__in--full { max-width: none; }
.s__eyebrow { margin: 0 0 14px; font-family: var(--sl-caption-font); font-size: var(--sl-caption-size, 12px); font-weight: var(--sl-caption-weight, 600); letter-spacing: var(--sl-caption-tracking, 0.14em); text-transform: var(--sl-caption-transform, uppercase); color: var(--s-accent); }
.s__h {
  margin: 0;
  font-size: var(--section-heading-size, 32px);
  line-height: var(--section-heading-line-height, 1.15);
  font-weight: var(--section-heading-weight, 700);
  color: var(--s-heading);
  letter-spacing: var(--section-heading-tracking, -0.01em);
  text-transform: var(--section-heading-transform, none);
  font-family: var(--section-heading-font, var(--theme-font-heading, {{ theme.typography.heading }}), ui-sans-serif, system-ui, sans-serif);
  text-wrap: balance;
}
.s__sub { margin: 16px 0 0; max-width: 38rem; font-size: var(--section-text-size, 17px); line-height: var(--section-text-line-height, 1.6); color: var(--s-para); text-wrap: pretty; }
.s__head { max-width: 46rem; }
.s__head--center { margin-inline: auto; text-align: center; }
.s__head--center .s__sub { margin-inline: auto; }
.s__btns { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
.s__head--center .s__btns { justify-content: center; }
.s__btn {
  display: inline-flex; align-items: center; justify-content: center; min-height: 44px;
  padding: var(--sl-button-padding, 13px 24px); font-size: var(--sl-button-size, 15px); line-height: var(--sl-button-line-height); font-weight: var(--theme-button-weight, 600); text-decoration: none;
  border-radius: var(--s-radius); border: 1px solid transparent; transition: background-color 180ms ease, color 180ms ease, border-color 180ms ease, transform 180ms ease;
}
.s__btn--primary:hover { background: var(--s-btn-hover); color: var(--s-btn-hover-text); border-color: var(--s-btn-hover); }
.s__btn--secondary:hover { background: var(--s-btn2-hover); color: var(--s-btn2-hover-text); }
.s__btn--primary { background: var(--s-btn); color: var(--s-btn-text); border-color: var(--s-btn); }
.s__btn--secondary { background: var(--s-btn2); color: var(--s-btn2-text); border-color: var(--s-btn2-border); }
.s__btn:focus-visible, .s a:focus-visible { outline: 2px solid var(--s-accent); outline-offset: 3px; }
.s__note { margin: 18px 0 0; font-size: 13px; color: var(--s-para); }
.ph { display: grid !important; place-content: center; justify-items: center; gap: 8px; width: 100%; height: 100%; min-height: 160px; box-sizing: border-box; border: 1px dashed var(--s-border); background: color-mix(in srgb, var(--s-text) 5%, transparent); color: var(--s-para); font-size: 13px; text-align: center; padding: 16px; }
.ph svg { width: 28px; height: 28px; fill: none; stroke: currentColor; stroke-width: 1.5; }

.he__grid { display: grid; gap: 32px; grid-template-columns: minmax(0, 1fr); }
.he__h {
  margin: 0; color: var(--s-heading); text-wrap: balance;
  font-family: var(--type-h1-font, var(--theme-font-heading)), ui-serif, Georgia, serif;
  font-weight: var(--type-h1-weight, 600); line-height: var(--type-h1-line-height, 1); letter-spacing: var(--type-h1-tracking, -0.02em); text-transform: var(--type-h1-transform, none);
  font-size: clamp(44px, calc(var(--he-size, 11) * 1cqi), calc(var(--he-size, 11) * 15px));
}
.he__sub { margin: 0; max-width: 30rem; font-size: var(--type-body-large-size, 19px); line-height: 1.6; color: var(--s-para); text-wrap: pretty; }
.he__body .s__btns { margin-top: 28px; }
.he__meta { display: flex; flex-wrap: wrap; gap: 16px 40px; margin: 36px 0 0; padding-top: 20px; border-top: 1px solid var(--s-border); }
.he__meta div { min-width: 0; }
.he__meta dt { margin: 0 0 4px; font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--s-para); }
.he__meta dd { margin: 0; font-size: 15px; color: var(--s-heading); }
.he__media { margin: 0; min-width: 0; }
.he__media img, .he__media .ph { display: block; width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: var(--sl-image-radius, var(--s-radius)); }
.he__media figcaption { margin-top: 10px; font-size: 12px; color: var(--s-para); }
@container (min-width: 900px) {
  .he__grid { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 24px; row-gap: 56px; align-items: end; }
  .he__top { grid-column: 1 / -1; }
  .he--split .he__top { grid-column: 1 / span 7; align-self: center; }
  .he__body { grid-column: 8 / -1; }
  .he--has-img .he__body { grid-column: 1 / span 4; grid-row: 2; align-self: end; }
  .he--has-img .he__media { grid-column: 6 / -1; grid-row: 2; }
  .he--has-img.he--img-left .he__body { grid-column: 9 / -1; }
  .he--has-img.he--img-left .he__media { grid-column: 1 / span 7; }
  .he--split.he--has-img .he__top { grid-row: 1; }
  .he--split.he--has-img .he__body { grid-column: 1 / span 6; grid-row: 2; }
  .he--split.he--has-img .he__media { grid-column: 8 / -1; grid-row: 1 / span 2; align-self: stretch; }
  .he--split.he--has-img.he--img-left .he__top, .he--split.he--has-img.he--img-left .he__body { grid-column: 6 / -1; }
  .he--split.he--has-img.he--img-left .he__media { grid-column: 1 / span 5; }
  .he--split .he__media img, .he--split .he__media .ph { height: 100%; aspect-ratio: auto; min-height: 520px; }
  .he--cover .he__media img, .he--cover .he__media .ph { aspect-ratio: 3 / 2; }
}
</style>

<schema>
{
  "schema_version": 1,
  "type": "hero_editorial",
  "name": "Editorial Hero",
  "category": "hero",
  "description": "Oversized type set like a magazine cover, an asymmetric split under it and an optional photograph.",
  "icon": "type",
  "settings": [
    {
      "type": "header",
      "id": "hdr_content",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Spring collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Objects made slowly, to be kept"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Supporting line",
      "default": "Say in a sentence or two what you make and who it is for."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button",
      "default": "See the collection"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link",
      "default": "/products"
    },
    {
      "type": "text",
      "id": "button2_text",
      "label": "Second button",
      "default": ""
    },
    {
      "type": "url",
      "id": "button2_url",
      "label": "Second button link",
      "default": ""
    },
    {
      "type": "text",
      "id": "detail_1_label",
      "label": "Detail 1 label",
      "default": "Made in"
    },
    {
      "type": "text",
      "id": "detail_1",
      "label": "Detail 1",
      "default": ""
    },
    {
      "type": "text",
      "id": "detail_2_label",
      "label": "Detail 2 label",
      "default": "Since"
    },
    {
      "type": "text",
      "id": "detail_2",
      "label": "Detail 2",
      "default": ""
    },
    {
      "type": "header",
      "id": "hdr_image",
      "label": "Photograph"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photograph",
      "default": "",
      "info": "Optional. Without one the heading carries the page on its own."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Photograph description",
      "default": "",
      "info": "Read aloud to people who cannot see it."
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Caption",
      "default": ""
    },
    {
      "type": "radio",
      "id": "image_side",
      "label": "Photograph on",
      "default": "right",
      "options": [
        {
          "label": "Left",
          "value": "left"
        },
        {
          "label": "Right",
          "value": "right"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_layout",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "stacked",
      "options": [
        {
          "label": "Heading across the top",
          "value": "stacked"
        },
        {
          "label": "Heading beside the photograph",
          "value": "split"
        },
        {
          "label": "Wide photograph",
          "value": "cover"
        }
      ]
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "default": 11,
      "min": 6,
      "max": 15,
      "step": 1,
      "info": "How big the heading is against the width of the page. It still fits a phone."
    },
    {
      "type": "select",
      "id": "max_width",
      "label": "Content width",
      "default": "wide",
      "options": [
        {
          "label": "Narrow",
          "value": "narrow"
        },
        {
          "label": "Medium",
          "value": "medium"
        },
        {
          "label": "Wide",
          "value": "wide"
        },
        {
          "label": "Full",
          "value": "full"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_style",
      "label": "Style"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "white"
    },
    {
      "type": "header",
      "id": "hdr_spacing",
      "label": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "default": 72,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "default": 96,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Editorial Hero"
    },
    {
      "name": "Editorial Hero, heading beside the photograph",
      "settings": {
        "layout": "split",
        "heading_size": 8
      }
    },
    {
      "name": "Editorial Hero, type only",
      "settings": {
        "heading_size": 13,
        "detail_1": "",
        "button2_text": "Our story",
        "button2_url": "/about"
      }
    }
  ]
}
</schema>
