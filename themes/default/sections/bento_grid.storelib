{# ===========================================================================
   Bento grid: tiles of different sizes on a four column grid, each a
   picture or words, each with its own width and height (Tile width, Tile
   height). Two columns on a tablet, one on a phone, where every tile is
   full width and the tall ones keep a little of their height.
   =========================================================================== #}
<template>
<section class="s bg" data-scheme="{{ settings.color_scheme }}" style="--s-bg: {{ scheme.bg }}; --s-text: {{ scheme.text }}; --s-heading: {{ scheme.heading }}; --s-para: {{ scheme.paragraph }}; --s-border: {{ scheme.border }}; --s-accent: {{ scheme.accent }}; --s-btn: {{ scheme.primary_btn_bg }}; --s-btn-text: {{ scheme.primary_btn_text }}; --s-btn2: {{ scheme.secondary_btn_bg }}; --s-btn2-text: {{ scheme.secondary_btn_text }}; --s-btn2-border: {{ scheme.secondary_btn_border }}; --s-btn-hover: {{ scheme.primary_btn_hover_bg }}; --s-btn-hover-text: {{ scheme.primary_btn_hover_text }}; --s-btn2-hover: {{ scheme.secondary_btn_hover_bg }}; --s-btn2-hover-text: {{ scheme.secondary_btn_hover_text }}; --s-radius: {{ theme.radius.medium }}px; --s-pt: {{ settings.padding_top }}px; --s-pb: {{ settings.padding_bottom }}px; --bg-row: {{ settings.row_height }}px; --bg-gap: {{ settings.gap }}px;">
  <div class="s__in s__in--{{ settings.max_width }}">
    {% if settings.eyebrow or settings.heading or settings.subheading %}
      <div class="s__head{% if settings.align == 'center' %} s__head--center{% endif %}">
        {% if settings.eyebrow %}<p class="s__eyebrow">{{ settings.eyebrow }}</p>{% endif %}
        {% if settings.heading %}<h2 class="s__h">{{ settings.heading }}</h2>{% endif %}
        {% if settings.subheading %}<p class="s__sub">{{ settings.subheading }}</p>{% endif %}
      </div>
    {% endif %}
    {% if blocks.size == 0 %}
      {% if page.in_editor %}<p class="bg__empty">Add tiles in the sidebar</p>{% endif %}
    {% else %}
      <div class="bg__grid">
        {% for block in blocks %}
          <article class="bg__tile bg__tile--c{{ block.settings.width }} bg__tile--r{{ block.settings.height }} bg__tile--{{ block.settings.style }}{% if block.settings.image %} bg__tile--img{% endif %}" data-container data-block-id="{{ block.id }}">
            {% if block.settings.image %}
              <img class="bg__img" src="{{ block.settings.image | asset }}" alt="{{ block.settings.image_alt }}" loading="lazy" decoding="async">
            {% elsif block.settings.style == 'photo' and page.in_editor %}
              <div class="bg__img"><div class="ph"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="2"/><path d="M21 17l-5-5-9 8"/></svg><span>Add a photograph</span></div></div>
            {% endif %}
            <div class="bg__body">
              {% if block.settings.kicker %}<p class="bg__kicker">{{ block.settings.kicker }}</p>{% endif %}
              {% if block.settings.title %}<h3 class="bg__title">{{ block.settings.title }}</h3>{% endif %}
              {% if block.settings.text %}<p class="bg__text">{{ block.settings.text }}</p>{% endif %}
              {% if block.settings.link_text %}<a class="bg__link" href="{{ block.settings.link | default: '#' | url }}">{{ block.settings.link_text }} <span aria-hidden="true">→</span></a>{% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>
</template>

<style scoped>
.s { container-type: inline-size; background: var(--s-bg); color: var(--s-text); }
.s__in {
  margin: 0 auto;
  padding: calc(var(--s-pt) * var(--theme-spacing-scale, 1)) var(--theme-padding-x, 24px) calc(var(--s-pb) * var(--theme-spacing-scale, 1));
}
.s__in--narrow { max-width: 720px; }
.s__in--medium { max-width: 960px; }
.s__in--wide { max-width: var(--theme-page-width, 1280px); }
.s__in--full { max-width: none; }
.s__eyebrow { margin: 0 0 14px; font-family: var(--sl-caption-font); font-size: var(--sl-caption-size, 12px); font-weight: var(--sl-caption-weight, 600); letter-spacing: var(--sl-caption-tracking, 0.14em); text-transform: var(--sl-caption-transform, uppercase); color: var(--s-accent); }
.s__h {
  margin: 0;
  font-size: var(--section-heading-size, 32px);
  line-height: var(--section-heading-line-height, 1.15);
  font-weight: var(--section-heading-weight, 700);
  color: var(--s-heading);
  letter-spacing: var(--section-heading-tracking, -0.01em);
  text-transform: var(--section-heading-transform, none);
  font-family: var(--section-heading-font, var(--theme-font-heading, {{ theme.typography.heading }}), ui-sans-serif, system-ui, sans-serif);
  text-wrap: balance;
}
.s__sub { margin: 16px 0 0; max-width: 38rem; font-size: var(--section-text-size, 17px); line-height: var(--section-text-line-height, 1.6); color: var(--s-para); text-wrap: pretty; }
.s__head { max-width: 46rem; }
.s__head--center { margin-inline: auto; text-align: center; }
.s__head--center .s__sub { margin-inline: auto; }
.s__btns { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
.s__head--center .s__btns { justify-content: center; }
.s__btn {
  display: inline-flex; align-items: center; justify-content: center; min-height: 44px;
  padding: var(--sl-button-padding, 13px 24px); font-size: var(--sl-button-size, 15px); line-height: var(--sl-button-line-height); font-weight: var(--theme-button-weight, 600); text-decoration: none;
  border-radius: var(--s-radius); border: 1px solid transparent; transition: background-color 180ms ease, color 180ms ease, border-color 180ms ease, transform 180ms ease;
}
.s__btn--primary:hover { background: var(--s-btn-hover); color: var(--s-btn-hover-text); border-color: var(--s-btn-hover); }
.s__btn--secondary:hover { background: var(--s-btn2-hover); color: var(--s-btn2-hover-text); }
.s__btn--primary { background: var(--s-btn); color: var(--s-btn-text); border-color: var(--s-btn); }
.s__btn--secondary { background: var(--s-btn2); color: var(--s-btn2-text); border-color: var(--s-btn2-border); }
.s__btn:focus-visible, .s a:focus-visible { outline: 2px solid var(--s-accent); outline-offset: 3px; }
.s__note { margin: 18px 0 0; font-size: 13px; color: var(--s-para); }
.ph { display: grid !important; place-content: center; justify-items: center; gap: 8px; width: 100%; height: 100%; min-height: 160px; box-sizing: border-box; border: 1px dashed var(--s-border); background: color-mix(in srgb, var(--s-text) 5%, transparent); color: var(--s-para); font-size: 13px; text-align: center; padding: 16px; }
.ph svg { width: 28px; height: 28px; fill: none; stroke: currentColor; stroke-width: 1.5; }

.bg .s__head { margin-bottom: 40px; }
.bg__empty { margin: 0; padding: 24px; border: 1px dashed var(--s-border); text-align: center; font-size: 13px; color: var(--s-para); }
.bg__grid { display: grid; gap: var(--bg-gap, 16px); grid-template-columns: minmax(0, 1fr); grid-auto-flow: dense; }
.bg__tile { position: relative; isolation: isolate; overflow: hidden; display: flex; flex-direction: column; justify-content: flex-end; min-height: calc(var(--bg-row) * 1); border-radius: var(--s-radius); background: color-mix(in srgb, var(--s-heading) 5%, var(--s-bg)); border: 1px solid var(--s-border); }
.bg__tile--r2, .bg__tile--r3 { min-height: calc(var(--bg-row) * 1.5); }
.bg__tile--accent { background: var(--s-accent); border-color: var(--s-accent); }
.bg__tile--inverse { background: var(--s-heading); border-color: var(--s-heading); }
.bg__tile--accent .bg__title, .bg__tile--accent .bg__text, .bg__tile--accent .bg__kicker, .bg__tile--accent .bg__link,
.bg__tile--inverse .bg__title, .bg__tile--inverse .bg__text, .bg__tile--inverse .bg__kicker, .bg__tile--inverse .bg__link { color: var(--s-bg); }
.bg__img { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; transition: transform 600ms cubic-bezier(.2,.7,.2,1); }
.bg__img .ph { border: 0; }
.bg__tile--img::after { content: ""; position: absolute; inset: 0; z-index: -1; background: linear-gradient(to top, color-mix(in srgb, var(--s-heading) 72%, transparent), transparent 60%); }
.bg__tile--img:hover .bg__img { transform: scale(1.04); }
.bg__tile--img .bg__title, .bg__tile--img .bg__text, .bg__tile--img .bg__kicker, .bg__tile--img .bg__link { color: var(--s-bg); }
.bg__body { padding: 24px; }
.bg__kicker { margin: 0 0 8px; font-size: 12px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--s-accent); }
.bg__title { margin: 0; color: var(--s-heading); font-family: var(--type-h3-font, var(--theme-font-heading)), ui-sans-serif, system-ui, sans-serif; font-weight: var(--type-h3-weight, 600); letter-spacing: var(--type-h3-tracking, -0.01em); font-size: clamp(20px, 2cqi, 26px); line-height: 1.2; text-wrap: balance; }
.bg__tile--c3 .bg__title, .bg__tile--c4 .bg__title, .bg__tile--r2.bg__tile--c2 .bg__title { font-size: clamp(24px, 3.2cqi, 40px); }
.bg__text { margin: 8px 0 0; max-width: 36ch; font-size: 15px; line-height: 1.55; color: var(--s-para); }
.bg__link { display: inline-block; margin-top: 14px; font-size: 14px; font-weight: 600; color: var(--s-heading); text-decoration: none; }
.bg__link::before { content: ""; position: absolute; inset: 0; z-index: 1; }
.bg__link:hover { text-decoration: underline; text-underline-offset: 4px; }
@container (min-width: 640px) {
  .bg__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: var(--bg-row); }
  .bg__tile { min-height: 0; }
  .bg__tile--c2, .bg__tile--c3, .bg__tile--c4 { grid-column: span 2; }
  .bg__tile--r2 { grid-row: span 2; }
  .bg__tile--r3 { grid-row: span 3; }
}
@container (min-width: 960px) {
  .bg__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .bg__tile--c3 { grid-column: span 3; }
  .bg__tile--c4 { grid-column: span 4; }
  .bg__body { padding: 28px; }
}
@media (prefers-reduced-motion: reduce) { .bg__img { transition: none; } .bg__tile--img:hover .bg__img { transform: none; } }
</style>

<schema>
{
  "schema_version": 1,
  "type": "bento_grid",
  "name": "Bento Grid",
  "category": "features",
  "description": "Tiles of different sizes, pictures and words, on one grid. Each tile sets its own width and height.",
  "icon": "layout-grid",
  "settings": [
    {
      "type": "header",
      "id": "hdr_content",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": ""
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Everything in one place"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Supporting line",
      "default": ""
    },
    {
      "type": "radio",
      "id": "align",
      "label": "Heading alignment",
      "default": "left",
      "options": [
        {
          "label": "Left",
          "value": "left"
        },
        {
          "label": "Centre",
          "value": "center"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_layout",
      "label": "Layout"
    },
    {
      "type": "range",
      "id": "row_height",
      "label": "Row height",
      "default": 220,
      "min": 120,
      "max": 360,
      "step": 10,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Space between tiles",
      "default": 16,
      "min": 4,
      "max": 40,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "max_width",
      "label": "Content width",
      "default": "wide",
      "options": [
        {
          "label": "Narrow",
          "value": "narrow"
        },
        {
          "label": "Medium",
          "value": "medium"
        },
        {
          "label": "Wide",
          "value": "wide"
        },
        {
          "label": "Full",
          "value": "full"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_style",
      "label": "Style"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "white"
    },
    {
      "type": "header",
      "id": "hdr_spacing",
      "label": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "default": 96,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "default": 96,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        {
          "type": "select",
          "id": "style",
          "label": "Tile",
          "default": "surface",
          "options": [
            {
              "label": "Soft",
              "value": "surface"
            },
            {
              "label": "Accent colour",
              "value": "accent"
            },
            {
              "label": "Inverted",
              "value": "inverse"
            },
            {
              "label": "Photograph",
              "value": "photo"
            }
          ]
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photograph",
          "default": "",
          "info": "Fills the tile; the words sit on it."
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Photograph description",
          "default": "",
          "info": "Read aloud to people who cannot see it."
        },
        {
          "type": "text",
          "id": "kicker",
          "label": "Small label",
          "default": ""
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "A short title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": ""
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "Link wording",
          "default": ""
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "default": ""
        },
        {
          "type": "select",
          "id": "width",
          "label": "Tile width",
          "default": "1",
          "options": [
            {
              "label": "1 column",
              "value": "1"
            },
            {
              "label": "2 columns",
              "value": "2"
            },
            {
              "label": "3 columns",
              "value": "3"
            },
            {
              "label": "Full width",
              "value": "4"
            }
          ]
        },
        {
          "type": "select",
          "id": "height",
          "label": "Tile height",
          "default": "1",
          "options": [
            {
              "label": "1 row",
              "value": "1"
            },
            {
              "label": "2 rows",
              "value": "2"
            },
            {
              "label": "3 rows",
              "value": "3"
            }
          ]
        }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "Bento Grid",
      "blocks": [
        {
          "id": "t1",
          "type": "tile",
          "settings": {
            "style": "photo",
            "width": "2",
            "height": "2",
            "title": "Your headline benefit",
            "text": "Put the picture that sells it best here."
          }
        },
        {
          "id": "t2",
          "type": "tile",
          "settings": {
            "style": "accent",
            "width": "2",
            "height": "1",
            "kicker": "Why it matters",
            "title": "A sharp, specific promise"
          }
        },
        {
          "id": "t3",
          "type": "tile",
          "settings": {
            "width": "1",
            "height": "1",
            "title": "A detail",
            "text": "One line about it."
          }
        },
        {
          "id": "t4",
          "type": "tile",
          "settings": {
            "style": "inverse",
            "width": "1",
            "height": "1",
            "title": "Another detail",
            "text": "One line about it."
          }
        },
        {
          "id": "t5",
          "type": "tile",
          "settings": {
            "width": "2",
            "height": "1",
            "title": "Something people ask about",
            "text": "Answer it in a sentence.",
            "link_text": "Read more",
            "link": "/about"
          }
        },
        {
          "id": "t6",
          "type": "tile",
          "settings": {
            "style": "photo",
            "width": "2",
            "height": "1",
            "title": "A second picture"
          }
        }
      ]
    }
  ]
}
</schema>
