            "url": "/sale"
          }
        },
        {
          "id": "col-2",
          "type": "footer_column",
          "settings": {
            "heading": "Company"
          }
        },
        {
          "id": "fl-4",
          "type": "footer_link",
          "settings": {
            "label": "About",
            "url": "/about"
          }
        },
        {
          "id": "fl-5",
          "type": "footer_link",
          "settings": {
            "label": "Blog",
            "url": "/blog"
          }
        },
        {
          "id": "fl-6",
          "type": "footer_link",
          "settings": {
            "label": "Contact",
            "url": "/contact"
          }
        },
        {
          "id": "col-3",
          "type": "footer_column",
          "settings": {
            "heading": "Support"
          }
        },
        {
          "id": "fl-7",
          "type": "footer_link",
          "settings": {
            "label": "FAQ",
            "url": "/faq"
          }
        },
        {
          "id": "fl-8",
          "type": "footer_link",
          "settings": {
            "label": "Shipping",
            "url": "/shipping"
          }
        },
        {
          "id": "fl-9",
          "type": "footer_link",
