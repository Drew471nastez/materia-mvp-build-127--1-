{# ===========================================================================
   Reviews marquee (Storelib Reviews)

   Short reviews drifting across the page in a loop: the list drawn twice,
   the second copy hidden from screen readers, moved by CSS alone. It stops
   under the pointer when asked, and stands still as a row that scrolls
   for a visitor who asks for less motion. From `reviews` through
   review_scope and review_list (lib/reviews/widgets.ts).
   =========================================================================== #}
<template>
{% if reviews.enabled %}
{% for sc in reviews | review_scope: settings.scope %}
{% if sc.items.size > 0 or page.in_editor %}
<div class="rw rw--{{ settings.show_on }} rw--{{ settings.star_style }}">
<section class="s mq" data-scheme="{{ settings.color_scheme }}" style="--s-bg: {{ settings.background | default: scheme.bg }}; --s-text: {{ settings.text_color | default: scheme.text }}; --s-heading: {{ settings.text_color | default: scheme.heading }}; --s-para: {{ settings.text_color | default: scheme.paragraph }}; --s-border: {{ settings.border_color | default: scheme.border }}; --s-accent: {{ scheme.accent }}; --s-btn: {{ scheme.primary_btn_bg }}; --s-btn-text: {{ scheme.primary_btn_text }}; --s-btn-hover: {{ scheme.primary_btn_hover_bg }}; --s-btn-hover-text: {{ scheme.primary_btn_hover_text }}; --s-pt: {{ settings.padding_top }}px; --s-pb: {{ settings.padding_bottom }}px; --rv-star: {{ settings.star_color | default: reviews.star_color }}; --rv-size: {{ settings.star_size }}px; --rw-scale: {{ settings.text_scale }}; --rw-hscale: {{ settings.heading_scale }}; --rw-card: {{ settings.card_background | default: 'transparent' }}; --rw-bw: {{ settings.border_width }}px; --rw-radius: {{ settings.radius }}px; --rw-gap: {{ settings.gap }}px; --mq-time: {{ settings.speed }}s; --mq-w: {{ settings.card_width }}px;">
  <div class="s__in s__in--{{ settings.max_width }}">
    {% if settings.heading or settings.subheading %}<div class="rw__head rw__head--{{ settings.align }}">{% if settings.heading %}<h2 class="s__h">{{ settings.heading }}</h2>{% endif %}{% if settings.subheading %}<p class="rw__sub">{{ settings.subheading }}</p>{% endif %}</div>{% endif %}
    {% if page.in_editor and reviews.sample %}<p class="rv__sample">Sample reviews. Your real reviews show here once you have some.</p>{% endif %}
  </div>
  <div class="mq__row mq__row--{{ settings.direction }}{% if settings.pause %} mq__row--pause{% endif %}">
    <div class="mq__track"><div class="mq__set" role="list">{% for r in sc.items | review_list: settings.sort, settings.min_rating limit: settings.count %}<article class="mq__card" data-review-id="{{ r.id }}"><span class="rv-stars" style="--rv: {{ r.rating | times: 20 }}%;" role="img" aria-label="{{ r.rating }} {{ words.out_of_five_stars }}"></span><p class="mq__body">{{ r.body }}</p><p class="mq__by"><span class="mq__name">{{ r.author }}</span>{% if settings.show_verified and reviews.show_verified and r.verified %}<span class="mq__ver">{{ words.verified_buyer }}</span>{% endif %}{% if settings.show_product and r.product_title %}<span class="mq__prod">{{ r.product_title }}</span>{% endif %}</p></article>{% endfor %}</div><div class="mq__set" aria-hidden="true">{% for r in sc.items | review_list: settings.sort, settings.min_rating limit: settings.count %}<article class="mq__card" data-review-id="{{ r.id }}"><span class="rv-stars" style="--rv: {{ r.rating | times: 20 }}%;" role="img" aria-label="{{ r.rating }} {{ words.out_of_five_stars }}"></span><p class="mq__body">{{ r.body }}</p><p class="mq__by"><span class="mq__name">{{ r.author }}</span>{% if settings.show_verified and reviews.show_verified and r.verified %}<span class="mq__ver">{{ words.verified_buyer }}</span>{% endif %}{% if settings.show_product and r.product_title %}<span class="mq__prod">{{ r.product_title }}</span>{% endif %}</p></article>{% endfor %}</div></div>
  </div>
  <div class="mq__end"></div>
</section>
{% if page.in_editor %}<p class="rw__off rw__off--desktop">Shown on computers only. Switch the preview to a computer to see it.</p><p class="rw__off rw__off--mobile">Shown on phones only. Switch the preview to a phone to see it.</p>{% endif %}
</div>
{% endif %}
{% endfor %}
{% endif %}
</template>

<style scoped>
.rw { container-type: inline-size; }
@container (max-width: 749px) { .rw--desktop > .s { display: none; } }
@container (min-width: 750px) { .rw--mobile > .s { display: none; } }
.rw__off { display: none; margin: 0; padding: 14px 16px; border: 1px dashed currentColor; opacity: 0.55; font-size: 13px; line-height: 1.4; text-align: center; }
@container (max-width: 749px) { .rw--desktop > .rw__off--desktop { display: block; } }
@container (min-width: 750px) { .rw--mobile > .rw__off--mobile { display: block; } }
.s { container-type: inline-size; background: var(--s-bg); color: var(--s-text); font-size: calc(15px * var(--rw-scale, 100) / 100); }
.s__in { margin: 0 auto; padding: calc(var(--s-pt) * var(--theme-spacing-scale, 1)) var(--theme-padding-x, 24px) calc(var(--s-pb) * var(--theme-spacing-scale, 1)); }
.s__in--narrow { max-width: 720px; }
.s__in--medium { max-width: 960px; }
.s__in--wide { max-width: var(--theme-page-width, 1280px); }
.s__in--full { max-width: none; }
.s__h {
  margin: 0;
  font-size: calc(var(--section-heading-size, 32px) * var(--rw-hscale, 100) / 100);
  line-height: var(--section-heading-line-height, 1.15);
  font-weight: var(--section-heading-weight, 700);
  color: var(--s-heading);
  letter-spacing: var(--section-heading-tracking, -0.01em);
  text-transform: var(--section-heading-transform, none);
  font-family: var(--section-heading-font, var(--theme-font-heading, {{ theme.typography.heading }}), ui-sans-serif, system-ui, sans-serif);
}
.rw__head { margin-bottom: 28px; }
.rw__head--center { text-align: center; }
.rw__sub { margin: 10px 0 0; font-size: calc(var(--section-text-size, 17px) * var(--rw-scale, 100) / 100); line-height: 1.6; color: var(--s-para); max-width: 44rem; }
.rw__head--center .rw__sub { margin-left: auto; margin-right: auto; }
.rv__sample { margin: -12px 0 20px; font-size: 13px; color: var(--s-para); opacity: 0.7; }
.rv-stars { --rv-g: "\2605\2605\2605\2605\2605"; position: relative; display: inline-block; flex: none; font-size: var(--rv-size, 16px); line-height: 1; letter-spacing: 0.12em; white-space: nowrap; color: color-mix(in srgb, var(--s-para) 22%, transparent); }
.rv-stars::before { content: var(--rv-g); }
.rv-stars::after { content: var(--rv-g); position: absolute; inset: 0 auto 0 0; width: var(--rv, 0%); overflow: hidden; white-space: nowrap; color: var(--rv-star, var(--s-accent)); }
.rw--outline .rv-stars { color: transparent; -webkit-text-stroke: 1px var(--rv-star, var(--s-accent)); }
.rw--outline .rv-stars::after { -webkit-text-stroke: 0; }
.rw--heart .rv-stars { --rv-g: "\2665\2665\2665\2665\2665"; }
.mq .s__in { padding-bottom: 0; }
.mq__end { height: calc(var(--s-pb) * var(--theme-spacing-scale, 1)); }
.mq__row { overflow: hidden; padding: 4px 0; -webkit-mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent); mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent); }
.mq__track { display: flex; width: max-content; animation: mq-move var(--mq-time, 40s) linear infinite; }
.mq__row--right .mq__track { animation-direction: reverse; }
.mq__row--pause:hover .mq__track, .mq__row--pause:focus-within .mq__track { animation-play-state: paused; }
.mq__set { display: flex; gap: var(--rw-gap); padding-right: var(--rw-gap); }
.mq__card { width: var(--mq-w, 300px); flex: none; box-sizing: border-box; display: flex; flex-direction: column; gap: 10px; padding: 18px; background: var(--rw-card); border: var(--rw-bw) solid var(--s-border); border-radius: var(--rw-radius); }
.mq__body { margin: 0; line-height: 1.55; color: var(--s-heading); overflow-wrap: anywhere; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
.mq__by { display: flex; flex-wrap: wrap; gap: 4px 8px; margin: auto 0 0; font-size: 0.85em; color: var(--s-para); }
.mq__name { font-weight: 600; color: var(--s-heading); }
.mq__ver::before { content: "\2713  "; font-weight: 700; color: var(--s-heading); }
@keyframes mq-move { from { transform: translateX(0); } to { transform: translateX(-50%); } }
@media (prefers-reduced-motion: reduce) {
  .mq__row { overflow-x: auto; -webkit-mask-image: none; mask-image: none; }
  .mq__track { animation: none; }
  .mq__set[aria-hidden="true"] { display: none; }
}
</style>

<schema>
{
  "schema_version": 1,
  "type": "reviews_marquee",
  "name": "Reviews marquee",
  "category": "reviews",
  "description": "Storelib Reviews: short reviews drifting across the page.",
  "version": "1.0.0",
  "icon": "star",
  "settings": [
    {
      "type": "header",
      "id": "hdr_content",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by buyers"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Supporting line",
      "default": ""
    },
    {
      "type": "radio",
      "id": "align",
      "label": "Heading sits",
      "default": "left",
      "options": [
        {
          "label": "Left",
          "value": "left"
        },
        {
          "label": "Centre",
          "value": "center"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_reviews",
      "label": "Reviews"
    },
    {
      "type": "select",
      "id": "scope",
      "label": "Whose reviews",
      "default": "all",
      "options": [
        {
          "label": "This page: the product's on a product page",
          "value": "here"
        },
        {
          "label": "The whole shop",
          "value": "all"
        }
      ]
    },
    {
      "type": "select",
      "id": "sort",
      "label": "Order",
      "default": "highest",
      "options": [
        {
          "label": "Featured first",
          "value": "featured"
        },
        {
          "label": "Newest",
          "value": "newest"
        },
        {
          "label": "Highest rated",
          "value": "highest"
        },
        {
          "label": "Lowest rated",
          "value": "lowest"
        },
        {
          "label": "With photos first",
          "value": "photos"
        }
      ]
    },
    {
      "type": "range",
      "id": "min_rating",
      "label": "Lowest rating shown",
      "default": 4,
      "min": 1,
      "max": 5,
      "step": 1
    },
    {
      "type": "range",
      "id": "count",
      "label": "How many",
      "default": 10,
      "min": 1,
      "max": 24,
      "step": 1
    },
    {
      "type": "header",
      "id": "hdr_shown",
      "label": "Shown on each review"
    },
    {
      "type": "toggle",
      "id": "show_verified",
      "label": "Verified buyer",
      "default": false
    },
    {
      "type": "toggle",
      "id": "show_product",
      "label": "Product",
      "default": false
    },
    {
      "type": "header",
      "id": "hdr_motion",
      "label": "Motion"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Time for one loop",
      "default": 50,
      "min": 15,
      "max": 120,
      "step": 5,
      "unit": "s"
    },
    {
      "type": "radio",
      "id": "direction",
      "label": "Moves",
      "default": "left",
      "options": [
        {
          "label": "Left",
          "value": "left"
        },
        {
          "label": "Right",
          "value": "right"
        }
      ]
    },
    {
      "type": "toggle",
      "id": "pause",
      "label": "Stop while the pointer is on it",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_layout",
      "label": "Layout"
    },
    {
      "type": "range",
      "id": "card_width",
      "label": "Card width",
      "default": 300,
      "min": 200,
      "max": 440,
      "step": 10,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Space between",
      "default": 16,
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "max_width",
      "label": "Content width",
      "default": "wide",
      "options": [
        {
          "label": "Narrow",
          "value": "narrow"
        },
        {
          "label": "Medium",
          "value": "medium"
        },
        {
          "label": "Wide",
          "value": "wide"
        },
        {
          "label": "Full",
          "value": "full"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_style",
      "label": "Style"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "white"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "",
      "info": "Empty uses the colour scheme."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "",
      "info": "Empty uses the colour scheme."
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": ""
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "",
      "info": "Empty uses the colour scheme."
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "default": 1,
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Corner radius",
      "default": 12,
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "star_style",
      "label": "Stars",
      "default": "solid",
      "options": [
        {
          "label": "Solid",
          "value": "solid"
        },
        {
          "label": "Outline",
          "value": "outline"
        },
        {
          "label": "Hearts",
          "value": "heart"
        }
      ]
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star colour",
      "default": "",
      "info": "Empty uses the colour set in Storelib Reviews."
    },
    {
      "type": "range",
      "id": "star_size",
      "label": "Star size",
      "default": 14,
      "min": 10,
      "max": 40,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "id": "hdr_type",
      "label": "Typography"
    },
    {
      "type": "range",
      "id": "text_scale",
      "label": "Text size",
      "default": 100,
      "min": 80,
      "max": 140,
      "step": 5,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "heading_scale",
      "label": "Heading size",
      "default": 100,
      "min": 60,
      "max": 160,
      "step": 5,
      "unit": "%"
    },
    {
      "type": "header",
      "id": "hdr_visibility",
      "label": "Visibility"
    },
    {
      "type": "select",
      "id": "show_on",
      "label": "Show on",
      "default": "all",
      "options": [
        {
          "label": "Phones and computers",
          "value": "all"
        },
        {
          "label": "Computers only",
          "value": "desktop"
        },
        {
          "label": "Phones only",
          "value": "mobile"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_spacing",
      "label": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "default": 56,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "default": 56,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Reviews marquee",
      "settings": {}
    }
  ]
}
</schema>
