{
  "type": "contact_form",
  "name": "Contact Form",
  "description": "Customizable contact form with optional split layout and configurable fields.",
  "icon": "mail",
  "category": "niche",
  "fields": [
    {
      "id": "hdr_content",
      "label": "Form Settings",
      "type": "header"
    },
    {
      "id": "heading",
      "label": "Heading",
      "type": "text",
      "default": "Get in Touch",
      "placeholder": "Section heading"
    },
    {
      "id": "subheading",
      "label": "Subheading",
      "type": "text",
      "default": "We'd love to hear from you. Fill out the form and we'll respond within 24 hours.",
      "placeholder": "Section subheading"
    },
    {
      "id": "submit_button_text",
      "label": "Submit Button Text",
      "type": "text",
      "default": "Send Message",
      "placeholder": "e.g. Send Message"
    },
    {
      "id": "success_message",
      "label": "Success Message",
      "type": "text",
      "default": "Thanks! Your message has been sent. We'll be in touch soon.",
      "placeholder": "Message shown after successful submission"
    },
    {
      "id": "error_message",
      "label": "Error Message",
      "type": "text",
      "default": "Something went wrong. Please try again or email us directly.",
      "placeholder": "Message shown on error"
    },
    {
      "id": "show_name",
      "label": "Show Name Field",
      "type": "toggle",
      "default": true
    },
    {
      "id": "show_company",
      "label": "Show Company Field",
      "type": "toggle",
      "default": false
    },
    {
      "id": "show_phone",
      "label": "Show Phone Field",
      "type": "toggle",
      "default": false
    },
    {
      "id": "show_subject",
      "label": "Show Subject Field",
      "type": "toggle",
      "default": true
    },
    {
      "id": "show_message",
      "label": "Show Message Field",
      "type": "toggle",
      "default": true
    },
    {
      "id": "recipient_email",
      "label": "Recipient Email",
      "type": "text",
      "default": "",
      "placeholder": "hello@yoursite.com"
    },
    {
      "id": "subject_prefix",
      "label": "Subject Prefix",
      "type": "text",
      "default": "[Contact Form]",
      "placeholder": "e.g. [Contact Form]"
    },
    {
      "id": "hdr_style",
      "label": "Style",
      "type": "header"
    },
    {
      "id": "layout",
      "label": "Layout",
      "type": "radio",
      "default": "centered",
      "options": [
        {
          "label": "Centered",
          "value": "centered"
        },
        {
          "label": "Split (form + image)",
          "value": "split"
        }
      ]
    },
    {
      "id": "split_image",
      "label": "Split Layout Image",
      "type": "image",
      "default": ""
    },
    {
      "id": "bg_color",
      "label": "Background Color",
      "type": "color",
      "default": "#ffffff"
    },
    {
      "id": "text_color",
      "label": "Text Color",
      "type": "color",
      "default": "#111111"
    },
    {
      "id": "input_bg_color",
      "label": "Input Background Color",
      "type": "color",
      "default": "#f9f9f9"
    },
    {
      "id": "input_border_color",
      "label": "Input Border Color",
      "type": "color",
      "default": "#d0d0d0"
    },
    {
      "id": "button_color",
      "label": "Button Color",
      "type": "color",
      "default": "#111111"
    },
    {
      "id": "button_text_color",
      "label": "Button Text Color",
      "type": "color",
      "default": "#ffffff"
    },
    {
      "id": "hdr_padding",
      "label": "Padding",
      "type": "header"
    },
    {
      "id": "padding_top",
      "label": "Padding Top",
      "type": "range",
      "default": 80,
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px"
    },
    {
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "type": "range",
      "default": 80,
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Contact Form",
      "settings": {
        "heading": "Get in Touch",
        "subheading": "We'd love to hear from you. Fill out the form and we'll respond within 24 hours.",
        "submit_button_text": "Send Message",
        "success_message": "Thanks! Your message has been sent. We'll be in touch soon.",
        "error_message": "Something went wrong. Please try again or email us directly.",
        "show_name": true,
        "show_company": false,
        "show_phone": false,
        "show_subject": true,
        "show_message": true,
        "subject_prefix": "[Contact Form]",
        "layout": "centered",
        "bg_color": "#ffffff",
        "text_color": "#111111",
        "input_bg_color": "#f9f9f9",
        "input_border_color": "#d0d0d0",
        "button_color": "#111111",
        "button_text_color": "#ffffff",
        "padding_top": 80,
        "padding_bottom": 80
      }
    }
  ]
}
