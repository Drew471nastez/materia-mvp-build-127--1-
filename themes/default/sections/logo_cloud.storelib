          }
        },
        {
          "id": "g5",
          "type": "logo",
          "settings": {
            "name": "Partner 5"
          }
        }
      ]
    },
    {
      "name": "Logo Cloud, row",
      "settings": {
        "layout": "row",
        "heading": "",
        "eyebrow": "As featured in",
        "padding_top": 56,
        "padding_bottom": 56
      },
      "blocks": [
        {
          "id": "r1",
          "type": "logo",
          "settings": {
            "name": "Publication 1"
          }
        },
        {
          "id": "r2",
