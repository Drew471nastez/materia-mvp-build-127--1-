{# ===========================================================================
   Marquee: a running line of words or logos that gives a page pace. The
   list is drawn four times on one track that moves by half its width, so it
   loops without a seam however few items there are; only the first copy is
   read aloud. Stopped on hover when asked, and for anyone who asked their
   system for less motion, when it becomes a still, wrapped line.
   =========================================================================== #}
<template>
<section class="s mq mq--{{ settings.size }}{% if settings.borders %} mq--lines{% endif %}{% if settings.pause_on_hover %} mq--pause{% endif %}" data-scheme="{{ settings.color_scheme }}" style="--s-bg: {{ scheme.bg }}; --s-text: {{ scheme.text }}; --s-heading: {{ scheme.heading }}; --s-para: {{ scheme.paragraph }}; --s-border: {{ scheme.border }}; --s-accent: {{ scheme.accent }}; --s-btn: {{ scheme.primary_btn_bg }}; --s-btn-text: {{ scheme.primary_btn_text }}; --s-btn2: {{ scheme.secondary_btn_bg }}; --s-btn2-text: {{ scheme.secondary_btn_text }}; --s-btn2-border: {{ scheme.secondary_btn_border }}; --s-btn-hover: {{ scheme.primary_btn_hover_bg }}; --s-btn-hover-text: {{ scheme.primary_btn_hover_text }}; --s-btn2-hover: {{ scheme.secondary_btn_hover_bg }}; --s-btn2-hover-text: {{ scheme.secondary_btn_hover_text }}; --s-radius: {{ theme.radius.medium }}px; --s-pt: {{ settings.padding_top }}px; --s-pb: {{ settings.padding_bottom }}px; --mq-dur: {{ settings.speed }}s; --mq-gap: {{ settings.gap }}px;">
  <div class="mq__in">
    {% if settings.heading %}<h2 class="mq__label">{{ settings.heading }}</h2>{% endif %}
    {% if blocks.size == 0 %}
      {% if page.in_editor %}<p class="mq__empty">Add words or logos in the sidebar</p>{% endif %}
    {% else %}
      <div class="mq__view">
        <div class="mq__track mq__track--{{ settings.direction }}">
          <ul class="mq__list" role="list">{% for block in blocks %}<li class="mq__item" data-block-id="{{ block.id }}">{% if block.type == 'logo' %}{% if block.settings.image %}<img class="mq__logo" src="{{ block.settings.image | asset }}" alt="{{ block.settings.name }}" loading="lazy" decoding="async">{% else %}<span class="mq__word">{{ block.settings.name }}</span>{% endif %}{% else %}{% if block.settings.link %}<a class="mq__word" href="{{ block.settings.link | url }}">{{ block.settings.text }}</a>{% else %}<span class="mq__word">{{ block.settings.text }}</span>{% endif %}{% endif %}</li>{% if settings.separator != 'none' %}<li class="mq__sep" aria-hidden="true">{% if settings.separator == 'dot' %}●{% elsif settings.separator == 'star' %}✦{% elsif settings.separator == 'slash' %}/{% else %}—{% endif %}</li>{% endif %}{% endfor %}{% for block in blocks %}<li class="mq__item mq__dup" aria-hidden="true" data-block-id="{{ block.id }}">{% if block.type == 'logo' %}{% if block.settings.image %}<img class="mq__logo" src="{{ block.settings.image | asset }}" alt="" loading="lazy" decoding="async">{% else %}<span class="mq__word">{{ block.settings.name }}</span>{% endif %}{% else %}{% if block.settings.link %}<a class="mq__word" href="{{ block.settings.link | url }}" tabindex="-1">{{ block.settings.text }}</a>{% else %}<span class="mq__word">{{ block.settings.text }}</span>{% endif %}{% endif %}</li>{% if settings.separator != 'none' %}<li class="mq__sep mq__dup" aria-hidden="true">{% if settings.separator == 'dot' %}●{% elsif settings.separator == 'star' %}✦{% elsif settings.separator == 'slash' %}/{% else %}—{% endif %}</li>{% endif %}{% endfor %}</ul>
          <ul class="mq__list mq__copy" aria-hidden="true">{% for block in blocks %}<li class="mq__item" data-block-id="{{ block.id }}">{% if block.type == 'logo' %}{% if block.settings.image %}<img class="mq__logo" src="{{ block.settings.image | asset }}" alt="" loading="lazy" decoding="async">{% else %}<span class="mq__word">{{ block.settings.name }}</span>{% endif %}{% else %}{% if block.settings.link %}<a class="mq__word" href="{{ block.settings.link | url }}" tabindex="-1">{{ block.settings.text }}</a>{% else %}<span class="mq__word">{{ block.settings.text }}</span>{% endif %}{% endif %}</li>{% if settings.separator != 'none' %}<li class="mq__sep" aria-hidden="true">{% if settings.separator == 'dot' %}●{% elsif settings.separator == 'star' %}✦{% elsif settings.separator == 'slash' %}/{% else %}—{% endif %}</li>{% endif %}{% endfor %}{% for block in blocks %}<li class="mq__item" data-block-id="{{ block.id }}">{% if block.type == 'logo' %}{% if block.settings.image %}<img class="mq__logo" src="{{ block.settings.image | asset }}" alt="" loading="lazy" decoding="async">{% else %}<span class="mq__word">{{ block.settings.name }}</span>{% endif %}{% else %}{% if block.settings.link %}<a class="mq__word" href="{{ block.settings.link | url }}" tabindex="-1">{{ block.settings.text }}</a>{% else %}<span class="mq__word">{{ block.settings.text }}</span>{% endif %}{% endif %}</li>{% if settings.separator != 'none' %}<li class="mq__sep" aria-hidden="true">{% if settings.separator == 'dot' %}●{% elsif settings.separator == 'star' %}✦{% elsif settings.separator == 'slash' %}/{% else %}—{% endif %}</li>{% endif %}{% endfor %}</ul>
        </div>
      </div>
    {% endif %}
  </div>
</section>
</template>

<style scoped>
.s { container-type: inline-size; background: var(--s-bg); color: var(--s-text); }
.s__in {
  margin: 0 auto;
  padding: calc(var(--s-pt) * var(--theme-spacing-scale, 1)) var(--theme-padding-x, 24px) calc(var(--s-pb) * var(--theme-spacing-scale, 1));
}
.s__in--narrow { max-width: 720px; }
.s__in--medium { max-width: 960px; }
.s__in--wide { max-width: var(--theme-page-width, 1280px); }
.s__in--full { max-width: none; }
.s__eyebrow { margin: 0 0 14px; font-family: var(--sl-caption-font); font-size: var(--sl-caption-size, 12px); font-weight: var(--sl-caption-weight, 600); letter-spacing: var(--sl-caption-tracking, 0.14em); text-transform: var(--sl-caption-transform, uppercase); color: var(--s-accent); }
.s__h {
  margin: 0;
  font-size: var(--section-heading-size, 32px);
  line-height: var(--section-heading-line-height, 1.15);
  font-weight: var(--section-heading-weight, 700);
  color: var(--s-heading);
  letter-spacing: var(--section-heading-tracking, -0.01em);
  text-transform: var(--section-heading-transform, none);
  font-family: var(--section-heading-font, var(--theme-font-heading, {{ theme.typography.heading }}), ui-sans-serif, system-ui, sans-serif);
  text-wrap: balance;
}
.s__sub { margin: 16px 0 0; max-width: 38rem; font-size: var(--section-text-size, 17px); line-height: var(--section-text-line-height, 1.6); color: var(--s-para); text-wrap: pretty; }
.s__head { max-width: 46rem; }
.s__head--center { margin-inline: auto; text-align: center; }
.s__head--center .s__sub { margin-inline: auto; }
.s__btns { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
.s__head--center .s__btns { justify-content: center; }
.s__btn {
  display: inline-flex; align-items: center; justify-content: center; min-height: 44px;
  padding: var(--sl-button-padding, 13px 24px); font-size: var(--sl-button-size, 15px); line-height: var(--sl-button-line-height); font-weight: var(--theme-button-weight, 600); text-decoration: none;
  border-radius: var(--s-radius); border: 1px solid transparent; transition: background-color 180ms ease, color 180ms ease, border-color 180ms ease, transform 180ms ease;
}
.s__btn--primary:hover { background: var(--s-btn-hover); color: var(--s-btn-hover-text); border-color: var(--s-btn-hover); }
.s__btn--secondary:hover { background: var(--s-btn2-hover); color: var(--s-btn2-hover-text); }
.s__btn--primary { background: var(--s-btn); color: var(--s-btn-text); border-color: var(--s-btn); }
.s__btn--secondary { background: var(--s-btn2); color: var(--s-btn2-text); border-color: var(--s-btn2-border); }
.s__btn:focus-visible, .s a:focus-visible { outline: 2px solid var(--s-accent); outline-offset: 3px; }
.s__note { margin: 18px 0 0; font-size: 13px; color: var(--s-para); }
.ph { display: grid !important; place-content: center; justify-items: center; gap: 8px; width: 100%; height: 100%; min-height: 160px; box-sizing: border-box; border: 1px dashed var(--s-border); background: color-mix(in srgb, var(--s-text) 5%, transparent); color: var(--s-para); font-size: 13px; text-align: center; padding: 16px; }
@media (prefers-reduced-motion: reduce) { .s__btn { transition: none; } }
.ph svg { width: 28px; height: 28px; fill: none; stroke: currentColor; stroke-width: 1.5; }

.mq__in { padding: calc(var(--s-pt) * var(--theme-spacing-scale, 1)) 0 calc(var(--s-pb) * var(--theme-spacing-scale, 1)); }
.mq--lines .mq__in { border-block: 1px solid var(--s-border); }
.mq__label { margin: 0 auto 20px; padding: 0 var(--theme-padding-x, 24px); max-width: var(--theme-page-width, 1280px); font-size: var(--sl-caption-size, 12px); font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--s-para); font-family: inherit; }
.mq__empty { margin: 0 var(--theme-padding-x, 24px); padding: 20px; border: 1px dashed var(--s-border); text-align: center; font-size: 13px; color: var(--s-para); }
.mq__view { overflow: hidden; mask-image: linear-gradient(to right, transparent, black 6%, black 94%, transparent); }
.mq__track { display: flex; width: max-content; animation: mq-left var(--mq-dur, 30s) linear infinite; }
.mq__track--right { animation-name: mq-right; }
.mq--pause .mq__view:hover .mq__track, .mq--pause .mq__view:focus-within .mq__track { animation-play-state: paused; }
.mq__list { display: flex; align-items: center; gap: var(--mq-gap, 48px); margin: 0; padding: 0 calc(var(--mq-gap, 48px) / 2); list-style: none; flex: none; }
.mq__item, .mq__sep { flex: none; white-space: nowrap; }
.mq__word { color: var(--s-heading); text-decoration: none; font-family: var(--type-h1-font, var(--theme-font-heading)), ui-sans-serif, system-ui, sans-serif; font-weight: var(--type-h2-weight, 600); letter-spacing: var(--type-h2-tracking, -0.01em); text-transform: var(--type-h2-transform, none); line-height: 1.1; }
a.mq__word:hover { color: var(--s-accent); }
.mq__sep { color: var(--s-accent); line-height: 1; }
.mq__logo { display: block; width: auto; object-fit: contain; }
.mq--small .mq__word { font-size: 20px; } .mq--small .mq__sep { font-size: 10px; } .mq--small .mq__logo { height: 28px; }
.mq--medium .mq__word { font-size: clamp(28px, 4cqi, 44px); } .mq--medium .mq__sep { font-size: 14px; } .mq--medium .mq__logo { height: 40px; }
.mq--large .mq__word { font-size: clamp(40px, 7cqi, 88px); } .mq--large .mq__sep { font-size: 20px; } .mq--large .mq__logo { height: 56px; }
.mq--display .mq__word { font-size: clamp(56px, 11cqi, 168px); } .mq--display .mq__sep { font-size: 28px; } .mq--display .mq__logo { height: 80px; }
@keyframes mq-left { from { transform: translateX(0); } to { transform: translateX(-50%); } }
@keyframes mq-right { from { transform: translateX(-50%); } to { transform: translateX(0); } }
@media (prefers-reduced-motion: reduce) {
  .mq__track { animation: none; width: auto; padding: 0 var(--theme-padding-x, 24px); }
  .mq__view { mask-image: none; }
  .mq__copy, .mq__dup { display: none; }
  .mq__list { flex-wrap: wrap; justify-content: center; row-gap: 12px; }
}
</style>

<schema>
{
  "schema_version": 1,
  "type": "marquee",
  "name": "Marquee",
  "category": "content",
  "description": "A running line of words or logos across the page: dates, places, promises or press.",
  "icon": "move-horizontal",
  "settings": [
    {
      "type": "header",
      "id": "hdr_content",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Small label above",
      "default": "",
      "info": "Optional, read before the line: As seen in, Coming to."
    },
    {
      "type": "header",
      "id": "hdr_motion",
      "label": "Motion"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Time for one loop",
      "default": 32,
      "min": 8,
      "max": 90,
      "step": 2,
      "unit": "s",
      "info": "Longer is slower."
    },
    {
      "type": "radio",
      "id": "direction",
      "label": "Direction",
      "default": "left",
      "options": [
        {
          "label": "To the left",
          "value": "left"
        },
        {
          "label": "To the right",
          "value": "right"
        }
      ]
    },
    {
      "type": "toggle",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_look",
      "label": "Look"
    },
    {
      "type": "select",
      "id": "size",
      "label": "Size",
      "default": "large",
      "options": [
        {
          "label": "Small",
          "value": "small"
        },
        {
          "label": "Medium",
          "value": "medium"
        },
        {
          "label": "Large",
          "value": "large"
        },
        {
          "label": "Display",
          "value": "display"
        }
      ]
    },
    {
      "type": "select",
      "id": "separator",
      "label": "Between items",
      "default": "star",
      "options": [
        {
          "label": "Nothing",
          "value": "none"
        },
        {
          "label": "Star",
          "value": "star"
        },
        {
          "label": "Dot",
          "value": "dot"
        },
        {
          "label": "Slash",
          "value": "slash"
        },
        {
          "label": "Dash",
          "value": "dash"
        }
      ]
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Space between",
      "default": 40,
      "min": 16,
      "max": 120,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "toggle",
      "id": "borders",
      "label": "Lines above and below",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_style",
      "label": "Style"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "white"
    },
    {
      "type": "header",
      "id": "hdr_spacing",
      "label": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "default": 28,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "default": 28,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Words",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Words",
          "default": "Your line here"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "default": ""
        }
      ]
    },
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo",
          "default": ""
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Brand name",
          "info": "Shown when there is no logo, and read aloud."
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Marquee",
      "blocks": [
        {
          "id": "m1",
          "type": "item",
          "settings": {
            "text": "Made in small batches"
          }
        },
        {
          "id": "m2",
          "type": "item",
          "settings": {
            "text": "Free returns"
          }
        },
        {
          "id": "m3",
          "type": "item",
          "settings": {
            "text": "Shipped this week"
          }
        },
        {
          "id": "m4",
          "type": "item",
          "settings": {
            "text": "Designed to last"
          }
        }
      ]
    },
    {
      "name": "Marquee, logos",
      "settings": {
        "size": "small",
        "separator": "none",
        "gap": 72,
        "heading": "As seen in",
        "borders": false
      },
      "blocks": [
        {
          "id": "l1",
          "type": "logo",
          "settings": {
            "name": "Publication one"
          }
        },
        {
          "id": "l2",
          "type": "logo",
          "settings": {
            "name": "Publication two"
          }
        },
        {
          "id": "l3",
          "type": "logo",
          "settings": {
            "name": "Publication three"
          }
        },
        {
          "id": "l4",
          "type": "logo",
          "settings": {
            "name": "Publication four"
          }
        }
      ]
    },
    {
      "name": "Marquee, display",
      "settings": {
        "size": "display",
        "separator": "dot",
        "speed": 46,
        "color_scheme": "dark",
        "borders": false,
        "padding_top": 40,
        "padding_bottom": 40
      },
      "blocks": [
        {
          "id": "d1",
          "type": "item",
          "settings": {
            "text": "Your big statement"
          }
        },
        {
          "id": "d2",
          "type": "item",
          "settings": {
            "text": "Said twice"
          }
        }
      ]
    }
  ]
}
</schema>
