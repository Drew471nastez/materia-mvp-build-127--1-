{# ===========================================================================
   Comparison table: plans or products side by side, one column block per
   plan and one row block per feature, its values typed in a line
   separated by commas (yes and no draw a tick and a dash). Reads the same
   settings and blocks the earlier comparison table saved, so a page built
   with that one keeps its content. On a phone the table scrolls sideways
   with the feature names held at the left.
   =========================================================================== #}
<template>
<section class="s ct ct--hl{{ settings.highlight_column }}{% if settings.sticky_header %} ct--sticky{% endif %}" data-scheme="{{ settings.color_scheme }}" style="--s-bg: {{ scheme.bg }}; --s-text: {{ scheme.text }}; --s-heading: {{ scheme.heading }}; --s-para: {{ scheme.paragraph }}; --s-border: {{ scheme.border }}; --s-accent: {{ scheme.accent }}; --s-btn: {{ scheme.primary_btn_bg }}; --s-btn-text: {{ scheme.primary_btn_text }}; --s-btn2: {{ scheme.secondary_btn_bg }}; --s-btn2-text: {{ scheme.secondary_btn_text }}; --s-btn2-border: {{ scheme.secondary_btn_border }}; --s-btn-hover: {{ scheme.primary_btn_hover_bg }}; --s-btn-hover-text: {{ scheme.primary_btn_hover_text }}; --s-btn2-hover: {{ scheme.secondary_btn_hover_bg }}; --s-btn2-hover-text: {{ scheme.secondary_btn_hover_text }}; --s-radius: {{ theme.radius.medium }}px; --s-pt: {{ settings.padding_top }}px; --s-pb: {{ settings.padding_bottom }}px; --ct-radius: {{ settings.border_radius }}px;">
  <div class="s__in s__in--{{ settings.max_width }}">
    {% if settings.eyebrow or settings.heading or settings.subheading %}
      <div class="s__head s__head--center">
        {% if settings.eyebrow %}<p class="s__eyebrow">{{ settings.eyebrow }}</p>{% endif %}
        {% if settings.heading %}<h2 class="s__h">{{ settings.heading }}</h2>{% endif %}
        {% if settings.subheading %}<p class="s__sub">{{ settings.subheading }}</p>{% endif %}
      </div>
    {% endif %}
    {% if blocks.size == 0 %}
      {% if page.in_editor %}<p class="ct__empty">Add plans and feature rows in the sidebar</p>{% endif %}
    {% else %}
      <div class="ct__scroll" tabindex="0" role="region" aria-label="{{ settings.heading | default: 'Comparison' }}">
        <table class="ct__table">
          <thead>
            <tr>
              <th class="ct__corner" scope="col"><span class="ct__sr">{{ settings.feature_label }}</span></th>
              {% for col in blocks %}{% if col.type == 'comparison_column' %}
                <th scope="col" class="ct__col" data-block-id="{{ col.id }}">
                  {% if col.settings.badge %}<span class="ct__badge">{{ col.settings.badge }}</span>{% endif %}
                  <span class="ct__name">{{ col.settings.name }}</span>
                  {% if col.settings.price %}<span class="ct__price">{{ col.settings.price }}</span>{% endif %}
                  {% if col.settings.description %}<span class="ct__desc">{{ col.settings.description }}</span>{% endif %}
                </th>
              {% endif %}{% endfor %}
            </tr>
          </thead>
          <tbody>
            {% for row in blocks %}{% if row.type == 'comparison_row' %}
              {% if row.settings.is_divider %}
                <tr class="ct__divider" data-block-id="{{ row.id }}"><th scope="rowgroup" colspan="99">{{ row.settings.divider_label }}</th></tr>
              {% else %}
                <tr data-block-id="{{ row.id }}">
                  <th scope="row" class="ct__feat">{{ row.settings.feature }}{% if row.settings.tooltip %}<span class="ct__tip">{{ row.settings.tooltip }}</span>{% endif %}</th>
                  {% for cell in row.settings.values | split: "," %}<td>{% if settings.show_check_icons and cell == 'yes' %}<svg class="ct__ic ct__ic--yes" viewBox="0 0 20 20" role="img" aria-label="{{ settings.yes_label }}"><path d="M4 10.5l4 4 8-9"/></svg>{% elsif settings.show_check_icons and cell == 'Yes' %}<svg class="ct__ic ct__ic--yes" viewBox="0 0 20 20" role="img" aria-label="{{ settings.yes_label }}"><path d="M4 10.5l4 4 8-9"/></svg>{% elsif settings.show_check_icons and cell == 'true' %}<svg class="ct__ic ct__ic--yes" viewBox="0 0 20 20" role="img" aria-label="{{ settings.yes_label }}"><path d="M4 10.5l4 4 8-9"/></svg>{% elsif settings.show_check_icons and cell == 'no' %}<svg class="ct__ic ct__ic--no" viewBox="0 0 20 20" role="img" aria-label="{{ settings.no_label }}"><path d="M6 10h8"/></svg>{% elsif settings.show_check_icons and cell == 'No' %}<svg class="ct__ic ct__ic--no" viewBox="0 0 20 20" role="img" aria-label="{{ settings.no_label }}"><path d="M6 10h8"/></svg>{% elsif settings.show_check_icons and cell == 'false' %}<svg class="ct__ic ct__ic--no" viewBox="0 0 20 20" role="img" aria-label="{{ settings.no_label }}"><path d="M6 10h8"/></svg>{% else %}{{ cell }}{% endif %}</td>{% endfor %}
                </tr>
              {% endif %}
            {% endif %}{% endfor %}
          </tbody>
          {% if settings.show_cta_row %}
            <tfoot>
              <tr>
                <td></td>
                {% for col in blocks %}{% if col.type == 'comparison_column' %}
                  <td>{% if col.settings.cta_text %}<a class="s__btn {% if col.settings.is_highlighted %}s__btn--primary{% else %}s__btn--secondary{% endif %} ct__btn" href="{{ col.settings.cta_url | default: '#' | url }}">{{ col.settings.cta_text }}</a>{% endif %}</td>
                {% endif %}{% endfor %}
              </tr>
            </tfoot>
          {% endif %}
        </table>
      </div>
    {% endif %}
  </div>
</section>
</template>

<style scoped>
.s { container-type: inline-size; background: var(--s-bg); color: var(--s-text); }
.s__in {
  margin: 0 auto;
  padding: calc(var(--s-pt) * var(--theme-spacing-scale, 1)) var(--theme-padding-x, 24px) calc(var(--s-pb) * var(--theme-spacing-scale, 1));
}
.s__in--narrow { max-width: 720px; }
.s__in--medium { max-width: 960px; }
.s__in--wide { max-width: var(--theme-page-width, 1280px); }
.s__in--full { max-width: none; }
.s__eyebrow { margin: 0 0 14px; font-family: var(--sl-caption-font); font-size: var(--sl-caption-size, 12px); font-weight: var(--sl-caption-weight, 600); letter-spacing: var(--sl-caption-tracking, 0.14em); text-transform: var(--sl-caption-transform, uppercase); color: var(--s-accent); }
.s__h {
  margin: 0;
  font-size: var(--section-heading-size, 32px);
  line-height: var(--section-heading-line-height, 1.15);
  font-weight: var(--section-heading-weight, 700);
  color: var(--s-heading);
  letter-spacing: var(--section-heading-tracking, -0.01em);
  text-transform: var(--section-heading-transform, none);
  font-family: var(--section-heading-font, var(--theme-font-heading, {{ theme.typography.heading }}), ui-sans-serif, system-ui, sans-serif);
  text-wrap: balance;
}
.s__sub { margin: 16px 0 0; max-width: 38rem; font-size: var(--section-text-size, 17px); line-height: var(--section-text-line-height, 1.6); color: var(--s-para); text-wrap: pretty; }
.s__head { max-width: 46rem; }
.s__head--center { margin-inline: auto; text-align: center; }
.s__head--center .s__sub { margin-inline: auto; }
.s__btns { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
.s__head--center .s__btns { justify-content: center; }
.s__btn {
  display: inline-flex; align-items: center; justify-content: center; min-height: 44px;
  padding: var(--sl-button-padding, 13px 24px); font-size: var(--sl-button-size, 15px); line-height: var(--sl-button-line-height); font-weight: var(--theme-button-weight, 600); text-decoration: none;
  border-radius: var(--s-radius); border: 1px solid transparent; transition: background-color 180ms ease, color 180ms ease, border-color 180ms ease, transform 180ms ease;
}
.s__btn--primary:hover { background: var(--s-btn-hover); color: var(--s-btn-hover-text); border-color: var(--s-btn-hover); }
.s__btn--secondary:hover { background: var(--s-btn2-hover); color: var(--s-btn2-hover-text); }
.s__btn--primary { background: var(--s-btn); color: var(--s-btn-text); border-color: var(--s-btn); }
.s__btn--secondary { background: var(--s-btn2); color: var(--s-btn2-text); border-color: var(--s-btn2-border); }
.s__btn:focus-visible, .s a:focus-visible { outline: 2px solid var(--s-accent); outline-offset: 3px; }
.s__note { margin: 18px 0 0; font-size: 13px; color: var(--s-para); }
.ph { display: grid !important; place-content: center; justify-items: center; gap: 8px; width: 100%; height: 100%; min-height: 160px; box-sizing: border-box; border: 1px dashed var(--s-border); background: color-mix(in srgb, var(--s-text) 5%, transparent); color: var(--s-para); font-size: 13px; text-align: center; padding: 16px; }
@media (prefers-reduced-motion: reduce) { .s__btn { transition: none; } }
.ph svg { width: 28px; height: 28px; fill: none; stroke: currentColor; stroke-width: 1.5; }

.ct .s__head { margin-bottom: 48px; }
.ct__empty { margin: 0; padding: 24px; border: 1px dashed var(--s-border); text-align: center; font-size: 13px; color: var(--s-para); }
.ct__sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
.ct__scroll { overflow-x: auto; border: 1px solid var(--s-border); border-radius: var(--ct-radius, var(--s-radius)); }
.ct__scroll:focus-visible { outline: 2px solid var(--s-accent); outline-offset: 2px; }
.ct__table { width: 100%; min-width: 560px; border-collapse: separate; border-spacing: 0; font-size: 15px; }
.ct__table th, .ct__table td { padding: 16px 20px; text-align: center; border-bottom: 1px solid var(--s-border); vertical-align: middle; }
.ct__table tbody tr:last-child > * { border-bottom: 0; }
.ct__table thead th { vertical-align: bottom; padding-top: 28px; padding-bottom: 20px; background: var(--s-bg); }
.ct__col { min-width: 140px; }
.ct__name { display: block; font-size: 17px; font-weight: 600; color: var(--s-heading); font-family: var(--type-h3-font, var(--theme-font-heading)), ui-sans-serif, system-ui, sans-serif; }
.ct__price { display: block; margin-top: 6px; font-size: clamp(22px, 2.6cqi, 30px); font-weight: 600; color: var(--s-heading); letter-spacing: -0.01em; }
.ct__desc { display: block; margin-top: 4px; font-size: 13px; font-weight: 400; color: var(--s-para); }
.ct__badge { display: inline-block; margin-bottom: 10px; padding: 4px 10px; border-radius: 999px; font-size: 11px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; background: var(--s-btn); color: var(--s-btn-text); }
.ct__feat { text-align: left !important; font-weight: 500; color: var(--s-heading); position: sticky; left: 0; z-index: 1; background: var(--s-bg); min-width: 160px; }
.ct__tip { display: block; margin-top: 2px; font-size: 12px; font-weight: 400; color: var(--s-para); }
.ct__corner { position: sticky; left: 0; z-index: 2; }
.ct__table td { color: var(--s-text); }
.ct--hl0 .ct__table tr > :nth-child(2) { background: color-mix(in srgb, var(--s-accent) 7%, var(--s-bg)); }
.ct--hl1 .ct__table tr > :nth-child(3) { background: color-mix(in srgb, var(--s-accent) 7%, var(--s-bg)); }
.ct--hl2 .ct__table tr > :nth-child(4) { background: color-mix(in srgb, var(--s-accent) 7%, var(--s-bg)); }
.ct--hl3 .ct__table tr > :nth-child(5) { background: color-mix(in srgb, var(--s-accent) 7%, var(--s-bg)); }
.ct--hl4 .ct__table tr > :nth-child(6) { background: color-mix(in srgb, var(--s-accent) 7%, var(--s-bg)); }
.ct--hl5 .ct__table tr > :nth-child(7) { background: color-mix(in srgb, var(--s-accent) 7%, var(--s-bg)); }
.ct__divider th { text-align: left; padding-top: 28px; font-size: 12px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--s-accent); background: var(--s-bg); }
.ct__ic { width: 20px; height: 20px; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; vertical-align: middle; }
.ct__ic--yes { stroke: var(--s-heading); }
.ct__ic--no { stroke: var(--s-border); stroke-width: 2.5; }
.ct__table tfoot td { border-bottom: 0; border-top: 1px solid var(--s-border); padding-block: 24px; }
.ct__btn { width: 100%; box-sizing: border-box; }
@container (max-width: 759px) {
  .ct__table { min-width: 0; font-size: 14px; }
  .ct__table th, .ct__table td { padding: 12px 10px; }
  .ct__feat { min-width: 120px; max-width: 150px; }
  .ct__col { min-width: 104px; }
  .ct__btn { padding-inline: 12px; }
}
@container (min-width: 760px) {
  .ct--sticky .ct__scroll { overflow: visible; }
  .ct--sticky .ct__table thead th { position: sticky; top: var(--sl-anchor-offset, 0px); z-index: 3; }
  .ct--sticky .ct__table thead th:first-child { border-top-left-radius: var(--ct-radius, var(--s-radius)); }
  .ct--sticky .ct__table thead th:last-child { border-top-right-radius: var(--ct-radius, var(--s-radius)); }
}
</style>

<schema>
{
  "schema_version": 1,
  "type": "comparison_table",
  "name": "Comparison Table",
  "category": "features",
  "description": "Plans or products side by side: a column per plan, a row per feature, ticks and dashes.",
  "icon": "table",
  "settings": [
    {
      "type": "header",
      "id": "hdr_content",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": ""
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Compare plans"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Supporting line",
      "default": "",
      "info": "Optional."
    },
    {
      "type": "text",
      "id": "feature_label",
      "label": "Feature column name",
      "default": "Feature",
      "info": "Read aloud for the first column."
    },
    {
      "type": "toggle",
      "id": "show_cta_row",
      "label": "Buttons under each column",
      "default": true
    },
    {
      "type": "toggle",
      "id": "show_check_icons",
      "label": "Draw yes and no as a tick and a dash",
      "default": true
    },
    {
      "type": "text",
      "id": "yes_label",
      "label": "Tick read aloud as",
      "default": "Included"
    },
    {
      "type": "text",
      "id": "no_label",
      "label": "Dash read aloud as",
      "default": "Not included"
    },
    {
      "type": "header",
      "id": "hdr_layout",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "highlight_column",
      "label": "Highlighted plan",
      "default": "1",
      "options": [
        {
          "label": "None",
          "value": "-1"
        },
        {
          "label": "First",
          "value": "0"
        },
        {
          "label": "Second",
          "value": "1"
        },
        {
          "label": "Third",
          "value": "2"
        },
        {
          "label": "Fourth",
          "value": "3"
        },
        {
          "label": "Fifth",
          "value": "4"
        },
        {
          "label": "Sixth",
          "value": "5"
        }
      ]
    },
    {
      "type": "toggle",
      "id": "sticky_header",
      "label": "Keep the plan names in view",
      "default": true
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Corner radius",
      "default": 12,
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "max_width",
      "label": "Content width",
      "default": "wide",
      "options": [
        {
          "label": "Narrow",
          "value": "narrow"
        },
        {
          "label": "Medium",
          "value": "medium"
        },
        {
          "label": "Wide",
          "value": "wide"
        },
        {
          "label": "Full",
          "value": "full"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_style",
      "label": "Style"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "white"
    },
    {
      "type": "header",
      "id": "hdr_spacing",
      "label": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "default": 88,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "default": 88,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "comparison_column",
      "name": "Plan",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Plan"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": ""
        },
        {
          "type": "text",
          "id": "description",
          "label": "Short description",
          "default": ""
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge",
          "default": ""
        },
        {
          "type": "text",
          "id": "cta_text",
          "label": "Button",
          "default": ""
        },
        {
          "type": "url",
          "id": "cta_url",
          "label": "Button link",
          "default": ""
        },
        {
          "type": "toggle",
          "id": "is_highlighted",
          "label": "Badge and button stand out",
          "default": false
        }
      ]
    },
    {
      "type": "comparison_row",
      "name": "Feature row",
      "settings": [
        {
          "type": "text",
          "id": "feature",
          "label": "Feature",
          "default": "A feature"
        },
        {
          "type": "text",
          "id": "tooltip",
          "label": "Help text",
          "default": ""
        },
        {
          "type": "text",
          "id": "values",
          "label": "Values",
          "default": "yes, yes, yes",
          "info": "One per plan, in order, separated by commas. yes and no draw a tick and a dash."
        },
        {
          "type": "toggle",
          "id": "is_divider",
          "label": "Use as a group heading",
          "default": false
        },
        {
          "type": "text",
          "id": "divider_label",
          "label": "Group heading",
          "default": ""
        }
      ]
    }
  ],
  "max_blocks": 40,
  "presets": [
    {
      "name": "Comparison Table",
      "settings": {
        "subheading": "Choose the one that fits."
      },
      "blocks": [
        {
          "id": "c1",
          "type": "comparison_column",
          "settings": {
            "name": "Plan one",
            "price": "Price",
            "description": "Who it is for",
            "cta_text": "Choose",
            "cta_url": "/products"
          }
        },
        {
          "id": "c2",
          "type": "comparison_column",
          "settings": {
            "name": "Plan two",
            "price": "Price",
            "description": "Who it is for",
            "badge": "Most popular",
            "cta_text": "Choose",
            "cta_url": "/products",
            "is_highlighted": true
          }
        },
        {
          "id": "c3",
          "type": "comparison_column",
          "settings": {
            "name": "Plan three",
            "price": "Price",
            "description": "Who it is for",
            "cta_text": "Choose",
            "cta_url": "/contact"
          }
        },
        {
          "id": "d1",
          "type": "comparison_row",
          "settings": {
            "is_divider": true,
            "divider_label": "The essentials"
          }
        },
        {
          "id": "r1",
          "type": "comparison_row",
          "settings": {
            "feature": "A feature every plan has",
            "values": "yes, yes, yes"
          }
        },
        {
          "id": "r2",
          "type": "comparison_row",
          "settings": {
            "feature": "A limit that grows",
            "values": "1, 5, Unlimited"
          }
        },
        {
          "id": "r3",
          "type": "comparison_row",
          "settings": {
            "feature": "Something only bigger plans get",
            "values": "no, yes, yes"
          }
        },
        {
          "id": "r4",
          "type": "comparison_row",
          "settings": {
            "feature": "Something only the top plan gets",
            "values": "no, no, yes"
          }
        }
      ]
    }
  ]
}
</schema>
