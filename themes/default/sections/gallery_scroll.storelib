{# ===========================================================================
   Scrolling gallery: pictures in a row that runs past the edge of the page,
   moved with a swipe, a trackpad or the keyboard, each one snapping into
   place. The first picture lines up with the page's content; the row runs
   to the edge of the screen.
   =========================================================================== #}
<template>
<section class="s gs gs--{{ settings.size }}" data-scheme="{{ settings.color_scheme }}" style="--s-bg: {{ scheme.bg }}; --s-text: {{ scheme.text }}; --s-heading: {{ scheme.heading }}; --s-para: {{ scheme.paragraph }}; --s-border: {{ scheme.border }}; --s-accent: {{ scheme.accent }}; --s-btn: {{ scheme.primary_btn_bg }}; --s-btn-text: {{ scheme.primary_btn_text }}; --s-btn2: {{ scheme.secondary_btn_bg }}; --s-btn2-text: {{ scheme.secondary_btn_text }}; --s-btn2-border: {{ scheme.secondary_btn_border }}; --s-btn-hover: {{ scheme.primary_btn_hover_bg }}; --s-btn-hover-text: {{ scheme.primary_btn_hover_text }}; --s-btn2-hover: {{ scheme.secondary_btn_hover_bg }}; --s-btn2-hover-text: {{ scheme.secondary_btn_hover_text }}; --s-radius: {{ theme.radius.medium }}px; --s-pt: {{ settings.padding_top }}px; --s-pb: {{ settings.padding_bottom }}px; --gs-ratio: {{ settings.ratio }};">
  <div class="s__in s__in--{{ settings.max_width }} gs__top">
    {% if settings.eyebrow or settings.heading or settings.subheading %}
      <div class="s__head{% if settings.align == 'center' %} s__head--center{% endif %}">
        {% if settings.eyebrow %}<p class="s__eyebrow">{{ settings.eyebrow }}</p>{% endif %}
        {% if settings.heading %}<h2 class="s__h">{{ settings.heading }}</h2>{% endif %}
        {% if settings.subheading %}<p class="s__sub">{{ settings.subheading }}</p>{% endif %}
      </div>
    {% endif %}
  </div>
  {% if blocks.size == 0 %}
    {% if page.in_editor %}<p class="gs__empty">Add pictures in the sidebar</p>{% endif %}
  {% else %}
    <ul class="gs__row" role="list" tabindex="0" aria-label="{{ settings.heading | default: 'Gallery' }}">
      {% for block in blocks %}
        <li class="gs__item" data-block-id="{{ block.id }}">
          <figure class="gs__fig">
            {% if block.settings.link %}<a class="gs__a" href="{{ block.settings.link | url }}">{% endif %}
            <div class="gs__frame">{% if block.settings.image %}<img src="{{ block.settings.image | asset }}" alt="{{ block.settings.image_alt }}" loading="lazy" decoding="async" data-media>{% elsif page.in_editor %}<div class="ph"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="2"/><path d="M21 17l-5-5-9 8"/></svg><span>Add a picture</span></div>{% endif %}</div>
            {% if block.settings.link %}</a>{% endif %}
            {% if block.settings.caption or block.settings.detail %}<figcaption class="gs__cap"><span class="gs__title">{{ block.settings.caption }}</span>{% if block.settings.detail %}<span class="gs__detail">{{ block.settings.detail }}</span>{% endif %}</figcaption>{% endif %}
          </figure>
        </li>
      {% endfor %}
    </ul>
    {% if settings.hint %}<p class="gs__hint">{{ settings.hint }} <span aria-hidden="true">→</span></p>{% endif %}
  {% endif %}
  <div class="gs__end" aria-hidden="true"></div>
</section>
</template>

<style scoped>
.s { container-type: inline-size; background: var(--s-bg); color: var(--s-text); }
.s__in {
  margin: 0 auto;
  padding: calc(var(--s-pt) * var(--theme-spacing-scale, 1)) var(--theme-padding-x, 24px) calc(var(--s-pb) * var(--theme-spacing-scale, 1));
}
.s__in--narrow { max-width: 720px; }
.s__in--medium { max-width: 960px; }
.s__in--wide { max-width: var(--theme-page-width, 1280px); }
.s__in--full { max-width: none; }
.s__eyebrow { margin: 0 0 14px; font-family: var(--sl-caption-font); font-size: var(--sl-caption-size, 12px); font-weight: var(--sl-caption-weight, 600); letter-spacing: var(--sl-caption-tracking, 0.14em); text-transform: var(--sl-caption-transform, uppercase); color: var(--s-accent); }
.s__h {
  margin: 0;
  font-size: var(--section-heading-size, 32px);
  line-height: var(--section-heading-line-height, 1.15);
  font-weight: var(--section-heading-weight, 700);
  color: var(--s-heading);
  letter-spacing: var(--section-heading-tracking, -0.01em);
  text-transform: var(--section-heading-transform, none);
  font-family: var(--section-heading-font, var(--theme-font-heading, {{ theme.typography.heading }}), ui-sans-serif, system-ui, sans-serif);
  text-wrap: balance;
}
.s__sub { margin: 16px 0 0; max-width: 38rem; font-size: var(--section-text-size, 17px); line-height: var(--section-text-line-height, 1.6); color: var(--s-para); text-wrap: pretty; }
.s__head { max-width: 46rem; }
.s__head--center { margin-inline: auto; text-align: center; }
.s__head--center .s__sub { margin-inline: auto; }
.s__btns { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
.s__head--center .s__btns { justify-content: center; }
.s__btn {
  display: inline-flex; align-items: center; justify-content: center; min-height: 44px;
  padding: var(--sl-button-padding, 13px 24px); font-size: var(--sl-button-size, 15px); line-height: var(--sl-button-line-height); font-weight: var(--theme-button-weight, 600); text-decoration: none;
  border-radius: var(--s-radius); border: 1px solid transparent; transition: background-color 180ms ease, color 180ms ease, border-color 180ms ease, transform 180ms ease;
}
.s__btn--primary:hover { background: var(--s-btn-hover); color: var(--s-btn-hover-text); border-color: var(--s-btn-hover); }
.s__btn--secondary:hover { background: var(--s-btn2-hover); color: var(--s-btn2-hover-text); }
.s__btn--primary { background: var(--s-btn); color: var(--s-btn-text); border-color: var(--s-btn); }
.s__btn--secondary { background: var(--s-btn2); color: var(--s-btn2-text); border-color: var(--s-btn2-border); }
.s__btn:focus-visible, .s a:focus-visible { outline: 2px solid var(--s-accent); outline-offset: 3px; }
.s__note { margin: 18px 0 0; font-size: 13px; color: var(--s-para); }
.ph { display: grid !important; place-content: center; justify-items: center; gap: 8px; width: 100%; height: 100%; min-height: 160px; box-sizing: border-box; border: 1px dashed var(--s-border); background: color-mix(in srgb, var(--s-text) 5%, transparent); color: var(--s-para); font-size: 13px; text-align: center; padding: 16px; }
@media (prefers-reduced-motion: reduce) { .s__btn { transition: none; } }
.ph svg { width: 28px; height: 28px; fill: none; stroke: currentColor; stroke-width: 1.5; }

.gs { --gs-edge: max(var(--theme-padding-x, 24px), calc((100cqi - var(--theme-page-width, 1280px)) / 2)); }
.gs__top { padding-bottom: 36px; }
.gs__empty { margin: 0 var(--theme-padding-x, 24px); padding: 24px; border: 1px dashed var(--s-border); text-align: center; font-size: 13px; color: var(--s-para); }
.gs__row { list-style: none; margin: 0; padding: 4px var(--gs-edge) 20px; display: flex; gap: 16px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--gs-edge); overscroll-behavior-x: contain; scrollbar-width: thin; scrollbar-color: var(--s-border) transparent; }
.gs__row:focus-visible { outline: 2px solid var(--s-accent); outline-offset: -2px; }
.gs__item { flex: none; scroll-snap-align: start; width: 78cqi; }
.gs--small .gs__item { width: 62cqi; }
.gs--large .gs__item { width: 86cqi; }
@container (min-width: 760px) {
  .gs__item { width: 34cqi; } .gs--small .gs__item { width: 24cqi; } .gs--large .gs__item { width: 48cqi; }
  .gs__row { gap: 24px; }
}
@container (min-width: 1200px) { .gs__item { width: 30cqi; } .gs--small .gs__item { width: 21cqi; } .gs--large .gs__item { width: 42cqi; } }
.gs__fig { margin: 0; }
.gs__a { display: block; color: inherit; }
.gs__frame { overflow: hidden; aspect-ratio: var(--gs-ratio, 4 / 5); border-radius: var(--sl-image-radius, var(--s-radius)); background: color-mix(in srgb, var(--s-heading) 6%, var(--s-bg)); }
.gs__frame img, .gs__frame .ph { display: block; width: 100%; height: 100%; min-height: 0; object-fit: cover; transition: transform 600ms cubic-bezier(.2,.7,.2,1); }
.gs__a:hover .gs__frame img { transform: scale(1.04); }
.gs__cap { display: flex; justify-content: space-between; gap: 12px; margin-top: 12px; font-size: 14px; }
.gs__title { color: var(--s-heading); font-weight: 600; }
.gs__detail { color: var(--s-para); }
.gs__hint { margin: 4px 0 0; padding: 0 var(--gs-edge); font-size: 13px; color: var(--s-para); }
.gs__end { height: calc(var(--s-pb) * var(--theme-spacing-scale, 1)); }
@media (prefers-reduced-motion: reduce) { .gs__frame img { transition: none; } .gs__a:hover .gs__frame img { transform: none; } }
</style>

<schema>
{
  "schema_version": 1,
  "type": "gallery_scroll",
  "name": "Scrolling Gallery",
  "category": "media",
  "description": "Pictures in a row that runs past the edge of the page, swiped or scrolled, each snapping into place.",
  "icon": "gallery-horizontal",
  "settings": [
    {
      "type": "header",
      "id": "hdr_content",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": ""
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A closer look"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Supporting line",
      "default": ""
    },
    {
      "type": "radio",
      "id": "align",
      "label": "Heading alignment",
      "default": "left",
      "options": [
        {
          "label": "Left",
          "value": "left"
        },
        {
          "label": "Centre",
          "value": "center"
        }
      ]
    },
    {
      "type": "text",
      "id": "hint",
      "label": "Scroll hint",
      "default": "Scroll for more"
    },
    {
      "type": "header",
      "id": "hdr_layout",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "size",
      "label": "Picture size",
      "default": "medium",
      "options": [
        {
          "label": "Small",
          "value": "small"
        },
        {
          "label": "Medium",
          "value": "medium"
        },
        {
          "label": "Large",
          "value": "large"
        }
      ]
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Picture shape",
      "default": "4 / 5",
      "options": [
        {
          "label": "Portrait",
          "value": "4 / 5"
        },
        {
          "label": "Square",
          "value": "1"
        },
        {
          "label": "Landscape",
          "value": "4 / 3"
        },
        {
          "label": "Tall",
          "value": "2 / 3"
        }
      ]
    },
    {
      "type": "select",
      "id": "max_width",
      "label": "Content width",
      "default": "wide",
      "options": [
        {
          "label": "Narrow",
          "value": "narrow"
        },
        {
          "label": "Medium",
          "value": "medium"
        },
        {
          "label": "Wide",
          "value": "wide"
        },
        {
          "label": "Full",
          "value": "full"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_style",
      "label": "Style"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "white"
    },
    {
      "type": "header",
      "id": "hdr_spacing",
      "label": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "default": 96,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "default": 96,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "picture",
      "name": "Picture",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Picture",
          "default": ""
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Picture description",
          "default": "",
          "info": "Read aloud to people who cannot see it."
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "default": ""
        },
        {
          "type": "text",
          "id": "detail",
          "label": "Detail",
          "default": "",
          "info": "Small text on the right of the caption: a price, a place, a year."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "default": ""
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Scrolling Gallery",
      "blocks": [
        {
          "id": "g1",
          "type": "picture",
          "settings": {
            "caption": "The first picture"
          }
        },
        {
          "id": "g2",
          "type": "picture",
          "settings": {
            "caption": "The second picture"
          }
        },
        {
          "id": "g3",
          "type": "picture",
          "settings": {
            "caption": "The third picture"
          }
        },
        {
          "id": "g4",
          "type": "picture",
          "settings": {
            "caption": "The fourth picture"
          }
        },
        {
          "id": "g5",
          "type": "picture",
          "settings": {
            "caption": "The fifth picture"
          }
        },
        {
          "id": "g6",
          "type": "picture",
          "settings": {
            "caption": "The sixth picture"
          }
        }
      ]
    }
  ]
}
</schema>
