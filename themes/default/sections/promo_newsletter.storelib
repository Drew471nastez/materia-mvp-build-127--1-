<template>
<section class="s" data-scheme="{{ settings.color_scheme }}" style="--s-bg: {{ scheme.bg }}; --s-text: {{ scheme.text }}; --s-heading: {{ scheme.heading }}; --s-para: {{ scheme.paragraph }}; --s-border: {{ scheme.border }}; --s-accent: {{ scheme.accent }}; --s-btn: {{ scheme.primary_btn_bg }}; --s-btn-text: {{ scheme.primary_btn_text }}; --s-radius: {{ theme.radius.medium }}px; --s-pt: {{ settings.padding_top }}px; --s-pb: {{ settings.padding_bottom }}px;">
  <div class="s__in s__in--{{ settings.max_width }}">
    <div class="s__head {% if settings.align == 'center' %}s__head--center{% endif %}">
      {% if settings.eyebrow %}<p class="s__eyebrow">{{ settings.eyebrow }}</p>{% endif %}
      {% if settings.heading %}<h2 class="s__h">{{ settings.heading }}</h2>{% endif %}
      {% if settings.subheading %}<p class="s__sub">{{ settings.subheading }}</p>{% endif %}
      {% if settings.action %}
        <form class="nl" method="post" action="{{ settings.action | url }}" target="_blank">
          <label class="nl__label" for="nl-{{ section.id }}">{{ settings.field_label }}</label>
          <div class="nl__row">
            <input class="nl__input" id="nl-{{ section.id }}" type="email" name="{{ settings.field_name }}" placeholder="{{ settings.placeholder }}" required autocomplete="email">
            <button class="s__btn s__btn--primary nl__go" type="submit">{{ settings.button_text }}</button>
          </div>
        </form>
      {% else %}
        <p class="nl__setup">Add the address your mailing list gives you, in the sidebar, and this becomes a working form.</p>
      {% endif %}
      {% if settings.note %}<p class="s__note">{{ settings.note }}</p>{% endif %}
    </div>
  </div>
</section>
</template>

<style scoped>
.s { container-type: inline-size; background: var(--s-bg); color: var(--s-text); }
.s__in {
  margin: 0 auto;
  padding: calc(var(--s-pt) * var(--theme-spacing-scale, 1)) var(--theme-padding-x, 24px) calc(var(--s-pb) * var(--theme-spacing-scale, 1));
}
.s__in--narrow { max-width: 720px; }
.s__in--medium { max-width: 960px; }
.s__in--wide { max-width: var(--theme-page-width, 1280px); }
.s__in--full { max-width: none; }
.s__eyebrow { margin: 0 0 12px; font-size: 12px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--s-accent); }
.s__h {
  margin: 0;
  font-size: 32px;
  line-height: 1.15;
  font-weight: 700;
  color: var(--s-heading);
  letter-spacing: -0.01em;
  /* The theme's font when the page sets one, the token otherwise, and a real
     stack either way: a bare family name falls back to the browser's serif. */
  font-family: var(--theme-font-heading, {{ theme.typography.heading }}), ui-sans-serif, system-ui, sans-serif;
}
@container (min-width: 768px) { .s__h { font-size: 40px; } }
.s__sub { margin: 14px 0 0; font-size: 17px; line-height: 1.6; color: var(--s-para); }
.s__head { max-width: 44rem; }
.s__head--center { margin-inline: auto; text-align: center; }
.s__btns { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
.s__head--center .s__btns { justify-content: center; }
.s__btn {
  display: inline-flex; align-items: center; justify-content: center;
  padding: 13px 24px; font-size: 15px; font-weight: 600; text-decoration: none;
  border-radius: var(--s-radius); border: 1px solid transparent; transition: opacity 150ms ease;
}
.s__btn:hover { opacity: 0.88; }
.s__btn--primary { background: var(--s-btn); color: var(--s-btn-text); border-color: var(--s-btn); }
.s__btn--secondary { background: transparent; color: var(--s-heading); border-color: var(--s-border); }
.s__note { margin: 16px 0 0; font-size: 13px; color: var(--s-para); opacity: 0.8; }

.nl { margin-top: 26px; }
.nl__label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
.nl__row { display: flex; flex-wrap: wrap; gap: 10px; }
.s__head--center .nl__row { justify-content: center; }
.nl__input {
  flex: 1 1 240px; min-width: 0; max-width: 360px;
  padding: 13px 16px; font: inherit; font-size: 15px; color: var(--s-heading);
  background: transparent; border: 1px solid var(--s-border); border-radius: var(--s-radius);
}
.nl__input::placeholder { color: var(--s-para); opacity: 0.7; }
.nl__input:focus { outline: 2px solid var(--s-accent); outline-offset: 1px; }
.nl__go { flex: none; }
.nl__setup { margin: 24px 0 0; font-size: 14px; color: var(--s-para); opacity: 0.7; }
</style>

<schema>
{
  "schema_version": 1,
  "type": "promo_newsletter",
  "name": "Newsletter Signup",
  "category": "marketing",
  "description": "An address box that posts straight to your mailing list. No script.",
  "version": "1.0.0",
  "icon": "mail",
  "settings": [
    {
      "type": "header",
      "id": "hdr_content",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": ""
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "One email a month"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Supporting line",
      "default": "New things, restocks, and nothing else."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button",
      "default": "Sign me up"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Box says",
      "default": "you@example.com"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Small print",
      "default": "Leave whenever you like."
    },
    {
      "type": "radio",
      "id": "align",
      "label": "Text sits",
      "default": "center",
      "options": [
        {
          "label": "Left",
          "value": "left"
        },
        {
          "label": "Centre",
          "value": "center"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_list",
      "label": "Your mailing list"
    },
    {
      "type": "url",
      "id": "action",
      "label": "Form address",
      "default": "",
      "info": "The address your mailing list gives you for its signup form. Mailchimp, Buttondown and Kit all show one."
    },
    {
      "type": "text",
      "id": "field_name",
      "label": "Address field name",
      "default": "email",
      "info": "What your mailing list calls the email box. Usually email, sometimes EMAIL."
    },
    {
      "type": "text",
      "id": "field_label",
      "label": "Label read aloud",
      "default": "Email address"
    },
    {
      "type": "header",
      "id": "hdr_layout",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "max_width",
      "label": "Content width",
      "default": "medium",
      "options": [
        {
          "label": "Narrow",
          "value": "narrow"
        },
        {
          "label": "Medium",
          "value": "medium"
        },
        {
          "label": "Wide",
          "value": "wide"
        },
        {
          "label": "Full",
          "value": "full"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_style",
      "label": "Style"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "white"
    },
    {
      "type": "header",
      "id": "hdr_spacing",
      "label": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "default": 72,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "default": 72,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Newsletter Signup"
    }
  ]
}
</schema>
