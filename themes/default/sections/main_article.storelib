{# ===========================================================================
   Blog post: the body of the Blog post template

   Every post of the blog is drawn with it, at /blogs/<handle>/<slug>. The
   post is `article`, read from the Blog manager (Website Settings › Blog):
   its title, category, author, date, cover picture and words. Its words
   were cleaned when the post was saved and again when it was drawn
   (lib/site-blog/render-html.ts), so they are printed with `raw`.

   Around them, each one a toggle: the tags, the author's bio, links to
   share it, the posts before and after it, and posts like it.
   =========================================================================== #}
<template>
<section class="s" data-scheme="{{ settings.color_scheme }}" style="--s-bg: {{ scheme.bg }}; --s-text: {{ scheme.text }}; --s-heading: {{ scheme.heading }}; --s-para: {{ scheme.paragraph }}; --s-border: {{ scheme.border }}; --s-accent: {{ scheme.accent }}; --s-radius: {{ theme.radius.medium }}px; --s-pt: {{ settings.padding_top }}px; --s-pb: {{ settings.padding_bottom }}px; --measure: {{ settings.text_width }}px; --ratio: {{ settings.image_ratio }};">
  {% if article %}
  <article class="a">
    <header class="a__head {% if settings.align == 'center' %}a__head--center{% endif %}">
      {% if settings.show_category and article.category %}<a class="a__cat" href="{{ article.category.url | url }}">{{ article.category.name }}</a>{% endif %}
      <h1 class="a__title">{{ article.title }}</h1>
      {% if settings.show_excerpt and article.excerpt %}<p class="a__lede">{{ article.excerpt }}</p>{% endif %}
      {% if settings.show_author and article.author or settings.show_date or settings.show_reading_time %}
        <div class="a__meta">
          {% if settings.show_author and article.author %}
            <span class="a__by">{% if article.author.avatar %}<img class="a__avatar" src="{{ article.author.avatar | asset }}" alt="" loading="eager" decoding="async">{% endif %}<span class="a__name">{{ article.author.name }}</span></span>
          {% endif %}
          {% if settings.show_date %}<time class="a__date" datetime="{{ article.published_at }}">{{ article.date }}</time>{% endif %}
          {% if settings.show_reading_time %}<span class="a__time">{{ article.reading_minutes }} {{ settings.minutes_label }}</span>{% endif %}
        </div>
      {% endif %}
    </header>

    {% if settings.show_cover and article.image %}
      <figure class="a__cover a__cover--{{ settings.cover_width }}">
        <img src="{{ article.image | asset }}" alt="{{ article.image_alt }}" loading="eager" fetchpriority="high" decoding="async">
      </figure>
    {% endif %}

    <div class="a__body sl-post">{{ article.content | raw }}</div>

    {% if settings.show_tags and article.tags.size > 0 %}
      <ul class="a__tags" aria-label="{{ words.tags }}">
        {% for t in article.tags %}<li><a class="a__tag" href="{{ t.url | url }}">#{{ t.name }}</a></li>{% endfor %}
      </ul>
    {% endif %}

    {% if settings.show_share %}
      <div class="a__share">
        <span class="a__share-label">{{ settings.share_label }}</span>
        <a class="a__net" href="{{ article.share.x | url }}" target="_blank" rel="noopener noreferrer" aria-label="X"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M17.8 3h3.1l-6.8 7.7 8 10.3h-6.3l-4.9-6.4L5.3 21H2.2l7.3-8.3L1.8 3h6.4l4.4 5.9L17.8 3Zm-1.1 16.2h1.7L7.4 4.7H5.6l11.1 14.5Z"/></svg></a>
        <a class="a__net" href="{{ article.share.facebook | url }}" target="_blank" rel="noopener noreferrer" aria-label="Facebook"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.8 1.4-3.8 3.9v2.3H8v3h2.5V21h3Z"/></svg></a>
        <a class="a__net" href="{{ article.share.linkedin | url }}" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6.9 8.8H3.6V20h3.3V8.8ZM5.3 3.5a1.9 1.9 0 1 0 0 3.8 1.9 1.9 0 0 0 0-3.8ZM20.4 13.6c0-3-1.6-5-4.3-5-1.5 0-2.5.8-3 1.6V8.8H9.9V20h3.3v-5.6c0-1.5.3-2.9 2.1-2.9 1.8 0 1.8 1.7 1.8 3V20h3.3v-6.4Z"/></svg></a>
        <a class="a__net" href="{{ article.share.email | url }}" aria-label="{{ words.email }}"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 6.5 8.5 6.5 8.5-6.5"/></svg></a>
      </div>
    {% endif %}

    {% if settings.show_author_bio and article.author %}
      {% if article.author.bio %}
        <aside class="a__bio">
          {% if article.author.avatar %}<img class="a__bio-pic" src="{{ article.author.avatar | asset }}" alt="" loading="lazy" decoding="async">{% endif %}
          <div class="a__bio-text">
            <p class="a__bio-label">{{ settings.author_label }}</p>
            <p class="a__bio-name">{{ article.author.name }}{% if article.author.role %} <span class="a__bio-role">{{ article.author.role }}</span>{% endif %}</p>
            <p class="a__bio-about">{{ article.author.bio }}</p>
            {% if article.author.links.size > 0 %}<p class="a__bio-links">{% for l in article.author.links %}<a href="{{ l.url | url }}" rel="noopener">{{ l.label }}</a>{% endfor %}</p>{% endif %}
          </div>
        </aside>
      {% endif %}
    {% endif %}

    {% if settings.show_neighbours %}
      {% if article.previous or article.next %}
        <nav class="a__near" aria-label="{{ settings.more_label }}">
          {% if article.previous %}<a class="a__step a__step--prev" href="{{ article.previous.url | url }}" rel="prev"><span class="a__step-label">{{ settings.previous_label }}</span><span class="a__step-title">{{ article.previous.title }}</span></a>{% else %}<span></span>{% endif %}
          {% if article.next %}<a class="a__step a__step--next" href="{{ article.next.url | url }}" rel="next"><span class="a__step-label">{{ settings.next_label }}</span><span class="a__step-title">{{ article.next.title }}</span></a>{% endif %}
        </nav>
      {% endif %}
    {% endif %}
  </article>

  {% if settings.show_related and settings.related_count > 0 and article.related.size > 0 %}
    <div class="rel">
      <h2 class="rel__h">{{ settings.related_heading }}</h2>
      <div class="rel__grid">
        {% for post in article.related limit: settings.related_count %}
          <article class="rel__post">
            <a class="rel__media" href="{{ post.url | url }}" tabindex="-1" aria-hidden="true">{% if post.image %}<img src="{{ post.image | asset }}" alt="" loading="lazy" decoding="async">{% else %}<span class="rel__blank">{{ post.title | first | upcase }}</span>{% endif %}</a>
            {% if post.category %}<a class="rel__cat" href="{{ post.category.url | url }}">{{ post.category.name }}</a>{% endif %}
            <h3 class="rel__title"><a href="{{ post.url | url }}">{{ post.title }}</a></h3>
            {% if settings.show_date %}<time class="rel__date" datetime="{{ post.published_at }}">{{ post.date }}</time>{% endif %}
          </article>
        {% endfor %}
      </div>
    </div>
  {% endif %}
  {% elsif page.in_editor %}
    <p class="none">A post from your blog is shown here. Write posts in Website Settings, Blog.</p>
  {% endif %}
</section>
</template>

<style scoped>
.s { container-type: inline-size; background: var(--s-bg); color: var(--s-text); padding: calc(var(--s-pt) * var(--theme-spacing-scale, 1)) var(--theme-padding-x, 24px) calc(var(--s-pb) * var(--theme-spacing-scale, 1)); }
.a { max-width: var(--measure); margin: 0 auto; }
.a__head { margin-bottom: 32px; }
.a__head--center { text-align: center; }
.a__head--center .a__meta { justify-content: center; }
.a__cat { display: inline-block; margin-bottom: 14px; font-size: 13px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--s-accent, var(--s-heading)); text-decoration: none; }
.a__cat:hover { text-decoration: underline; text-underline-offset: 3px; }
.a__title {
  margin: 0;
  font-size: clamp(32px, 6cqi, 52px);
  line-height: 1.08;
  font-weight: var(--section-heading-weight, 700);
  letter-spacing: -0.025em;
  color: var(--s-heading);
  text-wrap: balance;
  overflow-wrap: anywhere;
  font-family: var(--section-heading-font, var(--theme-font-heading, {{ theme.typography.heading }}), ui-sans-serif, system-ui, sans-serif);
}
.a__lede { margin: 18px 0 0; font-size: clamp(18px, 2.4cqi, 21px); line-height: 1.55; color: var(--s-para); text-wrap: pretty; }
.a__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; margin-top: 22px; font-size: 14px; color: var(--s-para); }
.a__by { display: inline-flex; align-items: center; gap: 10px; font-weight: 600; color: var(--s-heading); }
.a__avatar { width: 36px; height: 36px; border-radius: 999px; object-fit: cover; }
.a__meta > * + *::before { content: "·"; margin-right: 10px; opacity: 0.6; }

.a__cover { margin: 0 0 40px; overflow: hidden; border-radius: var(--sl-image-radius, var(--s-radius)); background: var(--s-border); aspect-ratio: var(--ratio); }
.a__cover img { display: block; width: 100%; height: 100%; object-fit: cover; }
@container (min-width: 900px) {
  .a__cover--wide { margin-inline: calc((min(100cqi - 48px, 1100px) - var(--measure)) / -2); }
}

.a__body { font-size: 18px; line-height: 1.75; color: var(--s-text); overflow-wrap: break-word; }
.a__body > * { margin: 0 0 1.25em; }
.a__body > :last-child { margin-bottom: 0; }
.a__body h2, .a__body h3, .a__body h4 { color: var(--s-heading); line-height: 1.25; letter-spacing: -0.01em; scroll-margin-top: 96px; font-family: var(--theme-font-heading, {{ theme.typography.heading }}), ui-sans-serif, system-ui, sans-serif; }
.a__body h2 { margin: 2em 0 0.6em; font-size: 1.6em; font-weight: 700; }
.a__body h3 { margin: 1.7em 0 0.5em; font-size: 1.28em; font-weight: 650; }
.a__body a { color: var(--s-heading); text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }
.a__body strong, .a__body b { color: var(--s-heading); font-weight: 650; }
.a__body ul, .a__body ol { padding-left: 1.4em; }
.a__body li { margin: 0.35em 0; }
.a__body li::marker { color: var(--s-para); }
.a__body blockquote { margin-inline: 0; padding: 4px 0 4px 22px; border-left: 3px solid var(--s-heading); font-size: 1.12em; font-style: italic; color: var(--s-heading); }
.a__body figure { margin-inline: 0; }
.a__body img, .a__body video { display: block; max-width: 100%; height: auto; border-radius: var(--sl-image-radius, var(--s-radius)); }
.a__body figcaption { margin-top: 10px; font-size: 14px; line-height: 1.5; color: var(--s-para); text-align: center; }
.a__body iframe { display: block; width: 100%; aspect-ratio: 16 / 9; height: auto; border: 0; border-radius: var(--s-radius); }
.a__body hr { border: 0; height: 1px; background: var(--s-border); margin: 2.5em 0; }
.a__body pre { overflow-x: auto; padding: 18px 20px; border-radius: var(--s-radius); background: var(--s-border); font-size: 14px; line-height: 1.6; }
.a__body code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.88em; }
.a__body :not(pre) > code { padding: 2px 6px; border-radius: 6px; background: var(--s-border); }
.a__body table { width: 100%; border-collapse: collapse; font-size: 15px; display: block; overflow-x: auto; }
.a__body th, .a__body td { padding: 10px 12px; border-bottom: 1px solid var(--s-border); text-align: left; vertical-align: top; }
.a__body th { color: var(--s-heading); font-weight: 600; }
.a__body [class*="gallery"] { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 10px; }
.a__body [class*="callout"] { padding: 18px 20px; border-radius: var(--s-radius); border: 1px solid var(--s-border); }
.a__body [class*="button"] a, .a__body a[class*="button"] { display: inline-flex; padding: 12px 22px; border-radius: var(--s-radius); background: var(--s-heading); color: var(--s-bg); text-decoration: none; font-weight: 600; }

.a__tags { display: flex; flex-wrap: wrap; gap: 8px; margin: 40px 0 0; padding: 0; list-style: none; }
.a__tag { display: inline-flex; align-items: center; height: 32px; padding: 0 14px; border-radius: 999px; border: 1px solid var(--s-border); font-size: 13px; color: var(--s-heading); text-decoration: none; }
.a__tag:hover { border-color: var(--s-heading); }
.a__share { display: flex; align-items: center; gap: 8px; margin-top: 28px; padding-top: 24px; border-top: 1px solid var(--s-border); }
.a__share-label { margin-right: 6px; font-size: 14px; font-weight: 600; color: var(--s-heading); }
.a__net { display: inline-flex; align-items: center; justify-content: center; width: 38px; height: 38px; border-radius: 999px; border: 1px solid var(--s-border); color: var(--s-heading); transition: background-color 150ms ease; }
.a__net:hover { background: var(--s-border); }
.a__net svg { width: 17px; height: 17px; fill: currentColor; }
.a__net svg[fill="none"] { fill: none; }

.a__bio { display: flex; gap: 20px; margin-top: 40px; padding: 24px; border-radius: var(--s-radius); border: 1px solid var(--s-border); }
.a__bio-pic { flex: none; width: 64px; height: 64px; border-radius: 999px; object-fit: cover; }
.a__bio-text { min-width: 0; }
.a__bio-label { margin: 0; font-size: 12px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--s-para); }
.a__bio-name { margin: 4px 0 0; font-size: 18px; font-weight: 650; color: var(--s-heading); }
.a__bio-role { font-size: 14px; font-weight: 400; color: var(--s-para); }
.a__bio-about { margin: 8px 0 0; font-size: 15px; line-height: 1.6; color: var(--s-para); }
.a__bio-links { display: flex; flex-wrap: wrap; gap: 14px; margin: 10px 0 0; font-size: 14px; }
.a__bio-links a { color: var(--s-heading); text-decoration: underline; text-underline-offset: 3px; }

.a__near { display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px; margin-top: 40px; }
@container (min-width: 640px) { .a__near { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
.a__step { display: flex; flex-direction: column; gap: 6px; padding: 18px 20px; border-radius: var(--s-radius); border: 1px solid var(--s-border); text-decoration: none; transition: border-color 150ms ease; }
.a__step:hover { border-color: var(--s-heading); }
.a__step--next { text-align: right; }
.a__step-label { font-size: 12px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--s-para); }
.a__step-title { font-size: 16px; line-height: 1.35; font-weight: 600; color: var(--s-heading); }

.rel { max-width: var(--theme-page-width, 1280px); margin: 72px auto 0; padding-top: 48px; border-top: 1px solid var(--s-border); }
.rel__h { margin: 0 0 28px; font-size: var(--section-heading-size, 26px); line-height: var(--section-heading-line-height, 1.2); font-weight: var(--section-heading-weight, 700); letter-spacing: var(--section-heading-tracking, -0.01em); text-transform: var(--section-heading-transform, none); color: var(--s-heading); font-family: var(--section-heading-font, var(--theme-font-heading, {{ theme.typography.heading }}), ui-sans-serif, system-ui, sans-serif); }
.rel__grid { display: grid; gap: 32px 24px; grid-template-columns: minmax(0, 1fr); }
@container (min-width: 640px) { .rel__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@container (min-width: 900px) { .rel__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
.rel__post { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
.rel__media { display: block; text-decoration: none; overflow: hidden; aspect-ratio: 16 / 10; border-radius: var(--sl-image-radius, var(--s-radius)); background: var(--s-border); margin-bottom: 6px; }
.rel__media img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 400ms cubic-bezier(0.22, 1, 0.36, 1); }
.rel__post:hover .rel__media img { transform: scale(1.03); }
.rel__blank { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; font-size: 40px; font-weight: 700; color: var(--s-para); opacity: 0.35; }
.rel__cat { align-self: flex-start; font-size: 12px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--s-accent, var(--s-heading)); text-decoration: none; }
.rel__title { margin: 0; font-size: 18px; line-height: 1.35; font-weight: 650; color: var(--s-heading); }
.rel__title a { color: inherit; text-decoration: none; }
.rel__title a:hover { text-decoration: underline; text-underline-offset: 3px; }
.rel__date { font-size: 13px; color: var(--s-para); }
.none { margin: 0; text-align: center; font-size: 15px; color: var(--s-para); }
.a a:focus-visible, .rel a:focus-visible { outline: 2px solid var(--s-heading); outline-offset: 3px; border-radius: 4px; }
@media (prefers-reduced-motion: reduce) { .rel__media img, .a__net, .a__step { transition: none; } .rel__post:hover .rel__media img { transform: none; } }
</style>

<schema>
{
  "schema_version": 1,
  "type": "main_article",
  "name": "Blog post",
  "category": "blog",
  "description": "One post of your blog: its title, author, date, cover picture and words, with its tags, share links, the posts before and after it and posts like it.",
  "version": "1.0.0",
  "icon": "file-text",
  "allowed_templates": ["article"],
  "settings": [
    { "type": "header", "id": "hdr_head", "label": "Top of the post" },
    {
      "type": "radio",
      "id": "align",
      "label": "Title sits",
      "default": "left",
      "options": [
        { "label": "Left", "value": "left" },
        { "label": "Centre", "value": "center" }
      ]
    },
    { "type": "toggle", "id": "show_category", "label": "Show its category", "default": true },
    { "type": "toggle", "id": "show_excerpt", "label": "Show its excerpt under the title", "default": true },
    { "type": "toggle", "id": "show_author", "label": "Show its author", "default": true },
    { "type": "toggle", "id": "show_date", "label": "Show its date", "default": true },
    { "type": "toggle", "id": "show_reading_time", "label": "Show its reading time", "default": true },
    { "type": "text", "id": "minutes_label", "label": "After the minutes", "default": "min read", "visible_if": "{{ section.settings.show_reading_time }}" },
    { "type": "header", "id": "hdr_cover", "label": "Cover picture" },
    { "type": "toggle", "id": "show_cover", "label": "Show the cover picture", "default": true },
    {
      "type": "select",
      "id": "cover_width",
      "label": "Cover width",
      "default": "wide",
      "options": [
        { "label": "As wide as the words", "value": "text" },
        { "label": "Wider than the words", "value": "wide" }
      ],
      "visible_if": "{{ section.settings.show_cover }}"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Cover shape",
      "default": "16 / 9",
      "options": [
        { "label": "Wide", "value": "16 / 9" },
        { "label": "Landscape", "value": "3 / 2" },
        { "label": "Classic", "value": "4 / 3" },
        { "label": "Square", "value": "1 / 1" }
      ],
      "visible_if": "{{ section.settings.show_cover }}"
    },
    { "type": "header", "id": "hdr_text", "label": "Words" },
    { "type": "range", "id": "text_width", "label": "Width of the words", "min": 560, "max": 960, "step": 20, "unit": "px", "default": 720 },
    { "type": "header", "id": "hdr_after", "label": "Under the post" },
    { "type": "toggle", "id": "show_tags", "label": "Show its tags", "default": true },
    { "type": "toggle", "id": "show_share", "label": "Show links to share it", "default": true },
    { "type": "text", "id": "share_label", "label": "Before the share links", "default": "Share", "visible_if": "{{ section.settings.show_share }}" },
    { "type": "toggle", "id": "show_author_bio", "label": "Show the author's bio", "default": true },
    { "type": "text", "id": "author_label", "label": "Above the bio", "default": "Written by", "visible_if": "{{ section.settings.show_author_bio }}" },
    { "type": "toggle", "id": "show_neighbours", "label": "Show the previous and next posts", "default": true },
    { "type": "text", "id": "previous_label", "label": "Previous post", "default": "Previous post", "visible_if": "{{ section.settings.show_neighbours }}" },
    { "type": "text", "id": "next_label", "label": "Next post", "default": "Next post", "visible_if": "{{ section.settings.show_neighbours }}" },
    { "type": "text", "id": "more_label", "label": "Name of those links, for screen readers", "default": "More posts", "visible_if": "{{ section.settings.show_neighbours }}" },
    { "type": "header", "id": "hdr_related", "label": "Related posts" },
    { "type": "toggle", "id": "show_related", "label": "Show related posts", "default": true },
    { "type": "text", "id": "related_heading", "label": "Heading", "default": "Keep reading", "visible_if": "{{ section.settings.show_related }}" },
    { "type": "range", "id": "related_count", "label": "How many", "min": 1, "max": 6, "step": 1, "default": 3, "visible_if": "{{ section.settings.show_related }}" },
    { "type": "header", "id": "hdr_style", "label": "Style" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "white" },
    { "type": "header", "id": "hdr_spacing", "label": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 88 }
  ],
  "presets": [
    { "name": "Blog post" }
  ]
}
</schema>
