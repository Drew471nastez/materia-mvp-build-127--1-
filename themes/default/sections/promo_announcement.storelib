<template>
<section class="s an" data-scheme="{{ settings.color_scheme }}" style="--s-bg: {{ scheme.bg }}; --s-text: {{ scheme.text }}; --s-heading: {{ scheme.heading }}; --s-para: {{ scheme.paragraph }}; --s-border: {{ scheme.border }}; --s-accent: {{ scheme.accent }}; --s-btn: {{ scheme.primary_btn_bg }}; --s-btn-text: {{ scheme.primary_btn_text }}; --s-radius: {{ theme.radius.medium }}px; --s-pt: {{ settings.padding_top }}px; --s-pb: {{ settings.padding_bottom }}px; --an-pad: {{ settings.density }}px;">
  <div class="s__in s__in--{{ settings.max_width }} an__in">
    <p class="an__text">
      {% if settings.label %}<span class="an__label">{{ settings.label }}</span>{% endif %}
      <span>{{ settings.text }}</span>
      {% if settings.link_text %}<a class="an__go" href="{{ settings.link_url | default: '#' | url }}">{{ settings.link_text }}</a>{% endif %}
    </p>
  </div>
</section>
</template>

<style scoped>
.s { container-type: inline-size; background: var(--s-bg); color: var(--s-text); }
.s__in {
  margin: 0 auto;
  padding: calc(var(--s-pt) * var(--theme-spacing-scale, 1)) var(--theme-padding-x, 24px) calc(var(--s-pb) * var(--theme-spacing-scale, 1));
}
.s__in--narrow { max-width: 720px; }
.s__in--medium { max-width: 960px; }
.s__in--wide { max-width: var(--theme-page-width, 1280px); }
.s__in--full { max-width: none; }
.s__eyebrow { margin: 0 0 12px; font-size: 12px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--s-accent); }
.s__h {
  margin: 0;
  font-size: 32px;
  line-height: 1.15;
  font-weight: 700;
  color: var(--s-heading);
  letter-spacing: -0.01em;
  /* The theme's font when the page sets one, the token otherwise, and a real
     stack either way: a bare family name falls back to the browser's serif. */
  font-family: var(--theme-font-heading, {{ theme.typography.heading }}), ui-sans-serif, system-ui, sans-serif;
}
@container (min-width: 768px) { .s__h { font-size: 40px; } }
.s__sub { margin: 14px 0 0; font-size: 17px; line-height: 1.6; color: var(--s-para); }
.s__head { max-width: 44rem; }
.s__head--center { margin-inline: auto; text-align: center; }
.s__btns { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
.s__head--center .s__btns { justify-content: center; }
.s__btn {
  display: inline-flex; align-items: center; justify-content: center;
  padding: 13px 24px; font-size: 15px; font-weight: 600; text-decoration: none;
  border-radius: var(--s-radius); border: 1px solid transparent; transition: opacity 150ms ease;
}
.s__btn:hover { opacity: 0.88; }
.s__btn--primary { background: var(--s-btn); color: var(--s-btn-text); border-color: var(--s-btn); }
.s__btn--secondary { background: transparent; color: var(--s-heading); border-color: var(--s-border); }
.s__note { margin: 16px 0 0; font-size: 13px; color: var(--s-para); opacity: 0.8; }

.an .s__in { padding-top: var(--an-pad); padding-bottom: var(--an-pad); }
.an__in { display: flex; justify-content: center; }
.an__text { margin: 0; display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 10px; font-size: 14px; line-height: 1.5; color: var(--s-text); text-align: center; }
.an__label { padding: 3px 9px; border-radius: 999px; font-size: 11px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; background: var(--s-btn); color: var(--s-btn-text); }
.an__go { color: var(--s-heading); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
</style>

<schema>
{
  "schema_version": 1,
  "type": "promo_announcement",
  "name": "Announcement / Promo",
  "category": "marketing",
  "description": "A thin band with one thing to say.",
  "version": "1.0.0",
  "icon": "megaphone",
  "settings": [
    {
      "type": "header",
      "id": "hdr_content",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Pill",
      "default": "",
      "placeholder": "New"
    },
