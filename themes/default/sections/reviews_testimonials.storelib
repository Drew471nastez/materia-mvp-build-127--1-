{# ===========================================================================
   Testimonials (Storelib Reviews)

   A few reviews as large quotes, side by side or one at a time (a
   scroll-snapping row, so it swipes with no script). Featured and four and
   five star reviews by default. From `reviews` through review_scope and
   review_list (lib/reviews/widgets.ts). With Storelib Reviews off, or no
   review to show, it draws nothing on a live page.
   =========================================================================== #}
<template>
{% if reviews.enabled %}
{% for sc in reviews | review_scope: settings.scope %}
{% if sc.items.size > 0 or page.in_editor %}
<div class="rw rw--{{ settings.show_on }} rw--{{ settings.star_style }}">
<section class="s rt" data-scheme="{{ settings.color_scheme }}" style="--s-bg: {{ settings.background | default: scheme.bg }}; --s-text: {{ settings.text_color | default: scheme.text }}; --s-heading: {{ settings.text_color | default: scheme.heading }}; --s-para: {{ settings.text_color | default: scheme.paragraph }}; --s-border: {{ settings.border_color | default: scheme.border }}; --s-accent: {{ scheme.accent }}; --s-btn: {{ scheme.primary_btn_bg }}; --s-btn-text: {{ scheme.primary_btn_text }}; --s-btn-hover: {{ scheme.primary_btn_hover_bg }}; --s-btn-hover-text: {{ scheme.primary_btn_hover_text }}; --s-pt: {{ settings.padding_top }}px; --s-pb: {{ settings.padding_bottom }}px; --rv-star: {{ settings.star_color | default: reviews.star_color }}; --rv-size: {{ settings.star_size }}px; --rw-scale: {{ settings.text_scale }}; --rw-hscale: {{ settings.heading_scale }}; --rw-card: {{ settings.card_background | default: 'transparent' }}; --rw-bw: {{ settings.border_width }}px; --rw-radius: {{ settings.radius }}px; --rw-gap: {{ settings.gap }}px; --cols-d: {{ settings.columns.desktop }}; --cols-t: {{ settings.columns.tablet }};">
  <div class="s__in s__in--{{ settings.max_width }}">
    {% if settings.heading or settings.subheading %}<div class="rw__head rw__head--{{ settings.align }}">{% if settings.heading %}<h2 class="s__h">{{ settings.heading }}</h2>{% endif %}{% if settings.subheading %}<p class="rw__sub">{{ settings.subheading }}</p>{% endif %}</div>{% endif %}
    {% if page.in_editor and reviews.sample %}<p class="rv__sample">Sample reviews. Your real reviews show here once you have some.</p>{% endif %}
    <div class="rt__list rt__list--{{ settings.layout }} rt__list--{{ settings.quote_align }}" role="list">
      {% for r in sc.items | review_list: settings.sort, settings.min_rating limit: settings.count %}<div class="rt__cell" role="listitem"><figure class="rt__item" data-review-id="{{ r.id }}"><span class="rv-stars" style="--rv: {{ r.rating | times: 20 }}%;" role="img" aria-label="{{ r.rating }} {{ words.out_of_five_stars }}"></span>{% if settings.show_title and r.title %}<p class="rt__title">{{ r.title }}</p>{% endif %}<blockquote class="rt__quote"><p>{{ r.body }}</p></blockquote><figcaption class="rt__by">{% if settings.show_product and r.product_image %}<img class="rt__img" src="{{ r.product_image }}" alt="" loading="lazy" decoding="async">{% elsif settings.show_avatar %}<span class="rt__av" aria-hidden="true">{{ r.initial }}</span>{% endif %}<span class="rt__who"><span class="rt__name">{{ r.author }}</span>{% if settings.show_verified and reviews.show_verified and r.verified %}<span class="rt__ver">{{ words.verified_buyer }}</span>{% endif %}{% if settings.show_product and r.product_title %}{% if r.product_url %}<a class="rt__prod" href="{{ r.product_url | url }}">{{ r.product_title }}</a>{% else %}<span class="rt__prod">{{ r.product_title }}</span>{% endif %}{% endif %}{% if settings.show_date and reviews.show_date %}<span class="rt__date">{{ r.date }}</span>{% endif %}</span></figcaption></figure></div>{% endfor %}
    </div>
  </div>
</section>
{% if page.in_editor %}<p class="rw__off rw__off--desktop">Shown on computers only. Switch the preview to a computer to see it.</p><p class="rw__off rw__off--mobile">Shown on phones only. Switch the preview to a phone to see it.</p>{% endif %}
</div>
{% endif %}
{% endfor %}
{% endif %}
</template>

<style scoped>
.rw { container-type: inline-size; }
@container (max-width: 749px) { .rw--desktop > .s { display: none; } }
@container (min-width: 750px) { .rw--mobile > .s { display: none; } }
.rw__off { display: none; margin: 0; padding: 14px 16px; border: 1px dashed currentColor; opacity: 0.55; font-size: 13px; line-height: 1.4; text-align: center; }
@container (max-width: 749px) { .rw--desktop > .rw__off--desktop { display: block; } }
@container (min-width: 750px) { .rw--mobile > .rw__off--mobile { display: block; } }
.s { container-type: inline-size; background: var(--s-bg); color: var(--s-text); font-size: calc(15px * var(--rw-scale, 100) / 100); }
.s__in { margin: 0 auto; padding: calc(var(--s-pt) * var(--theme-spacing-scale, 1)) var(--theme-padding-x, 24px) calc(var(--s-pb) * var(--theme-spacing-scale, 1)); }
.s__in--narrow { max-width: 720px; }
.s__in--medium { max-width: 960px; }
.s__in--wide { max-width: var(--theme-page-width, 1280px); }
.s__in--full { max-width: none; }
.s__h {
  margin: 0;
  font-size: calc(var(--section-heading-size, 32px) * var(--rw-hscale, 100) / 100);
  line-height: var(--section-heading-line-height, 1.15);
  font-weight: var(--section-heading-weight, 700);
  color: var(--s-heading);
  letter-spacing: var(--section-heading-tracking, -0.01em);
  text-transform: var(--section-heading-transform, none);
  font-family: var(--section-heading-font, var(--theme-font-heading, {{ theme.typography.heading }}), ui-sans-serif, system-ui, sans-serif);
}
.rw__head { margin-bottom: 28px; }
.rw__head--center { text-align: center; }
.rw__sub { margin: 10px 0 0; font-size: calc(var(--section-text-size, 17px) * var(--rw-scale, 100) / 100); line-height: 1.6; color: var(--s-para); max-width: 44rem; }
.rw__head--center .rw__sub { margin-left: auto; margin-right: auto; }
.rv__sample { margin: -12px 0 20px; font-size: 13px; color: var(--s-para); opacity: 0.7; }
.rv-stars { --rv-g: "\2605\2605\2605\2605\2605"; position: relative; display: inline-block; flex: none; font-size: var(--rv-size, 16px); line-height: 1; letter-spacing: 0.12em; white-space: nowrap; color: color-mix(in srgb, var(--s-para) 22%, transparent); }
.rv-stars::before { content: var(--rv-g); }
.rv-stars::after { content: var(--rv-g); position: absolute; inset: 0 auto 0 0; width: var(--rv, 0%); overflow: hidden; white-space: nowrap; color: var(--rv-star, var(--s-accent)); }
.rw--outline .rv-stars { color: transparent; -webkit-text-stroke: 1px var(--rv-star, var(--s-accent)); }
.rw--outline .rv-stars::after { -webkit-text-stroke: 0; }
.rw--heart .rv-stars { --rv-g: "\2665\2665\2665\2665\2665"; }
.rt__list { display: grid; gap: var(--rw-gap); }
.rt__list--columns { grid-template-columns: minmax(0, 1fr); }
@container (min-width: 640px) { .rt__list--columns { grid-template-columns: repeat(var(--cols-t), minmax(0, 1fr)); } }
@container (min-width: 900px) { .rt__list--columns { grid-template-columns: repeat(var(--cols-d), minmax(0, 1fr)); } }
.rt__list--slider { grid-auto-flow: column; grid-auto-columns: 100%; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: thin; padding-bottom: 12px; }
.rt__list--slider .rt__cell { scroll-snap-align: center; }
.rt__cell { min-width: 0; display: flex; }
.rt__item { margin: 0; display: flex; flex-direction: column; gap: 14px; flex: 1; min-width: 0; box-sizing: border-box; padding: clamp(20px, 4cqi, 36px); background: var(--rw-card); border: var(--rw-bw) solid var(--s-border); border-radius: var(--rw-radius); }
.rt__list--center .rt__item { align-items: center; text-align: center; }
.rt__list--slider .rt__item { max-width: 760px; margin: 0 auto; }
.rt__title { margin: 0; font-weight: 600; color: var(--s-heading); }
.rt__quote { margin: 0; }
.rt__quote p { margin: 0; font-size: 1.35em; line-height: 1.45; color: var(--s-heading); white-space: pre-line; overflow-wrap: anywhere; display: -webkit-box; -webkit-line-clamp: 8; -webkit-box-orient: vertical; overflow: hidden; }
.rt__list--columns .rt__quote p { font-size: 1.12em; }
.rt__by { display: flex; align-items: center; gap: 12px; margin-top: auto; padding-top: 4px; }
.rt__list--center .rt__by { justify-content: center; }
.rt__img, .rt__av { width: 44px; height: 44px; border-radius: 999px; flex: none; }
.rt__img { object-fit: cover; }
.rt__av { display: inline-flex; align-items: center; justify-content: center; font-weight: 700; background: color-mix(in srgb, var(--s-para) 12%, transparent); color: var(--s-heading); }
.rt__who { display: flex; flex-direction: column; gap: 2px; min-width: 0; font-size: 0.87em; color: var(--s-para); text-align: left; }
.rt__list--center .rt__who { text-align: center; }
.rt__name { font-weight: 600; color: var(--s-heading); }
.rt__ver::before { content: "\2713  "; font-weight: 700; color: var(--s-heading); }
.rt__prod { color: var(--s-para); }
a.rt__prod { text-decoration: underline; text-underline-offset: 3px; }
</style>

<schema>
{
  "schema_version": 1,
  "type": "reviews_testimonials",
  "name": "Testimonials",
  "category": "reviews",
  "description": "Storelib Reviews: a few reviews as large quotes.",
  "version": "1.0.0",
  "icon": "star",
  "settings": [
    {
      "type": "header",
      "id": "hdr_content",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "In their words"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Supporting line",
      "default": ""
    },
    {
      "type": "radio",
      "id": "align",
      "label": "Heading sits",
      "default": "left",
      "options": [
        {
          "label": "Left",
          "value": "left"
        },
        {
          "label": "Centre",
          "value": "center"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_reviews",
      "label": "Reviews"
    },
    {
      "type": "select",
      "id": "scope",
      "label": "Whose reviews",
      "default": "all",
      "options": [
        {
          "label": "This page: the product's on a product page",
          "value": "here"
        },
        {
          "label": "The whole shop",
          "value": "all"
        }
      ]
    },
    {
      "type": "select",
      "id": "sort",
      "label": "Order",
      "default": "featured",
      "options": [
        {
          "label": "Featured first",
          "value": "featured"
        },
        {
          "label": "Newest",
          "value": "newest"
        },
        {
          "label": "Highest rated",
          "value": "highest"
        },
        {
          "label": "Lowest rated",
          "value": "lowest"
        },
        {
          "label": "With photos first",
          "value": "photos"
        }
      ]
    },
    {
      "type": "range",
      "id": "min_rating",
      "label": "Lowest rating shown",
      "default": 4,
      "min": 1,
      "max": 5,
      "step": 1
    },
    {
      "type": "range",
      "id": "count",
      "label": "How many",
      "default": 3,
      "min": 1,
      "max": 12,
      "step": 1
    },
    {
      "type": "header",
      "id": "hdr_shown",
      "label": "Shown on each review"
    },
    {
      "type": "toggle",
      "id": "show_title",
      "label": "Title",
      "default": false
    },
    {
      "type": "toggle",
      "id": "show_date",
      "label": "Date",
      "default": false
    },
    {
      "type": "toggle",
      "id": "show_verified",
      "label": "Verified buyer",
      "default": true
    },
    {
      "type": "toggle",
      "id": "show_product",
      "label": "Product",
      "default": true
    },
    {
      "type": "toggle",
      "id": "show_avatar",
      "label": "Initial beside the name",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_layout",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "columns",
      "options": [
        {
          "label": "Side by side",
          "value": "columns"
        },
        {
          "label": "One at a time, swipe for the next",
          "value": "slider"
        }
      ]
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "default": {
        "desktop": 3,
        "tablet": 2,
        "mobile": 1
      },
      "min": 1,
      "max": 3,
      "step": 1,
      "responsive": true,
      "visible_if": "{{ section.settings.layout == 'columns' }}"
    },
    {
      "type": "radio",
      "id": "quote_align",
      "label": "Quote sits",
      "default": "left",
      "options": [
        {
          "label": "Left",
          "value": "left"
        },
        {
          "label": "Centre",
          "value": "center"
        }
      ]
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Space between",
      "default": 20,
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "max_width",
      "label": "Content width",
      "default": "wide",
      "options": [
        {
          "label": "Narrow",
          "value": "narrow"
        },
        {
          "label": "Medium",
          "value": "medium"
        },
        {
          "label": "Wide",
          "value": "wide"
        },
        {
          "label": "Full",
          "value": "full"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_style",
      "label": "Style"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "white"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "",
      "info": "Empty uses the colour scheme."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "",
      "info": "Empty uses the colour scheme."
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": ""
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "",
      "info": "Empty uses the colour scheme."
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "default": 0,
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Corner radius",
      "default": 16,
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "star_style",
      "label": "Stars",
      "default": "solid",
      "options": [
        {
          "label": "Solid",
          "value": "solid"
        },
        {
          "label": "Outline",
          "value": "outline"
        },
        {
          "label": "Hearts",
          "value": "heart"
        }
      ]
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star colour",
      "default": "",
      "info": "Empty uses the colour set in Storelib Reviews."
    },
    {
      "type": "range",
      "id": "star_size",
      "label": "Star size",
      "default": 18,
      "min": 10,
      "max": 40,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "id": "hdr_type",
      "label": "Typography"
    },
    {
      "type": "range",
      "id": "text_scale",
      "label": "Text size",
      "default": 100,
      "min": 80,
      "max": 140,
      "step": 5,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "heading_scale",
      "label": "Heading size",
      "default": 100,
      "min": 60,
      "max": 160,
      "step": 5,
      "unit": "%"
    },
    {
      "type": "header",
      "id": "hdr_visibility",
      "label": "Visibility"
    },
    {
      "type": "select",
      "id": "show_on",
      "label": "Show on",
      "default": "all",
      "options": [
        {
          "label": "Phones and computers",
          "value": "all"
        },
        {
          "label": "Computers only",
          "value": "desktop"
        },
        {
          "label": "Phones only",
          "value": "mobile"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_spacing",
      "label": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "default": 80,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "default": 80,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "settings": {}
    }
  ]
}
</schema>
