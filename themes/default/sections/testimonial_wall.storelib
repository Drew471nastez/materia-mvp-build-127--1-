{# ===========================================================================
   Testimonial wall: what customers said, in their words, as a masonry wall
   of cards of different heights. Every quote, name and photo is a block the
   creator fills with real reviews; the presets hold instructions, never an
   invented person.
   =========================================================================== #}
<template>
<section class="s tw{% if settings.feature_first %} tw--feature{% endif %}" data-scheme="{{ settings.color_scheme }}" style="--s-bg: {{ scheme.bg }}; --s-text: {{ scheme.text }}; --s-heading: {{ scheme.heading }}; --s-para: {{ scheme.paragraph }}; --s-border: {{ scheme.border }}; --s-accent: {{ scheme.accent }}; --s-btn: {{ scheme.primary_btn_bg }}; --s-btn-text: {{ scheme.primary_btn_text }}; --s-btn2: {{ scheme.secondary_btn_bg }}; --s-btn2-text: {{ scheme.secondary_btn_text }}; --s-btn2-border: {{ scheme.secondary_btn_border }}; --s-btn-hover: {{ scheme.primary_btn_hover_bg }}; --s-btn-hover-text: {{ scheme.primary_btn_hover_text }}; --s-btn2-hover: {{ scheme.secondary_btn_hover_bg }}; --s-btn2-hover-text: {{ scheme.secondary_btn_hover_text }}; --s-radius: {{ theme.radius.medium }}px; --s-pt: {{ settings.padding_top }}px; --s-pb: {{ settings.padding_bottom }}px; --tw-cols: {{ settings.columns.desktop }}; --tw-cols-t: {{ settings.columns.tablet }};">
  <div class="s__in s__in--{{ settings.max_width }}">
    {% if settings.eyebrow or settings.heading or settings.subheading %}
      <div class="s__head{% if settings.align == 'center' %} s__head--center{% endif %}">
        {% if settings.eyebrow %}<p class="s__eyebrow">{{ settings.eyebrow }}</p>{% endif %}
        {% if settings.heading %}<h2 class="s__h">{{ settings.heading }}</h2>{% endif %}
        {% if settings.subheading %}<p class="s__sub">{{ settings.subheading }}</p>{% endif %}
      </div>
    {% endif %}
    {% if blocks.size == 0 %}
      {% if page.in_editor %}<p class="tw__empty">Add what your customers said in the sidebar</p>{% endif %}
    {% else %}
      <div class="tw__wall">
        {% for block in blocks %}
          <figure class="tw__card" data-container data-block-id="{{ block.id }}">
            {% if block.settings.rating != '0' %}<p class="tw__stars" role="img" aria-label="{{ block.settings.rating }} / 5">{% if block.settings.rating == '5' %}★★★★★{% elsif block.settings.rating == '4' %}★★★★☆{% elsif block.settings.rating == '3' %}★★★☆☆{% elsif block.settings.rating == '2' %}★★☆☆☆{% else %}★☆☆☆☆{% endif %}</p>{% endif %}
            <blockquote class="tw__quote"><p>{{ block.settings.quote }}</p></blockquote>
            <figcaption class="tw__who">
              {% if block.settings.photo %}<img class="tw__avatar" src="{{ block.settings.photo | asset }}" alt="" loading="lazy" decoding="async">{% endif %}
              <span><span class="tw__name">{{ block.settings.name }}</span>{% if block.settings.detail %}<span class="tw__detail">{{ block.settings.detail }}</span>{% endif %}</span>
            </figcaption>
          </figure>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>
</template>

<style scoped>
.s { container-type: inline-size; background: var(--s-bg); color: var(--s-text); }
.s__in {
  margin: 0 auto;
  padding: calc(var(--s-pt) * var(--theme-spacing-scale, 1)) var(--theme-padding-x, 24px) calc(var(--s-pb) * var(--theme-spacing-scale, 1));
}
.s__in--narrow { max-width: 720px; }
.s__in--medium { max-width: 960px; }
.s__in--wide { max-width: var(--theme-page-width, 1280px); }
.s__in--full { max-width: none; }
.s__eyebrow { margin: 0 0 14px; font-family: var(--sl-caption-font); font-size: var(--sl-caption-size, 12px); font-weight: var(--sl-caption-weight, 600); letter-spacing: var(--sl-caption-tracking, 0.14em); text-transform: var(--sl-caption-transform, uppercase); color: var(--s-accent); }
.s__h {
  margin: 0;
  font-size: var(--section-heading-size, 32px);
  line-height: var(--section-heading-line-height, 1.15);
  font-weight: var(--section-heading-weight, 700);
  color: var(--s-heading);
  letter-spacing: var(--section-heading-tracking, -0.01em);
  text-transform: var(--section-heading-transform, none);
  font-family: var(--section-heading-font, var(--theme-font-heading, {{ theme.typography.heading }}), ui-sans-serif, system-ui, sans-serif);
  text-wrap: balance;
}
.s__sub { margin: 16px 0 0; max-width: 38rem; font-size: var(--section-text-size, 17px); line-height: var(--section-text-line-height, 1.6); color: var(--s-para); text-wrap: pretty; }
.s__head { max-width: 46rem; }
.s__head--center { margin-inline: auto; text-align: center; }
.s__head--center .s__sub { margin-inline: auto; }
.s__btns { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
.s__head--center .s__btns { justify-content: center; }
.s__btn {
  display: inline-flex; align-items: center; justify-content: center; min-height: 44px;
  padding: var(--sl-button-padding, 13px 24px); font-size: var(--sl-button-size, 15px); line-height: var(--sl-button-line-height); font-weight: var(--theme-button-weight, 600); text-decoration: none;
  border-radius: var(--s-radius); border: 1px solid transparent; transition: background-color 180ms ease, color 180ms ease, border-color 180ms ease, transform 180ms ease;
}
.s__btn--primary:hover { background: var(--s-btn-hover); color: var(--s-btn-hover-text); border-color: var(--s-btn-hover); }
.s__btn--secondary:hover { background: var(--s-btn2-hover); color: var(--s-btn2-hover-text); }
.s__btn--primary { background: var(--s-btn); color: var(--s-btn-text); border-color: var(--s-btn); }
.s__btn--secondary { background: var(--s-btn2); color: var(--s-btn2-text); border-color: var(--s-btn2-border); }
.s__btn:focus-visible, .s a:focus-visible { outline: 2px solid var(--s-accent); outline-offset: 3px; }
.s__note { margin: 18px 0 0; font-size: 13px; color: var(--s-para); }
.ph { display: grid !important; place-content: center; justify-items: center; gap: 8px; width: 100%; height: 100%; min-height: 160px; box-sizing: border-box; border: 1px dashed var(--s-border); background: color-mix(in srgb, var(--s-text) 5%, transparent); color: var(--s-para); font-size: 13px; text-align: center; padding: 16px; }
@media (prefers-reduced-motion: reduce) { .s__btn { transition: none; } }
.ph svg { width: 28px; height: 28px; fill: none; stroke: currentColor; stroke-width: 1.5; }

.tw .s__head { margin-bottom: 48px; }
.tw__empty { margin: 0; padding: 24px; border: 1px dashed var(--s-border); text-align: center; font-size: 13px; color: var(--s-para); }
.tw__wall { columns: 1; column-gap: 20px; }
@container (min-width: 640px) { .tw__wall { columns: var(--tw-cols-t, 2); } }
@container (min-width: 960px) { .tw__wall { columns: var(--tw-cols, 3); column-gap: 24px; } }
.tw__card { break-inside: avoid; margin: 0 0 20px; padding: 28px; border: 1px solid var(--s-border); border-radius: var(--s-radius); background: color-mix(in srgb, var(--s-heading) 3%, var(--s-bg)); }
.tw--feature .tw__card:first-child { background: var(--s-btn); border-color: var(--s-btn); color: var(--s-btn-text); }
.tw--feature .tw__card:first-child .tw__quote p { font-size: clamp(20px, 2.2cqi, 26px); color: var(--s-btn-text); font-family: var(--type-h3-font, var(--theme-font-heading)), ui-serif, Georgia, serif; line-height: 1.35; }
.tw--feature .tw__card:first-child .tw__name, .tw--feature .tw__card:first-child .tw__detail, .tw--feature .tw__card:first-child .tw__stars { color: var(--s-btn-text); }
.tw__stars { margin: 0 0 14px; font-size: 14px; letter-spacing: 2px; color: var(--s-accent); }
.tw__quote { margin: 0; }
.tw__quote p { margin: 0; font-size: 16px; line-height: 1.6; color: var(--s-heading); text-wrap: pretty; }
.tw__who { display: flex; align-items: center; gap: 12px; margin-top: 20px; }
.tw__avatar { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; flex: none; }
.tw__name { display: block; font-size: 14px; font-weight: 600; color: var(--s-heading); }
.tw__detail { display: block; margin-top: 2px; font-size: 13px; color: var(--s-para); }
</style>

<schema>
{
  "schema_version": 1,
  "type": "testimonial_wall",
  "name": "Testimonial Wall",
  "category": "social-proof",
  "description": "Real reviews in customers' own words, as a masonry wall of cards.",
  "icon": "message-square",
  "settings": [
    {
      "type": "header",
      "id": "hdr_content",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": ""
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "In their words"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Supporting line",
      "default": ""
    },
    {
      "type": "radio",
      "id": "align",
      "label": "Heading alignment",
      "default": "left",
      "options": [
        {
          "label": "Left",
          "value": "left"
        },
        {
          "label": "Centre",
          "value": "center"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_layout",
      "label": "Layout"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "default": {
        "desktop": 3,
        "tablet": 2,
        "mobile": 1
      },
      "min": 1,
      "max": 4,
      "step": 1,
      "responsive": true
    },
    {
      "type": "toggle",
      "id": "feature_first",
      "label": "Make the first one stand out",
      "default": true
    },
    {
      "type": "select",
      "id": "max_width",
      "label": "Content width",
      "default": "wide",
      "options": [
        {
          "label": "Narrow",
          "value": "narrow"
        },
        {
          "label": "Medium",
          "value": "medium"
        },
        {
          "label": "Wide",
          "value": "wide"
        },
        {
          "label": "Full",
          "value": "full"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_style",
      "label": "Style"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "white"
    },
    {
      "type": "header",
      "id": "hdr_spacing",
      "label": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "default": 96,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "default": 96,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "What they said",
          "default": "Paste a real review here, in the customer's own words."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Customer's name",
          "info": "Only with their permission. A first name and an initial is enough."
        },
        {
          "type": "text",
          "id": "detail",
          "label": "Detail",
          "default": "Where they are, or what they bought"
        },
        {
          "type": "image_picker",
          "id": "photo",
          "label": "Photo",
          "default": "",
          "info": "Optional, and only one they gave you."
        },
        {
          "type": "select",
          "id": "rating",
          "label": "Stars",
          "default": "5",
          "options": [
            {
              "label": "None",
              "value": "0"
            },
            {
              "label": "5",
              "value": "5"
            },
            {
              "label": "4",
              "value": "4"
            },
            {
              "label": "3",
              "value": "3"
            },
            {
              "label": "2",
              "value": "2"
            },
            {
              "label": "1",
              "value": "1"
            }
          ]
        }
      ]
    }
  ],
  "max_blocks": 24,
  "presets": [
    {
      "name": "Testimonial Wall",
      "blocks": [
        {
          "id": "q1",
          "type": "quote",
          "settings": {
            "quote": "Paste your best review here. The first card is the one people read first, so choose one that says what makes you different."
          }
        },
        {
          "id": "q2",
          "type": "quote",
          "settings": {
            "quote": "Paste a real review here, in the customer's own words."
          }
        },
        {
          "id": "q3",
          "type": "quote",
          "settings": {
            "quote": "A short one works well too."
          }
        },
        {
          "id": "q4",
          "type": "quote",
          "settings": {
            "quote": "Reviews of different lengths make the wall look natural. Paste a longer one here, with the detail that made it memorable for them."
          }
        },
        {
          "id": "q5",
          "type": "quote",
          "settings": {
            "quote": "One that mentions a detail, a person or a moment reads as real, because it is."
          }
        },
        {
          "id": "q6",
          "type": "quote",
          "settings": {
            "quote": "Ask a happy customer if you can quote them."
          }
        }
      ]
    }
  ]
}
</schema>
