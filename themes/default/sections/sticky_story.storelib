{# ===========================================================================
   Sticky story: one picture that stays in view while short steps scroll
   past it. CSS only: position: sticky on the picture column, and where the
   browser can tie an animation to scrolling, each step brightens as it
   reaches the middle of the screen. Without that, or with less motion
   asked for, every step is simply shown.
   =========================================================================== #}
<template>
<section class="s ss ss--{{ settings.media_side }}" data-scheme="{{ settings.color_scheme }}" style="--s-bg: {{ scheme.bg }}; --s-text: {{ scheme.text }}; --s-heading: {{ scheme.heading }}; --s-para: {{ scheme.paragraph }}; --s-border: {{ scheme.border }}; --s-accent: {{ scheme.accent }}; --s-btn: {{ scheme.primary_btn_bg }}; --s-btn-text: {{ scheme.primary_btn_text }}; --s-btn2: {{ scheme.secondary_btn_bg }}; --s-btn2-text: {{ scheme.secondary_btn_text }}; --s-btn2-border: {{ scheme.secondary_btn_border }}; --s-btn-hover: {{ scheme.primary_btn_hover_bg }}; --s-btn-hover-text: {{ scheme.primary_btn_hover_text }}; --s-btn2-hover: {{ scheme.secondary_btn_hover_bg }}; --s-btn2-hover-text: {{ scheme.secondary_btn_hover_text }}; --s-radius: {{ theme.radius.medium }}px; --s-pt: {{ settings.padding_top }}px; --s-pb: {{ settings.padding_bottom }}px;">
  <div class="s__in s__in--{{ settings.max_width }}">
    <div class="ss__grid">
      <div class="ss__stick">
        <div class="ss__media">
          {% if settings.image %}<img src="{{ settings.image | asset }}" alt="{{ settings.image_alt }}" loading="lazy" decoding="async" data-media>{% elsif page.in_editor %}<div class="ph"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="2"/><path d="M21 17l-5-5-9 8"/></svg><span>Add the picture that stays in view</span></div>{% endif %}
        </div>
      </div>
      <div class="ss__flow">
        {% if settings.eyebrow or settings.heading or settings.subheading %}
      <div class="s__head{% if settings.align == 'center' %} s__head--center{% endif %}">
        {% if settings.eyebrow %}<p class="s__eyebrow">{{ settings.eyebrow }}</p>{% endif %}
        {% if settings.heading %}<h2 class="s__h">{{ settings.heading }}</h2>{% endif %}
        {% if settings.subheading %}<p class="s__sub">{{ settings.subheading }}</p>{% endif %}
      </div>
    {% endif %}
        {% if blocks.size == 0 %}
          {% if page.in_editor %}<p class="ss__empty">Add steps in the sidebar</p>{% endif %}
        {% else %}
          <ol class="ss__steps">
            {% for block in blocks %}
              <li class="ss__step" data-block-id="{{ block.id }}">
                <span class="ss__num" aria-hidden="true">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
                <h3 class="ss__title">{{ block.settings.title }}</h3>
                {% if block.settings.text %}<p class="ss__text">{{ block.settings.text }}</p>{% endif %}
                {% if block.settings.image %}<img class="ss__img" src="{{ block.settings.image | asset }}" alt="{{ block.settings.image_alt }}" loading="lazy" decoding="async">{% endif %}
              </li>
            {% endfor %}
          </ol>
        {% endif %}
      </div>
    </div>
  </div>
</section>
</template>

<style scoped>
.s { container-type: inline-size; background: var(--s-bg); color: var(--s-text); }
.s__in {
  margin: 0 auto;
  padding: calc(var(--s-pt) * var(--theme-spacing-scale, 1)) var(--theme-padding-x, 24px) calc(var(--s-pb) * var(--theme-spacing-scale, 1));
}
.s__in--narrow { max-width: 720px; }
.s__in--medium { max-width: 960px; }
.s__in--wide { max-width: var(--theme-page-width, 1280px); }
.s__in--full { max-width: none; }
.s__eyebrow { margin: 0 0 14px; font-family: var(--sl-caption-font); font-size: var(--sl-caption-size, 12px); font-weight: var(--sl-caption-weight, 600); letter-spacing: var(--sl-caption-tracking, 0.14em); text-transform: var(--sl-caption-transform, uppercase); color: var(--s-accent); }
.s__h {
  margin: 0;
  font-size: var(--section-heading-size, 32px);
  line-height: var(--section-heading-line-height, 1.15);
  font-weight: var(--section-heading-weight, 700);
  color: var(--s-heading);
  letter-spacing: var(--section-heading-tracking, -0.01em);
  text-transform: var(--section-heading-transform, none);
  font-family: var(--section-heading-font, var(--theme-font-heading, {{ theme.typography.heading }}), ui-sans-serif, system-ui, sans-serif);
  text-wrap: balance;
}
.s__sub { margin: 16px 0 0; max-width: 38rem; font-size: var(--section-text-size, 17px); line-height: var(--section-text-line-height, 1.6); color: var(--s-para); text-wrap: pretty; }
.s__head { max-width: 46rem; }
.s__head--center { margin-inline: auto; text-align: center; }
.s__head--center .s__sub { margin-inline: auto; }
.s__btns { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
.s__head--center .s__btns { justify-content: center; }
.s__btn {
  display: inline-flex; align-items: center; justify-content: center; min-height: 44px;
  padding: var(--sl-button-padding, 13px 24px); font-size: var(--sl-button-size, 15px); line-height: var(--sl-button-line-height); font-weight: var(--theme-button-weight, 600); text-decoration: none;
  border-radius: var(--s-radius); border: 1px solid transparent; transition: background-color 180ms ease, color 180ms ease, border-color 180ms ease, transform 180ms ease;
}
.s__btn--primary:hover { background: var(--s-btn-hover); color: var(--s-btn-hover-text); border-color: var(--s-btn-hover); }
.s__btn--secondary:hover { background: var(--s-btn2-hover); color: var(--s-btn2-hover-text); }
.s__btn--primary { background: var(--s-btn); color: var(--s-btn-text); border-color: var(--s-btn); }
.s__btn--secondary { background: var(--s-btn2); color: var(--s-btn2-text); border-color: var(--s-btn2-border); }
.s__btn:focus-visible, .s a:focus-visible { outline: 2px solid var(--s-accent); outline-offset: 3px; }
.s__note { margin: 18px 0 0; font-size: 13px; color: var(--s-para); }
.ph { display: grid !important; place-content: center; justify-items: center; gap: 8px; width: 100%; height: 100%; min-height: 160px; box-sizing: border-box; border: 1px dashed var(--s-border); background: color-mix(in srgb, var(--s-text) 5%, transparent); color: var(--s-para); font-size: 13px; text-align: center; padding: 16px; }
@media (prefers-reduced-motion: reduce) { .s__btn { transition: none; } }
.ph svg { width: 28px; height: 28px; fill: none; stroke: currentColor; stroke-width: 1.5; }

.ss__grid { display: grid; gap: 40px; grid-template-columns: minmax(0, 1fr); }
.ss__media img, .ss__media .ph { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--sl-image-radius, var(--s-radius)); }
.ss__empty { margin: 0; padding: 24px; border: 1px dashed var(--s-border); text-align: center; font-size: 13px; color: var(--s-para); }
.ss__steps { list-style: none; margin: 40px 0 0; padding: 0; display: grid; gap: 40px; counter-reset: ss; }
.ss__step { position: relative; padding-left: 64px; }
.ss__num { position: absolute; left: 0; top: 2px; font-size: 13px; font-weight: 600; letter-spacing: 0.08em; color: var(--s-accent); font-variant-numeric: tabular-nums; }
.ss__step::before { content: ""; position: absolute; left: 0; top: 28px; bottom: -28px; width: 1px; background: var(--s-border); }
.ss__step:last-child::before { display: none; }
.ss__title { margin: 0; color: var(--s-heading); font-family: var(--type-h3-font, var(--theme-font-heading)), ui-sans-serif, system-ui, sans-serif; font-weight: var(--type-h3-weight, 600); letter-spacing: var(--type-h3-tracking, -0.01em); font-size: clamp(22px, 2.6cqi, 32px); line-height: 1.2; text-wrap: balance; }
.ss__text { margin: 12px 0 0; max-width: 38ch; font-size: 17px; line-height: 1.65; color: var(--s-para); }
.ss__img { display: block; width: 100%; margin-top: 20px; aspect-ratio: 16 / 10; object-fit: cover; border-radius: var(--sl-image-radius, var(--s-radius)); }
@container (min-width: 900px) {
  .ss__grid { grid-template-columns: 6fr 5fr; gap: 80px; align-items: start; }
  .ss--left .ss__stick { order: 0; }
  .ss--right .ss__stick { order: 2; }
  .ss__stick { position: sticky; top: calc(var(--sl-anchor-offset, 0px) + 48px); }
  .ss__media img, .ss__media .ph { aspect-ratio: 4 / 5; max-height: calc(var(--sl-vh, 1vh) * 80); }
  .ss__steps { margin-top: 64px; gap: 0; }
  .ss__step { min-height: calc(var(--sl-vh, 1vh) * 55); padding-bottom: 48px; }
  .ss__step::before { bottom: 0; }
}
@supports (animation-timeline: view()) {
  @media (prefers-reduced-motion: no-preference) {
    .ss__step { animation: ss-lit linear both; animation-timeline: view(); animation-range: entry 0% entry 90%; }
    @keyframes ss-lit { from { opacity: 0.25; transform: translateY(24px); } to { opacity: 1; transform: none; } }
  }
}
</style>

<schema>
{
  "schema_version": 1,
  "type": "sticky_story",
  "name": "Sticky Story",
  "category": "content",
  "description": "A picture that stays in view while short steps scroll past it. Good for a process, a story or a how-it-works.",
  "icon": "book-open",
  "settings": [
    {
      "type": "header",
      "id": "hdr_content",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": ""
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How it comes together"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Supporting line",
      "default": ""
    },
    {
      "type": "radio",
      "id": "align",
      "label": "Heading alignment",
      "default": "left",
      "options": [
        {
          "label": "Left",
          "value": "left"
        },
        {
          "label": "Centre",
          "value": "center"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_image",
      "label": "Picture"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Picture that stays in view",
      "default": ""
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Picture description",
      "default": "",
      "info": "Read aloud to people who cannot see it."
    },
    {
      "type": "radio",
      "id": "media_side",
      "label": "Picture on",
      "default": "left",
      "options": [
        {
          "label": "Left",
          "value": "left"
        },
        {
          "label": "Right",
          "value": "right"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_layout",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "max_width",
      "label": "Content width",
      "default": "wide",
      "options": [
        {
          "label": "Narrow",
          "value": "narrow"
        },
        {
          "label": "Medium",
          "value": "medium"
        },
        {
          "label": "Wide",
          "value": "wide"
        },
        {
          "label": "Full",
          "value": "full"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_style",
      "label": "Style"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "white"
    },
    {
      "type": "header",
      "id": "hdr_spacing",
      "label": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "default": 96,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "default": 96,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "A step"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Say what happens here in a sentence or two."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Picture",
          "default": "",
          "info": "Optional, shown under the step."
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Picture description",
          "default": "",
          "info": "Read aloud to people who cannot see it."
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Sticky Story",
      "blocks": [
        {
          "id": "s1",
          "type": "step",
          "settings": {
            "title": "Where it starts"
          }
        },
        {
          "id": "s2",
          "type": "step",
          "settings": {
            "title": "What happens next"
          }
        },
        {
          "id": "s3",
          "type": "step",
          "settings": {
            "title": "What you get"
          }
        }
      ]
    }
  ]
}
</schema>
