{# ===========================================================================
   Team: the people behind the business, a portrait each with name, role,
   a line about them and a link. An empty portrait shows an outline in the
   builder and nothing on the site.
   =========================================================================== #}
<template>
<section class="s tg tg--{{ settings.shape }}" data-scheme="{{ settings.color_scheme }}" style="--s-bg: {{ scheme.bg }}; --s-text: {{ scheme.text }}; --s-heading: {{ scheme.heading }}; --s-para: {{ scheme.paragraph }}; --s-border: {{ scheme.border }}; --s-accent: {{ scheme.accent }}; --s-btn: {{ scheme.primary_btn_bg }}; --s-btn-text: {{ scheme.primary_btn_text }}; --s-btn2: {{ scheme.secondary_btn_bg }}; --s-btn2-text: {{ scheme.secondary_btn_text }}; --s-btn2-border: {{ scheme.secondary_btn_border }}; --s-btn-hover: {{ scheme.primary_btn_hover_bg }}; --s-btn-hover-text: {{ scheme.primary_btn_hover_text }}; --s-btn2-hover: {{ scheme.secondary_btn_hover_bg }}; --s-btn2-hover-text: {{ scheme.secondary_btn_hover_text }}; --s-radius: {{ theme.radius.medium }}px; --s-pt: {{ settings.padding_top }}px; --s-pb: {{ settings.padding_bottom }}px; --cols-d: {{ settings.columns.desktop }}; --cols-t: {{ settings.columns.tablet }}; --cols-m: {{ settings.columns.mobile }}; --tg-ratio: {{ settings.ratio }};">
  <div class="s__in s__in--{{ settings.max_width }}">
    {% if settings.eyebrow or settings.heading or settings.subheading %}
      <div class="s__head{% if settings.align == 'center' %} s__head--center{% endif %}">
        {% if settings.eyebrow %}<p class="s__eyebrow">{{ settings.eyebrow }}</p>{% endif %}
        {% if settings.heading %}<h2 class="s__h">{{ settings.heading }}</h2>{% endif %}
        {% if settings.subheading %}<p class="s__sub">{{ settings.subheading }}</p>{% endif %}
      </div>
    {% endif %}
    {% if blocks.size == 0 %}
      {% if page.in_editor %}<p class="tg__empty">Add people in the sidebar</p>{% endif %}
    {% else %}
      <ul class="tg__grid" role="list">
        {% for block in blocks %}
          <li class="tg__card" data-block-id="{{ block.id }}">
            {% if block.settings.photo %}
              <div class="tg__photo"><img src="{{ block.settings.photo | asset }}" alt="{{ block.settings.name }}" loading="lazy" decoding="async" data-media></div>
            {% elsif page.in_editor %}
              <div class="tg__photo"><div class="ph"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/></svg><span>Add a portrait</span></div></div>
            {% endif %}
            <h3 class="tg__name">{{ block.settings.name }}</h3>
            {% if block.settings.role %}<p class="tg__role">{{ block.settings.role }}</p>{% endif %}
            {% if block.settings.bio %}<p class="tg__bio">{{ block.settings.bio }}</p>{% endif %}
            {% if block.settings.link_text %}<a class="tg__link" href="{{ block.settings.link | default: '#' | url }}">{{ block.settings.link_text }}</a>{% endif %}
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>
</section>
</template>

<style scoped>
.s { container-type: inline-size; background: var(--s-bg); color: var(--s-text); }
.s__in {
  margin: 0 auto;
  padding: calc(var(--s-pt) * var(--theme-spacing-scale, 1)) var(--theme-padding-x, 24px) calc(var(--s-pb) * var(--theme-spacing-scale, 1));
}
.s__in--narrow { max-width: 720px; }
.s__in--medium { max-width: 960px; }
.s__in--wide { max-width: var(--theme-page-width, 1280px); }
.s__in--full { max-width: none; }
.s__eyebrow { margin: 0 0 14px; font-family: var(--sl-caption-font); font-size: var(--sl-caption-size, 12px); font-weight: var(--sl-caption-weight, 600); letter-spacing: var(--sl-caption-tracking, 0.14em); text-transform: var(--sl-caption-transform, uppercase); color: var(--s-accent); }
.s__h {
  margin: 0;
  font-size: var(--section-heading-size, 32px);
  line-height: var(--section-heading-line-height, 1.15);
  font-weight: var(--section-heading-weight, 700);
  color: var(--s-heading);
  letter-spacing: var(--section-heading-tracking, -0.01em);
  text-transform: var(--section-heading-transform, none);
  font-family: var(--section-heading-font, var(--theme-font-heading, {{ theme.typography.heading }}), ui-sans-serif, system-ui, sans-serif);
  text-wrap: balance;
}
.s__sub { margin: 16px 0 0; max-width: 38rem; font-size: var(--section-text-size, 17px); line-height: var(--section-text-line-height, 1.6); color: var(--s-para); text-wrap: pretty; }
.s__head { max-width: 46rem; }
.s__head--center { margin-inline: auto; text-align: center; }
.s__head--center .s__sub { margin-inline: auto; }
.s__btns { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
.s__head--center .s__btns { justify-content: center; }
.s__btn {
  display: inline-flex; align-items: center; justify-content: center; min-height: 44px;
  padding: var(--sl-button-padding, 13px 24px); font-size: var(--sl-button-size, 15px); line-height: var(--sl-button-line-height); font-weight: var(--theme-button-weight, 600); text-decoration: none;
  border-radius: var(--s-radius); border: 1px solid transparent; transition: background-color 180ms ease, color 180ms ease, border-color 180ms ease, transform 180ms ease;
}
.s__btn--primary:hover { background: var(--s-btn-hover); color: var(--s-btn-hover-text); border-color: var(--s-btn-hover); }
.s__btn--secondary:hover { background: var(--s-btn2-hover); color: var(--s-btn2-hover-text); }
.s__btn--primary { background: var(--s-btn); color: var(--s-btn-text); border-color: var(--s-btn); }
.s__btn--secondary { background: var(--s-btn2); color: var(--s-btn2-text); border-color: var(--s-btn2-border); }
.s__btn:focus-visible, .s a:focus-visible { outline: 2px solid var(--s-accent); outline-offset: 3px; }
.s__note { margin: 18px 0 0; font-size: 13px; color: var(--s-para); }
.ph { display: grid !important; place-content: center; justify-items: center; gap: 8px; width: 100%; height: 100%; min-height: 160px; box-sizing: border-box; border: 1px dashed var(--s-border); background: color-mix(in srgb, var(--s-text) 5%, transparent); color: var(--s-para); font-size: 13px; text-align: center; padding: 16px; }
.ph svg { width: 28px; height: 28px; fill: none; stroke: currentColor; stroke-width: 1.5; }

.tg .s__head { margin-bottom: 48px; }
.tg__empty { margin: 0; padding: 24px; border: 1px dashed var(--s-border); text-align: center; font-size: 13px; color: var(--s-para); }
.tg__grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 32px 16px; grid-template-columns: repeat(var(--cols-m), minmax(0, 1fr)); }
@container (min-width: 640px) { .tg__grid { grid-template-columns: repeat(var(--cols-t), minmax(0, 1fr)); } }
@container (min-width: 900px) { .tg__grid { grid-template-columns: repeat(var(--cols-d), minmax(0, 1fr)); gap: 56px 32px; } }
.tg__card { min-width: 0; }
.tg__photo { margin-bottom: 18px; overflow: hidden; aspect-ratio: var(--tg-ratio, 4 / 5); border-radius: var(--sl-image-radius, var(--s-radius)); }
.tg--round .tg__photo { border-radius: 24px; }
.tg--circle .tg__photo { border-radius: 50%; aspect-ratio: 1; max-width: 220px; }
.tg__photo img, .tg__photo .ph { display: block; width: 100%; height: 100%; min-height: 0; object-fit: cover; transition: transform 400ms cubic-bezier(.2,.7,.2,1); }
.tg__card:hover .tg__photo img { transform: scale(1.03); }
.tg__name { margin: 0; font-size: var(--type-h4-size, 18px); font-weight: var(--type-h4-weight, 600); color: var(--s-heading); font-family: var(--type-h3-font, var(--theme-font-heading)), ui-sans-serif, system-ui, sans-serif; }
.tg__role { margin: 4px 0 0; font-size: 14px; color: var(--s-accent); }
.tg__bio { margin: 10px 0 0; font-size: 15px; line-height: 1.6; color: var(--s-para); }
.tg__link { display: inline-block; margin-top: 10px; font-size: 14px; font-weight: 600; color: var(--s-heading); text-underline-offset: 4px; }
@media (prefers-reduced-motion: reduce) { .tg__photo img { transition: none; } .tg__card:hover .tg__photo img { transform: none; } }
</style>

<schema>
{
  "schema_version": 1,
  "type": "team_grid",
  "name": "Team",
  "category": "about",
  "description": "The people behind the business: a portrait each with name, role and a line about them.",
  "icon": "users",
  "settings": [
    {
      "type": "header",
      "id": "hdr_content",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": ""
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The people behind it"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Supporting line",
      "default": ""
    },
    {
      "type": "radio",
      "id": "align",
      "label": "Heading alignment",
      "default": "left",
      "options": [
        {
          "label": "Left",
          "value": "left"
        },
        {
          "label": "Centre",
          "value": "center"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_layout",
      "label": "Layout"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "default": {
        "desktop": 4,
        "tablet": 2,
        "mobile": 2
      },
      "min": 1,
      "max": 5,
      "step": 1,
      "responsive": true
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Portrait shape",
      "default": "4 / 5",
      "options": [
        {
          "label": "Portrait",
          "value": "4 / 5"
        },
        {
          "label": "Square",
          "value": "1"
        },
        {
          "label": "Tall",
          "value": "2 / 3"
        }
      ]
    },
    {
      "type": "select",
      "id": "shape",
      "label": "Corners",
      "default": "theme",
      "options": [
        {
          "label": "Theme",
          "value": "theme"
        },
        {
          "label": "Rounded",
          "value": "round"
        },
        {
          "label": "Circle",
          "value": "circle"
        }
      ]
    },
    {
      "type": "select",
      "id": "max_width",
      "label": "Content width",
      "default": "wide",
      "options": [
        {
          "label": "Narrow",
          "value": "narrow"
        },
        {
          "label": "Medium",
          "value": "medium"
        },
        {
          "label": "Wide",
          "value": "wide"
        },
        {
          "label": "Full",
          "value": "full"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_style",
      "label": "Style"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "white"
    },
    {
      "type": "header",
      "id": "hdr_spacing",
      "label": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "default": 88,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "default": 88,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "member",
      "name": "Person",
      "settings": [
        {
          "type": "image_picker",
          "id": "photo",
          "label": "Portrait",
          "default": ""
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Name"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Role",
          "default": "Role"
        },
        {
          "type": "textarea",
          "id": "bio",
          "label": "About them",
          "default": ""
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "Link wording",
          "default": ""
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "default": ""
        }
      ]
    }
  ],
  "max_blocks": 24,
  "presets": [
    {
      "name": "Team",
      "blocks": [
        {
          "id": "p1",
          "type": "member",
          "settings": {
            "name": "Team member name",
            "role": "Their role",
            "bio": "One line about what they do here."
          }
        },
        {
          "id": "p2",
          "type": "member",
          "settings": {
            "name": "Team member name",
            "role": "Their role",
            "bio": "One line about what they do here."
          }
        },
        {
          "id": "p3",
          "type": "member",
          "settings": {
            "name": "Team member name",
            "role": "Their role",
            "bio": "One line about what they do here."
          }
        },
        {
          "id": "p4",
          "type": "member",
          "settings": {
            "name": "Team member name",
            "role": "Their role",
            "bio": "One line about what they do here."
          }
        }
      ]
    }
  ]
}
</schema>
