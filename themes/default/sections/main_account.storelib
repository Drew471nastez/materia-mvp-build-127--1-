<template>
<section class="s" data-scheme="{{ settings.color_scheme }}" style="--s-bg: {{ scheme.bg }}; --s-text: {{ scheme.text }}; --s-heading: {{ scheme.heading }}; --s-para: {{ scheme.paragraph }}; --s-border: {{ scheme.border }}; --s-btn: {{ scheme.primary_btn_bg }}; --s-btn-text: {{ scheme.primary_btn_text }}; --s-btn2: {{ scheme.secondary_btn_bg }}; --s-btn2-text: {{ scheme.secondary_btn_text }}; --s-btn2-border: {{ scheme.secondary_btn_border }}; --s-btn-hover: {{ scheme.primary_btn_hover_bg }}; --s-btn-hover-text: {{ scheme.primary_btn_hover_text }}; --s-btn2-hover: {{ scheme.secondary_btn_hover_bg }}; --s-btn2-hover-text: {{ scheme.secondary_btn_hover_text }}; --s-radius: {{ theme.radius.medium }}px; --s-pt: {{ settings.padding_top }}px; --s-pb: {{ settings.padding_bottom }}px;">
  <div class="s__in acct">
    {% if customer %}
      {# Who is signed in, and the way out, on one line. The page is theirs,
         so it starts with them rather than with a word about accounts. #}
      <div class="acct__top">
        <div class="acct__who">
          <h1 class="s__h">{% if customer.first_name %}{{ settings.greeting }}, {{ customer.first_name }}{% else %}{{ settings.heading }}{% endif %}</h1>
          {% if customer.email %}<p class="acct__email">{{ customer.email }}</p>{% endif %}
        </div>
        <form class="acct__out" method="post" action="{{ routes.account_logout_url }}" data-storelib-form="native">
          <button class="acct__link" type="submit">{{ settings.signout_label }}</button>
        </form>
      </div>

      <h2 class="acct__h2">{{ settings.orders_heading }}</h2>
      {% if customer.orders.size == 0 %}
        <p class="acct__empty">{{ settings.orders_empty }} <a class="acct__inline" href="{{ routes.products_url }}">{{ settings.shop_link }}</a></p>
      {% else %}
        <ul class="orders">
          {% for order in customer.orders %}
          <li class="order">
            <div class="order__img">{% if order.image %}<img src="{{ order.image | asset }}" alt="" loading="lazy" decoding="async">{% endif %}</div>
            <div class="order__main">
              {% if order.url %}<a class="order__title" href="{{ order.url | url }}">{{ order.title }}</a>{% else %}<span class="order__title">{{ order.title }}</span>{% endif %}
              <p class="order__meta">{{ order.date }}{% if order.price %} · {{ order.price }}{% endif %}</p>
            </div>
            <a class="order__go" href="{{ order.action_url | url }}">{{ order.action_label }}</a>
          </li>
          {% endfor %}
        </ul>
        <p class="acct__note">{{ settings.library_note }}</p>
      {% endif %}

      {% if settings.show_wishlist %}
        <div class="acct__row">
          <h2 class="acct__h2">{{ settings.wishlist_heading }}</h2>
          {% if wishlist.count > 0 %}<a class="acct__inline" href="{{ routes.wishlist_url }}">{{ settings.wishlist_link }}</a>{% endif %}
        </div>
        {% if wishlist.count > 0 %}
          <div class="saved">
            {% for item in wishlist.items %}
              {% if forloop.index <= 4 %}
              <article class="card">
                <div class="card__media">{% if item.image %}<img src="{{ item.image | asset }}" alt="{{ item.title }}" loading="lazy" decoding="async">{% endif %}</div>
                <p class="card__title">{{ item.title }}</p>
                {% if item.price %}<p class="card__price">{{ item.price }}</p>{% endif %}
                {% if item.url %}<a class="card__link" href="{{ item.url | url }}"><span class="sr">{{ item.title }}</span></a>{% endif %}
              </article>
              {% endif %}
            {% endfor %}
          </div>
        {% else %}
          <p class="acct__empty">{{ settings.wishlist_empty }}</p>
        {% endif %}
      {% endif %}
    {% else %}
      {# Nobody signed in. The live page sends them to sign in before it gets
         here; this is what the page says if it is ever drawn without them. #}
      <h1 class="s__h">{{ settings.heading }}</h1>
      <p class="acct__empty">{{ settings.signed_out_text }}</p>
      <div class="acct__actions">
        <a class="s__btn s__btn--primary" href="{{ routes.account_signin_url }}">{{ settings.signin_label }}</a>
      </div>
    {% endif %}
  </div>
</section>
</template>

<style scoped>
.s { container-type: inline-size; background: var(--s-bg); color: var(--s-text); }
.s__in {
  margin: 0 auto;
  padding: calc(var(--s-pt) * var(--theme-spacing-scale, 1)) var(--theme-padding-x, 24px) calc(var(--s-pb) * var(--theme-spacing-scale, 1));
}
.acct { max-width: 860px; }
.s__h {
  margin: 0;
  font-size: var(--section-heading-size, 32px);
  line-height: var(--section-heading-line-height, 1.15);
  font-weight: var(--section-heading-weight, 700);
  color: var(--s-heading);
  letter-spacing: var(--section-heading-tracking, -0.01em);
  text-transform: var(--section-heading-transform, none);
  font-family: var(--theme-font-heading, {{ theme.typography.heading }}), ui-sans-serif, system-ui, sans-serif;
  overflow-wrap: anywhere;
}
.acct__top { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; }
.acct__who { min-width: 0; }
.acct__email { margin: 6px 0 0; font-size: 15px; color: var(--s-para); overflow-wrap: anywhere; }
.acct__out { margin: 6px 0 0; flex: none; }
.acct__link {
  padding: 8px 0; font: inherit; font-size: 15px; font-weight: 500; color: var(--s-heading);
  background: none; border: 0; cursor: pointer; text-decoration: underline; text-underline-offset: 4px;
}
.acct__h2 { margin: 48px 0 0; font-size: 19px; font-weight: 600; color: var(--s-heading); }
.acct__row { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; }
.acct__row .acct__h2 { margin-top: 48px; }
.acct__empty { margin: 12px 0 0; font-size: 15px; line-height: 1.6; color: var(--s-para); }
.acct__inline { color: var(--s-heading); font-weight: 500; text-decoration: underline; text-underline-offset: 4px; font-size: 15px; white-space: nowrap; }
.acct__note { margin: 14px 0 0; font-size: 13px; color: var(--s-para); }
.acct__actions { margin-top: 24px; max-width: 320px; }

.orders { list-style: none; margin: 16px 0 0; padding: 0; border-top: 1px solid var(--s-border); }
.order { display: flex; align-items: center; gap: 14px; padding: 14px 0; border-bottom: 1px solid var(--s-border); }
.order__img { flex: none; width: 56px; height: 56px; overflow: hidden; border-radius: calc(var(--s-radius) * 0.6); background: var(--s-border); }
.order__img img { display: block; width: 100%; height: 100%; object-fit: cover; }
.order__main { flex: 1 1 auto; min-width: 0; }
.order__title { display: block; font-size: 15px; font-weight: 600; color: var(--s-heading); text-decoration: none; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
a.order__title:hover { text-decoration: underline; text-underline-offset: 3px; }
.order__meta { margin: 4px 0 0; font-size: 13px; color: var(--s-para); }
.order__go {
  flex: none; padding: 9px 14px; font-size: 14px; font-weight: 600; text-decoration: none;
  color: var(--s-btn2-text); background: var(--s-btn2); border: 1px solid var(--s-btn2-border); border-radius: var(--s-radius);
  transition: background-color 150ms ease, color 150ms ease;
}
.order__go:hover { background: var(--s-btn2-hover); color: var(--s-btn2-hover-text); }

.saved { display: grid; gap: 16px; margin-top: 16px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
@container (min-width: 640px) { .saved { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
.card { position: relative; display: flex; flex-direction: column; }
.card__media { aspect-ratio: 1 / 1; overflow: hidden; border-radius: var(--s-radius); background: var(--s-border); }
.card__media img { display: block; width: 100%; height: 100%; object-fit: cover; }
.card__title { margin: 10px 0 0; font-size: 14px; font-weight: 600; color: var(--s-heading); }
.card__price { margin: 4px 0 0; font-size: 14px; color: var(--s-para); }
.card__link { position: absolute; inset: 0; }
.sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }

.s__btn {
  display: flex; align-items: center; justify-content: center; min-height: 48px;
  padding: 12px 24px; font-size: 15px; font-weight: 600; text-decoration: none;
  border-radius: var(--s-radius); border: 1px solid transparent; transition: background-color 150ms ease, color 150ms ease, border-color 150ms ease;
}
.s__btn--primary { background: var(--s-btn); color: var(--s-btn-text); border-color: var(--s-btn); }
.s__btn--secondary { background: var(--s-btn2); color: var(--s-btn2-text); border-color: var(--s-btn2-border); }
.s__btn:focus-visible, .order__go:focus-visible, .acct__link:focus-visible { outline: 2px solid var(--s-heading); outline-offset: 2px; }
/* Hover colours from the scheme, after the section's own Advanced colors. */
.s__btn--primary:hover { background: var(--s-btn-hover); color: var(--s-btn-hover-text); border-color: var(--s-btn-hover); }
.s__btn--secondary:hover { background: var(--s-btn2-hover); color: var(--s-btn2-hover-text); }
</style>

<schema>
{
  "schema_version": 1,
  "type": "main_account",
  "name": "Account",
  "category": "account",
  "description": "A signed-in visitor's page: their orders from you, their saved items and a way to sign out.",
  "version": "1.0.0",
  "icon": "user",
  "allowed_templates": ["page.account"],
  "settings": [
    { "type": "header", "id": "hdr_content", "label": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Account" },
    { "type": "text", "id": "greeting", "label": "Greeting", "default": "Hi", "info": "Shown before the visitor's first name." },
    { "type": "text", "id": "signout_label", "label": "Sign out link", "default": "Sign out" },
    { "type": "header", "id": "hdr_orders", "label": "Orders" },
    { "type": "text", "id": "orders_heading", "label": "Heading", "default": "Orders" },
    { "type": "text", "id": "orders_empty", "label": "When there are none", "default": "Nothing here yet." },
    { "type": "text", "id": "shop_link", "label": "Link to the shop", "default": "Browse the shop" },
    { "type": "text", "id": "library_note", "label": "Under the orders", "default": "Downloads open in your Storelib Library." },
    { "type": "header", "id": "hdr_saved", "label": "Saved items" },
    { "type": "toggle", "id": "show_wishlist", "label": "Show saved items", "default": true },
    { "type": "text", "id": "wishlist_heading", "label": "Heading", "default": "Saved" },
    { "type": "text", "id": "wishlist_link", "label": "Link to the Wishlist", "default": "See all" },
    { "type": "text", "id": "wishlist_empty", "label": "When there are none", "default": "Tap the heart on a product to keep it here." },
    { "type": "header", "id": "hdr_signed_out", "label": "Signed out" },
    { "type": "text", "id": "signed_out_text", "label": "Line", "default": "Sign in to see your orders and saved items." },
    { "type": "text", "id": "signin_label", "label": "Button", "default": "Sign in" },
    { "type": "header", "id": "hdr_style", "label": "Style" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "white" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "default": 64, "min": 0, "max": 160, "step": 4, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "default": 88, "min": 0, "max": 160, "step": 4, "unit": "px" }
  ],
  "presets": [
    { "name": "Account", "settings": {} }
  ]
}
</schema>
