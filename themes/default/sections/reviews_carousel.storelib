{# ===========================================================================
   Reviews carousel (Storelib Reviews)

   What buyers said, across every product, in a row that scrolls sideways:
   the featured reviews (Reviews › Feature), or when none is featured, the
   four and five star ones, the whole shop's or this page's, in the order
   and from the rating it is set to (review_scope and review_list,
   lib/reviews/widgets.ts).
   No script: the row is a scroll-snapping list. With Storelib Reviews off
   it draws nothing on a live page.
   =========================================================================== #}
<template>
{% if reviews.enabled %}
{% if reviews.all.items.size > 0 or page.in_editor %}
<div class="rw rw--{{ settings.show_on }} rw--{{ settings.star_style }}">
<section class="s rc" data-scheme="{{ settings.color_scheme }}" style="--s-bg: {{ scheme.bg }}; --s-text: {{ scheme.text }}; --s-heading: {{ scheme.heading }}; --s-para: {{ scheme.paragraph }}; --s-border: {{ scheme.border }}; --s-accent: {{ scheme.accent }}; --s-btn: {{ scheme.primary_btn_bg }}; --s-btn-text: {{ scheme.primary_btn_text }}; --s-btn-hover: {{ scheme.primary_btn_hover_bg }}; --s-btn-hover-text: {{ scheme.primary_btn_hover_text }}; --s-radius: {{ theme.radius.medium }}px; --s-pt: {{ settings.padding_top }}px; --s-pb: {{ settings.padding_bottom }}px; --rv-star: {{ settings.star_color | default: reviews.star_color }}; --rv-size: {{ settings.star_size }}px; --rc-card: {{ settings.card_background | default: scheme.bg }}; --rc-bw: {{ settings.border_width }}px;">
  <div class="s__in s__in--{{ settings.max_width }}">
    <div class="rc__head{% if settings.align == 'center' %} rc__head--center{% endif %}">
      <div>
        {% if settings.heading %}<h2 class="s__h">{{ settings.heading }}</h2>{% endif %}
        {% if settings.subheading %}<p class="rc__sub">{{ settings.subheading }}</p>{% endif %}
      </div>
      {% if settings.show_score and reviews.all.summary.count > 0 %}
        <p class="rc__score"><span class="rv-stars" style="--rv: {{ reviews.all.summary.percent }}%;" role="img" aria-label="{{ reviews.all.summary.average_label }} {{ words.out_of_five_stars }}"></span><b>{{ reviews.all.summary.average_label }}</b> {{ words.rating_from }} {{ reviews.all.summary.count }} {% if reviews.all.summary.count == 1 %}{{ words.review }}{% else %}{{ words.reviews }}{% endif %}{% if settings.show_all_link %} · <a class="rc__all" href="{{ reviews.page_url | url }}">{{ settings.all_link_label }}</a>{% endif %}</p>
      {% endif %}
    </div>
    {% if page.in_editor and reviews.sample %}<p class="rv__sample">Sample reviews. Your real reviews show here once you have some.</p>{% endif %}
    <div class="rc__track" role="list">
      {% for sc in reviews | review_scope: settings.scope %}{% if settings.source == 'recent' %}{% for r in sc.items | review_list: settings.sort, settings.min_rating limit: settings.count %}<article class="rc__card" role="listitem" data-review-id="{{ r.id }}"><div class="rc__top"><span class="rv-stars" style="--rv: {{ r.rating | times: 20 }}%;" role="img" aria-label="{{ r.rating }} {{ words.out_of_five_stars }}"></span>{% if settings.show_date and reviews.show_date %}<span class="rc__date">{{ r.date }}</span>{% endif %}</div>{% if settings.show_title and r.title %}<h3 class="rc__title">{{ r.title }}</h3>{% endif %}<p class="rc__body">{{ r.body }}</p><p class="rc__foot"><span class="rc__name">{{ r.author }}</span>{% if settings.show_verified and reviews.show_verified and r.verified %}<span class="rc__ver">{{ words.verified_buyer }}</span>{% endif %}{% if settings.show_product and r.product_title %}{% if r.product_url %}<a class="rc__prod" href="{{ r.product_url | url }}">{{ r.product_title }}</a>{% else %}<span class="rc__prod">{{ r.product_title }}</span>{% endif %}{% endif %}</p></article>{% endfor %}{% else %}{% for r in sc.featured_items | review_list: settings.sort, settings.min_rating limit: settings.count %}<article class="rc__card" role="listitem" data-review-id="{{ r.id }}"><div class="rc__top"><span class="rv-stars" style="--rv: {{ r.rating | times: 20 }}%;" role="img" aria-label="{{ r.rating }} {{ words.out_of_five_stars }}"></span>{% if settings.show_date and reviews.show_date %}<span class="rc__date">{{ r.date }}</span>{% endif %}</div>{% if settings.show_title and r.title %}<h3 class="rc__title">{{ r.title }}</h3>{% endif %}<p class="rc__body">{{ r.body }}</p><p class="rc__foot"><span class="rc__name">{{ r.author }}</span>{% if settings.show_verified and reviews.show_verified and r.verified %}<span class="rc__ver">{{ words.verified_buyer }}</span>{% endif %}{% if settings.show_product and r.product_title %}{% if r.product_url %}<a class="rc__prod" href="{{ r.product_url | url }}">{{ r.product_title }}</a>{% else %}<span class="rc__prod">{{ r.product_title }}</span>{% endif %}{% endif %}</p></article>{% endfor %}{% endif %}{% endfor %}
    </div>
  </div>
</section>
{% if page.in_editor %}<p class="rw__off rw__off--desktop">Shown on computers only. Switch the preview to a computer to see it.</p><p class="rw__off rw__off--mobile">Shown on phones only. Switch the preview to a phone to see it.</p>{% endif %}
</div>
{% endif %}
{% endif %}
</template>

<style scoped>
.rw { container-type: inline-size; }
@container (max-width: 749px) { .rw--desktop > .s { display: none; } }
@container (min-width: 750px) { .rw--mobile > .s { display: none; } }
.rw__off { display: none; margin: 0; padding: 14px 16px; border: 1px dashed currentColor; opacity: 0.55; font-size: 13px; line-height: 1.4; text-align: center; }
@container (max-width: 749px) { .rw--desktop > .rw__off--desktop { display: block; } }
@container (min-width: 750px) { .rw--mobile > .rw__off--mobile { display: block; } }
.s { container-type: inline-size; background: var(--s-bg); color: var(--s-text); }
.s__in { margin: 0 auto; padding: calc(var(--s-pt) * var(--theme-spacing-scale, 1)) var(--theme-padding-x, 24px) calc(var(--s-pb) * var(--theme-spacing-scale, 1)); }
.s__in--narrow { max-width: 720px; }
.s__in--medium { max-width: 960px; }
.s__in--wide { max-width: var(--theme-page-width, 1280px); }
.s__in--full { max-width: none; }
.s__h {
  margin: 0;
  font-size: var(--section-heading-size, 32px);
  line-height: var(--section-heading-line-height, 1.15);
  font-weight: var(--section-heading-weight, 700);
  color: var(--s-heading);
  letter-spacing: var(--section-heading-tracking, -0.01em);
  text-transform: var(--section-heading-transform, none);
  font-family: var(--section-heading-font, var(--theme-font-heading, {{ theme.typography.heading }}), ui-sans-serif, system-ui, sans-serif);
}
.rc__head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 12px 24px; margin-bottom: 28px; }
.rc__head--center { flex-direction: column; align-items: center; text-align: center; }
.rc__sub { margin: 10px 0 0; font-size: var(--section-text-size, 17px); line-height: 1.6; color: var(--s-para); }
.rc__score { display: flex; align-items: center; gap: 10px; font-size: 14px; color: var(--s-para); }
.rc__score b { font-size: 18px; color: var(--s-heading); font-variant-numeric: tabular-nums; }
.rc__all { font-size: 14px; font-weight: 600; color: var(--s-heading); text-decoration: underline; text-underline-offset: 3px; }
.rv__sample { margin: -16px 0 20px; font-size: 13px; color: var(--s-para); opacity: 0.7; }
.rv-stars { --rv-g: "\2605\2605\2605\2605\2605"; position: relative; display: inline-block; font-size: var(--rv-size, 15px); line-height: 1; letter-spacing: 2px; color: color-mix(in srgb, var(--s-para) 22%, transparent); }
.rv-stars::before { content: var(--rv-g); }
.rv-stars::after { content: var(--rv-g); position: absolute; inset: 0 auto 0 0; width: var(--rv, 0%); overflow: hidden; white-space: nowrap; color: var(--rv-star, var(--s-accent)); }
.rc__track { display: grid; grid-auto-flow: column; grid-auto-columns: min(86%, 340px); gap: 16px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: 2px; padding: 2px 2px 14px; margin: 0 -2px; scrollbar-width: thin; }
@container (min-width: 900px) { .rc__track { grid-auto-columns: calc((100% - 32px) / 3); } }
.rc__card { scroll-snap-align: start; display: flex; flex-direction: column; min-width: 0; padding: 22px; border: var(--rc-bw, 1px) solid var(--s-border); border-radius: var(--s-radius); background: var(--rc-card, var(--s-bg)); }
.rc__top { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.rc__date { font-size: 13px; color: var(--s-para); }
.rc__title { margin: 14px 0 0; font-size: 16px; font-weight: 600; color: var(--s-heading); overflow-wrap: anywhere; }
.rc__body { margin: 8px 0 0; font-size: 15px; line-height: 1.6; color: var(--s-para); overflow-wrap: anywhere; display: -webkit-box; -webkit-line-clamp: 6; -webkit-box-orient: vertical; overflow: hidden; }
.rc__foot { margin-top: auto; padding-top: 16px; display: flex; flex-direction: column; gap: 4px; font-size: 13px; color: var(--s-para); }
.rc__name { font-weight: 600; color: var(--s-heading); }
.rc__ver::before { content: "\2713  "; font-weight: 700; color: var(--s-heading); }
.rc__prod { color: var(--s-para); text-decoration: none; }
.rc__prod:hover { text-decoration: underline; text-underline-offset: 3px; }
.rw--outline .rv-stars { color: transparent; -webkit-text-stroke: 1px var(--rv-star, var(--s-accent)); }
.rw--outline .rv-stars::after { -webkit-text-stroke: 0; }
.rw--heart .rv-stars { --rv-g: "\2665\2665\2665\2665\2665"; }
</style>

<schema>
{
  "schema_version": 1,
  "type": "reviews_carousel",
  "name": "Reviews carousel",
  "category": "reviews",
  "description": "Storelib Reviews: what buyers said, in a row that scrolls.",
  "version": "1.0.0",
  "icon": "star",
  "settings": [
    { "type": "header", "id": "hdr_content", "label": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What buyers say" },
    { "type": "textarea", "id": "subheading", "label": "Supporting line", "default": "" },
    { "type": "radio", "id": "align", "label": "Heading sits", "default": "left", "options": [{ "label": "Left", "value": "left" }, { "label": "Centre", "value": "center" }] },
    { "type": "select", "id": "source", "label": "Reviews", "default": "featured", "options": [{ "label": "Featured, or four and five stars", "value": "featured" }, { "label": "All of them", "value": "recent" }] },
    { "type": "select", "id": "scope", "label": "Whose reviews", "default": "all", "options": [{ "label": "This page: the product's on a product page", "value": "here" }, { "label": "The whole shop", "value": "all" }] },
    { "type": "select", "id": "sort", "label": "Order", "default": "app", "options": [{ "label": "As set in Storelib Reviews", "value": "app" }, { "label": "Featured first", "value": "featured" }, { "label": "Newest", "value": "newest" }, { "label": "Highest rated", "value": "highest" }, { "label": "Lowest rated", "value": "lowest" }, { "label": "With photos first", "value": "photos" }] },
    { "type": "range", "id": "min_rating", "label": "Lowest rating shown", "default": 1, "min": 1, "max": 5, "step": 1 },
    { "type": "range", "id": "count", "label": "How many", "default": 8, "min": 2, "max": 24, "step": 1 },
    { "type": "toggle", "id": "show_score", "label": "Show the shop's rating", "default": true },
    { "type": "toggle", "id": "show_all_link", "label": "Link to all reviews", "default": true },
    { "type": "text", "id": "all_link_label", "label": "Link label", "default": "Read all reviews" },
    { "type": "header", "id": "hdr_shown", "label": "Shown on each review" },
    { "type": "toggle", "id": "show_title", "label": "Title", "default": true },
    { "type": "toggle", "id": "show_date", "label": "Date", "default": false },
    { "type": "toggle", "id": "show_verified", "label": "Verified buyer", "default": true },
    { "type": "toggle", "id": "show_product", "label": "Product", "default": true },
    { "type": "select", "id": "max_width", "label": "Content width", "default": "wide", "options": [{ "label": "Narrow", "value": "narrow" }, { "label": "Medium", "value": "medium" }, { "label": "Wide", "value": "wide" }, { "label": "Full", "value": "full" }] },
    { "type": "header", "id": "hdr_style", "label": "Style" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "white" },
    { "type": "color", "id": "star_color", "label": "Star colour", "default": "", "info": "Empty uses the colour set in Storelib Reviews." },
    { "type": "range", "id": "star_size", "label": "Star size", "default": 15, "min": 10, "max": 32, "step": 1, "unit": "px" },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "", "info": "Empty uses the colour scheme." },
    { "type": "range", "id": "border_width", "label": "Border width", "default": 1, "min": 0, "max": 4, "step": 1, "unit": "px" },
    { "type": "select", "id": "star_style", "label": "Stars", "default": "solid", "options": [{ "label": "Solid", "value": "solid" }, { "label": "Outline", "value": "outline" }, { "label": "Hearts", "value": "heart" }] },
    { "type": "header", "id": "hdr_visibility", "label": "Visibility" },
    { "type": "select", "id": "show_on", "label": "Show on", "default": "all", "options": [{ "label": "Phones and computers", "value": "all" }, { "label": "Computers only", "value": "desktop" }, { "label": "Phones only", "value": "mobile" }] },
    { "type": "header", "id": "hdr_spacing", "label": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "default": 64, "min": 0, "max": 160, "step": 4, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "default": 64, "min": 0, "max": 160, "step": 4, "unit": "px" }
  ],
  "presets": [{ "name": "Reviews carousel", "settings": {} }]
}
</schema>
