{# ===========================================================================
   Blog posts: the newest, featured or one category's, on any page

   Shopify's Featured blog section. The posts are the creator's live ones,
   read from the Blog manager (Website Settings › Blog): `blog.recent` is
   the newest, each with `featured` set when the creator marked it, and
   `blog.featured` the ones the creator marked featured (the newest while
   none is), and `blog.categories` each category with a live post and its
   newest posts. A post is never typed into a setting; the section says
   which posts and how many.

   The same card is drawn for each of the three sources, so each source has
   its own loop over the same markup.
   =========================================================================== #}
<template>
<section class="s" data-scheme="{{ settings.color_scheme }}" style="--s-bg: {{ scheme.bg }}; --s-text: {{ scheme.text }}; --s-heading: {{ scheme.heading }}; --s-para: {{ scheme.paragraph }}; --s-border: {{ scheme.border }}; --s-accent: {{ scheme.accent }}; --s-btn2: {{ scheme.secondary_btn_bg }}; --s-btn2-text: {{ scheme.secondary_btn_text }}; --s-btn2-border: {{ scheme.secondary_btn_border }}; --s-btn2-hover: {{ scheme.secondary_btn_hover_bg }}; --s-btn2-hover-text: {{ scheme.secondary_btn_hover_text }}; --s-radius: {{ theme.radius.medium }}px; --s-pt: {{ settings.padding_top }}px; --s-pb: {{ settings.padding_bottom }}px; --cols-d: {{ settings.columns.desktop }}; --cols-t: {{ settings.columns.tablet }}; --cols-m: {{ settings.columns.mobile }}; --ratio: {{ settings.image_ratio }};">
  <div class="s__in">
    {% if blog and blog.recent.size > 0 %}
      {% if settings.heading or settings.subheading %}
        <div class="s__head {% if settings.align == 'center' %}s__head--center{% endif %}">
          {% if settings.heading %}<h2 class="s__h">{{ settings.heading }}</h2>{% endif %}
          {% if settings.subheading %}<p class="s__sub">{{ settings.subheading }}</p>{% endif %}
        </div>
      {% endif %}
      <div class="posts posts--{{ settings.layout }}">
        {% if settings.source == 'category' %}
          {% for c in blog.categories %}{% if c.url == settings.category_url or settings.category_url contains c.url %}
            {% for post in c.posts limit: settings.post_count %}
            <article class="post">
              {% if settings.show_image %}<a class="post__media" href="{{ post.url | url }}" tabindex="-1" aria-hidden="true">{% if post.image %}<img src="{{ post.image | asset }}" alt="" loading="lazy" decoding="async">{% else %}<span class="post__blank">{{ post.title | first | upcase }}</span>{% endif %}</a>{% endif %}
              <div class="post__body">
                {% if settings.show_category and post.category %}<a class="post__cat" href="{{ post.category.url | url }}">{{ post.category.name }}</a>{% endif %}
                <h3 class="post__title"><a href="{{ post.url | url }}">{{ post.title }}</a></h3>
                {% if settings.show_excerpt and post.excerpt %}<p class="post__excerpt">{{ post.excerpt }}</p>{% endif %}
                {% if settings.show_date or settings.show_author and post.author %}<p class="post__meta">{% if settings.show_author and post.author %}<span>{{ post.author.name }}</span>{% endif %}{% if settings.show_date %}<time datetime="{{ post.published_at }}">{{ post.date }}</time>{% endif %}</p>{% endif %}
              </div>
            </article>
            {% endfor %}
          {% endif %}{% endfor %}
        {% elsif settings.source == 'featured' and blog.featured.size > 0 %}
          {% for post in blog.featured limit: settings.post_count %}
            <article class="post">
              {% if settings.show_image %}<a class="post__media" href="{{ post.url | url }}" tabindex="-1" aria-hidden="true">{% if post.image %}<img src="{{ post.image | asset }}" alt="" loading="lazy" decoding="async">{% else %}<span class="post__blank">{{ post.title | first | upcase }}</span>{% endif %}</a>{% endif %}
              <div class="post__body">
                {% if settings.show_category and post.category %}<a class="post__cat" href="{{ post.category.url | url }}">{{ post.category.name }}</a>{% endif %}
                <h3 class="post__title"><a href="{{ post.url | url }}">{{ post.title }}</a></h3>
                {% if settings.show_excerpt and post.excerpt %}<p class="post__excerpt">{{ post.excerpt }}</p>{% endif %}
                {% if settings.show_date or settings.show_author and post.author %}<p class="post__meta">{% if settings.show_author and post.author %}<span>{{ post.author.name }}</span>{% endif %}{% if settings.show_date %}<time datetime="{{ post.published_at }}">{{ post.date }}</time>{% endif %}</p>{% endif %}
              </div>
            </article>
          {% endfor %}
        {% else %}
          {% for post in blog.recent limit: settings.post_count %}
            <article class="post">
              {% if settings.show_image %}<a class="post__media" href="{{ post.url | url }}" tabindex="-1" aria-hidden="true">{% if post.image %}<img src="{{ post.image | asset }}" alt="" loading="lazy" decoding="async">{% else %}<span class="post__blank">{{ post.title | first | upcase }}</span>{% endif %}</a>{% endif %}
              <div class="post__body">
                {% if settings.show_category and post.category %}<a class="post__cat" href="{{ post.category.url | url }}">{{ post.category.name }}</a>{% endif %}
                <h3 class="post__title"><a href="{{ post.url | url }}">{{ post.title }}</a></h3>
                {% if settings.show_excerpt and post.excerpt %}<p class="post__excerpt">{{ post.excerpt }}</p>{% endif %}
                {% if settings.show_date or settings.show_author and post.author %}<p class="post__meta">{% if settings.show_author and post.author %}<span>{{ post.author.name }}</span>{% endif %}{% if settings.show_date %}<time datetime="{{ post.published_at }}">{{ post.date }}</time>{% endif %}</p>{% endif %}
              </div>
            </article>
          {% endfor %}
        {% endif %}
      </div>
      {% if settings.button_text %}
        <div class="more {% if settings.align == 'center' %}more--center{% endif %}"><a class="s__btn" href="{{ blog.url | url }}">{{ settings.button_text }}</a></div>
      {% endif %}
    {% elsif page.in_editor %}
      <p class="empty">Your blog's newest posts appear here once one is published in Website Settings, Blog.</p>
    {% endif %}
  </div>
</section>
</template>

<style scoped>
.s { container-type: inline-size; background: var(--s-bg); color: var(--s-text); }
.s__in {
  max-width: var(--theme-page-width, 1280px);
  margin: 0 auto;
  padding: calc(var(--s-pt) * var(--theme-spacing-scale, 1)) var(--theme-padding-x, 24px) calc(var(--s-pb) * var(--theme-spacing-scale, 1));
}
.s__head { max-width: 44rem; margin-bottom: 36px; }
.s__head--center { margin-inline: auto; text-align: center; }
.s__h {
  margin: 0;
  font-size: var(--section-heading-size, 32px);
  line-height: var(--section-heading-line-height, 1.15);
  font-weight: var(--section-heading-weight, 700);
  color: var(--s-heading);
  letter-spacing: var(--section-heading-tracking, -0.01em);
  text-transform: var(--section-heading-transform, none);
  font-family: var(--section-heading-font, var(--theme-font-heading, {{ theme.typography.heading }}), ui-sans-serif, system-ui, sans-serif);
}
.s__sub { margin: 12px 0 0; font-size: var(--section-text-size, 17px); line-height: var(--section-text-line-height, 1.6); color: var(--s-para); }
.posts { display: grid; gap: 36px 24px; }
.posts--grid { grid-template-columns: repeat(var(--cols-m), minmax(0, 1fr)); }
@container (min-width: 640px) { .posts--grid { grid-template-columns: repeat(var(--cols-t), minmax(0, 1fr)); } }
@container (min-width: 900px) { .posts--grid { grid-template-columns: repeat(var(--cols-d), minmax(0, 1fr)); } }
.posts--list { grid-template-columns: minmax(0, 1fr); gap: 24px; max-width: 56rem; }
.s__head--center + .posts--list { margin-inline: auto; }
.post { position: relative; display: flex; flex-direction: column; min-width: 0; }
.post__media { display: block; overflow: hidden; aspect-ratio: var(--ratio); border-radius: var(--sl-image-radius, var(--s-radius)); background: var(--s-border); }
.post__media img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 400ms cubic-bezier(0.22, 1, 0.36, 1); }
.post:hover .post__media img { transform: scale(1.03); }
.post__blank { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; font-size: 40px; font-weight: 700; color: var(--s-para); opacity: 0.35; }
.post__body { display: flex; flex-direction: column; gap: 8px; padding-top: 14px; min-width: 0; }
.post__cat { align-self: flex-start; font-size: 12px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--s-accent, var(--s-heading)); text-decoration: none; }
.post__title { margin: 0; font-size: 18px; line-height: 1.35; font-weight: 650; color: var(--s-heading); overflow-wrap: anywhere; }
.post__title a { color: inherit; text-decoration: none; }
.post__title a:hover { text-decoration: underline; text-underline-offset: 3px; }
.post__title a:focus-visible, .post__cat:focus-visible, .s__btn:focus-visible { outline: 2px solid var(--s-heading); outline-offset: 3px; border-radius: 4px; }
.post__excerpt { margin: 0; font-size: 15px; line-height: 1.6; color: var(--s-para); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
.post__meta { display: flex; flex-wrap: wrap; gap: 4px 8px; margin: 2px 0 0; font-size: 13px; color: var(--s-para); }
.post__meta > * + *::before { content: "·"; margin-right: 8px; opacity: 0.6; }
@container (min-width: 640px) {
  .posts--list .post { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); gap: 24px; align-items: center; }
  .posts--list .post__body { padding-top: 0; }
  .posts--list .post__title { font-size: 21px; }
}
.more { display: flex; margin-top: 36px; }
.more--center { justify-content: center; }
.s__btn {
  display: inline-flex; align-items: center; justify-content: center;
  padding: var(--sl-button-padding, 13px 24px); font-size: var(--sl-button-size, 15px); line-height: var(--sl-button-line-height); font-weight: var(--theme-button-weight, 600); text-decoration: none;
  border-radius: var(--s-radius); border: 1px solid var(--s-btn2-border);
  background: var(--s-btn2); color: var(--s-btn2-text);
  transition: background-color 150ms ease, color 150ms ease;
}
.s__btn:hover { background: var(--s-btn2-hover); color: var(--s-btn2-hover-text); }
.empty { margin: 0; text-align: center; font-size: 14px; color: var(--s-para); opacity: 0.6; }
@media (prefers-reduced-motion: reduce) { .post__media img { transition: none; } .post:hover .post__media img { transform: none; } }
</style>

<schema>
{
  "schema_version": 1,
  "type": "blog_featured",
  "name": "Blog posts",
  "category": "blog",
  "description": "Your blog's newest posts, the ones you marked featured, or one category's, as cards with a link to the blog.",
  "version": "1.0.0",
  "icon": "file-text",
  "settings": [
    {
      "type": "select",
      "id": "source",
      "label": "Posts",
      "default": "latest",
      "options": [
        { "label": "The newest", "value": "latest" },
        { "label": "The ones marked featured", "value": "featured" },
        { "label": "One category's", "value": "category" }
      ]
    },
    { "type": "url", "id": "category_url", "label": "Category", "default": "", "info": "Pick the category in the link picker, under Pages, or paste its address.", "visible_if": "{{ section.settings.source == 'category' }}" },
    { "type": "range", "id": "post_count", "label": "How many", "min": 1, "max": 12, "step": 1, "default": 3 },
    { "type": "header", "id": "hdr_content", "label": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From the blog" },
    { "type": "textarea", "id": "subheading", "label": "Supporting line", "default": "" },
    {
      "type": "radio",
      "id": "align",
      "label": "Heading sits",
      "default": "left",
      "options": [
        { "label": "Left", "value": "left" },
        { "label": "Centre", "value": "center" }
      ]
    },
    { "type": "text", "id": "button_text", "label": "Button under the posts", "default": "Read the blog" },
    { "type": "header", "id": "hdr_cards", "label": "Cards" },
    {
      "type": "radio",
      "id": "layout",
      "label": "Layout",
      "default": "grid",
      "options": [
        { "label": "Grid", "value": "grid" },
        { "label": "List", "value": "list" }
      ]
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "default": { "desktop": 3, "tablet": 2, "mobile": 1 },
      "min": 1,
      "max": 4,
      "step": 1,
      "responsive": true,
      "visible_if": "{{ section.settings.layout == 'grid' }}"
    },
    { "type": "toggle", "id": "show_image", "label": "Show the cover picture", "default": true },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Picture shape",
      "default": "16 / 10",
      "options": [
        { "label": "Wide", "value": "16 / 9" },
        { "label": "Landscape", "value": "16 / 10" },
        { "label": "Classic", "value": "4 / 3" },
        { "label": "Square", "value": "1 / 1" }
      ],
      "visible_if": "{{ section.settings.show_image }}"
    },
    { "type": "toggle", "id": "show_category", "label": "Show its category", "default": true },
    { "type": "toggle", "id": "show_excerpt", "label": "Show its excerpt", "default": true },
    { "type": "toggle", "id": "show_author", "label": "Show its author", "default": false },
    { "type": "toggle", "id": "show_date", "label": "Show its date", "default": true },
    { "type": "header", "id": "hdr_style", "label": "Style" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "white" },
    { "type": "header", "id": "hdr_spacing", "label": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 72 }
  ],
  "presets": [
    { "name": "Blog posts", "settings": { "heading": "From the blog" } }
  ]
}
</schema>
