        {
          "label": "None",
          "value": "none"
        },
        {
          "label": "Zoom",
          "value": "zoom"
        },
        {
          "label": "Lightbox",
          "value": "lightbox"
        }
      ]
    },
    {
      "id": "image_hover_action",
      "label": "Image hover action",
      "type": "select",
      "default": "none",
      "options": [
        {
          "label": "None",
          "value": "none"
        },
        {
          "label": "Zoom",
          "value": "zoom"
        }
      ]
    },
