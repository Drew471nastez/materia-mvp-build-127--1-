      "type": "color",
      "default": "#0f172a"
    },
    {
      "id": "padding_top",
      "label": "Padding top",
      "type": "range",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "id": "padding_bottom",
      "label": "Padding bottom",
      "type": "range",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
