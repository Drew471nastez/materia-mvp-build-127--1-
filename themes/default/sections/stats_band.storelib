{# ===========================================================================
   Stats band: a few numbers that are true, big, in the heading font, with
   what each one counts beneath. Beside a heading or under it.
   =========================================================================== #}
<template>
<section class="s st st--{{ settings.layout }}{% if settings.dividers %} st--lines{% endif %}" data-scheme="{{ settings.color_scheme }}" style="--s-bg: {{ scheme.bg }}; --s-text: {{ scheme.text }}; --s-heading: {{ scheme.heading }}; --s-para: {{ scheme.paragraph }}; --s-border: {{ scheme.border }}; --s-accent: {{ scheme.accent }}; --s-btn: {{ scheme.primary_btn_bg }}; --s-btn-text: {{ scheme.primary_btn_text }}; --s-btn2: {{ scheme.secondary_btn_bg }}; --s-btn2-text: {{ scheme.secondary_btn_text }}; --s-btn2-border: {{ scheme.secondary_btn_border }}; --s-btn-hover: {{ scheme.primary_btn_hover_bg }}; --s-btn-hover-text: {{ scheme.primary_btn_hover_text }}; --s-btn2-hover: {{ scheme.secondary_btn_hover_bg }}; --s-btn2-hover-text: {{ scheme.secondary_btn_hover_text }}; --s-radius: {{ theme.radius.medium }}px; --s-pt: {{ settings.padding_top }}px; --s-pb: {{ settings.padding_bottom }}px; --cols-d: {{ settings.columns.desktop }}; --cols-t: {{ settings.columns.tablet }}; --cols-m: {{ settings.columns.mobile }};">
  <div class="s__in s__in--{{ settings.max_width }}">
    <div class="st__wrap">
      {% if settings.eyebrow or settings.heading or settings.subheading %}
      <div class="s__head{% if settings.align == 'center' %} s__head--center{% endif %}">
        {% if settings.eyebrow %}<p class="s__eyebrow">{{ settings.eyebrow }}</p>{% endif %}
        {% if settings.heading %}<h2 class="s__h">{{ settings.heading }}</h2>{% endif %}
        {% if settings.subheading %}<p class="s__sub">{{ settings.subheading }}</p>{% endif %}
      </div>
    {% endif %}
      {% if blocks.size == 0 %}
        {% if page.in_editor %}<p class="st__empty">Add numbers in the sidebar</p>{% endif %}
      {% else %}
        <dl class="st__grid">
          {% for block in blocks %}
            <div class="st__item" data-block-id="{{ block.id }}">
              <dt class="st__label">{{ block.settings.label }}</dt>
              <dd class="st__value">{{ block.settings.value }}</dd>
              {% if block.settings.note %}<dd class="st__note">{{ block.settings.note }}</dd>{% endif %}
            </div>
          {% endfor %}
        </dl>
      {% endif %}
    </div>
  </div>
</section>
</template>

<style scoped>
.s { container-type: inline-size; background: var(--s-bg); color: var(--s-text); }
.s__in {
  margin: 0 auto;
  padding: calc(var(--s-pt) * var(--theme-spacing-scale, 1)) var(--theme-padding-x, 24px) calc(var(--s-pb) * var(--theme-spacing-scale, 1));
}
.s__in--narrow { max-width: 720px; }
.s__in--medium { max-width: 960px; }
.s__in--wide { max-width: var(--theme-page-width, 1280px); }
.s__in--full { max-width: none; }
.s__eyebrow { margin: 0 0 14px; font-family: var(--sl-caption-font); font-size: var(--sl-caption-size, 12px); font-weight: var(--sl-caption-weight, 600); letter-spacing: var(--sl-caption-tracking, 0.14em); text-transform: var(--sl-caption-transform, uppercase); color: var(--s-accent); }
.s__h {
  margin: 0;
  font-size: var(--section-heading-size, 32px);
  line-height: var(--section-heading-line-height, 1.15);
  font-weight: var(--section-heading-weight, 700);
  color: var(--s-heading);
  letter-spacing: var(--section-heading-tracking, -0.01em);
  text-transform: var(--section-heading-transform, none);
  font-family: var(--section-heading-font, var(--theme-font-heading, {{ theme.typography.heading }}), ui-sans-serif, system-ui, sans-serif);
  text-wrap: balance;
}
.s__sub { margin: 16px 0 0; max-width: 38rem; font-size: var(--section-text-size, 17px); line-height: var(--section-text-line-height, 1.6); color: var(--s-para); text-wrap: pretty; }
.s__head { max-width: 46rem; }
.s__head--center { margin-inline: auto; text-align: center; }
.s__head--center .s__sub { margin-inline: auto; }
.s__btns { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
.s__head--center .s__btns { justify-content: center; }
.s__btn {
  display: inline-flex; align-items: center; justify-content: center; min-height: 44px;
  padding: var(--sl-button-padding, 13px 24px); font-size: var(--sl-button-size, 15px); line-height: var(--sl-button-line-height); font-weight: var(--theme-button-weight, 600); text-decoration: none;
  border-radius: var(--s-radius); border: 1px solid transparent; transition: background-color 180ms ease, color 180ms ease, border-color 180ms ease, transform 180ms ease;
}
.s__btn--primary:hover { background: var(--s-btn-hover); color: var(--s-btn-hover-text); border-color: var(--s-btn-hover); }
.s__btn--secondary:hover { background: var(--s-btn2-hover); color: var(--s-btn2-hover-text); }
.s__btn--primary { background: var(--s-btn); color: var(--s-btn-text); border-color: var(--s-btn); }
.s__btn--secondary { background: var(--s-btn2); color: var(--s-btn2-text); border-color: var(--s-btn2-border); }
.s__btn:focus-visible, .s a:focus-visible { outline: 2px solid var(--s-accent); outline-offset: 3px; }
.s__note { margin: 18px 0 0; font-size: 13px; color: var(--s-para); }
.ph { display: grid !important; place-content: center; justify-items: center; gap: 8px; width: 100%; height: 100%; min-height: 160px; box-sizing: border-box; border: 1px dashed var(--s-border); background: color-mix(in srgb, var(--s-text) 5%, transparent); color: var(--s-para); font-size: 13px; text-align: center; padding: 16px; }
.ph svg { width: 28px; height: 28px; fill: none; stroke: currentColor; stroke-width: 1.5; }

.st__wrap { display: grid; gap: 48px; }
@container (min-width: 900px) { .st--split .st__wrap { grid-template-columns: 4fr 8fr; gap: 64px; align-items: start; } }
.st__empty { margin: 0; padding: 24px; border: 1px dashed var(--s-border); text-align: center; font-size: 13px; color: var(--s-para); }
.st__grid { display: grid; gap: 40px 32px; margin: 0; grid-template-columns: repeat(var(--cols-m), minmax(0, 1fr)); }
@container (min-width: 640px) { .st__grid { grid-template-columns: repeat(var(--cols-t), minmax(0, 1fr)); } }
@container (min-width: 900px) { .st__grid { grid-template-columns: repeat(var(--cols-d), minmax(0, 1fr)); } }
.st__item { display: flex; flex-direction: column; min-width: 0; }
.st--lines .st__item { padding-top: 20px; border-top: 1px solid var(--s-border); }
.st__value { order: 1; margin: 0; color: var(--s-heading); font-family: var(--type-h1-font, var(--theme-font-heading)), ui-sans-serif, system-ui, sans-serif; font-weight: var(--type-h1-weight, 700); letter-spacing: var(--type-h1-tracking, -0.02em); line-height: 1; font-size: clamp(44px, 6cqi, 80px); font-variant-numeric: tabular-nums; }
.st__label { order: 2; margin: 14px 0 0; font-size: 15px; font-weight: 600; color: var(--s-heading); }
.st__note { order: 3; margin: 6px 0 0; font-size: 14px; line-height: 1.5; color: var(--s-para); max-width: 26ch; }
</style>

<schema>
{
  "schema_version": 1,
  "type": "stats_band",
  "name": "Numbers",
  "category": "social-proof",
  "description": "Three or four true numbers, big, with what each one counts.",
  "icon": "bar-chart",
  "settings": [
    {
      "type": "header",
      "id": "hdr_content",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": ""
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The numbers so far"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Supporting line",
      "default": ""
    },
    {
      "type": "radio",
      "id": "align",
      "label": "Heading alignment",
      "default": "left",
      "options": [
        {
          "label": "Left",
          "value": "left"
        },
        {
          "label": "Centre",
          "value": "center"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_layout",
      "label": "Layout"
    },
    {
      "type": "radio",
      "id": "layout",
      "label": "Heading",
      "default": "split",
      "options": [
        {
          "label": "Beside the numbers",
          "value": "split"
        },
        {
          "label": "Above the numbers",
          "value": "stacked"
        }
      ]
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "default": {
        "desktop": 3,
        "tablet": 3,
        "mobile": 1
      },
      "min": 1,
      "max": 4,
      "step": 1,
      "responsive": true
    },
    {
      "type": "toggle",
      "id": "dividers",
      "label": "Lines above each number",
      "default": true
    },
    {
      "type": "select",
      "id": "max_width",
      "label": "Content width",
      "default": "wide",
      "options": [
        {
          "label": "Narrow",
          "value": "narrow"
        },
        {
          "label": "Medium",
          "value": "medium"
        },
        {
          "label": "Wide",
          "value": "wide"
        },
        {
          "label": "Full",
          "value": "full"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_style",
      "label": "Style"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "white"
    },
    {
      "type": "header",
      "id": "hdr_spacing",
      "label": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "default": 88,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "default": 88,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Number",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Number",
          "default": "100+",
          "info": "Only numbers that are true. 12k, 98%, 4.9, Since 2009."
        },
        {
          "type": "text",
          "id": "label",
          "label": "What it counts",
          "default": "What this number counts"
        },
        {
          "type": "textarea",
          "id": "note",
          "label": "Small print",
          "default": ""
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Numbers",
      "blocks": [
        {
          "id": "n1",
          "type": "stat",
          "settings": {
            "value": "00",
            "label": "Your first number",
            "note": "Replace with something true and specific."
          }
        },
        {
          "id": "n2",
          "type": "stat",
          "settings": {
            "value": "00",
            "label": "Your second number"
          }
        },
        {
          "id": "n3",
          "type": "stat",
          "settings": {
            "value": "00",
            "label": "Your third number"
          }
        }
      ]
    },
    {
      "name": "Numbers, band",
      "settings": {
        "layout": "stacked",
        "heading": "",
        "color_scheme": "dark",
        "columns": {
          "desktop": 4,
          "tablet": 2,
          "mobile": 2
        },
        "padding_top": 64,
        "padding_bottom": 64
      },
      "blocks": [
        {
          "id": "b1",
          "type": "stat",
          "settings": {
            "value": "00",
            "label": "First number"
          }
        },
        {
          "id": "b2",
          "type": "stat",
          "settings": {
            "value": "00",
            "label": "Second number"
          }
        },
        {
          "id": "b3",
          "type": "stat",
          "settings": {
            "value": "00",
            "label": "Third number"
          }
        },
        {
          "id": "b4",
          "type": "stat",
          "settings": {
            "value": "00",
            "label": "Fourth number"
          }
        }
      ]
    }
  ]
}
</schema>
