{# ===========================================================================
   Feature tabs: a list of features on one side, the picture of the chosen
   one on the other. Plain CSS: each tab is a radio button and its label,
   so it works without a script, with the keyboard (arrow keys move between
   them) and before the page has finished loading. Up to eight.
   =========================================================================== #}
<template>
<section class="s ft ft--{{ settings.media_side }}" data-scheme="{{ settings.color_scheme }}" style="--s-bg: {{ scheme.bg }}; --s-text: {{ scheme.text }}; --s-heading: {{ scheme.heading }}; --s-para: {{ scheme.paragraph }}; --s-border: {{ scheme.border }}; --s-accent: {{ scheme.accent }}; --s-btn: {{ scheme.primary_btn_bg }}; --s-btn-text: {{ scheme.primary_btn_text }}; --s-btn2: {{ scheme.secondary_btn_bg }}; --s-btn2-text: {{ scheme.secondary_btn_text }}; --s-btn2-border: {{ scheme.secondary_btn_border }}; --s-btn-hover: {{ scheme.primary_btn_hover_bg }}; --s-btn-hover-text: {{ scheme.primary_btn_hover_text }}; --s-btn2-hover: {{ scheme.secondary_btn_hover_bg }}; --s-btn2-hover-text: {{ scheme.secondary_btn_hover_text }}; --s-radius: {{ theme.radius.medium }}px; --s-pt: {{ settings.padding_top }}px; --s-pb: {{ settings.padding_bottom }}px;">
  <div class="s__in s__in--{{ settings.max_width }}">
    {% if settings.eyebrow or settings.heading or settings.subheading %}
      <div class="s__head{% if settings.align == 'center' %} s__head--center{% endif %}">
        {% if settings.eyebrow %}<p class="s__eyebrow">{{ settings.eyebrow }}</p>{% endif %}
        {% if settings.heading %}<h2 class="s__h">{{ settings.heading }}</h2>{% endif %}
        {% if settings.subheading %}<p class="s__sub">{{ settings.subheading }}</p>{% endif %}
      </div>
    {% endif %}
    {% if blocks.size == 0 %}
      {% if page.in_editor %}<p class="ft__empty">Add tabs in the sidebar</p>{% endif %}
    {% else %}
      <div class="ft__box">
        {% for block in blocks limit: 8 %}<input class="ft__r" type="radio" name="ft-{{ section.id }}" id="ft-{{ section.id }}-{{ forloop.index }}" {% if forloop.first %}checked{% endif %} aria-label="{{ block.settings.label }}">{% endfor %}
        <div class="ft__grid">
          <div class="ft__tabs">
            {% for block in blocks limit: 8 %}
              <label class="ft__tab" for="ft-{{ section.id }}-{{ forloop.index }}" data-block-id="{{ block.id }}">
                <span class="ft__label"><span class="ft__num">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>{{ block.settings.label }}</span>
                <span class="ft__more">
                  {% if block.settings.text %}<span class="ft__text">{{ block.settings.text }}</span>{% endif %}
                  {% if block.settings.link_text %}<a class="ft__link" href="{{ block.settings.link | default: '#' | url }}">{{ block.settings.link_text }} <span aria-hidden="true">→</span></a>{% endif %}
                </span>
              </label>
            {% endfor %}
          </div>
          <div class="ft__panes">
            {% for block in blocks limit: 8 %}
              <div class="ft__pane">
                {% if block.settings.image %}<img src="{{ block.settings.image | asset }}" alt="{{ block.settings.image_alt }}" loading="lazy" decoding="async" data-media>{% elsif page.in_editor %}<div class="ph"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="2"/><path d="M21 17l-5-5-9 8"/></svg><span>Add a picture for this tab</span></div>{% endif %}
              </div>
            {% endfor %}
          </div>
        </div>
      </div>
    {% endif %}
  </div>
</section>
</template>

<style scoped>
.s { container-type: inline-size; background: var(--s-bg); color: var(--s-text); }
.s__in {
  margin: 0 auto;
  padding: calc(var(--s-pt) * var(--theme-spacing-scale, 1)) var(--theme-padding-x, 24px) calc(var(--s-pb) * var(--theme-spacing-scale, 1));
}
.s__in--narrow { max-width: 720px; }
.s__in--medium { max-width: 960px; }
.s__in--wide { max-width: var(--theme-page-width, 1280px); }
.s__in--full { max-width: none; }
.s__eyebrow { margin: 0 0 14px; font-family: var(--sl-caption-font); font-size: var(--sl-caption-size, 12px); font-weight: var(--sl-caption-weight, 600); letter-spacing: var(--sl-caption-tracking, 0.14em); text-transform: var(--sl-caption-transform, uppercase); color: var(--s-accent); }
.s__h {
  margin: 0;
  font-size: var(--section-heading-size, 32px);
  line-height: var(--section-heading-line-height, 1.15);
  font-weight: var(--section-heading-weight, 700);
  color: var(--s-heading);
  letter-spacing: var(--section-heading-tracking, -0.01em);
  text-transform: var(--section-heading-transform, none);
  font-family: var(--section-heading-font, var(--theme-font-heading, {{ theme.typography.heading }}), ui-sans-serif, system-ui, sans-serif);
  text-wrap: balance;
}
.s__sub { margin: 16px 0 0; max-width: 38rem; font-size: var(--section-text-size, 17px); line-height: var(--section-text-line-height, 1.6); color: var(--s-para); text-wrap: pretty; }
.s__head { max-width: 46rem; }
.s__head--center { margin-inline: auto; text-align: center; }
.s__head--center .s__sub { margin-inline: auto; }
.s__btns { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
.s__head--center .s__btns { justify-content: center; }
.s__btn {
  display: inline-flex; align-items: center; justify-content: center; min-height: 44px;
  padding: var(--sl-button-padding, 13px 24px); font-size: var(--sl-button-size, 15px); line-height: var(--sl-button-line-height); font-weight: var(--theme-button-weight, 600); text-decoration: none;
  border-radius: var(--s-radius); border: 1px solid transparent; transition: background-color 180ms ease, color 180ms ease, border-color 180ms ease, transform 180ms ease;
}
.s__btn--primary:hover { background: var(--s-btn-hover); color: var(--s-btn-hover-text); border-color: var(--s-btn-hover); }
.s__btn--secondary:hover { background: var(--s-btn2-hover); color: var(--s-btn2-hover-text); }
.s__btn--primary { background: var(--s-btn); color: var(--s-btn-text); border-color: var(--s-btn); }
.s__btn--secondary { background: var(--s-btn2); color: var(--s-btn2-text); border-color: var(--s-btn2-border); }
.s__btn:focus-visible, .s a:focus-visible { outline: 2px solid var(--s-accent); outline-offset: 3px; }
.s__note { margin: 18px 0 0; font-size: 13px; color: var(--s-para); }
.ph { display: grid !important; place-content: center; justify-items: center; gap: 8px; width: 100%; height: 100%; min-height: 160px; box-sizing: border-box; border: 1px dashed var(--s-border); background: color-mix(in srgb, var(--s-text) 5%, transparent); color: var(--s-para); font-size: 13px; text-align: center; padding: 16px; }
@media (prefers-reduced-motion: reduce) { .s__btn { transition: none; } }
.ph svg { width: 28px; height: 28px; fill: none; stroke: currentColor; stroke-width: 1.5; }

.ft .s__head { margin-bottom: 48px; }
.ft__empty { margin: 0; padding: 24px; border: 1px dashed var(--s-border); text-align: center; font-size: 13px; color: var(--s-para); }
.ft__r { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
.ft__grid { display: grid; gap: 32px; grid-template-columns: minmax(0, 1fr); }
.ft__tabs { display: grid; align-content: start; }
.ft__tab { display: block; padding: 20px 0 20px 20px; border-left: 2px solid var(--s-border); cursor: pointer; transition: border-color 200ms ease; }
.ft__tab:hover .ft__label { color: var(--s-heading); }
.ft__label { display: flex; gap: 14px; align-items: baseline; color: var(--s-para); font-family: var(--type-h3-font, var(--theme-font-heading)), ui-sans-serif, system-ui, sans-serif; font-weight: var(--type-h3-weight, 600); letter-spacing: var(--type-h3-tracking, -0.01em); font-size: clamp(19px, 2.2cqi, 24px); line-height: 1.25; transition: color 200ms ease; }
.ft__num { font-size: 12px; font-weight: 600; letter-spacing: 0.08em; color: var(--s-accent); font-variant-numeric: tabular-nums; }
.ft__more { display: none; padding: 10px 0 0 32px; }
.ft__text { display: block; font-size: 15px; line-height: 1.6; color: var(--s-para); max-width: 40ch; }
.ft__link { display: inline-block; margin-top: 10px; font-size: 14px; font-weight: 600; color: var(--s-heading); text-decoration: none; }
.ft__link:hover { text-decoration: underline; text-underline-offset: 4px; }
.ft__pane { display: none; }
.ft__pane img, .ft__pane .ph { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--sl-image-radius, var(--s-radius)); animation: ft-in 400ms cubic-bezier(.2,.7,.2,1); }
@keyframes ft-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
@media (prefers-reduced-motion: reduce) { .ft__pane img, .ft__pane .ph { animation: none; } }
@container (max-width: 859px) { .ft__panes { order: -1; } }
@container (min-width: 860px) {
  .ft__grid { grid-template-columns: 5fr 7fr; gap: 64px; align-items: center; }
  .ft--left .ft__panes { order: -1; }
}
.ft__r:nth-of-type(1):checked ~ .ft__grid .ft__tab:nth-of-type(1) { border-color: var(--s-heading); }
.ft__r:nth-of-type(1):checked ~ .ft__grid .ft__tab:nth-of-type(1) .ft__more { display: block; }
.ft__r:nth-of-type(1):checked ~ .ft__grid .ft__tab:nth-of-type(1) .ft__label { color: var(--s-heading); }
.ft__r:nth-of-type(1):checked ~ .ft__grid .ft__pane:nth-of-type(1) { display: block; }
.ft__r:nth-of-type(1):focus-visible ~ .ft__grid .ft__tab:nth-of-type(1) { outline: 2px solid var(--s-accent); outline-offset: 4px; }
.ft__r:nth-of-type(2):checked ~ .ft__grid .ft__tab:nth-of-type(2) { border-color: var(--s-heading); }
.ft__r:nth-of-type(2):checked ~ .ft__grid .ft__tab:nth-of-type(2) .ft__more { display: block; }
.ft__r:nth-of-type(2):checked ~ .ft__grid .ft__tab:nth-of-type(2) .ft__label { color: var(--s-heading); }
.ft__r:nth-of-type(2):checked ~ .ft__grid .ft__pane:nth-of-type(2) { display: block; }
.ft__r:nth-of-type(2):focus-visible ~ .ft__grid .ft__tab:nth-of-type(2) { outline: 2px solid var(--s-accent); outline-offset: 4px; }
.ft__r:nth-of-type(3):checked ~ .ft__grid .ft__tab:nth-of-type(3) { border-color: var(--s-heading); }
.ft__r:nth-of-type(3):checked ~ .ft__grid .ft__tab:nth-of-type(3) .ft__more { display: block; }
.ft__r:nth-of-type(3):checked ~ .ft__grid .ft__tab:nth-of-type(3) .ft__label { color: var(--s-heading); }
.ft__r:nth-of-type(3):checked ~ .ft__grid .ft__pane:nth-of-type(3) { display: block; }
.ft__r:nth-of-type(3):focus-visible ~ .ft__grid .ft__tab:nth-of-type(3) { outline: 2px solid var(--s-accent); outline-offset: 4px; }
.ft__r:nth-of-type(4):checked ~ .ft__grid .ft__tab:nth-of-type(4) { border-color: var(--s-heading); }
.ft__r:nth-of-type(4):checked ~ .ft__grid .ft__tab:nth-of-type(4) .ft__more { display: block; }
.ft__r:nth-of-type(4):checked ~ .ft__grid .ft__tab:nth-of-type(4) .ft__label { color: var(--s-heading); }
.ft__r:nth-of-type(4):checked ~ .ft__grid .ft__pane:nth-of-type(4) { display: block; }
.ft__r:nth-of-type(4):focus-visible ~ .ft__grid .ft__tab:nth-of-type(4) { outline: 2px solid var(--s-accent); outline-offset: 4px; }
.ft__r:nth-of-type(5):checked ~ .ft__grid .ft__tab:nth-of-type(5) { border-color: var(--s-heading); }
.ft__r:nth-of-type(5):checked ~ .ft__grid .ft__tab:nth-of-type(5) .ft__more { display: block; }
.ft__r:nth-of-type(5):checked ~ .ft__grid .ft__tab:nth-of-type(5) .ft__label { color: var(--s-heading); }
.ft__r:nth-of-type(5):checked ~ .ft__grid .ft__pane:nth-of-type(5) { display: block; }
.ft__r:nth-of-type(5):focus-visible ~ .ft__grid .ft__tab:nth-of-type(5) { outline: 2px solid var(--s-accent); outline-offset: 4px; }
.ft__r:nth-of-type(6):checked ~ .ft__grid .ft__tab:nth-of-type(6) { border-color: var(--s-heading); }
.ft__r:nth-of-type(6):checked ~ .ft__grid .ft__tab:nth-of-type(6) .ft__more { display: block; }
.ft__r:nth-of-type(6):checked ~ .ft__grid .ft__tab:nth-of-type(6) .ft__label { color: var(--s-heading); }
.ft__r:nth-of-type(6):checked ~ .ft__grid .ft__pane:nth-of-type(6) { display: block; }
.ft__r:nth-of-type(6):focus-visible ~ .ft__grid .ft__tab:nth-of-type(6) { outline: 2px solid var(--s-accent); outline-offset: 4px; }
.ft__r:nth-of-type(7):checked ~ .ft__grid .ft__tab:nth-of-type(7) { border-color: var(--s-heading); }
.ft__r:nth-of-type(7):checked ~ .ft__grid .ft__tab:nth-of-type(7) .ft__more { display: block; }
.ft__r:nth-of-type(7):checked ~ .ft__grid .ft__tab:nth-of-type(7) .ft__label { color: var(--s-heading); }
