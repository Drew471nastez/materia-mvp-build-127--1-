.ft__r:nth-of-type(8):checked ~ .ft__grid .ft__tab:nth-of-type(8) { border-color: var(--s-heading); }
.ft__r:nth-of-type(8):checked ~ .ft__grid .ft__tab:nth-of-type(8) .ft__more { display: block; }
.ft__r:nth-of-type(8):checked ~ .ft__grid .ft__tab:nth-of-type(8) .ft__label { color: var(--s-heading); }
.ft__r:nth-of-type(8):checked ~ .ft__grid .ft__pane:nth-of-type(8) { display: block; }
.ft__r:nth-of-type(8):focus-visible ~ .ft__grid .ft__tab:nth-of-type(8) { outline: 2px solid var(--s-accent); outline-offset: 4px; }
</style>

<schema>
{
  "schema_version": 1,
  "type": "feature_tabs",
  "name": "Feature Tabs",
  "category": "features",
  "description": "Features as a list of tabs, the chosen one's picture beside it. Works without a script.",
  "icon": "panels-top-left",
  "settings": [
    {
      "type": "header",
      "id": "hdr_content",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": ""
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How it works"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Supporting line",
      "default": ""
    },
    {
      "type": "radio",
      "id": "align",
      "label": "Heading alignment",
      "default": "left",
      "options": [
        {
          "label": "Left",
          "value": "left"
        },
        {
          "label": "Centre",
          "value": "center"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_layout",
      "label": "Layout"
    },
    {
      "type": "radio",
      "id": "media_side",
      "label": "Picture on",
      "default": "right",
      "options": [
        {
          "label": "Left",
          "value": "left"
        },
        {
          "label": "Right",
          "value": "right"
        }
      ]
    },
    {
      "type": "select",
      "id": "max_width",
      "label": "Content width",
      "default": "wide",
      "options": [
        {
          "label": "Narrow",
          "value": "narrow"
        },
        {
          "label": "Medium",
          "value": "medium"
        },
        {
          "label": "Wide",
          "value": "wide"
        },
        {
          "label": "Full",
          "value": "full"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_style",
      "label": "Style"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "white"
    },
    {
      "type": "header",
      "id": "hdr_spacing",
      "label": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "default": 96,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "default": 96,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Tab title",
          "default": "A feature"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Two lines on what it does for the person using it."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Picture",
          "default": ""
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Picture description",
          "default": "",
          "info": "Read aloud to people who cannot see it."
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "Link wording",
          "default": ""
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "default": ""
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Feature Tabs",
      "blocks": [
        {
          "id": "f1",
          "type": "tab",
          "settings": {
            "label": "The first thing it does"
          }
        },
        {
          "id": "f2",
          "type": "tab",
          "settings": {
            "label": "The second thing it does"
          }
        },
        {
          "id": "f3",
          "type": "tab",
          "settings": {
            "label": "The third thing it does"
          }
        }
      ]
    }
  ]
}
</schema>
