<template>
<section class="s" data-scheme="{{ settings.color_scheme }}" style="--s-bg: {{ scheme.bg }}; --s-text: {{ scheme.text }}; --s-heading: {{ scheme.heading }}; --s-para: {{ scheme.paragraph }}; --s-border: {{ scheme.border }}; --s-accent: {{ scheme.accent }}; --s-btn: {{ scheme.primary_btn_bg }}; --s-btn-text: {{ scheme.primary_btn_text }}; --s-radius: {{ theme.radius.medium }}px; --s-pt: {{ settings.padding_top }}px; --s-pb: {{ settings.padding_bottom }}px;">
  <div class="s__in s__in--{{ settings.max_width }} fo__in">
    {% if settings.image %}<img class="fo__photo" src="{{ settings.image | asset }}" alt="{{ settings.name }}" loading="lazy" decoding="async">{% endif %}
    {% if settings.eyebrow %}<p class="s__eyebrow">{{ settings.eyebrow }}</p>{% endif %}
    {% if settings.heading %}<h2 class="s__h fo__h">{{ settings.heading }}</h2>{% endif %}
    {% if settings.body %}<div class="rt fo__body">{{ settings.body | raw }}</div>{% endif %}
    {% if settings.signature %}<img class="fo__sign" src="{{ settings.signature | asset }}" alt="" loading="lazy">{% endif %}
    {% if settings.name %}
      <p class="fo__by"><span class="fo__name">{{ settings.name }}</span>{% if settings.role %}<span class="fo__role">{{ settings.role }}</span>{% endif %}</p>
    {% endif %}
  </div>
</section>
</template>

<style scoped>
.s { container-type: inline-size; background: var(--s-bg); color: var(--s-text); }
.s__in {
  margin: 0 auto;
  padding: calc(var(--s-pt) * var(--theme-spacing-scale, 1)) var(--theme-padding-x, 24px) calc(var(--s-pb) * var(--theme-spacing-scale, 1));
}
.s__in--narrow { max-width: 720px; }
.s__in--medium { max-width: 960px; }
.s__in--wide { max-width: var(--theme-page-width, 1280px); }
.s__in--full { max-width: none; }
.s__eyebrow { margin: 0 0 12px; font-size: 12px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--s-accent); }
.s__h {
  margin: 0;
  font-size: 32px;
  line-height: 1.15;
  font-weight: 700;
  color: var(--s-heading);
  letter-spacing: -0.01em;
  /* The theme's font when the page sets one, the token otherwise, and a real
     stack either way: a bare family name falls back to the browser's serif. */
  font-family: var(--theme-font-heading, {{ theme.typography.heading }}), ui-sans-serif, system-ui, sans-serif;
}
@container (min-width: 768px) { .s__h { font-size: 40px; } }
.s__sub { margin: 14px 0 0; font-size: 17px; line-height: 1.6; color: var(--s-para); }
.s__head { max-width: 44rem; }
.s__head--center { margin-inline: auto; text-align: center; }
.s__btns { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
.s__head--center .s__btns { justify-content: center; }
.s__btn {
  display: inline-flex; align-items: center; justify-content: center;
  padding: 13px 24px; font-size: 15px; font-weight: 600; text-decoration: none;
  border-radius: var(--s-radius); border: 1px solid transparent; transition: opacity 150ms ease;
}
.s__btn:hover { opacity: 0.88; }
.s__btn--primary { background: var(--s-btn); color: var(--s-btn-text); border-color: var(--s-btn); }
.s__btn--secondary { background: transparent; color: var(--s-heading); border-color: var(--s-border); }
.s__note { margin: 16px 0 0; font-size: 13px; color: var(--s-para); opacity: 0.8; }

.rt { font-size: 16px; line-height: 1.7; color: var(--s-para); }
.rt > :first-child { margin-top: 0; } .rt > :last-child { margin-bottom: 0; }
.rt p { margin: 0 0 1em; }
.rt a { color: var(--s-heading); text-decoration: underline; text-underline-offset: 3px; }
.rt ul { margin: 0 0 1em; padding-left: 1.35em; }

.fo__in { display: flex; flex-direction: column; align-items: center; text-align: center; }
.fo__photo { width: 96px; height: 96px; border-radius: 999px; object-fit: cover; margin-bottom: 22px; }
.fo__h { margin-bottom: 18px; }
.fo__body { max-width: 38rem; text-align: left; }
.fo__sign { margin-top: 26px; height: 48px; width: auto; }
.fo__by { margin: 18px 0 0; display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; }
.fo__name { font-size: 14px; font-weight: 600; color: var(--s-heading); }
.fo__role { font-size: 14px; color: var(--s-para); opacity: 0.85; }
.fo__role::before { content: "· "; }
</style>

<schema>
{
  "schema_version": 1,
  "type": "about_founder",
  "name": "Founder Story",
  "category": "about",
  "description": "One person, their picture and their words.",
  "version": "1.0.0",
  "icon": "user",
  "settings": [
    {
      "type": "header",
      "id": "hdr_content",
      "label": "Content"
    },
