{
  "type": "hero",
  "name": "Hero",
  "description": "Full-width hero section with heading, subheading, CTAs, and flexible background",
  "icon": "star",
  "category": "content",
  "fields": [
    {
      "id": "hdr_content",
      "label": "Content",
      "type": "header"
    },
    {
      "id": "eyebrow",
      "label": "Eyebrow text",
      "type": "text",
      "placeholder": "New arrivals"
    },
    {
      "id": "heading",
      "label": "Heading",
      "type": "text",
      "placeholder": "Welcome to our store"
    },
    {
      "id": "subheading",
      "label": "Subheading",
      "type": "textarea",
      "placeholder": "Discover premium products crafted for you."
    },
    {
      "id": "badge_text",
      "label": "Badge text",
      "type": "text",
      "placeholder": "Limited time offer"
    },
    {
      "id": "animate_heading",
      "label": "Animate heading on load",
      "type": "toggle",
      "default": false
    },
    {
      "id": "hdr_cta1",
      "label": "Primary Button",
      "type": "header"
    },
    {
      "id": "button_text",
      "label": "Button text",
      "type": "text",
      "placeholder": "Shop Now"
    },
    {
      "id": "button_url",
      "label": "Button URL",
      "type": "link"
    },
    {
      "id": "button_style",
      "label": "Button style",
      "type": "radio",
      "default": "filled",
      "options": [
        {
          "label": "Filled",
          "value": "filled"
        },
        {
          "label": "Outline",
          "value": "outline"
        },
        {
          "label": "Ghost",
          "value": "ghost"
        }
      ]
    },
    {
      "id": "button_color",
      "label": "Button color",
      "type": "color",
      "default": "#6366f1"
    },
    {
      "id": "button_text_color",
      "label": "Button text color",
      "type": "color",
      "default": "#ffffff"
    },
    {
      "id": "button_border_radius",
      "label": "Button radius",
      "type": "range",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "id": "hdr_cta2",
      "label": "Secondary Button",
      "type": "header"
    },
    {
      "id": "button2_text",
      "label": "Button text",
      "type": "text",
      "placeholder": "Learn more"
    },
    {
      "id": "button2_url",
      "label": "Button URL",
      "type": "link"
    },
    {
      "id": "button2_style",
      "label": "Button style",
      "type": "radio",
      "default": "outline",
      "options": [
        {
          "label": "Filled",
          "value": "filled"
        },
        {
          "label": "Outline",
          "value": "outline"
        },
        {
          "label": "Ghost",
          "value": "ghost"
        }
      ]
    },
    {
      "id": "hdr_bg",
      "label": "Background",
      "type": "header"
    },
    {
      "id": "bg_type",
      "label": "Background type",
      "type": "select",
      "default": "color",
      "options": [
        {
          "label": "Color",
          "value": "color"
        },
        {
          "label": "Gradient",
          "value": "gradient"
        },
        {
          "label": "Image",
          "value": "image"
        },
        {
          "label": "Video",
          "value": "video"
        }
      ]
    },
    {
      "id": "bg_color",
      "label": "Background color",
      "type": "color",
      "default": "",
      "info": "Leave empty to use the color scheme."
    },
    {
      "id": "bg_gradient",
      "label": "Gradient CSS",
      "type": "text",
      "placeholder": "linear-gradient(135deg, #667eea 0%, #764ba2 100%)"
    },
    {
      "id": "bg_image",
      "label": "Background image",
      "type": "image"
    },
    {
      "id": "bg_video",
      "label": "Background video",
      "type": "video"
    },
    {
      "id": "bg_overlay_color",
      "label": "Overlay color",
      "type": "color",
      "default": "#000000"
    },
    {
      "id": "bg_overlay_opacity",
      "label": "Overlay opacity",
      "type": "range",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 40
    },
    {
      "id": "hdr_style",
      "label": "Style",
      "type": "header"
    },
    {
      "id": "color_scheme",
      "label": "Color scheme",
      "type": "select",
      "default": "white",
      "options": [
        {
          "label": "White",
          "value": "white"
        },
        {
          "label": "Light",
          "value": "light"
        },
        {
          "label": "Dark",
          "value": "dark"
        },
        {
          "label": "Black",
          "value": "black"
        },
        {
          "label": "Highlight",
          "value": "highlight"
        }
      ]
    },
    {
      "id": "text_color",
      "label": "Text color",
      "type": "color",
      "default": "",
      "info": "Leave empty to use the color scheme."
    },
    {
      "id": "font_size_heading",
      "label": "Heading font size",
      "type": "range",
      "min": 24,
      "max": 96,
      "step": 2,
      "unit": "px",
      "default": 56
    },
    {
      "id": "hero_image",
      "label": "Side image (split layout)",
      "type": "image"
    },
    {
      "id": "hdr_layout",
      "label": "Layout",
      "type": "header"
    },
    {
      "id": "layout",
      "label": "Layout",
      "type": "radio",
      "default": "center",
      "options": [
        {
          "label": "Center",
          "value": "center"
        },
        {
          "label": "Left",
          "value": "left"
        },
        {
          "label": "Right",
          "value": "right"
        },
        {
          "label": "Split",
          "value": "split"
        }
      ]
    },
    {
      "id": "max_width",
      "label": "Container width",
      "type": "select",
      "default": "wide",
      "options": [
        {
          "label": "Narrow",
          "value": "narrow"
        },
        {
          "label": "Medium",
          "value": "medium"
        },
        {
          "label": "Wide",
          "value": "wide"
        },
        {
          "label": "Full",
          "value": "full"
        }
      ]
    },
    {
      "id": "full_height",
      "label": "Full screen height",
      "type": "toggle",
      "default": false
    },
    {
      "id": "scroll_indicator",
      "label": "Show scroll indicator",
      "type": "toggle",
      "default": false
    },
    {
      "id": "hdr_padding",
      "label": "Padding",
      "type": "header"
    },
    {
      "id": "padding_top",
      "label": "Padding top",
      "type": "range",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "id": "padding_bottom",
      "label": "Padding bottom",
      "type": "range",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
