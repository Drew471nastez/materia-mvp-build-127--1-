{# ===========================================================================
   Full bleed hero: a photograph or a video behind the whole section, a veil
   of the overlay colour over it, and the words placed where the picture
   leaves room (Content position). The video plays muted, looped and inline;
   a visitor who asked for less motion sees its poster, still.
   =========================================================================== #}
<template>
<section class="s hm hm--{{ settings.position }} hm--h{{ settings.height }}{% if settings.zoom %} hm--zoom{% endif %}" data-scheme="{{ settings.color_scheme }}" style="--s-bg: {{ scheme.bg }}; --s-text: {{ scheme.text }}; --s-heading: {{ scheme.heading }}; --s-para: {{ scheme.paragraph }}; --s-border: {{ scheme.border }}; --s-accent: {{ scheme.accent }}; --s-btn: {{ scheme.primary_btn_bg }}; --s-btn-text: {{ scheme.primary_btn_text }}; --s-btn2: {{ scheme.secondary_btn_bg }}; --s-btn2-text: {{ scheme.secondary_btn_text }}; --s-btn2-border: {{ scheme.secondary_btn_border }}; --s-btn-hover: {{ scheme.primary_btn_hover_bg }}; --s-btn-hover-text: {{ scheme.primary_btn_hover_text }}; --s-btn2-hover: {{ scheme.secondary_btn_hover_bg }}; --s-btn2-hover-text: {{ scheme.secondary_btn_hover_text }}; --s-radius: {{ theme.radius.medium }}px; --s-pt: {{ settings.padding_top }}px; --s-pb: {{ settings.padding_bottom }}px; --hm-ov: {{ settings.overlay_color }}; --hm-ov-a: {{ settings.overlay_opacity }}%;">
  <div class="hm__media" aria-hidden="true">
    {% if settings.video %}
      <video class="hm__vid" src="{{ settings.video | asset }}" {% if settings.image %}poster="{{ settings.image | asset }}"{% endif %} autoplay muted loop playsinline preload="metadata"></video>
    {% elsif settings.image %}
      <picture>
        {% if settings.mobile_image %}<source media="(max-width: 767px)" srcset="{{ settings.mobile_image | asset }}">{% endif %}
        <img class="hm__img" src="{{ settings.image | asset }}" alt="" loading="eager" fetchpriority="high" decoding="async" style="object-position: {{ settings.focus }};">
      </picture>
    {% elsif page.in_editor %}
      <div class="ph"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="2"/><path d="M21 17l-5-5-9 8"/></svg><span>Add a photograph or a video for the background</span></div>
    {% endif %}
    <span class="hm__veil hm__veil--{{ settings.overlay_style }}"></span>
  </div>
  {% if settings.image_alt %}<p class="hm__alt">{{ settings.image_alt }}</p>{% endif %}
  <div class="s__in s__in--{{ settings.max_width }} hm__in">
    <div class="hm__copy">
      {% if settings.eyebrow %}<p class="s__eyebrow">{{ settings.eyebrow }}</p>{% endif %}
      {% if settings.heading %}<h1 class="hm__h">{{ settings.heading }}</h1>{% endif %}
      {% if settings.subheading %}<p class="hm__sub">{{ settings.subheading }}</p>{% endif %}
      {% if settings.button_text or settings.button2_text %}
        <div class="s__btns">
          {% if settings.button_text %}<a class="s__btn s__btn--primary" href="{{ settings.button_url | default: '#' | url }}">{{ settings.button_text }}</a>{% endif %}
          {% if settings.button2_text %}<a class="s__btn s__btn--secondary" href="{{ settings.button2_url | default: '#' | url }}">{{ settings.button2_text }}</a>{% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</section>
</template>

<style scoped>
.s { container-type: inline-size; background: var(--s-bg); color: var(--s-text); }
.s__in {
  margin: 0 auto;
  padding: calc(var(--s-pt) * var(--theme-spacing-scale, 1)) var(--theme-padding-x, 24px) calc(var(--s-pb) * var(--theme-spacing-scale, 1));
}
.s__in--narrow { max-width: 720px; }
.s__in--medium { max-width: 960px; }
.s__in--wide { max-width: var(--theme-page-width, 1280px); }
.s__in--full { max-width: none; }
.s__eyebrow { margin: 0 0 14px; font-family: var(--sl-caption-font); font-size: var(--sl-caption-size, 12px); font-weight: var(--sl-caption-weight, 600); letter-spacing: var(--sl-caption-tracking, 0.14em); text-transform: var(--sl-caption-transform, uppercase); color: var(--s-accent); }
.s__h {
  margin: 0;
  font-size: var(--section-heading-size, 32px);
  line-height: var(--section-heading-line-height, 1.15);
  font-weight: var(--section-heading-weight, 700);
  color: var(--s-heading);
  letter-spacing: var(--section-heading-tracking, -0.01em);
  text-transform: var(--section-heading-transform, none);
  font-family: var(--section-heading-font, var(--theme-font-heading, {{ theme.typography.heading }}), ui-sans-serif, system-ui, sans-serif);
  text-wrap: balance;
}
.s__sub { margin: 16px 0 0; max-width: 38rem; font-size: var(--section-text-size, 17px); line-height: var(--section-text-line-height, 1.6); color: var(--s-para); text-wrap: pretty; }
.s__head { max-width: 46rem; }
.s__head--center { margin-inline: auto; text-align: center; }
.s__head--center .s__sub { margin-inline: auto; }
.s__btns { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
.s__head--center .s__btns { justify-content: center; }
.s__btn {
  display: inline-flex; align-items: center; justify-content: center; min-height: 44px;
  padding: var(--sl-button-padding, 13px 24px); font-size: var(--sl-button-size, 15px); line-height: var(--sl-button-line-height); font-weight: var(--theme-button-weight, 600); text-decoration: none;
  border-radius: var(--s-radius); border: 1px solid transparent; transition: background-color 180ms ease, color 180ms ease, border-color 180ms ease, transform 180ms ease;
}
.s__btn--primary:hover { background: var(--s-btn-hover); color: var(--s-btn-hover-text); border-color: var(--s-btn-hover); }
.s__btn--secondary:hover { background: var(--s-btn2-hover); color: var(--s-btn2-hover-text); }
.s__btn--primary { background: var(--s-btn); color: var(--s-btn-text); border-color: var(--s-btn); }
.s__btn--secondary { background: var(--s-btn2); color: var(--s-btn2-text); border-color: var(--s-btn2-border); }
.s__btn:focus-visible, .s a:focus-visible { outline: 2px solid var(--s-accent); outline-offset: 3px; }
.s__note { margin: 18px 0 0; font-size: 13px; color: var(--s-para); }
.ph { display: grid !important; place-content: center; justify-items: center; gap: 8px; width: 100%; height: 100%; min-height: 160px; box-sizing: border-box; border: 1px dashed var(--s-border); background: color-mix(in srgb, var(--s-text) 5%, transparent); color: var(--s-para); font-size: 13px; text-align: center; padding: 16px; }
.ph svg { width: 28px; height: 28px; fill: none; stroke: currentColor; stroke-width: 1.5; }

.hm { position: relative; isolation: isolate; overflow: hidden; display: flex; }
.hm--h60 { min-height: calc(var(--sl-vh, 1vh) * 60); }
.hm--h80 { min-height: calc(var(--sl-vh, 1vh) * 80); }
.hm--h100 { min-height: calc(var(--sl-vh, 1vh) * 100); }
.hm__media { position: absolute; inset: 0; z-index: -1; }
.hm__media picture, .hm__img, .hm__vid { display: block; width: 100%; height: 100%; object-fit: cover; }
.hm__media .ph { border: 0; min-height: 100%; }
.hm__veil { position: absolute; inset: 0; background: color-mix(in srgb, var(--hm-ov) var(--hm-ov-a), transparent); }
.hm__veil--bottom { background: linear-gradient(to top, color-mix(in srgb, var(--hm-ov) calc(var(--hm-ov-a) + 25%), transparent) 0%, color-mix(in srgb, var(--hm-ov) var(--hm-ov-a), transparent) 45%, transparent 100%); }
.hm__veil--side { background: linear-gradient(to right, color-mix(in srgb, var(--hm-ov) calc(var(--hm-ov-a) + 25%), transparent) 0%, color-mix(in srgb, var(--hm-ov) var(--hm-ov-a), transparent) 50%, transparent 100%); }
.hm__alt { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); margin: 0; }
.hm__in { position: relative; display: flex; width: 100%; box-sizing: border-box; }
.hm__copy { max-width: 46rem; }
.hm__h {
  margin: 0; color: var(--s-heading); text-wrap: balance;
  font-family: var(--type-h1-font, var(--theme-font-heading)), ui-sans-serif, system-ui, sans-serif;
  font-weight: var(--type-h1-weight, 700); line-height: var(--type-h1-line-height, 1.02); letter-spacing: var(--type-h1-tracking, -0.02em); text-transform: var(--type-h1-transform, none);
  font-size: clamp(40px, 8cqi, calc(var(--type-h1-size, 64px) * 1.25));
}
.hm__sub { margin: 18px 0 0; max-width: 34rem; font-size: var(--type-body-large-size, 19px); line-height: 1.55; color: var(--s-text); text-wrap: pretty; }
.hm--bottom_left .hm__in { align-items: flex-end; }
.hm--center_left .hm__in { align-items: center; }
.hm--top_left .hm__in { align-items: flex-start; }
.hm--center .hm__in { align-items: center; justify-content: center; text-align: center; }
.hm--center .hm__copy, .hm--bottom_center .hm__copy { margin-inline: auto; }
.hm--center .hm__sub, .hm--bottom_center .hm__sub { margin-inline: auto; }
.hm--center .s__btns, .hm--bottom_center .s__btns { justify-content: center; }
.hm--bottom_center .hm__in { align-items: flex-end; justify-content: center; text-align: center; }
.hm--bottom_right .hm__in { align-items: flex-end; justify-content: flex-end; }
.hm--zoom .hm__img { animation: hm-zoom 18s cubic-bezier(.2,.6,.2,1) both; }
@keyframes hm-zoom { from { transform: scale(1.12); } to { transform: scale(1); } }
@media (prefers-reduced-motion: reduce) {
  .hm--zoom .hm__img { animation: none; }
  .hm__vid { display: none; }
  .hm__media:has(.hm__vid) { background: var(--s-bg); }
}
</style>

<schema>
{
  "schema_version": 1,
  "type": "hero_media",
  "name": "Full Bleed Hero",
  "category": "hero",
  "description": "A photograph or a looping video across the whole screen, a veil over it and the words placed where the picture leaves room.",
  "icon": "image",
  "settings": [
    {
      "type": "header",
      "id": "hdr_content",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": ""
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Step inside"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Supporting line",
      "default": "One line that makes someone want to see more."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button",
      "default": "Explore"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link",
      "default": "/products"
    },
    {
      "type": "text",
      "id": "button2_text",
      "label": "Second button",
      "default": ""
    },
    {
      "type": "url",
      "id": "button2_url",
      "label": "Second button link",
      "default": ""
    },
    {
      "type": "header",
      "id": "hdr_media",
      "label": "Background"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photograph",
      "default": "",
      "info": "Also the video's still frame."
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Photograph on phones",
      "default": "",
      "info": "Optional: a taller crop for phones."
    },
    {
      "type": "video_picker",
      "id": "video",
      "label": "Video",
      "default": "",
      "info": "Optional. Plays muted and on a loop. Short and small is best."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Background description",
      "default": "",
      "info": "Read aloud to people who cannot see it."
    },
    {
      "type": "select",
      "id": "focus",
      "label": "Keep in view",
      "default": "center",
      "options": [
        {
          "label": "Centre",
          "value": "center"
        },
        {
          "label": "Top",
          "value": "top"
        },
        {
          "label": "Bottom",
          "value": "bottom"
        },
        {
          "label": "Left",
          "value": "left"
        },
        {
          "label": "Right",
          "value": "right"
        }
      ]
    },
    {
      "type": "toggle",
      "id": "zoom",
      "label": "Slow zoom as it opens",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_overlay",
      "label": "Overlay"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay colour",
      "default": "scheme.background"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay strength",
      "default": 40,
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%"
    },
    {
      "type": "select",
      "id": "overlay_style",
      "label": "Overlay shape",
      "default": "bottom",
      "options": [
        {
          "label": "Even",
          "value": "even"
        },
        {
          "label": "Darker at the bottom",
          "value": "bottom"
        },
        {
          "label": "Darker on the left",
          "value": "side"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_layout",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "position",
      "label": "Content position",
      "default": "bottom_left",
      "options": [
        {
          "label": "Bottom left",
          "value": "bottom_left"
        },
        {
          "label": "Middle left",
          "value": "center_left"
        },
        {
          "label": "Top left",
          "value": "top_left"
        },
        {
          "label": "Centre",
          "value": "center"
        },
        {
          "label": "Bottom centre",
          "value": "bottom_center"
        },
        {
          "label": "Bottom right",
          "value": "bottom_right"
        }
      ]
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "default": "100",
      "options": [
        {
          "label": "Most of the screen",
          "value": "80"
        },
        {
          "label": "Full screen",
          "value": "100"
        },
        {
          "label": "Shorter",
          "value": "60"
        }
      ]
    },
    {
      "type": "select",
      "id": "max_width",
      "label": "Content width",
      "default": "wide",
      "options": [
        {
          "label": "Narrow",
          "value": "narrow"
        },
        {
          "label": "Medium",
          "value": "medium"
        },
        {
          "label": "Wide",
          "value": "wide"
        },
        {
          "label": "Full",
          "value": "full"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_style",
      "label": "Style"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "black"
    },
    {
      "type": "header",
      "id": "hdr_spacing",
      "label": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "default": 120,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "default": 72,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Full Bleed Hero"
    },
    {
      "name": "Full Bleed Hero, centred",
      "settings": {
        "position": "center",
        "overlay_style": "even",
        "overlay_opacity": 45,
        "height": "80"
      }
    }
  ]
}
</schema>
