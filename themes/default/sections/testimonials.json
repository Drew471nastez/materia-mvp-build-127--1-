{
  "type": "testimonials",
  "name": "Testimonials",
  "description": "Customer reviews and social proof with flexible layouts.",
  "icon": "message-square",
  "category": "social-proof",
  "fields": [
    {
      "id": "heading",
      "label": "Heading",
      "type": "text",
      "default": "What our customers say",
      "placeholder": "Section heading"
    },
    {
      "id": "subheading",
      "label": "Subheading",
      "type": "textarea",
      "default": "Join thousands of happy customers who trust us every day.",
      "placeholder": "Supporting text"
    },
    {
      "id": "layout",
      "label": "Layout",
      "type": "select",
      "default": "carousel",
      "options": [
        {
          "label": "Cards (grid)",
          "value": "card"
        },
        {
          "label": "Carousel",
          "value": "carousel"
        },
        {
          "label": "Masonry",
          "value": "masonry"
        }
      ]
    },
    {
      "id": "show_rating",
      "label": "Show star rating",
      "type": "toggle",
      "default": true
    },
    {
      "id": "show_date",
      "label": "Show date",
      "type": "toggle",
      "default": false
    },
    {
      "id": "accent_color",
      "label": "Accent / star color",
      "type": "color",
      "default": "#f59e0b"
    },
    {
      "id": "card_bg_color",
      "label": "Card background",
      "type": "color",
      "default": "#ffffff"
    },
    {
      "id": "hdr_padding",
      "label": "Padding",
      "type": "header"
    },
    {
      "id": "bg_color",
      "label": "Background color",
      "type": "color",
      "default": "#f9fafb"
    },
    {
      "id": "text_color",
      "label": "Text color",
      "type": "color",
      "default": "#111827"
    },
    {
      "id": "padding_top",
      "label": "Padding top",
      "type": "range",
      "default": 60,
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px"
    },
    {
      "id": "padding_bottom",
      "label": "Padding bottom",
      "type": "range",
      "default": 60,
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "fields": [
        {
          "id": "quote",
          "label": "Quote",
          "type": "textarea",
          "default": "This product completely changed how I work. I can't imagine going back.",
          "placeholder": "Customer quote"
        },
        {
          "id": "author",
          "label": "Author name",
          "type": "text",
          "default": "Jane Smith",
          "placeholder": "Full name"
        },
        {
          "id": "role",
          "label": "Role / title",
          "type": "text",
          "default": "Product Manager",
          "placeholder": "Job title"
        },
        {
          "id": "company",
          "label": "Company",
          "type": "text",
          "default": "Acme Corp",
          "placeholder": "Company name"
        },
        {
          "id": "avatar",
          "label": "Avatar image",
          "type": "image",
          "default": ""
        },
        {
          "id": "rating",
          "label": "Star rating (1–5)",
          "type": "range",
          "default": 5,
          "min": 1,
          "max": 5,
          "step": 1
        },
        {
          "id": "date",
          "label": "Date",
          "type": "text",
          "default": "March 2025",
          "placeholder": "e.g. March 2025"
        },
        {
          "id": "verified",
          "label": "Verified badge",
          "type": "toggle",
          "default": true
        },
        {
          "id": "source",
          "label": "Review source",
          "type": "select",
          "default": "google",
          "options": [
            {
              "label": "Google",
              "value": "google"
            },
            {
              "label": "Trustpilot",
              "value": "trustpilot"
            },
            {
              "label": "Twitter / X",
              "value": "twitter"
            },
            {
              "label": "None",
              "value": "none"
            }
          ]
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Three testimonials carousel",
      "settings": {
        "heading": "What our customers say",
        "layout": "carousel",
        "show_rating": true,
        "show_date": true,
        "accent_color": "#f59e0b",
        "card_bg_color": "#ffffff",
        "bg_color": "#f9fafb",
        "text_color": "#111827",
        "padding_top": 60,
        "padding_bottom": 60
      },
      "blocks": [
        {
          "id": "t1",
          "type": "testimonial",
          "settings": {
            "quote": "Absolutely love this product. It saves me hours every week and the support team is fantastic!",
            "author": "Sarah Johnson",
            "role": "Freelance Designer",
            "company": "Self-employed",
            "rating": 5,
            "date": "January 2025",
            "verified": true,
            "source": "google"
          }
        },
        {
          "id": "t2",
          "type": "testimonial",
          "settings": {
            "quote": "Best purchase I've made this year. Setup was a breeze and results were immediate.",
            "author": "Marcus Lee",
            "role": "Head of Marketing",
            "company": "Bright Ideas Inc.",
            "rating": 5,
            "date": "February 2025",
            "verified": true,
            "source": "trustpilot"
          }
        },
        {
          "id": "t3",
          "type": "testimonial",
          "settings": {
            "quote": "Highly recommend to anyone looking to streamline their workflow. 10 out of 10.",
            "author": "Priya Patel",
            "role": "Operations Lead",
            "company": "Velocity Co.",
            "rating": 5,
            "date": "March 2025",
            "verified": false,
            "source": "twitter"
          }
        }
      ]
    }
  ]
}
