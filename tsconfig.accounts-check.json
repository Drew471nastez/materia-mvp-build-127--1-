{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "next-env.d.ts",
    "lib/site-accounts/*.ts",
    "lib/site-contact/*.ts",
    "lib/storelib-theme/globals.ts",
    "lib/website-builder/account-pages.ts",
    "lib/website-builder/contact-client.ts",
    "app/api/site-account/**/*.ts",
    "app/api/website-builder/contact/route.ts",
    "app/account/site/**/*.tsx",
    "app/account/site/**/*.ts",
    "app/(site)/w/[username]/account/**/*.tsx",
    "app/(site)/w/[username]/account/**/*.ts",
    "app/(site)/w/[username]/wishlist/page.tsx",
    "app/(site)/w/[username]/render-account.tsx",
    "app/(site)/w/[username]/render-site.tsx",
    "app/(site)/w/[username]/visitor.ts",
    "components/website-builder/site-wishlist.tsx",
    "components/website-builder/sections/StorelibSection.tsx",
    "components/website-builder/sections/storelib-live.tsx",
    "components/website-builder/sections/renderers/ContactFormSection.tsx",
    "components/website-builder/sections/renderers/HeaderSection.tsx",
    "components/website-builder/sections/renderers/ProductSection.tsx",
    "components/website-builder/theme/ThemePage.tsx"
  ]
}
