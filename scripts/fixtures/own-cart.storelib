<template>
<section class="shop">
  <button type="button" class="bag" data-storelib-cart aria-label="Open cart"><span data-storelib-cart-count></span></button>
  <ul class="grid">
    {% for block in products %}
    <li class="card">
      <a href="{{ block.settings.url | url }}">{{ block.settings.title }}</a>
      <span>{{ block.settings.price }}</span>
      {% if block.settings.available %}
      <button type="button" data-storelib-add-to-cart="{{ block.id }}" data-title="{{ block.settings.title }}" data-price="{{ block.settings.price }}" data-image="{{ block.settings.image }}" data-url="{{ block.settings.url }}" data-kind="{{ block.settings.kind }}">{{ settings.add_label }}</button>
      {% endif %}
    </li>
    {% endfor %}
  </ul>
  <aside class="panel" data-storelib-cart-panel aria-label="Cart">
    <button type="button" data-storelib-cart-close aria-label="Close cart">Close</button>
    <p data-storelib-cart-empty>{{ settings.empty_text }}</p>
    <ul data-storelib-cart-lines>
      <li class="line" data-storelib-cart-line hidden><img data-line-image width="56" height="56" alt=""><a data-line-url><span data-line-title></span></a><span data-line-qty></span><span data-line-price></span><button type="button" data-line-dec aria-label="One less">-</button><button type="button" data-line-inc aria-label="One more">+</button><button type="button" data-line-remove>Remove</button></li>
    </ul>
    <div data-storelib-cart-filled><span data-storelib-cart-subtotal></span><button type="button" data-storelib-checkout>{{ settings.checkout_label }}</button></div>
  </aside>
</section>
</template>
<style>
.shop { container-type: inline-size; }
.panel { position: fixed; inset: 0 0 0 auto; width: min(420px, 100%); background: var(--s-bg, #fff); transform: translateX(100%); transition: transform 300ms ease; }
.panel[data-open="true"] { transform: none; }
@media (prefers-reduced-motion: reduce) { .panel { transition: none; } }
</style>
<schema>
{ "language_version": 1, "type": "own_cart", "name": "Shop with its own cart", "category": "products", "settings": [
  { "type": "text", "id": "add_label", "label": "Add button", "default": "Add to bag" },
  { "type": "text", "id": "empty_text", "label": "Empty cart text", "default": "Your bag is empty." },
  { "type": "text", "id": "checkout_label", "label": "Checkout button", "default": "Check out" }
], "presets": [{ "name": "Shop with its own cart" }] }
</schema>
