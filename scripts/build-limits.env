# Public build-only defaults. Explicit caller settings still take precedence.
RAYON_NUM_THREADS=2
TOKIO_WORKER_THREADS=2
# Turbopack's allocator (mimalloc) gives freed pages back at once instead of
# holding them, and commits arena memory as it is used: the build's peak on
# 4 CPUs fell from 8.8 GB to 8.4 GB with the same compile time and output
# (round 41, after Vercel's 8 GB Standard machine ran out of memory).
MIMALLOC_PURGE_DELAY=0
MIMALLOC_ARENA_EAGER_COMMIT=0
