# Copy to .env and fill in. Never commit .env.

# The shared secret Storelib sends as "Authorization: Bearer <secret>".
# Generate: openssl rand -hex 32   (same value goes in Vercel as CLAMAV_SERVICE_SECRET)
CLAMAV_SERVICE_SECRET=

# Port the API is published on, on this machine.
API_PORT=8080

# Largest file accepted, in bytes (1 GiB). Keep clamd's StreamMaxLength above it.
MAX_FILE_BYTES=1073741824

# From first byte to verdict, in milliseconds.
SCAN_TIMEOUT_MS=120000

# Scans sent to clamd at once, and how many more may wait.
MAX_CONCURRENT_SCANS=4
MAX_QUEUED_SCANS=32

# Per caller: scans a minute, plus a burst.
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=30

# Set to true only when a reverse proxy you run sets X-Forwarded-For.
TRUST_PROXY=false
