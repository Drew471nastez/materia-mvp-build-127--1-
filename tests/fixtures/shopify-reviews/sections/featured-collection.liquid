<div class="rv-grid page-width">
  <h2>{{ section.settings.heading }}</h2>
  {%- for card_product in collections.all.products limit: 8 -%}
    {% render 'card-product', card_product: card_product %}
  {%- endfor -%}
</div>
{% schema %}
{
  "name": "Featured collection",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "I più amati" }],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
