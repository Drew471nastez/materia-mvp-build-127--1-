{# A slim bar under the header: which service this page is about, and a two-way
   switch that jumps to the other one. Both options are links, so they work
   with no script and can point anywhere. #}

<template>
<section class="ldm" id="{{ settings.anchor }}" data-scheme="{{ settings.color_scheme }}" style="--ldm-pt: {{ settings.padding_top }}px; --ldm-pb: {{ settings.padding_bottom }}px; --ldm-accent: {{ settings.accent_color }};">
  <div class="ldm__in">
    <div class="ldm__copy">
      {% if settings.title %}<p class="ldm__title">{{ settings.title }}</p>{% endif %}
      {% if settings.text %}<p class="ldm__text">{{ settings.text }}</p>{% endif %}
    </div>
    {% if settings.show_switch %}
      <div class="ldm__switch" role="group" aria-label="{{ settings.switch_label }}">
        <a class="ldm__opt{% if settings.active == 'first' %} is-on{% endif %}" href="{{ settings.first_url | url }}" aria-current="{% if settings.active == 'first' %}true{% else %}false{% endif %}">{{ settings.first_label }}</a>
        <a class="ldm__opt{% if settings.active == 'second' %} is-on{% endif %}" href="{{ settings.second_url | url }}" aria-current="{% if settings.active == 'second' %}true{% else %}false{% endif %}">{{ settings.second_label }}</a>
      </div>
    {% endif %}
  </div>
</section>
</template>

<style>
.ldm {
  container-type: inline-size;
  background: var(--scheme-background);
  color: var(--scheme-text);
  font-family: var(--theme-font-body, "DM Sans"), ui-sans-serif, system-ui, sans-serif;
  scroll-margin-top: 88px;
}
.ldm__in {
  box-sizing: border-box;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 16px 24px;
  max-width: calc(var(--theme-page-width, 1160px) + 2 * var(--theme-padding-x, 24px));
  margin: 0 auto;
  padding: calc(var(--ldm-pt) * var(--theme-spacing-scale, 1)) var(--theme-padding-x, 24px) calc(var(--ldm-pb) * var(--theme-spacing-scale, 1));
}
.ldm__copy { min-width: 0; }
.ldm__title {
  margin: 0;
  font-family: var(--theme-font-heading, "DM Sans"), ui-sans-serif, system-ui, sans-serif;
  font-size: 17px;
  font-weight: 600;
  line-height: 1.3;
  letter-spacing: -0.01em;
  color: var(--scheme-heading);
}
.ldm__text { margin: 2px 0 0; font-size: 13px; line-height: 1.45; color: var(--scheme-text); }

.ldm__switch {
  display: inline-flex;
  gap: 4px;
  padding: 4px;
  border: 1px solid var(--scheme-border);
  border-radius: 10px;
  background: var(--scheme-background-secondary);
}
.ldm__opt {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 40px;
  padding: 0 22px;
  border-radius: 7px;
  font-size: 14px;
  font-weight: 600;
  line-height: 1;
  text-decoration: none;
  white-space: nowrap;
  color: var(--scheme-text);
  transition: background-color 160ms ease, color 160ms ease;
}
.ldm__opt:hover { color: var(--scheme-heading); }
.ldm__opt.is-on { background: var(--ldm-accent); color: #ffffff; }
.ldm__opt:focus-visible { outline: 2px solid var(--ldm-accent); outline-offset: 2px; }

@container (max-width: 560px) {
  .ldm__switch { width: 100%; }
  .ldm__opt { flex: 1 1 0; padding: 0 12px; }
}
@media (prefers-reduced-motion: reduce) {
  .ldm__opt { transition: none; }
}
</style>

<schema>
{
  "schema_version": 1,
  "type": "ld_mode_bar",
  "name": "LD Service switch",
  "category": "content",
  "description": "A slim bar naming the service, with a Done for you / Do it yourself switch",
  "supports_typography_overrides": false,
  "settings": [
    { "type": "header", "id": "hdr_content", "label": "Content" },
    { "type": "text", "id": "title", "label": "Title", "default": "Done for you" },
    { "type": "text", "id": "text", "label": "Text", "default": "I write and edit your LinkedIn posts." },
    { "type": "header", "id": "hdr_switch", "label": "Switch" },
    { "type": "toggle", "id": "show_switch", "label": "Show the switch", "default": true },
    { "type": "text", "id": "switch_label", "label": "Switch name for screen readers", "default": "Choose a service" },
    { "type": "text", "id": "first_label", "label": "First option", "default": "Done for you" },
    { "type": "url", "id": "first_url", "label": "First option link", "default": "#ghostwriting" },
    { "type": "text", "id": "second_label", "label": "Second option", "default": "Do it yourself" },
    { "type": "url", "id": "second_url", "label": "Second option link", "default": "#templates" },
    { "type": "radio", "id": "active", "label": "Highlighted option", "default": "first",
      "options": [{ "value": "first", "label": "First" }, { "value": "second", "label": "Second" }] },
    { "type": "header", "id": "hdr_style", "label": "Style" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "white" },
    { "type": "color", "id": "accent_color", "label": "Highlight", "default": "scheme.accent" },
    { "type": "text", "id": "anchor", "label": "Anchor id", "info": "Lets a link jump here, as #ghostwriting", "default": "ghostwriting" },
    { "type": "header", "id": "hdr_spacing", "label": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 26 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 26 }
  ],
  "presets": [{ "name": "LD Service switch" }]
}
</schema>
