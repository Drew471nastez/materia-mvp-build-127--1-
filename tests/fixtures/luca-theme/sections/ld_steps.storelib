{# A heading and a short sequence of steps, numbered in order, with an optional
   note underneath. The numbers come from the order of the steps, so dragging
   a step renumbers it. #}

<template>
<section class="lds" id="{{ settings.anchor }}" data-scheme="{{ settings.color_scheme }}" style="--lds-pt: {{ settings.padding_top }}px; --lds-pb: {{ settings.padding_bottom }}px; --lds-hs: {{ settings.heading_size }}; --lds-hsm: {{ settings.heading_size_mobile }}; --lds-accent: {{ settings.accent_color }}; --lds-cols: {{ settings.columns }};">
  <div class="lds__in">
    {% if settings.eyebrow or settings.heading or settings.text %}
      <div class="lds__head">
        {% if settings.eyebrow %}<p class="lds__eyebrow">{{ settings.eyebrow }}</p>{% endif %}
        {% if settings.heading %}<h2 class="lds__h">{{ settings.heading }}</h2>{% endif %}
        {% if settings.text %}<p class="lds__sub">{{ settings.text }}</p>{% endif %}
      </div>
    {% endif %}

    {% for block in blocks %}
      {% if forloop.first %}<ol class="lds__list">{% endif %}
      <li class="lds__step" data-block-id="{{ block.id }}">
        {% if settings.show_numbers %}<span class="lds__num" aria-hidden="true">{{ forloop.index }}</span>{% endif %}
        <h3 class="lds__title">{{ block.settings.title }}</h3>
        {% if block.settings.text %}<p class="lds__text">{{ block.settings.text }}</p>{% endif %}
      </li>
      {% if forloop.last %}</ol>{% endif %}
    {% else %}
      {% if page.in_editor %}<p class="lds__empty">Add steps in the sidebar</p>{% endif %}
    {% endfor %}

    {% if settings.note %}<p class="lds__note">{{ settings.note }}</p>{% endif %}
  </div>
</section>
</template>

<style>
.lds {
  container-type: inline-size;
  background: var(--scheme-background);
  color: var(--scheme-text);
  font-family: var(--theme-font-body, "DM Sans"), ui-sans-serif, system-ui, sans-serif;
  scroll-margin-top: 88px;
}
.lds__in {
  box-sizing: border-box;
  max-width: calc(var(--theme-page-width, 1160px) + 2 * var(--theme-padding-x, 24px));
  margin: 0 auto;
  padding: calc(var(--lds-pt) * var(--theme-spacing-scale, 1)) var(--theme-padding-x, 24px) calc(var(--lds-pb) * var(--theme-spacing-scale, 1));
}
.lds__head { max-width: 46rem; margin-bottom: 44px; }
.lds__eyebrow { margin: 0 0 18px; font-size: 13px; font-weight: 600; letter-spacing: 0.09em; text-transform: uppercase; color: var(--scheme-text); }
.lds__h {
  margin: 0;
  font-family: var(--theme-font-heading, "DM Sans"), ui-sans-serif, system-ui, sans-serif;
  font-size: clamp(calc(var(--lds-hsm) * 1px), calc(var(--lds-hs) * 0.0715cqi), calc(var(--lds-hs) * 1px));
  font-weight: 700;
  line-height: 1.06;
  letter-spacing: -0.045em;
  color: var(--scheme-heading);
  overflow-wrap: anywhere;
}
.lds__sub { margin: 20px 0 0; font-size: 17px; line-height: 1.65; color: var(--scheme-text); }

.lds__list { display: grid; grid-template-columns: minmax(0, 1fr); gap: 34px 40px; margin: 0; padding: 0; list-style: none; }
.lds__step { min-width: 0; }
.lds__num { display: block; margin-bottom: 22px; font-size: 18px; font-weight: 600; line-height: 1; color: var(--lds-accent); }
.lds__title {
  margin: 0;
  font-family: var(--theme-font-heading, "DM Sans"), ui-sans-serif, system-ui, sans-serif;
  font-size: 22px;
  font-weight: 600;
  line-height: 1.3;
  letter-spacing: -0.02em;
  color: var(--scheme-heading);
}
.lds__text { margin: 16px 0 0; max-width: 36em; font-size: 15.5px; line-height: 1.72; color: var(--scheme-text); }
.lds__note { margin: 64px 0 0; font-size: 13.5px; line-height: 1.6; color: var(--scheme-text); }
.lds__empty { margin: 0; padding: 28px 0; text-align: center; font-size: 14px; opacity: 0.7; }

@container (min-width: 820px) {
  .lds__list { grid-template-columns: repeat(var(--lds-cols, 3), minmax(0, 1fr)); }
}
@container (max-width: 520px) {
  .lds__head { margin-bottom: 32px; }
  .lds__num { margin-bottom: 14px; }
  .lds__title { font-size: 20px; }
  .lds__text { font-size: 15px; }
  .lds__note { margin-top: 40px; }
}
</style>

<schema>
{
  "schema_version": 1,
  "type": "ld_steps",
  "name": "LD How it works",
  "category": "features",
  "description": "Numbered steps in a row with a note underneath",
  "supports_typography_overrides": false,
  "settings": [
    { "type": "header", "id": "hdr_content", "label": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How it works" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "textarea", "id": "note", "label": "Note under the steps", "default": "As a starting point, set aside 15 to 30 minutes a week to share material and review drafts. This is a planning estimate; we agree a routine that works for you." },
    { "type": "header", "id": "hdr_layout", "label": "Layout" },
    { "type": "range", "id": "columns", "label": "Steps per row on a computer", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "toggle", "id": "show_numbers", "label": "Show step numbers", "default": true },
    { "type": "header", "id": "hdr_style", "label": "Style" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "white" },
    { "type": "color", "id": "accent_color", "label": "Number colour", "default": "scheme.accent" },
    { "type": "range", "id": "heading_size", "label": "Heading size on a computer", "min": 28, "max": 96, "step": 2, "unit": "px", "default": 54 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size on a phone", "min": 24, "max": 60, "step": 1, "unit": "px", "default": 34 },
    { "type": "text", "id": "anchor", "label": "Anchor id", "info": "Lets a link jump here, as #how-it-works", "default": "how-it-works" },
    { "type": "header", "id": "hdr_spacing", "label": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 104 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 8,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Tell me who you want to reach" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Share an old post or a voice note. I ask a few questions about your audience, your experience, and the points you want to make." }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "LD How it works",
      "blocks": [
        { "type": "step", "settings": { "title": "Tell me who you want to reach", "text": "Share an old post or a voice note. I ask a few questions about your audience, your experience, and the points you want to make. We can do this by email." } },
        { "type": "step", "settings": { "title": "Review two drafts", "text": "I choose an angle from your material and write two posts. Tell me which phrases feel right and which you would change; I use that feedback in the edit." } },
        { "type": "step", "settings": { "title": "Agree a monthly routine", "text": "If the drafts fit, we plan the next month. You approve and publish each post. We keep a record of your feedback so I can get closer to your voice. We also look at the questions and replies your posts receive to choose the next angles." } }
      ]
    }
  ]
}
</schema>
