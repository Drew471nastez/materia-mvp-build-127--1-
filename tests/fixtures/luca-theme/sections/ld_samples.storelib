{# Samples of the work, one per row: a draft drawn as a card on the left, and
   what it is, a short note and the link to the full PDF on the right. #}

<template>
<section class="ldw" id="{{ settings.anchor }}" data-scheme="{{ settings.color_scheme }}" style="--ldw-pt: {{ settings.padding_top }}px; --ldw-pb: {{ settings.padding_bottom }}px; --ldw-hs: {{ settings.heading_size }}; --ldw-hsm: {{ settings.heading_size_mobile }}; --ldw-accent: {{ settings.accent_color }}; --ldw-radius: {{ settings.card_radius }}px;">
  <div class="ldw__in">
    {% if settings.eyebrow or settings.heading or settings.text %}
      <div class="ldw__head">
        {% if settings.eyebrow %}<p class="ldw__eyebrow">{{ settings.eyebrow }}</p>{% endif %}
        {% if settings.heading %}<h2 class="ldw__h">{{ settings.heading }}</h2>{% endif %}
        {% if settings.text %}<p class="ldw__sub">{{ settings.text }}</p>{% endif %}
      </div>
    {% endif %}

    {% for block in blocks %}
      {% if forloop.first %}<div class="ldw__rows">{% endif %}
      <article class="ldw__row" data-block-id="{{ block.id }}">
        <div class="ldw__card">
          {% if block.settings.meta %}<p class="ldw__meta">{{ block.settings.meta }}</p>{% endif %}
          {% if block.settings.brand %}
            <p class="ldw__brand">
              {% if block.settings.logo %}<img class="ldw__logo" src="{{ block.settings.logo }}" alt="" width="36" height="36" loading="lazy">{% endif %}
              <span>{{ block.settings.brand }}</span>
            </p>
          {% endif %}
          <p class="ldw__headline">{{ block.settings.headline }}</p>
          {% if block.settings.pages %}<p class="ldw__pages">{{ block.settings.pages }}</p>{% endif %}
        </div>
        <div class="ldw__info">
          {% if block.settings.title %}<h3 class="ldw__title">{{ block.settings.title }}</h3>{% endif %}
          {% if block.settings.description %}<p class="ldw__desc">{{ block.settings.description }}</p>{% endif %}
          {% if block.settings.note %}<p class="ldw__note">{{ block.settings.note }}</p>{% endif %}
          {% if block.settings.file or block.settings.link_url %}
            {% if block.settings.link_label %}
              <a class="ldw__link" href="{% if block.settings.file %}{{ block.settings.file | url }}{% else %}{{ block.settings.link_url | url }}{% endif %}" target="{% if block.settings.new_tab %}_blank{% else %}_self{% endif %}" rel="noopener">{{ block.settings.link_label }}</a>
            {% endif %}
          {% elsif page.in_editor %}
            <p class="ldw__hint">Upload the PDF in this sample's settings to show “{{ block.settings.link_label }}”</p>
          {% endif %}
        </div>
      </article>
      {% if forloop.last %}</div>{% endif %}
    {% else %}
      {% if page.in_editor %}<p class="ldw__empty">Add samples in the sidebar</p>{% endif %}
    {% endfor %}
  </div>
</section>
</template>

<style>
.ldw {
  container-type: inline-size;
  background: var(--scheme-background);
  color: var(--scheme-text);
  font-family: var(--theme-font-body, "DM Sans"), ui-sans-serif, system-ui, sans-serif;
  scroll-margin-top: 88px;
}
.ldw__in {
  box-sizing: border-box;
  max-width: calc(var(--theme-page-width, 1160px) + 2 * var(--theme-padding-x, 24px));
  margin: 0 auto;
  padding: calc(var(--ldw-pt) * var(--theme-spacing-scale, 1)) var(--theme-padding-x, 24px) calc(var(--ldw-pb) * var(--theme-spacing-scale, 1));
}
.ldw__head { margin-bottom: 40px; }
.ldw__eyebrow { margin: 0 0 18px; font-size: 13px; font-weight: 600; letter-spacing: 0.09em; text-transform: uppercase; color: var(--scheme-text); }
.ldw__h {
  margin: 0;
  font-family: var(--theme-font-heading, "DM Sans"), ui-sans-serif, system-ui, sans-serif;
  font-size: clamp(calc(var(--ldw-hsm) * 1px), calc(var(--ldw-hs) * 0.0715cqi), calc(var(--ldw-hs) * 1px));
  font-weight: 700;
  line-height: 1.06;
  letter-spacing: -0.045em;
  color: var(--scheme-heading);
  overflow-wrap: anywhere;
}
.ldw__sub { margin: 22px 0 0; max-width: 72em; font-size: 17px; line-height: 1.65; color: var(--scheme-text); }

.ldw__rows { display: grid; gap: 40px; }
.ldw__row { display: grid; grid-template-columns: minmax(0, 1fr); gap: 28px; align-items: start; }
.ldw__card {
  box-sizing: border-box;
  min-width: 0;
  max-width: 320px;
  padding: 36px 30px 32px;
  border: 1px solid var(--scheme-border);
  border-top: 3px solid var(--ldw-accent);
  border-radius: var(--ldw-radius);
  background: var(--scheme-background-secondary);
  box-shadow: 0 10px 30px rgba(17, 20, 28, 0.05);
}
.ldw__meta { margin: 0 0 22px; font-size: 11px; font-weight: 500; line-height: 1.6; letter-spacing: 0.08em; text-transform: uppercase; color: var(--scheme-text-muted); }
.ldw__brand { display: flex; align-items: center; gap: 9px; margin: 0 0 26px; font-size: 14px; font-weight: 600; color: var(--scheme-heading); }
.ldw__logo { flex: none; width: 36px; height: 36px; border-radius: 50%; object-fit: cover; }
.ldw__headline {
  margin: 0;
  font-family: var(--theme-font-heading, "DM Sans"), ui-sans-serif, system-ui, sans-serif;
  font-size: 26px;
  font-weight: 600;
  line-height: 1.24;
  letter-spacing: -0.03em;
  color: var(--scheme-heading);
}
.ldw__pages { margin: 30px 0 0; font-size: 16px; font-weight: 600; color: var(--scheme-text); }

.ldw__info { min-width: 0; padding-top: 4px; }
.ldw__title {
  margin: 0;
  font-family: var(--theme-font-heading, "DM Sans"), ui-sans-serif, system-ui, sans-serif;
  font-size: 25px;
  font-weight: 600;
  line-height: 1.3;
  letter-spacing: -0.025em;
  color: var(--scheme-heading);
}
.ldw__desc { margin: 18px 0 0; max-width: 46em; font-size: 17px; line-height: 1.65; color: var(--scheme-text); }
.ldw__note { margin: 18px 0 0; font-size: 13.5px; line-height: 1.6; color: var(--scheme-text); }
.ldw__link {
  display: inline-block;
  margin-top: 24px;
  font-size: 17px;
  font-weight: 600;
  color: var(--scheme-heading);
  text-decoration: underline;
  text-decoration-thickness: 1.5px;
  text-underline-offset: 6px;
}
.ldw__link:hover { color: var(--ldw-accent); }
.ldw__link:focus-visible { outline: 2px solid var(--ldw-accent); outline-offset: 3px; }
.ldw__hint { display: inline-block; margin: 24px 0 0; padding: 8px 12px; border: 1px dashed var(--scheme-border); border-radius: 6px; font-size: 13px; color: var(--scheme-text); }
.ldw__empty { margin: 0; padding: 28px 0; text-align: center; font-size: 14px; opacity: 0.7; }

@container (min-width: 820px) {
  .ldw__row { grid-template-columns: 320px minmax(0, 1fr); gap: 50px; }
  .ldw__info { padding-top: 76px; }
}
@container (max-width: 520px) {
  .ldw__card { max-width: none; padding: 28px 24px 26px; }
  .ldw__headline { font-size: 23px; }
  .ldw__title { font-size: 21px; }
  .ldw__desc { font-size: 16px; }
  .ldw__link { font-size: 16px; }
}
</style>

<schema>
{
  "schema_version": 1,
  "type": "ld_samples",
  "name": "LD Writing samples",
  "category": "social-proof",
  "description": "Sample drafts, each a card with a description and a link to the PDF",
  "supports_typography_overrides": false,
  "settings": [
    { "type": "header", "id": "hdr_content", "label": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Work you can read now" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Two LinkedIn drafts prepared for Andrew Rullz, founder of Materia Themes and Storelib, with his permission to write in his name. Both are unpublished; the final wording remains subject to his review." },
    { "type": "header", "id": "hdr_style", "label": "Style" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "light" },
    { "type": "color", "id": "accent_color", "label": "Card accent", "default": "scheme.accent" },
    { "type": "range", "id": "heading_size", "label": "Heading size on a computer", "min": 28, "max": 96, "step": 2, "unit": "px", "default": 54 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size on a phone", "min": 24, "max": 60, "step": 1, "unit": "px", "default": 34 },
    { "type": "range", "id": "card_radius", "label": "Card corners", "min": 0, "max": 24, "step": 1, "unit": "px", "default": 10 },
    { "type": "text", "id": "anchor", "label": "Anchor id", "info": "Lets a link jump here, as #samples", "default": "samples" },
    { "type": "header", "id": "hdr_spacing", "label": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 88 }
  ],
  "blocks": [
    {
      "type": "sample",
      "name": "Sample",
      "limit": 10,
      "settings": [
        { "type": "header", "id": "hdr_card", "label": "Card" },
        { "type": "text", "id": "meta", "label": "Small label", "default": "Andrew Rullz · Unpublished draft" },
        { "type": "image_picker", "id": "logo", "label": "Brand logo" },
        { "type": "text", "id": "brand", "label": "Brand", "default": "Materia Themes" },
        { "type": "textarea", "id": "headline", "label": "Opening line", "default": "Before I launched Materia 1.0.0, I spent months testing and refining it." },
        { "type": "text", "id": "pages", "label": "Card footer", "default": "3 pages" },
        { "type": "header", "id": "hdr_info", "label": "Description" },
        { "type": "text", "id": "title", "label": "Title", "default": "Andrew Rullz on Materia Themes" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "A first-person draft about giving Shopify store owners more control over their product pages, with notes on the writing." },
        { "type": "text", "id": "note", "label": "Small note", "default": "Written with Andrew’s permission. Unpublished sample; no performance results are claimed." },
        { "type": "text", "id": "link_label", "label": "Link text", "default": "Open the 3-page PDF" },
        { "type": "file_picker", "id": "file", "label": "PDF file", "info": "Upload the PDF, or paste a link below" },
        { "type": "url", "id": "link_url", "label": "Link" },
        { "type": "toggle", "id": "new_tab", "label": "Open in a new tab", "default": true }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "LD Writing samples",
      "blocks": [
        { "type": "sample", "settings": { "brand": "Materia Themes", "headline": "Before I launched Materia 1.0.0, I spent months testing and refining it.", "title": "Andrew Rullz on Materia Themes", "description": "A first-person draft about giving Shopify store owners more control over their product pages, with notes on the writing." } },
        { "type": "sample", "settings": { "brand": "Storelib", "headline": "The first time I shared Storelib publicly, it was still in development.", "title": "Andrew Rullz on Storelib", "description": "A first-person draft about helping creators deliver a digital product after purchase, with notes on the writing." } }
      ]
    }
  ]
}
</schema>
