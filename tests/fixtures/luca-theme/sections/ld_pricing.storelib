{# Prices as plan cards. One plan can be marked as the one to start with: it
   gets the outline and the filled button. A two-way switch beside the heading
   links to the other service. Features are typed one per line. #}

<template>
<section class="ldp" id="{{ settings.anchor }}" data-scheme="{{ settings.color_scheme }}" style="--ldp-pt: {{ settings.padding_top }}px; --ldp-pb: {{ settings.padding_bottom }}px; --ldp-hs: {{ settings.heading_size }}; --ldp-hsm: {{ settings.heading_size_mobile }}; --ldp-accent: {{ settings.accent_color }}; --ldp-radius: {{ settings.card_radius }}px; --ldp-cols: {{ settings.columns }};">
  <div class="ldp__in">
    <div class="ldp__top">
      <div class="ldp__head">
        {% if settings.eyebrow %}<p class="ldp__eyebrow">{{ settings.eyebrow }}</p>{% endif %}
        {% if settings.heading %}<h2 class="ldp__h">{{ settings.heading }}</h2>{% endif %}
        {% if settings.text %}<p class="ldp__sub">{{ settings.text }}</p>{% endif %}
      </div>
      {% if settings.show_switch %}
        <div class="ldp__switch" role="group" aria-label="{{ settings.switch_label }}">
          <a class="ldp__opt{% if settings.active == 'first' %} is-on{% endif %}" href="{{ settings.first_url | url }}" aria-current="{% if settings.active == 'first' %}true{% else %}false{% endif %}">{{ settings.first_label }}</a>
          <a class="ldp__opt{% if settings.active == 'second' %} is-on{% endif %}" href="{{ settings.second_url | url }}" aria-current="{% if settings.active == 'second' %}true{% else %}false{% endif %}">{{ settings.second_label }}</a>
        </div>
      {% endif %}
    </div>

    {% for block in blocks %}
      {% if forloop.first %}<div class="ldp__grid">{% endif %}
      <article class="ldp__plan{% if block.settings.featured %} ldp__plan--on{% endif %}" data-block-id="{{ block.id }}">
        <h3 class="ldp__name">{{ block.settings.name }}</h3>
        <p class="ldp__price ldp__price--{{ block.settings.price_size }}">{{ block.settings.price }}</p>
        {% if block.settings.period %}<p class="ldp__period">{{ block.settings.period }}</p>{% endif %}
        {% for line in block.settings.features | lines %}
          {% if forloop.first %}<ul class="ldp__features">{% endif %}
          <li>{{ line }}</li>
          {% if forloop.last %}</ul>{% endif %}
        {% endfor %}
        {% if block.settings.button_label %}
          <a class="ldp__btn s__btn{% if block.settings.featured %} ldp__btn--primary{% else %} ldp__btn--secondary{% endif %}" href="{{ block.settings.button_url | url }}">{{ block.settings.button_label }}</a>
        {% endif %}
      </article>
      {% if forloop.last %}</div>{% endif %}
    {% else %}
      {% if page.in_editor %}<p class="ldp__empty">Add plans in the sidebar</p>{% endif %}
    {% endfor %}

    {% if settings.note %}<p class="ldp__note">{{ settings.note }}</p>{% endif %}
  </div>
</section>
</template>

<style>
.ldp {
  container-type: inline-size;
  background: var(--scheme-background);
  color: var(--scheme-text);
  font-family: var(--theme-font-body, "DM Sans"), ui-sans-serif, system-ui, sans-serif;
  scroll-margin-top: 88px;
}
.ldp__in {
  box-sizing: border-box;
  max-width: calc(var(--theme-page-width, 1160px) + 2 * var(--theme-padding-x, 24px));
  margin: 0 auto;
  padding: calc(var(--ldp-pt) * var(--theme-spacing-scale, 1)) var(--theme-padding-x, 24px) calc(var(--ldp-pb) * var(--theme-spacing-scale, 1));
}
.ldp__top { display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: 24px 40px; margin-bottom: 38px; }
.ldp__head { min-width: 0; max-width: 48rem; }
.ldp__eyebrow { margin: 0 0 18px; font-size: 13px; font-weight: 600; letter-spacing: 0.09em; text-transform: uppercase; color: var(--scheme-text); }
.ldp__h {
  margin: 0;
  font-family: var(--theme-font-heading, "DM Sans"), ui-sans-serif, system-ui, sans-serif;
  font-size: clamp(calc(var(--ldp-hsm) * 1px), calc(var(--ldp-hs) * 0.0715cqi), calc(var(--ldp-hs) * 1px));
  font-weight: 700;
  line-height: 1.06;
  letter-spacing: -0.045em;
  color: var(--scheme-heading);
  overflow-wrap: anywhere;
}
.ldp__sub { margin: 22px 0 0; max-width: 46em; font-size: 17px; line-height: 1.65; color: var(--scheme-text); }

.ldp__switch { display: inline-flex; flex: none; gap: 4px; margin-top: 22px; padding: 4px; border: 1px solid var(--scheme-border); border-radius: 10px; background: var(--scheme-background-secondary); }
.ldp__opt {
  display: inline-flex; align-items: center; justify-content: center;
  min-height: 40px; padding: 0 22px; border-radius: 7px;
  font-size: 14px; font-weight: 600; line-height: 1; white-space: nowrap;
  text-decoration: none; color: var(--scheme-text);
  transition: background-color 160ms ease, color 160ms ease;
}
.ldp__opt:hover { color: var(--scheme-heading); }
.ldp__opt.is-on { background: var(--ldp-accent); color: #ffffff; }
.ldp__opt:focus-visible { outline: 2px solid var(--ldp-accent); outline-offset: 2px; }

.ldp__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 20px; }
.ldp__plan {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  min-width: 0;
  padding: 44px 28px 28px;
  border: 1px solid var(--scheme-border);
  border-radius: var(--ldp-radius);
  background: var(--scheme-background);
}
.ldp__plan--on { border-color: var(--ldp-accent); }
.ldp__name {
  margin: 0;
  font-family: var(--theme-font-heading, "DM Sans"), ui-sans-serif, system-ui, sans-serif;
  font-size: 25px;
  font-weight: 600;
  line-height: 1.25;
  letter-spacing: -0.02em;
  color: var(--scheme-heading);
}
.ldp__price {
  margin: 34px 0 0;
  font-family: var(--theme-font-heading, "DM Sans"), ui-sans-serif, system-ui, sans-serif;
  font-size: 44px;
  font-weight: 600;
  line-height: 1.1;
  letter-spacing: -0.035em;
  color: var(--scheme-heading);
}
.ldp__price--compact { font-size: 35px; }
.ldp__period { margin: 12px 0 0; font-size: 14px; color: var(--scheme-text); }
.ldp__features { margin: 40px 0 48px; padding: 0; list-style: none; }
.ldp__features li { position: relative; padding-left: 18px; font-size: 15px; line-height: 1.55; color: var(--scheme-text); }
.ldp__features li + li { margin-top: 12px; }
.ldp__features li::before {
  content: ""; position: absolute; left: 3px; top: 0.66em;
  width: 5px; height: 5px; border-radius: 50%; background: var(--ldp-accent);
}
.ldp__btn {
  box-sizing: border-box;
  display: flex; align-items: center; justify-content: center;
  min-height: 52px; margin-top: auto; padding: 0 20px;
  border-radius: 6px;
  font-size: 15.5px; font-weight: 600; line-height: 1.2; text-align: center; text-decoration: none;
  transition: background-color 160ms ease, color 160ms ease;
}
.ldp__btn--primary { background: var(--scheme-button-primary); color: var(--scheme-button-primary-text); border: 1px solid var(--scheme-button-primary-border); }
.ldp__btn--primary:hover { background: var(--scheme-button-primary-hover); color: var(--scheme-button-primary-hover-text); }
.ldp__btn--secondary { background: var(--scheme-button-secondary); color: var(--scheme-button-secondary-text); border: 1px solid var(--scheme-button-secondary-border); }
.ldp__btn--secondary:hover { background: var(--scheme-button-secondary-hover); color: var(--scheme-button-secondary-hover-text); }
.ldp__btn:focus-visible { outline: 2px solid var(--ldp-accent); outline-offset: 3px; }
.ldp__note { margin: 26px 0 0; font-size: 13.5px; line-height: 1.6; color: var(--scheme-text); }
.ldp__empty { margin: 0; padding: 28px 0; text-align: center; font-size: 14px; opacity: 0.7; }

@container (min-width: 700px) {
  .ldp__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
@container (min-width: 1000px) {
  .ldp__grid { grid-template-columns: repeat(var(--ldp-cols, 3), minmax(0, 1fr)); }
}
@container (max-width: 520px) {
  .ldp__switch { width: 100%; }
  .ldp__opt { flex: 1 1 0; padding: 0 12px; }
  .ldp__plan { padding: 32px 22px 24px; }
  .ldp__price { margin-top: 24px; font-size: 38px; }
  .ldp__price--compact { font-size: 32px; }
  .ldp__features { margin: 28px 0 36px; }
}
@media (prefers-reduced-motion: reduce) {
  .ldp__opt, .ldp__btn { transition: none; }
}
</style>

<schema>
{
  "schema_version": 1,
  "type": "ld_pricing",
  "name": "LD Pricing plans",
  "category": "products",
  "description": "Plan cards with prices, features and a button, plus a service switch",
  "supports_typography_overrides": false,
  "settings": [
    { "type": "header", "id": "hdr_content", "label": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Two free drafts for selected prospects" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ghostwriting prices" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Choose the monthly cadence that fits how often you want to publish. Every paid post includes research from your material, a finished LinkedIn draft, and one edit round." },
    { "type": "textarea", "id": "note", "label": "Note under the plans", "default": "All prices are in USD. The free test is for selected direct prospects only, not Upwork. I do not promise reach, followers, leads, or viral posts." },
    { "type": "header", "id": "hdr_switch", "label": "Switch" },
    { "type": "toggle", "id": "show_switch", "label": "Show the switch", "default": true },
    { "type": "text", "id": "switch_label", "label": "Switch name for screen readers", "default": "Choose a service" },
    { "type": "text", "id": "first_label", "label": "First option", "default": "Done for you" },
    { "type": "url", "id": "first_url", "label": "First option link", "default": "#pricing" },
    { "type": "text", "id": "second_label", "label": "Second option", "default": "Do it yourself" },
    { "type": "url", "id": "second_url", "label": "Second option link", "default": "#templates" },
    { "type": "radio", "id": "active", "label": "Highlighted option", "default": "first",
      "options": [{ "value": "first", "label": "First" }, { "value": "second", "label": "Second" }] },
    { "type": "header", "id": "hdr_layout", "label": "Layout" },
    { "type": "range", "id": "columns", "label": "Plans per row on a computer", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "header", "id": "hdr_style", "label": "Style" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "white" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "scheme.accent" },
    { "type": "range", "id": "heading_size", "label": "Heading size on a computer", "min": 28, "max": 96, "step": 2, "unit": "px", "default": 54 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size on a phone", "min": 24, "max": 60, "step": 1, "unit": "px", "default": 34 },
    { "type": "range", "id": "card_radius", "label": "Card corners", "min": 0, "max": 24, "step": 1, "unit": "px", "default": 10 },
    { "type": "text", "id": "anchor", "label": "Anchor id", "info": "Lets a link jump here, as #pricing", "default": "pricing" },
    { "type": "header", "id": "hdr_spacing", "label": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 104 }
  ],
  "blocks": [
    {
      "type": "plan",
      "name": "Plan",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Consistent" },
        { "type": "text", "id": "price", "label": "Price", "default": "$200" },
        { "type": "select", "id": "price_size", "label": "Price size", "default": "normal",
          "options": [{ "value": "normal", "label": "Large" }, { "value": "compact", "label": "Smaller, for a range" }] },
        { "type": "text", "id": "period", "label": "Period", "default": "/ month" },
        { "type": "textarea", "id": "features", "label": "Features", "info": "One per line", "default": "Four finished LinkedIn posts\nAbout one post each week\nFounding price for the first three clients" },
        { "type": "text", "id": "button_label", "label": "Button text", "default": "Choose Consistent" },
        { "type": "url", "id": "button_url", "label": "Button link", "default": "#contact" },
        { "type": "toggle", "id": "featured", "label": "Highlight this plan", "default": false }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "LD Pricing plans",
      "blocks": [
        { "type": "plan", "settings": { "name": "Two free posts", "price": "Free", "period": "", "features": "For selected direct prospects\nTwo finished drafts from your material\nSee whether the writing fits before paying", "button_label": "Ask if it fits", "button_url": "#contact", "featured": true } },
        { "type": "plan", "settings": { "name": "Consistent", "price": "$200", "period": "/ month", "features": "Four finished LinkedIn posts\nAbout one post each week\nFounding price for the first three clients", "button_label": "Choose Consistent", "button_url": "#contact", "featured": false } },
        { "type": "plan", "settings": { "name": "Editorial", "price": "$800 to $1,500", "price_size": "compact", "period": "/ month", "features": "Eight to twelve posts\nFor a regular publishing rhythm\nScope and timing agreed before the month starts", "button_label": "Ask about Editorial", "button_url": "#contact", "featured": false } }
      ]
    }
  ]
}
</schema>
