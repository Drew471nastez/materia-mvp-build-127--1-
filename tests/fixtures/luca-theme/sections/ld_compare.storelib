{# A heading and two cards side by side: the way things are now, and the way
   they are with you. One card can be marked to carry the coloured top edge.
   Each card's list is typed one point per line. #}

<template>
<section class="ldc" id="{{ settings.anchor }}" data-scheme="{{ settings.color_scheme }}" style="--ldc-pt: {{ settings.padding_top }}px; --ldc-pb: {{ settings.padding_bottom }}px; --ldc-hs: {{ settings.heading_size }}; --ldc-hsm: {{ settings.heading_size_mobile }}; --ldc-accent: {{ settings.accent_color }}; --ldc-radius: {{ settings.card_radius }}px;">
  <div class="ldc__in">
    {% if settings.eyebrow or settings.heading or settings.text %}
      <div class="ldc__head">
        {% if settings.eyebrow %}<p class="ldc__eyebrow">{{ settings.eyebrow }}</p>{% endif %}
        {% if settings.heading %}<h2 class="ldc__h">{{ settings.heading }}</h2>{% endif %}
        {% if settings.text %}<p class="ldc__sub">{{ settings.text }}</p>{% endif %}
      </div>
    {% endif %}

    {% for block in blocks %}
      {% if forloop.first %}<div class="ldc__grid">{% endif %}
      <article class="ldc__card{% if block.settings.highlight %} ldc__card--on{% endif %}" data-block-id="{{ block.id }}">
        {% if block.settings.label %}<p class="ldc__label">{{ block.settings.label }}</p>{% endif %}
        {% if block.settings.title %}<h3 class="ldc__title">{{ block.settings.title }}</h3>{% endif %}
        {% if block.settings.text %}<p class="ldc__text">{{ block.settings.text }}</p>{% endif %}
        {% for line in block.settings.points | lines %}
          {% if forloop.first %}<ul class="ldc__points">{% endif %}
          <li>{{ line }}</li>
          {% if forloop.last %}</ul>{% endif %}
        {% endfor %}
      </article>
      {% if forloop.last %}</div>{% endif %}
    {% else %}
      {% if page.in_editor %}<p class="ldc__empty">Add cards in the sidebar</p>{% endif %}
    {% endfor %}
  </div>
</section>
</template>

<style>
.ldc {
  container-type: inline-size;
  background: var(--scheme-background);
  color: var(--scheme-text);
  font-family: var(--theme-font-body, "DM Sans"), ui-sans-serif, system-ui, sans-serif;
  scroll-margin-top: 88px;
}
.ldc__in {
  box-sizing: border-box;
  max-width: calc(var(--theme-page-width, 1160px) + 2 * var(--theme-padding-x, 24px));
  margin: 0 auto;
  padding: calc(var(--ldc-pt) * var(--theme-spacing-scale, 1)) var(--theme-padding-x, 24px) calc(var(--ldc-pb) * var(--theme-spacing-scale, 1));
}
.ldc__head { max-width: 46rem; margin-bottom: 36px; }
.ldc__eyebrow { margin: 0 0 18px; font-size: 13px; font-weight: 600; line-height: 1.3; letter-spacing: 0.09em; text-transform: uppercase; color: var(--scheme-text); }
.ldc__h {
  margin: 0;
  max-width: 10.4em;
  font-family: var(--theme-font-heading, "DM Sans"), ui-sans-serif, system-ui, sans-serif;
  font-size: clamp(calc(var(--ldc-hsm) * 1px), calc(var(--ldc-hs) * 0.0715cqi), calc(var(--ldc-hs) * 1px));
  font-weight: 700;
  line-height: 1.06;
  letter-spacing: -0.045em;
  color: var(--scheme-heading);
  overflow-wrap: anywhere;
}
.ldc__sub { margin: 22px 0 0; max-width: 46em; font-size: 17px; line-height: 1.65; color: var(--scheme-text); }

.ldc__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 24px; }
.ldc__card {
  box-sizing: border-box;
  min-width: 0;
  padding: 34px 32px 38px;
  border: 1px solid var(--scheme-border);
  border-radius: var(--ldc-radius);
  background: var(--scheme-background-secondary);
}
.ldc__card--on { border-top: 3px solid var(--ldc-accent); padding-top: 32px; }
.ldc__label { margin: 0 0 16px; font-size: 13px; font-weight: 600; letter-spacing: 0.09em; text-transform: uppercase; color: var(--scheme-text); }
.ldc__title {
  margin: 0;
  font-family: var(--theme-font-heading, "DM Sans"), ui-sans-serif, system-ui, sans-serif;
  font-size: 24px;
  font-weight: 600;
  line-height: 1.3;
  letter-spacing: -0.02em;
  color: var(--scheme-heading);
}
.ldc__text { margin: 18px 0 0; font-size: 17px; line-height: 1.65; color: var(--scheme-text); }
.ldc__points { margin: 22px 0 0; padding: 0; list-style: none; }
.ldc__points li { position: relative; padding-left: 21px; font-size: 17px; line-height: 1.6; color: var(--scheme-text); }
.ldc__points li + li { margin-top: 13px; }
.ldc__points li::before {
  content: "";
  position: absolute;
  left: 2px;
  top: 0.68em;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--ldc-accent);
}
.ldc__empty { margin: 0; padding: 28px 0; text-align: center; font-size: 14px; opacity: 0.7; }

@container (min-width: 820px) {
  .ldc__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
@container (max-width: 520px) {
  .ldc__sub, .ldc__text, .ldc__points li { font-size: 16px; }
  .ldc__card { padding: 26px 22px 28px; }
  .ldc__title { font-size: 21px; }
}
</style>

<schema>
{
  "schema_version": 1,
  "type": "ld_compare",
  "name": "LD Before and after",
  "category": "features",
  "description": "A heading and two cards that compare the old way with the new one",
  "supports_typography_overrides": false,
  "settings": [
    { "type": "header", "id": "hdr_content", "label": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "A simpler publishing routine" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Turn a customer conversation into a post." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Here is how we can work from something you already know. The example below illustrates the process." },
    { "type": "header", "id": "hdr_style", "label": "Style" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "light" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "scheme.accent" },
    { "type": "range", "id": "heading_size", "label": "Heading size on a computer", "min": 28, "max": 96, "step": 2, "unit": "px", "default": 54 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size on a phone", "min": 24, "max": 60, "step": 1, "unit": "px", "default": 34 },
    { "type": "range", "id": "card_radius", "label": "Card corners", "min": 0, "max": 24, "step": 1, "unit": "px", "default": 10 },
    { "type": "text", "id": "anchor", "label": "Anchor id", "info": "Lets a link jump here, as #how" },
    { "type": "header", "id": "hdr_spacing", "label": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 88 }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "On your own" },
        { "type": "text", "id": "title", "label": "Title", "default": "The idea stays in your notes." },
        { "type": "textarea", "id": "text", "label": "Text", "default": "You have something useful to share after a customer call. Writing it up becomes another task to get back to." },
        { "type": "textarea", "id": "points", "label": "Points", "info": "One per line", "default": "Ideas scattered across notes and voice memos\nA draft waiting for a clearer opening\nFinding time to write and edit" },
        { "type": "toggle", "id": "highlight", "label": "Coloured top edge", "default": false }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "LD Before and after",
      "blocks": [
        { "type": "card", "settings": { "label": "On your own", "title": "The idea stays in your notes.", "text": "You have something useful to share after a customer call. Writing it up becomes another task to get back to.", "points": "Ideas scattered across notes and voice memos\nA draft waiting for a clearer opening\nFinding time to write and edit", "highlight": false } },
        { "type": "card", "settings": { "label": "Working with me", "title": "A draft you can review.", "text": "Send the material you already have. I work through it, write the post, and make changes from your feedback.", "points": "Your experience supplies the subject\nI handle the writing and editing\nYou approve every post before publishing", "highlight": true } }
      ]
    }
  ]
}
</schema>
