    "ld_about-1791000000009": {
      "type": "ld_about",
      "name": "LD About me",
      "settings": {
        "image": "https://lucadragoste.ro/luca-dragoste.webp",
        "image_focus": "50% 30%",
        "image_alt": "Luca Dragoste",
        "eyebrow": "About me",
        "heading": "One writer, from research to final edit.",
        "content": "<p>I’m Luca Dragoste, an Advertising student at SNSPA in Bucharest, and I write LinkedIn posts for founders.</p><p>You work directly with me. I ask about the details behind an idea, check the facts, and revise the wording with you.</p>",
        "color_scheme": "white",
        "anchor": "about"
      },
      "hidden": false,
      "blocks": {},
