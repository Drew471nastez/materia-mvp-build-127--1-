    "ld_faq-1791000000010": {
      "type": "ld_faq",
      "name": "LD Questions",
      "settings": {
        "eyebrow": "Before we start",
        "heading": "Before we work together",
        "one_at_a_time": true,
        "color_scheme": "light",
        "anchor": "faq"
      },
      "hidden": false,
      "blocks": {
        "block-ld-fq-1": {
          "type": "qa",
          "settings": {
            "question": "Will it sound like me?",
            "answer": "<p>That is the aim. I write from your notes, your old posts and how you talk about your work. You mark the phrases that feel right and the ones you would change, and each draft gets closer to your voice.</p>",
            "open": false
          }
        },
        "block-ld-fq-2": {
          "type": "qa",
          "settings": {
            "question": "Do you use AI?",
            "answer": "<p>I may use AI tools for research and to check a draft, but the angle, the writing and the edits are mine, and every post is built from your own material. Nothing is published without your approval.</p>",
            "open": false
          }
        },
        "block-ld-fq-3": {
          "type": "qa",
          "settings": {
            "question": "How much of my time does it take?",
            "answer": "<p>As a starting point, set aside 15 to 30 minutes a week to share material and review drafts. We agree a routine that works for you.</p>",
            "open": false
          }
        },
        "block-ld-fq-4": {
          "type": "qa",
          "settings": {
            "question": "What if I don't like the first posts?",
            "answer": "<p>The first two drafts are free for selected prospects, so you can see whether the writing fits before paying. If it does not, you owe nothing.</p>",
            "open": false
          }
        }
      },
      "block_order": [
        "block-ld-fq-1",
        "block-ld-fq-2",
        "block-ld-fq-3",
        "block-ld-fq-4"
      ]
    },
