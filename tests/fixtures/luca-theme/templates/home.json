    "ld_compare-1791000000004": {
      "type": "ld_compare",
      "name": "LD Before and after",
      "settings": {
        "eyebrow": "A simpler publishing routine",
        "heading": "Turn a customer conversation into a post.",
        "text": "Here is how we can work from something you already know. The example below illustrates the process.",
        "color_scheme": "light",
        "anchor": "process"
      },
      "hidden": false,
      "blocks": {
        "block-ld-cmp-1": {
          "type": "card",
          "settings": {
            "label": "On your own",
            "title": "The idea stays in your notes.",
            "text": "You have something useful to share after a customer call. Writing it up becomes another task to get back to.",
            "points": "Ideas scattered across notes and voice memos\nA draft waiting for a clearer opening\nFinding time to write and edit",
            "highlight": false
          }
        },
        "block-ld-cmp-2": {
          "type": "card",
          "settings": {
            "label": "Working with me",
            "title": "A draft you can review.",
            "text": "Send the material you already have. I work through it, write the post, and make changes from your feedback.",
            "points": "Your experience supplies the subject\nI handle the writing and editing\nYou approve every post before publishing",
            "highlight": true
          }
        }
      },
      "block_order": [
        "block-ld-cmp-1",
        "block-ld-cmp-2"
      ]
    },
    "ld_steps-1791000000005": {
      "type": "ld_steps",
      "name": "LD How it works",
      "settings": {
        "heading": "How it works",
        "note": "As a starting point, set aside 15 to 30 minutes a week to share material and review drafts. This is a planning estimate; we agree a routine that works for you.",
        "columns": 3,
        "show_numbers": true,
        "color_scheme": "white",
        "anchor": "how-it-works"
      },
      "hidden": false,
      "blocks": {
        "block-ld-st-1": {
          "type": "step",
          "settings": {
            "title": "Tell me who you want to reach",
            "text": "Share an old post or a voice note. I ask a few questions about your audience, your experience, and the points you want to make. We can do this by email."
          }
        },
        "block-ld-st-2": {
          "type": "step",
          "settings": {
            "title": "Review two drafts",
            "text": "I choose an angle from your material and write two posts. Tell me which phrases feel right and which you would change; I use that feedback in the edit."
          }
        },
        "block-ld-st-3": {
          "type": "step",
          "settings": {
            "title": "Agree a monthly routine",
            "text": "If the drafts fit, we plan the next month. You approve and publish each post. We keep a record of your feedback so I can get closer to your voice. We also look at the questions and replies your posts receive to choose the next angles."
          }
        }
      },
      "block_order": [
        "block-ld-st-1",
        "block-ld-st-2",
        "block-ld-st-3"
      ]
    },
