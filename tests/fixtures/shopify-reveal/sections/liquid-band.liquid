<div class="band">
  {%- for i in (1..3) -%}
    <div class="band__card{% unless request.design_mode %} js-reveal{% endunless %}" data-probe="liquid-{{ i }}">Liquid {{ i }}</div>
  {%- endfor -%}
</div>
{% schema %}
{ "name": "Liquid band", "presets": [ { "name": "Liquid band" } ] }
{% endschema %}
