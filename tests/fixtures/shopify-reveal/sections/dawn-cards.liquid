<div class="band">
  {%- for i in (1..3) -%}
    <div class="band__card scroll-trigger animate--slide-in" data-cascade style="--animation-order: {{ forloop.index }};" data-probe="dawn-{{ i }}">{{ section.settings.heading }} {{ i }}</div>
  {%- endfor -%}
</div>
{% schema %}
{ "name": "Dawn cards", "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Dawn" } ], "presets": [ { "name": "Dawn cards" } ] }
{% endschema %}
