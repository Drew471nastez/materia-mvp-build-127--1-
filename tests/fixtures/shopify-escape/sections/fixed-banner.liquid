<style>
  .fb { padding: 30px 0; background: #fff7d6; }
  .fb__bar { position: fixed; top: 0; left: 0; right: 0; height: 2000px; z-index: 99999; background: rgba(255, 0, 200, 0.6); }
</style>
<div class="fb"><p class="page-width">{{ section.settings.text }}</p><div class="fb__bar"></div></div>
{% schema %}
{ "name": "Fixed Banner", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Free shipping this week" } ],
  "presets": [ { "name": "Fixed Banner", "category": "Banners" } ] }
{% endschema %}
