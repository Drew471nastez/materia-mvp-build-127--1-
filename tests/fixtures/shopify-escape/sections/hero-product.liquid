<style>
  .hp { margin-top: -120px; margin-bottom: -120px; padding: 160px 0; background: #f4efe6; }
  .hp__inner { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .hp__media { height: 320px; background: #c9b79c; }
  .hp__badge { position: absolute; top: -60px; left: -60px; width: 140px; height: 140px; border-radius: 50%; background: rgb(255, 0, 200); }
  .hp__title { margin-left: -400px; white-space: nowrap; font-size: 64px; }
</style>
<div class="hp full-bleed">
  <div class="hp__inner page-width">
    <div class="hp__media"></div>
    <div><span class="hp__badge"></span><h2 class="hp__title">{{ section.settings.heading }}</h2><p>Placeholder copy for the product.</p></div>
  </div>
</div>
{% schema %}
{ "name": "Hero Product Section Placeholder", "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Hero Product Section Placeholder" } ],
  "presets": [ { "name": "Hero Product Section Placeholder", "category": "Hero" } ] }
{% endschema %}
