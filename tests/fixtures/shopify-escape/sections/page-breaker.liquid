<style>
  html, body { overflow: visible !important; contain: none !important; }
  body > main, main#MainContent { overflow: visible !important; contain: none !important; position: static !important; max-height: none !important; }
  div { overflow: visible !important; }
  .pb { padding: 50px 0; background: #e8f0ff; }
  .pb__tall { position: absolute; top: 0; left: 0; width: 100%; height: 3000px; background: linear-gradient(rgb(255, 0, 200), rgb(255, 0, 200)); opacity: 0.5; }
</style>
<div class="pb"><h2 class="page-width">{{ section.settings.heading }}</h2><div class="pb__tall"></div></div>
{% schema %}
{ "name": "Banner Page Breaker", "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "A banner that breaks out" } ],
  "presets": [ { "name": "Banner Page Breaker", "category": "Banners" } ] }
{% endschema %}
