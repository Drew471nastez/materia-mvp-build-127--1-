<template>
<section class="cols" data-scheme="{{ settings.color_scheme }}" style="--d: {{ settings.columns.desktop }}; --t: {{ settings.columns.tablet }}; --m: {{ settings.columns.mobile }}; background: {{ scheme.bg }}; color: {{ scheme.heading }}">
  <h2>{{ settings.heading | default: "Columns" }}</h2>
</section>
</template>

<style scoped>
.cols { display: grid; grid-template-columns: repeat(var(--d), 1fr); padding: {{ settings.padding }}px 0; }
@container (max-width: 900px) { .cols { grid-template-columns: repeat(var(--t), 1fr); } }
@container (max-width: 600px) { .cols { grid-template-columns: repeat(var(--m), 1fr); } }
</style>

<schema>
{
  "type": "columns",
  "name": "Columns",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "" },
    { "type": "range", "id": "columns", "label": "Columns", "default": 3, "min": 1, "max": 4, "step": 1, "responsive": true },
    { "type": "range", "id": "padding", "label": "Padding", "default": 40, "min": 0, "max": 120, "step": 4, "unit": "px" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Scheme", "default": "white" }
  ],
  "allowed_templates": ["index", "page"],
  "presets": [{ "name": "Three columns" }, { "name": "Four columns", "settings": { "columns": 4 } }],
  "future_setting_key": "kept"
}
</schema>
