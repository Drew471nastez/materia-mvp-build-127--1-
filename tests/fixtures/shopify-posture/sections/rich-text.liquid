<div class="rich-text reveal">
  {%- for block in section.blocks -%}
    {%- case block.type -%}
      {%- when 'heading' -%}<h2 {{ block.shopify_attributes }}>{{ block.settings.heading }}</h2>
      {%- when 'text' -%}<div class="rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
      {%- when 'button' -%}<a class="button" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
    {%- endcase -%}
  {%- endfor -%}
</div>
{% schema %}
{ "name": "Rich text", "blocks": [
  { "type": "heading", "name": "Heading", "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Feel the difference" } ] },
  { "type": "text", "name": "Text", "settings": [ { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Worn by thousands every day.</p>" } ] },
  { "type": "button", "name": "Button", "settings": [ { "type": "text", "id": "label", "label": "Label", "default": "Read more" }, { "type": "url", "id": "link", "label": "Link" } ] }
], "presets": [ { "name": "Rich text" } ] }
{% endschema %}
