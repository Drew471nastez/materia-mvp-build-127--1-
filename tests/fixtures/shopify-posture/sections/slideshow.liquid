<div class="slideshow reveal" data-slideshow>
  <div class="slideshow__track">
    {%- for block in section.blocks -%}
      <div class="slideshow__slide" {{ block.shopify_attributes }}>
        <div class="slideshow__media" style="background:{{ block.settings.color }}"></div>
        <div class="slideshow__content">
          <p class="slideshow__rating">4.9 / 5</p>
          <h2>{{ block.settings.heading }}</h2>
          <p>{{ block.settings.text }}</p>
          {%- if block.settings.button_label != blank -%}<a class="button" href="{{ block.settings.button_link }}">{{ block.settings.button_label }}</a>{%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{ "name": "Slideshow", "blocks": [ { "type": "slide", "name": "Slide", "settings": [
  { "type": "text", "id": "heading", "label": "Heading", "default": "Stand straighter" },
  { "type": "text", "id": "text", "label": "Text", "default": "Support for your back" },
  { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
  { "type": "url", "id": "button_link", "label": "Button link" },
  { "type": "color", "id": "color", "label": "Colour", "default": "#22252b" }
] } ], "presets": [ { "name": "Slideshow" } ] }
{% endschema %}
