{%- comment -%}
  The hero the owner's Materia storefront opens on: a picture for the
  computer and another for the phone, stars, a large headline that rises in
  when its slide becomes the current one, and a slider that sizes its slides
  in pixels from its own width, again on resize (debounced) and from scratch
  when the page crosses the phone breakpoint, as section packs' sliders do.
{%- endcomment -%}
<div class="hero" data-slider data-hero data-slider-debounce="250">
  <div class="hero__viewport" data-viewport>
    <div class="hero__track" data-track>
      {%- for block in section.blocks -%}
        <div class="hero__slide{% if forloop.first %} is-active{% endif %}" data-slide {{ block.shopify_attributes }}>
          <div class="hero__media">
            {%- if block.settings.image != blank -%}<img class="hero__img hero__img--desktop" src="{{ block.settings.image | image_url: width: 1800 }}" alt="" width="1800" height="900" loading="lazy">{%- endif -%}
            {%- if block.settings.mobile_image != blank -%}<img class="hero__img hero__img--mobile" src="{{ block.settings.mobile_image | image_url: width: 900 }}" alt="" width="900" height="700" loading="lazy">{%- endif -%}
          </div>
          <div class="hero__content">
            <div class="hero__rating hero__anim"><span class="hero__stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span> <span>{{ block.settings.rating_text }}</span></div>
            <h2 class="hero__heading hero__anim">{{ block.settings.heading }}</h2>
            <p class="hero__text hero__anim">{{ block.settings.text }}</p>
            {%- if block.settings.button_label != blank -%}<a class="hero__button hero__anim" href="{{ block.settings.button_link }}">{{ block.settings.button_label }}</a>{%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>
{% schema %}
{ "name": "Slideshow", "blocks": [ { "type": "slide", "name": "Slide", "settings": [
  { "type": "image_picker", "id": "image", "label": "Desktop image" },
  { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
  { "type": "text", "id": "rating_text", "label": "Rating", "default": "Scelto da oltre 1.250 clienti" },
  { "type": "text", "id": "heading", "label": "Heading", "default": "Alimenta la tua concentrazione." },
  { "type": "text", "id": "text", "label": "Text", "default": "" },
  { "type": "text", "id": "button_label", "label": "Button label", "default": "Acquista ora" },
  { "type": "url", "id": "button_link", "label": "Button link" }
] } ], "presets": [ { "name": "Slideshow", "category": "Hero" } ] }
{% endschema %}
