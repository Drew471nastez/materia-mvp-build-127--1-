<header class="hd" data-sticky>
  <div class="hd__inner">
    <button type="button" class="hd__burger" aria-label="Menu"><span></span><span></span><span></span></button>
    <a href="{{ routes.root_url }}" class="hd__logo">
      {%- if section.settings.logo != blank -%}
        <img src="{{ section.settings.logo | image_url: width: 200 }}" alt="{{ shop.name }}" width="56" height="56">
      {%- else -%}
        <span>{{ shop.name }}</span>
      {%- endif -%}
    </a>
    <nav class="hd__nav" aria-label="Principale">
      <ul>
        {%- for link in linklists[section.settings.menu].links -%}
          <li><a href="{{ link.url }}">{{ link.title }}</a></li>
        {%- endfor -%}
      </ul>
    </nav>
    <div class="hd__icons">
      <span class="hd__currency">EUR &euro;</span>
      <a href="{{ routes.search_url }}" class="hd__icon" aria-label="Cerca">S</a>
      <a href="{{ routes.account_url }}" class="hd__icon hd__icon--desk" aria-label="Account">A</a>
      <a href="{{ routes.cart_url }}" class="hd__icon" aria-label="Carrello">C</a>
    </div>
  </div>
</header>
{% schema %}
{ "name": "Header", "class": "section-header", "settings": [
  { "type": "image_picker", "id": "logo", "label": "Logo" },
  { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" }
] }
{% endschema %}
