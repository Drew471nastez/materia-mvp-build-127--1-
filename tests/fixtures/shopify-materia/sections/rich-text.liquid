<div class="rt reveal">
  <h2>{{ section.settings.heading }}</h2>
  <p>{{ section.settings.text }}</p>
</div>
{% schema %}
{ "name": "Rich text", "settings": [
  { "type": "text", "id": "heading", "label": "Heading", "default": "Fatto per le giornate lunghe" },
  { "type": "text", "id": "text", "label": "Text", "default": "Una formula semplice, testata da chi lavora otto ore davanti a uno schermo." }
], "presets": [ { "name": "Rich text" } ] }
{% endschema %}
