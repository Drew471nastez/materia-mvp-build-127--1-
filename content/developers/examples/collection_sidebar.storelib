<template>
<section class="cs" data-scheme="{{ settings.color_scheme }}" style="--cs-pt: {{ settings.padding_top }}px; --cs-pb: {{ settings.padding_bottom }}px; --cs-cols: {{ settings.columns }};">
  <div class="cs__in">
    <header class="cs__head">
      <h1 class="cs__title">{% if collection %}{{ collection.title }}{% else %}{{ settings.heading }}{% endif %}</h1>
      {% if collection.description %}<p class="cs__desc">{{ collection.description }}</p>{% endif %}
    </header>
    <div class="cs__body">
      {% if page.filters %}
      <form class="cs__side" action="{{ page.filters.path | url }}" method="get" data-storelib-filters>
        {% if page.filters.q %}<input type="hidden" name="q" value="{{ page.filters.q }}">{% endif %}
        <details class="cs__panel" open>
          <summary class="cs__sum">{{ settings.filter_label }}{% if page.filters.active_count > 0 %} ({{ page.filters.active_count }}){% endif %}</summary>
          {% for g in page.filters.groups %}
            <fieldset class="cs__group">
              <legend class="cs__legend">{{ g.label }}</legend>
              {% for v in g.values %}
                <label class="cs__opt"><input type="checkbox" name="{{ g.param }}" value="{{ v.value }}"{% if v.checked %} checked{% endif %}{% if v.disabled %} disabled{% endif %}><span>{{ v.label }}</span><span class="cs__n">{{ v.count }}</span></label>
              {% endfor %}
            </fieldset>
          {% endfor %}
          {% if page.filters.price.show %}
            <fieldset class="cs__group">
              <legend class="cs__legend">{{ settings.range_label }}</legend>
              <div class="cs__price">
                <input type="number" name="price_min" min="0" inputmode="numeric" placeholder="{{ page.filters.price.min }}" value="{{ page.filters.price.from }}" aria-label="Lowest price">
                <input type="number" name="price_max" min="0" inputmode="numeric" placeholder="{{ page.filters.price.max }}" value="{{ page.filters.price.to }}" aria-label="Highest price">
              </div>
            </fieldset>
          {% endif %}
          <button type="submit" class="cs__apply" data-sl-button>{{ settings.apply_label }}</button>
          {% if page.filters.active %}<a class="cs__clear" href="{{ page.filters.clear_url | url }}">{{ settings.clear_label }}</a>{% endif %}
        </details>
      </form>
      {% endif %}
      <div class="cs__main">
        {% if page.filters %}
        <form class="cs__bar" action="{{ page.filters.path | url }}" method="get" data-storelib-filters>
          <p class="cs__count" aria-live="polite">{{ page.filters.count_label }}</p>
          <label class="cs__sort">{{ settings.sort_label }}
            <select name="sort">{% for o in page.filters.sort_options %}<option value="{{ o.value }}"{% if o.selected %} selected{% endif %}>{{ o.label }}</option>{% endfor %}</select>
          </label>
        </form>
        {% endif %}
        <div class="cs__grid">
          {% for block in products %}
            <a class="cs__card" href="{{ block.settings.url | url }}" data-card="product">
              <span class="cs__media" data-card-media>{% if block.settings.image != "" %}<img src="{{ block.settings.image }}" alt="{{ block.settings.title }}" loading="lazy">{% endif %}</span>
              <span class="cs__name">{{ block.settings.title }}</span>
              <span class="cs__cost">{{ block.settings.price }}{% if block.settings.compare_price != "" %} <s>{{ block.settings.compare_price }}</s>{% endif %}</span>
            </a>
          {% else %}
            <p class="cs__none">{{ settings.empty_text }}</p>
          {% endfor %}
        </div>
        {% if page.pagination.pages > 1 %}
          <nav class="cs__pages" aria-label="Pages">
            {% if page.pagination.prev_url %}<a href="{{ page.pagination.prev_url | url }}" rel="prev">{{ settings.prev_label }}</a>{% endif %}
            {% for link in page.pagination.links %}{% if link.current %}<span aria-current="page">{{ link.number }}</span>{% else %}<a href="{{ link.url | url }}">{{ link.number }}</a>{% endif %}{% endfor %}
            {% if page.pagination.next_url %}<a href="{{ page.pagination.next_url | url }}" rel="next">{{ settings.next_label }}</a>{% endif %}
          </nav>
        {% endif %}
      </div>
    </div>
  </div>
</section>
</template>

<style>
.cs { container-type: inline-size; background: var(--scheme-background); color: var(--scheme-text); padding: calc(var(--cs-pt) * var(--theme-spacing-scale, 1)) var(--theme-padding-x, 24px) calc(var(--cs-pb) * var(--theme-spacing-scale, 1)); }
.cs__in { max-width: var(--theme-page-width, 1280px); margin: 0 auto; }
.cs__head { margin-bottom: 24px; }
.cs__title { margin: 0; color: var(--scheme-heading); font-family: var(--section-heading-font, inherit); font-size: var(--section-heading-size, 36px); line-height: var(--section-heading-line-height, 1.15); }
.cs__desc { margin: 8px 0 0; max-width: 40rem; color: var(--scheme-text-muted); font-size: var(--section-text-size, 16px); }
.cs__body { display: grid; gap: 24px; }
.cs__panel { border: 1px solid var(--scheme-border); border-radius: var(--theme-radius, 8px); padding: 12px 16px; }
.cs__sum { cursor: pointer; font-weight: 600; color: var(--scheme-heading); }
.cs__group { margin: 16px 0 0; padding: 0; border: 0; }
.cs__legend { margin-bottom: 8px; font-size: 13px; font-weight: 600; color: var(--scheme-heading); }
.cs__opt { display: flex; align-items: center; gap: 8px; padding: 4px 0; font-size: 14px; }
.cs__n { margin-left: auto; color: var(--scheme-text-muted); font-size: 12px; }
.cs__price { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
.cs__price input { width: 100%; padding: 8px; border: 1px solid var(--scheme-border); border-radius: var(--theme-input-radius, 8px); background: transparent; color: inherit; }
.cs__apply { margin-top: 16px; width: 100%; padding: 10px; border: 0; color: var(--scheme-button-primary-text); background: var(--scheme-button-primary); border-radius: var(--theme-button-radius, 8px); font-weight: 600; cursor: pointer; }
.cs__clear { display: block; margin-top: 8px; text-align: center; color: var(--scheme-text-muted); font-size: 13px; }
.cs__bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 16px; }
.cs__count { margin: 0; color: var(--scheme-text-muted); font-size: 14px; }
.cs__sort { display: inline-flex; align-items: center; gap: 8px; font-size: 14px; }
.cs__sort select { padding: 6px 8px; border: 1px solid var(--scheme-border); border-radius: var(--theme-input-radius, 8px); background: transparent; color: inherit; }
.cs__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px 16px; }
.cs__card { display: flex; flex-direction: column; gap: 6px; min-width: 0; color: inherit; text-decoration: none; }
.cs__media { display: block; aspect-ratio: 1; overflow: hidden; border-radius: var(--theme-image-radius, 8px); background: var(--scheme-background-secondary); }
.cs__media img { display: block; width: 100%; height: 100%; object-fit: cover; }
.cs__name { color: var(--scheme-heading); font-weight: 600; overflow-wrap: anywhere; }
.cs__cost { font-size: 14px; }
.cs__cost s { color: var(--scheme-text-muted); }
.cs__none { color: var(--scheme-text-muted); }
.cs__pages { display: flex; justify-content: center; gap: 8px; margin-top: 32px; }
.cs__pages a, .cs__pages span { padding: 6px 10px; border-radius: var(--theme-radius, 8px); color: inherit; text-decoration: none; }
.cs__pages span { background: var(--scheme-background-secondary); font-weight: 600; }
@container (min-width: 900px) {
  .cs__body { grid-template-columns: 240px minmax(0, 1fr); align-items: start; }
  .cs__side { position: sticky; top: 16px; }
  .cs__grid { grid-template-columns: repeat(var(--cs-cols), minmax(0, 1fr)); }
}
</style>

<schema>
{
  "type": "collection_sidebar",
  "name": "Collection with filter sidebar",
  "category": "Products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading when there is no collection", "default": "Shop" },
    { "type": "range", "id": "columns", "label": "Columns on desktop", "default": 3, "min": 2, "max": 4, "step": 1 },
    { "type": "text", "id": "filter_label", "label": "Filter title", "default": "Filter" },
    { "type": "text", "id": "range_label", "label": "Range title", "default": "Price" },
    { "type": "text", "id": "sort_label", "label": "Sort label", "default": "Sort" },
    { "type": "text", "id": "apply_label", "label": "Apply button", "default": "Apply" },
    { "type": "text", "id": "clear_label", "label": "Clear link", "default": "Clear all" },
    { "type": "text", "id": "prev_label", "label": "Previous page", "default": "Previous" },
    { "type": "text", "id": "next_label", "label": "Next page", "default": "Next" },
    { "type": "text", "id": "empty_text", "label": "When nothing matches", "default": "No products match these filters." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "white" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "default": 48, "min": 0, "max": 160, "step": 4, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "default": 64, "min": 0, "max": 160, "step": 4, "unit": "px" }
  ],
  "presets": [{ "name": "Collection with filter sidebar" }]
}
</schema>
