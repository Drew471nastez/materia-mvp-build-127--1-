<template>
<section class="pp" data-scheme="{{ settings.color_scheme }}" style="--pp-bg: {{ scheme.bg }}; --pp-text: {{ scheme.text }}; --pp-heading: {{ scheme.heading }}; --pp-para: {{ scheme.paragraph }}; --pp-border: {{ scheme.border }}; --pp-accent: {{ scheme.accent }}; --pp-btn: {{ scheme.primary_btn_bg }}; --pp-btn-text: {{ scheme.primary_btn_text }}; --pp-btn-hover: {{ scheme.primary_btn_hover_bg }}; --pp-btn-hover-text: {{ scheme.primary_btn_hover_text }}; --pp-radius: {{ theme.radius.medium }}px; --pp-pt: {{ settings.padding_top }}px; --pp-pb: {{ settings.padding_bottom }}px;">
  {% if page.product %}
  <div class="pp__in">
    <div class="pp__gallery">
      {% if page.product.settings.images.size > 0 %}
        <div class="pp__track">
          {% for image in page.product.settings.images %}
            <img class="pp__img" src="{{ image }}" alt="{{ page.product.settings.title }}" width="1200" height="1200" {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %} decoding="async">
          {% endfor %}
        </div>
      {% endif %}
    </div>
    <div class="pp__info">
      <h1 class="pp__title">{{ page.product.settings.title }}</h1>
      {% if page.product.settings.variants.size == 0 %}
        <p class="pp__price">
          {% if page.product.settings.free %}{{ settings.free_label }}{% else %}{% if page.product.settings.pay_what_you_want %}<span class="pp__from">{{ settings.pwyw_label }}</span> {% endif %}{{ page.product.settings.price }}{% endif %}
          {% if page.product.settings.compare_price != "" %}<s class="pp__was">{{ page.product.settings.compare_price }}</s>{% endif %}
        </p>
      {% endif %}
      {% if page.product.settings.available %}
        {% if page.product.settings.variants.size > 0 %}
          <fieldset class="pp__choose">
            <legend class="pp__legend">{{ settings.options_label }}</legend>
            {% for variant in page.product.settings.variants %}
              <input class="pp__radio" type="radio" name="{{ section.id }}-option" id="{{ section.id }}-option-{{ forloop.index }}" {% if forloop.first %}checked{% endif %}>
              <label class="pp__option" for="{{ section.id }}-option-{{ forloop.index }}">
                <span class="pp__option-name">{{ variant.name }}</span>
                <span class="pp__option-price">{% if variant.free %}{{ settings.free_label }}{% else %}{{ variant.price }}{% endif %}{% if variant.compare_price != "" %} <s class="pp__was">{{ variant.compare_price }}</s>{% endif %}</span>
              </label>
            {% endfor %}
            <div class="pp__buys">
              {% for variant in page.product.settings.variants %}
                <a class="pp__btn" href="{{ variant.checkout_url | url }}">{{ settings.button_label }}</a>
              {% endfor %}
            </div>
          </fieldset>
        {% else %}
          <a class="pp__btn pp__btn--solo" href="{{ page.product.settings.checkout_url | url }}">{{ settings.button_label }}</a>
        {% endif %}
      {% else %}
        <p class="pp__tag">{{ page.product.settings.tag }}</p>
      {% endif %}
      {% if settings.show_description and page.product.settings.description != "" %}
        <div class="pp__desc">{{ page.product.settings.description }}</div>
      {% endif %}
    </div>
  </div>
  {% elsif page.in_editor %}
    <p class="pp__empty">Your product appears here on its product page</p>
  {% endif %}
</section>
</template>

<style>
.pp { container-type: inline-size; background: var(--pp-bg); color: var(--pp-text); padding: var(--pp-pt) var(--theme-padding-x, 20px) var(--pp-pb); }
.pp__in { display: grid; gap: 24px; max-width: var(--theme-page-width, 1200px); margin: 0 auto; }
.pp__gallery { min-width: 0; }
.pp__track { display: flex; gap: 8px; overflow-x: auto; scroll-snap-type: x mandatory; overscroll-behavior-x: contain; scrollbar-width: none; }
.pp__track::-webkit-scrollbar { display: none; }
.pp__img { display: block; flex: 0 0 100%; width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; scroll-snap-align: start; border-radius: var(--pp-radius); background: var(--pp-border); }
.pp__info { display: flex; flex-direction: column; gap: 16px; min-width: 0; }
.pp__title {
  margin: 0;
  overflow-wrap: anywhere;
  color: var(--pp-heading);
  font-family: var(--theme-font-heading, {{ theme.typography.heading }}), ui-sans-serif, system-ui, sans-serif;
  font-size: var(--type-h1-size, var(--section-heading-size, 32px));
  font-weight: var(--section-heading-weight, 700);
  line-height: var(--section-heading-line-height, 1.15);
}
.pp__price { margin: 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px; font-size: 20px; font-weight: 600; color: var(--pp-heading); }
.pp__from { font-size: 14px; font-weight: 400; color: var(--pp-para); }
.pp__was { font-size: 14px; font-weight: 400; color: var(--pp-para); }
.pp__choose { margin: 0; padding: 0; border: 0; min-width: 0; display: grid; gap: 8px; }
.pp__legend { padding: 0; margin-bottom: 8px; font-size: 14px; font-weight: 600; color: var(--pp-heading); }
.pp__radio { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip-path: inset(50%); }
.pp__option { display: flex; justify-content: space-between; gap: 12px; min-height: 44px; align-items: center; padding: 10px 14px; border: 1px solid var(--pp-border); border-radius: var(--pp-radius); cursor: pointer; }
.pp__option-name { min-width: 0; overflow-wrap: anywhere; color: var(--pp-heading); }
.pp__option-price { flex-shrink: 0; color: var(--pp-text); }
.pp__radio:checked + .pp__option { border-color: var(--pp-heading); box-shadow: inset 0 0 0 1px var(--pp-heading); }
.pp__radio:focus-visible + .pp__option { outline: 2px solid var(--pp-accent); outline-offset: 2px; }
.pp__buys { margin-top: 8px; }
.pp__btn { display: none; align-items: center; justify-content: center; min-height: 48px; padding: 0 24px; border: 1px solid var(--pp-btn); border-radius: var(--pp-radius); background: var(--pp-btn); color: var(--pp-btn-text); font-size: 16px; font-weight: 600; text-decoration: none; transition: background-color 150ms ease, color 150ms ease, border-color 150ms ease; }
.pp__btn:hover { background: var(--pp-btn-hover); border-color: var(--pp-btn-hover); color: var(--pp-btn-hover-text); }
.pp__btn:focus-visible { outline: 2px solid var(--pp-accent); outline-offset: 2px; }
.pp__btn--solo { display: flex; }
.pp__radio:nth-of-type(1):checked ~ .pp__buys > .pp__btn:nth-of-type(1),
.pp__radio:nth-of-type(2):checked ~ .pp__buys > .pp__btn:nth-of-type(2),
.pp__radio:nth-of-type(3):checked ~ .pp__buys > .pp__btn:nth-of-type(3),
.pp__radio:nth-of-type(4):checked ~ .pp__buys > .pp__btn:nth-of-type(4),
.pp__radio:nth-of-type(5):checked ~ .pp__buys > .pp__btn:nth-of-type(5),
.pp__radio:nth-of-type(6):checked ~ .pp__buys > .pp__btn:nth-of-type(6),
.pp__radio:nth-of-type(7):checked ~ .pp__buys > .pp__btn:nth-of-type(7),
.pp__radio:nth-of-type(8):checked ~ .pp__buys > .pp__btn:nth-of-type(8) { display: flex; }
.pp__tag { margin: 0; font-size: 14px; font-weight: 600; color: var(--pp-para); }
.pp__desc { white-space: pre-line; overflow-wrap: anywhere; font-size: var(--section-text-size, 16px); line-height: 1.6; color: var(--pp-para); }
.pp__empty { margin: 0; text-align: center; color: var(--pp-para); }
@container (min-width: 900px) {
  .pp__in { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 48px; align-items: start; }
  .pp__track { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); overflow: visible; }
  .pp__img:first-child { grid-column: 1 / -1; }
  .pp__info { position: sticky; top: 24px; }
}
@media (prefers-reduced-motion: reduce) { .pp__btn { transition: none; } }
</style>

<schema>
{
  "type": "product_page",
  "name": "Product page",
  "category": "Products",
  "allowed_templates": ["product"],
  "settings": [
    { "type": "text", "id": "button_label", "label": "Buy button", "default": "Buy now" },
    { "type": "text", "id": "options_label", "label": "Options heading", "default": "Choose an option" },
    { "type": "text", "id": "free_label", "label": "Price when free", "default": "Free" },
    { "type": "text", "id": "pwyw_label", "label": "Before a pay what you want price", "default": "From" },
    { "type": "toggle", "id": "show_description", "label": "Show the description", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "white" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "default": 48, "min": 0, "max": 160, "step": 4, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "default": 64, "min": 0, "max": 160, "step": 4, "unit": "px" }
  ],
  "presets": [{ "name": "Product page" }]
}
</schema>
